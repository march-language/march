-- DOM demo: a row of colored tiles that move when clicked.
-- Compile with: march --target js -o dom_demo.mjs dom_demo.march
-- Then open index.html in a browser.
mod DomDemo do

  fn move_to_end(tile) : Unit do
    match Dom.parent(tile) do
      None    -> ()
      Some(p) ->
        Dom.remove(tile)
        Dom.append(p, tile)
    end
  end

  fn set_status(msg: String) : Unit do
    match Dom.find("status") do
      None     -> ()
      Some(el) -> Dom.set_text(el, msg)
    end
  end

  fn prepend_all(container, nodes) : Unit do
    match nodes do
      Nil           -> ()
      Cons(n, rest) ->
        Dom.prepend(container, n)
        prepend_all(container, rest)
    end
  end

  fn reverse_tiles(container) : Unit do
    let kids = Dom.children(container)
    Dom.clear(container)
    prepend_all(container, kids)
    set_status("Reversed!")
  end

  fn add_tile(container, label: String, color: String) : Unit do
    let tile = Dom.create("div")
    Dom.add_class(tile, "tile")
    Dom.set_style(tile, "background", color)
    Dom.set_text(tile, label)
    Dom.listen(tile, "click", fn _ev ->
      let _ = move_to_end(tile)
      set_status("Moved " ++ label ++ " to end")
    )
    Dom.append(container, tile)
  end

  fn main() : Unit do
    match Dom.find("board") do
      None -> ()
      Some(board) ->
        add_tile(board, "A", "#e74c3c")
        add_tile(board, "B", "#3498db")
        add_tile(board, "C", "#2ecc71")
        add_tile(board, "D", "#f39c12")
        add_tile(board, "E", "#9b59b6")
        set_status("Click a tile to move it to the end")
        match Dom.find("reverse-btn") do
          None      -> ()
          Some(btn) ->
            Dom.listen(btn, "click", fn _ev ->
              reverse_tiles(board)
            )
        end
    end
  end
end
