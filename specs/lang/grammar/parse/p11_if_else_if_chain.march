mod P11IfElseIfChain do
  needs IO.Console
  fn classify(n) do
    if n < 0 do
      "negative"
    else if n == 0 do
      "zero"
    else if n < 10 do
      "small"
    else
      "large"
    end
    end
    end
  end

  fn main() do
    println(classify(-5))
    println(classify(0))
    println(classify(3))
    println(classify(100))
  end
end
