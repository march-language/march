mod P44DecreasesAttribute do
  -- `@[decreases(e, ...)]`: a termination metric, the one attribute whose
  -- payload is a list of expressions (termination design
  -- specs/2026-10-26-termination-checking-design.md §2.1).
  @[decreases(m, n)]
  fn ack(m : Int, n : Int) : Int do
    if m <= 0 do n + 1
    else if n <= 0 do ack(m - 1, 1)
    else ack(m - 1, ack(m, n - 1)) end end
  end

  @[decreases(len(xs) - i)]
  fn scan(xs : List(Int), i : {Int | _ >= 0}, acc : Int) : Int do
    if i >= List.length(xs) do acc else scan(xs, i + 1, acc + 1) end
  end

  -- A one-identifier payload keeps its old meaning.
  @[no_alloc(warn)]
  fn inc(n : Int) : Int do n + 1 end

  fn main() : Int do ack(1, 1) + scan([1, 2], 0, 0) + inc(0) end
end
