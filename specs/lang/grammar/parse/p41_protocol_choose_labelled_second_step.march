-- The labelled twin of p40: a branch's second step carries a label
-- (`tick: A -> B : Int`). `tick ->` would be a new arm; `tick:` is a step,
-- told apart by the COLON before any ARROW (2026-09-23; this line used to be
-- read as an arm and fail with "I got stuck here").
mod P41ProtocolChooseLabelledSecondStep do
  needs IO.Console
  protocol Tally do
    choose by A:
      go -> A -> B : Int
            tick: A -> B : Int
            stop_ack: B -> A : String
      no -> A -> B : Bool
    end
  end

  fn main(_cap_console : Cap(IO.Console)) do
    println(1)
  end
end
