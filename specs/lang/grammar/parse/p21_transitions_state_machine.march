mod P21TransitionsStateMachine do
  type Conn(s) = Conn(Int)
  tag Open
  tag Closed

  fn open_conn(h: Conn(Closed)): Conn(Open) do
    match h do
      Conn(n) -> Conn(n + 1)
    end
  end

  transitions Conn do
    ConnTag: Closed -> Open via open_conn
  end

  fn main() do
    let h = Conn(0)
    let h2 = open_conn(h)
    match h2 do
      Conn(n) -> println(n)
    end
  end
end
