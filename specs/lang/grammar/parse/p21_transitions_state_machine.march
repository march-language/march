mod P21TransitionsStateMachine do
  needs IO.Console
  type Handle(s) = Handle(Int)
  tag Open
  tag Closed

  fn open_conn(h: Handle(Closed)): Handle(Open) do
    match h do
      Handle(n) -> Handle(n + 1)
    end
  end

  transitions Handle do
    ConnTag: Closed -> Open via open_conn
  end

  fn main(_cap_console : Cap(IO.Console)) do
    let h = Handle(0)
    let h2 = open_conn(h)
    match h2 do
      Handle(n) -> println(n)
    end
  end
end
