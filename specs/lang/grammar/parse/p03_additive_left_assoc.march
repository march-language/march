mod P03AdditiveLeftAssoc do
  fn main() do
    -- 10 - 3 - 2 only equals 5 under LEFT-associative `-`: (10 - 3) - 2 = 5.
    -- Right-associative would give 10 - (3 - 2) = 9. This is a value-witness
    -- of expr_add's left recursion (parser.mly expr_add: `expr_add MINUS
    -- expr_mul`), not just a parse-witness.
    println(10 - 3 - 2)
  end
end
