-- EXPECT-ERROR: expected `Int` but got `String`
mod Main do
  -- Session-types widening, Task 3 -- wrong payload type.
  -- `Chan.send` (typecheck.ml:3479) `check_expr`s the payload against the
  -- session's declared `T` in `SSend(T, S)`. `Echo` declares `Int`; passing
  -- a `String` fails the ordinary constructor/type-mismatch path (the
  -- `check_expr` call, not a session-specific message) -- proving payload
  -- SHAPE is checked, not just session STATE.
  type Client = Client
  type Server = Server

  protocol Echo do
    Client -> Server : Int
    Server -> Client : Int
  end

  fn main() do
    let (cc, sc) = Chan.new(Echo)
    let cc2 = Chan.send(cc, "not an int")
    Chan.close(cc2)
    Chan.close(sc)
  end
end
