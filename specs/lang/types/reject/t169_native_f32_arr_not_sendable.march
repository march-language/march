-- EXPECT-ERROR: cannot be sent in actor messages
mod Main do
  -- Companion to reject/t164 for NativeF32Arr (P10 narrow-width NativeArray
  -- backing type).
  actor Worker do
    state { n : Int }
    init  { n: 0 }
    on MsgArr(arr : NativeF32Arr) do
      { n: 1 }
    end
  end

  fn main() do
    let w = spawn(Worker)
    let arr = NativeArray.make_f32(4, 0.0)
    send(w, MsgArr(arr))
  end
end
