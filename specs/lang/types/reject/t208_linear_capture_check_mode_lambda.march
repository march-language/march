-- EXPECT-ERROR: The linear value `s` cannot be captured by a closure
mod Main do
  needs IO.Console
  -- The capture rule ran only when a lambda was INFERRED. Passed straight to
  -- an annotated function, a lambda is checked instead, and could capture a
  -- linear value; `run2` then calls it twice and `s` is consumed twice (the
  -- interpreter printed 2). Accepted before 2026-09-13.
  always_linear type S1 = S1(Int)
  fn sink(s : S1) : Int do match s do S1(e) -> e end end
  fn run2(k : () -> Int) : Int do k() + k() end
  fn main(c : Cap(IO.Console)) do
    let s = S1(1)
    println(int_to_string(run2(fn () -> sink(s))))
  end
end
