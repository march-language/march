-- EXPECT-ERROR: Two different types named `Note` both derive Json
mod Main do
  needs IO.Console
  -- Two RECORD types with the same short name, `A.Note` and `B.Note`, both
  -- `derive Json` (owner decision 2026-10-11,
  -- specs/progress/2026-10-03-derive-json-same-short-name-two-modules.md).
  -- Records unify structurally and keep their bare name, so `from_json`'s
  -- result-type dispatch cannot tell the two codecs apart: still a compile
  -- error, at the second derive, with a label on the first. Two same-short-
  -- name VARIANT types have their own identities and both derive Json fine
  -- (specs/lang/golden/g48_same_short_name_types.march).
  mod A do
    type Note = { a : Int }
    derive Json for Note
    fn make() : Note do { a: 3 } end
  end
  mod B do
    type Note = { b : String }
    derive Json for Note
  end
  fn main(c : Cap(IO.Console)) do
    print_line(Json.to_string(to_json(A.make())))
  end
end
