-- EXPECT-ERROR: The linear value `r.st` is used more than once here
mod Main do
  needs IO.Console
  -- Field sentinels existed only for `linear`-qualified fields; a field whose
  -- TYPE is always_linear was untracked in every record.
  always_linear type S1 = S1(Int)
  fn sink(s : S1) : Int do match s do S1(e) -> e end end
  type R = { st : S1, n : Int }
  fn main(c : Cap(IO.Console)) do
    let r : R = { st: S1(0), n: 0 }
    println(int_to_string(sink(r.st) + sink(r.st)))
  end
end
