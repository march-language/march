-- EXPECT-ERROR: Chan.choose: label
mod Main do
  -- Session-types widening, Task 3 -- invalid choose label.
  -- `Chan.choose` (typecheck.ml:3564) requires the channel be at SChoose(bs)
  -- and the label to name one of the declared branches. `:maybe` is not a
  -- branch of `Decision` (only `:ok`/`:err` are) -- rejected.
  type Client = Client
  type Server = Server

  protocol Decision do
    choose by Client:
      ok  -> Client -> Server : Int
      err -> Client -> Server : String
    end
  end

  fn main() do
    let (cc, sc) = Chan.new(Decision)
    let cc2 = Chan.choose(cc, :maybe)
    let (lbl, sc2) = Chan.offer(sc)
    println(lbl)
  end
end
