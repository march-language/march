-- EXPECT-ERROR: expected `Pid(
-- Config typed keys (specs/progress/2026-09-22-config-typed-keys.md): the
-- witness from the filed todo kept in that file, spelled with the typed API.
-- `Config.key(..., Config.int())` is a `Config.Key(Int)`, and
-- `Config.get(key : Key(v)) : Option(v)`, so the read is an `Option(Int)` and
-- `is_alive(p)` is a type error. Before typed keys the untyped
-- `Config.put(:ns, :name, 42)` / `Config.get(:ns, :name)` pair typechecked and
-- handed the stored Int to `is_alive` as a Pid. A key minted with no codec
-- cannot exist: the codec argument is what fixes `v`, so the caller cannot
-- choose it at the minting door (accept/t286 is the runtime half).
mod M do
  needs IO.Console
  needs IO.Mut
  needs IO.Process

  fn main(_c : Cap(IO.Console), _m : Cap(IO.Mut), _p : Cap(IO.Process)) do
    let k = Config.key(:config_erased_witness, :value, Config.int())
    Config.put(k, 42)
    match Config.get(k) do
      Some(p) -> println(bool_to_string(is_alive(p)))
      None    -> println("missing")
    end
  end
end
