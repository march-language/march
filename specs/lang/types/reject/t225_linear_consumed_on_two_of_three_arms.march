-- EXPECT-ERROR: The linear value `s` is consumed on some branches but not others
mod Main do
  needs IO.Console
  -- The same through a three-arm match on a let-bound value.
  always_linear type S1 = S1(Int)
  fn sink(s : S1) : Int do match s do S1(e) -> e end end
  fn main(c : Cap(IO.Console)) do
    let s = S1(1)
    let n = match 2 do
      1 -> sink(s)
      2 -> sink(s) + 1
      _ -> 0
    end
    println(int_to_string(n))
  end
end
