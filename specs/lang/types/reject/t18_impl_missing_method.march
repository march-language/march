-- EXPECT-ERROR: Missing method `greet` in `impl Speak(Dog)`.
mod M do
  interface Speak(a) do
    fn speak : a -> String
    fn greet : a -> String
  end

  type Dog = Dog(String)

  impl Speak(Dog) do
    fn speak(self) do
      match self do
        Dog(name) -> name
      end
    end
  end

  fn main() do
    println(speak(Dog("Rex")))
  end
end
