-- EXPECT-ERROR: `stop` outside of a `loop` has no effect
mod Main do
  needs IO.Console
  -- Session types: `stop` (2026-07-27) is only meaningful inside a `loop`
  -- body (directly, or nested inside a `choose` branch within one) -- it
  -- exits the loop's back-reference by projecting to `SEnd`. Outside any
  -- `loop`, writing `stop` is indistinguishable from writing nothing (the
  -- protocol already ends where the step list ends), so it is rejected
  -- rather than silently accepted as a no-op.
  type A = A
  type B = B

  protocol Bad do
    A -> B : Int
    stop
  end

  fn main() do
    println("unused")
  end
end
