-- EXPECT-ERROR: came from `Chan.offer`
mod Main do
  -- Session-types Task 4 review fix (2026-07-27) -- offer-label shadowing
  -- bypassed the F5 residual soundness fix (reject/t95).
  --
  -- `env.offer_labels` links the NAME `lbl` (from `let (lbl, ch) =
  -- Chan.offer(...)`) to the offer's session ref, keyed on the bare string.
  -- Before this fix, rebinding `lbl` to an unrelated value (`let lbl = :ok`)
  -- left the OLD entry reachable: `match lbl do :ok -> ...` looked up
  -- `env.offer_labels` by name, found the stale linkage, and refined (and
  -- un-marked) `cc2` as if the peer had actually returned `:ok` -- even
  -- though `lbl` no longer holds the offer's real label at all. That let the
  -- exact type confusion `t95` closes back in through a shadowed name
  -- instead of a missing `match`: here the peer chose `:err` and sent a
  -- `String`, but the shadowed `:ok` match arm drives `Chan.recv` typed
  -- `Int` regardless.
  --
  -- Fixed by retiring any `offer_labels` entry for a name the moment it is
  -- rebound -- `bind_var`/`bind_linear`, the two chokepoints every binding
  -- construct (`let`, lambda/`fn` params, `match` pattern bindings) funnels
  -- through, now filter it out. So `let lbl = :ok` clears the stale entry,
  -- the later `match lbl` finds no linkage, and `cc2` stays correctly marked
  -- in `env.offer_unrefined` -- rejected, same as t95.
  needs IO.Console
  type C = C
  type S = S

  protocol D2 do
    choose by S:
      ok  -> S -> C : Int
      err -> S -> C : String
    end
  end

  fn main() do
    let (cc, sc) = Chan.new(D2)
    let sc2 = Chan.choose(sc, :err)
    let sc3 = Chan.send(sc2, "boom")
    Chan.close(sc3)
    let (lbl, cc2) = Chan.offer(cc)
    let lbl = :ok
    match lbl do
      :ok ->
        let (v, cc3) = Chan.recv(cc2)
        Chan.close(cc3)
        println(int_to_string(v))
      _ -> println("other")
    end
  end
end
