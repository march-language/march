-- EXPECT-ERROR: came from `Chan.offer`
mod Main do
  -- Session-types final review, Finding 1 (2026-07-27) -- the `if`-join shape
  -- of the unification laundering `t98` documents, and the one a user could
  -- hit BY ACCIDENT: no type annotation is written anywhere.
  --
  -- An `if` whose two branches are channels unifies their `TChan` refs. `ec`
  -- is an ordinary `E`-protocol endpoint at `S -> C : Int`; `cc2` is the
  -- unrefined `Chan.offer` continuation, guessed at its FIRST branch, which is
  -- the same state -- so the join succeeded silently and `ch` came out as a
  -- fresh, unmarked ref. Pre-fix: `--check` exit 0, compiled printed
  -- `4315028705` (the `String` payload's heap pointer read as an `Int`).
  --
  -- Fixed alongside `t98` by rejecting in `unify`'s `TChan` arm rather than by
  -- propagating the mark: propagation cannot help across a function boundary,
  -- where the callee body was already checked against its own ref.
  needs IO.Console
  type C = C
  type S = S

  protocol D2 do
    choose by S:
      ok  -> S -> C : Int
      err -> S -> C : String
    end
  end

  protocol E do
    S -> C : Int
  end

  fn main() do
    let (cc, sc) = Chan.new(D2)
    let sc2 = Chan.choose(sc, :err)
    let sc3 = Chan.send(sc2, "boom")
    Chan.close(sc3)
    let (ec, es) = Chan.new(E)
    let (lbl, cc2) = Chan.offer(cc)
    -- The laundering: the join's result ref is `ec`'s, which is not marked.
    let ch = if false do ec else cc2 end
    let (v, ch2) = Chan.recv(ch)
    Chan.close(ch2)
    let es2 = Chan.send(es, 7)
    Chan.close(es2)
    println(int_to_string(v + 1))
  end
end
