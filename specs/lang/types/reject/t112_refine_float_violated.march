-- EXPECT-ERROR: refinement violation
-- Refinement types: `Float` refinements (§2.14), discharged through Z3's
-- bit-precise `FloatingPoint` theory (`Float64`, `fp.geq`) -- see accept/t100
-- for why bit-precise (not `Real`) matters. `0.0 -. 1.0` is a literal
-- float expression refinecheck evaluates to `-1.0`, definitely refuting
-- `_ >= 0.0`. Accept companion: accept/t99 (`sqrtish(4.0)`).
mod M do
  fn sqrtish(x : {Float | _ >= 0.0}) : Float do x end
  fn main() do
    println(float_to_string(sqrtish(0.0 -. 1.0)))
  end
end
