-- EXPECT-ERROR: Overlapping implementation
-- Coherence stopgap (FQN dispatch, Task 6b): the declaring-module relaxation
-- (accept/t89) lets two DISTINCT same-short-name types each implement the SAME
-- general interface — but ONLY when their constructor NAME sets are disjoint.
-- Here both `NA.Thing` and `NB.Thing` also declare a constructor named `Shared`
-- (a "double collision": same short type name AND a shared ctor name). The
-- constructor-tag identity the backends and interpreter route dispatch on keys
-- on the BARE ctor name (`ci_module` is diagnostic-only, feeds no dispatch), so
-- `speak` would silently MISDISPATCH in both backends (registration-order-
-- dependent; interpreted and compiled can disagree on the wrong answer). Until
-- the full `ci_module.Type.Ctor`-qualified ctor identity lands, this specific
-- shape is REJECTED at typecheck (safe compile error) via the existing overlap
-- path — `register_impl_shape`'s ctor-set-disjointness check. Accept twin with
-- DISTINCT ctor names: accept/t89. See
-- specs/plans/2026-07-20-fqn-impl-dispatch-identity.md.
mod Top do
  interface Speak(a) do
    fn speak : a -> String
  end
  mod NA do
    type Thing = Shared | OnlyA
    impl Speak(Thing) do
      fn speak(_self) do "from-A" end
    end
  end
  mod NB do
    type Thing = Shared | OnlyB
    impl Speak(Thing) do
      fn speak(_self) do "from-B" end
    end
  end
  fn main() do 0 end
end
