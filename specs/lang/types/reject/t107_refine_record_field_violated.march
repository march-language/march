-- EXPECT-ERROR: refinement violation
-- Refinement types: record refinements naming a field through a bound
-- variable, `{v : T | v.port >= 1}` (§2.14). `serve({ port: 0 })` passes a
-- record LITERAL whose field value refinecheck reflects directly into the
-- Z3 model; `0 >= 1` is refuted without ambiguity. Accept companion:
-- accept/t95 (`serve({ port: 8080 })`).
mod M do
  type Cfg = { port : Int }
  fn serve(c : {v : Cfg | v.port >= 1}) : Int do c.port end
  fn main() do
    println(int_to_string(serve({ port: 0 })))
  end
end
