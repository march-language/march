-- EXPECT-ERROR: The linear value `p` is used more than once here
mod Main do
  needs IO.Console
  -- A tuple holding a linear value was an ordinary value, so destructuring it
  -- twice produced the same S1 twice. A binding whose type HOLDS a linear
  -- value (a tuple component, a list element, an ADT payload) is now linear
  -- itself. Accepted before 2026-09-13.
  always_linear type S1 = S1(Int)
  fn sink(s : S1) : Int do match s do S1(e) -> e end end
  fn main(c : Cap(IO.Console)) do
    let s = S1(1)
    let p = (s, 1)
    let (a, _) = p
    let (b, _) = p
    println(int_to_string(sink(a) + sink(b)))
  end
end
