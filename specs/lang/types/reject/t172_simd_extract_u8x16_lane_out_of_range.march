-- EXPECT-ERROR: refinement violation: argument `i` of `Simd.extract_u8x16` does not satisfy precondition
-- Refinement types (widening slice 12, §2.14), applied to Simd (2026-08-10 —
-- specs/todos/2026-08-10-simd-vector-types.md Task 1). `Simd.extract_u8x16`'s
-- lane index carries `{Int | 0 <= _ && _ < 16}` (stdlib/simd.march); a DIRECT
-- call with the literal `16` violates the upper bound (U8x16 has lanes
-- 0..15) -- Z3 refutes it with no path-sensitivity needed, so `--check`
-- rejects with the pinned "refinement violation" message. Companion to
-- reject/t171 (same shape, F32x4's 4-lane bound). Accept companion:
-- accept/t173 (lane 15, the last legal index).
mod M do
  needs IO.Console
  fn main() do
    let v = Simd.splat_u8x16(7)
    println(to_string(Simd.extract_u8x16(v, 16)))
  end
end
