mod FoldAnnotatedAccumulatorBaseFails do
  cap verified
  fn need_pos(k : {Int | _ > 0}) : Int do k end
  fn count(ys : List(Int)) : Int do
    let s = List.fold_left(ys, 0, fn (acc : {Int | _ > 0}, _x) -> acc + 1)
    need_pos(s)
  end
end
