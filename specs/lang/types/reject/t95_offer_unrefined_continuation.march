-- EXPECT-ERROR: came from `Chan.offer`
mod Main do
  -- Session-types Task 4 (2026-07-24) -- F5 residual soundness hole.
  -- The 2026-07-15 F5 fix made `match`-on-the-label refine an `offer`
  -- channel PER ARM, but only when such a `match` exists. Without one,
  -- `Chan.offer` used to hand back the FIRST branch's continuation as an
  -- unsound guess. Here the peer chooses `:err` and sends a `String`, but
  -- `D2`'s branches continue DIFFERENTLY (`Int` vs `String`), so driving the
  -- returned channel with `Chan.recv` before matching on `lbl` is now a hard
  -- error: interpreted this used to die dynamically; compiled it silently
  -- read the String's heap pointer as an Int (observed: printing
  -- `4328203745`). See accept/t79 for the fix path (match-refined offer) and
  -- reject/t74 for driving a REFINED arm with the wrong branch's type.
  needs IO.Console
  type C = C
  type S = S

  protocol D2 do
    choose by S:
      ok  -> S -> C : Int
      err -> S -> C : String
    end
  end

  fn main() do
    let (cc, sc) = Chan.new(D2)
    let sc2 = Chan.choose(sc, :err)
    let sc3 = Chan.send(sc2, "boom")
    Chan.close(sc3)
    let (lbl, cc2) = Chan.offer(cc)
    let (v, cc3) = Chan.recv(cc2)
    Chan.close(cc3)
    println(int_to_string(v))
  end
end
