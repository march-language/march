-- EXPECT-ERROR: `ys` has type `List(b)`, which holds a type variable that a `linear` parameter of `f` opts in to linear values
mod Main do
  needs IO.Console
  -- The check reads each parameter's type after the body is solved: `ys` is
  -- declared `List(b)`, and the body unifies `b` with the opted-in `a`. A
  -- container of `a` counts, since the body may drop or copy the list and its
  -- elements with it. Accepted before 2026-09-19.
  always_linear type S1 = S1(Int)
  fn sink_all(xs : List(S1)) : Int do
    match xs do
      Nil -> 0
      Cons(S1(n), rest) -> n + sink_all(rest)
    end
  end
  fn f(linear x : a, ys : List(b)) : List(a) do Cons(x, ys) end
  fn main(c : Cap(IO.Console)) do
    println(int_to_string(sink_all(f(S1(1), Nil))))
  end
end
