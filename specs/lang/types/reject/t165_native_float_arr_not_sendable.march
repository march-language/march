-- EXPECT-ERROR: cannot be sent in actor messages
mod Main do
  -- Companion to reject/t164 for NativeFloatArr (the other NativeArray
  -- backing type).
  actor Worker do
    state { n : Int }
    init  { n: 0 }
    on MsgArr(arr : NativeFloatArr) do
      { n: 1 }
    end
  end

  fn main() do
    let w = spawn(Worker)
    let arr = NativeArray.make_float(4, 0.0)
    send(w, MsgArr(arr))
  end
end
