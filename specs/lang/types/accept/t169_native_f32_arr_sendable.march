mod Main do
  -- Companion to accept/t164 for NativeF32Arr (P10 narrow-width NativeArray
  -- backing type): a copy-on-write value, sendable since Part C, Phase C1.
  actor Worker do
    state { n : Int }
    init  { n: 0 }
    on MsgArr(arr : NativeF32Arr) do
      { n: 1 }
    end
  end

  fn main() do
    let w = spawn(Worker)
    let arr = NativeArray.make_f32(4, 0.0)
    send(w, MsgArr(arr))
  end
end
