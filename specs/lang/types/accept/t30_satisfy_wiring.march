mod M do
  needs IO.Console
  -- `satisfy` (core-march-types.md §2.3 / desugar.ml's `expand_satisfy`,
  -- ~:1673-1716): wires an EXISTING top-level `fn name` to `interface
  -- Named(a)`'s `name` method purely by NAME MATCH -- no `impl` block
  -- required. `satisfy Named for Person` builds an ordinary `DImpl` behind
  -- the scenes once every method name resolves to a same-named top-level fn.
  interface Named(a) do
    fn name : a -> String
  end

  type Person = Person(String)

  fn name(p) do
    match p do
      Person(n) -> n
    end
  end

  satisfy Named for Person

  fn main() do
    println(name(Person("Ada")))
  end
end
