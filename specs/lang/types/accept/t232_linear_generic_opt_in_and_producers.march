mod Main do
  needs IO.Console
  -- What the generic rule keeps accepting. A function that opted in with
  -- `linear x : a` (and is then checked to use `x` exactly once); a generic
  -- function that only PRODUCES its type variable (`panic`, a constructor);
  -- constructors, which store each argument once; and every generic call at
  -- an unrestricted type.
  always_linear type S1 = S1(Int)
  fn sink(s : S1) : Int do match s do S1(e) -> e end end
  fn id(linear x : a) : a do x end
  fn pick(first : Bool, linear x : a, linear y : a) : (a, a) do
    if first do (x, y) else (y, x) end
  end
  fn main(c : Cap(IO.Console)) do
    let s = id(S1(1))
    let (p, q) = pick(true, S1(2), S1(3))
    let o = Some(S1(4))
    let n = match o do
      Some(v) -> sink(v)
      None -> 0
    end
    let xs = List.map([1, 2, 3], fn x -> x + 1)
    println(int_to_string(sink(s) + sink(p) + sink(q) + n + List.length(xs)))
  end
end
