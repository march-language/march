-- Session-types fix-campaign (F4, 2026-07-07): a BINARY protocol whose two
-- `choose` branches carry the SAME payload type now typechecks. Before the fix,
-- `project_steps`'s ProtoChoice arm applied the MPST merge rule unconditionally,
-- so the non-chooser (Server) projection collapsed from `SOffer{...}` to the
-- single shared `Recv(Int, End)` — no longer the dual of the chooser's
-- `SChoose{...}` — and `project_protocol`'s binary duality check rejected it as
-- "not duals of each other." The fix gates the merge on `multiparty`, so a
-- 2-role protocol's non-chooser always projects to `SOffer{...}` (it observes
-- the choice). Witnesses that identical-type branches are now legal in a binary
-- protocol. See core-march-types.md §2.7.5 and todos.md finding 20 (FIXED).
mod Main do
  type Client = Client
  type Server = Server

  protocol Decision do
    choose by Client:
      ok  -> Client -> Server : Int
      err -> Client -> Server : Int
    end
  end

  fn main() do
    let (cc, sc) = Chan.new(Decision)
    ()
  end
end
