mod Main do
  needs IO.Console
  -- A `linear x : a` opt-in is keyed on `a`'s type variable. When the body
  -- unifies `a` with another variable (here, passing `x` to a generic `g`),
  -- the opt-in must move with it. Rejected before 2026-09-18 ("`S1` is linear,
  -- but `w` is generic in a parameter of that type"), depending only on which
  -- way unification happened to link the two variables.
  always_linear type S1 = S1(Int)
  fn sink(s : S1) : Int do match s do S1(e) -> e end end
  fn g(linear x : b) : b do x end
  fn w(linear val : v) : v do g(val) end
  fn main(c : Cap(IO.Console)) do
    println(int_to_string(sink(w(S1(4)))))
  end
end
