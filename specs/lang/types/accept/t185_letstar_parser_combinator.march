-- `let*` works with the parser combinator library -- the ORIGINAL motivating
-- example for `let*` (specs/plans/2026-08-09-parsing-and-string-search.md
-- §4.3), which the feature could not actually express until 2026-08-17.
--
-- `let*` resolves `M`'s `flat_map` in the module named `M`. The combinator
-- library's type is `Parser`, but its module was called `Parse`, so `let*`
-- over a parser reported "`Parser.flat_map` doesn't exist" -- the one library
-- the sugar was designed for was the one library it did not work with. Fixed
-- by renaming the module to `Parser`, so type and module names agree the way
-- they already do for Option/Result/List.
--
-- This is context-SENSITIVE parsing: how many items follow is read from the
-- input itself, which is exactly what `flat_map` buys over `and_then`/`alt`
-- and cannot be expressed applicatively.
mod Main do
  needs IO.Console

  pfn digit() : Parser.Parser(Int) do
    Parser.byte_if("a digit", fn b -> b >= 48 && b <= 57)
  end

  -- a leading count says how many `x`s follow
  pfn counted() : Parser.Parser(List(String)) do
    let* n = digit()
    Parser.repeat(Parser.lit("x"), n - 48)
  end

  fn main(_cap_console : Cap(IO.Console)) : Unit do
    match Parser.run_all(counted(), "3xxx") do
      Ok(xs) -> println(int_to_string(List.length(xs)))
      Err(e) -> println(Parser.render("3xxx", e))
    end
  end
end
