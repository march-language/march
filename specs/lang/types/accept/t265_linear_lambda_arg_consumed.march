mod Main do
  needs IO.Console
  -- The accepting counterpart of reject/t269: a lambda checked before the
  -- argument that fixes its parameter to a linear type, which consumes it.
  -- The judgement deferred to `main`'s close finds it used exactly once.
  always_linear type S1 = S1(Int)
  fn sink(s : S1) : Int do match s do S1(e) -> e end end
  fn ap2(f : a -> Int, linear x : a) : Int do f(x) end
  fn main(c : Cap(IO.Console)) do
    println(int_to_string(ap2(fn s -> sink(s), S1(7))))
  end
end
