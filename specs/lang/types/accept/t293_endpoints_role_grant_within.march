-- Per-role grants (distributed-deploys step 4, 2026-09-22): `role Cons needs
-- IO.Console, IO.FileWrite` bounds everything `Cons`'s body reaches (since
-- ocap phase 7b it adds no `Cap` parameters to the body, which stays
-- `(Cap(Session.Live), Entry) -> Yield`), and `check_role_grants` walks everything the body reaches -- here `save`,
-- which writes a file ambiently (no capability value changes hands) -- and
-- finds it under the grant.  Reject twin: `reject/t294`, the same program with
-- `IO.FileWrite` taken out of the grant.
mod Main do
  needs IO
  needs IO.Console
  needs IO.FileWrite
  needs Session.Live
  @[endpoints]
  protocol Stream do
    role Cons needs IO.Console, IO.FileWrite
    loop do
      Prod -> Cons : Int
      choose by Cons:
        more -> Cons -> Prod : Bool
        done -> Cons -> Prod : Bool
                stop
      end
    end
  end

  pfn save(n : Int) : () do
    let _ = File.write("/tmp/n", int_to_string(n))
    ()
  end

  pfn cons(s : Cap(Session.Live), st : Stream_Cons.Entry) : Stream_Cons.Yield do
    Stream_Cons.recv_Msg_Prod_Cons_1(s, st, fn (n, st1) ->
      save(n)
      Stream_Cons.close(s, Stream_Cons.choose_done(s, st1, true)))
  end

  fn main() needs IO do
    let _ = Stream_Run.run_Cons("cons", "secret", Stream_Run.addrs_from_env(),
      fn (s, st) -> cons(s, st))
    ()
  end
end
