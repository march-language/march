-- F6: all 18 capability-hierarchy roots must be valid `Cap(X)` type ARGUMENTS.
-- `builtin_types` (`typecheck.ml`) previously registered only 10 of the 18
-- IO.* hierarchy entries as 0-arity type names, so writing `Cap(IO.Random)`,
-- `Cap(IO.Mut)`, `Cap(IO.Foreign)`, etc. — valid `needs` targets — was
-- rejected with `Unknown module `IO``. The missing 8 (IO.Random, IO.Database,
-- IO.Spawn, IO.Mut, IO.Telemetry, IO.Foreign, IO.Foreign.Blocking,
-- IO.NetConnect.TLS) are now registered, matching the hierarchy in
-- lib/caps/cap_lattice.ml. See core-march-types.md §2.8.11. IO.Registry (ocap
-- phase 2) is registered the same way.
-- Ocap phase 7b retired `Cap(IO.X)` values: the same coverage is now shown with a
-- function `needs` clause, which must lie within the module's `needs`
-- (`cap_bound_needs`); the comment above describes the original form.
mod HierApp do
  needs IO.Random
  needs IO.Mut
  needs IO.Foreign
  needs IO.Telemetry
  needs IO.Registry

  fn use_caps() : Int needs IO.Random, IO.Mut, IO.Foreign, IO.Telemetry, IO.Registry do
    0
  end
end
