mod Main do
  needs IO.Console
  -- What t212-t214's fix keeps accepting. An unannotated parameter used once
  -- on each path is fine (a use per branch is not a duplicate). One whose type
  -- is never fixed inside its own body is polymorphic and untouched: `id` at
  -- S1 and at Int, and every ordinary `fn x -> x + 1`.
  always_linear type S1 = S1(Int)
  fn sink(s : S1) : Int do match s do S1(e) -> e end end
  fn per_branch(b : Bool, st) : Int do
    if b do sink(st) else sink(st) end
  end
  fn id(x) do x end
  fn main(c : Cap(IO.Console)) do
    let f = fn st -> sink(st)
    let xs = List.map([1, 2, 3], fn x -> x + 1)
    let n = sink(id(S1(1))) + id(2) + per_branch(true, S1(3)) + f(S1(4))
    println(int_to_string(n + List.length(xs)))
  end
end
