-- Capabilities widening, Task 4 -- `cap no_alloc`, the ACCEPT side. Since
-- 2026-09-15 the cap makes every function in the module (nested modules,
-- impl methods and actor handlers included) carry a hard `@[no_alloc]`
-- contract, judged by `lib/tir/alloc_contract.ml` on the final TIR,
-- transitively over callees; `--check` lowers the program on demand to judge
-- it. `max3`'s nested `if`/`else` and `abs_diff`'s `let` + arithmetic
-- negation compile to scalar comparisons and subtraction with no heap cell
-- and no allocating callee, so `--check` exits 0 with no diagnostic. See
-- core-march-types.md §2.8.11.
mod NoAllocMath do
  cap no_alloc

  fn max3(a : Int, b : Int, c : Int) : Int do
    if a > b do
      if a > c do a else c end
    else
      if b > c do b else c end
    end
  end

  fn abs_diff(a : Int, b : Int) : Int do
    let d = a - b
    if d > 0 do d else 0 - d end
  end
end
