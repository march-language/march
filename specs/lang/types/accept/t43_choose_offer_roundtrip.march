mod Main do
  -- Session-types widening, Task 3 -- choose/offer full round-trip (accept).
  -- Complements t41 (plain send/recv/close). `Decision`'s two branches carry
  -- DIFFERENT payload types (Int vs String) so the MPST merge rule (F4,
  -- core-march-types.md finding 20) does not collapse Server's projection --
  -- this protocol's binary duality holds cleanly. `Chan.choose` (typecheck.ml
  -- :3564) requires SChoose and advances to the chosen branch's continuation;
  -- `Chan.offer` (:3614) requires SOffer and returns (Atom, Chan at some
  -- continuation).
  --
  -- Session-types Task 4 (2026-07-24, F5 residual): because `Decision`'s
  -- branches continue DIFFERENTLY, the channel `Chan.offer` returns is no
  -- longer usable at the guessed first-branch type -- driving it without a
  -- `match` on the paired label is now a hard error (reject/t95). This
  -- witness matches on `lbl` and drives the channel inside the matched arm.
  type Client = Client
  type Server = Server

  protocol Decision do
    choose by Client:
      ok  -> Client -> Server : Int
      err -> Client -> Server : String
    end
  end

  fn main() do
    let (cc, sc) = Chan.new(Decision)
    let cc2 = Chan.choose(cc, :ok)
    let cc3 = Chan.send(cc2, 42)
    Chan.close(cc3)
    let (lbl, sc2) = Chan.offer(sc)
    match lbl do
      :ok ->
        let (n, sc3) = Chan.recv(sc2)
        Chan.close(sc3)
        println(lbl)
        println(int_to_string(n))
      :err ->
        let (s, sc3) = Chan.recv(sc2)
        Chan.close(sc3)
        println(lbl)
        println(s)
      _ -> println("other")
    end
  end
end
