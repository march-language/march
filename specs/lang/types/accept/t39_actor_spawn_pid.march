mod Main do
  -- Widening actors slice, Task 1 -- ACTOR DECLARATION + `spawn` typing.
  -- `actor Counter do state {…} init {…} on Msg(…) do … end end` typechecks
  -- via `typecheck.ml`'s `DActor` arm (`:6742`): the state record type is built
  -- from the field decls (`:6744-6748`), `init` is CHECKED against that state
  -- type (`:6786`), and each handler body must RETURN the state record type
  -- (`:6789-6820`). The handler below reads `state.count` and returns a new
  -- `{ count: … }` record, so it type-conforms.
  --
  -- `spawn(Counter)` typechecks via the `ESpawn` arm (`:4185`): the argument is
  -- a bare actor NAME (`EVar`/`ECon(_,[],_)`, `:4194-4202`), so it is accepted;
  -- the expression's result type is `Pid[<fresh var>]` (`:4203`, `t_pid` alias
  -- `:983`). NOTE (see core-march-types.md §2.6): that parameter is a FRESH
  -- UNIFICATION VARIABLE, *not* the actor's state type -- the `Pid[state_ty]`
  -- binding at `:6821` is not what a bare `spawn(Counter)` observably yields.
  -- The `is_alive : Pid(a) -> Bool` builtin (`:1341`) accepts the result, its
  -- own polymorphic `a` unifying with that fresh var.
  actor Counter do
    state { count : Int }
    init  { count: 0 }

    on Inc() do
      { count: state.count + 1 }
    end
  end

  fn main() do
    let p = spawn(Counter)
    println(bool_to_string(is_alive(p)))
  end
end
