mod Main do
  needs IO.Console
  -- Widening actors slice, Task 1 -- ACTOR DECLARATION + `spawn` typing.
  -- `actor Counter do state {…} init {…} on Msg(…) do … end end` typechecks
  -- via `typecheck.ml`'s `DActor` arm (`:6742`): the state record type is built
  -- from the field decls (`:6744-6748`), `init` is CHECKED against that state
  -- type (`:6786`), and each handler body must RETURN the state record type
  -- (`:6789-6820`). The handler below reads `state.count` and returns a new
  -- `{ count: … }` record, so it type-conforms.
  --
  -- `spawn(Counter)` typechecks via the `ESpawn` arm (`:4185`): the argument is
  -- a bare actor NAME (`EVar`/`ECon(_,[],_)`), so it is accepted; the
  -- expression's result type is `Pid[state]` -- the ESpawn arm reaches the
  -- actor's `Pid[state_ty]` vars binding (made by the DActor arm) directly by
  -- name, since the nullary-ctor registration shadows it at ECon occurrences.
  -- (Historically this was `Pid[<fresh var>]` -- finding 18, fixed 2026-07-18;
  -- see accept/t87 for the state-type propagation witness and reject/t81 for
  -- the cross-actor Pid confusion this now catches.)
  -- The `is_alive : Pid(a) -> Bool` builtin accepts the result, its
  -- own polymorphic `a` unifying with the state record type.
  actor Counter do
    state { count : Int }
    init  { count: 0 }

    on Inc() do
      { count: state.count + 1 }
    end
  end

  fn main(_cap_console : Cap(IO.Console)) do
    let p = spawn(Counter)
    println(bool_to_string(is_alive(p)))
  end
end
