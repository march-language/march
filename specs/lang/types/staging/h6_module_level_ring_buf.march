-- H6: a module-level `let` of a RingBuf is a global every actor and thread
-- shares; the DLet arm has no linearity handling. Type-checks today.
mod Main do
  let shared = RingBuf.make(8)
  fn record(x : Int) : Unit do RingBuf.push(shared, x) end
  fn count() : Int do RingBuf.size(shared) end
  fn main() : Int do
    record(1)
    count()
  end
end
