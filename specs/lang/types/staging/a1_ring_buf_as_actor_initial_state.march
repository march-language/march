-- Phase 0 accept fixture: a RingBuf passed as initial actor state through
-- spawn(A, rb). check_spawn_args runs check_expr on each argument, so under
-- C2 this spawn is the consuming use of `rb`.
mod Main do
  actor Recent do
    state { buf : RingBuf(Int), n : Int }
    init(buf : RingBuf(Int)) { buf: buf, n: 0 }
    on Seen(x : Int) do
      RingBuf.push(state.buf, x)
      { state with n: state.n + 1 }
    end
  end
  fn main() : Int do
    let rb = RingBuf.make(8)
    let s = spawn(Recent, rb)
    send(s, Seen(1))
    0
  end
end
