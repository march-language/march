-- Phase 0 accept fixture: a RingBuf in a user record, updated with a record
-- update. This is the path where the ring_buf_* borrow-table entries are
-- load-bearing (the plan's C2 contract).
mod Main do
  type Recent = { buf : RingBuf(Int), count : Int }
  fn bump(r : Recent, x : Int) : Recent do
    RingBuf.push(r.buf, x)
    { r with count: r.count + 1 }
  end
  fn main() : Int do
    let r0 = { buf: RingBuf.make(4), count: 0 }
    let r1 = bump(r0, 1)
    let r2 = bump(r1, 2)
    r2.count + RingBuf.size(r2.buf)
  end
end
