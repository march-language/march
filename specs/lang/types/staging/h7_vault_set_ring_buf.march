-- H7: Vault.set puts a RingBuf in a process-global table that any thread
-- can read back; two handles alias one buffer. Type-checks today.
mod Main do
  needs IO.Mut
  fn main(_m : Cap(IO.Mut)) : Int do
    let t = Vault.new("bufs")
    let rb = RingBuf.make(4)
    Vault.set(t, "k", rb)
    RingBuf.push(rb, 1)
    match Vault.get(t, "k") do
      Some(other) -> RingBuf.size(other)
      None -> 0
    end
  end
end
