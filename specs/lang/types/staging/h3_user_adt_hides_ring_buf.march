-- H3: check_sendable visits a TCon's type ARGUMENTS, not its constructors'
-- fields, so a user ADT wrapping a RingBuf hides it. Type-checks today.
mod Main do
  type Wrap = Wrap(RingBuf(Int))
  actor Holder do
    state { n : Int }
    init { n: 0 }
    on Put(w : Wrap) do
      match w do
        Wrap(rb) -> RingBuf.push(rb, 1)
      end
      { n: state.n + 1 }
    end
  end
  fn main() : Int do
    let rb = RingBuf.make(4)
    let s = spawn(Holder)
    send(s, Put(Wrap(rb)))
    RingBuf.push(rb, 2)
    RingBuf.size(rb)
  end
end
