-- EXPECT-VIOLATED: postcondition Account.Steal.ensures
-- EXPECT-ERROR: A counterexample was found
-- Kind: two-state handler guarantee. `Steal` raises the balance it promises
-- not to raise.
mod K07 do
  @invariant(balance >= 0)
  actor Account do
    state { balance : Int }
    init { balance: 0 }

    on Steal(n : {Int | _ > 0}) ensures state.balance <= old(state.balance) do
      { balance: state.balance + n }
    end
  end
end
