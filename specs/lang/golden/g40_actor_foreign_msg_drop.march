mod Main do
  needs IO.Console
  -- Operational actor foreign-message-drop witness (core-march.md §4.10, finding
  -- 19 compiled-misroute fix). `send` does NOT gate a message by its target actor
  -- (a deferred type-system gap), so a `Logger` message (`Zlog`) can be sent to a
  -- `Counter` Pid and still typechecks (exit 0). The INTERPRETER matches handlers by
  -- NAME and silently DROPS a message no handler accepts (eval.ml `No handler for
  -- this message tag`). The COMPILED backend used to MISROUTE it: each actor's
  -- message type lowered to a per-actor variant dispatched by an ECase, so `Zlog`'s
  -- discriminant indexed into Counter's `Inc` slot and its String payload was
  -- reinterpreted as an Int — a large garbage `count` (memory-unsafe UB). The fix
  -- forces actor message types to a Boxed heap cell with a GLOBALLY-unique tag and
  -- gives the dispatch ECase a dropping default arm, so a foreign message's tag
  -- matches no branch and is dropped — byte-identical to the interpreter's drop.
  --
  -- Shape: a foreign `Zlog` drop sandwiched BETWEEN two count-changing messages
  -- (`Inc(3)`, drop `Zlog`, `Inc(4)`), then `Report` → `count=7`. This shape used
  -- to be flaky: it exposed finding 20, a compiled-only race where the first
  -- count-changing message's state write was LOST (~5-17%, printing `count=4`).
  -- Root cause was NOT the drop or the mailbox drain but FBIP in-place reuse: an
  -- actor handler wrote its new state back into the actor struct via an
  -- RC-conditional EReuse (in place iff the actor's RC == 1), and the main thread's
  -- concurrent atomic incrc/decrc of the actor `Pid` handle (Perceus RC of `c`
  -- across the sends) raced that check — a handler observing RC > 1 took the
  -- "fresh" branch, writing the update into a discarded copy. Fixed (2026-07-08)
  -- by making an actor-struct EReuse ALWAYS mutate in place (the actor is a
  -- daemon-owned singleton; its handle RC is irrelevant to state-write safety) —
  -- lib/tir/llvm_emit.ml. Now deterministic `count=7` in both backends.
  actor Counter do
    state { count : Int }
    init  { count: 0 }

    on Inc(n : Int) do
      { count: state.count + n }
    end

    on Report() do
      println("count=" ++ int_to_string(state.count))
      { count: state.count }
    end
  end

  actor Logger do
    state { seen : Int }
    init  { seen: 0 }

    on Zlog(m : String) do
      println("Logger.Zlog -> " ++ m)
      { seen: state.seen + 1 }
    end
  end

  fn main(_cap : Cap(IO.Console)) do
    let c = spawn(Counter)
    send(c, Inc(3))
    send(c, Zlog("stray"))   -- Zlog is a Logger message, not Counter's — dropped
    send(c, Inc(4))          -- the drop sits between two count-changing messages
    send(c, Report())        -- prints count=7 (3 + 4; the dropped Zlog adds nothing)
    run_until_idle()
  end
end
