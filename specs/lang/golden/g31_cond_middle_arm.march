mod Main do
  needs IO.Console
  -- ECond (the scrutinee-less `match do cond -> body end` boolean chain).
  -- The interpreter evaluates each arm's CONDITION top-to-bottom and selects
  -- the body of the FIRST arm whose condition is `VBool true`
  -- (eval.ml:7097-7106: `go` walks the arm list; `VBool true` -> run body,
  -- `VBool false` -> `go rest`). Here `grade(75)` makes the FIRST condition
  -- (`s > 89`) false and the SECOND (`s > 69`) true, so the MIDDLE arm is
  -- selected — earlier false arms are skipped, later arms (including the
  -- terminal `true` catch-all) are never consulted once one is selected.
  -- (The thresholds use `>` rather than `>=` for historical reasons — a `>=` in
  -- an ECond arm USED to confuse the token filter's arm-boundary lookahead and
  -- fail to parse (item 110). That is now FIXED; `>=`/`<=` in an ECond arm parse
  -- fine, witnessed by grammar `parse/p26_cond_arm_ge_le`. This golden keeps `>`
  -- since middle-arm selection, not the operator, is what it exercises.)
  fn grade(s) do
    match do
      s > 89 -> "A"
      s > 69 -> "B"
      s > 49 -> "C"
      true   -> "F"
    end
  end
  fn main(_cap_console : Cap(IO.Console)) do
    println(grade(95))
    println(grade(75))
    println(grade(60))
    println(grade(30))
  end
end
