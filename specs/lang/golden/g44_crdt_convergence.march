mod Main do
  -- Operational clustering witness (core-march.md §4.15): the pure
  -- conflict-free replicated data types converge deterministically and run
  -- byte-identically interpreted and compiled. This is the single-process,
  -- conformance-testable core of the distributed stack -- the CRDT / lattice
  -- laws. The live-network layers (handshake, SWIM gossip dispatch, RPC
  -- transport, cross-node monitor firing) are NOT single-process testable and
  -- are documented as a prose scope boundary in §4.15, exercised only by the
  -- native TCP-loopback tests under test/native/.
  --
  -- Finding C1 (specs/todos.md, FIXED 2026-07-11): the read-then-update map
  -- idiom `Map.insert(m, k, f(Map.get_or(m, k, ...)), cmp)` -- which
  -- underlies VectorClock.increment and CRDT counter updates -- used to
  -- miscompile into a use-after-free that surfaced when the resulting map
  -- was later read by folding its own keys and looking them up (e.g.
  -- VectorClock.compare on clocks with disjoint/partial key sets). Root
  -- cause: `lib/tir/llvm_case.ml`'s `strip_scrut_decrc` only recognized the
  -- scrutinee's own EDecRC as the LITERAL head of a match arm's body, but
  -- `add_cross_decrcs` can prepend OTHER cross-branch-dead variables' decs
  -- in front of it (e.g. Map.node_insert's HLeaf arm: `dec_rc eq; dec_rc
  -- node; ...`), silently defeating the shared-path field-protection that
  -- keeps an extracted String key's refcount correct when the scrutinee is
  -- shared. Fixed by generalizing `strip_scrut_decrc` to scan through a
  -- leading run of bare dec_rc ops for the scrutinee's own, preserving the
  -- others. This golden now includes the disjoint-key `VectorClock.compare`
  -- case that used to be excluded (below) -- the full CRDT/lattice core is
  -- unconditionally byte-identical and crash-free, not scoped around a bug.
  fn main() do
    -- Grow-only counter: a join-semilattice. Merge is commutative + idempotent.
    let a = CRDT.GCounter.add(CRDT.GCounter.increment(CRDT.GCounter.new(), "n1"), "n1", 4)  -- n1 -> 5
    let b = CRDT.GCounter.increment(CRDT.GCounter.new(), "n2")                                -- n2 -> 1
    let mab = CRDT.GCounter.merge(a, b)
    let mba = CRDT.GCounter.merge(b, a)
    println("gcounter.value=" ++ int_to_string(CRDT.GCounter.value(mab)))                    -- 6
    println("gcounter.commutes=" ++ bool_to_string(CRDT.GCounter.equal(mab, mba)))
    println("gcounter.idempotent=" ++ bool_to_string(CRDT.GCounter.equal(CRDT.GCounter.merge(mab, mab), mab)))

    -- Positive/negative counter: value = increments - decrements.
    let p = CRDT.PNCounter.decrement(CRDT.PNCounter.increment(CRDT.PNCounter.increment(CRDT.PNCounter.new(), "n1"), "n1"), "n1")
    println("pncounter.value=" ++ int_to_string(CRDT.PNCounter.value(p)))                    -- 1

    -- Observed-remove set: add/remove semantics + order-independent merge.
    let idf = fn s -> s
    let s1 = CRDT.ORSet.add(CRDT.ORSet.add(CRDT.ORSet.new(), "apple", idf, "t1"), "pear", idf, "t2")
    println("orset.size=" ++ int_to_string(CRDT.ORSet.size(s1)))                             -- 2
    println("orset.has_apple=" ++ bool_to_string(CRDT.ORSet.contains(s1, "apple", idf)))
    let s2 = CRDT.ORSet.remove(s1, "apple", idf)
    println("orset.removed=" ++ bool_to_string(not(CRDT.ORSet.contains(s2, "apple", idf))))
    println("orset.merge_converges=" ++ bool_to_string(CRDT.ORSet.equal(CRDT.ORSet.merge(s1, s2), CRDT.ORSet.merge(s2, s1))))

    -- Vector-clock causality on causally-ORDERED clocks (v1 -> v2): a partial
    -- order in which happens_before holds one way and not the other.
    let v1 = VectorClock.increment(VectorClock.increment(VectorClock.new(), "n1"), "n1")
    let v2 = VectorClock.increment(v1, "n1")
    println("vclock.v1_before_v2=" ++ bool_to_string(VectorClock.happens_before(v1, v2)))
    println("vclock.not_v2_before_v1=" ++ bool_to_string(VectorClock.happens_before(v2, v1) == false))

    -- Vector-clock causality on CONCURRENT clocks with disjoint actor-id
    -- sets -- the case finding C1 used to make compiled-only unsafe. Neither
    -- clock's slot dominates the other's, so `compare` classifies them
    -- Concurrent (neither happens_before nor equal).
    let cx = VectorClock.increment(VectorClock.new(), "x")
    let cy = VectorClock.increment(VectorClock.new(), "y")
    println("vclock.disjoint_concurrent=" ++ bool_to_string(VectorClock.concurrent(cx, cy)))
    println("done")
  end
end
