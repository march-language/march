mod Main do
  needs IO.Console
  fn describe(msg) do
    "error: " ++ msg
  end

  fn main(_cap_console : Cap(IO.Console)) do
    let result = :error("disk full")
    match result do
      :ok -> println("no error")
      :error(msg) -> println(describe(msg))
      _ -> println("unknown result")
    end
  end
end
