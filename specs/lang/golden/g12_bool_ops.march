mod Main do
  needs IO.Console
  fn main(_cap_console : Cap(IO.Console)) do
    println(bool_to_string(true && true))
    println(bool_to_string(true && false))
    println(bool_to_string(false || true))
    println(bool_to_string(false || false))
    println(bool_to_string(!true))
    println(bool_to_string(not(false)))
    println("a" ++ "b")
  end
end
