mod Main do
  -- A local, self-referential `fn go` inside a block (an ELetFn statement,
  -- alongside `let`s) computes factorial recursively. `go` calls ITSELF: the
  -- interpreter ties the recursive knot with the env_ref back-patch
  -- (eval.ml:6875-6884) — go is bound to a VBuiltin wrapper whose body re-reads
  -- the extended env (which contains go itself) on every call (eval.ml:6879-6883).
  fn main() do
    fn go(n) do
      if n == 0 do
        1
      else
        n * go(n - 1)
      end
    end
    println(int_to_string(go(5)))
    println(int_to_string(go(0)))
  end
end
