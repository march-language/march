mod Main do
  needs IO.Console
  -- Operational linearity witness (core-march.md §4.12): linear/affine
  -- annotations are COMPILE-TIME-ERASED -- a linearity-correct program runs
  -- byte-identically interpreted and compiled, with no runtime use-accounting
  -- on either backend. Exercises all three keyword surfaces: a `linear` fn
  -- param (consumed once via match INSIDE the callee), a `linear let`
  -- (consumed once by the call), and an `affine` type-modifier binding
  -- consumed by a DIRECT match.
  --
  -- The direct match on the affine-annotated binding is ALSO the regression
  -- witness for finding L7 (FIXED 2026-07-10): escape analysis used to
  -- stack-promote the non-escaping Newtype-repr alloc R(22) into a boxed
  -- stack cell that the match then decoded under the erased convention
  -- (untagging the raw stack ADDRESS) -- this golden's first-ever run caught
  -- it printing nondeterministic garbage. Erased-repr (Newtype/Niche) allocs
  -- are no longer stack-promotion candidates (lib/tir/escape.ml
  -- alloc_emits_heap_cell), and llvm_emit's EStackAlloc arm fails loudly if
  -- one ever slips through.
  --
  -- Type named Res, NOT Handle -- always_linear_types is name-keyed globally
  -- and stdlib handle.march claims Handle (finding L4, specs/todos.md).
  type Res = R(Int)
  fn take(linear q : Res) : Int do
    match q do
      R(n) -> n
    end
  end
  fn main(_cap_console : Cap(IO.Console)) do
    linear let r : Res = R(20)
    let a = take(r)
    let c : affine Res = R(22)
    let b = match c do
      R(n) -> n
    end
    println(int_to_string(a + b))
    println("done")
  end
end
