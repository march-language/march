# HTML contextual-escaping transition table.
#
# SOURCE OF TRUTH. lib/ctxesc/table_data.ml and stdlib/ctx_table.march are
# GENERATED from this file -- see specs/security/README.md for the format, the
# regeneration command, and the invariant every row must preserve (a hole's
# successor context must never depend on the interpolated value).
#
# Rows are tried IN ORDER; first match wins. Keep `any` last within each state.

[tags]
# tag-name-pattern | element class
script             | script
style              | style
textarea           | textarea
title              | title
*                  | normal

[attrs]
# attr-name-pattern | attr class    (first match wins -- keep on* first)
#
# EVERY attribute whose value a browser will FETCH or NAVIGATE TO belongs here.
# Classification is exact-match unless the pattern ends in `*`, so an attribute
# that is missing falls through to `*` -> normal -> the plain attribute escaper,
# which entity-encodes quotes and angle brackets and passes `javascript:`
# through untouched. That is how `xlink:href`, `object data` and `ping` were
# live XSS/SSRF vectors until 2026-08-20; see
# specs/progress/2026-08-20-h-sigil-js-and-url-attr-xss.md. A miss here is
# silent, so err towards listing an attribute.
on*                 | script
href                | url
xlink:href          | url    # the SVG spelling of href -- executes javascript:
src                 | url
action              | url
formaction          | url
poster              | url
cite                | url
background          | url
data                | url    # <object data="javascript:..."> executes. EXACT match, so data-* attributes are untouched.
ping                | url    # fetched on click, so an unvalidated value is an outbound request the page never showed
manifest            | url
longdesc            | url
srcset              | srcset   # a candidate LIST, not one URL -- rejected, see below
srcdoc              | htmldoc  # HTML-decoded, then parsed as a document -- rejected, see below
style               | style
*                   | normal

[transitions]
# from-context | pattern | substitution | successor-context | diagnostic

# ── PCDATA ───────────────────────────────────────────────────────────────
# A comment is entered before the `<` rules so `<!--` wins over `<`.
pcdata,*,*,*          | lit:"<!--"      |  | comment,=,=,=            |
pcdata,*,*,*          | lit:"</"        |  | closetagname,=,=,=       |
pcdata,*,*,*          | lit:"<"         |  | tagname,=,=,=            |
pcdata,*,*,*          | interp          |  | =,=,=,=                  |
pcdata,*,*,*          | any             |  | =,=,=,=                  |

# ── TAG NAME (opening) ───────────────────────────────────────────────────
# `tag` consumes the name AND sets the element class from [tags].
tagname,*,*,*         | interp          |  | =,=,=,=                  | Cannot interpolate an element name. No escaping can make an attacker-chosen tag name safe -- move the dynamic part into element content or an attribute value.
tagname,*,*,*         | tag             |  | beforeattrname,=,=,=     |
tagname,*,*,*         | any             |  | =,=,=,=                  |

# ── TAG NAME (closing) ───────────────────────────────────────────────────
# A close tag returns to PCDATA and clears the element class.
closetagname,*,*,*    | interp          |  | =,=,=,=                  | Cannot interpolate an element name.
closetagname,*,*,*    | lit:">"         |  | pcdata,normal,normal,none |
closetagname,*,*,*    | any             |  | =,=,=,=                  |

# ── BEFORE ATTRIBUTE NAME ────────────────────────────────────────────────
# Leaving the tag enters RCDATA for script/style/textarea/title, PCDATA
# otherwise -- hence the element-specific rows above the general one.
beforeattrname,script,*,*   | lit:">"   |  | rcdata,=,normal,none     |
beforeattrname,style,*,*    | lit:">"   |  | rcdata,=,normal,none     |
beforeattrname,textarea,*,* | lit:">"   |  | rcdata,=,normal,none     |
beforeattrname,title,*,*    | lit:">"   |  | rcdata,=,normal,none     |
beforeattrname,*,*,*  | lit:"/>"        |  | pcdata,normal,normal,none |
beforeattrname,*,*,*  | lit:">"         |  | pcdata,=,normal,none     |
beforeattrname,*,*,*  | cls+:[ \t\r\n]  |  | =,=,=,=                  |
beforeattrname,*,*,*  | interp          |  | =,=,=,=                  | Cannot interpolate where an attribute name is expected. An attacker-chosen name can introduce an event handler such as `onerror`, which no escaping prevents -- interpolate an attribute VALUE instead.
beforeattrname,*,*,*  | name            |  | afterattrname,=,=,=      |
beforeattrname,*,*,*  | any             |  | =,=,=,=                  |

# ── AFTER ATTRIBUTE NAME ─────────────────────────────────────────────────
afterattrname,*,*,*   | cls+:[ \t\r\n]  |  | =,=,=,=                  |
afterattrname,*,*,*   | lit:"="         |  | beforeattrvalue,=,=,=    |
afterattrname,*,*,*   | lit:"/>"        |  | pcdata,normal,normal,none |
afterattrname,*,*,*   | lit:">"         |  | pcdata,=,normal,none     |
afterattrname,*,*,*   | interp          |  | =,=,=,=                  | Cannot interpolate an attribute name.
afterattrname,*,*,*   | any             |  | beforeattrname,=,=,=     |

# ── BEFORE ATTRIBUTE VALUE ───────────────────────────────────────────────
# The substitution rule: an unquoted value that is about to receive a hole gets
# a `"` inserted, and `doublesubst` remembers to close it. Without this, a value
# containing a space would end the attribute and start a new one.
beforeattrvalue,*,*,* | cls+:[ \t\r\n]  |  | =,=,=,=                  |
beforeattrvalue,*,*,* | lit:"\""        |  | attrvalue,=,=,double     |
beforeattrvalue,*,*,* | lit:"'"         |  | attrvalue,=,=,single     |
# An unquoted URL value: a hole here is the whole URL, exactly as after `href="`,
# and its first literal character starts the scheme sub-automaton below rather
# than being swallowed by the generic `any` (which would leave the context at
# the START of the URL with one character already written).
beforeattrvalue,*,url,* | interp                  | "\"" | attrvalue,=,urlschemehole,doublesubst |
beforeattrvalue,*,url,* | lit:"&#"                |  | attrvalue,=,urlschemeref,unquoted |
beforeattrvalue,*,url,* | lit:"&"                 |  | attrvalue,=,urlschemeref,unquoted |
beforeattrvalue,*,url,* | lit:"%"                 |  | attrvalue,=,urlpct,unquoted |
beforeattrvalue,*,url,* | cls:[a-zA-Z0-9+.;-]     |  | attrvalue,=,urlscheme,unquoted |
beforeattrvalue,*,url,* | lit:"?"                 |  | attrvalue,=,urlquery,unquoted |
beforeattrvalue,*,url,* | lit:"#"                 |  | attrvalue,=,urlfragment,unquoted |
beforeattrvalue,*,url,* | any                     |  | attrvalue,=,urlmid,unquoted   |
beforeattrvalue,*,*,* | interp          | "\"" | attrvalue,=,=,doublesubst |
beforeattrvalue,*,*,* | any             |  | attrvalue,=,=,unquoted   |

# ── ATTRIBUTE VALUE ──────────────────────────────────────────────────────
# ORDER MATTERS HERE, twice over.
#
# 1. The rows that END the value come first. They are delimiter-specific, and
#    if any catch-all sat above them it would swallow the closing quote and the
#    automaton would never leave the attribute.
# 2. URL position: a hole at the START of a url attribute IS the whole URL and
#    needs a scheme allowlist (`href="${u}"` with `javascript:` must not pass),
#    while a hole after literal content is a COMPONENT needing percent-encoding.
#    Rather than add a fifth context field, the URL's scheme sub-automaton is
#    encoded in `attr` (see "URL scheme tracking" below).

# -- rows that leave the attribute value --
attrvalue,*,*,double      | lit:"\""       |  | beforeattrname,=,normal,none |
attrvalue,*,*,single      | lit:"'"        |  | beforeattrname,=,normal,none |
# A substituted value is closed by the automaton, not by the source text: the
# quote in the substitution column is emitted on the way out.
attrvalue,*,*,doublesubst | lit:"/>"       | "\"" | pcdata,normal,normal,none |
attrvalue,*,*,doublesubst | lit:">"        | "\"" | pcdata,=,normal,none     |
attrvalue,*,*,doublesubst | cls+:[ \t\r\n] | "\"" | beforeattrname,=,normal,none |
attrvalue,*,*,unquoted    | lit:"/>"       |  | pcdata,normal,normal,none |
attrvalue,*,*,unquoted    | lit:">"        |  | pcdata,=,normal,none     |
attrvalue,*,*,unquoted    | cls+:[ \t\r\n] |  | beforeattrname,=,normal,none |

# -- URL scheme tracking (must precede the generic `any`) --
# The scheme is everything before the first `:`, provided all of it is
# scheme-shaped. The whole-URL escaper checks the scheme of ONE VALUE, so it is
# only sound if no other text can extend that value's scheme. Until 2026-10-11
# the first literal character demoted `url` -> `urlmid` unconditionally, so
#   href="${s}://${rest}"   with s = `javascript`
# passed `javascript` (no colon: a relative reference), then appended a literal
# `:` that turned it into the scheme, and rendered an executable
# `javascript://%0Aalert%281%29`. The positions below track whether the
# scheme is still open and whether a hole has contributed to it:
#
#   url              nothing written yet (leading space/C0 is stripped by
#                    the URL parser, so it does not count)
#   urlscheme        only literal, scheme-shaped text so far
#   urlschemehole    scheme still open, and a whole-URL hole wrote into it
#   urlschemeholemid scheme still open, a hole wrote into it, and literal
#                    text followed (later holes are components again)
#   urlmid           the scheme is settled: `/`, `?`, `:`, or any other
#                    non-scheme character was written by the template
#
# A literal `:` (or an entity that decodes to one) while a hole has written
# into the open scheme is REJECTED: that colon would let the interpolated
# value choose the scheme. `&`, `&#` and `;` keep the scheme open because they
# spell character references (`java&#115;cript:` is `javascript:` once the
# HTML parser has decoded the attribute); tab, CR and LF keep it open because
# the URL parser deletes them. Both are over-approximations: the cost is a
# compile error for a template like `href="${a}&x:y"`, never a missed scheme.
# A `#` on its own settles the scheme (it starts the fragment).
# The escapers are unchanged by this tracking, with one exception: a hole
# after nothing but leading whitespace (`href=" ${u}"`) is at the start of the
# URL once the URL parser strips that whitespace, so it now gets the whole-URL
# escaper rather than the component one. Otherwise only the rejection is new.
attrvalue,*,url,*              | interp                  |  | =,=,urlschemehole,=    |
attrvalue,*,url,*              | cls+:[ \t\r\n]          |  | =,=,=,=                |
attrvalue,*,url,*              | lit:"&#"                |  | =,=,urlschemeref,=     |
attrvalue,*,url,*              | lit:"&"                 |  | =,=,urlschemeref,=     |
attrvalue,*,url,*              | lit:"%"                 |  | =,=,urlpct,=           |
attrvalue,*,url,*              | cls:[a-zA-Z0-9+.;-]     |  | =,=,urlscheme,=        |
attrvalue,*,url,*              | lit:"?"                 |  | =,=,urlquery,=         |
attrvalue,*,url,*              | lit:"#"                 |  | =,=,urlfragment,=      |
attrvalue,*,url,*              | any                     |  | =,=,urlmid,=           |
attrvalue,*,urlscheme,*        | interp                  |  | =,=,urlschemeholemid,= |
attrvalue,*,urlscheme,*        | lit:"&#"                |  | =,=,urlschemeref,=     |
attrvalue,*,urlscheme,*        | lit:"&"                 |  | =,=,urlschemeref,=     |
attrvalue,*,urlscheme,*        | lit:"%"                 |  | =,=,urlpct,=           |
attrvalue,*,urlscheme,*        | cls+:[a-zA-Z0-9+.;\t\r\n-] |  | =,=,=,=            |
attrvalue,*,urlscheme,*        | lit:"?"                 |  | =,=,urlquery,=         |
attrvalue,*,urlscheme,*        | lit:"#"                 |  | =,=,urlfragment,=      |
attrvalue,*,urlscheme,*        | any                     |  | =,=,urlmid,=           |
# `urlschemeref` is `urlscheme` after the template has written a character
# reference (any `&`) since the last hole. It differs only in rejecting a
# hole: the HTML parser decodes a numeric reference with or without its `;`,
# so `href="javascript&#${x}alert(1)"` with x = `58` rendered
# `javascript&#58alert(1)` -- `javascript:` -- and `&#37;` before a hole lets
# the hole finish a percent-escape. The table cannot decode a reference, so it
# rejects the hole after ANY reference here; the scheme is still open, so the
# over-strictness only costs templates that spell their scheme with
# references.
attrvalue,*,urlschemeref,*     | interp                  |  | =,=,=,=                | An interpolation right after a character reference, in a URL whose scheme is not settled yet, can finish that reference or the escape it starts: an unfinished numeric reference completed by the value with `58` decodes to `:` (so `javascript` followed by it becomes `javascript:`), and a reference for `%` lets the value finish a percent-escape such as `%2e`. The table cannot decode references, so a hole after any of them is rejected here. Write the character literally, or build the whole URL in one interpolation.
attrvalue,*,urlschemeref,*     | lit:"&#"                |  | =,=,=,=                |
attrvalue,*,urlschemeref,*     | lit:"&"                 |  | =,=,=,=                |
attrvalue,*,urlschemeref,*     | lit:"%"                 |  | =,=,urlpct,=           |
attrvalue,*,urlschemeref,*     | cls+:[a-zA-Z0-9+.;\t\r\n-] |  | =,=,=,=            |
attrvalue,*,urlschemeref,*     | lit:"?"                 |  | =,=,urlquery,=         |
attrvalue,*,urlschemeref,*     | lit:"#"                 |  | =,=,urlfragment,=      |
attrvalue,*,urlschemeref,*     | any                     |  | =,=,urlmid,=           |
attrvalue,*,urlschemehole,*    | lit:":"                 |  | =,=,=,=                | A literal `:` right after an interpolation at the start of a URL lets the interpolated value choose the URL's scheme: `${s}:` with s = `javascript` passes the scheme allowlist (it has no colon of its own) and then becomes `javascript:`. Build the whole URL first and interpolate it as ONE hole, so the allowlist sees its scheme, or write the scheme literally in the template.
attrvalue,*,urlschemehole,*    | lit:"&#"                |  | =,=,=,=                | A numeric character reference right after an interpolation at the start of a URL can decode to `:` and let the interpolated value choose the URL's scheme. Write the character literally, or build the whole URL in one interpolation.
attrvalue,*,urlschemehole,*    | ilit:"&colon;"          |  | =,=,=,=                | `&colon;` right after an interpolation at the start of a URL decodes to `:` and lets the interpolated value choose the URL's scheme. Build the whole URL in one interpolation so the scheme allowlist sees it.
attrvalue,*,urlschemehole,*    | ilit:"&percnt;"         |  | =,=,=,=                | `&percnt;` right after an interpolation at the start of a URL decodes to `%`, and the next interpolation could finish the percent-escape it starts (`%2e` is a dot to the URL parser). Write `%` literally, or build the whole URL in one interpolation.
attrvalue,*,urlschemehole,*    | interp                  |  | =,=,=,=                |
attrvalue,*,urlschemehole,*    | cls+:[\t\r\n]           |  | =,=,=,=                |
attrvalue,*,urlschemehole,*    | lit:"%"                 |  | =,=,urlpct,=           |
attrvalue,*,urlschemehole,*    | cls:[a-zA-Z0-9+.&;-]    |  | =,=,urlschemeholemid,= |
attrvalue,*,urlschemehole,*    | lit:"?"                 |  | =,=,urlquery,=         |
attrvalue,*,urlschemehole,*    | lit:"#"                 |  | =,=,urlfragment,=      |
attrvalue,*,urlschemehole,*    | any                     |  | =,=,urlmid,=           |
attrvalue,*,urlschemeholemid,* | lit:":"                 |  | =,=,=,=                | A literal `:` after an interpolation that is still part of the URL's scheme lets the interpolated value choose the scheme: `java${s}:` with s = `script` renders `javascript:`. Build the whole URL in one interpolation so the scheme allowlist sees it, or write the scheme literally in the template.
attrvalue,*,urlschemeholemid,* | lit:"&#"                |  | =,=,=,=                | A numeric character reference after an interpolation that is still part of the URL's scheme can decode to `:` and let the interpolated value choose the scheme. Write the character literally, or build the whole URL in one interpolation.
attrvalue,*,urlschemeholemid,* | ilit:"&colon;"          |  | =,=,=,=                | `&colon;` after an interpolation that is still part of the URL's scheme decodes to `:` and lets the interpolated value choose the scheme. Build the whole URL in one interpolation so the scheme allowlist sees it.
attrvalue,*,urlschemeholemid,* | ilit:"&percnt;"         |  | =,=,=,=                | `&percnt;` after an interpolation that is still part of the URL's scheme decodes to `%`, and the next interpolation could finish the percent-escape it starts (`%2e` is a dot to the URL parser). Write `%` literally, or build the whole URL in one interpolation.
attrvalue,*,urlschemeholemid,* | interp                  |  | =,=,=,=                |
# `&` is consumed ONE AT A TIME (here and in `urlscheme`), never inside a
# greedy class: a greedy run would stop between `&` and `#`, and the `&#`
# rows would never see the reference.
attrvalue,*,urlschemeholemid,* | lit:"&"                 |  | =,=,=,=                |
attrvalue,*,urlschemeholemid,* | lit:"%"                 |  | =,=,urlpct,=           |
attrvalue,*,urlschemeholemid,* | cls+:[a-zA-Z0-9+.;\t\r\n-] |  | =,=,=,=            |
attrvalue,*,urlschemeholemid,* | lit:"?"                 |  | =,=,urlquery,=         |
attrvalue,*,urlschemeholemid,* | lit:"#"                 |  | =,=,urlfragment,=      |
attrvalue,*,urlschemeholemid,* | any                     |  | =,=,urlmid,=           |

# -- URL path vs query vs fragment (must precede the generic `any`) --
# Once the scheme is settled, a hole is a percent-encoded component wherever it
# sits, so it can never write a `/`, `?`, `#`, `@` or `:` of its own. What the
# component escaper does NOT stop is a value of nothing but dots: in a PATH it
# fills a segment and becomes a dot segment, so
#   href="/users/${id}/edit"   with id = `..`
# renders `/users/../edit`, which the URL parser resolves to `/edit` -- a
# client-side path traversal for every attribute that fetches (`src`,
# `action`, `ping`, ...). Percent-encoding cannot fix it, because the URL
# parser reads `%2e` as `.` when it removes dot segments, so path holes get
# their own escaper (`url_path`) that replaces an all-dot value outright. A
# dot segment means nothing in a query or fragment, and `?q=..` is honest
# data, so those positions are tracked separately and keep the plain component
# escaper. `urlmid` is therefore the PATH (or authority) position.
#
# The literal `?` / `#` is the only way in. An entity spelling of either
# (`&#63;`) leaves the walk in the path, which costs an honest query value of
# `..` its dots -- the over-strict direction. A hole can never move the walk,
# because the escapers encode both characters.
#
# The `&#` rows come FIRST, and are not decoration: the `#` of a numeric
# character reference is not a fragment delimiter. Without them
# `href="/a/&#46;${x}/b"` would read as a fragment, give the hole the plain
# component escaper, and render `/a/../b` for x = `.`.
#
# -- an escape the HOLE could finish (2026-10-11) --
# The path escaper judges the value alone. When the TEMPLATE has already
# started an escape, the value only has to finish it:
#   href="/users/.%${x}/edit"   with x = `2e`
# rendered `/users/.%2e/edit`, which the URL parser reads as `/users/../edit`.
# So a hole is REJECTED right after a literal `%` or `%` plus one hex digit
# (`urlpct`, `urlpct1`), and right after a numeric character reference
# (`urlref`): `&#37;` decodes to the `%`, and a bare `&#` is finished by the
# value itself (`&#${x}` with x = `46` is a dot). `&percnt;` is the one named
# reference for `%`. Every open-scheme position above routes `%` here too: a
# `%` cannot be part of a scheme, so it settles it. The over-approximations
# all run in the strict direction: since the table cannot decode a numeric
# reference, a hole right after ANY of them in a path is rejected.
attrvalue,*,urlmid,*           | lit:"&#"                |  | =,=,urlref,=           |
attrvalue,*,urlmid,*           | ilit:"&percnt;"         |  | =,=,urlpct,=           |
attrvalue,*,urlmid,*           | lit:"%"                 |  | =,=,urlpct,=           |
attrvalue,*,urlquery,*         | lit:"&#"                |  | =,=,=,=                |
attrvalue,*,urlmid,*           | lit:"?"                 |  | =,=,urlquery,=         |
attrvalue,*,urlmid,*           | lit:"#"                 |  | =,=,urlfragment,=      |
attrvalue,*,urlquery,*         | lit:"#"                 |  | =,=,urlfragment,=      |
attrvalue,*,urlpct,*           | interp                  |  | =,=,=,=                | An interpolation right after a literal `%` in a URL path can finish the percent-escape: `/users/.%${x}/edit` with x = `2e` renders `/users/.%2e/edit`, which the URL parser reads as `/users/../edit`. Percent-encode inside the value you interpolate, not around it, or write the whole escape in the template.
attrvalue,*,urlpct,*           | cls:[0-9a-fA-F]         |  | =,=,urlpct1,=          |
attrvalue,*,urlpct1,*          | interp                  |  | =,=,=,=                | An interpolation right after `%` and one hex digit in a URL path can finish the percent-escape: `/a/.%2${x}` with x = `e` renders `/a/.%2e`, which the URL parser reads as `/a/..`. Percent-encode inside the value you interpolate, not around it, or write the whole escape in the template.
attrvalue,*,urlpct1,*          | cls:[0-9a-fA-F]         |  | =,=,urlmid,=           |
attrvalue,*,urlref,*           | interp                  |  | =,=,=,=                | An interpolation right after a numeric character reference in a URL path can finish it or the escape it starts: an unfinished numeric reference completed by the value with `46` decodes to a second dot after `/a/.`, and a reference for `%` lets the value turn it into `%2e`. The table cannot decode references, so a hole after any of them is rejected here. Write the character literally, or put the whole segment in the interpolation.
attrvalue,*,urlref,*           | cls+:[0-9a-fA-FxX;]     |  | =,=,=,=                |
# Anything else after `%`, `%X` or a reference reads exactly as it would in
# the path.
attrvalue,*,urlpct,*           | lit:"&#"                |  | =,=,urlref,=           |
attrvalue,*,urlpct1,*          | lit:"&#"                |  | =,=,urlref,=           |
attrvalue,*,urlref,*           | lit:"&#"                |  | =,=,urlref,=           |
attrvalue,*,urlpct,*           | ilit:"&percnt;"         |  | =,=,urlpct,=           |
attrvalue,*,urlpct1,*          | ilit:"&percnt;"         |  | =,=,urlpct,=           |
attrvalue,*,urlref,*           | ilit:"&percnt;"         |  | =,=,urlpct,=           |
attrvalue,*,urlpct,*           | lit:"%"                 |  | =,=,urlpct,=           |
attrvalue,*,urlpct1,*          | lit:"%"                 |  | =,=,urlpct,=           |
attrvalue,*,urlref,*           | lit:"%"                 |  | =,=,urlpct,=           |
attrvalue,*,urlpct,*           | lit:"?"                 |  | =,=,urlquery,=         |
attrvalue,*,urlpct1,*          | lit:"?"                 |  | =,=,urlquery,=         |
attrvalue,*,urlref,*           | lit:"?"                 |  | =,=,urlquery,=         |
attrvalue,*,urlpct,*           | lit:"#"                 |  | =,=,urlfragment,=      |
attrvalue,*,urlpct1,*          | lit:"#"                 |  | =,=,urlfragment,=      |
attrvalue,*,urlref,*           | lit:"#"                 |  | =,=,urlfragment,=      |
attrvalue,*,urlpct,*           | any                     |  | =,=,urlmid,=           |
attrvalue,*,urlpct1,*          | any                     |  | =,=,urlmid,=           |
attrvalue,*,urlref,*           | any                     |  | =,=,urlmid,=           |

# -- CSS url() gets its own context --
# A hole inside url(...) is a URL, not a CSS value. Escaping it as CSS mangles
# the slashes and breaks the reference; escaping it as a plain URL would leave
# `)` free to close the construct. `ilit` because `URL(` is valid CSS.
# These MUST precede the generic style/stylevalue rows below.
#
# -- CSS url() scheme tracking (2026-10-11) --
# The CSS url escaper checks the scheme of ONE value, exactly as the whole-URL
# escaper does for `href`, so the same composition defeated it:
#   style="background:url(${s}:x)"   with s = `javascript`
# passed `javascript` (no colon: a relative reference) and the template's own
# `:` made it the scheme. No current browser runs `javascript:` from CSS, but
# the rule is the same as `href`'s (owner decision, 2026-10-11): a literal
# `:` that would let a hole choose the scheme is a compile error. Positions,
# all of which give a hole the CSS url escaper:
#
#   cssurl        nothing written yet but whitespace and an opening quote
#   cssurlscheme  only literal, scheme-shaped text so far
#   cssurlref     scheme still open, and the template wrote a character
#                 reference or a CSS escape since the last hole -- a hole here
#                 could FINISH it (`\` then `00003a` is the escape for `:`),
#                 so a hole is rejected
#   cssurlhole    scheme still open, and a hole wrote into it: a `:`, a
#                 reference or a CSS escape (either can decode to `:`) is
#                 rejected
#   cssurlmid     the scheme is settled
#
# Every one of them leaves on `)`. CSS has two decoders between the template
# and the URL -- HTML references in an attribute, CSS escapes in both
# wrappers -- so both `&` and `\` are tracked; in a <style> body references
# are not decoded, which only makes the body copy over-strict.
attrvalue,*,style,*       | ilit:"url("    |  | =,=,cssurl,=             |
attrvalue,*,stylevalue,*  | ilit:"url("    |  | =,=,cssurl,=             |
attrvalue,*,cssurl,*        | lit:")"                            |  | =,=,stylevalue,=        |
attrvalue,*,cssurlscheme,*  | lit:")"                            |  | =,=,stylevalue,=        |
attrvalue,*,cssurlref,*     | lit:")"                            |  | =,=,stylevalue,=        |
attrvalue,*,cssurlhole,*    | lit:")"                            |  | =,=,stylevalue,=        |
attrvalue,*,cssurlmid,*     | lit:")"                            |  | =,=,stylevalue,=        |
attrvalue,*,cssurl,*        | interp                             |  | =,=,cssurlhole,=        |
attrvalue,*,cssurl,*        | cls+:[ \t\r\n]                     |  | =,=,=,=                 |
attrvalue,*,cssurl,*        | lit:"'"                            |  | =,=,=,=                 |
attrvalue,*,cssurl,*        | lit:"\""                           |  | =,=,=,=                 |
attrvalue,*,cssurl,*        | ilit:"&quot;"                      |  | =,=,=,=                 |
attrvalue,*,cssurl,*        | ilit:"&apos;"                      |  | =,=,=,=                 |
attrvalue,*,cssurl,*        | lit:"&#34;"                        |  | =,=,=,=                 |
attrvalue,*,cssurl,*        | lit:"&#39;"                        |  | =,=,=,=                 |
attrvalue,*,cssurl,*        | cls:[&\\]                          |  | =,=,cssurlref,=         |
attrvalue,*,cssurl,*        | cls:[a-zA-Z0-9+.;-]                |  | =,=,cssurlscheme,=      |
attrvalue,*,cssurl,*        | any                                |  | =,=,cssurlmid,=         |
attrvalue,*,cssurlscheme,*  | interp                             |  | =,=,cssurlhole,=        |
attrvalue,*,cssurlscheme,*  | cls:[&\\]                          |  | =,=,cssurlref,=         |
attrvalue,*,cssurlscheme,*  | cls+:[a-zA-Z0-9+.;\t\r\n-]         |  | =,=,=,=                 |
attrvalue,*,cssurlscheme,*  | any                                |  | =,=,cssurlmid,=         |
attrvalue,*,cssurlref,*     | interp                             |  | =,=,=,=                 | An interpolation right after a character reference or CSS escape, in a CSS url() whose scheme is not settled yet, can finish it: `url(javascript\${x}...)` with x = `00003a` renders the CSS escape for `:`, and an unfinished numeric reference completed with `58` decodes to one too. Write the character literally, or build the whole URL in one interpolation.
attrvalue,*,cssurlref,*     | cls+:[a-zA-Z0-9+.;&\\ \t\r\n-]     |  | =,=,=,=                 |
attrvalue,*,cssurlref,*     | lit:"#"                            |  | =,=,=,=                 |
attrvalue,*,cssurlref,*     | any                                |  | =,=,cssurlmid,=         |
attrvalue,*,cssurlhole,*    | lit:":"                            |  | =,=,=,=                 | A literal `:` after an interpolation that may still be spelling the scheme of a CSS url() lets the interpolated value choose the scheme: `url(${s}:x)` with s = `javascript` passes the scheme allowlist (it has no colon of its own) and then becomes `javascript:`. Build the whole URL first and interpolate it as ONE hole, or write the scheme literally in the template.
attrvalue,*,cssurlhole,*    | ilit:"&quot;"                      |  | =,=,cssurlmid,=         |
attrvalue,*,cssurlhole,*    | ilit:"&apos;"                      |  | =,=,cssurlmid,=         |
attrvalue,*,cssurlhole,*    | lit:"&#34;"                        |  | =,=,cssurlmid,=         |
attrvalue,*,cssurlhole,*    | lit:"&#39;"                        |  | =,=,cssurlmid,=         |
attrvalue,*,cssurlhole,*    | cls:[&\\]                          |  | =,=,=,=                 | A character reference or CSS escape after an interpolation that may still be spelling the scheme of a CSS url() can decode to `:` (a numeric reference, `&colon;`, or the CSS escape `\3a`) and let the interpolated value choose the scheme. Write the character literally, or build the whole URL in one interpolation.
attrvalue,*,cssurlhole,*    | interp                             |  | =,=,=,=                 |
attrvalue,*,cssurlhole,*    | cls+:[a-zA-Z0-9+.;\t\r\n-]         |  | =,=,=,=                 |
attrvalue,*,cssurlhole,*    | any                                |  | =,=,cssurlmid,=         |
attrvalue,*,cssurlmid,*     | interp                             |  | =,=,=,=                 |
attrvalue,*,cssurlmid,*     | any                                |  | =,=,=,=                 |

# -- CSS position tracking --
# A style attribute alternates between DECLARATION and VALUE positions, and the
# two need different escapers: a declaration list may contain `:` and `;`, a
# value may not (either would let it start a new declaration). The discriminator
# is CSS syntax, not offset -- `style="a:b;${decls}"` is a declaration position
# even though literal text precedes it, and `style="color:${v}"` is a value
# position. Measured against forgepm, both shapes occur in real templates.
attrvalue,*,style,*       | lit:":"        |  | =,=,stylevalue,=         |
attrvalue,*,stylevalue,*  | lit:";"        |  | =,=,style,=              |
attrvalue,*,style,*       | interp         |  | =,=,=,=                  |
attrvalue,*,stylevalue,*  | interp         |  | =,=,=,=                  |

# -- JS position tracking inside an on* handler attribute --
# Same split as a <script> body below, and for the same reason: the JS string
# escaper is correct ONLY inside a string literal. `onclick="n = ${p}"` used to
# get it, so `alert(document.cookie)` -- which contains no quote, no angle
# bracket and nothing else that escaper touches -- passed through as code.
#
# The JS string delimiter is implied by the HTML one, and cannot be recorded in
# `delim` because the HTML delimiter is already there. That is not a
# limitation: inside a double-quoted attribute a raw `"` ends the ATTRIBUTE
# (the rows at the top of this section, which run first), so the only JS string
# a double-quoted handler can contain is a single-quoted one, and vice versa.
attrvalue,*,script,double   | lit:"'"        |  | =,=,jsstring,=           |
attrvalue,*,script,single   | lit:"\""       |  | =,=,jsstring,=           |
attrvalue,*,jsstring,double | lit:"\\'"      |  | =,=,=,=                  |
attrvalue,*,jsstring,single | lit:"\\\""     |  | =,=,=,=                  |
attrvalue,*,jsstring,*      | cls+:[\\]      |  | =,=,=,=                  |
attrvalue,*,jsstring,double | lit:"'"        |  | =,=,script,=             |
attrvalue,*,jsstring,single | lit:"\""       |  | =,=,script,=             |
attrvalue,*,script,*        | lit:"//"       |  | =,=,jscomment,=          |
attrvalue,*,script,*        | lit:"/*"       |  | =,=,jscomment,=          |
attrvalue,*,script,*        | lit:"/"        |  | =,=,jsregex,=            |
attrvalue,*,script,*        | lit:"`"        |  | =,=,jstemplate,=         |
attrvalue,*,jscomment,*     | lit:"\n"       |  | =,=,script,=             |
attrvalue,*,jscomment,*     | lit:"*/"       |  | =,=,script,=             |
attrvalue,*,jsregex,*       | cls+:[\\]      |  | =,=,=,=                  |
attrvalue,*,jsregex,*       | lit:"/"        |  | =,=,script,=             |
attrvalue,*,jstemplate,*    | cls+:[\\]      |  | =,=,=,=                  |
attrvalue,*,jstemplate,*    | lit:"`"        |  | =,=,script,=             |
attrvalue,*,jsstring,*      | interp         |  | =,=,=,=                  |
# A single-quoted handler is the ONE context the JS-expression escaper cannot
# serve: it renders the value as a single-quoted JS string, and those
# delimiters would close the attribute. Everywhere else its output contains no
# raw quote at all.
attrvalue,*,script,single   | interp         |  | =,=,=,=                  | Cannot interpolate at a JavaScript expression position inside a SINGLE-quoted event-handler attribute. The value is rendered as a single-quoted JS string, and its delimiters would close the attribute. Use a double-quoted attribute, or put the hole inside a double-quoted JS string: onclick='f("${x}")'.
attrvalue,*,script,*        | interp         |  | =,=,=,=                  |
attrvalue,*,jscomment,*     | interp         |  | =,=,=,=                  | Cannot interpolate inside a JavaScript comment. The value is dead text until a newline or an unbalanced */ moves it into live code, so a hole here is always a mistake -- move it into the code the comment describes.
attrvalue,*,jsregex,*       | interp         |  | =,=,=,=                  | Cannot interpolate inside a JavaScript regular-expression literal: an unescaped / in the value ends the literal and everything after it is parsed as code, and no escaping fixes that. If this / was meant as division, note the table cannot tell the two apart and deliberately assumes the regex -- move the arithmetic out of the template.
attrvalue,*,jstemplate,*    | interp         |  | =,=,=,=                  | Cannot interpolate inside a JavaScript template literal: a backtick closes it and ${ opens a substitution, which is arbitrary code, and the JS string escaper escapes neither. Use a single- or double-quoted JS string instead.

# -- URL-ish attributes that no escaper can serve --
attrvalue,*,srcset,*      | interp         |  | =,=,=,=                  | Cannot interpolate into a srcset attribute: the value is a comma-separated list of candidates, so the whole-URL scheme check would validate only the first one and wave the rest through. Interpolate a single URL into src instead, or assemble the candidate list from values you already control.
attrvalue,*,htmldoc,*     | interp         |  | =,=,=,=                  | Cannot interpolate into a srcdoc attribute: the browser HTML-decodes the attribute and then parses the result as a whole DOCUMENT, so the entity escaping that makes every other attribute safe is undone before the markup is parsed and an onerror handler fires. Point the iframe at a src URL instead.

# -- generic within-value rows --
attrvalue,*,*,*           | interp         |  | =,=,=,=                  |
attrvalue,*,*,*           | any            |  | =,=,=,=                  |

# ── RCDATA / RAW TEXT (script, style, textarea, title bodies) ────────────
# Exit only on the MATCHING close tag, case-insensitively -- `</b>` inside a
# script string must not be mistaken for the end of the script.
# A url() inside a <style> body needs the same context as one in a style
# attribute -- the language nesting is identical, only the outer wrapper differs.
# The positions inside it are listed after the close-tag rows below, so that
# `</style` still ends the element from inside a url().
rcdata,style,*,*      | ilit:"url("       |  | =,=,cssurl,=            |

# `</script` ends the element from EVERY JS sub-position below, including from
# inside a string literal -- the HTML tokenizer does not know JS exists. This
# row must therefore stay ABOVE the per-position `any` rows that follow, and it
# clears the JS position on the way out.
rcdata,script,*,*     | ilit:"</script"   |  | closetagname,normal,normal,none |
rcdata,style,*,*      | ilit:"</style"    |  | closetagname,normal,=,= |
rcdata,textarea,*,*   | ilit:"</textarea" |  | closetagname,normal,=,= |
rcdata,title,*,*      | ilit:"</title"    |  | closetagname,normal,=,= |

# CSS url() inside a <style> body: the same positions as in a style attribute
# (see "CSS url() scheme tracking" above); only the exit differs.
rcdata,style,cssurl,*       | lit:")"                            |  | =,=,normal,=            |
rcdata,style,cssurlscheme,* | lit:")"                            |  | =,=,normal,=            |
rcdata,style,cssurlref,*    | lit:")"                            |  | =,=,normal,=            |
rcdata,style,cssurlhole,*   | lit:")"                            |  | =,=,normal,=            |
rcdata,style,cssurlmid,*    | lit:")"                            |  | =,=,normal,=            |
rcdata,style,cssurl,*       | interp                             |  | =,=,cssurlhole,=        |
rcdata,style,cssurl,*       | cls+:[ \t\r\n]                     |  | =,=,=,=                 |
rcdata,style,cssurl,*       | lit:"'"                            |  | =,=,=,=                 |
rcdata,style,cssurl,*       | lit:"\""                           |  | =,=,=,=                 |
rcdata,style,cssurl,*       | ilit:"&quot;"                      |  | =,=,=,=                 |
rcdata,style,cssurl,*       | ilit:"&apos;"                      |  | =,=,=,=                 |
rcdata,style,cssurl,*       | lit:"&#34;"                        |  | =,=,=,=                 |
rcdata,style,cssurl,*       | lit:"&#39;"                        |  | =,=,=,=                 |
rcdata,style,cssurl,*       | cls:[&\\]                          |  | =,=,cssurlref,=         |
rcdata,style,cssurl,*       | cls:[a-zA-Z0-9+.;-]                |  | =,=,cssurlscheme,=      |
rcdata,style,cssurl,*       | any                                |  | =,=,cssurlmid,=         |
rcdata,style,cssurlscheme,* | interp                             |  | =,=,cssurlhole,=        |
rcdata,style,cssurlscheme,* | cls:[&\\]                          |  | =,=,cssurlref,=         |
rcdata,style,cssurlscheme,* | cls+:[a-zA-Z0-9+.;\t\r\n-]         |  | =,=,=,=                 |
rcdata,style,cssurlscheme,* | any                                |  | =,=,cssurlmid,=         |
rcdata,style,cssurlref,*    | interp                             |  | =,=,=,=                 | An interpolation right after a character reference or CSS escape, in a CSS url() whose scheme is not settled yet, can finish it: `url(javascript\${x}...)` with x = `00003a` renders the CSS escape for `:`, and an unfinished numeric reference completed with `58` decodes to one too. Write the character literally, or build the whole URL in one interpolation.
rcdata,style,cssurlref,*    | cls+:[a-zA-Z0-9+.;&\\ \t\r\n-]     |  | =,=,=,=                 |
rcdata,style,cssurlref,*    | lit:"#"                            |  | =,=,=,=                 |
rcdata,style,cssurlref,*    | any                                |  | =,=,cssurlmid,=         |
rcdata,style,cssurlhole,*   | lit:":"                            |  | =,=,=,=                 | A literal `:` after an interpolation that may still be spelling the scheme of a CSS url() lets the interpolated value choose the scheme: `url(${s}:x)` with s = `javascript` passes the scheme allowlist (it has no colon of its own) and then becomes `javascript:`. Build the whole URL first and interpolate it as ONE hole, or write the scheme literally in the template.
rcdata,style,cssurlhole,*   | ilit:"&quot;"                      |  | =,=,cssurlmid,=         |
rcdata,style,cssurlhole,*   | ilit:"&apos;"                      |  | =,=,cssurlmid,=         |
rcdata,style,cssurlhole,*   | lit:"&#34;"                        |  | =,=,cssurlmid,=         |
rcdata,style,cssurlhole,*   | lit:"&#39;"                        |  | =,=,cssurlmid,=         |
rcdata,style,cssurlhole,*   | cls:[&\\]                          |  | =,=,=,=                 | A character reference or CSS escape after an interpolation that may still be spelling the scheme of a CSS url() can decode to `:` (a numeric reference, `&colon;`, or the CSS escape `\3a`) and let the interpolated value choose the scheme. Write the character literally, or build the whole URL in one interpolation.
rcdata,style,cssurlhole,*   | interp                             |  | =,=,=,=                 |
rcdata,style,cssurlhole,*   | cls+:[a-zA-Z0-9+.;\t\r\n-]         |  | =,=,=,=                 |
rcdata,style,cssurlhole,*   | any                                |  | =,=,cssurlmid,=         |
rcdata,style,cssurlmid,*    | interp                             |  | =,=,=,=                 |
rcdata,style,cssurlmid,*    | any                                |  | =,=,=,=                 |

# JS inside a <script> BODY -----------------------------------------------
# The subsidiary automaton the paper calls for, expressed in the flat context
# tuple: `attr` carries the JS position, and `delim` -- free here, since a
# script body has no HTML attribute around it -- carries the quote that opened
# the current string literal.
#
# WHY THIS EXISTS. Every script context used to select the JS STRING escaper,
# which is correct only between quotes. In expression position it escaped
# characters that were not delimiting anything and left alone the ones that
# matter, so `<script>var x = ${p}</script>` rendered `alert(document.cookie)`
# verbatim as code, while honest arithmetic came out as a syntax error. Wrong
# in both directions, from one root cause. See
# specs/progress/2026-08-20-h-sigil-js-and-url-attr-xss.md.
#
# THE INVARIANT the rest of this block is arranged to keep:
#
#     the walk must never land at `jsstring` when the hole is really in
#     expression position.
#
# That direction is the dangerous one -- it is the bug above. The reverse costs
# an over-strict escaper or a compile error, which is loud and harmless. So
# every construct that can hide a stray quote is tracked: a comment, a template
# literal, and a regex literal. Each would otherwise leave the quote count off
# by one and hand the NEXT hole the string escaper while it sat in open code.
#
# A hole is ACCEPTED in expression position and inside a quote-delimited string
# literal. Comments, regex literals and template literals reject: a comment
# hides the value until it does not, a regex literal ends at an unescaped `/`
# that no escaper here escapes, and a template literal reads a dollar-brace as
# a substitution -- arbitrary code -- and a backtick as its terminator, neither
# of which the JS string escaper touches.

# -- expression position; the state a script body opens in --
# `//` and `/*` must precede the bare `/`, and the bare `/` is deliberately
# greedy: division is read as the start of a regex literal. See the diagnostic.
rcdata,script,normal,*        | lit:"//"          |  | =,=,jscomment,=         |
rcdata,script,normal,*        | lit:"/*"          |  | =,=,jscomment,=         |
rcdata,script,normal,*        | lit:"/"           |  | =,=,jsregex,=           |
rcdata,script,normal,*        | lit:"'"           |  | =,=,jsstring,single     |
rcdata,script,normal,*        | lit:"\""          |  | =,=,jsstring,double     |
rcdata,script,normal,*        | lit:"`"           |  | =,=,jstemplate,=        |
rcdata,script,normal,*        | interp            |  | =,=,=,=                 |
rcdata,script,normal,*        | any               |  | =,=,=,=                 |

# -- string literal; `delim` remembers which quote opened it --
# The two-character escape rows come first, so a backslash-quote cannot close
# the string. `cls+` then swallows any remaining RUN of backslashes: an odd run
# followed by a quote makes the walk leave the string one escape early, which
# is the over-strict direction and therefore safe.
rcdata,script,jsstring,*      | lit:"\\'"         |  | =,=,=,=                 |
rcdata,script,jsstring,*      | lit:"\\\""        |  | =,=,=,=                 |
rcdata,script,jsstring,*      | cls+:[\\]         |  | =,=,=,=                 |
rcdata,script,jsstring,single | lit:"'"           |  | =,=,normal,none         |
rcdata,script,jsstring,double | lit:"\""          |  | =,=,normal,none         |
rcdata,script,jsstring,*      | interp            |  | =,=,=,=                 |
rcdata,script,jsstring,*      | any               |  | =,=,=,=                 |

# -- comment; one class for both forms, carrying both terminators --
# Conflating `//` with `/* */` can only end a comment EARLY, which returns to
# expression position -- the safe direction.
rcdata,script,jscomment,*     | lit:"\n"          |  | =,=,normal,=            |
rcdata,script,jscomment,*     | lit:"*/"          |  | =,=,normal,=            |
rcdata,script,jscomment,*     | interp            |  | =,=,=,=                 | Cannot interpolate inside a JavaScript comment. The value is dead text until a newline or an unbalanced */ moves it into live code, so a hole here is always a mistake -- move it into the code the comment describes.
rcdata,script,jscomment,*     | any               |  | =,=,=,=                 |

# -- regular-expression literal --
rcdata,script,jsregex,*       | cls+:[\\]         |  | =,=,=,=                 |
rcdata,script,jsregex,*       | lit:"/"           |  | =,=,normal,=            |
rcdata,script,jsregex,*       | interp            |  | =,=,=,=                 | Cannot interpolate inside a JavaScript regular-expression literal: an unescaped / in the value would end the literal and everything after it would be parsed as code, and no escaping prevents that. If this / was meant as division, the table cannot tell the two apart and deliberately assumes the regex -- move the arithmetic out of the template.
rcdata,script,jsregex,*       | any               |  | =,=,=,=                 |

# -- template literal --
rcdata,script,jstemplate,*    | cls+:[\\]         |  | =,=,=,=                 |
rcdata,script,jstemplate,*    | lit:"`"           |  | =,=,normal,=            |
rcdata,script,jstemplate,*    | interp            |  | =,=,=,=                 | Cannot interpolate inside a JavaScript template literal: a backtick would close it and a dollar-brace would open a substitution, which is arbitrary code, and the JS string escaper escapes neither. Use a single- or double-quoted JS string instead.
rcdata,script,jstemplate,*    | any               |  | =,=,=,=                 |

rcdata,*,*,*          | interp            |  | =,=,=,=                 |
rcdata,*,*,*          | any               |  | =,=,=,=                 |

# ── COMMENT ──────────────────────────────────────────────────────────────
# Nothing safe can be interpolated here: `--!>` and friends end a comment in
# ways that vary across parsers, so a hole inside one is always a mistake.
comment,*,*,*         | interp          |  | =,=,=,=                  | Cannot interpolate inside an HTML comment. Comment-ending sequences vary between parsers, so no escaping is reliable here.
comment,*,*,*         | until:"-->"     |  | pcdata,=,=,=             |
comment,*,*,*         | any             |  | =,=,=,=                  |
