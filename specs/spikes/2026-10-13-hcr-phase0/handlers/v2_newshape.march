    -- v2: ABI-stable (SpikeConn still only read) but a NEW closure shape: the
    -- lambda captures a String and a List (heap captures) instead of an Int.
    fn handle(conn: SpikeConn): Int do
      conn.status * 2 + List.length(conn.headers)
    end
    fn mk(conn: SpikeConn): Int -> Int do
      let p = conn.path
      let hs = conn.headers
      fn x -> x + string_length(p) + List.length(hs) * 1000
    end
    fn tag(): String do
      "v2-tag-is-longer"
    end
    -- count borrows its List (it only reads it).
    fn count(hs: List(String)): Int do
      match hs do
        Nil -> 0
        Cons(h, _) -> 1 + string_length(h)
      end
    end
