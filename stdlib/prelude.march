-- March Standard Library Prelude
--
-- Everything in this module is auto-imported into every March program.
-- These are the most commonly needed functions and types.
--
-- Sections:
--   1. Diverging (panic, todo, unreachable)
--   2. Option helpers
--   3. Result helpers
--   4. List basics
--   5. Combinators (identity, compose, flip, const)
--   6. String helpers
--
-- Naming overlap with module-qualified APIs is intentional:
--
-- - `head`, `tail`, `is_nil`, `length`, `reverse`, `fold_left`,
--   `filter`, `map` are all List-typed in the prelude (their
--   signatures fix `xs : List(a)`), so `length(xs)` always means
--   `List.length(xs)`.  Strings have no `length` — use
--   `String.byte_size` / `String.codepoint_count` instead.  The
--   absence of a generic `length` prevents silent type confusion.
-- - `unwrap` and `unwrap_or` operate on `Option(a)`.  For Result
--   call `Result.unwrap` directly.
--
-- New code should prefer module-qualified calls for readability;
-- prelude names exist for short scripts and for the few cases (head,
-- tail, length, reverse) where the unqualified name reads better.
-- Prelude functions are called unqualified (`length(xs)`, not
-- `Prelude.length(xs)`).
--
-- doc: try

mod Prelude do

  -- ---- Diverging ----

  doc """
  Terminates the program with a runtime error carrying `msg`.
  Used for violated invariants — bugs, not expected failures; return a
  `Result` for errors a caller can handle. Propagates to the enclosing
  actor boundary. Typechecks as any type, so it can stand in any branch:

      fn safe_div(a : Int, b : Int) : Int do
        if b == 0 do panic("safe_div: zero divisor") else a / b end
      end
  """
  fn panic(msg : String) : a do
    panic_(msg)
  end

  doc """
  Marks code as not yet implemented: evaluating it is a runtime error
  carrying `msg`. Typechecks as any type so you can sketch a program
  top-down. Never valid in production.

      fn parse_config(s : String) : Config do
        todo("parse_config")
      end
  """
  fn todo(msg : String) : a do
    todo_(msg)
  end

  doc """
  Asserts that a code path is unreachable: reaching it at runtime is an
  error. Typechecks as any type.

      match n % 2 do
      0 -> "even"
      1 -> "odd"
      _ -> unreachable()
      end
  """
  fn unreachable() : a do
    unreachable_()
  end

  -- ---- Option helpers ----

  doc """
  Extracts the value from Some(x), panicking if None. The Option-only
  prelude form of `Option.unwrap`; for Result use `Result.unwrap`.

  ## Examples

      march> unwrap(Some(3))
      3
  """
  fn unwrap(opt : {Option(a) | is_Some(_)}) : a do
    match opt do
    Some(x) -> x
    None    -> panic("unwrap called on None")
    end
  end

  doc """
  Returns the contained value, or `default` if None. Option-only; for
  Result use `Result.unwrap_or`.

  ## Examples

      march> unwrap_or(Some(1), 7)
      1
      march> unwrap_or(None, 7)
      7
  """
  fn unwrap_or(opt : Option(a), default : a) : a do
    match opt do
    Some(x) -> x
    None    -> default
    end
  end

  -- ---- List basics ----

  doc """
  Returns the first element of the list. Panics if empty; use
  `List.head_opt` when the list may be empty.

  ## Examples

      march> head([4, 5])
      4
  """
  fn head(xs : {List(a) | len(_) > 0}) : a do
    match xs do
    Cons(h, _) -> h
    Nil        -> panic("head: empty list")
    end
  end

  doc """
  Returns all but the first element. Panics if empty; use `List.tail_opt`
  when the list may be empty.

  ## Examples

      march> tail([4, 5])
      [5]
      march> tail([4])
      []
  """
  fn tail(xs : {List(a) | len(_) > 0}) : List(a) do
    match xs do
    Cons(_, t) -> t
    Nil        -> panic("tail: empty list")
    end
  end

  doc """
  Returns true if the list is empty.

  ## Examples

      march> is_nil([])
      true
      march> is_nil([1])
      false
  """
  fn is_nil(xs : List(a)) : Bool do
    match xs do
    Nil -> true
    Cons(_, _) -> false
    end
  end

  doc """
  Returns the number of elements in the list. O(n). Lists only: for a
  String use `String.byte_size` or `String.codepoint_count`.

  ## Examples

      march> length([1, 2, 3])
      3
      march> length([])
      0
  """
  fn length(xs : List(a)) : Int do
    fn go(lst : List(a), acc : Int) : Int do
      match lst do
      Nil        -> acc
      Cons(_, t) -> go(t, acc + 1)
      end
    end
    go(xs, 0)
  end

  doc """
  Reverses a list.

  ## Examples

      march> reverse([1, 2, 3])
      [3, 2, 1]
  """
  fn reverse(xs : List(a)) : List(a) do
    fn go(lst : List(a), acc : List(a)) : List(a) do
      match lst do
      Nil        -> acc
      Cons(h, t) -> go(t, Cons(h, acc))
      end
    end
    go(xs, Nil)
  end

  doc """
  Left fold over a list.  Argument order: collection first, init
  second, callback last (uncurried-collection convention). The callback
  takes the accumulator first: `f(acc, x)`.

  ## Examples

      march> fold_left([1, 2, 3], 10, fn (acc, x) -> acc - x)
      4
      march> fold_left([], 10, fn (acc, x) -> acc - x)
      10
  """
  fn fold_left(xs : List(a), acc : b, f : b -> a -> b) : b do
    match xs do
    Nil        -> acc
    Cons(h, t) -> fold_left(t, f(acc, h), f)
    end
  end

  doc """
  Returns only the elements satisfying `pred`, in their original order.

  ## Examples

      march> filter([1, 2, 3, 4], fn x -> x > 2)
      [3, 4]
  """
  fn filter(xs : List(a), pred : a -> Bool) : List(a) do
    fn go(acc : List(a), remaining : List(a)) : List(a) do
      match remaining do
      Nil        -> reverse(acc)
      Cons(h, t) -> if pred(h) do go(Cons(h, acc), t) else go(acc, t) end
      end
    end
    go(Nil, xs)
  end

  doc """
  Applies `f` to every element of the list, returning the new list.

  ## Examples

      march> map([1, 2, 3], fn x -> x + 1)
      [2, 3, 4]
      march> map([], fn x -> x + 1)
      []
  """
  fn map(xs : List(a), f : a -> b) : List(b) do
    fn go(acc : List(b), remaining : List(a)) : List(b) do
      match remaining do
      Nil        -> reverse(acc)
      Cons(h, t) -> go(Cons(f(h), acc), t)
      end
    end
    go(Nil, xs)
  end

  -- ---- Combinators ----

  doc """
  The identity function — returns its argument unchanged.

  ## Examples

      march> identity(5)
      5
      march> List.filter_map([Some(1), None, Some(3)], identity)
      [1, 3]
  """
  fn identity(x : a) : a do
    x
  end

  doc """
  Function composition: returns the function `fn x -> f(g(x))` (`g` runs
  first). March has no chained call `f(a)(b)`, so bind the result or wrap
  it in parentheses before calling it.

  ## Examples

      march> (compose(fn x -> x * 2, fn x -> x + 1))(3)
      8
      march> List.map([1, 2], compose(fn x -> x * 2, fn x -> x + 1))
      [4, 6]
  """
  fn compose(f : b -> c, g : a -> b) : a -> c do
    fn x -> f(g(x))
  end

  doc """
  Flips the order of a two-argument function's arguments: the result `g`
  satisfies `g(b, a) == f(a, b)`.

  ## Examples

      march> (flip(fn (a, b) -> a - b))(1, 10)
      9
  """
  fn flip(f : a -> b -> c) : b -> a -> c do
    fn (b, a) -> f(a, b)
  end

  doc """
  Returns a one-argument function that always returns `x`, ignoring its
  argument.

  ## Examples

      march> List.map([1, 2, 3], const(0))
      [0, 0, 0]
  """
  fn const(x : a) : b -> a do
    fn _ -> x
  end

  -- ---- Show impls for generic containers ----

  impl Show(List(a)) when Show(a) do
    fn show(xs) do
      "[" ++ string_join(map(xs, fn x -> show(x)), ", ") ++ "]"
    end
  end

  impl Show(Option(a)) when Show(a) do
    fn show(opt) do
      match opt do
      None    -> "None"
      Some(x) -> "Some(" ++ show(x) ++ ")"
      end
    end
  end

  impl Show(Result(a, e)) when Show(a), Show(e) do
    fn show(r) do
      match r do
      Ok(x)  -> "Ok(" ++ show(x) ++ ")"
      Err(e) -> "Err(" ++ show(e) ++ ")"
      end
    end
  end

  -- Tuple Show, per arity (2..5). Tuples are structural, so the dispatch keys
  -- them by arity ("$Tuple2".."$Tuple5"); each element is shown via its own
  -- Show impl and joined with ", " inside parens, matching the interpreter's
  -- `VTuple` rendering. Fixes compiled `println`/`to_string` on a tuple, which
  -- previously failed to link `_show` (no tuple Show) or printed `#<tag>`.
  impl Show((a, b)) when Show(a), Show(b) do
    fn show(t) do
      let (x, y) = t
      "(" ++ show(x) ++ ", " ++ show(y) ++ ")"
    end
  end

  impl Show((a, b, c)) when Show(a), Show(b), Show(c) do
    fn show(t) do
      let (x, y, z) = t
      "(" ++ show(x) ++ ", " ++ show(y) ++ ", " ++ show(z) ++ ")"
    end
  end

  impl Show((a, b, c, d)) when Show(a), Show(b), Show(c), Show(d) do
    fn show(t) do
      let (w, x, y, z) = t
      "(" ++ show(w) ++ ", " ++ show(x) ++ ", " ++ show(y) ++ ", " ++ show(z) ++ ")"
    end
  end

  impl Show((a, b, c, d, e)) when Show(a), Show(b), Show(c), Show(d), Show(e) do
    fn show(t) do
      let (v, w, x, y, z) = t
      "(" ++ show(v) ++ ", " ++ show(w) ++ ", " ++ show(x) ++ ", " ++ show(y) ++ ", " ++ show(z) ++ ")"
    end
  end

  -- Tuple Ord, per arity (2..5): lexicographic, the first component pair
  -- that differs decides, each by its own Ord impl. Keyed by arity like the
  -- Show impls above. `<`/`<=`/`>`/`>=` on a tuple lower to `compare` (the
  -- interpreter applies the same rule directly).
  impl Ord((a, b)) when Ord(a), Ord(b) do
    fn compare(s, t) do
      let (s1, s2) = s
      let (t1, t2) = t
      let c = compare(s1, t1)
      if c != 0 do c else compare(s2, t2) end
    end
  end

  impl Ord((a, b, c)) when Ord(a), Ord(b), Ord(c) do
    fn compare(s, t) do
      let (s1, s2, s3) = s
      let (t1, t2, t3) = t
      let c1 = compare(s1, t1)
      if c1 != 0 do c1 else
        let c2 = compare(s2, t2)
        if c2 != 0 do c2 else compare(s3, t3) end
      end
    end
  end

  impl Ord((a, b, c, d)) when Ord(a), Ord(b), Ord(c), Ord(d) do
    fn compare(s, t) do
      let (s1, s2, s3, s4) = s
      let (t1, t2, t3, t4) = t
      let c1 = compare(s1, t1)
      if c1 != 0 do c1 else
        let c2 = compare(s2, t2)
        if c2 != 0 do c2 else
          let c3 = compare(s3, t3)
          if c3 != 0 do c3 else compare(s4, t4) end
        end
      end
    end
  end

  impl Ord((a, b, c, d, e)) when Ord(a), Ord(b), Ord(c), Ord(d), Ord(e) do
    fn compare(s, t) do
      let (s1, s2, s3, s4, s5) = s
      let (t1, t2, t3, t4, t5) = t
      let c1 = compare(s1, t1)
      if c1 != 0 do c1 else
        let c2 = compare(s2, t2)
        if c2 != 0 do c2 else
          let c3 = compare(s3, t3)
          if c3 != 0 do c3 else
            let c4 = compare(s4, t4)
            if c4 != 0 do c4 else compare(s5, t5) end
          end
        end
      end
    end
  end

  -- What compiled `<`, `<=`, `>`, `>=` on a tuple lower to (Lower_expr):
  -- the Ord impls above decide. Not for direct use.
  pfn __tuple_lt(a, b) do compare(a, b) < 0 end
  pfn __tuple_le(a, b) do compare(a, b) <= 0 end
  pfn __tuple_gt(a, b) do compare(a, b) > 0 end
  pfn __tuple_ge(a, b) do compare(a, b) >= 0 end

  -- ---- Polymorphic println and string conversion ----

  doc """
  Prints any Show value followed by a newline, and returns ().
  Works for Int, Float, String, Bool, List, Option, Result, tuples,
  and any type with an explicit impl Show. A String prints without quotes.

      println([1, 2])     -- prints [1, 2]
      println("hi")       -- prints hi
  """
  fn println(x) do
    print_line(show(x))
  end

  doc """
  Runs `f` with `c` installed as the capability its operations dispatch
  through, so a test can substitute an implementation:

  ```march
  with_cap(mock, fn _ -> code_under_test())
  ```

  At runtime this simply calls `f` — the capability is consumed by the
  compiler's capability-passing elaboration, which rewrites calls inside `f`
  to route through `c`'s dictionary. Outside a `--test` build the elaboration
  does not run and this is exactly `f(())`.

  ## Examples

      march> with_cap(0, fn _ -> 9)
      9
  """
  fn with_cap(_c, f) do f(()) end

  doc """
  Short alias for `to_string`: the value's Show representation. Strings
  nested inside a list, option or tuple are shown without quotes.

  ## Examples

      march> str(42)
      "42"
      march> str([1, 2])
      "[1, 2]"
      march> str(Some(true))
      "Some(true)"
  """
  fn str(x) do to_string(x) end

  -- ---- IO convenience ----

  doc """
  Prints a value using its Show representation, with a trailing newline,
  and returns (). The same output as `println`.

      debug(Some(3))      -- prints Some(3)
  """
  fn debug(x) do
    print_line(to_string(x))
  end

  doc """
  Converts any value to its string representation; the same as `str` and
  `to_string`.

  ## Examples

      march> inspect([Some(1), None])
      "[Some(1), None]"
      march> inspect("hi")
      "hi"
  """
  fn inspect(x) do to_string(x) end

end
