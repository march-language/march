-- March Standard Library Prelude
--
-- Everything in this module is auto-imported into every March program.
-- These are the most commonly needed functions and types.
--
-- Sections:
--   1. Diverging (panic, todo, unreachable)
--   2. Option helpers
--   3. Result helpers
--   4. List basics
--   5. Combinators (identity, compose, flip, const)
--   6. String helpers
--
-- Naming overlap with module-qualified APIs is intentional:
--
-- - `head`, `tail`, `is_nil`, `length`, `reverse`, `fold_left`,
--   `filter`, `map` are all List-typed in the prelude (their
--   signatures fix `xs : List(a)`), so `length(xs)` always means
--   `List.length(xs)`.  Strings have no `length` — use
--   `String.byte_size` / `String.codepoint_count` instead.  The
--   absence of a generic `length` prevents silent type confusion.
-- - `unwrap` and `unwrap_or` operate on `Option(a)`.  For Result
--   call `Result.unwrap` directly.
--
-- New code should prefer module-qualified calls for readability;
-- prelude names exist for short scripts and for the few cases (head,
-- tail, length, reverse) where the unqualified name reads better.

mod Prelude do

  -- ---- Diverging ----

  doc """
  Terminates the program with a runtime error.
  Used for violated invariants — bugs, not expected failures.
  Propagates to the enclosing actor boundary.
  """
  fn panic(msg : String) : a do
    panic_(msg)
  end

  doc """
  Marks code as not yet implemented.
  Typechecks as any type so you can sketch a program top-down.
  Never valid in production.
  """
  fn todo(msg : String) : a do
    todo_(msg)
  end

  doc "Asserts that a code path is unreachable."
  fn unreachable() : a do
    unreachable_()
  end

  -- ---- Option helpers ----

  doc "Extracts the value from Some(x), panicking if None."
  fn unwrap(opt : {Option(a) | is_Some(_)}) : a do
    match opt do
    Some(x) -> x
    None    -> panic("unwrap called on None")
    end
  end

  doc "Returns the contained value, or `default` if None."
  fn unwrap_or(opt : Option(a), default : a) : a do
    match opt do
    Some(x) -> x
    None    -> default
    end
  end

  -- ---- List basics ----

  doc "Returns the first element of the list. Panics if empty."
  fn head(xs : {List(a) | len(_) > 0}) : a do
    match xs do
    Cons(h, _) -> h
    Nil        -> panic("head: empty list")
    end
  end

  doc "Returns all but the first element. Panics if empty."
  fn tail(xs : {List(a) | len(_) > 0}) : List(a) do
    match xs do
    Cons(_, t) -> t
    Nil        -> panic("tail: empty list")
    end
  end

  doc "Returns true if the list is empty."
  fn is_nil(xs : List(a)) : Bool do
    match xs do
    Nil -> true
    Cons(_, _) -> false
    end
  end

  doc "Returns the number of elements in the list."
  fn length(xs : List(a)) : Int do
    fn go(lst : List(a), acc : Int) : Int do
      match lst do
      Nil        -> acc
      Cons(_, t) -> go(t, acc + 1)
      end
    end
    go(xs, 0)
  end

  doc "Reverses a list."
  fn reverse(xs : List(a)) : List(a) do
    fn go(lst : List(a), acc : List(a)) : List(a) do
      match lst do
      Nil        -> acc
      Cons(h, t) -> go(t, Cons(h, acc))
      end
    end
    go(xs, Nil)
  end

  doc """
  Left fold over a list.  Argument order: collection first, init
  second, callback last (uncurried-collection convention).
  """
  fn fold_left(xs : List(a), acc : b, f : b -> a -> b) : b do
    match xs do
    Nil        -> acc
    Cons(h, t) -> fold_left(t, f(acc, h), f)
    end
  end

  doc """
  Returns only the elements satisfying `pred`, in order.

  Every element of the result is known to satisfy `pred` (an abstract
  refinement `p`, as for `List.filter`): with
  `sum_pos(xs : List({Int | _ > 0}))`, `sum_pos(filter(ys, fn y -> y > 0))`
  is proved.
  """
  fn filter(xs : List(a), pred : a -> Bool[p]) : List(a[p]) do
    -- List.filter's natural body, copied rather than called (the prelude
    -- does not depend on List). TRMC makes it a single-traversal loop, and
    -- the element contract is proved through the self-call.
    match xs do
    Nil        -> Nil
    Cons(h, t) ->
      if pred(h) do Cons(h, filter(t, pred)) else filter(t, pred) end
    end
  end

  doc "Applies `f` to every element of the list."
  fn map(xs : List(a), f : a -> b) : List(b) do
    fn go(acc : List(b), remaining : List(a)) : List(b) do
      match remaining do
      Nil        -> reverse(acc)
      Cons(h, t) -> go(Cons(f(h), acc), t)
      end
    end
    go(Nil, xs)
  end

  -- ---- Combinators ----

  doc "The identity function — returns its argument unchanged."
  fn identity(x : a) : a do
    x
  end

  doc "Function composition: compose(f, g)(x) = f(g(x))."
  fn compose(f : b -> c, g : a -> b) : a -> c do
    fn x -> f(g(x))
  end

  doc "Flips the order of arguments: flip(f)(b, a) = f(a, b)."
  fn flip(f : a -> b -> c) : b -> a -> c do
    fn (b, a) -> f(a, b)
  end

  doc "Returns a function that always returns `x`, ignoring its argument."
  fn const(x : a) : b -> a do
    fn _ -> x
  end

  -- ---- Show impls for generic containers ----

  impl Show(List(a)) when Show(a) do
    fn show(xs) do
      "[" ++ string_join(map(xs, fn x -> show(x)), ", ") ++ "]"
    end
  end

  impl Show(Option(a)) when Show(a) do
    fn show(opt) do
      match opt do
      None    -> "None"
      Some(x) -> "Some(" ++ show(x) ++ ")"
      end
    end
  end

  impl Show(Result(a, e)) when Show(a), Show(e) do
    fn show(r) do
      match r do
      Ok(x)  -> "Ok(" ++ show(x) ++ ")"
      Err(e) -> "Err(" ++ show(e) ++ ")"
      end
    end
  end

  -- Tuple Show, per arity (2..5). Tuples are structural, so the dispatch keys
  -- them by arity ("$Tuple2".."$Tuple5"); each element is shown via its own
  -- Show impl and joined with ", " inside parens, matching the interpreter's
  -- `VTuple` rendering. Fixes compiled `println`/`to_string` on a tuple, which
  -- previously failed to link `_show` (no tuple Show) or printed `#<tag>`.
  impl Show((a, b)) when Show(a), Show(b) do
    fn show(t) do
      let (x, y) = t
      "(" ++ show(x) ++ ", " ++ show(y) ++ ")"
    end
  end

  impl Show((a, b, c)) when Show(a), Show(b), Show(c) do
    fn show(t) do
      let (x, y, z) = t
      "(" ++ show(x) ++ ", " ++ show(y) ++ ", " ++ show(z) ++ ")"
    end
  end

  impl Show((a, b, c, d)) when Show(a), Show(b), Show(c), Show(d) do
    fn show(t) do
      let (w, x, y, z) = t
      "(" ++ show(w) ++ ", " ++ show(x) ++ ", " ++ show(y) ++ ", " ++ show(z) ++ ")"
    end
  end

  impl Show((a, b, c, d, e)) when Show(a), Show(b), Show(c), Show(d), Show(e) do
    fn show(t) do
      let (v, w, x, y, z) = t
      "(" ++ show(v) ++ ", " ++ show(w) ++ ", " ++ show(x) ++ ", " ++ show(y) ++ ", " ++ show(z) ++ ")"
    end
  end

  -- Tuple Ord, per arity (2..5): lexicographic, the first component pair
  -- that differs decides, each by its own Ord impl. Keyed by arity like the
  -- Show impls above. `<`/`<=`/`>`/`>=` on a tuple lower to `compare` (the
  -- interpreter applies the same rule directly).
  impl Ord((a, b)) when Ord(a), Ord(b) do
    fn compare(s, t) do
      let (s1, s2) = s
      let (t1, t2) = t
      let c = compare(s1, t1)
      if c != 0 do c else compare(s2, t2) end
    end
  end

  impl Ord((a, b, c)) when Ord(a), Ord(b), Ord(c) do
    fn compare(s, t) do
      let (s1, s2, s3) = s
      let (t1, t2, t3) = t
      let c1 = compare(s1, t1)
      if c1 != 0 do c1 else
        let c2 = compare(s2, t2)
        if c2 != 0 do c2 else compare(s3, t3) end
      end
    end
  end

  impl Ord((a, b, c, d)) when Ord(a), Ord(b), Ord(c), Ord(d) do
    fn compare(s, t) do
      let (s1, s2, s3, s4) = s
      let (t1, t2, t3, t4) = t
      let c1 = compare(s1, t1)
      if c1 != 0 do c1 else
        let c2 = compare(s2, t2)
        if c2 != 0 do c2 else
          let c3 = compare(s3, t3)
          if c3 != 0 do c3 else compare(s4, t4) end
        end
      end
    end
  end

  impl Ord((a, b, c, d, e)) when Ord(a), Ord(b), Ord(c), Ord(d), Ord(e) do
    fn compare(s, t) do
      let (s1, s2, s3, s4, s5) = s
      let (t1, t2, t3, t4, t5) = t
      let c1 = compare(s1, t1)
      if c1 != 0 do c1 else
        let c2 = compare(s2, t2)
        if c2 != 0 do c2 else
          let c3 = compare(s3, t3)
          if c3 != 0 do c3 else
            let c4 = compare(s4, t4)
            if c4 != 0 do c4 else compare(s5, t5) end
          end
        end
      end
    end
  end

  -- What compiled `<`, `<=`, `>`, `>=` on a tuple lower to (Lower_expr):
  -- the Ord impls above decide. Not for direct use.
  pfn __tuple_lt(a, b) do compare(a, b) < 0 end
  pfn __tuple_le(a, b) do compare(a, b) <= 0 end
  pfn __tuple_gt(a, b) do compare(a, b) > 0 end
  pfn __tuple_ge(a, b) do compare(a, b) >= 0 end

  -- ---- Polymorphic println and string conversion ----

  doc """
  Prints any Show value followed by a newline.
  Works for Int, Float, String, Bool, List, Option, Result,
  and any type with an explicit impl Show.
  """
  fn println(x) do
    print_line(show(x))
  end

  doc """
  Runs `f` with `c` installed as the capability its operations dispatch
  through, so a test can substitute an implementation:

  ```march
  with_cap(mock, fn _ -> code_under_test())
  ```

  At runtime this simply calls `f` — the capability is consumed by the
  compiler's capability-passing elaboration, which rewrites calls inside `f`
  to route through `c`'s dictionary. Outside a `--test` build the elaboration
  does not run and this is exactly `f(())`.
  """
  fn with_cap(_c, f) do f(()) end

  doc "Short alias for to_string."
  fn str(x) do to_string(x) end

  -- ---- IO convenience ----

  doc "Prints a value using its Show representation, with a trailing newline."
  fn debug(x) do
    print_line(to_string(x))
  end

  doc "Converts any value to its string representation."
  fn inspect(x) do to_string(x) end

end
