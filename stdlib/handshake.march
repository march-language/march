-- Handshake: the net-kernel greeting + authentication decision.
--
-- When two nodes connect, each sends a Hello { its identity, a fresh nonce }.
-- Each then replies with a proof = ClusterAuth.prove(secret, peer_nonce). A
-- node accepts the peer iff the peer's proof matches the nonce *it* issued —
-- so only holders of the cluster secret join, and a proof can't be replayed
-- for a different nonce. This module is the pure protocol logic; the socket
-- I/O (framing via NetFrame, send/recv) lives in the net-kernel on top.
mod Handshake do

  -- `role` names the connection this hello opens: "control" (SWIM, registry
  -- sync, monitors, CREDIT, DELIVERY_FAILED) or "data" (ACTOR_MSG, RPC). One
  -- of each per peer since the control/data split
  -- (specs/progress/2026-09-14-distributed-plane-flow-control-and-control-channel.md,
  -- step 2). A hello without the field -- every node before the split -- is
  -- a control connection, so the two wire shapes interoperate.
  --
  -- `addr` is the sender's ADVERTISED listen address ("host:port"), so an
  -- acceptor learns where to dial the peer back before any gossip arrives
  -- (the cluster node service). "" when not sent: a hello without it (every
  -- node before the service) decodes as before.
  --
  -- `cert` is present only in CERTIFICATE mode (ClusterAuth.Certified): the
  -- sender's signed certificate (NodeCert.to_bytes) and a fresh ephemeral
  -- X25519 public key for the connection's MAC key agreement. It is sent as a
  -- seventh element, ["cert1", Bin(cert), Bin(eph)]; a shared-secret hello
  -- never has it and is byte-identical to a pre-11a node's.
  type HelloCert = { cert : List(Int), eph : List(Int) }

  type Hello = { identity : NodeIdentity.Identity, nonce : String, role : String, addr : String,
                 cert : Option(HelloCert) }

  doc "The role of a control connection (SWIM, registry sync, monitors, CREDIT, DELIVERY_FAILED): \"control\"."
  fn role_control() : String do "control" end
  doc "The role of a data connection (ACTOR_MSG, RPC): \"data\"."
  fn role_data() : String do "data" end

  doc "A shared-secret hello from [identity] with challenge [nonce], opening a control connection and advertising no address."
  fn make_hello(identity : NodeIdentity.Identity, nonce : String) : Hello do
    { identity: identity, nonce: nonce, role: role_control(), addr: "", cert: None }
  end

  doc "As `make_hello`, opening a connection of [role] (`role_control()` or `role_data()`)."
  fn make_hello_role(identity : NodeIdentity.Identity, nonce : String, role : String) : Hello do
    { identity: identity, nonce: nonce, role: role, addr: "", cert: None }
  end

  doc "As `make_hello_role`, advertising [addr] (\"host:port\", this node's listen address; \"\" for none)."
  fn make_hello_addr(identity : NodeIdentity.Identity, nonce : String, role : String, addr : String) : Hello do
    { identity: identity, nonce: nonce, role: role, addr: addr, cert: None }
  end

  doc """
  A certificate-mode hello: as `make_hello_addr`, carrying this node's signed
  certificate [cert] (`NodeCert.to_bytes`) and the connection's ephemeral
  X25519 public key [eph].
  """
  fn make_hello_cert(identity : NodeIdentity.Identity, nonce : String, role : String, addr : String,
                     cert : List(Int), eph : List(Int)) : Hello do
    { identity: identity, nonce: nonce, role: role, addr: addr, cert: Some({ cert: cert, eph: eph }) }
  end

  doc """
  Serialize [h] to MessagePack bytes: [name, node_id, incarnation, nonce,
  role], then [addr] when it is not "" (so a hello without an address is
  byte-identical to the pre-service shape). A certificate hello always
  carries the address (possibly "") and then ["cert1", Bin(cert), Bin(eph)].
  """
  fn encode_hello(h : Hello) : List(Int) do
    let tail = match h.cert do
      Some(hc) -> [Msgpack.str(h.addr), Msgpack.array([Msgpack.str("cert1"), Msgpack.bin(hc.cert), Msgpack.bin(hc.eph)])]
      None -> if String.is_empty(h.addr) do Nil else Cons(Msgpack.str(h.addr), Nil) end
    end
    Msgpack.encode(Msgpack.array(
      Cons(Msgpack.str(h.identity.name),
      Cons(Msgpack.str(h.identity.node_id),
      Cons(Msgpack.int(h.identity.incarnation),
      Cons(Msgpack.str(h.nonce),
      Cons(Msgpack.str(h.role), tail)))))))
  end

  doc """
  Decode the bytes of `encode_hello`, and the older shapes: a 6-element hello
  (no certificate), a 5-element one (no address: `addr` ""), and a
  4-element one from before roles (read as a control connection). `Err`
  for bytes that are not MessagePack, or "Handshake: malformed hello".
  """
  fn decode_hello(bytes : List(Int)) : Result(Hello, String) do
    match Msgpack.decode(bytes) do
      Err(e) -> Err(e)
      Ok(v) ->
        match v do
          Msgpack.Array([Msgpack.Str(name), Msgpack.Str(nid), Msgpack.Int(inc), Msgpack.Str(nonce),
                         Msgpack.Str(role), Msgpack.Str(addr),
                         Msgpack.Array([Msgpack.Str("cert1"), Msgpack.Bin(cert), Msgpack.Bin(eph)])]) ->
            Ok({ identity: { name: name, node_id: nid, incarnation: inc },
                 nonce: nonce, role: role, addr: addr, cert: Some({ cert: cert, eph: eph }) })
          Msgpack.Array(Cons(Msgpack.Str(name),
                        Cons(Msgpack.Str(nid),
                        Cons(Msgpack.Int(inc),
                        Cons(Msgpack.Str(nonce),
                        Cons(Msgpack.Str(role),
                        Cons(Msgpack.Str(addr), Nil))))))) ->
            Ok({ identity: { name: name, node_id: nid, incarnation: inc },
                 nonce: nonce, role: role, addr: addr, cert: None })
          Msgpack.Array(Cons(Msgpack.Str(name),
                        Cons(Msgpack.Str(nid),
                        Cons(Msgpack.Int(inc),
                        Cons(Msgpack.Str(nonce),
                        Cons(Msgpack.Str(role), Nil)))))) ->
            Ok({ identity: { name: name, node_id: nid, incarnation: inc },
                 nonce: nonce, role: role, addr: "", cert: None })
          Msgpack.Array(Cons(Msgpack.Str(name),
                        Cons(Msgpack.Str(nid),
                        Cons(Msgpack.Int(inc),
                        Cons(Msgpack.Str(nonce), Nil))))) ->
            Ok({ identity: { name: name, node_id: nid, incarnation: inc },
                 nonce: nonce, role: role_control(), addr: "", cert: None })
          _ -> Err("Handshake: malformed hello")
        end
    end
  end

  doc """
  Shared-secret mode's decision. Given the cluster [secret], the nonce
  [our_nonce] *we* issued to the peer, the peer's decoded hello [peer], and
  the peer's proof [peer_proof]: `Ok` with the identity the hello claims
  when the proof is `ClusterAuth.prove(secret, our_nonce)`, else
  `Err("Handshake: peer failed authentication")`. A proof made for another
  nonce never verifies.
  """
  fn authenticate(secret : String, our_nonce : String, peer : Hello,
                  peer_proof : String) : Result(NodeIdentity.Identity, String) do
    if ClusterAuth.verify(secret, our_nonce, peer_proof) do
      Ok(peer.identity)
    else
      Err("Handshake: peer failed authentication")
    end
  end

  -- ── certificate mode ───────────────────────────────────────────────────

  doc """
  The two modes do not mix: a certificate-mode node refuses a shared-secret
  peer and a shared-secret node refuses a certificate-mode one, each naming
  what the other side must be given. (A pre-11a node cannot decode a
  certificate hello at all and fails with "malformed hello".) `Ok(())` when
  the modes agree.
  """
  fn check_mode(mine : ClusterAuth.Auth, peer : Hello) : Result((), String) do
    match (mine, peer.cert) do
      (ClusterAuth.Certified(_), None) ->
        Err("Handshake: the peer runs in shared-secret mode, but this node requires a certificate "
            ++ "(give the peer MARCH_NODE_CERT, MARCH_NODE_KEY and MARCH_CLUSTER_OPERATOR_PUBKEY)")
      (ClusterAuth.Secret(_), Some(_)) ->
        Err("Handshake: the peer requires a certificate, but this node runs in shared-secret mode "
            ++ "(set MARCH_NODE_CERT, MARCH_NODE_KEY and MARCH_CLUSTER_OPERATOR_PUBKEY here too)")
      _ -> Ok(())
    end
  end

  doc """
  Check the certificate a certificate-mode peer sent at [now] (unix seconds):
  signed by the operator key, not expired, not revoked, and naming the node
  the hello claims to be -- its name is the certificate URI's last segment,
  and its node id is that name's (NodeIdentity.name_id). Returns the
  certificate and the node's public key, or a reason.
  """
  fn verify_peer_cert(creds : NodeCert.Credentials, peer : Hello, now : Int) : Result((NodeCert.Cert, Bytes), String) do
    match peer.cert do
      None -> Err("Handshake: the peer sent no certificate")
      Some(hc) ->
        match NodeCert.from_bytes(hc.cert) do
          Err(e) -> Err("Handshake: peer certificate: " ++ e)
          Ok(signed) ->
            match NodeCert.verify(signed, creds.operator_pubkey, now) do
              Err(e) -> Err("Handshake: peer " ++ peer.identity.name ++ ": " ++ e)
              Ok(c) ->
                if creds.revoked(c) do Err("Handshake: peer " ++ peer.identity.name ++ ": certificate revoked")
                else if NodeCert.node_name(c.node) != peer.identity.name do
                  Err("Handshake: peer calls itself " ++ peer.identity.name ++ " but its certificate names " ++ c.node)
                else if peer.identity.node_id != NodeIdentity.name_id(peer.identity.name) do
                  Err("Handshake: peer " ++ peer.identity.name ++ " announced a node id that is not its name's")
                else
                  match NodeCert.key_from_hex(c.pubkey, 32) do
                    Err(e) -> Err("Handshake: peer certificate key: " ++ e)
                    Ok(pk) -> Ok((c, pk))
                  end
                end end end
            end
        end
    end
  end

end
