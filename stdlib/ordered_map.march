-- OrderedMap module: AVL tree-based sorted map.
--
-- Keys are ordered by a user-supplied comparator function:
--   cmp(a, b) < 0  means a < b
--   cmp(a, b) = 0  means a = b
--   cmp(a, b) > 0  means a > b
--
-- The built-in `compare` is a ready-made comparator for Int, String and
-- other ordered values.  Lookup, put and delete are O(log n); keys, values,
-- to_list and fold visit entries in ascending key order.
--
-- The map itself is a record holding the comparator and the tree root.
-- Type: {cmp: (k,k)->Int, tree: Tree(k,v)}
--
-- doc: try

mod OrderedMap do

  -- Internal AVL tree: Leaf | Node(left, key, value, right, height)
  type Tree(k, v) = Leaf | Node(Tree(k, v), k, v, Tree(k, v), Int)

  -- ---- Internal helpers ----

  pfn height(t : Tree(k, v)) : Int do
    match t do
    Leaf -> 0
    Node(_, _, _, _, h) -> h
    end
  end

  pfn make_node(l : Tree(k, v), k : k, v : v, r : Tree(k, v)) : Tree(k, v) do
    let lh = height(l)
    let rh = height(r)
    let h = if lh > rh do lh + 1 else rh + 1 end
    Node(l, k, v, r, h)
  end

  pfn balance_factor(t : Tree(k, v)) : Int do
    match t do
    Leaf -> 0
    Node(l, _, _, r, _) -> height(l) - height(r)
    end
  end

  pfn rotate_right(t : Tree(k, v)) : Tree(k, v) do
    match t do
    Node(Node(ll, lk, lv, lr, _), k, v, r, _) ->
      let new_r = make_node(lr, k, v, r)
      make_node(ll, lk, lv, new_r)
    _ -> t
    end
  end

  pfn rotate_left(t : Tree(k, v)) : Tree(k, v) do
    match t do
    Node(l, k, v, Node(rl, rk, rv, rr, _), _) ->
      let new_l = make_node(l, k, v, rl)
      make_node(new_l, rk, rv, rr)
    _ -> t
    end
  end

  pfn balance(t : Tree(k, v)) : Tree(k, v) do
    match t do
    Leaf -> Leaf
    Node(l, k, v, r, _) ->
      let bf = height(l) - height(r)
      if bf > 1 do
        if balance_factor(l) < 0 do
          rotate_right(make_node(rotate_left(l), k, v, r))
        else
          rotate_right(t)
        end
      else
        if bf < -1 do
          if balance_factor(r) > 0 do
            rotate_left(make_node(l, k, v, rotate_right(r)))
          else
            rotate_left(t)
          end
        else
          make_node(l, k, v, r)
        end
      end
    end
  end

  pfn tree_insert(t : Tree(k, v), cmp : k -> k -> Int, key : k, val : v) : Tree(k, v) do
    match t do
    Leaf -> Node(Leaf, key, val, Leaf, 1)
    Node(l, k, v2, r, _) ->
      let c = cmp(key, k)
      if c < 0 do
        balance(make_node(tree_insert(l, cmp, key, val), k, v2, r))
      else
        if c > 0 do
          balance(make_node(l, k, v2, tree_insert(r, cmp, key, val)))
        else
          make_node(l, key, val, r)
        end
      end
    end
  end

  pfn tree_get(t : Tree(k, v), cmp : k -> k -> Int, key : k) : Option(v) do
    match t do
    Leaf -> None
    Node(l, k, v, r, _) ->
      let c = cmp(key, k)
      if c < 0 do
        tree_get(l, cmp, key)
      else
        if c > 0 do
          tree_get(r, cmp, key)
        else
          Some(v)
        end
      end
    end
  end

  pfn tree_min(t : Tree(k, v)) : Option((k, v)) do
    match t do
    Leaf -> None
    Node(Leaf, k, v, _, _) -> Some((k, v))
    Node(l, _, _, _, _) -> tree_min(l)
    end
  end

  pfn tree_delete_min(t : Tree(k, v)) : Tree(k, v) do
    match t do
    Leaf -> Leaf
    Node(Leaf, _, _, r, _) -> r
    Node(l, k, v, r, _) -> balance(make_node(tree_delete_min(l), k, v, r))
    end
  end

  pfn tree_delete(t : Tree(k, v), cmp : k -> k -> Int, key : k) : Tree(k, v) do
    match t do
    Leaf -> Leaf
    Node(l, k, v, r, _) ->
      let c = cmp(key, k)
      if c < 0 do
        balance(make_node(tree_delete(l, cmp, key), k, v, r))
      else
        if c > 0 do
          balance(make_node(l, k, v, tree_delete(r, cmp, key)))
        else
          match tree_min(r) do
          None -> l
          Some((rk, rv)) -> balance(make_node(l, rk, rv, tree_delete_min(r)))
          end
        end
      end
    end
  end

  pfn tree_to_list(t : Tree(k, v), acc : List((k, v))) : List((k, v)) do
    match t do
    Leaf -> acc
    Node(l, k, v, r, _) ->
      tree_to_list(l, Cons((k, v), tree_to_list(r, acc)))
    end
  end

  pfn tree_size(t : Tree(k, v)) : Int do
    match t do
    Leaf -> 0
    Node(l, _, _, r, _) -> 1 + tree_size(l) + tree_size(r)
    end
  end

  pfn tree_fold(t : Tree(k, v), acc : b, f : b -> k -> v -> b) : b do
    match t do
    Leaf -> acc
    Node(l, k, v, r, _) ->
      let acc2 = tree_fold(l, acc, f)
      let acc3 = f(acc2, k, v)
      tree_fold(r, acc3, f)
    end
  end

  pfn tree_map(t : Tree(k, v), f : k -> v -> w) : Tree(k, w) do
    match t do
    Leaf -> Leaf
    Node(l, k, v, r, h) -> Node(tree_map(l, f), k, f(k, v), tree_map(r, f), h)
    end
  end

  pfn tree_filter(t : Tree(k, v), cmp : k -> k -> Int, f : k -> v -> Bool) : Tree(k, v) do
    match t do
    Leaf -> Leaf
    Node(l, k, v, r, _) ->
      let l2 = tree_filter(l, cmp, f)
      let r2 = tree_filter(r, cmp, f)
      if f(k, v) do
        balance(make_node(l2, k, v, r2))
      else
        match tree_min(r2) do
        None -> l2
        Some((rk, rv)) -> balance(make_node(l2, rk, rv, tree_delete_min(r2)))
        end
      end
    end
  end

  pfn tree_max(t : Tree(k, v)) : Option((k, v)) do
    match t do
    Leaf -> None
    Node(_, k, v, Leaf, _) -> Some((k, v))
    Node(_, _, _, r, _) -> tree_max(r)
    end
  end

  -- ---- Public API ----

  doc """
  Creates a new empty ordered map with the given comparator
  (`cmp(a, b)` negative, zero or positive as `a` is less than, equal to or
  greater than `b`).

  ## Examples

      march> OrderedMap.is_empty(OrderedMap.new(compare))
      true
  """
  fn new(cmp : k -> k -> Int) : {cmp: k -> k -> Int, tree: Tree(k, v)} do
    {cmp: cmp, tree: Leaf}
  end

  doc """
  Inserts or updates key k with value v in map m.  A key that compares
  equal to an existing one replaces both its key and its value.  O(log n).

  ## Examples

      march> OrderedMap.to_list(OrderedMap.put(OrderedMap.put(OrderedMap.new(compare), 2, "b"), 1, "a"))
      [(1, "a"), (2, "b")]
      march> OrderedMap.get(OrderedMap.put(OrderedMap.from_list([(1, "a")], compare), 1, "z"), 1)
      Some("z")
  """
  fn put(m : {cmp: k -> k -> Int, tree: Tree(k, v)}, k : k, v : v) : {cmp: k -> k -> Int, tree: Tree(k, v)} do
    {cmp: m.cmp, tree: tree_insert(m.tree, m.cmp, k, v)}
  end

  doc """
  Looks up key k in map m. Returns Some(v) or None.  O(log n).

  ## Examples

      march> let m = OrderedMap.from_list([(3, "c"), (1, "a"), (2, "b")], compare)
      march> OrderedMap.get(m, 2)
      Some("b")
      march> let m = OrderedMap.from_list([(3, "c"), (1, "a"), (2, "b")], compare)
      march> OrderedMap.get(m, 9)
      None
  """
  fn get(m : {cmp: k -> k -> Int, tree: Tree(k, v)}, k : k) : Option(v) do
    tree_get(m.tree, m.cmp, k)
  end

  doc """
  Deletes key k from map m. No-op if key not present.  O(log n).

  ## Examples

      march> let m = OrderedMap.from_list([(3, "c"), (1, "a"), (2, "b")], compare)
      march> OrderedMap.keys(OrderedMap.delete(m, 2))
      [1, 3]
      march> let m = OrderedMap.from_list([(3, "c"), (1, "a"), (2, "b")], compare)
      march> OrderedMap.size(OrderedMap.delete(m, 9))
      3
  """
  fn delete(m : {cmp: k -> k -> Int, tree: Tree(k, v)}, k : k) : {cmp: k -> k -> Int, tree: Tree(k, v)} do
    {cmp: m.cmp, tree: tree_delete(m.tree, m.cmp, k)}
  end

  doc """
  Returns true if key k is present in map m.

  ## Examples

      march> OrderedMap.member(OrderedMap.from_list([("a", 1)], compare), "a")
      true
      march> OrderedMap.member(OrderedMap.new(compare), "a")
      false
  """
  fn member(m : {cmp: k -> k -> Int, tree: Tree(k, v)}, k : k) : Bool do
    match tree_get(m.tree, m.cmp, k) do
    Some(_) -> true
    None -> false
    end
  end

  doc """
  Returns all keys in ascending order.

  ## Examples

      march> OrderedMap.keys(OrderedMap.from_list([("b", 2), ("a", 1)], compare))
      ["a", "b"]
  """
  fn keys(m : {cmp: k -> k -> Int, tree: Tree(k, v)}) : List(k) do
    List.map(tree_to_list(m.tree, Nil), fn pair ->
      match pair do
        (k, _) -> k
      end
    )
  end

  doc """
  Returns all values, in ascending order of their keys.

  ## Examples

      march> OrderedMap.values(OrderedMap.from_list([("b", 2), ("a", 1)], compare))
      [1, 2]
  """
  fn values(m : {cmp: k -> k -> Int, tree: Tree(k, v)}) : List(v) do
    List.map(tree_to_list(m.tree, Nil), fn pair ->
      match pair do
        (_, v) -> v
      end
    )
  end

  doc """
  Returns all (key, value) pairs in ascending key order.

  ## Examples

      march> OrderedMap.to_list(OrderedMap.from_list([(3, "c"), (1, "a")], compare))
      [(1, "a"), (3, "c")]
      march> OrderedMap.to_list(OrderedMap.new(compare))
      []
  """
  fn to_list(m : {cmp: k -> k -> Int, tree: Tree(k, v)}) : List((k, v)) do
    tree_to_list(m.tree, Nil)
  end

  doc """
  Builds a map from a list of (key, value) pairs.  Later pairs overwrite
  earlier ones with an equal key.  O(n log n).

  ## Examples

      march> OrderedMap.to_list(OrderedMap.from_list([(2, "b"), (1, "a"), (2, "z")], compare))
      [(1, "a"), (2, "z")]
  """
  fn from_list(pairs : List((k, v)), cmp : k -> k -> Int) : {cmp: k -> k -> Int, tree: Tree(k, v)} do
    List.fold_left(pairs, new(cmp), fn (m, pair) ->
      match pair do
        (k, v) -> put(m, k, v)
      end
    )
  end

  doc """
  Returns the number of entries in the map.  O(n): the count is not cached.

  ## Examples

      march> OrderedMap.size(OrderedMap.from_list([(1, "a"), (2, "b"), (1, "c")], compare))
      2
  """
  fn size(m : {cmp: k -> k -> Int, tree: Tree(k, v)}) : Int do
    tree_size(m.tree)
  end

  doc """
  Returns the smallest key, or None if empty.  O(log n).

  ## Examples

      march> OrderedMap.min_key(OrderedMap.from_list([(3, "c"), (1, "a")], compare))
      Some(1)
      march> OrderedMap.min_key(OrderedMap.new(compare))
      None
  """
  fn min_key(m : {cmp: k -> k -> Int, tree: Tree(k, v)}) : Option(k) do
    match tree_min(m.tree) do
    Some((k, _)) -> Some(k)
    None -> None
    end
  end

  doc """
  Returns the largest key, or None if empty.  O(log n).

  ## Examples

      march> OrderedMap.max_key(OrderedMap.from_list([(3, "c"), (1, "a")], compare))
      Some(3)
      march> OrderedMap.max_key(OrderedMap.new(compare))
      None
  """
  fn max_key(m : {cmp: k -> k -> Int, tree: Tree(k, v)}) : Option(k) do
    match tree_max(m.tree) do
    Some((k, _)) -> Some(k)
    None -> None
    end
  end

  doc """
  Folds over the map in ascending key order: f(acc, key, value) -> acc.

  ## Examples

      march> OrderedMap.fold(OrderedMap.from_list([(2, "b"), (1, "a")], compare), "", fn (acc, k, v) -> acc ++ v)
      "ab"
  """
  fn fold(m : {cmp: k -> k -> Int, tree: Tree(k, v)}, acc : b, f : b -> k -> v -> b) : b do
    tree_fold(m.tree, acc, f)
  end

  doc """
  Maps f over all values, preserving keys and order.  `f` receives both
  the key and the value: f(key, value) -> new_value.

  ## Examples

      march> OrderedMap.to_list(OrderedMap.map(OrderedMap.from_list([(1, 10), (2, 20)], compare), fn (k, v) -> k + v))
      [(1, 11), (2, 22)]
  """
  fn map(m : {cmp: k -> k -> Int, tree: Tree(k, v)}, f : k -> v -> w) : {cmp: k -> k -> Int, tree: Tree(k, w)} do
    {cmp: m.cmp, tree: tree_map(m.tree, f)}
  end

  doc """
  Returns a new map containing only entries where f(k, v) is true.

  ## Examples

      march> OrderedMap.to_list(OrderedMap.filter(OrderedMap.from_list([(1, "a"), (2, "b"), (3, "c")], compare), fn (k, v) -> k != 2))
      [(1, "a"), (3, "c")]
  """
  fn filter(m : {cmp: k -> k -> Int, tree: Tree(k, v)}, f : k -> v -> Bool) : {cmp: k -> k -> Int, tree: Tree(k, v)} do
    {cmp: m.cmp, tree: tree_filter(m.tree, m.cmp, f)}
  end

  doc """
  Returns true if the map is empty.  O(1).

  ## Examples

      march> OrderedMap.is_empty(OrderedMap.delete(OrderedMap.from_list([(1, "a")], compare), 1))
      true
      march> OrderedMap.is_empty(OrderedMap.from_list([(1, "a")], compare))
      false
  """
  fn is_empty(m : {cmp: k -> k -> Int, tree: Tree(k, v)}) : Bool do
    match m.tree do
    Leaf -> true
    _ -> false
    end
  end

  doc """
  Returns the value for key k, or default if not present.

  ## Examples

      march> OrderedMap.get_or(OrderedMap.from_list([(1, "a")], compare), 1, "?")
      "a"
      march> OrderedMap.get_or(OrderedMap.from_list([(1, "a")], compare), 5, "?")
      "?"
  """
  fn get_or(m : {cmp: k -> k -> Int, tree: Tree(k, v)}, k : k, default : v) : v do
    match tree_get(m.tree, m.cmp, k) do
    Some(v) -> v
    None -> default
    end
  end

end
