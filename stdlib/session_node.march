-- SessionNode: the `Session.Ops` network transport. A protocol's
-- `@[endpoints]` roles run on two or more nodes, one connection per pair
-- (distributed actors, step 4 of specs/progress/2026-09-15-remote-actor-dispatch.md;
-- multiparty routing: specs/progress/2026-09-16-session-node-multiparty-routing.md).
--
-- The transport is protocol-independent: `Session.Ops` speaks in endpoint
-- ids (Int) and encoded messages (Bytes, the generated `<P>_Msg.encode`), so
-- nothing here names a protocol's constructors and nothing needs generating.
-- Roles are numbered 1..n by the generator (`<P>_Msg.role_<R>()`) and
-- `register` returns the role as the endpoint id, so an endpoint id IS its
-- role: `emit`'s `to` names the remote role, and that is what picks the
-- connection.
--
-- Two nodes:
--
--   let p = SessionNode.open(conn, "node-a", false, fn ep -> ())   -- after connect_split / accept_split
--   let s = Session.attach(io, SessionNode.ops(p))
--   ... drive the role to its first suspension ...
--   SessionNode.serve(p)          -- deliveries, until every peer's endpoint closes
--   SessionNode.finish(p)
--
-- Three or more: one `party`, then one join per peer. The side that ACCEPTS
-- learns the peer's role from its hello (a listener does not know which role
-- will connect next); the side that connects names it.
--
--   let p0 = SessionNode.party(Relay_Msg.role_B(), "node-b", fn ep -> ())
--   let p1 = SessionNode.accept_from(p0, conn_from_a)
--   let p  = SessionNode.connect_to(p1, Relay_Msg.role_C(), conn_to_c)
--
-- Connect rule, so no configuration and no deadlock: for roles i < j, i
-- listens and j connects.
--
-- On the wire, per peer connection (the control/data split):
--   data     ACTOR_MSG "SessionNode.Deliver" [to, from, msg], through a
--            NodeQueue (credit-based flow control); "SessionNode.Bye" when an
--            endpoint closes.
--   control  "SessionNode.Hello" [role, pid] (the ACCEPTING side announces
--            first), CREDIT, and a final Bye.
--
-- Receiving: a delivery is sent to this node's endpoint actor, whose turn
-- runs the continuation `suspend` installed. ONE actor per party, whatever
-- the number of peers, so a node's resumptions (and prints) run in mailbox
-- order. "Consumed" for credit is "in the mailbox".
--
-- Ordering: each connection is FIFO, but messages from DIFFERENT peers race.
-- A role that receives from A and then from B can see B's delivery first, so
-- `suspend` takes the role the continuation expects and a delivery from
-- anyone else is parked until the continuation that wants it is installed
-- (`pending`). `suspend`'s expected role is 0 for "any", which is what a
-- same-thread transport and a two-party session pass.
--
-- The role runner (`run`, at the end of this file) does all of the above
-- from a role, its peer set and a role->address table, in the order that
-- cannot deadlock; the generated `<P>_Run.run_<Role>` is its typed front.
-- `run_hosted` is the same party driving a role hosted in an actor (the
-- generated event API) -- `<P>_Run.host_<Role>`.
-- Design: specs/progress/2026-09-16-role-runner.md and
-- specs/progress/2026-09-17-actor-hosted-runner.md.
mod SessionNode do
  needs IO.Mut
  needs IO.NetConnect
  needs IO.NetListen
  needs IO.Spawn

  pfn budget() : Int do 4096 end

  -- One peer connection: the remote role it reaches and everything that
  -- connection owns.
  type Link = { role : Int, data_fd : Int, control_fd : Int, peer : GlobalPid.Pid,
                q : (Pid(NodeQueue.WriterState), Int), control : Task(Int) }

  -- The endpoint actor's state: the delivery count, and the readers'
  -- outcomes `serve_outcome` waits on (see the actor below).
  type EndpointState = { n : Int, links : Int, ended : Int, failed : List((Int, String)),
                         waiters : List(List((Int, String)) -> Unit) }

  -- The whole session on this node. `handlers` holds the installed
  -- continuation per local endpoint and `waiting` the role each expects;
  -- `pending` holds deliveries that arrived before their continuation.
  -- `meta` carries the send seq, the closed flag and the host-gone flag.
  -- `forward` (key "f") is set only for a HOSTED party (`run_hosted`): a
  -- delivery for an awaiting endpoint then goes to the user's actor through
  -- it, instead of the installed handler running here, and the actor
  -- resumes the endpoint itself (the generated event API).
  type Party = { my_role : Int, node_id : String,
                 handlers : Vault(Int -> Bytes -> Int -> Int), waiting : Vault(Int),
                 pending : Vault(List((Int, Bytes))), meta : Vault(Int),
                 forward : Vault(Int -> Bytes -> Int -> Unit), why : Vault(String),
                 ep : Pid(EndpointState), links : List(Link), on_close : Int -> Unit }

  pfn ekey(ep : Int) : String do "e" ++ int_to_string(ep) end

  pfn encode_deliver(to : Int, from : Int, msg : Bytes) : List(Int) do
    Msgpack.encode(Msgpack.array(
      Cons(Msgpack.int(to), Cons(Msgpack.int(from), Cons(Msgpack.bin(Bytes.to_list(msg)), Nil)))))
  end

  pfn decode_deliver(payload : List(Int)) : Result((Int, Int, Bytes), String) do
    match Msgpack.decode(payload) do
      Ok(Msgpack.Array(Cons(Msgpack.Int(to), Cons(Msgpack.Int(from), Cons(Msgpack.Bin(m), Nil))))) ->
        Ok((to, from, Bytes.from_list(m)))
      _ -> Err("session_node: bad Deliver payload")
    end
  end

  pfn next_seq(meta : Vault(Int)) : Int do
    Vault.incr(meta, "seq", 1)
  end

  -- ── delivery: expected sender first, everyone else parked ───────────────

  pfn take_pending(pending : Vault(List((Int, Bytes))), ep : Int, want : Int) : Option((Int, Bytes)) do
    let queued = Vault.get_or(pending, ekey(ep), Nil)
    let hit = List.find(queued, fn e -> match e do (from, _) -> want == 0 || from == want end)
    match hit do
      None -> None
      Some(found) ->
        match found do
          (from, _) ->
            -- Drop the first entry from that sender: per-peer FIFO is the
            -- order they were parked in.
            let rest = drop_first(queued, from, Nil)
            Vault.set(pending, ekey(ep), rest)
            Some(found)
        end
    end
  end

  pfn drop_first(xs : List((Int, Bytes)), from : Int, seen : List((Int, Bytes))) : List((Int, Bytes)) do
    match xs do
      Nil -> List.reverse(seen)
      Cons(e, rest) ->
        match e do
          (f, _) -> if f == from do List.append(List.reverse(seen), rest) else drop_first(rest, from, Cons(e, seen)) end
        end
    end
  end

  pfn park(pending : Vault(List((Int, Bytes))), ep : Int, from : Int, msg : Bytes) : () do
    Vault.set(pending, ekey(ep), List.append(Vault.get_or(pending, ekey(ep), Nil), Cons((from, msg), Nil)))
  end

  -- The endpoint's host is gone (restarted: its parked session state died
  -- with it). The session cannot continue and must not look as if it ended
  -- cleanly: no Bye goes out, every reader is ended (peers then see the
  -- connection drop and get `PeerGone`), and `run_hosted` reports `HostGone`.
  -- A host that exits after closing its endpoint is not this.
  pfn host_gone(p : Party, ep : Int) : Int do
    match Vault.get(p.meta, "closed") do
      Some(_) -> ep
      None ->
        Vault.set(p.meta, "host_gone", ep)
        let _ = List.map(p.links, fn l -> tcp_shutdown(l.data_fd))
        ep
    end
  end

  -- The generated code could not deliver a message to [ep]'s continuation
  -- (`Session.fail`): the peer that sent it is not speaking the protocol,
  -- and the session is abandoned the way a dead host's is -- no Bye, readers
  -- ended, `run` reports `Protocol(from, why)`.  `from` is the sender of the
  -- delivery being resumed (recorded by `resume_with`).
  pfn protocol_failed(p : Party, ep : Int, why : String) : () do
    match Vault.get(p.meta, "closed") do
      Some(_) -> ()
      None ->
        Vault.set(p.why, "protocol", why)
        Vault.set(p.meta, "protocol", Vault.get_or(p.meta, "from", 0))
        let _ = List.map(p.links, fn l -> tcp_shutdown(l.data_fd))
        let _ = ep
        ()
    end
  end

  -- Watches a hosted party's actor: its `Down` -- a crash, a kill, a
  -- supervisor's restart -- is the session's end, whether or not a delivery
  -- was in flight. (Detecting it at the next delivery is not enough: a host
  -- that dies between resuming and re-parking has no handler installed, so
  -- the next delivery is parked and nothing would ever look.) `Down` is a
  -- raw mailbox message, so a dedicated actor reads it with `receive`;
  -- `run_hosted` sets the monitor (`monitor(watcher, host)`, from outside
  -- the actor, as the monitor fixture does) and sends `Stop` when the
  -- session ends, so the watcher is not left parked in `receive`.
  actor HostWatch do
    state { n : Int }
    init  { n: 0 }
    on Watch(p : Party, ep : Int) do
      match receive() do
        Down.Down(_, _, _) ->
          let _ = host_gone(p, ep)
          ()
        _ -> ()
      end
      { n: state.n + 1 }
    end
    on Stop() do state end
  end

  -- Hand [msg] to the continuation that awaits on [ep]: the installed handler
  -- (callback API), or the host actor through `forward` (hosted party), which
  -- gets ONE delivery per suspension -- it re-suspends when it has resumed,
  -- and that drains the next.
  pfn resume_with(p : Party, k : Int -> Bytes -> Int -> Int, ep : Int, from : Int, msg : Bytes) : Int do
    let _ = Vault.delete(p.handlers, ekey(ep))
    -- Who this delivery is from, for `fail`: a message the continuation
    -- cannot take is reported against its sender (RunError.Protocol).
    Vault.set(p.meta, "from", from)
    match Vault.get(p.forward, "f") do
      None ->
        let _ = k(from, msg, ep)
        drain(p, ep)
      Some(f) ->
        f(from, msg, ep)
        ep
    end
  end

  -- Run the continuation installed on [ep] with [msg] from [from], then drain
  -- whatever the new continuation is now willing to take. A delivery nobody
  -- expects yet is parked, not dropped.
  fn deliver(p : Party, ep : Int, from : Int, msg : Bytes) : Int do
    let want = Vault.get_or(p.waiting, ekey(ep), 0)
    match Vault.get(p.handlers, ekey(ep)) do
      None ->
        park(p.pending, ep, from, msg)
        ep
      Some(k) ->
        if want == 0 || want == from do
          -- This continuation is consumed by the call; anything parked is for
          -- whatever it installs next.
          resume_with(p, k, ep, from, msg)
        else
          park(p.pending, ep, from, msg)
          ep
        end
    end
  end

  pfn drain(p : Party, ep : Int) : Int do
    let want = Vault.get_or(p.waiting, ekey(ep), 0)
    match Vault.get(p.handlers, ekey(ep)) do
      None -> ep
      Some(k) ->
        match take_pending(p.pending, ep, want) do
          None -> ep
          Some(entry) ->
            match entry do
              (from, msg) -> resume_with(p, k, ep, from, msg)
            end
        end
    end
  end

  -- The endpoint actor: a delivery's continuation runs in its turn. It also
  -- collects the readers' outcomes for `serve` (`Expect` the link count,
  -- then one `LinkEnded` per reader) and answers `AwaitOutcome` at the FIRST
  -- failure or the last clean end, whichever comes first -- so a party whose
  -- peer died is not stuck awaiting readers parked on peers still alive.
  -- `failed` is empty for a clean end, else `(role, why)` per failed reader.
  pfn settled(st : EndpointState) : Bool do
    st.links > 0 && (st.ended >= st.links || List.length(st.failed) > 0)
  end

  pfn ep_state(n : Int, links : Int, ended : Int, failed : List((Int, String)),
               waiters : List(List((Int, String)) -> Unit)) : EndpointState do
    { n: n, links: links, ended: ended, failed: failed, waiters: waiters }
  end

  -- Handler ORDER is load-bearing: `Actor.call` routes a sentinel to the
  -- handler at the sentinel's constructor index within its own type
  -- (`EndpointReq`: `DeliverReq` = 0, `OutcomeReq` = 1), as in NodeQueue.
  actor Endpoint do
    state { n : Int, links : Int, ended : Int, failed : List((Int, String)),
            waiters : List(List((Int, String)) -> Unit) }
    init  { n: 0, links: 0, ended: 0, failed: Nil, waiters: Nil }
    on Deliver(p : Party, ep : Int, from : Int, msg : Bytes) do
      let _ = deliver(p, ep, from, msg)
      ep_state(state.n + 1, state.links, state.ended, state.failed, state.waiters)
    end
    on AwaitOutcome(reply_to) do
      if settled(state) do
        Actor.reply(reply_to, state.failed)
        state
      else
        -- Held across turns: retained, and as the closure that answers it
        -- (an Int-typed slot would tag the ref; see NodeQueue.Wait).
        let r = actor_reply_retain(reply_to)
        ep_state(state.n, state.links, state.ended, state.failed,
                 Cons(fn out -> Actor.reply(r, out), state.waiters))
      end
    end
    on Expect(links : Int) do
      ep_state(state.n, links, state.ended, state.failed, state.waiters)
    end
    on LinkEnded(role : Int, why : String) do
      let failed = if why == "" do state.failed else List.append(state.failed, Cons((role, why), Nil)) end
      let st = ep_state(state.n, state.links, state.ended + 1, failed, state.waiters)
      if settled(st) do
        let _ = List.map(st.waiters, fn w -> w(st.failed))
        ep_state(st.n, st.links, st.ended, st.failed, Nil)
      else
        st
      end
    end
    -- A hosted party's `suspend` runs in the HOST actor's turn; the drain of
    -- what was parked meanwhile runs here, in this actor's turn, so every
    -- look-then-act on `handlers`/`pending` happens in one mailbox order.
    on Drain(p : Party, ep : Int) do
      let _ = drain(p, ep)
      state
    end
  end

  type EndpointReq = DeliverReq | OutcomeReq

  -- ── hello: role + endpoint pid ──────────────────────────────────────────

  pfn encode_hello(role : Int, me : GlobalPid.Pid) : List(Int) do
    Msgpack.encode(Msgpack.array(
      Cons(Msgpack.int(role), Cons(Msgpack.bin(GlobalPid.encode(me)), Nil))))
  end

  pfn decode_hello(payload : List(Int)) : Result((Int, GlobalPid.Pid), String) do
    match Msgpack.decode(payload) do
      Ok(Msgpack.Array(Cons(Msgpack.Int(role), Cons(Msgpack.Bin(pid_bytes), Nil)))) ->
        match GlobalPid.decode(pid_bytes) do
          Ok(pid) -> Ok((role, pid))
          Err(e) -> Err("session_node: hello pid: " ++ e)
        end
      _ -> Err("session_node: bad Hello payload")
    end
  end

  pfn announce(fd : Int, role : Int, me : GlobalPid.Pid) : () do
    let _ = NodeSend.cast(fd, 0, GlobalPid.make("peer", 0, 0), "SessionNode.Hello", encode_hello(role, me))
    ()
  end

  pfn await_hello(fd : Int) : (Int, GlobalPid.Pid) do
    match NetKernel.recv_frame_exact(fd) do
      Err(e) -> panic("session_node: hello: " ++ e)
      Ok(frame) ->
        match NodeSend.decode_msg(frame) do
          Ok(d) ->
            if d.type_tag != "SessionNode.Hello" do panic("session_node: expected a Hello, got " ++ d.type_tag) else () end
            match decode_hello(d.payload) do
              Ok(pair) -> pair
              Err(e) -> panic(e)
            end
          Err(e) -> panic("session_node: hello frame: " ++ e)
        end
    end
  end

  -- ── control connection ──────────────────────────────────────────────────

  -- CREDIT feeds the queue; a Bye ends it (each side awaits its own reader, so
  -- closing first and awaiting would deadlock).
  pfn on_control(q : (Pid(NodeQueue.WriterState), Int), tag : Int, frame : List(Int)) : Result(Bool, String) do
    if tag == NodeQueue.tag_credit() do
      match NodeQueue.decode_credit(frame) do
        Ok(total) ->
          NodeQueue.credit(q, total)
          Ok(true)
        Err(e) -> Err(e)
      end
    else
      if tag == NodeSend.tag_actor_msg() do
        match NodeSend.decode_msg(frame) do
          Ok(d) -> Ok(d.type_tag != "SessionNode.Bye")
          Err(e) -> Err(e)
        end
      else
        if tag == NodeSend.tag_delivery_failed() do
          match NodeSend.decode_failed(frame) do
            Ok((seq, reason)) -> Err("session_node: delivery " ++ int_to_string(seq) ++ " failed: " ++ reason)
            Err(e) -> Err(e)
          end
        else
          Err("session_node: unexpected tag " ++ int_to_string(tag) ++ " on the control connection")
        end
      end
    end
  end

  pfn serve_control(control_fd : Int, q : (Pid(NodeQueue.WriterState), Int)) : Int do
    match PeerReader.serve(control_fd, Nil, fn (tag, frame) -> on_control(q, tag, frame)) do
      Ok(_) -> 0
      Err(_) -> 0
    end
  end

  -- ── building a party ────────────────────────────────────────────────────

  doc """
  Start a session on this node in role [my_role] (`<P>_Msg.role_<R>()`), with
  no peers yet: add one per remote role with `accept_from` / `connect_to`.
  [on_close] runs when a local endpoint closes, with its endpoint id.
  """
  fn party(my_role : Int, node_id : String, on_close : Int -> Unit) : Party do
    let ep = spawn(Endpoint)
    let tag = node_id ++ "." ++ int_to_string(my_role) ++ "." ++ int_to_string(pid_to_int(ep))
    { my_role: my_role, node_id: node_id,
      handlers: Vault.new("session_node_handlers_" ++ tag),
      waiting: Vault.new("session_node_waiting_" ++ tag),
      pending: Vault.new("session_node_pending_" ++ tag),
      meta: Vault.new("session_node_meta_" ++ tag),
      forward: Vault.new("session_node_forward_" ++ tag),
      why: Vault.new("session_node_why_" ++ tag),
      ep: ep, links: Nil, on_close: on_close }
  end

  pfn with_link(p : Party, l : Link) : Party do
    { my_role: p.my_role, node_id: p.node_id, handlers: p.handlers, waiting: p.waiting,
      pending: p.pending, meta: p.meta, forward: p.forward, why: p.why, ep: p.ep,
      links: List.append(p.links, Cons(l, Nil)), on_close: p.on_close }
  end

  pfn start_link(p : Party, their_role : Int, conn : Peer, peer_pid : GlobalPid.Pid) : Party do
    let q = NodeQueue.start(conn.data_fd, budget())
    let control = task_spawn(fn _ -> serve_control(conn.fd, q))
    with_link(p, { role: their_role, data_fd: conn.data_fd, control_fd: conn.fd,
                   peer: peer_pid, q: q, control: control })
  end

  doc """
  Add the peer on a connection this node ACCEPTED. The accepting side
  announces first, then learns the peer's role from its hello -- a listener
  does not know which role connects next.
  """
  fn accept_from(p : Party, conn : Peer) : Party do
    announce(conn.fd, p.my_role, GlobalPid.make(p.node_id, pid_to_int(p.ep), 1))
    match await_hello(conn.fd) do
      (their_role, peer_pid) -> start_link(p, their_role, conn, peer_pid)
    end
  end

  doc """
  Add the peer in role [their_role] on a connection this node OPENED. The
  peer announces first; a role in its hello that is not [their_role] is a
  wiring mistake and fails loudly.
  """
  fn connect_to(p : Party, their_role : Int, conn : Peer) : Party do
    match await_hello(conn.fd) do
      (announced, peer_pid) ->
        if announced != their_role && announced != 0 && their_role != 0 do
          panic("session_node: connected to role " ++ int_to_string(their_role) ++ " but it announced role " ++ int_to_string(announced))
        else () end
        announce(conn.fd, p.my_role, GlobalPid.make(p.node_id, pid_to_int(p.ep), 1))
        start_link(p, their_role, conn, peer_pid)
    end
  end

  doc """
  The two-party case in one call: a party of one peer over [conn], with role
  numbers left at 0 (a single-peer party routes every message to its one
  connection). [accepted] says which side of the connection this is.
  """
  fn open(conn : Peer, node_id : String, accepted : Bool, on_close : Int -> Unit) : Party do
    let p = party(0, node_id, on_close)
    if accepted do accept_from(p, conn) else connect_to(p, 0, conn) end
  end

  -- ── routing ─────────────────────────────────────────────────────────────

  pfn has_link(links : List(Link), role : Int) : Bool do
    match List.find(links, fn l -> l.role == role) do
      Some(_) -> true
      None -> false
    end
  end

  pfn show_roles(rs : List(Int)) : String do
    match rs do
      Nil -> ""
      Cons(r, Nil) -> int_to_string(r)
      Cons(r, rest) -> int_to_string(r) ++ ", " ++ show_roles(rest)
    end
  end

  doc """
  Check that [p] has a connection to every role in [peers] -- the generated
  `<P>_Msg.peers_<R>()`, every role [R] exchanges a message with -- and panic
  naming the missing ones. Call it before `serve`, so a wiring mistake fails
  at startup rather than at the first `emit` to an unreachable role. A party
  with exactly one peer passes: it routes everything to that connection
  whatever the role numbers say (the two-party case, where `open` never asked
  for them).
  """
  fn require(p : Party, peers : List(Int)) : Party do
    match p.links do
      Cons(_, Nil) -> p
      _ ->
        let missing = List.filter(peers, fn r -> has_link(p.links, r) == false)
        match missing do
          Nil -> p
          _ -> panic("session_node: role " ++ int_to_string(p.my_role) ++ " has no connection to role(s) " ++ show_roles(missing))
        end
    end
  end

  -- The connection that reaches role [to]. A party with exactly ONE peer
  -- routes everything to it, whatever the role numbers say: that is the
  -- two-party case, where `open` never asked for role numbers at all.
  pfn link_for(links : List(Link), to : Int) : Link do
    match links do
      Cons(single, Nil) -> single
      _ ->
        match List.find(links, fn l -> l.role == to) do
          Some(l) -> l
          None -> panic("session_node: no connection to role " ++ int_to_string(to) ++ " in this party")
        end
    end
  end

  doc "The `Session.Ops` for [p]: hand it to `Session.attach`."
  fn ops(p : Party) : Session.Ops do
    let links = p.links
    let meta = p.meta
    let handlers = p.handlers
    let waiting = p.waiting
    let on_close = p.on_close
    let forward = p.forward
    let ep_actor = p.ep
    let party = p
    {
      register: fn (_ap, role) -> role,
      emit: fn (ep, to, msg) -> do
        let l = link_for(links, to)
        let _ = NodeQueue.cast(l.q, next_seq(meta), l.peer, "SessionNode.Deliver", encode_deliver(to, ep, msg), NodeQueue.DropNew)
        ep
      end,
      suspend: fn (ep, from, handler) -> do
        Vault.set(waiting, ekey(ep), from)
        Vault.set(handlers, ekey(ep), handler)
        -- Hosted: this runs in the host actor's turn. A delivery parked
        -- while the host was resuming is drained in the endpoint actor's
        -- turn, never here (see `Drain`).
        match Vault.get(forward, "f") do
          None -> ()
          Some(_) -> send(ep_actor, Drain(party, ep))
        end
        ep
      end,
      close: fn ep -> do
        on_close(ep)
        Vault.set(meta, "closed", 1)
        -- Every peer's reader has to learn this endpoint is done.
        let _ = List.map(links, fn l ->
          NodeQueue.cast(l.q, next_seq(meta), l.peer, "SessionNode.Bye", Nil, NodeQueue.DropNew))
        ()
      end,
      fail: fn (ep, why) -> protocol_failed(party, ep, why)
    }
  end

  -- ── reading ─────────────────────────────────────────────────────────────

  pfn on_frame(p : Party, l : Link, tag : Int, frame : List(Int)) : Result(Bool, String) do
    if tag == NodeSend.tag_actor_msg() do
      match NodeSend.decode_msg(frame) do
        Err(e) -> Err(e)
        Ok(d) ->
          if d.type_tag == "SessionNode.Bye" do
            Ok(false)
          else
            if d.type_tag == "SessionNode.Deliver" do
              match decode_deliver(d.payload) do
                Err(e) -> Err(e)
                Ok((to, from, msg)) ->
                  send(p.ep, Deliver(p, to, from, msg))
                  let _ = NodeQueue.consumed(l.control_fd, budget(), List.length(frame) + 4)
                  Ok(true)
              end
            else
              Err("session_node: unexpected type " ++ d.type_tag)
            end
          end
      end
    else
      Err("session_node: unexpected tag " ++ int_to_string(tag) ++ " on the data connection")
    end
  end

  -- Read one peer to its end. "" is a clean end; anything else is why the
  -- reader failed. Once a local endpoint has closed, a peer closing its data
  -- connection (its Bye may still be in its writer) is a clean end.
  pfn read_link(p : Party, l : Link) : String do
    match PeerReader.serve(l.data_fd, Nil, fn (tag, frame) -> on_frame(p, l, tag, frame)) do
      Ok(_) -> ""
      Err(e) ->
        if Vault.get(p.meta, "closed") != None do ""
        else
          -- The party ended this reader itself (host gone): still a failure,
          -- so the outcome settles, but `run_hosted` reports HostGone.
          e
        end
    end
  end

  pfn await_outcome(p : Party) : List((Int, String)) do
    match Actor.call(p.ep, OutcomeReq, 3600000) do
      Ok(failed) -> failed
      Err(_) -> await_outcome(p)
    end
  end

  doc """
  Read deliveries from every peer until each one's endpoint closes, or until
  the first reader fails before this node's endpoint closed: `Nil` for a
  clean end, else `(role, why)` for each failed reader. Every resumption runs
  in this node's endpoint actor, so call it after driving the local role to
  its first suspension. `serve` is this with a panic on failure; `run` maps
  the failure to a `RunError`.

  On a failure the other readers are still parked on peers that are alive
  and waiting; they are ended with `tcp_shutdown` (a close would not wake
  them), so `finish` can follow at once and the process can exit.
  """
  fn serve_outcome(p : Party) : List((Int, String)) do
    match p.links do
      -- One peer: read on this green thread, as the two-party transport
      -- always did.
      Cons(single, Nil) ->
        let why = read_link(p, single)
        if why == "" do Nil else Cons((single.role, why), Nil) end
      _ ->
        send(p.ep, Expect(List.length(p.links)))
        let _ = List.map(p.links, fn l -> task_spawn(fn _ -> do
          send(p.ep, LinkEnded(l.role, read_link(p, l)))
          0
        end))
        let failed = await_outcome(p)
        match failed do
          Nil -> ()
          _ ->
            let _ = List.map(p.links, fn l -> tcp_shutdown(l.data_fd))
            ()
        end
        failed
    end
  end

  doc "`serve_outcome`, panicking on a reader failure; the transport's original contract."
  fn serve(p : Party) : Unit do
    match serve_outcome(p) do
      Nil -> ()
      Cons((_, why), _) -> panic("session_node: reader: " ++ why)
    end
  end

  doc "Tear every connection down: close data, Bye on control, await the control reader, close control."
  fn finish(p : Party) : Unit do
    let _ = List.map(p.links, fn l -> do
      tcp_close(l.data_fd)
      let _ = NodeSend.cast(l.control_fd, 0, GlobalPid.make("peer", 0, 0), "SessionNode.Bye", Nil)
      let _ = task_await(l.control)
      tcp_close(l.control_fd)
      0
    end)
    ()
  end

  -- ── the role runner ─────────────────────────────────────────────────────
  -- Everything above, from a role, its peer set and an address table, in
  -- the one order that cannot deadlock: connect to every LOWER role
  -- (ascending), then accept every HIGHER one. Role 1 has nothing to connect
  -- to, so it is accepting at once; role k connects only to roles below it,
  -- each of which finished its own connects and is accepting. No node ever
  -- waits on a node that is waiting on it.
  --
  -- Addresses are a runtime value; their SHAPE is checked here from what the
  -- compiler knows (`peers_<R>()`): a role needs its own entry iff some peer
  -- is above it, and an entry for every peer below it. A missing one fails
  -- at startup, by role, before any socket opens.

  -- Where a role listens: its own entry says where; a peer's entry says
  -- where to dial it.
  type Addr = { role : Int, host : String, port : Int }
  -- Signatures below say `List(Addr)` outright: an alias does not unify
  -- with its expansion across a module boundary, and a caller building the
  -- table by hand (`Cons(addr, Nil)`) must be able to pass it.
  type Addrs = List(Addr)

  -- Why `run` ended other than by the protocol reaching its end. A session
  -- is not resumable: a peer that is gone ends it for everyone, and `run`
  -- returns rather than hanging on it. What to do next (run again: a fresh
  -- party and fresh connections) is the caller's decision.
  --
  -- - `PeerGone(role, why)`: that peer's connection ended mid-session.
  -- - `Protocol(role, why)`: that peer sent what cannot be delivered -- a
  --   message the generated code could not decode or one its state cannot
  --   receive (`Session.fail`), or a frame this transport cannot read.
  -- - `HostGone(ep)`: a hosted party's actor is gone (restarted); its parked
  --   session state died with it, so the session is abandoned, and the peers
  --   see the connection drop (`PeerGone`).
  -- - `Listen(port, why)` / `Accept(why)` / `Connect(role, why)`: wiring.
  type RunError = PeerGone(Int, String) | Protocol(Int, String) | HostGone(Int) | Listen(Int, String) | Accept(String) | Connect(Int, String)

  fn run_error_message(e : RunError) : String do
    match e do
      PeerGone(role, why) -> "session_node: role " ++ int_to_string(role) ++ " is gone: " ++ why
      Protocol(role, why) -> "session_node: role " ++ int_to_string(role) ++ ": " ++ why
      HostGone(ep) -> "session_node: endpoint " ++ int_to_string(ep) ++ ": its host actor is gone and the parked session state with it; session abandoned"
      Listen(port, why) -> "session_node: listen on port " ++ int_to_string(port) ++ ": " ++ why
      Accept(why) -> "session_node: accept: " ++ why
      Connect(role, why) -> "session_node: connect to role " ++ int_to_string(role) ++ ": " ++ why
    end
  end

  doc "The peers [my_role] dials: those below it, ascending (i < j: i listens, j connects)."
  fn dials(my_role : Int, peers : List(Int)) : List(Int) do
    List.sort_by(List.filter(peers, fn r -> r < my_role), fn (a, b) -> a < b)
  end

  doc "The peers [my_role] accepts: those above it."
  fn accepts(my_role : Int, peers : List(Int)) : List(Int) do
    List.filter(peers, fn r -> r > my_role)
  end

  fn addr_of(addrs : List(Addr), role : Int) : Option(Addr) do
    List.find(addrs, fn a -> a.role == role)
  end

  pfn has_addr(addrs : List(Addr), role : Int) : Bool do
    match addr_of(addrs, role) do
      Some(_) -> true
      None -> false
    end
  end

  doc """
  The roles [my_role] needs an address for and [addrs] lacks: every peer it
  dials, and itself if it accepts anyone. Empty means `run` can start.
  """
  fn missing_addrs(my_role : Int, peers : List(Int), addrs : List(Addr)) : List(Int) do
    let need = match accepts(my_role, peers) do
      Nil -> dials(my_role, peers)
      _ -> Cons(my_role, dials(my_role, peers))
    end
    List.filter(need, fn r -> has_addr(addrs, r) == false)
  end

  doc "Parse `host:port` into the entry for [role]."
  fn parse_addr(role : Int, s : String) : Result(Addr, String) do
    match String.split_first(s, ":") do
      None -> Err("session_node: address " ++ s ++ " is not host:port")
      Some((host, port_s)) ->
        match String.to_int(port_s) do
          Ok(port) -> Ok({ role: role, host: host, port: port })
          Err(_) -> Err("session_node: address " ++ s ++ " has a bad port")
        end
    end
  end

  doc """
  One entry per role from the environment: `<PREFIX>_<ROLE>_ADDR = host:port`
  (upper-cased) for each `(name, index)` in [roles], the generated
  `<P>_Msg.role_names()`. An unset variable is no entry, and `run` names the
  roles it needed; a set one that does not parse panics. The generated
  `<P>_Run.addrs_from_env()` passes the protocol's name and roles.
  """
  fn addrs_from_env(prefix : String, roles : List((String, Int))) : List(Addr) do
    List.flat_map(roles, fn r -> match r do
      (name, idx) ->
        let key = String.to_uppercase(prefix ++ "_" ++ name ++ "_ADDR")
        match process_env(key) do
          None -> Nil
          Some(v) ->
            match parse_addr(idx, v) do
              Ok(a) -> Cons(a, Nil)
              Err(e) -> panic(e ++ " (" ++ key ++ ")")
            end
        end
    end)
  end

  -- 200 attempts 100 ms apart: 20 s for a peer that is still starting.
  pfn dial_retry(a : Addr, me, secret : String, attempts : Int) : Result(Peer, String) do
    match ClusterConn.connect_split(PeerRegistry.empty(), a.host, a.port, me, secret) do
      Ok((_reg, conn)) -> Ok(conn)
      Err(e) ->
        if attempts <= 1 do
          Err(e)
        else
          sleep_ms(100)
          dial_retry(a, me, secret, attempts - 1)
        end
    end
  end

  pfn dial_all(p : Party, roles : List(Int), addrs : List(Addr), me, secret : String) : Result(Party, RunError) do
    match roles do
      Nil -> Ok(p)
      Cons(r, rest) ->
        match addr_of(addrs, r) do
          None -> Err(Connect(r, "no address"))
          Some(a) ->
            match dial_retry(a, me, secret, 200) do
              Err(e) -> Err(Connect(r, e))
              Ok(conn) -> dial_all(connect_to(p, r, conn), rest, addrs, me, secret)
            end
        end
    end
  end

  pfn last_role(links : List(Link)) : Int do
    match links do
      Nil -> 0
      Cons(l, Nil) -> l.role
      Cons(_, rest) -> last_role(rest)
    end
  end

  -- Accept one connection per role in [expected], in whatever order they
  -- arrive: the hello says which role it is. A role not expected, or seen
  -- twice, is a wiring mistake and fails loudly.
  pfn accept_all(p : Party, expected : List(Int), listen_fd : Int, me, secret : String) : Result(Party, RunError) do
    match expected do
      Nil -> Ok(p)
      _ ->
        match ClusterConn.accept_split(PeerRegistry.empty(), listen_fd, me, secret) do
          Err(e) -> Err(Accept(e))
          Ok((_reg, conn)) ->
            let p2 = accept_from(p, conn)
            let got = last_role(p2.links)
            if List.member(expected, got) == false do
              panic("session_node: role " ++ int_to_string(p.my_role) ++ " accepted a connection from role "
                    ++ int_to_string(got) ++ " but expects role(s) " ++ show_roles(expected))
            else () end
            accept_all(p2, List.filter(expected, fn r -> r != got), listen_fd, me, secret)
        end
    end
  end

  pfn open_listener(my_role : Int, higher : List(Int), addrs : List(Addr)) : Result(Int, RunError) do
    match higher do
      Nil -> Ok(-1)
      _ ->
        match addr_of(addrs, my_role) do
          None -> Ok(-1)   -- unreachable: missing_addrs was checked first
          Some(a) ->
            match tcp_listen(a.port) do
              Ok(fd) -> Ok(fd)
              Err(e) -> Err(Listen(a.port, e))
            end
        end
    end
  end

  doc """
  Run role [my_role] of a session on this node: listen if any peer is above
  it, connect to every peer below it (ascending, with retry), accept every
  peer above it, check the party against [peers] (`<P>_Msg.peers_<R>()`),
  attach, run [body] to its first suspension, serve, and tear down. [addrs]
  must hold this role's own entry iff it accepts anyone and an entry for
  every peer it dials; a missing one panics by role before any socket opens.
  [node_id] names this node in the handshake and [secret] is the cluster
  secret every node shares. The generated `<P>_Run.run_<Role>` supplies the
  role, its peers and the typed entry state.

  `Ok(())` when every peer's endpoint closed; else the `RunError` that ended
  the session, after the party has been torn down.
  """
  fn run(io : Cap(IO), my_role : Int, peers : List(Int), node_id : String, secret : String,
         addrs : List(Addr), on_close : Int -> Unit, body : Cap(Session.Live) -> Unit) : Result((), RunError) do
    run_party(io, my_role, peers, node_id, secret, addrs, on_close, fn (_p, s) -> body(s))
  end

  doc """
  `run`, with the role HOSTED IN AN ACTOR [host] (its pid as an Int,
  `pid_to_int`): the generated event API (`Parked_<Role>` in the actor's
  state, `await_*`/`resume`) instead of a body. [start] runs once the party
  is connected, with the session capability: send it to the actor, whose
  start handler registers and parks. [deliver] is called for every delivery
  the actor's parked endpoint awaits -- `(s, from, msg, ep)`, what its resume
  handler takes: send them on. Deliveries are one per suspension, in mailbox
  order, and one that arrives before the host has re-parked is held for it.

  The host is monitored: its `Down` (a crash, a kill, a supervisor's restart)
  ends the session with `Err(HostGone(ep))`, no Bye sent, so the peers see
  the connection drop (`PeerGone`). A restarted actor starts `Idle` and
  cannot continue a session its predecessor parked; run again for a new one.
  The generated `<P>_Run.host_<Role>` supplies the role and its peers.
  """
  fn run_hosted(io : Cap(IO), my_role : Int, peers : List(Int), node_id : String, secret : String,
                addrs : List(Addr), on_close : Int -> Unit, host : Int, start : Cap(Session.Live) -> Unit,
                deliver : Cap(Session.Live) -> Int -> Bytes -> Int -> Unit) : Result((), RunError) do
    run_party(io, my_role, peers, node_id, secret, addrs, on_close, fn (p, s) -> do
      Vault.set(p.forward, "f", fn (from, msg, ep) -> deliver(s, from, msg, ep))
      let w = spawn(HostWatch)
      send(w, Watch(p, my_role))
      let _ = monitor(w, pid_of_int(host))
      Vault.set(p.meta, "watch", pid_to_int(w))
      start(s)
    end)
  end

  pfn run_party(io : Cap(IO), my_role : Int, peers : List(Int), node_id : String, secret : String,
                addrs : List(Addr), on_close : Int -> Unit, drive : Party -> Cap(Session.Live) -> Unit) : Result((), RunError) do
    match missing_addrs(my_role, peers, addrs) do
      Nil -> ()
      missing -> panic("session_node: role " ++ int_to_string(my_role) ++ " needs an address for role(s) " ++ show_roles(missing))
    end
    let me = NodeIdentity.make(node_id, "pk-" ++ node_id, 1)
    let higher = accepts(my_role, peers)
    let? listen_fd = open_listener(my_role, higher, addrs)
    let p0 = party(my_role, node_id, on_close)
    let? p1 = dial_all(p0, dials(my_role, peers), addrs, me, secret)
    let? p2 = accept_all(p1, higher, listen_fd, me, secret)
    let p = require(p2, peers)
    let s = Session.attach(io, ops(p))
    drive(p, s)
    let failed = serve_outcome(p)
    finish(p)
    if listen_fd >= 0 do tcp_close(listen_fd) else () end
    match Vault.get(p.meta, "watch") do
      Some(w) -> send(pid_of_int(w), Stop)
      None -> ()
    end
    match Vault.get(p.meta, "protocol") do
      Some(from) -> Err(Protocol(from, Vault.get_or(p.why, "protocol", "protocol error")))
      None ->
        match Vault.get(p.meta, "host_gone") do
          Some(ep) -> Err(HostGone(ep))
          None ->
            match failed do
              Nil -> Ok(())
              Cons((role, why), _) ->
                if String.starts_with(why, "session_node:") do Err(Protocol(role, why)) else Err(PeerGone(role, why)) end
            end
        end
    end
  end
end
