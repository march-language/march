-- SessionNode: the `Session.Ops` network transport. A protocol's
-- `@[endpoints]` roles run on two or more nodes, one connection per pair
-- (distributed actors, step 4 of specs/progress/2026-09-15-remote-actor-dispatch.md;
-- multiparty routing: specs/progress/2026-09-16-session-node-multiparty-routing.md).
--
-- The transport is protocol-independent: `Session.Ops` speaks in endpoint
-- ids (Int) and encoded messages (Bytes, the generated `<P>_Msg.encode`), so
-- nothing here names a protocol's constructors and nothing needs generating.
-- Roles are numbered 1..n by the generator (`<P>_Msg.role_<R>()`) and
-- `register` returns the role as the endpoint id, so an endpoint id IS its
-- role: `emit`'s `to` names the remote role, and that is what picks the
-- connection.
--
-- Two nodes:
--
--   let p = SessionNode.open(conn, "node-a", false, fn ep -> ())   -- after connect_split / accept_split
--   let s = Session.attach(io, SessionNode.ops(p))
--   ... drive the role to its first suspension ...
--   SessionNode.serve(p)          -- deliveries, until every peer's endpoint closes
--   SessionNode.finish(p)
--
-- Three or more: one `party`, then one join per peer. The side that ACCEPTS
-- learns the peer's role from its hello (a listener does not know which role
-- will connect next); the side that connects names it.
--
--   let p0 = SessionNode.party(Relay_Msg.role_B(), "node-b", fn ep -> ())
--   let p1 = SessionNode.accept_from(p0, conn_from_a)
--   let p  = SessionNode.connect_to(p1, Relay_Msg.role_C(), conn_to_c)
--
-- Connect rule, so no configuration and no deadlock: for roles i < j, i
-- listens and j connects.
--
-- On the wire, per peer connection (the control/data split):
--   data     ACTOR_MSG "SessionNode.Deliver" [to, from, msg], through a
--            NodeQueue (credit-based flow control); "SessionNode.Bye" when an
--            endpoint closes.
--   control  "SessionNode.Hello" [role, pid] (the ACCEPTING side announces
--            first), CREDIT, and a final Bye.
--
-- Receiving: a delivery is sent to this node's endpoint actor, whose turn
-- runs the continuation `suspend` installed. ONE actor per party, whatever
-- the number of peers, so a node's resumptions (and prints) run in mailbox
-- order. "Consumed" for credit is "in the mailbox".
--
-- Ordering: each connection is FIFO, but messages from DIFFERENT peers race.
-- A role that receives from A and then from B can see B's delivery first, so
-- `suspend` takes the role the continuation expects and a delivery from
-- anyone else is parked until the continuation that wants it is installed
-- (`pending`). `suspend`'s expected role is 0 for "any", which is what a
-- same-thread transport and a two-party session pass.
--
-- Failure (specs/todos/2026-09-18-choreography-failure-handling.md, after
-- Maty's affine sessions): a role that fails is CANCELLED. Its node sends a
-- `SessionNode.Cancel` frame on each data connection, behind everything
-- it already sent, and a dropped connection counts as one at that point in
-- the stream. Messages to a cancelled role are discarded. A local endpoint
-- fails only when its continuation waits on a role that can send nothing
-- more and nothing from that role is still queued; its cancel handler then
-- runs and it is cancelled in turn, which is how failure cascades. Every
-- one of these events goes through the endpoint actor's mailbox, behind the
-- deliveries that preceded it, so the "handle what was already sent" rule
-- holds by construction. A heartbeat on each data connection catches a
-- peer that stops without closing.
--
-- The role runner (`run`, at the end of this file) does all of the above
-- from a role, its peer set and a role->address table, in the order that
-- cannot deadlock; the generated `<P>_Run.run_<Role>` is its typed front.
-- `run_hosted` is the same party driving a role hosted in an actor (the
-- generated event API) -- `<P>_Run.host_<Role>`.
-- Design: specs/progress/2026-09-16-role-runner.md and
-- specs/progress/2026-09-17-actor-hosted-runner.md.
mod SessionNode do
  needs IO
  needs IO.Mut
  needs IO.NetConnect
  needs IO.NetListen
  needs IO.Process
  needs IO.Spawn
  needs Session.Live

  pfn budget() : Int do 4096 end

  -- One peer connection: the remote role it reaches and everything that
  -- connection owns.
  type Link = { role : Int, data_fd : Int, control_fd : Int, peer : GlobalPid.Pid,
                q : (Pid(NodeQueue.WriterState), Int), control : Task(Int) }

  -- The endpoint actor's state: the delivery count, and the readers'
  -- outcomes `serve_outcome` waits on (see the actor below).
  type EndpointState = { n : Int, links : Int, ended : Int, failed : List((Int, String)),
                         waiters : List(List((Int, String)) -> Unit) }

  -- The whole session on this node. `handlers` holds the installed
  -- continuation per local endpoint and `waiting` the role each expects;
  -- `pending` holds deliveries that arrived before their continuation.
  -- `meta` carries the send seq, the closed flag and the host-gone flag.
  -- `forward` (key "f") is set only for a HOSTED party (`run_hosted`): a
  -- delivery for an awaiting endpoint then goes to the user's actor through
  -- it, instead of the installed handler running here, and the actor
  -- resumes the endpoint itself (the generated event API).
  --
  -- Failure state: `gone` maps a peer role that can send nothing more to
  -- why ("closed" for a normal close, else the cancellation cause);
  -- `cancel_hs` holds the cancel handler installed with the current
  -- continuation (`Session.on_cancel`); `crash_hs` the crash continuation
  -- installed with it (`Session.on_crash`), under the endpoint AND the role
  -- it is for (`crash_key`); `forward_cancel` (key "c") is the
  -- hosted party's way to tell its actor that its endpoint was cancelled and
  -- `forward_crash` (key "x") its way to tell it that a role it waits on
  -- crashed, so the actor takes the crash branch itself (the crash arrives
  -- on the delivery route, as `Session.crash_payload`, and the generated
  -- `resume` turns it into a `Crashed_…` event); `heard` counts heartbeat ticks
  -- since a peer's last frame. Our own endpoint's end is in `meta`: "done"
  -- once it closed or was cancelled, and for a cancellation "kind"
  -- (see `cancel_endpoint`), "cancel_role", and `why`'s "cancel_cause".
  type Party = { my_role : Int, node_id : String,
                 handlers : Vault(Int -> Bytes -> Int -> Int), waiting : Vault(Int),
                 pending : Vault(List((Int, Bytes))), meta : Vault(Int),
                 forward : Vault(Int -> Bytes -> Int -> Unit), why : Vault(String),
                 gone : Vault(String), cancel_hs : Vault(Int -> String -> Int -> Int),
                 crash_hs : Vault(Int -> String -> Int -> Int),
                 forward_cancel : Vault(Int -> String -> Int -> Unit),
                 forward_crash : Vault(Int -> String -> Int -> Unit), heard : Vault(Int),
                 ep : Pid(EndpointState), links : List(Link), on_close : Int -> Unit }

  pfn ekey(ep : Int) : String do "e" ++ int_to_string(ep) end
  pfn crash_key(ep : Int, role : Int) : String do ekey(ep) ++ "/r" ++ int_to_string(role) end

  pfn encode_deliver(to : Int, from : Int, msg : Bytes) : List(Int) do
    Msgpack.encode(Msgpack.array(
      Cons(Msgpack.int(to), Cons(Msgpack.int(from), Cons(Msgpack.bin(Bytes.to_list(msg)), Nil)))))
  end

  pfn decode_deliver(payload : List(Int)) : Result((Int, Int, Bytes), String) do
    match Msgpack.decode(payload) do
      Ok(Msgpack.Array(Cons(Msgpack.Int(to), Cons(Msgpack.Int(from), Cons(Msgpack.Bin(m), Nil))))) ->
        Ok((to, from, Bytes.from_list(m)))
      _ -> Err("session_node: bad Deliver payload")
    end
  end

  -- ── cluster mode ─────────────────────────────────────────────────────────
  -- A party run by `run_cluster` has no connections of its own: it rides the
  -- cluster node's (ClusterNode), shared by every session between the two
  -- nodes. Its frames carry the session id in the type tag
  -- ("SessionNode.Deliver#<sid>"), so a frame for another session -- an
  -- old one whose endpoint pid was reused -- is refused, not delivered.

  pfn is_cluster(p : Party) : Bool do Vault.get(p.why, "sid") != None end

  pfn wire_tag(p : Party, kind : String) : String do
    match Vault.get(p.why, "sid") do
      Some(sid) -> kind ++ "#" ++ sid
      None -> kind
    end
  end

  -- Bye names its sender in cluster mode (one route serves every peer, so
  -- the connection no longer says who it is from); empty otherwise, as
  -- before.
  pfn bye_payload(p : Party) : List(Int) do
    if is_cluster(p) do Msgpack.encode(Msgpack.int(p.my_role)) else Nil end
  end

  pfn next_seq(meta : Vault(Int)) : Int do
    Vault.incr(meta, "seq", 1)
  end

  -- ── delivery: expected sender first, everyone else parked ───────────────

  pfn take_pending(pending : Vault(List((Int, Bytes))), ep : Int, want : Int) : Option((Int, Bytes)) do
    let queued = Vault.get_or(pending, ekey(ep), Nil)
    let hit = List.find(queued, fn e -> match e do (from, _) -> want == 0 || from == want end)
    match hit do
      None -> None
      Some(found) ->
        match found do
          (from, _) ->
            -- Drop the first entry from that sender: per-peer FIFO is the
            -- order they were parked in.
            let rest = drop_first(queued, from, Nil)
            Vault.set(pending, ekey(ep), rest)
            Some(found)
        end
    end
  end

  pfn drop_first(xs : List((Int, Bytes)), from : Int, seen : List((Int, Bytes))) : List((Int, Bytes)) do
    match xs do
      Nil -> List.reverse(seen)
      Cons(e, rest) ->
        match e do
          (f, _) -> if f == from do List.append(List.reverse(seen), rest) else drop_first(rest, from, Cons(e, seen)) end
        end
    end
  end

  pfn park(pending : Vault(List((Int, Bytes))), ep : Int, from : Int, msg : Bytes) : () do
    Vault.set(pending, ekey(ep), List.append(Vault.get_or(pending, ekey(ep), Nil), Cons((from, msg), Nil)))
  end

  -- ── cancellation ────────────────────────────────────────────────────────

  pfn rkey(role : Int) : String do "r" ++ int_to_string(role) end

  pfn ep_done(p : Party) : Bool do Vault.get(p.meta, "done") != None end

  pfn encode_cancel(role : Int, cause : String) : List(Int) do
    Msgpack.encode(Msgpack.array(Cons(Msgpack.int(role), Cons(Msgpack.str(cause), Nil))))
  end

  pfn decode_cancel(payload : List(Int)) : Result((Int, String), String) do
    match Msgpack.decode(payload) do
      Ok(Msgpack.Array(Cons(Msgpack.Int(role), Cons(Msgpack.Str(cause), Nil)))) -> Ok((role, cause))
      _ -> Err("session_node: bad Cancel payload")
    end
  end

  -- Send one session frame (Deliver, Bye, Cancel) to [l]'s peer. These are
  -- never dropped and the sender never waits (`NodeQueue.Unbounded`): the
  -- frame is queued past the budget if need be and goes out as the peer's
  -- credit allows. Under `DropNew`, a message over the 4096-byte budget, or
  -- most of a burst, was refused and the result ignored: a lost Deliver left
  -- its receiver waiting forever while both nodes kept heartbeating, and a
  -- lost Bye or Cancel ended the session later with the wrong cause. The
  -- sender must not block instead: it runs in the endpoint actor's turn (or
  -- the host actor's), which handles none of its other messages while it
  -- waits for credit, so a wait on one slow peer would hold up every other
  -- (and the reader's `LinkEnded`). The queue grows only while the peer is slow,
  -- and a peer that stays silent is dropped by the heartbeat, whose
  -- `drop_link` lets the queue go.
  --
  -- Bounded all the same: past MARCH_SESSION_QUEUE_MAX_BYTES (default 64 MiB)
  -- queued and unread for the peer, it has stopped reading (`over_limit`).
  pfn send_frame(p : Party, l : Link, type_tag : String, payload : List(Int)) : () do
    if Vault.get(p.meta, "over" ++ rkey(l.role)) != None do ()   -- given up on: discard
    else
      let limit = queue_limit()
      if limit > 0 && NodeQueue.depth(l.q) > limit do over_limit(p, l, limit)
      else
        -- `Unbounded` never refuses; a dead connection's reader reports it.
        let _ = NodeQueue.cast(l.q, next_seq(p.meta), l.peer, wire_tag(p, type_tag), payload, NodeQueue.Unbounded)
        ()
      end
    end
  end

  pfn queue_limit() : Int do Env.get_int("MARCH_SESSION_QUEUE_MAX_BYTES", 67108864) end

  -- More than [limit] bytes are queued for [l]'s peer and unread: it has
  -- stopped reading, and it is given up on, once. Standalone, the
  -- connection is this session's own and is torn down (`drop_link`, as the
  -- heartbeat does for a silent peer). In cluster mode the connection and
  -- its queue are the node's, shared with every other session to that
  -- node, so only this session gives up: the peer is gone for it and its
  -- frames to that peer are discarded from now on. Cluster sessions have no
  -- heartbeat (SWIM watches the node, not whether it reads its data), so
  -- without this a peer node that stopped reading would let the queue grow
  -- without bound.
  pfn over_limit(p : Party, l : Link, limit : Int) : () do
    if Vault.incr(p.meta, "over" ++ rkey(l.role), 1) == 1 do
      let why = "stopped reading (over " ++ int_to_string(limit) ++ " bytes queued)"
      if is_cluster(p) do
        let _ = send(p.ep, PeerGone(p, l.role, why))
        link_ended(p, l.role, why)
      else drop_link(p, l, why) end
    else () end
  end

  -- Give up on [l]'s peer: report it gone, let its queue go, and shut BOTH
  -- connections down -- the data one ends the reader, the control one ends
  -- the control reader, which `finish` awaits and which would otherwise
  -- wait for a Bye the peer may never send.
  pfn drop_link(p : Party, l : Link, why : String) : () do
    send(p.ep, PeerGone(p, l.role, why))
    NodeQueue.close(l.q)
    tcp_shutdown(l.data_fd)
    tcp_shutdown(l.control_fd)
  end

  -- Kinds of our own endpoint's cancellation, for `run`'s result.
  pfn kind_cancelled() : Int do 1 end
  pfn kind_protocol() : Int do 2 end
  pfn kind_host_gone() : Int do 3 end
  pfn kind_left() : Int do 4 end

  -- Cancel our endpoint [ep]: record why, run the cancel handler installed
  -- with the continuation it was waiting in (or tell the hosting actor),
  -- and send `Cancel(my_role, outward)` on every data connection, behind
  -- everything this role already sent. [role] is the peer this failure is
  -- attributed to, [cause] why, [outward] what the peers are told. Runs in
  -- the endpoint actor's turn (every caller is one of its handlers, or the
  -- generated handler it is running), and is idempotent: an endpoint that
  -- already closed or was cancelled is left alone.
  pfn cancel_endpoint(p : Party, ep : Int, role : Int, cause : String, outward : String, kind : Int) : () do
    if ep_done(p) do ()
    else
      Vault.set(p.meta, "done", 1)
      Vault.set(p.meta, "kind", kind)
      Vault.set(p.meta, "cancel_role", role)
      Vault.set(p.why, "cancel_cause", cause)
      let _ = Vault.delete(p.handlers, ekey(ep))
      let handler = match Vault.get(p.cancel_hs, ekey(ep)) do
        Some(h) -> Some(h)
        None -> Vault.get(p.cancel_hs, "cur" ++ ekey(ep))
      end
      let _ = Vault.delete(p.cancel_hs, ekey(ep))
      let _ = Vault.delete(p.cancel_hs, "cur" ++ ekey(ep))
      match handler do
        Some(h) ->
          let _ = h(role, cause, ep)
          ()
        None -> ()
      end
      match Vault.get(p.forward_cancel, "c") do
        Some(f) -> f(role, cause, ep)
        None -> ()
      end
      let _ = List.map(p.links, fn l -> send_frame(p, l, "SessionNode.Cancel", encode_cancel(p.my_role, outward)))
      ()
    end
  end

  -- Can [want] (0 = any peer) send us nothing more? `Some((role, why))` if
  -- so. For 0: every connected peer is gone.
  pfn blocked_on(p : Party, want : Int) : Option((Int, String)) do
    if want != 0 do
      match Vault.get(p.gone, rkey(want)) do
        Some(why) -> Some((want, why))
        None -> None
      end
    else
      match p.links do
        Nil -> None
        Cons(first, _) ->
          if List.all(p.links, fn l -> Vault.get(p.gone, rkey(l.role)) != None) do
            Some((first.role, Vault.get_or(p.gone, rkey(first.role), "gone")))
          else None end
      end
    end
  end

  -- Maty's E-CancelH: our endpoint's continuation waits on a role that can
  -- send nothing more, and nothing from that role is queued. Called after
  -- every drain (which consumed anything that WAS queued) and whenever a
  -- peer goes. A role that closed normally counts too: waiting on it with
  -- nothing queued means waiting forever.
  --
  -- Crash branches (the protocol declared the role `may crash`, and the
  -- receive installed a crash continuation for it, `Session.on_crash`, which
  -- an actor-hosted `await_…` does too): the
  -- continuation waiting on it is replaced by the crash branch, run here as
  -- a delivery would be -- in the endpoint actor's turn, then `drain` for
  -- whatever the branch installs next. The endpoint stays live and no Cancel
  -- frame goes out; messages to the crashed role are discarded by `emit`.
  -- The `drain` here recurses into `check_waiting` only if the branch's own
  -- first receive waits on another role that is gone: bounded by the
  -- protocol's nesting of crash branches, hence the annotation.
  @[no_warn_recursion]
  pfn check_waiting(p : Party, ep : Int) : () do
    if ep_done(p) do ()
    else
      match Vault.get(p.handlers, ekey(ep)) do
        None -> ()
        Some(_) ->
          let want = Vault.get_or(p.waiting, ekey(ep), 0)
          match blocked_on(p, want) do
            None -> ()
            Some(found) ->
              match found do
                (role, why) ->
                  let cause = if why == "closed" do "role " ++ int_to_string(role) ++ " closed without sending" else why end
                  match Vault.get(p.crash_hs, crash_key(ep, role)) do
                    Some(h) ->
                      let _ = Vault.delete(p.handlers, ekey(ep))
                      let _ = Vault.delete(p.crash_hs, crash_key(ep, role))
                      let _ = Vault.delete(p.cancel_hs, ekey(ep))
                      match Vault.get(p.forward_crash, "x") do
                        -- Hosted: the actor owns the session state, so it
                        -- takes the branch, in its own turn, and its next
                        -- `suspend` drains what is queued (as a delivery
                        -- does). The continuation installed here is inert.
                        Some(f) -> f(role, cause, ep)
                        None ->
                          let _ = h(role, cause, ep)
                          let _ = drain(p, ep)
                          ()
                      end
                    None ->
                      cancel_endpoint(p, ep, role, cause, "role " ++ int_to_string(role) ++ ": " ++ cause, kind_cancelled())
                  end
              end
          end
      end
    end
  end

  -- A peer can send nothing more: it closed ([why] = "closed") or was
  -- cancelled. The first report wins; a later one (the reader's end of file
  -- after a Cancel frame, say) is ignored.
  pfn peer_gone(p : Party, role : Int, why : String) : () do
    match Vault.get(p.gone, rkey(role)) do
      Some(_) -> ()
      None ->
        Vault.set(p.gone, rkey(role), why)
        match Vault.get(p.meta, "ep") do
          Some(ep) -> check_waiting(p, ep)
          None -> ()
        end
    end
  end

  -- The generated code could not deliver a message to [ep]'s continuation
  -- (`Session.fail`): the peer that sent it is not speaking the protocol.
  -- That peer is treated as failed: our endpoint is cancelled (with the
  -- cancel handler of the receive that got the message) and `run` reports
  -- `Protocol(from, why)`. `from` is the sender of the delivery being
  -- resumed (recorded by `resume_with`). Runs inside that delivery, in the
  -- endpoint actor's turn.
  pfn protocol_failed(p : Party, ep : Int, why : String) : () do
    let from = Vault.get_or(p.meta, "from", 0)
    Vault.set(p.gone, rkey(from), "protocol: " ++ why)
    cancel_endpoint(p, ep, from, why, "role " ++ int_to_string(from) ++ ": protocol: " ++ why, kind_protocol())
  end

  -- Watches a hosted party's actor: its `Down` -- a crash, a kill, a
  -- supervisor's restart -- is the session's end, whether or not a delivery
  -- was in flight. (Detecting it at the next delivery is not enough: a host
  -- that dies between resuming and re-parking has no handler installed, so
  -- the next delivery is parked and nothing would ever look.) `Down` is a
  -- raw mailbox message, so a dedicated actor reads it with `receive`;
  -- `run_hosted` sets the monitor (`monitor(watcher, host)`, from outside
  -- the actor, as the monitor fixture does) and kills the watcher when the
  -- session ends, so it is not left parked in `receive`.
  actor HostWatch do
    state { n : Int }
    init  { n: 0 }
    on Watch(p : Party, ep : Int) do
      -- Only a `Down` ever arrives: the session's end kills this actor
      -- rather than messaging it (a message would be read here as a
      -- `Down`, `receive()` being typed by this pattern).
      match receive() do
        Down.Down(_, _, _) ->
          let _ = send(p.ep, HostDown(p, ep))
          ()
      end
      { n: state.n + 1 }
    end
  end

  -- Hand [msg] to the continuation that awaits on [ep]: the installed handler
  -- (callback API), or the host actor through `forward` (hosted party), which
  -- gets ONE delivery per suspension -- it re-suspends when it has resumed,
  -- and that drains the next.
  pfn resume_with(p : Party, k : Int -> Bytes -> Int -> Int, ep : Int, from : Int, msg : Bytes) : Int do
    let _ = Vault.delete(p.handlers, ekey(ep))
    -- Who this delivery is from, for `fail`: a message the continuation
    -- cannot take is reported against its sender (RunError.Protocol).
    Vault.set(p.meta, "from", from)
    -- The cancel handler belongs to the continuation just consumed. It
    -- stays reachable ("cur") while that continuation runs, because `fail`
    -- inside it cancels with THIS receive's handler; the next suspend
    -- installs its own.
    match Vault.get(p.cancel_hs, ekey(ep)) do
      Some(h) ->
        Vault.set(p.cancel_hs, "cur" ++ ekey(ep), h)
        let _ = Vault.delete(p.cancel_hs, ekey(ep))
        ()
      None -> ()
    end
    -- So does the crash continuation: the message arrived, so the sender
    -- did not crash before sending it.
    let _ = Vault.delete(p.crash_hs, crash_key(ep, from))
    match Vault.get(p.forward, "f") do
      None ->
        let _ = k(from, msg, ep)
        let _ = Vault.delete(p.cancel_hs, "cur" ++ ekey(ep))
        drain(p, ep)
      Some(f) ->
        f(from, msg, ep)
        let _ = Vault.delete(p.cancel_hs, "cur" ++ ekey(ep))
        ep
    end
  end

  -- Run the continuation installed on [ep] with [msg] from [from], then drain
  -- whatever the new continuation is now willing to take. A delivery nobody
  -- expects yet is parked, not dropped.
  fn deliver(p : Party, ep : Int, from : Int, msg : Bytes) : Int do
    let want = Vault.get_or(p.waiting, ekey(ep), 0)
    if ep_done(p) do ep   -- our endpoint closed or was cancelled: discard
    else
    match Vault.get(p.handlers, ekey(ep)) do
      None ->
        park(p.pending, ep, from, msg)
        ep
      Some(k) ->
        if want == 0 || want == from do
          -- This continuation is consumed by the call; anything parked is for
          -- whatever it installs next.
          resume_with(p, k, ep, from, msg)
        else
          park(p.pending, ep, from, msg)
          ep
        end
    end
    end
  end

  -- `check_waiting` below may run a crash branch and drain again: the
  -- recursion is bounded by the protocol's nesting of crash branches.
  @[no_warn_recursion]
  pfn drain(p : Party, ep : Int) : Int do
    let want = Vault.get_or(p.waiting, ekey(ep), 0)
    match Vault.get(p.handlers, ekey(ep)) do
      None -> ep
      Some(k) ->
        match take_pending(p.pending, ep, want) do
          None ->
            -- Nothing queued from the role this continuation wants: if that
            -- role can send nothing more, this is where we fail.
            check_waiting(p, ep)
            ep
          Some(entry) ->
            match entry do
              (from, msg) -> resume_with(p, k, ep, from, msg)
            end
        end
    end
  end

  -- The endpoint actor: a delivery's continuation runs in its turn. It also
  -- collects the readers' outcomes for `serve` (`Expect` the link count,
  -- then one `LinkEnded` per reader) and answers `AwaitOutcome` at the FIRST
  -- failure or the last clean end, whichever comes first -- so a party whose
  -- peer died is not stuck awaiting readers parked on peers still alive.
  -- `failed` is empty for a clean end, else `(role, why)` per failed reader.
  pfn settled(st : EndpointState) : Bool do
    st.links > 0 && st.ended >= st.links
  end

  pfn ep_state(n : Int, links : Int, ended : Int, failed : List((Int, String)),
               waiters : List(List((Int, String)) -> Unit)) : EndpointState do
    { n: n, links: links, ended: ended, failed: failed, waiters: waiters }
  end

  -- Handler ORDER is load-bearing: `Actor.call` routes a sentinel to the
  -- handler at the sentinel's constructor index within its own type
  -- (`EndpointReq`: `DeliverReq` = 0, `OutcomeReq` = 1), as in NodeQueue.
  actor Endpoint do
    state { n : Int, links : Int, ended : Int, failed : List((Int, String)),
            waiters : List(List((Int, String)) -> Unit) }
    init  { n: 0, links: 0, ended: 0, failed: Nil, waiters: Nil }
    on Deliver(p : Party, ep : Int, from : Int, msg : Bytes) do
      let _ = deliver(p, ep, from, msg)
      ep_state(state.n + 1, state.links, state.ended, state.failed, state.waiters)
    end
    on AwaitOutcome(reply_to) do
      if settled(state) do
        Actor.reply(reply_to, state.failed)
        state
      else
        -- Held across turns: retained, and as the closure that answers it
        -- (an Int-typed slot would tag the ref; see NodeQueue.Wait).
        let r = actor_reply_retain(reply_to)
        ep_state(state.n, state.links, state.ended, state.failed,
                 Cons(fn out -> Actor.reply(r, out), state.waiters))
      end
    end
    on Expect(links : Int) do
      ep_state(state.n, links, state.ended, state.failed, state.waiters)
    end
    on LinkEnded(role : Int, why : String) do
      let failed = if why == "" do state.failed else List.append(state.failed, Cons((role, why), Nil)) end
      let st = ep_state(state.n, state.links, state.ended + 1, failed, state.waiters)
      if settled(st) do
        let _ = List.map(st.waiters, fn w -> w(st.failed))
        ep_state(st.n, st.links, st.ended, st.failed, Nil)
      else
        st
      end
    end
    -- A hosted party's `suspend` runs in the HOST actor's turn; the drain of
    -- what was parked meanwhile runs here, in this actor's turn, so every
    -- look-then-act on `handlers`/`pending` happens in one mailbox order.
    on Drain(p : Party, ep : Int) do
      let _ = drain(p, ep)
      state
    end
    -- A peer can send nothing more. Queued behind every delivery from it.
    on PeerGone(p : Party, role : Int, why : String) do
      peer_gone(p, role, why)
      state
    end
    -- The hosting actor died: our endpoint's session state died with it.
    on HostDown(p : Party, ep : Int) do
      cancel_endpoint(p, ep, p.my_role, "host gone", "host gone", kind_host_gone())
      state
    end
    -- `Session.leave`: this role exits the session on purpose.
    on Leave(p : Party, ep : Int, why : String) do
      cancel_endpoint(p, ep, p.my_role, "left: " ++ why, "left: " ++ why, kind_left())
      state
    end
    -- Cluster mode: a frame that arrived before this session was ready
    -- (its peers found, its party complete). Held here, in this actor's
    -- mailbox order, rather than by the node's data reader, which every
    -- other session and route on that connection shares; replayed on
    -- `Ready`. A frame after `Ready` is handled at once.
    on Early(slot : Vault(Party), p0 : Party, kind : Int, payload : Bytes) do
      match Vault.get(slot, "p") do
        Some(p) ->
          if Vault.get(p.meta, "ready") != None do
            let _ = cluster_kind_here(p, early_kind_name(kind), Bytes.to_list(payload))
            ()
          else park(p0.pending, -1, kind, payload) end
        None -> park(p0.pending, -1, kind, payload)
      end
      state
    end
    on Ready(p : Party) do
      Vault.set(p.meta, "ready", 1)
      let held = Vault.get_or(p.pending, ekey(-1), Nil)
      let _ = Vault.delete(p.pending, ekey(-1))
      let _ = List.map(held, fn e -> match e do
        (kind, payload) -> cluster_kind_here(p, early_kind_name(kind), Bytes.to_list(payload))
      end)
      state
    end
  end

  type EndpointReq = DeliverReq | OutcomeReq

  -- ── hello: role + endpoint pid ──────────────────────────────────────────

  -- The protocol fingerprint rides the hello as an OPTIONAL THIRD element
  -- (2026-09-21). A node built before this sends the two-element hello it
  -- always sent, and a node built after can still read it -- otherwise an
  -- old and a new node would deadlock at the handshake instead of reporting
  -- the skew. `""` means "nothing to say": the raw party API
  -- (`accept_from` / `connect_to` / `open`) has no protocol identity of its
  -- own, so it neither sends nor demands one. See `hello_verdict`.
  pfn encode_hello(role : Int, me : GlobalPid.Pid, fingerprint : String) : List(Int) do
    let head = Cons(Msgpack.int(role), Cons(Msgpack.bin(GlobalPid.encode(me)), Nil))
    Msgpack.encode(Msgpack.array(
      if fingerprint == "" do head
      else List.append(head, Cons(Msgpack.str(fingerprint), Nil)) end))
  end

  pfn decode_hello(payload : List(Int)) : Result((Int, GlobalPid.Pid, String), String) do
    match Msgpack.decode(payload) do
      Ok(Msgpack.Array(Cons(Msgpack.Int(role), Cons(Msgpack.Bin(pid_bytes), rest)))) ->
        let fp = match rest do
          Cons(Msgpack.Str(s), Nil) -> s
          _ -> ""
        end
        match GlobalPid.decode(pid_bytes) do
          Ok(pid) -> Ok((role, pid, fp))
          Err(e) -> Err("session_node: hello pid: " ++ e)
        end
      _ -> Err("session_node: bad Hello payload")
    end
  end

  doc """
  Whether a peer that announced [theirs] may join a session this node runs
  under the protocol fingerprint [mine] (`<P>_Msg.fingerprint()`).

  [mine] is `""` when this side has no protocol identity to compare (the raw
  party API), and then anything is accepted -- that path never had a check.
  [theirs] is `""` when the peer sent a hello with no fingerprint in it,
  which since 2026-09-21 means the peer is older than the check itself; that
  is a REFUSAL with a clear reason, not a silent accept. The `Handshake:`
  prefix is the one `dial_retry` stops on, so a skew is reported at once
  instead of retried until the connect budget runs out.
  """
  pfn hello_verdict(mine : String, theirs : String) : Result((), String) do
    if mine == "" do Ok(())
    else if theirs == "" do
      Err("Handshake: the peer sent no protocol fingerprint, so it was built before the session "
          ++ "handshake carried one; the two sides cannot be shown to run the same protocol. "
          ++ "Rebuild both from the same source.")
    else if mine != theirs do
      Err("Handshake: this node and its peer were built from DIFFERENT versions of the protocol "
          ++ "(fingerprint " ++ mine ++ " here, " ++ theirs ++ " there). Rebuild both from the "
          ++ "same source.")
    else Ok(()) end end end
  end

  pfn announce(fd : Int, role : Int, me : GlobalPid.Pid, fingerprint : String) : () do
    let _ = NodeSend.cast(fd, 0, GlobalPid.make("peer", 0, 0), "SessionNode.Hello",
                          encode_hello(role, me, fingerprint))
    ()
  end

  pfn read_hello(fd : Int) : Result((Int, GlobalPid.Pid, String), String) do
    match NetKernel.recv_frame_exact(fd) do
      Err(e) -> Err("session_node: hello: " ++ e)
      Ok(frame) ->
        match NodeSend.decode_msg(frame) do
          Ok(d) ->
            if d.type_tag != "SessionNode.Hello" do Err("session_node: expected a Hello, got " ++ d.type_tag)
            else decode_hello(d.payload) end
          Err(e) -> Err("session_node: hello frame: " ++ e)
        end
    end
  end

  pfn await_hello(fd : Int) : (Int, GlobalPid.Pid, String) do
    match read_hello(fd) do
      Ok(hello) -> hello
      Err(e) -> panic(e)
    end
  end

  -- `read_hello` bounded by [timeout_ms] (> 0): the control socket's receive
  -- timeout covers the read and is cleared again before the control reader
  -- takes the socket over.
  pfn read_hello_within(fd : Int, timeout_ms : Int) : Result((Int, GlobalPid.Pid, String), String) do
    let _ = if timeout_ms > 0 do tcp_set_recv_timeout(fd, timeout_ms) else Ok(()) end
    let r = read_hello(fd)
    let _ = if timeout_ms > 0 do tcp_set_recv_timeout(fd, 0) else Ok(()) end
    r
  end

  -- ── control connection ──────────────────────────────────────────────────

  -- CREDIT feeds the queue; a Bye ends it (each side awaits its own reader, so
  -- closing first and awaiting would deadlock).
  pfn on_control(q : (Pid(NodeQueue.WriterState), Int), tag : Int, frame : List(Int)) : Result(Bool, String) do
    if tag == NodeQueue.tag_credit() do
      match NodeQueue.decode_credit(frame) do
        Ok(total) ->
          NodeQueue.credit(q, total)
          Ok(true)
        Err(e) -> Err(e)
      end
    else
      if tag == NodeSend.tag_actor_msg() do
        match NodeSend.decode_msg(frame) do
          Ok(d) -> Ok(d.type_tag != "SessionNode.Bye")
          Err(e) -> Err(e)
        end
      else
        if tag == NodeSend.tag_delivery_failed() do
          match NodeSend.decode_failed(frame) do
            Ok((seq, reason)) -> Err("session_node: delivery " ++ int_to_string(seq) ++ " failed: " ++ reason)
            Err(e) -> Err(e)
          end
        else
          Err("session_node: unexpected tag " ++ int_to_string(tag) ++ " on the control connection")
        end
      end
    end
  end

  pfn serve_control(control_fd : Int, q : (Pid(NodeQueue.WriterState), Int)) : Int do
    match PeerReader.serve(control_fd, Nil, fn (tag, frame) -> on_control(q, tag, frame)) do
      Ok(_) -> 0
      Err(_) -> 0
    end
  end

  -- ── building a party ────────────────────────────────────────────────────

  doc """
  Start a session on this node in role [my_role] (`<P>_Msg.role_<R>()`), with
  no peers yet: add one per remote role with `accept_from` / `connect_to`.
  [on_close] runs when a local endpoint closes, with its endpoint id.
  """
  fn party(my_role : Int, node_id : String, on_close : Int -> Unit) : Party do
    let ep = spawn(Endpoint)
    let tag = node_id ++ "." ++ int_to_string(my_role) ++ "." ++ int_to_string(pid_to_int(ep))
    { my_role: my_role, node_id: node_id,
      handlers: Vault.new("session_node_handlers_" ++ tag),
      waiting: Vault.new("session_node_waiting_" ++ tag),
      pending: Vault.new("session_node_pending_" ++ tag),
      meta: Vault.new("session_node_meta_" ++ tag),
      forward: Vault.new("session_node_forward_" ++ tag),
      why: Vault.new("session_node_why_" ++ tag),
      gone: Vault.new("session_node_gone_" ++ tag),
      cancel_hs: Vault.new("session_node_cancel_" ++ tag),
      crash_hs: Vault.new("session_node_crash_" ++ tag),
      forward_cancel: Vault.new("session_node_fwdcancel_" ++ tag),
      forward_crash: Vault.new("session_node_fwdcrash_" ++ tag),
      heard: Vault.new("session_node_heard_" ++ tag),
      ep: ep, links: Nil, on_close: on_close }
  end

  pfn with_link(p : Party, l : Link) : Party do
    { my_role: p.my_role, node_id: p.node_id, handlers: p.handlers, waiting: p.waiting,
      pending: p.pending, meta: p.meta, forward: p.forward, why: p.why, gone: p.gone,
      cancel_hs: p.cancel_hs, crash_hs: p.crash_hs, forward_cancel: p.forward_cancel,
      forward_crash: p.forward_crash, heard: p.heard, ep: p.ep,
      links: List.append(p.links, Cons(l, Nil)), on_close: p.on_close }
  end

  -- The heartbeat starts with the connection, not with `serve`: a role
  -- that works past the timeout before its first send or receive (driving
  -- to its first suspension runs before `serve`) is pinging its peers all
  -- the while, so it is not taken for dead. See `heartbeat`.
  pfn start_link(p : Party, their_role : Int, conn : Peer, peer_pid : GlobalPid.Pid) : Party do
    let q = NodeQueue.start(conn.data_fd, budget())
    let control = task_spawn(fn _ -> serve_control(conn.fd, q))
    let l = { role: their_role, data_fd: conn.data_fd, control_fd: conn.fd,
              peer: peer_pid, q: q, control: control }
    match heartbeat_config() do
      (interval, limit) ->
        if interval > 0 do
          let _ = task_spawn(fn _ -> heartbeat(p, l, interval, limit))
          ()
        else () end
    end
    with_link(p, l)
  end

  doc """
  Add the peer on a connection this node ACCEPTED. The accepting side
  announces first, then learns the peer's role from its hello -- a listener
  does not know which role connects next.
  """
  fn accept_from(p : Party, conn : Peer) : Party do
    announce(conn.fd, p.my_role, GlobalPid.make(p.node_id, pid_to_int(p.ep), 1), "")
    match await_hello(conn.fd) do
      (their_role, peer_pid, _fp) -> start_link(p, their_role, conn, peer_pid)
    end
  end

  doc """
  Add the peer in role [their_role] on a connection this node OPENED. The
  peer announces first; a role in its hello that is not [their_role] is a
  wiring mistake and fails loudly.
  """
  fn connect_to(p : Party, their_role : Int, conn : Peer) : Party do
    match await_hello(conn.fd) do
      (announced, peer_pid, _fp) ->
        if announced != their_role && announced != 0 && their_role != 0 do
          panic("session_node: connected to role " ++ int_to_string(their_role) ++ " but it announced role " ++ int_to_string(announced))
        else () end
        announce(conn.fd, p.my_role, GlobalPid.make(p.node_id, pid_to_int(p.ep), 1), "")
        start_link(p, their_role, conn, peer_pid)
    end
  end

  doc """
  The two-party case in one call: a party of one peer over [conn], with role
  numbers left at 0 (a single-peer party routes every message to its one
  connection). [accepted] says which side of the connection this is.
  """
  fn open(conn : Peer, node_id : String, accepted : Bool, on_close : Int -> Unit) : Party do
    let p = party(0, node_id, on_close)
    if accepted do accept_from(p, conn) else connect_to(p, 0, conn) end
  end

  -- The role runner's joins: `accept_from` / `connect_to` with the hello
  -- bounded by [timeout_ms] and an `Err` instead of a panic when the peer
  -- goes quiet or sends something else, so `run` can report it. A role that
  -- announces the wrong number is still a wiring mistake and panics. The
  -- connection is closed on `Err`.
  pfn join_accepted(p : Party, conn : Peer, timeout_ms : Int, fingerprint : String) : Result(Party, String) do
    announce(conn.fd, p.my_role, GlobalPid.make(p.node_id, pid_to_int(p.ep), 1), fingerprint)
    match read_hello_within(conn.fd, timeout_ms) do
      Err(e) ->
        close_peer(conn)
        Err(e)
      Ok((their_role, peer_pid, their_fp)) ->
        match hello_verdict(fingerprint, their_fp) do
          Err(e) ->
            close_peer(conn)
            Err(e)
          Ok(_) -> Ok(start_link(p, their_role, conn, peer_pid))
        end
    end
  end

  pfn join_dialed(p : Party, their_role : Int, conn : Peer, timeout_ms : Int, fingerprint : String) : Result(Party, String) do
    match read_hello_within(conn.fd, timeout_ms) do
      Err(e) ->
        close_peer(conn)
        Err(e)
      Ok((announced, peer_pid, their_fp)) ->
        if announced != their_role && announced != 0 && their_role != 0 do
          panic("session_node: connected to role " ++ int_to_string(their_role) ++ " but it announced role " ++ int_to_string(announced))
        else () end
        -- Announce BEFORE refusing: the peer is parked in its own
        -- `read_hello_within` and would otherwise wait out its whole
        -- timeout, reporting a quiet peer rather than the skew both sides
        -- can see from the two fingerprints.
        announce(conn.fd, p.my_role, GlobalPid.make(p.node_id, pid_to_int(p.ep), 1), fingerprint)
        match hello_verdict(fingerprint, their_fp) do
          Err(e) ->
            close_peer(conn)
            Err(e)
          Ok(_) -> Ok(start_link(p, their_role, conn, peer_pid))
        end
    end
  end

  pfn close_peer(conn : Peer) : () do
    tcp_close(conn.fd)
    tcp_close(conn.data_fd)
  end

  -- Setup failed: tear down every connection made so far, so each peer's
  -- side sees it end now (and fails its own setup, or is cancelled) rather
  -- than waiting out its own timeout. Shutdown before close: it wakes the
  -- control reader parked on the socket, which close alone may not.
  pfn abort_links(p : Party) : () do
    let _ = List.map(p.links, fn l -> do
      -- Stops its heartbeat, which started with the connection.
      Vault.set(p.meta, "link_done" ++ rkey(l.role), 1)
      NodeQueue.close(l.q)
      tcp_shutdown(l.data_fd)
      tcp_shutdown(l.control_fd)
      let _ = task_await(l.control)
      tcp_close(l.data_fd)
      tcp_close(l.control_fd)
      0
    end)
    ()
  end

  -- ── routing ─────────────────────────────────────────────────────────────

  pfn has_link(links : List(Link), role : Int) : Bool do
    match List.find(links, fn l -> l.role == role) do
      Some(_) -> true
      None -> false
    end
  end

  pfn show_roles(rs : List(Int)) : String do
    String.join(List.map(rs, fn r -> int_to_string(r)), ", ")
  end

  doc """
  Check that [p] has a connection to every role in [peers] -- the generated
  `<P>_Msg.peers_<R>()`, every role [R] exchanges a message with -- and panic
  naming the missing ones. Call it before `serve`, so a wiring mistake fails
  at startup rather than at the first `emit` to an unreachable role. A party
  with exactly one peer passes: it routes everything to that connection
  whatever the role numbers say (the two-party case, where `open` never asked
  for them).
  """
  fn require(p : Party, peers : List(Int)) : Party do
    match p.links do
      Cons(_, Nil) -> p
      _ ->
        let missing = List.filter(peers, fn r -> has_link(p.links, r) == false)
        match missing do
          Nil -> p
          _ -> panic("session_node: role " ++ int_to_string(p.my_role) ++ " has no connection to role(s) " ++ show_roles(missing))
        end
    end
  end

  -- The connection that reaches role [to]. A party with exactly ONE peer
  -- routes everything to it, whatever the role numbers say: that is the
  -- two-party case, where `open` never asked for role numbers at all.
  pfn link_for(links : List(Link), to : Int) : Link do
    match links do
      Cons(single, Nil) -> single
      _ ->
        match List.find(links, fn l -> l.role == to) do
          Some(l) -> l
          None -> panic("session_node: no connection to role " ++ int_to_string(to) ++ " in this party")
        end
    end
  end

  doc "The `Session.Ops` for [p]: hand it to `Session.attach`."
  fn ops(p : Party) : Session.Ops do
    let links = p.links
    let meta = p.meta
    let handlers = p.handlers
    let waiting = p.waiting
    let on_close = p.on_close
    let forward = p.forward
    let ep_actor = p.ep
    let party = p
    {
      register: fn (_ap, role) -> do
        Vault.set(meta, "ep", role)
        role
      end,
      emit: fn (ep, to, msg) -> do
        -- Maty's E-CancelMsg: a message to a role that can take no more, or
        -- from an endpoint that is itself done, is discarded.
        if Vault.get(meta, "done") != None || Vault.get(party.gone, rkey(to)) != None do
          let _ = Vault.incr(meta, "discarded", 1)
          ep
        else
          send_frame(party, link_for(links, to), "SessionNode.Deliver", encode_deliver(to, ep, msg))
          ep
        end
      end,
      suspend: fn (ep, from, handler) -> do
        Vault.set(waiting, ekey(ep), from)
        Vault.set(handlers, ekey(ep), handler)
        -- Hosted: this runs in the host actor's turn. A delivery parked
        -- while the host was resuming is drained in the endpoint actor's
        -- turn, never here (see `Drain`).
        match Vault.get(forward, "f") do
          None -> ()
          Some(_) ->
            let _ = send(ep_actor, Drain(party, ep))
            ()
        end
        ep
      end,
      close: fn ep -> do
        on_close(ep)
        Vault.set(meta, "closed", 1)
        Vault.set(meta, "done", 1)
        -- Every peer's reader has to learn this endpoint is done.
        let _ = List.map(links, fn l -> send_frame(party, l, "SessionNode.Bye", bye_payload(party)))
        ()
      end,
      fail: fn (ep, why) -> protocol_failed(party, ep, why),
      on_cancel: fn (ep, h) -> do
        Vault.set(party.cancel_hs, ekey(ep), h)
        ep
      end,
      leave: fn (ep, why) -> do
        let _ = send(ep_actor, Leave(party, ep, why))
        ()
      end,
      on_crash: fn (ep, role, h) -> do
        Vault.set(party.crash_hs, crash_key(ep, role), h)
        ep
      end
    }
  end

  -- ── reading ─────────────────────────────────────────────────────────────

  -- Every frame on a data connection is proof of life (the heartbeat's
  -- counter restarts), and every one is sent to the endpoint actor in the
  -- order read, so a peer's Bye or Cancel lands behind its deliveries.
  pfn on_frame(p : Party, l : Link, tag : Int, frame : List(Int)) : Result(Bool, String) do
    Vault.set(p.heard, rkey(l.role), 0)
    if tag == NodeSend.tag_actor_msg() do
      match NodeSend.decode_msg(frame) do
        Err(e) -> Err(e)
        Ok(d) ->
          let _ = NodeQueue.consumed(l.control_fd, budget(), List.length(frame) + 4)
          if d.type_tag == "SessionNode.Bye" do
            send(p.ep, PeerGone(p, l.role, "closed"))
            Ok(false)
          else
            if d.type_tag == "SessionNode.Cancel" do
              match decode_cancel(d.payload) do
                Ok((role, cause)) ->
                  send(p.ep, PeerGone(p, role, cause))
                  Ok(false)
                Err(e) -> Err(e)
              end
            else
              if d.type_tag == "SessionNode.Ping" do
                Ok(true)
              else
                if d.type_tag == "SessionNode.Deliver" do
                  match decode_deliver(d.payload) do
                    Err(e) -> Err(e)
                    Ok((to, from, msg)) ->
                      send(p.ep, Deliver(p, to, from, msg))
                      Ok(true)
                  end
                else
                  Err("session_node: unexpected type " ++ d.type_tag)
                end
              end
            end
          end
      end
    else
      Err("session_node: unexpected tag " ++ int_to_string(tag) ++ " on the data connection")
    end
  end

  -- Read one peer to its end: its Bye, its Cancel, or the connection
  -- ending. The last counts as that peer's cancellation at this point in
  -- the stream ("connection lost"); if a Bye or Cancel already arrived, the
  -- endpoint actor ignores the repeat. "" or why the reader stopped.
  pfn read_link(p : Party, l : Link) : String do
    match PeerReader.serve(l.data_fd, Nil, fn (tag, frame) -> on_frame(p, l, tag, frame)) do
      Ok(_) -> ""
      Err(e) ->
        send(p.ep, PeerGone(p, l.role, "connection lost"))
        e
    end
  end

  -- The heartbeat, one per connection, from the moment it is made
  -- (`start_link`): every interval, ping the peer on the data connection
  -- (through its NodeQueue writer, which serialises every write to that
  -- socket) and, once this side reads the connection (`serve`), count one
  -- tick since the peer's last frame. Past the limit the peer is taken for
  -- dead (`drop_link`, "no heartbeat"). A peer that is stopped, hung or
  -- behind a partition sends no end of file, so without this the reader
  -- would wait forever. Ticks are not counted before the reader runs: the
  -- peer's frames, pings included, are not read yet, so nothing could
  -- reset the count, and a role driving to its first suspension would take
  -- its peers for dead. Stops once the reader has, or setup was abandoned.
  -- A ping is the one frame that may be dropped (`DropNew`): when the queue
  -- is full, data frames are already telling the peer we are alive.
  -- MARCH_SESSION_HEARTBEAT_MS (default 1000) and MARCH_SESSION_TIMEOUT_MS
  -- (default 10000) tune it.
  -- (interval, limit in ticks): MARCH_SESSION_HEARTBEAT_MS (default 1000;
  -- <= 0 turns the heartbeat off) and MARCH_SESSION_TIMEOUT_MS (default
  -- 10000).
  pfn heartbeat_config() : (Int, Int) do
    let interval = Env.get_int("MARCH_SESSION_HEARTBEAT_MS", 1000)
    let timeout = Env.get_int("MARCH_SESSION_TIMEOUT_MS", 10000)
    (interval, if interval > 0 do timeout / interval else 0 end)
  end

  pfn heartbeat(p : Party, l : Link, interval : Int, limit : Int) : Int do
    sleep_ms(interval)
    if Vault.get(p.meta, "link_done" ++ rkey(l.role)) != None do 0
    else
      if Vault.get(p.meta, "done") == None do
        let _ = NodeQueue.cast(l.q, next_seq(p.meta), l.peer, "SessionNode.Ping", Nil, NodeQueue.DropNew)
        ()
      else () end
      let ticks = if Vault.get(p.meta, "reading" ++ rkey(l.role)) == None do 0
                  else Vault.incr(p.heard, rkey(l.role), 1) end
      if ticks > limit do
        drop_link(p, l, "no heartbeat")
        0
      else
        heartbeat(p, l, interval, limit)
      end
    end
  end

  pfn await_outcome(p : Party) : List((Int, String)) do
    match Actor.call(p.ep, OutcomeReq, 3600000) do
      Ok(failed) -> failed
      Err(_) -> await_outcome(p)
    end
  end

  doc """
  Read deliveries from every peer until each connection has ended: the
  peer closed, was cancelled, or went away. A peer's failure no longer ends
  the session for this node at once: it cancels our endpoint only if our
  endpoint is waiting on that peer with nothing from it queued (Maty's
  rule; see the module comment), and cancellation then spreads to our other
  peers as a Cancel frame. `Nil` if our endpoint ended normally, else
  `(role, cause)` for its cancellation. Every resumption runs in this
  node's endpoint actor, so call it after driving the local role to its
  first suspension. `serve` panics on a cancellation; `run` returns it.
  """
  fn serve_outcome(p : Party) : List((Int, String)) do
    send(p.ep, Expect(List.length(p.links)))
    -- The heartbeats are already running (`start_link`); from here they
    -- also count the silence on each connection.
    let _ = List.map(p.links, fn l -> Vault.set(p.meta, "reading" ++ rkey(l.role), 1))
    let _ = List.map(p.links, fn l -> task_spawn(fn _ -> do
      let why = read_link(p, l)
      Vault.set(p.meta, "link_done" ++ rkey(l.role), 1)
      send(p.ep, LinkEnded(l.role, why))
      0
    end))
    let _ = await_outcome(p)
    -- Every connection has ended. An endpoint still waiting now waits on
    -- nobody: that is a cancellation too.
    if ep_done(p) do () else
      match Vault.get(p.meta, "ep") do
        Some(ep) -> cancel_endpoint(p, ep, 0, "every peer is gone", "every peer is gone", kind_cancelled())
        None -> Vault.set(p.meta, "done", 1)
      end
    end
    match Vault.get(p.meta, "kind") do
      None -> Nil
      Some(_) -> Cons((Vault.get_or(p.meta, "cancel_role", 0), Vault.get_or(p.why, "cancel_cause", "")), Nil)
    end
  end

  doc "`serve_outcome`, panicking if our endpoint was cancelled; the transport's original contract."
  fn serve(p : Party) : Unit do
    match serve_outcome(p) do
      Nil -> ()
      Cons((role, why), _) -> panic("session_node: cancelled (role " ++ int_to_string(role) ++ "): " ++ why)
    end
  end

  doc "Tear every connection down: close data, Bye on control, await the control reader, close control. (A cluster-mode party owns no connection: nothing to do.)"
  fn finish(p : Party) : Unit do
    let _ = if is_cluster(p) do Nil else List.map(p.links, fn l -> do
      -- Its reader has ended, which stopped its heartbeat; a party that
      -- never served stops it here.
      Vault.set(p.meta, "link_done" ++ rkey(l.role), 1)
      tcp_close(l.data_fd)
      let _ = NodeSend.cast(l.control_fd, 0, GlobalPid.make("peer", 0, 0), "SessionNode.Bye", Nil)
      let _ = task_await(l.control)
      tcp_close(l.control_fd)
      0
    end) end
    ()
  end

  -- ── the role runner ─────────────────────────────────────────────────────
  -- Everything above, from a role, its peer set and an address table, in
  -- the one order that cannot deadlock: connect to every LOWER role
  -- (ascending), then accept every HIGHER one. Role 1 has nothing to connect
  -- to, so it is accepting at once; role k connects only to roles below it,
  -- each of which finished its own connects and is accepting. No node ever
  -- waits on a node that is waiting on it. No wait is unbounded either: a
  -- dial retries, an accept waits, and each handshake and hello reads, for
  -- at most MARCH_SESSION_CONNECT_MS (`connect_ms`), and a setup that fails
  -- tears down what it built (`abort_links`), so a role that never starts,
  -- or fails its own setup, fails the others' setup too instead of holding
  -- them for ever (specs/progress/2026-09-18-session-accept-deadline.md).
  --
  -- Addresses are a runtime value; their SHAPE is checked here from what the
  -- compiler knows (`peers_<R>()`): a role needs its own entry iff some peer
  -- is above it, and an entry for every peer below it. A missing one fails
  -- at startup, by role, before any socket opens.

  -- Where a role listens: its own entry says where; a peer's entry says
  -- where to dial it.
  type Addr = { role : Int, host : String, port : Int }
  -- Signatures below say `List(Addr)` outright: an alias does not unify
  -- with its expansion across a module boundary, and a caller building the
  -- table by hand (`Cons(addr, Nil)`) must be able to pass it.
  type Addrs = List(Addr)

  -- Why `run` ended other than by the protocol reaching its end. A session
  -- is not resumable: a peer that is gone ends it for everyone, and `run`
  -- returns rather than hanging on it. What to do next (run again: a fresh
  -- party and fresh connections) is the caller's decision.
  --
  -- - `Cancelled(role, cause)`: this role's endpoint was cancelled because
  --   it was waiting on `role`, which can send nothing more, and nothing
  --   from it was queued. `cause` is the chain back to where the failure
  --   began ("role 3: connection lost"). A peer that fails AFTER this role
  --   no longer needs it does not cancel it: `run` returns `Ok`.
  -- - `Protocol(role, why)`: that peer sent what cannot be delivered -- a
  --   message the generated code could not decode or one its state cannot
  --   receive (`Session.fail`). Our endpoint is cancelled and the peers are
  --   told.
  -- - `HostGone(ep)`: a hosted party's actor is gone (crashed or
  --   restarted); its parked session state died with it. The peers are sent
  --   a Cancel.
  -- - `Left(why)`: this role called `leave`.
  -- - `Listen(port, why)` / `Accept(why)` / `Connect(role, why)`: wiring.
  -- - `NoOffer(role, why)`: `initiate` found no access point that would
  --   take [role] (none registered, all full, all refused, or no answer).
  -- - `AlreadyOffered(role)`: this node already offers [role] of that protocol.
  type RunError = Cancelled(Int, String) | Protocol(Int, String) | HostGone(Int) | Left(String) | Listen(Int, String) | Accept(String) | Connect(Int, String) | NoOffer(Int, String) | AlreadyOffered(Int)

  fn run_error_message(e : RunError) : String do
    run_error_message_named(e, fn i -> int_to_string(i))
  end

  doc """
  `run_error_message` with roles shown by [name] (the generated
  `<P>_Msg.role_name`): what `<P>_Run.error_message` is.
  """
  fn run_error_message_named(e : RunError, name : Int -> String) : String do
    match e do
      Cancelled(role, why) -> "session_node: cancelled while waiting on role " ++ name(role) ++ ": " ++ why
      RunError.Left(why) -> "session_node: left the session: " ++ why
      Protocol(role, why) -> "session_node: role " ++ name(role) ++ ": " ++ why
      HostGone(ep) -> "session_node: endpoint " ++ int_to_string(ep) ++ ": its host actor is gone and the parked session state with it; session abandoned"
      Listen(port, why) -> "session_node: listen on port " ++ int_to_string(port) ++ ": " ++ why
      RunError.Accept(why) -> "session_node: accept: " ++ why
      RunError.Connect(role, why) -> "session_node: connect to role " ++ name(role) ++ ": " ++ why
      NoOffer(role, why) -> "session_node: no access point for role " ++ name(role) ++ ": " ++ why
      AlreadyOffered(role) -> "session_node: role " ++ name(role) ++ " is already offered on this node"
    end
  end

  doc "The peers [my_role] dials: those below it, ascending (i < j: i listens, j connects)."
  fn dials(my_role : Int, peers : List(Int)) : List(Int) do
    List.sort_by(List.filter(peers, fn r -> r < my_role), fn (a, b) -> a < b)
  end

  doc "The peers [my_role] accepts: those above it."
  fn accepts(my_role : Int, peers : List(Int)) : List(Int) do
    List.filter(peers, fn r -> r > my_role)
  end

  fn addr_of(addrs : List(Addr), role : Int) : Option(Addr) do
    List.find(addrs, fn a -> a.role == role)
  end

  pfn has_addr(addrs : List(Addr), role : Int) : Bool do
    match addr_of(addrs, role) do
      Some(_) -> true
      None -> false
    end
  end

  doc """
  The roles [my_role] needs an address for and [addrs] lacks: every peer it
  dials, and itself if it accepts anyone. Empty means `run` can start.
  """
  fn missing_addrs(my_role : Int, peers : List(Int), addrs : List(Addr)) : List(Int) do
    let need = match accepts(my_role, peers) do
      Nil -> dials(my_role, peers)
      _ -> Cons(my_role, dials(my_role, peers))
    end
    List.filter(need, fn r -> has_addr(addrs, r) == false)
  end

  doc "Parse `host:port` into the entry for [role]."
  fn parse_addr(role : Int, s : String) : Result(Addr, String) do
    match String.split_first(s, ":") do
      None -> Err("session_node: address " ++ s ++ " is not host:port")
      Some((host, port_s)) ->
        match String.to_int(port_s) do
          Ok(port) -> Ok({ role: role, host: host, port: port })
          Err(_) -> Err("session_node: address " ++ s ++ " has a bad port")
        end
    end
  end

  doc """
  One entry per role from the environment: `<PREFIX>_<ROLE>_ADDR = host:port`
  (upper-cased) for each `(name, index)` in [roles], the generated
  `<P>_Msg.role_names()`. An unset variable is no entry, and `run` names the
  roles it needed; a set one that does not parse panics. The generated
  `<P>_Run.addrs_from_env()` passes the protocol's name and roles.
  """
  fn addrs_from_env(prefix : String, roles : List((String, Int))) : List(Addr) do
    List.flat_map(roles, fn r -> match r do
      (name, idx) ->
        let key = String.to_uppercase(prefix ++ "_" ++ name ++ "_ADDR")
        match process_env(key) do
          None -> Nil
          Some(v) ->
            match parse_addr(idx, v) do
              Ok(a) -> Cons(a, Nil)
              Err(e) -> panic(e ++ " (" ++ key ++ ")")
            end
        end
    end)
  end

  -- How long setup waits on a peer: to dial a role that is still starting,
  -- for a role to connect, and for each handshake and hello once it has.
  -- MARCH_SESSION_CONNECT_MS (default 20000); <= 0 waits for ever.
  pfn connect_ms() : Int do
    Env.get_int("MARCH_SESSION_CONNECT_MS", 20000)
  end

  -- Dial [a] every 100 ms until it answers or [attempts] run out (connect_ms
  -- worth), each handshake bounded by [timeout_ms].
  pfn dial_retry(a : Addr, me, secret : String, attempts : Int, timeout_ms : Int) : Result(Peer, String) do
    match ClusterConn.connect_split_within(PeerRegistry.empty(), a.host, a.port, me, secret, timeout_ms) do
      Ok((_reg, conn)) -> Ok(conn)
      Err(e) ->
        -- The peer answered and rejected the handshake: retrying cannot
        -- help, and the peer has given up on this node, so a retry would
        -- only be refused and hide the real reason.
        if String.starts_with(e, "Handshake:") do
          Err(e ++ " (do both nodes run with the same secret?)")
        else if attempts <= 1 do
          Err(e)
        else
          sleep_ms(100)
          dial_retry(a, me, secret, attempts - 1, timeout_ms)
        end end
    end
  end

  -- Every setup failure below tears down the connections made so far
  -- (`abort_links`), so the peers already reached learn of it at once.
  pfn dial_all(p : Party, roles : List(Int), addrs : List(Addr), me, secret : String, fingerprint : String) : Result(Party, RunError) do
    match roles do
      Nil -> Ok(p)
      Cons(r, rest) ->
        match addr_of(addrs, r) do
          None ->
            abort_links(p)
            Err(RunError.Connect(r, "no address"))
          Some(a) ->
            let t = connect_ms()
            let attempts = if t > 0 do if t / 100 > 1 do t / 100 else 1 end else 1000000000 end
            match dial_retry(a, me, secret, attempts, t) do
              Err(e) ->
                abort_links(p)
                Err(RunError.Connect(r, e))
              Ok(conn) ->
                match join_dialed(p, r, conn, t, fingerprint) do
                  Err(e) ->
                    abort_links(p)
                    Err(RunError.Connect(r, e))
                  Ok(p2) -> dial_all(p2, rest, addrs, me, secret, fingerprint)
                end
            end
        end
    end
  end

  pfn last_role(links : List(Link)) : Int do
    match links do
      Nil -> 0
      Cons(l, Nil) -> l.role
      Cons(_, rest) -> last_role(rest)
    end
  end

  -- Accept one connection per role in [expected], in whatever order they
  -- arrive: the hello says which role it is. A role not expected, or seen
  -- twice, is a wiring mistake and fails loudly. Gives up when no expected
  -- role connects within connect_ms (each accept waits that long, so a
  -- cluster whose roles keep arriving is never cut off): a role that never
  -- starts, or failed its own setup, no longer holds this one for ever.
  pfn accept_all(p : Party, expected : List(Int), listen_fd : Int, me, secret : String, fingerprint : String) : Result(Party, RunError) do
    match expected do
      Nil -> Ok(p)
      _ ->
        let t = connect_ms()
        match ClusterConn.accept_split_within(PeerRegistry.empty(), listen_fd, me, secret, t) do
          Err(e) ->
            abort_links(p)
            if e == "tcp_accept: timed out" do
              Err(RunError.Accept("no connection from role(s) " ++ show_roles(expected) ++ " within " ++ int_to_string(t) ++ " ms"))
            else Err(RunError.Accept(e)) end
          Ok((_reg, conn)) ->
            match join_accepted(p, conn, t, fingerprint) do
              Err(e) ->
                abort_links(p)
                Err(RunError.Accept(e))
              Ok(p2) ->
                let got = last_role(p2.links)
                if List.member(expected, got) == false do
                  panic("session_node: role " ++ int_to_string(p.my_role) ++ " accepted a connection from role "
                        ++ int_to_string(got) ++ " but expects role(s) " ++ show_roles(expected))
                else () end
                accept_all(p2, List.filter(expected, fn r -> r != got), listen_fd, me, secret, fingerprint)
            end
        end
    end
  end

  pfn open_listener(my_role : Int, higher : List(Int), addrs : List(Addr)) : Result(Int, RunError) do
    match higher do
      Nil -> Ok(-1)
      _ ->
        match addr_of(addrs, my_role) do
          None -> Ok(-1)   -- unreachable: missing_addrs was checked first
          Some(a) ->
            match tcp_listen(a.port) do
              Ok(fd) -> Ok(fd)
              Err(e) -> Err(Listen(a.port, e))
            end
        end
    end
  end

  doc """
  Run role [my_role] of a session on this node: listen if any peer is above
  it, connect to every peer below it (ascending, with retry), accept every
  peer above it, check the party against [peers] (`<P>_Msg.peers_<R>()`),
  attach, run [body] to its first suspension, serve, and tear down. [addrs]
  must hold this role's own entry iff it accepts anyone and an entry for
  every peer it dials; a missing one panics by role before any socket opens.
  [node_id] names this node in the handshake and [secret] is the cluster
  secret every node shares. [fingerprint] is the protocol's own
  (`<P>_Msg.fingerprint()`): it rides the hello, and a peer whose own differs
  -- or that is too old to send one at all -- is refused at setup with a
  `Connect`/`Accept` error rather than discovered mid-session as an
  undecodable message (2026-09-21). `""` asks for no check. The generated
  `<P>_Run.run_<Role>` supplies the role, its peers, the fingerprint and the
  typed entry state.

  `Ok(())` when every peer's endpoint closed; else the `RunError` that ended
  the session, after the party has been torn down.
  """
  fn run(io : Cap(IO), my_role : Int, peers : List(Int), node_id : String, secret : String,
         addrs : List(Addr), fingerprint : String, on_close : Int -> Unit,
         body : Cap(Session.Live) -> Unit) : Result((), RunError) do
    run_party(io, my_role, peers, node_id, secret, addrs, fingerprint, on_close, fn (_p, s) -> body(s))
  end

  doc """
  `run`, with the role HOSTED IN AN ACTOR [host] (its pid as an Int,
  `pid_to_int`): the generated event API (`Parked_<Role>` in the actor's
  state, `await_*`/`resume`) instead of a body. [start] runs once the party
  is connected, with the session capability: send it to the actor, whose
  start handler registers and parks. [deliver] is called for every delivery
  the actor's parked endpoint awaits -- `(s, from, msg, ep)`, what its resume
  handler takes: send them on. Deliveries are one per suspension, in mailbox
  order, and one that arrives before the host has re-parked is held for it.

  The host is monitored: its `Down` (a crash, a kill, a supervisor's restart)
  cancels its role with `Err(HostGone(ep))`, and the peers are sent a Cancel
  (they are cancelled in turn only if they were waiting on it). A restarted
  actor starts `Idle` and cannot continue a session its predecessor parked;
  run again for a new one. `run_hosted_or` also tells the actor itself. The
  generated `<P>_Run.host_<Role>` supplies the role and its peers.
  """
  fn run_hosted(io : Cap(IO), my_role : Int, peers : List(Int), node_id : String, secret : String,
                addrs : List(Addr), fingerprint : String, on_close : Int -> Unit, host : Int,
                start : Cap(Session.Live) -> Unit,
                deliver : Cap(Session.Live) -> Int -> Bytes -> Int -> Unit) : Result((), RunError) do
    run_hosted_or(io, my_role, peers, node_id, secret, addrs, fingerprint, on_close, host, start, deliver,
                  fn (_s, _role, _cause, _ep) -> ())
  end

  doc """
  `run_hosted`, telling the actor when its endpoint is cancelled: [cancel]
  gets `(s, role, cause, ep)` -- the role it was waiting on and why that
  role is gone. Send it to the actor, whose handler stores the generated
  `<P>_<Role>.cancel(state.parked)` (a `Closed` parked value) and may update
  the rest of its state; it cannot communicate in the cancelled session.
  """
  fn run_hosted_or(io : Cap(IO), my_role : Int, peers : List(Int), node_id : String, secret : String,
                   addrs : List(Addr), fingerprint : String, on_close : Int -> Unit, host : Int,
                   start : Cap(Session.Live) -> Unit,
                   deliver : Cap(Session.Live) -> Int -> Bytes -> Int -> Unit,
                   cancel : Cap(Session.Live) -> Int -> String -> Int -> Unit) : Result((), RunError) do
    run_party(io, my_role, peers, node_id, secret, addrs, fingerprint, on_close,
              fn (p, s) -> host_party(p, s, host, start, deliver, cancel))
  end

  -- The hosted party's setup, once the party is formed and attached as [s]:
  -- deliveries and cancellations for the awaiting endpoint go to the actor
  -- through the two forwards, a `HostWatch` monitors the host [host] (its
  -- pid as an Int) for the session's whole life, and the actor is started.
  -- Shared by the standalone runner (`run_hosted_or`) and the cluster one
  -- (`run_cluster_hosted_with`); the session's end must `stop_host_watch`.
  pfn host_party(p : Party, s : Cap(Session.Live), host : Int, start : Cap(Session.Live) -> Unit,
                 deliver : Cap(Session.Live) -> Int -> Bytes -> Int -> Unit,
                 cancel : Cap(Session.Live) -> Int -> String -> Int -> Unit) : () do
    Vault.set(p.forward, "f", fn (from, msg, ep) -> deliver(s, from, msg, ep))
    Vault.set(p.forward_cancel, "c", fn (role, cause, ep) -> cancel(s, role, cause, ep))
    -- A crash the actor has a branch for goes the DELIVERY way, to the same
    -- callback, so the actor's resume handler takes it with `state` in scope
    -- exactly as it takes a message (`Session.crash_payload`).
    Vault.set(p.forward_crash, "x", fn (role, cause, ep) -> deliver(s, role, Session.crash_payload(cause), ep))
    let w = spawn(HostWatch)
    send(w, Watch(p, p.my_role))
    let _ = monitor(w, pid_of_int(host))
    Vault.set(p.meta, "watch", pid_to_int(w))
    start(s)
  end

  -- Kill the party's `HostWatch`, if it has one, so it is not left parked in
  -- `receive` after the session ended. A no-op for a callback-mode party.
  pfn stop_host_watch(p : Party) : () do
    match Vault.get(p.meta, "watch") do
      Some(w) -> kill(pid_of_int(w))
      None -> ()
    end
  end

  pfn run_party(io : Cap(IO), my_role : Int, peers : List(Int), node_id : String, secret : String,
                addrs : List(Addr), fingerprint : String, on_close : Int -> Unit,
                drive : Party -> Cap(Session.Live) -> Unit) : Result((), RunError) do
    match missing_addrs(my_role, peers, addrs) do
      Nil -> ()
      missing -> panic("session_node: role " ++ int_to_string(my_role) ++ " needs an address for role(s) " ++ show_roles(missing))
    end
    let me = NodeIdentity.make(node_id, "pk-" ++ node_id, 1)
    let higher = accepts(my_role, peers)
    let? listen_fd = open_listener(my_role, higher, addrs)
    let p0 = party(my_role, node_id, on_close)
    let joined = match dial_all(p0, dials(my_role, peers), addrs, me, secret, fingerprint) do
      Err(e) -> Err(e)
      Ok(p1) -> accept_all(p1, higher, listen_fd, me, secret, fingerprint)
    end
    match joined do
      Err(e) ->
        if listen_fd >= 0 do tcp_close(listen_fd) else () end
        Err(e)
      Ok(p2) -> serve_party(p2, io, my_role, peers, listen_fd, drive)
    end
  end

  pfn serve_party(p2 : Party, io : Cap(IO), my_role : Int, peers : List(Int), listen_fd : Int,
                  drive : Party -> Cap(Session.Live) -> Unit) : Result((), RunError) do
    let p = require(p2, peers)
    let s = Session.attach(io, ops(p))
    drive(p, s)
    let _ = serve_outcome(p)
    finish(p)
    if listen_fd >= 0 do tcp_close(listen_fd) else () end
    stop_host_watch(p)
    let role = Vault.get_or(p.meta, "cancel_role", 0)
    let cause = Vault.get_or(p.why, "cancel_cause", "")
    match Vault.get(p.meta, "kind") do
      None -> Ok(())
      Some(kind) ->
        if kind == kind_protocol() do Err(Protocol(role, cause))
        else if kind == kind_host_gone() do Err(HostGone(Vault.get_or(p.meta, "ep", my_role)))
        else if kind == kind_left() do Err(RunError.Left(cause))
        else Err(Cancelled(role, cause)) end end end
    end
  end

  -- ── the cluster runner ──────────────────────────────────────────────────
  -- `run`, over a running cluster node instead of per-session connections
  -- (specs/progress/2026-09-18-cluster-node-service.md, phase 4). Each role
  -- registers its endpoint under "session:<sid>/<role>" and finds its peers'
  -- by name; frames ride the node's data queues and reach the endpoint
  -- through a route on its pid; a peer whose node's data connection ends --
  -- SWIM declared the node dead, or the connection was lost -- is gone, told
  -- from that connection's reader after its last delivery (the drain rule's
  -- ordering). No heartbeat: SWIM is the failure detector. Every role must
  -- be on a different node (a node has no connection to itself).

  pfn role_name(session : String, role : Int) : String do
    "session:" ++ session ++ "/" ++ int_to_string(role)
  end

  -- Report [role] ended to the endpoint actor, once.
  pfn link_ended(p : Party, role : Int, why : String) : () do
    let key = "link_done" ++ rkey(role)
    if Vault.get(p.meta, key) != None do () else
      Vault.set(p.meta, key, 1)
      let _ = send(p.ep, LinkEnded(role, why))
      ()
    end
  end

  pfn cluster_kind(p : Party, kind : String, payload : List(Int)) : Result((), String) do
    if kind == "SessionNode.Deliver" do
      match decode_deliver(payload) do
        Err(e) -> Err(e)
        Ok((to, from, msg)) ->
          let _ = send(p.ep, Deliver(p, to, from, msg))
          Ok(())
      end
    else if kind == "SessionNode.Bye" do
      match Msgpack.decode(payload) do
        Ok(Msgpack.Int(role)) ->
          let _ = send(p.ep, PeerGone(p, role, "closed"))
          link_ended(p, role, "")
          Ok(())
        _ -> Err("session_node: bad Bye payload")
      end
    else if kind == "SessionNode.Cancel" do
      match decode_cancel(payload) do
        Err(e) -> Err(e)
        Ok((role, cause)) ->
          let _ = send(p.ep, PeerGone(p, role, cause))
          link_ended(p, role, "")
          Ok(())
      end
    else if kind == "SessionNode.Ping" do
      Ok(())
    else
      Err("session_node: unexpected type " ++ kind)
    end end end end
  end

  -- `cluster_kind`, run in the endpoint actor's own turn (`Early`, `Ready`):
  -- a held frame is handled HERE rather than re-sent to this mailbox, where
  -- it would land behind frames the reader forwarded after it.
  pfn cluster_kind_here(p : Party, kind : String, payload : List(Int)) : Result((), String) do
    if kind == "SessionNode.Deliver" do
      match decode_deliver(payload) do
        Err(e) -> Err(e)
        Ok((to, from, msg)) ->
          let _ = deliver(p, to, from, msg)
          Ok(())
      end
    else if kind == "SessionNode.Bye" do
      match Msgpack.decode(payload) do
        Ok(Msgpack.Int(role)) ->
          peer_gone(p, role, "closed")
          link_ended(p, role, "")
          Ok(())
        _ -> Err("session_node: bad Bye payload")
      end
    else if kind == "SessionNode.Cancel" do
      match decode_cancel(payload) do
        Err(e) -> Err(e)
        Ok((role, cause)) ->
          peer_gone(p, role, cause)
          link_ended(p, role, "")
          Ok(())
      end
    else Ok(()) end end end
  end

  -- The frame kinds a session receives, as a small number to hold an early
  -- frame by (`Early`), and back.
  pfn early_kind(kind : String) : Int do
    if kind == "SessionNode.Deliver" do 1
    else if kind == "SessionNode.Bye" do 2
    else if kind == "SessionNode.Cancel" do 3
    else if kind == "SessionNode.Ping" do 4
    else 0 end end end end
  end

  pfn early_kind_name(k : Int) : String do
    if k == 1 do "SessionNode.Deliver"
    else if k == 2 do "SessionNode.Bye"
    else if k == 3 do "SessionNode.Cancel"
    else "SessionNode.Ping" end end end
  end

  -- A frame for this session, from the node's data reader -- a task every
  -- session and route on that peer connection shares, so it must never
  -- wait. Before the session is ready (a peer can send as soon as it has
  -- found us, which may be before we have found it), the frame goes to the
  -- session's endpoint actor, which holds it until `Ready` (see `Early`).
  -- Until 2026-09-19 the reader polled for the session instead, up to 10 s,
  -- holding up every other session's frames on that connection meanwhile.
  pfn cluster_frame(slot : Vault(Party), p0 : Party, sid : String, d : NodeSend.Delivery) : Result((), String) do
    match String.split_first(d.type_tag, "#") do
      None -> Err("session_node: untagged frame " ++ d.type_tag ++ " for cluster session " ++ sid)
      Some((kind, fsid)) ->
        if fsid != sid do
          Err("session_node: frame for session " ++ fsid ++ ", this endpoint is in session " ++ sid)
        else if early_kind(kind) == 0 do
          Err("session_node: unexpected type " ++ kind)
        else
          match Vault.get(slot, "p") do
            Some(p) ->
              if Vault.get(p.meta, "ready") != None do cluster_kind(p, kind, d.payload)
              else
                let _ = send(p0.ep, Early(slot, p0, early_kind(kind), Bytes.from_list(d.payload)))
                Ok(())
              end
            None ->
              let _ = send(p0.ep, Early(slot, p0, early_kind(kind), Bytes.from_list(d.payload)))
              Ok(())
          end
        end end
    end
  end

  -- The node of every role on [node_id] ended its data connection: each is
  -- gone for [why] ("node <name> dead: <cause>", "connection lost", ...).
  pfn peer_node_closed(p : Party, node_id : String, why : String) : () do
    let _ = List.map(p.links, fn l ->
      if l.peer.node_id == node_id do
        let _ = send(p.ep, PeerGone(p, l.role, why))
        link_ended(p, l.role, why)
      else () end)
    ()
  end

  pfn slot_peer_closed(slot : Vault(Party), node_id : String, why : String) : () do
    match Vault.get(slot, "p") do
      Some(p) -> peer_node_closed(p, node_id, why)
      None -> ()
    end
  end

  pfn recheck_links(node : ClusterNode.ClusterHandle, p : Party) : () do
    let _ = List.map(p.links, fn l -> do
      let current = match ClusterNode.queue_for(node, l.peer.node_id) do
        Some((w, _)) -> match l.q do (lw, _) -> pid_to_int(w) == pid_to_int(lw) end
        None -> false
      end
      if current do () else peer_node_closed(p, l.peer.node_id, "connection lost before the session formed") end
    end)
    ()
  end

  -- Each peer role's endpoint, by name; waits up to [left] ms for all of them,
  -- or until [abandoned] says the session was withdrawn (an access point's
  -- session whose initiator gave up on it): Err(0) then.
  pfn find_peers(node : ClusterNode.ClusterHandle, session : String, peers : List(Int), left : Int,
                 abandoned : Int -> Bool) : Result(List((Int, GlobalPid.Pid)), Int) do
    let found = List.map(peers, fn r -> (r, ClusterNode.lookup(node, role_name(session, r))))
    match List.find(found, fn rp -> match rp do (_r, o) -> o == None end) do
      None ->
        Ok(List.filter_map(found, fn rp ->
          match rp do
            (r, Some(g)) -> Some((r, g))
            (_, None) -> None
          end))
      Some((missing, _)) ->
        if abandoned(0) do Err(0)
        else if left <= 0 do Err(missing) else
          sleep_ms(50)
          find_peers(node, session, peers, left - 50, abandoned)
        end end
    end
  end

  -- A Link per peer over the node's data queue to that peer's node; waits
  -- up to [left] ms for each node to be linked.
  pfn cluster_links(node : ClusterNode.ClusterHandle, found : List((Int, GlobalPid.Pid)), left : Int)
      : Result(List(Link), Int) do
    let qs = List.map(found, fn rg ->
      match rg do (r, g) -> (r, g, ClusterNode.queue_for(node, g.node_id)) end)
    match List.find(qs, fn t -> match t do (_r, _g, q) -> q == None end) do
      None ->
        Ok(List.filter_map(qs, fn t ->
          match t do
            (r, g, Some(q)) -> Some({ role: r, data_fd: -1, control_fd: -1, peer: g, q: q,
                                      control: task_spawn(fn _ -> 0) })
            _ -> None
          end))
      Some((missing, _, _)) ->
        if left <= 0 do Err(missing) else
          sleep_ms(50)
          cluster_links(node, found, left - 50)
        end
    end
  end

  pfn serve_cluster_outcome(p : Party) : () do
    let _ = send(p.ep, Expect(List.length(p.links)))
    let _ = await_outcome(p)
    if ep_done(p) do () else
      match Vault.get(p.meta, "ep") do
        Some(ep) -> cancel_endpoint(p, ep, 0, "every peer is gone", "every peer is gone", kind_cancelled())
        None -> Vault.set(p.meta, "done", 1)
      end
    end
  end

  pfn run_result(p : Party, my_role : Int) : Result((), RunError) do
    let role = Vault.get_or(p.meta, "cancel_role", 0)
    let cause = Vault.get_or(p.why, "cancel_cause", "")
    match Vault.get(p.meta, "kind") do
      None -> Ok(())
      Some(kind) ->
        if kind == kind_protocol() do Err(Protocol(role, cause))
        else if kind == kind_host_gone() do Err(HostGone(Vault.get_or(p.meta, "ep", my_role)))
        else if kind == kind_left() do Err(RunError.Left(cause))
        else Err(Cancelled(role, cause)) end end end
    end
  end

  doc """
  `run`, over the running cluster node [node] (ClusterNode.start) instead of
  connections of its own: role [my_role] of session [session] (any string
  the roles agree on -- a fresh one per session). Each role registers its
  endpoint under the session's name and finds its peers' by name (waiting up
  to 30 s), then [body] drives it exactly as for `run`. A peer is gone when
  it closes or is cancelled, or when its node's data connection ends --
  SWIM declared the node dead ("node <name> dead: <cause>") or the
  connection was lost. Every role must be on a different node. The generated
  `<P>_Run.cluster_<Role>` supplies the role and its peers.
  """
  fn run_cluster(io : Cap(IO), node : ClusterNode.ClusterHandle, my_role : Int, peers : List(Int), session : String,
                 on_close : Int -> Unit, body : Cap(Session.Live) -> Unit) : Result((), RunError) do
    run_cluster_with(io, node, my_role, peers, session, on_close, body, fn _ -> false)
  end

  -- `run_cluster`, abandoned while still finding its peers once [abandoned]
  -- says so (an access point's session the initiator withdrew).
  pfn run_cluster_with(io : Cap(IO), node : ClusterNode.ClusterHandle, my_role : Int, peers : List(Int), session : String,
                       on_close : Int -> Unit, body : Cap(Session.Live) -> Unit, abandoned : Int -> Bool) : Result((), RunError) do
    run_cluster_party(io, node, my_role, peers, session, on_close, fn (_p, s) -> body(s), abandoned)
  end

  doc """
  `run_cluster`, with the role HOSTED IN AN ACTOR [host] (its pid as an Int),
  as `run_hosted_or` hosts it over the runner's own connections: [start]
  gets the session capability once the party is formed, [deliver] every
  delivery the actor's parked endpoint awaits, `(s, from, msg, ep)`, and
  [cancel] a cancellation, `(s, role, cause, ep)`. The host is monitored:
  its `Down` ends the session with `Err(HostGone(ep))`. The generated
  `<P>_Run.cluster_hosted_<Role>` supplies the role and its peers and adds
  the session id to every callback.
  """
  fn run_cluster_hosted(io : Cap(IO), node : ClusterNode.ClusterHandle, my_role : Int, peers : List(Int), session : String,
                        on_close : Int -> Unit, host : Int, start : Cap(Session.Live) -> Unit,
                        deliver : Cap(Session.Live) -> Int -> Bytes -> Int -> Unit,
                        cancel : Cap(Session.Live) -> Int -> String -> Int -> Unit) : Result((), RunError) do
    run_cluster_hosted_with(io, node, my_role, peers, session, on_close, host, start, deliver, cancel, fn _ -> false)
  end

  -- `run_cluster_hosted`, abandoned while still finding its peers once
  -- [abandoned] says so (a hosted access point's session the initiator
  -- withdrew).
  pfn run_cluster_hosted_with(io : Cap(IO), node : ClusterNode.ClusterHandle, my_role : Int, peers : List(Int), session : String,
                              on_close : Int -> Unit, host : Int, start : Cap(Session.Live) -> Unit,
                              deliver : Cap(Session.Live) -> Int -> Bytes -> Int -> Unit,
                              cancel : Cap(Session.Live) -> Int -> String -> Int -> Unit,
                              abandoned : Int -> Bool) : Result((), RunError) do
    run_cluster_party(io, node, my_role, peers, session, on_close,
                      fn (p, s) -> host_party(p, s, host, start, deliver, cancel), abandoned)
  end

  -- The cluster runner proper: form the party under [session], then [drive]
  -- it (a callback body, or a hosted party's setup) and serve it to its end.
  pfn run_cluster_party(io : Cap(IO), node : ClusterNode.ClusterHandle, my_role : Int, peers : List(Int), session : String,
                        on_close : Int -> Unit, drive : Party -> Cap(Session.Live) -> Unit,
                        abandoned : Int -> Bool) : Result((), RunError) do
    let p0 = party(my_role, node.node_id, on_close)
    Vault.set(p0.why, "sid", session)
    let slot = Vault.new("session_node_slot_" ++ session ++ "." ++ int_to_string(pid_to_int(p0.ep)))
    let route_key = ClusterNode.route(node, pid_to_int(p0.ep), fn d -> cluster_frame(slot, p0, session, d))
    let me = role_name(session, my_role)
    match ClusterNode.register(node, me, p0.ep) do
      Err(_) ->
        ClusterNode.unroute(node, route_key)
        Err(Listen(my_role, "session " ++ session ++ ": role " ++ int_to_string(my_role) ++ " is already registered"))
      Ok(_) ->
        match find_peers(node, session, peers, 30000, abandoned) do
          Err(missing) ->
            ClusterNode.unroute(node, route_key)
            ClusterNode.unregister(node, me)
            if missing == 0 do Err(RunError.Connect(0, "session " ++ session ++ ": withdrawn by its initiator"))
            else Err(RunError.Connect(missing, "session " ++ session ++ ": no endpoint registered for role " ++ int_to_string(missing))) end
          Ok(found) ->
            match cluster_links(node, found, 30000) do
              Err(missing) ->
                ClusterNode.unroute(node, route_key)
                ClusterNode.unregister(node, me)
                Err(RunError.Connect(missing, "session " ++ session ++ ": no link to role " ++ int_to_string(missing) ++ "'s node"))
              Ok(links) ->
                let p = List.fold_left(links, p0, fn (acc, l) -> with_link(acc, l))
                Vault.set(slot, "p", p)
                let closer = ClusterNode.on_peer_closed(node, fn (nid, why) -> slot_peer_closed(slot, nid, why))
                -- A peer's node whose connection ended between finding it and
                -- installing the handler above was told to nobody: check now
                -- that every link is still the node's current one. (Reported
                -- twice is harmless: the first PeerGone wins, LinkEnded is once.)
                recheck_links(node, p)
                let s = Session.attach(io, ops(p))
                drive(p, s)
                -- Only now, with the role driven to its first suspension and
                -- its first handler installed, are held frames replayed (and
                -- later ones handled as they come): one handled earlier would
                -- find no handler and be parked where, in the callback API,
                -- nothing drains it -- the session would wait for ever (the
                -- standalone runner starts its readers after the drive for
                -- the same reason). A hosted party may not have parked yet
                -- when this is sent: its start message is in the actor's
                -- mailbox; a frame replayed before the actor parks is held,
                -- and the park's `Drain` finds it.
                let _ = send(p.ep, Ready(p))
                serve_cluster_outcome(p)
                stop_host_watch(p)
                ClusterNode.off_peer_closed(node, closer)
                ClusterNode.unroute(node, route_key)
                ClusterNode.unregister(node, me)
                run_result(p, my_role)
            end
        end
    end
  end

  -- ── access points ───────────────────────────────────────────────────────
  -- A node OFFERS a role of a protocol for many sessions; a session forms when
  -- an INITIATOR invites one offer of each other role, found by name, and
  -- every member runs the cluster session under a fresh id. Design:
  -- specs/2026-09-19-choreography-access-points-and-crash-branches-design.md
  -- (Part A). Wire, over the cluster node (routed by the offer's / the
  -- initiator's inbox pid):
  --   SessionAP.Invite    [sid, fingerprint, reply pid]   initiator -> offer
  --   SessionAP.Withdraw  [sid]                           initiator -> offer
  --   SessionAP.Answer    [sid, node_id, verdict]         offer -> initiator
  -- where verdict "" accepts and anything else is why it refused.

  -- An offer's name: one per protocol, role and node.
  pfn ap_prefix(proto : String, role : Int) : String do
    "ap:" ++ proto ++ "/" ++ int_to_string(role) ++ "/"
  end

  type OfferCount = { active : Int }

  -- An offer: what an invitation needs to be answered and its session run.
  -- [start] runs one session under a sid, abandoned while still forming
  -- once its argument says so. [flags]: "closing", and "w<sid>" for a
  -- session its initiator withdrew.
  type Offer = { node : ClusterNode.ClusterHandle, proto : String, fingerprint : String, my_role : Int,
                 capacity : Int, name : String, flags : Vault(Int), strs : Vault(String),
                 start : String -> (Int -> Bool) -> Result((), RunError), worker : Pid(OfferCount) }

  pfn offer_verdict(o : Offer, active : Int, fp : String) : String do
    if Vault.get(o.flags, "closing") != None do "closing"
    else if fp != o.fingerprint do "protocol differs"
    else if active >= o.capacity do "full"
    else "" end end end
  end

  -- Invitations are answered in the offer actor's turn, so the count of
  -- running sessions is exact; each accepted session runs in its own task
  -- and reports back when it ends.
  actor OfferActor do
    state { active : Int }
    init  { active: 0 }
    on Invite(o : Offer, sid : String, fp : String, reply : GlobalPid.Pid) do
      let verdict = offer_verdict(o, state.active, fp)
      let _ = ClusterNode.send_msg(o.node, reply, "SessionAP.Answer",
                encode_answer(sid, o.node.node_id, verdict), NodeQueue.Unbounded)
      if verdict == "" do
        let flags = o.flags
        let start = o.start
        let me = o.worker
        let _ = task_spawn(fn _ -> do
          let _ = start(sid, fn _ -> Vault.get(flags, "w" ++ sid) != None)
          let _ = Vault.delete(flags, "w" ++ sid)
          let _ = send(me, Ended(sid))
          0
        end)
        { active: state.active + 1 }
      else state end
    end
    on Withdraw(o : Offer, sid : String) do
      Vault.set(o.flags, "w" ++ sid, 1)
      state
    end
    on Ended(sid : String) do
      { active: state.active - 1 }
    end
  end

  pfn encode_invite(sid : String, fp : String, reply : GlobalPid.Pid) : List(Int) do
    Msgpack.encode(Msgpack.array(Cons(Msgpack.str(sid), Cons(Msgpack.str(fp),
      Cons(Msgpack.bin(GlobalPid.encode(reply)), Nil)))))
  end

  pfn encode_answer(sid : String, node_id : String, verdict : String) : List(Int) do
    Msgpack.encode(Msgpack.array(Cons(Msgpack.str(sid), Cons(Msgpack.str(node_id), Cons(Msgpack.str(verdict), Nil)))))
  end

  pfn encode_sid(sid : String) : List(Int) do
    Msgpack.encode(Msgpack.array(Cons(Msgpack.str(sid), Nil)))
  end

  -- An invitation or withdrawal for [o], from the node's data reader (its
  -- turn must only send): handed to the offer actor.
  pfn offer_frame(o : Offer, d : NodeSend.Delivery) : Result((), String) do
    if d.type_tag == "SessionAP.Invite" do
      match Msgpack.decode(d.payload) do
        Ok(Msgpack.Array(Cons(Msgpack.Str(sid), Cons(Msgpack.Str(fp), Cons(Msgpack.Bin(rb), Nil))))) ->
          match GlobalPid.decode(rb) do
            Ok(reply) ->
              let _ = send(o.worker, Invite(o, sid, fp, reply))
              Ok(())
            Err(e) -> Err("session_ap: invite reply pid: " ++ e)
          end
        _ -> Err("session_ap: bad Invite payload")
      end
    else if d.type_tag == "SessionAP.Withdraw" do
      match Msgpack.decode(d.payload) do
        Ok(Msgpack.Array(Cons(Msgpack.Str(sid), Nil))) ->
          let _ = send(o.worker, Withdraw(o, sid))
          Ok(())
        _ -> Err("session_ap: bad Withdraw payload")
      end
    else Err("session_ap: unexpected type " ++ d.type_tag) end end
  end

  doc """
  Offer role [my_role] of protocol [proto] (fingerprint [fingerprint], the
  generated `<P>_Msg.fingerprint()`) on the cluster node [node], for up to
  [capacity] sessions at once. Each session forms when an initiator
  (`initiate`) invites this node; it then runs [body] in its own task, as
  `run_cluster` would, under the session id the initiator minted. An
  invitation is refused when the offer is full, closing, or built from a
  different version of the protocol. One offer per role per node: a second
  is `Err`. The generated `<P>_Run.offer_<Role>` supplies the protocol, role
  and peers. The offer's name is bound to an actor of this node; if the
  node stops, or a supervisor restarts the program that made it, it is
  gone from the registry and an initiator no longer picks it -- offer again
  to be found again.
  """
  fn offer_role(io : Cap(IO), node : ClusterNode.ClusterHandle, proto : String, fingerprint : String, my_role : Int,
           peers : List(Int), capacity : Int, on_close : Int -> Unit, body : Cap(Session.Live) -> Unit) : Result(Offer, RunError) do
    offer_with(node, proto, fingerprint, my_role, capacity,
               fn (sid, abandoned) -> run_cluster_with(io, node, my_role, peers, sid, on_close, body, abandoned))
  end

  doc """
  `offer_role`, with the role HOSTED IN AN ACTOR [host] (its pid as an Int)
  for every session at once: each accepted session runs
  `run_cluster_hosted` in its own task, and the actor keeps one parked
  endpoint per session id (a `LinearMap`), which is why every callback
  carries the session id: `start(sid, s)`, `deliver(sid, s, from, msg, ep)`,
  `cancel(sid, s, role, cause, ep)`. The host is monitored once per session;
  if it dies, every session it hosts ends with `HostGone`. The generated
  `<P>_Run.offer_hosted_<Role>` supplies the protocol, role and peers.
  """
  fn offer_hosted(io : Cap(IO), node : ClusterNode.ClusterHandle, proto : String, fingerprint : String, my_role : Int,
                  peers : List(Int), capacity : Int, on_close : Int -> Unit, host : Int,
                  start : String -> Cap(Session.Live) -> Unit,
                  deliver : String -> Cap(Session.Live) -> Int -> Bytes -> Int -> Unit,
                  cancel : String -> Cap(Session.Live) -> Int -> String -> Int -> Unit) : Result(Offer, RunError) do
    offer_with(node, proto, fingerprint, my_role, capacity, fn (sid, abandoned) ->
      run_cluster_hosted_with(io, node, my_role, peers, sid, on_close, host,
                              fn s -> start(sid, s),
                              fn (s, from, msg, ep) -> deliver(sid, s, from, msg, ep),
                              fn (s, role, cause, ep) -> cancel(sid, s, role, cause, ep),
                              abandoned))
  end

  -- The offer itself: an actor that answers invitations and runs each
  -- accepted session through [start] (under its sid, abandoned once the
  -- second argument says so), routed and registered under the offer's name.
  pfn offer_with(node : ClusterNode.ClusterHandle, proto : String, fingerprint : String, my_role : Int, capacity : Int,
                 start : String -> (Int -> Bool) -> Result((), RunError)) : Result(Offer, RunError) do
    let a = spawn(OfferActor)
    let tag = proto ++ "." ++ int_to_string(my_role) ++ "." ++ int_to_string(pid_to_int(a))
    let o = { node: node, proto: proto, fingerprint: fingerprint, my_role: my_role, capacity: capacity,
              name: ap_prefix(proto, my_role) ++ node.node_id,
              flags: Vault.new("session_ap_flags_" ++ tag), strs: Vault.new("session_ap_strs_" ++ tag),
              start: start, worker: a }
    let key = ClusterNode.route(node, pid_to_int(a), fn d -> offer_frame(o, d))
    Vault.set(o.strs, "route", key)
    match ClusterNode.register(node, o.name, a) do
      Ok(_) -> Ok(o)
      Err(_) ->
        ClusterNode.unroute(node, key)
        Err(AlreadyOffered(my_role))
    end
  end

  doc "Stop offering: new invitations are refused and the name is released. Sessions already running finish."
  fn close_offer(o : Offer) : () do
    Vault.set(o.flags, "closing", 1)
    ClusterNode.unregister(o.node, o.name)
    match Vault.get(o.strs, "route") do
      Some(k) -> ClusterNode.unroute(o.node, k)
      None -> ()
    end
  end

  -- The initiator's reply address: an actor that exists only to have a pid
  -- the node can route answers by.
  actor ApInbox do
    state { n : Int }
    init  { n: 0 }
    on Nop() do state end
  end

  pfn inbox_frame(answers : Vault(String), sid : String, d : NodeSend.Delivery) : Result((), String) do
    if d.type_tag != "SessionAP.Answer" do Err("session_ap: unexpected type " ++ d.type_tag)
    else
      match Msgpack.decode(d.payload) do
        Ok(Msgpack.Array(Cons(Msgpack.Str(asid), Cons(Msgpack.Str(nid), Cons(Msgpack.Str(verdict), Nil))))) ->
          if asid == sid do
            Vault.set(answers, nid, verdict)
            Ok(())
          else Ok(()) end
        _ -> Err("session_ap: bad Answer payload")
      end
    end
  end

  -- The offers of [role], other than on the nodes in [used], rotated by [n]
  -- so successive sessions of one initiator spread over them, with an offer
  -- on THIS node first (prefer-local, plan 4.2: it saves a hop, and it goes
  -- over the node's loopback link). Only offers on nodes this node is
  -- connected to: the registry can show a name (learnt through a third node)
  -- before the two nodes have a connection, and a session between them
  -- needs one.
  pfn candidates(node : ClusterNode.ClusterHandle, proto : String, role : Int, used : List(String), n : Int)
      : List(GlobalPid.Pid) do
    let prefix = ap_prefix(proto, role)
    let found = List.filter_map(ClusterNode.names(node), fn name ->
      if String.starts_with(name, prefix) do ClusterNode.lookup(node, name) else None end)
    let fresh = List.filter(found, fn g ->
      List.member(used, g.node_id) == false && ClusterNode.queue_for(node, g.node_id) != None)
    let local = List.filter(fresh, fn g -> g.node_id == node.node_id)
    let remote = List.filter(fresh, fn g -> g.node_id != node.node_id)
    let k = List.length(remote)
    if k == 0 do local else
      let r = n % k
      List.append(local, List.append(List.drop(remote, r), List.take(remote, r)))
    end
  end

  -- Wait up to [left] ms for [nid]'s answer: Some(verdict), or None.
  -- [budget] holds the setup time left, shared by every invitation.
  pfn await_answer(answers : Vault(String), nid : String, budget : Vault(Int)) : Option(String) do
    match Vault.get(answers, nid) do
      Some(v) -> Some(v)
      None ->
        if Vault.get_or(budget, "left", 0) <= 0 do None else
          sleep_ms(20)
          let _ = Vault.incr(budget, "left", -20)
          await_answer(answers, nid, budget)
        end
    end
  end

  -- A node's name for messages, falling back to its id.
  pfn node_label(node : ClusterNode.ClusterHandle, node_id : String) : String do
    match ClusterNode.name_of(node, node_id) do
      Some(nm) -> nm
      None -> node_id
    end
  end

  -- [why] so far, and one more reason.
  pfn and_why(why : String, more : String) : String do
    if why == "" do more else why ++ "; " ++ more end
  end

  -- Invite the candidates for [role] in turn until one accepts: Ok(its pid),
  -- or Err(every refusal, "; "-separated, or why there was none).
  --
  -- ONE recursive function, not a mutually recursive pair: a mutual pair is
  -- flattened into a shared loop that frees an argument it is about to
  -- forward, which ASAN caught here as a use-after-free on `why`
  -- (specs/todos/2026-09-20-mutual-tco-borrowed-forwarded-arg.md). Keep it
  -- self-recursive until that is fixed.
  pfn invite_role(node : ClusterNode.ClusterHandle, sid : String, fp : String, reply : GlobalPid.Pid,
                  answers : Vault(String), budget : Vault(Int), cands : List(GlobalPid.Pid), why : String)
      : Result(GlobalPid.Pid, String) do
    match cands do
      Nil -> Err(if why == "" do "no access point is registered" else why end)
      Cons(g, rest) ->
        if Vault.get_or(budget, "left", 0) <= 0 do Err(and_why(why, "no answer within the setup time"))
        else
          -- Ok(None) accepts; Ok(Some(reason)) moves on to the next candidate.
          let outcome = match ClusterNode.send_msg(node, g, "SessionAP.Invite", encode_invite(sid, fp, reply), NodeQueue.Unbounded) do
            Err(_) -> Some(node_label(node, g.node_id) ++ " is unreachable")
            Ok(_) ->
              match await_answer(answers, g.node_id, budget) do
                Some(v) ->
                  if v == "" do None
                  else Some(node_label(node, g.node_id) ++ " refused: " ++ v) end
                None ->
                  let _ = ClusterNode.send_msg(node, g, "SessionAP.Withdraw", encode_sid(sid), NodeQueue.Unbounded)
                  Some(node_label(node, g.node_id) ++ " did not answer")
              end
          end
          match outcome do
            None -> Ok(g)
            Some(reason) -> invite_role(node, sid, fp, reply, answers, budget, rest, and_why(why, reason))
          end
        end
    end
  end

  pfn withdraw_all(node : ClusterNode.ClusterHandle, sid : String, accepted : List(GlobalPid.Pid)) : () do
    let _ = List.map(accepted, fn g ->
      ClusterNode.send_msg(node, g, "SessionAP.Withdraw", encode_sid(sid), NodeQueue.Unbounded))
    ()
  end

  -- Fill every role in [roles] from its offers: Ok(the accepted offers), or
  -- Err((role, why, accepted so far)). Any node may play several roles of
  -- one session, the initiator's own included -- each party is its own
  -- endpoint, and frames between two on one node take the loopback link --
  -- so [used] (nodes to skip) is empty unless a caller wants otherwise.
  pfn fill_roles(node : ClusterNode.ClusterHandle, proto : String, sid : String, fp : String, reply : GlobalPid.Pid,
                 answers : Vault(String), budget : Vault(Int), roles : List(Int), n : Int,
                 used : List(String), accepted : List(GlobalPid.Pid))
      : Result(List(GlobalPid.Pid), (Int, String, List(GlobalPid.Pid))) do
    match roles do
      Nil -> Ok(accepted)
      Cons(r, rest) ->
        match invite_role(node, sid, fp, reply, answers, budget, candidates(node, proto, r, used, n), "") do
          Err(why) -> Err((r, why, accepted))
          Ok(g) -> fill_roles(node, proto, sid, fp, reply, answers, budget, rest, n,
                              used, Cons(g, accepted))
        end
    end
  end

  doc """
  Start one session of protocol [proto] in role [my_role] on the cluster
  node [node], filling every role in [others] (all the other roles) from the
  access points that offer it (`offer_role`). Mints a fresh session id (this
  node, its creation, a counter: never reused, so a restarted or partitioned
  node cannot be addressed by an old session), invites one offer per role --
  an offer on this node first, then the others -- moving to the next
  offer on a refusal or no answer, all within the setup time
  (MARCH_SESSION_CONNECT_MS, 20 s). Then runs [body] as `run_cluster` does.
  `Err(NoOffer(role, why))` if a role could not be filled; the offers that
  had accepted are withdrawn. The generated `<P>_Run.initiate_<Role>`
  supplies the protocol, role, peers and other roles.
  """
  fn initiate(io : Cap(IO), node : ClusterNode.ClusterHandle, proto : String, fingerprint : String, my_role : Int,
              peers : List(Int), others : List(Int), on_close : Int -> Unit, body : Cap(Session.Live) -> Unit)
      : Result((), RunError) do
    let n = Vault.incr(node.meta, "ap_sessions", 1)
    let sid = node.node_id ++ "." ++ int_to_string(ClusterNode.creation(node)) ++ "." ++ int_to_string(n)
    let inbox = spawn(ApInbox)
    let answers = Vault.new("session_ap_answers_" ++ sid)
    let budget = Vault.new("session_ap_budget_" ++ sid)
    let t = connect_ms()
    Vault.set(budget, "left", if t > 0 do t else 3600000 end)
    let key = ClusterNode.route(node, pid_to_int(inbox), fn d -> inbox_frame(answers, sid, d))
    let reply = ClusterNode.global_pid(node, pid_to_int(inbox))
    let filled = fill_roles(node, proto, sid, fingerprint, reply, answers, budget, others, n, Nil, Nil)
    ClusterNode.unroute(node, key)
    match filled do
      Err((role, why, accepted)) ->
        withdraw_all(node, sid, accepted)
        Err(NoOffer(role, why))
      Ok(_) -> run_cluster(io, node, my_role, peers, sid, on_close, body)
    end
  end
end
