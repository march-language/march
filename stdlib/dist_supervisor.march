-- DistSupervisor: a supervisor that manages children on remote cluster nodes (P5d).
--
-- Mirrors the local supervisor model but each child runs on a named remote node
-- via NodeCall.call to its init function.  The supervisor monitors each child
-- with DistLink.monitor and applies the restart strategy when a Down arrives.
--
-- Restart strategies (matching local supervisor semantics):
--   Permanent  — always restart, regardless of exit reason.
--   Transient  — restart only on abnormal exit (Crash, Killed or NodeDown), not Normal.
--   Temporary  — never restart.
--
-- Supervision strategies (applied to the child set as a whole):
--   OneForOne  — restart only the failed child.
--   OneForAll  — restart all children when any one fails.
--   RestForOne — restart the failed child and all children started after it.
--
-- Implementation note: the supervisor is a local actor.  It spawns children via
-- NodeCall.call, monitors them via DistLink.encode_req frames, and processes
-- Down messages to restart as needed.  The socket I/O and actor machinery are
-- not eval-testable; only the pure restart-decision logic is tested here.
mod DistSupervisor do

  type RestartStrategy = Permanent | Transient | Temporary

  type SupervisionStrategy = OneForOne | OneForAll | RestForOne

  -- A remote child specification.
  type RemoteChild = {
    fn_ref  : RemoteRef,       -- the child actor's init fn (CAS-typed)
    node_id : String,          -- which cluster node to run it on
    restart : RestartStrategy
  }

  -- Live child state tracked by the supervisor.
  type ChildState = {
    spec      : RemoteChild,
    global_pid : GlobalPid.Pid,   -- pid assigned after spawn
    ref       : DistLink.MonitorRef  -- DistLink monitor ref for this child
  }

  -- Supervisor state.
  type State = {
    sup_strategy : SupervisionStrategy,
    children     : List(ChildState)   -- in start order (important for RestForOne)
  }

  doc "A supervisor using strategy [strat] with no children yet."
  fn make(strat : SupervisionStrategy) : State do
    { sup_strategy: strat, children: Nil }
  end

  -- ── Restart decision ────────────────────────────────────────────────────────

  doc """
  Whether a child with restart policy [restart] should be restarted after it
  went down with [reason]: `Permanent` always, `Temporary` never, `Transient`
  on every reason except `Normal` (so `Crash`, `Killed` and `NodeDown` all
  restart it).

  ## Examples

      DistSupervisor.should_restart(Transient, DistLink.Normal)     -- false
      DistSupervisor.should_restart(Transient, DistLink.NodeDown)   -- true
  """
  fn should_restart(restart : RestartStrategy, reason : DistLink.DownReason) : Bool do
    match restart do
      Permanent -> true
      Temporary -> false
      Transient ->
        -- Qualified: `Normal`/`Killed`/`Crash` are also the LOCAL monitor's
        -- `DownReason` constructors (typecheck_builtins), so bare arms are
        -- ambiguous in any program that sees both -- including this file's
        -- own standalone `--check`.
        match reason do
          DistLink.Normal   -> false
          DistLink.NodeDown -> true
          DistLink.Killed   -> true
          DistLink.Crash(_) -> true
        end
    end
  end

  doc """
  The child indices (0-based, in start order) to restart when child
  [failed_idx] of [n_children] fails: `OneForOne` restarts just
  `[failed_idx]`, `OneForAll` every index `0..n_children-1`, `RestForOne`
  `failed_idx..n_children-1`. [failed_idx] is not range-checked:
  `OneForOne` returns it as given, and `RestForOne` returns `[]` when it is
  at or past [n_children].

  ## Examples

      DistSupervisor.restart_indices(RestForOne, 1, 4)   -- [1, 2, 3]
      DistSupervisor.restart_indices(OneForAll, 1, 3)    -- [0, 1, 2]
  """
  fn restart_indices(strat : SupervisionStrategy, failed_idx : Int,
                      n_children : Int) : List(Int) do
    match strat do
      OneForOne ->
        Cons(failed_idx, Nil)
      OneForAll ->
        List.range(0, n_children)
      RestForOne ->
        List.range(failed_idx, n_children)
    end
  end

  doc "The first child monitored under [ref], with its 0-based index in [children], or `None`. O(n)."
  fn find_child_by_ref(children : List(ChildState),
                        ref : DistLink.MonitorRef) : Option((Int, ChildState)) do
    find_child_by_ref_go(children, ref, 0)
  end

  pfn find_child_by_ref_go(children : List(ChildState), ref : DistLink.MonitorRef,
                             idx : Int) : Option((Int, ChildState)) do
    match children do
      Nil -> None
      Cons(c, rest) ->
        if c.ref == ref do
          Some((idx, c))
        else
          find_child_by_ref_go(rest, ref, idx + 1)
        end
    end
  end

  doc "[children] with the element at index [idx] replaced by [new_child]; the list is returned unchanged when [idx] is negative or out of range."
  fn update_child(children : List(ChildState), idx : Int,
                   new_child : ChildState) : List(ChildState) do
    update_child_go(children, idx, new_child, 0)
  end

  pfn update_child_go(children : List(ChildState), idx : Int,
                       new_child : ChildState, cur : Int) : List(ChildState) do
    match children do
      Nil -> Nil
      Cons(c, rest) ->
        if cur == idx do
          Cons(new_child, rest)
        else
          Cons(c, update_child_go(rest, idx, new_child, cur + 1))
        end
    end
  end

  -- ── Summary helpers ─────────────────────────────────────────────────────────

  doc "The number of supervised children."
  fn child_count(s : State) : Int do List.length(s.children) end

  doc "The supervised children, in start order (every child the state tracks; no liveness check is made)."
  fn live_children(s : State) : List(ChildState) do s.children end

end
