-- Merkle: content-addressed hash tree.
--
-- Each leaf stores a value and the SHA-256 hash of its byte representation.
-- Each branch stores the SHA-256 hash of (left_hash ++ right_hash).
-- The root hash summarises the entire tree; comparing root hashes detects
-- any difference in O(1), while diff() localises changes in O(k log n)
-- by recursing only into subtrees whose hashes differ.
--
-- build/2 constructs a balanced tree from a list of items in O(n).
-- The caller supplies a `to_bytes : a -> String` function for leaf hashing.
-- Hashes are lowercase hex SHA-256 strings (Crypto.sha256).
--
-- doc: try

mod Merkle do

  -- A node: MLeaf(sha256_hex, value) or MBranch(sha256_hex, left, right).
  type MerkleTree(a) = MLeaf(String, a) | MBranch(String, MerkleTree(a), MerkleTree(a))

  doc """
  A single-leaf tree holding `x`, whose hash is `Crypto.sha256(to_bytes(x))`.

  ## Examples

      march> Merkle.leaves(Merkle.leaf(42, int_to_string))
      [42]
      march> Merkle.root_hash(Merkle.leaf("abc", fn s -> s)) == Crypto.sha256("abc")
      true
  """
  fn leaf(x : a, to_bytes : a -> String) : MerkleTree(a) do
    MLeaf(Crypto.sha256(to_bytes(x)), x)
  end

  doc """
  A branch over `l` and `r`, whose hash is the SHA-256 of the two children's
  root hashes concatenated (left first, as hex strings).

  ## Examples

      march> Merkle.size(Merkle.branch(Merkle.leaf(1, int_to_string), Merkle.leaf(2, int_to_string)))
      2
      march> Merkle.root_hash(Merkle.branch(Merkle.leaf("a", fn s -> s), Merkle.leaf("b", fn s -> s))) == Crypto.sha256(Crypto.sha256("a") ++ Crypto.sha256("b"))
      true
  """
  fn branch(l : MerkleTree(a), r : MerkleTree(a)) : MerkleTree(a) do
    MBranch(Crypto.sha256(root_hash(l) ++ root_hash(r)), l, r)
  end

  doc """
  The hash stored at the root: the leaf's hash for a leaf, the branch hash
  otherwise. Two trees built the same way from equal leaves have equal root
  hashes. O(1).

  ## Examples

      march> String.byte_size(Merkle.root_hash(Merkle.leaf("abc", fn s -> s)))
      64
  """
  fn root_hash(t : MerkleTree(a)) : String do
    match t do
    MLeaf(h, _)      -> h
    MBranch(h, _, _) -> h
    end
  end

  doc """
  Build a tree from `items`, hashing each with `to_bytes`. Leaves are paired
  left to right, layer by layer; an odd node at the end of a layer is carried
  up unpaired. Returns `None` for an empty list. O(n).

  ## Examples

      march> Merkle.build([], int_to_string)
      None
      march> Option.map(Merkle.build([1, 2, 3], int_to_string), Merkle.leaves)
      Some([1, 2, 3])
  """
  fn build(items : List(a), to_bytes : a -> String) : Option(MerkleTree(a)) do
    match items do
    Nil -> None
    _   ->
      let leaves = List.map(items, fn x -> leaf(x, to_bytes))
      Some(build_layer(leaves))
    end
  end

  pfn build_layer(nodes : List(MerkleTree(a))) : MerkleTree(a) do
    match nodes do
    Cons(t, Nil) -> t
    _            -> build_layer(pair_up(nodes))
    end
  end

  pfn pair_up(nodes : List(MerkleTree(a))) : List(MerkleTree(a)) do
    match nodes do
    Nil                       -> Nil
    Cons(t, Nil)              -> Cons(t, Nil)
    Cons(l, Cons(r, rest))    -> Cons(branch(l, r), pair_up(rest))
    end
  end

  doc """
  The hashes, taken from `t1`, of the leaves where `t1` and `t2` differ, left
  to right. Subtrees whose hashes match are skipped, so for k changed leaves
  this is O(k log n). Meant for trees of the same shape (built from lists of
  the same length); where the shapes diverge it reports `t1`'s node at that
  point, which for a branch is a branch hash, not a leaf hash.

  ## Examples

      march> let mt1 = Option.unwrap(Merkle.build([1, 2, 3, 4], int_to_string))
      march> let mt2 = Option.unwrap(Merkle.build([1, 2, 30, 4], int_to_string))
      march> Merkle.diff(mt1, mt1)
      []
      march> let mt1 = Option.unwrap(Merkle.build([1, 2, 3, 4], int_to_string))
      march> let mt2 = Option.unwrap(Merkle.build([1, 2, 30, 4], int_to_string))
      march> Merkle.diff(mt1, mt2) == [Merkle.root_hash(Merkle.leaf(3, int_to_string))]
      true
  """
  fn diff(t1 : MerkleTree(a), t2 : MerkleTree(a)) : List(String) do
    diff_work(Cons((t1, t2), Nil), Nil)
  end

  pfn diff_work(work : List((MerkleTree(a), MerkleTree(a))), acc : List(String)) : List(String) do
    match work do
    Nil -> List.reverse(acc)
    Cons((t1, t2), rest) ->
      if root_hash(t1) == root_hash(t2) do
        diff_work(rest, acc)
      else
        match (t1, t2) do
        (MLeaf(h, _), _)                         -> diff_work(rest, Cons(h, acc))
        (MBranch(h, _, _), MLeaf(_, _))          -> diff_work(rest, Cons(h, acc))
        (MBranch(_, l1, r1), MBranch(_, l2, r2)) ->
          diff_work(Cons((l1, l2), Cons((r1, r2), rest)), acc)
        end
      end
    end
  end

  doc """
  All values stored at the leaves, left to right (the order given to `build`).

  ## Examples

      march> let mt2 = Option.unwrap(Merkle.build([1, 2, 30, 4], int_to_string))
      march> Merkle.leaves(mt2)
      [1, 2, 30, 4]
  """
  fn leaves(t : MerkleTree(a)) : List(a) do
    match t do
    MLeaf(_, x)      -> Cons(x, Nil)
    MBranch(_, l, r) -> List.append(leaves(l), leaves(r))
    end
  end

  doc """
  All leaf hashes, left to right.

  ## Examples

      march> let mt1 = Option.unwrap(Merkle.build([1, 2, 3, 4], int_to_string))
      march> Merkle.leaf_hashes(mt1) == List.map([1, 2, 3, 4], fn x -> Crypto.sha256(int_to_string(x)))
      true
  """
  fn leaf_hashes(t : MerkleTree(a)) : List(String) do
    match t do
    MLeaf(h, _)      -> Cons(h, Nil)
    MBranch(_, l, r) -> List.append(leaf_hashes(l), leaf_hashes(r))
    end
  end

  doc """
  True when any node of the tree, leaf or branch, has hash `h`. A branch
  match stops the search, so this also answers "is this subtree present".
  O(n) in the worst case.

  ## Examples

      march> let mt1 = Option.unwrap(Merkle.build([1, 2, 3, 4], int_to_string))
      march> Merkle.contains_hash(mt1, Crypto.sha256("2"))
      true
      march> let mt1 = Option.unwrap(Merkle.build([1, 2, 3, 4], int_to_string))
      march> Merkle.contains_hash(mt1, Merkle.root_hash(mt1))
      true
      march> let mt1 = Option.unwrap(Merkle.build([1, 2, 3, 4], int_to_string))
      march> Merkle.contains_hash(mt1, "nope")
      false
  """
  fn contains_hash(t : MerkleTree(a), h : String) : Bool do
    match t do
    MLeaf(lh, _)     -> lh == h
    MBranch(bh, l, r) ->
      if bh == h do true
      else contains_hash(l, h) || contains_hash(r, h)
      end
    end
  end

  doc """
  Number of leaves in the tree. O(n).

  ## Examples

      march> let mt1 = Option.unwrap(Merkle.build([1, 2, 3, 4], int_to_string))
      march> Merkle.size(mt1)
      4
  """
  fn size(t : MerkleTree(a)) : Int do
    match t do
    MLeaf(_, _)      -> 1
    MBranch(_, l, r) -> size(l) + size(r)
    end
  end

end
