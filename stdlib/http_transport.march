-- HttpTransport: low-level HTTP transport layer.
--
-- Sends raw HTTP/1.1 requests over TCP sockets.
-- This is Layer 2 of March's HTTP library — it handles connection
-- management and raw request/response exchange.
--
-- Most users should use HttpClient (Layer 3) instead. Use this
-- directly only when you need low-level control over connections.
--
-- HTTPS requests use the certificate-verifying TLS client.  The
-- connection-oriented APIs (`connect`, `request_on`, `stream_request_on`)
-- deliberately remain plain HTTP only: a plain `Socket` carries no TLS
-- context, so accepting an HTTPS request there could leak a request in
-- plaintext.
--
-- doc: try

mod HttpTransport do

  needs IO.NetConnect
  needs IO.NetConnect.TLS

  type TransportError =
    ConnectionRefused(String)
    | ConnTimeout(String)
    | SendError(String)
    | RecvError(String)
    | ConnParseError(String)
    | Closed
    | SchemeNotSupported(String)
    | Refused(String)

  -- One raw socket call each, on the descriptor inside s; Err(Closed) once s
  -- is closed. The enter/leave pair keeps the descriptor from being
  -- released, and its number reused, while the call runs, even if another
  -- task closes s meanwhile.
  pfn send_all_on(s : Socket, raw_request : String) : Result((), TransportError) do
    let fd = handle_enter(s, 3)
    if fd == -1 do Err(Closed) else
      let r = match tcp_send_all(fd, raw_request) do
        Err(msg) -> Err(SendError(msg))
        Ok(_) -> Ok(())
      end
      handle_leave(s)
      r
    end
  end

  pfn recv_http_on(s : Socket) : Result(String, TransportError) do
    let fd = handle_enter(s, 3)
    if fd == -1 do Err(Closed) else
      let r = match tcp_recv_http(fd, 1048576) do
        Err(msg) -> Err(RecvError(msg))
        Ok(raw) -> Ok(raw)
      end
      handle_leave(s)
      r
    end
  end

  pfn recv_all_on(s : Socket) : Result(String, TransportError) do
    let fd = handle_enter(s, 3)
    if fd == -1 do Err(Closed) else
      let r = match tcp_recv_all(fd, 1048576, 30000) do
        Err(msg) -> Err(RecvError(msg))
        Ok(raw) -> Ok(raw)
      end
      handle_leave(s)
      r
    end
  end

  pfn recv_headers_on(s : Socket) : Result((String, Int, Bool), TransportError) do
    let fd = handle_enter(s, 3)
    if fd == -1 do Err(Closed) else
      let r = match tcp_recv_http_headers(fd) do
        Err(msg) -> Err(RecvError(msg))
        Ok(h) -> Ok(h)
      end
      handle_leave(s)
      r
    end
  end

  pfn recv_chunked_frame_on(s : Socket) : Result(String, TransportError) do
    let fd = handle_enter(s, 3)
    if fd == -1 do Err(Closed) else
      let r = match tcp_recv_chunked_frame(fd) do
        Err(msg) -> Err(RecvError(msg))
        Ok(f) -> Ok(f)
      end
      handle_leave(s)
      r
    end
  end

  pfn recv_chunk_on(s : Socket, max : Int) : Result(String, TransportError) do
    let fd = handle_enter(s, 3)
    if fd == -1 do Err(Closed) else
      let r = match tcp_recv_chunk(fd, max) do
        Err(msg) -> Err(RecvError(msg))
        Ok(c) -> Ok(c)
      end
      handle_leave(s)
      r
    end
  end

  pfn connect_error(e : Socket.SocketError) : TransportError do
    match e do
    ConnectionFailed(msg) -> ConnectionRefused(msg)
    other -> ConnectionRefused(Socket.error_message(other))
    end
  end

  -- Guard the Socket-oriented APIs: they write plaintext to the socket.
  pfn require_plain_http(req) do
    match Http.scheme(req) do
    SchemeHttp  -> Ok(())
    SchemeHttps -> Err(SchemeNotSupported("https:// not supported by HttpTransport; use the Tls module"))
    end
  end

  doc """
  Open a TCP connection to the request's host and port (80 when the
  request has none). Returns `Ok(socket)`, or `Err(ConnectionRefused(msg))`
  if the connection fails. Close the socket with `Socket.close` when done
  (dropping the last reference closes it too).

  Refuses https:// requests with `SchemeNotSupported` — use the Tls
  module for TLS-enabled connections.

  ## Examples

      let req = Result.unwrap(Http.get("http://example.com/"))
      match HttpTransport.connect(req) do
        Ok(s) -> HttpTransport.request_on(s, Http.set_body(req, ""))
        Err(e) -> Err(e)
      end

      march> let sreq = Http.set_body(Result.unwrap(Http.get("https://example.com/")), "")
      march> HttpTransport.connect(sreq)
      Err(SchemeNotSupported("https:// not supported by HttpTransport; use the Tls module"))
  """
  fn connect(req) do
    match require_plain_http(req) do
    Err(e) -> Err(e)
    Ok(_) -> do
      let req_host = Http.host(req)
      let req_port = match Http.port(req) do
        Some(p) -> p
        None -> 80
        end
      match Socket.connect(req_host, req_port) do
      Err(e) -> Err(connect_error(e))
      Ok(s) -> Ok(s)
      end
    end
    end
  end

  doc """
  Send a request and receive the response on an open socket.
  Does NOT close the connection — the caller manages the socket's lifetime.
  Suitable for keep-alive connection reuse. No `Connection: close` header
  is added. The response is read with a 1 MiB limit.

  Returns `Ok(Response(...))`, or `SendError` / `RecvError` /
  `ConnParseError` for a failed send, receive or unparseable response.
  A method, host, path, query or header that would smuggle a second request
  (a CR, LF, space or other byte the request line or a header cannot carry)
  gives `Refused(reason)` and nothing is sent. `Err(Closed)` once the
  socket is closed.

  Refuses https:// requests with `SchemeNotSupported` even on an open
  socket, because this module writes plaintext that would bypass TLS.
  Use the Tls module for HTTPS.

  ## Examples

      let r1 = HttpTransport.request_on(s, users_req)
      let r2 = HttpTransport.request_on(s, posts_req)
      Socket.close(s)
  """
  fn request_on(s : Socket, req) do
    match require_plain_http(req) do
    Err(e) -> Err(e)
    Ok(_) -> request_on_plain(s, req)
    end
  end

  pfn request_on_plain(s, req) do
    let meth = Http.method_to_string(Http.method(req))
    let req_host = Http.host(req)
    let req_path = Http.path(req)
    let req_query = Http.query(req)
    let req_headers = Http.headers(req)
    let req_body = Http.body(req)

    match http_serialize_request(meth, req_host, req_path, req_query, req_headers, req_body) do
    Err(msg) -> Err(Refused(msg))
    Ok(raw_request) -> send_and_recv_on(s, raw_request)
    end
  end

  pfn send_and_recv_on(s, raw_request) do
    match send_all_on(s, raw_request) do
    Err(e) -> Err(e)
    Ok(_) -> do
      match recv_http_on(s) do
      Err(e) -> Err(e)
      Ok(raw_response) ->
        match http_parse_response(raw_response) do
        Err(msg) -> Err(ConnParseError(msg))
        Ok((status_code, resp_headers, resp_body)) ->
          Ok(Response(Status(status_code), resp_headers, resp_body))
        end
      end
    end
    end
  end

  doc """
  Send a request on an open socket and stream the response body.
  Calls `on_chunk(chunk_string)` for each body chunk as it arrives (chunked
  transfer-encoding frames, or reads of a Content-Length body).
  Returns `Ok((status_code, headers, ()))`: the values returned by
  `on_chunk` are discarded. Errors are `SendError` / `RecvError` /
  `ConnParseError`, and `Refused(reason)` (nothing sent) for a request field
  that would smuggle a second request, and `Closed` once the socket is
  closed. Does NOT close the connection.

  ## Examples

      HttpTransport.stream_request_on(s, req, fn chunk -> println(chunk))

  Refuses https:// requests with `SchemeNotSupported`.  Use the Tls
  module for streaming over TLS.
  """
  fn stream_request_on(s : Socket, req, on_chunk) do
    match require_plain_http(req) do
    Err(e) -> Err(e)
    Ok(_) -> stream_request_on_plain(s, req, on_chunk)
    end
  end

  pfn stream_request_on_plain(s, req, on_chunk) do
    let meth = Http.method_to_string(Http.method(req))
    let req_host = Http.host(req)
    let req_path = Http.path(req)
    let req_query = Http.query(req)
    let req_headers = Http.headers(req)
    let req_body = Http.body(req)

    match http_serialize_request(meth, req_host, req_path, req_query, req_headers, req_body) do
    Err(msg) -> Err(Refused(msg))
    Ok(raw_request) -> stream_send_on(s, raw_request, on_chunk)
    end
  end

  pfn stream_send_on(s, raw_request, on_chunk) do
    match send_all_on(s, raw_request) do
    Err(e) -> Err(e)
    Ok(_) -> do
      match recv_headers_on(s) do
      Err(e) -> Err(e)
      Ok((headers_str, content_length, is_chunked)) ->
        match http_parse_response(headers_str) do
        Err(msg) -> Err(ConnParseError(msg))
        Ok((status_code, resp_headers, _)) ->
          if is_chunked do
            stream_chunked_body(s, on_chunk, status_code, resp_headers)
          else
            stream_fixed_body(s, content_length, on_chunk, status_code, resp_headers)
          end
        end
      end
    end
    end
  end

  doc """
  Read chunked-encoding frames from `s`, calling `on_chunk` on each, until
  the terminating empty frame. Returns `Ok((status_code, resp_headers, ()))`,
  `Err(RecvError(msg))`, or `Err(Closed)` once the socket is closed. Used by
  `stream_request_on` after the headers have been read.
  """
  @[diverges] fn stream_chunked_body(s : Socket, on_chunk, status_code, resp_headers) do
    match recv_chunked_frame_on(s) do
    Err(e) -> Err(e)
    Ok("") -> Ok((status_code, resp_headers, ()))
    Ok(chunk) -> do
      on_chunk(chunk)
      stream_chunked_body(s, on_chunk, status_code, resp_headers)
    end
    end
  end

  doc """
  Read a Content-Length body of `remaining` bytes from `s`, calling
  `on_chunk` on each piece received. Stops when `remaining` reaches 0 or the
  peer closes early (both give `Ok((status_code, resp_headers, ()))`), or
  returns `Err(RecvError(msg))` (`Err(Closed)` once the socket is closed).
  Used by `stream_request_on`.
  """
  fn stream_fixed_body(s : Socket, remaining, on_chunk, status_code, resp_headers) do
    if remaining == 0 do Ok((status_code, resp_headers, ()))
    else
      match recv_chunk_on(s, remaining) do
      Err(e) -> Err(e)
      Ok("") -> Ok((status_code, resp_headers, ()))
      Ok(chunk) -> do
        on_chunk(chunk)
        stream_fixed_body(s, remaining - string_length(chunk), on_chunk, status_code, resp_headers)
      end
      end
    end
  end

  -- ---- Browser/js_of_ocaml transport (synchronous XHR) ----
  -- When running under js_of_ocaml there are no raw sockets, so the whole
  -- request is handed to the platform `http_fetch` builtin (a synchronous
  -- XMLHttpRequest).  Native builds leave `http_fetch_available()` false and
  -- never take this path.

  pfn scheme_to_string(sch) do
    match sch do
    SchemeHttp  -> "http"
    SchemeHttps -> "https"
    end
  end

  pfn build_url(req) do
    let port_str = match Http.port(req) do
      Some(p) -> ":" ++ int_to_string(p)
      None -> ""
      end
    let query_str = match Http.query(req) do
      Some(q) -> "?" ++ q
      None -> ""
      end
    scheme_to_string(Http.scheme(req)) ++ "://" ++ Http.host(req) ++ port_str ++ Http.path(req) ++ query_str
  end

  pfn serialize_header_block(headers) do
    match headers do
    Nil -> ""
    Cons(Header(n, v), rest) -> n ++ ": " ++ v ++ "\r\n" ++ serialize_header_block(rest)
    end
  end

  pfn request_via_fetch(req) do
    let meth = Http.method_to_string(Http.method(req))
    -- The fetch path builds its own URL and header block, so it runs the
    -- serializer only for its field checks: the same request is refused here
    -- as on the socket path.
    match http_serialize_request(meth, Http.host(req), Http.path(req), Http.query(req),
                                 Http.headers(req), Http.body(req)) do
    Err(msg) -> Err(Refused(msg))
    Ok(_) -> request_via_fetch_checked(meth, req)
    end
  end

  pfn request_via_fetch_checked(meth, req) do
    let url = build_url(req)
    let header_block = serialize_header_block(Http.headers(req))
    match http_fetch(meth, url, header_block, Http.body(req)) do
    Err(msg) -> Err(RecvError(msg))
    Ok(raw) ->
      match http_parse_response(raw) do
      Err(msg) -> Err(ConnParseError(msg))
      Ok((status_code, resp_headers, resp_body)) ->
        Ok(Response(Status(status_code), resp_headers, resp_body))
      end
    end
  end

  doc """
  Send an HTTP or HTTPS request and receive the response.
  Opens a TCP connection, sends the request with Connection: close,
  receives and parses the response, then closes the connection.

  HTTPS uses the certificate-verifying TLS client with SNI. `connect`,
  `request_on`, and `stream_request_on` remain plain-HTTP Socket APIs and refuse
  HTTPS because they cannot safely construct or receive a TLS connection.

  In js_of_ocaml builds (where `http_fetch_available()` is true) the request
  is routed through a synchronous XHR instead, which handles both http and
  https; the socket path below is skipped.

  Default ports are 80 / 443. The response is read with a 1 MiB limit (plain
  HTTP also uses a 30 s receive timeout). Errors: `ConnectionRefused` for a
  failed TCP connect or TLS setup/handshake, `SendError`, `RecvError`,
  `ConnParseError` for an unparseable response, and `Refused(reason)`,
  before any connection is opened, for a method, host, path, query or header
  that would smuggle a second request (CR, LF, space, a control byte, or a
  path/query byte outside RFC 3986 that was not percent-encoded).

  ## Examples

      let req = Result.unwrap(Http.get("https://example.com/"))
      match HttpTransport.request(Http.set_body(req, "")) do
        Ok(resp) -> Http.response_status_code(resp)
        Err(_) -> 0
      end
  """
  fn request(req) do
    if http_fetch_available() do
      request_via_fetch(req)
    else
      match Http.scheme(req) do
      SchemeHttp -> request_plain(req)
      SchemeHttps -> request_https(req)
      end
    end
  end

  pfn request_https(req) do
    let req = Http.set_header(req, "Connection", "close")
    let host = Http.host(req)
    let port = match Http.port(req) do
      Some(value) -> value
      None -> 443
      end
    match http_serialize_request(
      Http.method_to_string(Http.method(req)), host, Http.path(req), Http.query(req),
      Http.headers(req), Http.body(req)) do
    Err(msg) -> Err(Refused(msg))
    Ok(raw) -> request_https_raw(host, port, raw)
    end
  end

  pfn request_https_raw(host, port, raw) do
    match Tls.client_ctx(Tls.default_client_config()) do
    Err(error) -> Err(ConnectionRefused(Tls.error_to_string(error)))
    Ok(context) -> do
      let result = request_https_with_context(context, host, port, raw)
      Tls.ctx_free(context)
      result
    end
    end
  end

  pfn request_https_with_context(context, host, port, raw) do
    match Socket.connect(host, port) do
    Err(error) -> Err(connect_error(error))
    Ok(s) -> do
      -- A successful Tls.connect takes the socket over (closing the TLS
      -- connection closes it); after a failed one it is still ours, and this
      -- close is what releases it. On the success path it is a no-op.
      let result = request_https_on_socket(context, s, host, raw)
      let _ = Socket.close(s)
      result
    end
    end
  end

  pfn request_https_on_socket(context, s, host, raw) do
    match Tls.connect(s, context, host) do
    Err(error) -> Err(ConnectionRefused(Tls.error_to_string(error)))
    Ok(connection) -> do
      let result = request_on_tls(connection, raw)
      Tls.close(connection)
      result
    end
    end
  end

  pfn request_on_tls(connection, raw) do
    match Tls.write(connection, raw) do
    Err(error) -> Err(SendError(Tls.error_to_string(error)))
    Ok(_) ->
      match tls_recv_all(connection, "", 1048576) do
      Err(error) -> Err(RecvError(Tls.error_to_string(error)))
      Ok(response) ->
        match http_parse_response(response) do
        Err(error) -> Err(ConnParseError(error))
        Ok((status, headers, body)) -> Ok(Response(Status(status), headers, body))
        end
      end
    end
  end

  pfn tls_recv_all(connection, received, remaining) do
    if remaining <= 0 do
      Err(Tls.TlsReadError("response exceeds 1048576 bytes"))
    else
      match Tls.read(connection, remaining) do
      Err(error) -> Err(error)
      Ok("") -> Ok(received)
      Ok(chunk) -> tls_recv_all(connection, received ++ chunk, remaining - string_byte_length(chunk))
      end
    end
  end

  pfn request_plain(req) do
    let req = Http.set_header(req, "Connection", "close")
    let req_host = Http.host(req)
    let req_port = match Http.port(req) do
      Some(p) -> p
      None -> 80
      end

    match http_serialize_request(
      Http.method_to_string(Http.method(req)),
      req_host, Http.path(req), Http.query(req),
      Http.headers(req), Http.body(req)) do
    Err(msg) -> Err(Refused(msg))
    Ok(raw_request) -> request_plain_raw(req_host, req_port, raw_request)
    end
  end

  pfn request_plain_raw(req_host, req_port, raw_request) do
    match Socket.connect(req_host, req_port) do
    Err(e) -> Err(connect_error(e))
    Ok(s) -> do
      let received = match send_all_on(s, raw_request) do
        Err(e) -> Err(e)
        Ok(_) -> recv_all_on(s)
      end
      let _ = Socket.close(s)
      match received do
      Err(e) -> Err(e)
      Ok(raw_response) ->
        match http_parse_response(raw_response) do
        Err(msg) -> Err(ConnParseError(msg))
        Ok((status_code, resp_headers, resp_body)) ->
          Ok(Response(Status(status_code), resp_headers, resp_body))
        end
      end
    end
    end
  end

  doc """
  Convenience wrapper: parse a URL and send a GET request (empty body)
  with `request`. A URL that does not parse gives `Err(ConnParseError(...))`
  without touching the network; otherwise the result of `request`.

  ## Examples

      HttpTransport.simple_get("http://example.com/")

      march> HttpTransport.simple_get("ftp://example.com/")
      Err(ConnParseError("invalid scheme: ftp://example.com/"))
  """
  @[net_dest(url)]
  fn simple_get(url) do simple_get_scoped(url, "") end

  doc """
  `simple_get` checked against a host/path scope string (the format in
  `Http`'s scope section) before connecting: a request outside it is
  `Err(Refused(reason))` and never connects. The compiler calls this for a
  module that declares a host scope; calling it directly can only narrow.

  ## Examples

      march> HttpTransport.simple_get_scoped("https://other.invalid/", "a.invalid")
      Err(Refused("host other.invalid is outside the scope"))
  """
  @[net_dest(url)]
  fn simple_get_scoped(url, scope) do
    match Http.get(url) do
    Err(InvalidScheme(s)) -> Err(ConnParseError("invalid scheme: " ++ s))
    Err(MissingHost) -> Err(ConnParseError("missing host"))
    Err(InvalidPort(s)) -> Err(ConnParseError("invalid port: " ++ s))
    Err(MalformedUrl(s)) -> Err(ConnParseError("malformed url: " ++ s))
    Ok(req) ->
      match Http.scope_check_request(scope, req) do
      Ok(_) -> request(Http.set_body(req, ""))
      Err(HostRefused(h)) -> Err(Refused("host " ++ h ++ " is outside the scope"))
      Err(MethodNotAllowed(m)) -> Err(Refused(m ++ " is not allowed by the scope"))
      Err(PathNotAllowed(p)) -> Err(Refused("path " ++ p ++ " is outside the scope"))
      end
    end
  end

end
