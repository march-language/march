-- File module: filesystem I/O.
-- Every function that takes a path is a capability operation (IO.FileRead /
-- IO.FileWrite on the path) and returns `Result(T, CapError)`: `Err(CapError(...))` when
-- the current authority refuses it (specs/2026-11-10-object-capability-
-- design.md §15). For all but `exists`, `T` is `Result(value, FileError)`:
-- `Ok(Err(NotFound(p)))` is a missing file, `Err(CapError(...))` a refused
-- read.
--
-- Open a `File.Handle` with `open` / `open_write` (or `with_open` /
-- `with_open_write`, which close it for you) to read, write and seek a
-- stream; a use after `close` returns `Err(Closed)`. Opening is the
-- capability operation; `read_line`, `read_chunk`, `write_to`, `seek` and
-- `close` use the handle you already hold and return `Result(_, FileError)`.
-- Use with_lines / with_chunks for streaming.  The file handle is
-- closed when the callback returns *and* if the callback panics —
-- these wrappers delegate to the runtime `try_finally` primitive to
-- guarantee cleanup even on unhandled exceptions.  each_line /
-- each_chunk close the handle on normal return; if `f` panics they do
-- not close it there, and the descriptor is released only when the
-- handle's last reference is dropped.

mod File do
  needs IO.FileRead
  needs IO.FileWrite

  -- The runtime builds these by tag (runtime/march_runtime.c FILEERR_*):
  -- keep the order, and add new constructors at the end.
  ptype FileError = NotFound(String) | Permission(String) | IsDirectory(String) | NotEmpty(String) | IoError(String) | Closed
  derive Eq for FileError

  -- How `open_write` treats an existing file: `Truncate` empties it,
  -- `Append` writes after its end. Either way a missing file is created.
  type WriteMode = Truncate | Append

  ptype FileKind = RegularFile | Directory | Symlink | OtherKind
  derive Eq for FileKind

  -- FileStat uses a positional constructor
  -- Pattern match: FileStat(size, kind, modified, accessed)
  ptype FileStat = FileStat(Int, FileKind, Int, Int)

  -- Read

  doc """
  Read the whole file at `path` into a String. Returns `Ok(contents)` or
  `Err(FileError)`, e.g. `NotFound(path)`, `Permission(path)` or
  `IsDirectory(path)`.

  ## Examples

      match File.read("config.toml") do
        Ok(Ok(text)) -> parse(text)
        Ok(Err(NotFound(p))) -> defaults()
        Ok(Err(e)) -> panic("cannot read config")
        Err(refused) -> panic(Authority.describe(refused))
      end
  """
  fn read(path) do
    let? _ = Authority.check("IO.FileRead", path)
    Ok(file_read(path))
  end

  doc """
  Read the file at `path` and split it on `\n`. Returns `Ok(lines)` without
  the newline characters; ALL trailing empty lines are dropped (so a final
  newline, or several, adds no empty element, and an empty file gives
  `Ok([])`). A `\r` before each `\n` is kept. Errors as for `read`.

  ## Examples

      -- file contents "a\nb\n\n"
      File.read_lines("notes.txt")   -- Ok(["a", "b"])
  """
  fn read_lines(path) do
    let? _ = Authority.check("IO.FileRead", path)
    let performed = match file_read(path) do
    Err(e) -> Err(e)
    Ok(s) -> do
      let lines = String.split(s, "\n")
      -- Strip all trailing empty strings (from trailing newlines)
      fn strip_trailing(xs) do
        match List.reverse(xs) do
        Nil -> Nil
        Cons("", rest) -> strip_trailing(List.reverse(rest))
        ig -> xs
        end
      end
      Ok(strip_trailing(lines))
    end
    end
    Ok(performed)
  end

  doc """
  True if any filesystem entry exists at `path`, including directories.
  Use `Dir.exists` to test specifically for directories. Never fails.

  ## Examples

      if File.exists("out.log") do File.delete("out.log") else Ok(:ok) end
  """
  fn exists(path) : Result(Bool, CapError) do
    let? _ = Authority.check("IO.FileRead", path)
    Ok(file_exists(path))
  end

  doc """
  Metadata for `path`: `Ok(FileStat(size_bytes, kind, modified, accessed))`
  where `kind` is a `FileKind` and the times are Unix timestamps in whole
  seconds. Returns `Err(NotFound(path))` if nothing exists there.

  ## Examples

      match File.stat("data.bin") do
        Ok(FileStat(size, RegularFile, _, _)) -> size
        _ -> 0
      end
  """
  fn stat(path) do
    let? _ = Authority.check("IO.FileRead", path)
    Ok(file_stat(path))
  end

  doc """
  The modification time of `path` as a Unix timestamp in seconds
  (`Ok(mtime)`), or the `FileError` from `stat`.
  """
  fn mtime(path) do
    let? _ = Authority.check("IO.FileRead", path)
    let performed = match file_stat(path) do
    Err(e) -> Err(e)
    Ok(FileStat(_, _, m, _)) -> Ok(m)
    end
    Ok(performed)
  end

  -- Write

  doc """
  Write `data` to `path`, creating the file or truncating an existing one.
  Returns `Ok(:ok)` or `Err(FileError)` (e.g. the parent directory does
  not exist).

  ## Examples

      File.write("out.txt", "hello\n")
  """
  fn write(path, data) do
    let? _ = Authority.check("IO.FileWrite", path)
    Ok(file_write(path, data))
  end
  doc """
  Append `data` to the end of `path`, creating the file if it does not
  exist. Returns `Ok(:ok)` or `Err(FileError)`.

  ## Examples

      File.append("app.log", "started\n")
  """
  fn append(path, data) do
    let? _ = Authority.check("IO.FileWrite", path)
    Ok(file_append(path, data))
  end
  doc """
  Delete the file at `path`. Returns `Ok(:ok)`, or `Err(FileError)` if it
  does not exist or cannot be removed. Use `Dir.rmdir` / `Dir.rm_rf` for
  directories.
  """
  fn delete(path) do
    let? _ = Authority.check("IO.FileWrite", path)
    Ok(file_delete(path))
  end
  doc """
  Copy the contents of `src` to `dest`, creating or overwriting `dest`.
  Returns `Ok(:ok)` or `Err(FileError)` (reported as `IoError(msg)`).
  """
  fn copy(src, dest) do
    let? _ = Authority.check("IO.FileRead", src)
    let? _ = Authority.check("IO.FileWrite", dest)
    Ok(file_copy(src, dest))
  end
  doc """
  Rename (move) `src` to `dest`, replacing `dest` if it exists. Returns
  `Ok(:ok)` or `Err(IoError("<src>: <reason>"))`.
  """
  fn rename(src, dest) do
    let? _ = Authority.check("IO.FileWrite", src)
    let? _ = Authority.check("IO.FileWrite", dest)
    Ok(file_rename(src, dest))
  end

  -- Handles

  doc """
  Open `path` for reading (a capability operation, IO.FileRead). Returns
  `Ok(Ok(handle))`, `Ok(Err(FileError))` such as `NotFound(path)` or
  `Permission(path)`, or `Err(CapError(...))` when the open is refused. Read it with `read_line` /
  `read_chunk`, and `close` it when done; a handle that is dropped without
  being closed is closed when its last reference goes. `with_open` closes it
  for you.

  ## Examples

      match Authority.must(File.open("notes.txt")) do
        Ok(h) ->
          let first = File.read_line(h)
          let _ = File.close(h)
          first
        Err(e) -> Err(e)
      end
  """
  fn open(path : String) : Result(Result(File.Handle, FileError), CapError) do
    let? _ = Authority.check("IO.FileRead", path)
    Ok(open_raw(path))
  end

  -- The open itself, after the capability check. Called directly (not through
  -- a closure) so capability attribution sees through it to the caller.
  pfn open_raw(path : String) : Result(File.Handle, FileError) do
    match file_open(path) do
    Err(e) -> Err(e)
    Ok(fd) ->
      let h : File.Handle = handle_new(1, fd, 0)
      Ok(h)
    end
  end

  doc """
  Open `path` for writing, creating it if missing. `Truncate` empties an
  existing file first; `Append` writes after its end. Returns `Ok(handle)`
  or `Err(FileError)`. Write with `write_to` and `close` the handle when
  done (the bytes are on disk once it is closed). A capability operation
  (IO.FileWrite): the result is wrapped in `Result(_, CapError)` like `open`'s.

  ## Examples

      match Authority.must(File.open_write("out.log", File.Append)) do
        Ok(h) ->
          let _ = File.write_to(h, "started\n")
          File.close(h)
        Err(e) -> Err(e)
      end
  """
  fn open_write(path : String, mode : WriteMode) : Result(Result(File.Handle, FileError), CapError) do
    let? _ = Authority.check("IO.FileWrite", path)
    Ok(open_write_raw(path, mode))
  end

  pfn open_write_raw(path : String, mode : WriteMode) : Result(File.Handle, FileError) do
    let m = match mode do
      Truncate -> 0
      Append -> 1
    end
    match file_open_write(path, m) do
    Err(e) -> Err(e)
    Ok(fd) ->
      let h : File.Handle = handle_new(1, fd, 0)
      Ok(h)
    end
  end

  -- Every use of a handle goes through here: enter the box (refused once it
  -- is closed), run the raw operation, then leave. A close that races the
  -- use defers the release to this leave, so the descriptor is never
  -- reused while `f` runs.
  pfn with_raw(h : File.Handle, f : Int -> Result(b, FileError)) : Result(b, FileError) do
    let fd = handle_enter(h, 1)
    if fd == -1 do Err(Closed) else
      let r = f(fd)
      handle_leave(h)
      r
    end
  end

  doc """
  Read the next line from `h`, without its line terminator. Returns
  `Ok(Some(line))`, `Ok(None)` at end of file, or `Err(Closed)` once `h`
  is closed.

  ## Examples

      File.read_line(h)   -- Ok(Some("first line"))
  """
  fn read_line(h : File.Handle) : Result(Option(String), FileError) do
    with_raw(h, fn fd -> Ok(file_read_line(fd)))
  end

  doc """
  Read up to `size` bytes from `h`. Returns `Ok(Some(chunk))` (the last
  chunk may be shorter), `Ok(None)` at end of file, or `Err(Closed)`.
  """
  fn read_chunk(h : File.Handle, size : Int) : Result(Option(String), FileError) do
    with_raw(h, fn fd -> Ok(file_read_chunk(fd, size)))
  end

  doc """
  Write `data` to `h`, a handle from `open_write`. Returns `Ok(())`,
  `Err(Closed)` once `h` is closed, or `Err(IoError(msg))`. Named
  `write_to` because `File.write(path, data)` writes a whole file by path.
  """
  fn write_to(h : File.Handle, data : String) : Result((), FileError) do
    with_raw(h, fn fd -> file_write_handle(fd, data))
  end

  doc """
  Move `h` to the absolute byte `offset`. Returns `Ok(offset)` or
  `Err(Closed)` / `Err(IoError(msg))`.

  ## Examples

      File.seek(h, 0)     -- back to the start: Ok(0)
  """
  fn seek(h : File.Handle, offset : Int) : Result(Int, FileError) do
    with_raw(h, fn fd -> file_seek(fd, offset))
  end

  doc """
  Close `h`. Returns `Ok(())`, or `Err(Closed)` if it was already closed.
  Every later use of `h` returns `Err(Closed)`. A read or write still in
  progress on another task finishes first; the descriptor is released
  when it does.
  """
  fn close(h : File.Handle) : Result((), FileError) do
    if handle_close(h) do Ok(()) else Err(Closed) end
  end

  doc """
  Open `path` for reading, pass the handle to `f`, and close it when `f`
  returns or panics. Returns `Ok(Ok(f_result))`, the open's `Ok(Err(FileError))`,
  or `Err(CapError(...))` when the open is refused.
  The handle must not be used after `f` returns: it is closed.

  ## Examples

      File.with_open("notes.txt", fn h -> File.read_line(h))
  """
  fn with_open(path : String, f : File.Handle -> a) : Result(Result(a, FileError), CapError) do
    let? _ = Authority.check("IO.FileRead", path)
    let performed = match open_raw(path) do
    Err(e) -> Err(e)
    Ok(h) ->
      let result = try_finally(
        fn _ -> f(h),
        fn _ -> close(h)
      )
      Ok(result)
    end
    Ok(performed)
  end

  doc """
  Like `with_open`, for writing: opens `path` with `open_write(path, mode)`,
  passes the handle to `f`, and closes it when `f` returns or panics.

  ## Examples

      File.with_open_write("out.txt", File.Truncate, fn h ->
        File.write_to(h, "hello\n"))
  """
  fn with_open_write(path : String, mode : WriteMode, f : File.Handle -> a) : Result(Result(a, FileError), CapError) do
    let? _ = Authority.check("IO.FileWrite", path)
    let performed = match open_write_raw(path, mode) do
    Err(e) -> Err(e)
    Ok(h) ->
      let result = try_finally(
        fn _ -> f(h),
        fn _ -> close(h)
      )
      Ok(result)
    end
    Ok(performed)
  end

  -- Streaming: closed when callback returns OR panics (via try_finally).

  -- Seq wraps a church-encoded fold closure. Single-pass.
  ptype Seq(a) = Seq(a)

  doc """
  Open `path`, pass the callback a single-pass `Seq(String)` of its lines
  (line terminators stripped), then close the file. Returns
  `Ok(callback_result)`, or `Err(FileError)` if the file cannot be opened.
  Lines are read lazily as the Seq is folded, so memory stays bounded.
  The Seq is single-pass: consuming it twice yields nothing the second
  time, and it must not escape the callback (the file is closed after).
  `try_finally` guarantees the fd is closed even if `callback` panics.

  ## Examples

      File.with_lines("big.log", fn lines ->
        Seq.fold(lines, 0, fn (n, line) ->
          if String.contains(line, "ERROR") do n + 1 else n end))
  """
  fn with_lines(path, callback) do
    let? _ = Authority.check("IO.FileRead", path)
    let performed = match open_raw(path) do
    Err(e) -> Err(e)
    Ok(h) -> do
      fn do_lines(a, f) do
        match read_line(h) do
        Ok(Some(line)) -> do_lines(f(a, line), f)
        _ -> a
        end
      end
      let seq = Seq(fn(acc, f) -> do_lines(acc, f))
      let result = try_finally(
        fn _ -> callback(seq),
        fn _ -> close(h)
      )
      Ok(result)
    end
    end
    Ok(performed)
  end

  doc """
  Like `with_lines`, but the Seq yields raw chunks of at most `size` bytes
  (the last one may be shorter). Returns `Ok(callback_result)` or
  `Err(FileError)`. The file is closed even if `callback` panics.

  ## Examples

      File.with_chunks("blob.bin", 65536, fn chunks ->
        Seq.fold(chunks, 0, fn (n, c) -> n + string_byte_length(c)))
  """
  fn with_chunks(path, size, callback) do
    let? _ = Authority.check("IO.FileRead", path)
    let performed = match open_raw(path) do
    Err(e) -> Err(e)
    Ok(h) -> do
      fn do_chunks(a, f) do
        match read_chunk(h, size) do
        Ok(Some(chunk)) -> do_chunks(f(a, chunk), f)
        _ -> a
        end
      end
      let seq = Seq(fn(acc, f) -> do_chunks(acc, f))
      let result = try_finally(
        fn _ -> callback(seq),
        fn _ -> close(h)
      )
      Ok(result)
    end
    end
    Ok(performed)
  end

  -- Low-level callbacks (side-effect iteration)

  -- Internal helper: recursively reads lines. Used by each_line.
  @[diverges] pfn each_line_loop(h, f) do
    match read_line(h) do
    Ok(Some(line)) -> do
      f(line)
      each_line_loop(h, f)
    end
    _ -> :ok
    end
  end

  doc """
  Call `f(line)` for each line of `path` (terminators stripped), for side
  effects. Returns `Ok(:ok)`, or `Err(FileError)` if the file cannot be
  opened. Unlike `with_lines`, the file is not closed at the panic site if
  `f` panics: its descriptor is released when the handle's last reference
  is dropped.

  ## Examples

      File.each_line("names.txt", fn name -> println("hello " ++ name))
  """
  fn each_line(path, f) do
    let? _ = Authority.check("IO.FileRead", path)
    let performed = match open_raw(path) do
    Err(e) -> Err(e)
    Ok(h) -> do
      each_line_loop(h, f)
      let _ = close(h)
      Ok(:ok)
    end
    end
    Ok(performed)
  end

  -- Internal helper: recursively reads chunks. Used by each_chunk.
  @[diverges] pfn each_chunk_loop(h, size, f) do
    match read_chunk(h, size) do
    Ok(Some(chunk)) -> do
      f(chunk)
      each_chunk_loop(h, size, f)
    end
    _ -> :ok
    end
  end

  doc """
  Call `f(chunk)` for each chunk of at most `size` bytes of `path`, for side
  effects. Returns `Ok(:ok)` or `Err(FileError)` if the file cannot be
  opened. If `f` panics the file is not closed at the panic site: its
  descriptor is released when the handle's last reference is dropped (use
  `with_chunks` to close it at once).
  """
  fn each_chunk(path, size, f) do
    let? _ = Authority.check("IO.FileRead", path)
    let performed = match open_raw(path) do
    Err(e) -> Err(e)
    Ok(h) -> do
      each_chunk_loop(h, size, f)
      let _ = close(h)
      Ok(:ok)
    end
    end
    Ok(performed)
  end

end
