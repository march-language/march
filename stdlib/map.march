-- Map module: persistent hash-array-mapped-trie map.
--
-- Map(k, v) is an immutable, hash-indexed key-value store backed by a
-- HAMT (Hash Array Mapped Trie).  Lookup, insert, and delete are
-- O(log₃₂ n) ≈ O(1) amortized.  The HAMT provides excellent structural
-- sharing under Perceus reference counting (path-copy only touches
-- 1–7 nodes per update).
--
-- Operations that need key identity take an explicit comparator:
--   cmp : k -> k -> Bool    where cmp(a)(b) = true means a < b
--
-- Equality between keys is derived from the comparator:
--   eq(a, b) = not cmp(a)(b) and not cmp(b)(a)
--
-- Standard comparators:
--   fn a -> fn b -> a < b        for Int or String keys (String: lexicographic)
--   Map.int_cmp / Map.str_cmp    the same, as named functions
--
-- Keys are located by `hash`, and the comparator only decides equality among
-- keys whose hashes match, so it must agree with `==` (a comparator that
-- treats two `==`-different keys as equal, e.g. case-insensitively, does not
-- merge them).
--
-- Element refinements: `get`, `get_or`, `insert`, `remove`, `keys`, `values`,
-- `map_values`, `merge` and `singleton` are annotated with their generic types,
-- so the refinement checker carries a refined map's key and value facts through
-- them by PARAMETRICITY (checked, not assumed): `Map.insert(m, k, v, cmp)` with
-- `m : Map(String, {Int | _ > 0})` meets `Map(String, {Int | _ > 0})` when `v`
-- is positive. Their key-set contracts stay assumed, as below. See
-- docs/refinement-types.md, "Map's own functions".
--
-- Iteration order is hash-traversal order (not sorted by key).
-- Use to_list then sort externally if sorted order is needed.
--
-- Performance (n entries):
--   Lookup / insert / delete  O(log₃₂ n) ≈ O(1)
--   size                      O(n)
--   Traversals (fold / keys)  O(n)
--
-- doc: try

mod Map do

  -- ── Internal representation ────────────────────────────────────────────────

  -- Map(k, v) wraps a Hamt.HEntry(k, v) trie node.
  -- We use HEntry directly as the Map type to avoid an extra wrapper allocation.
  ptype Map(k, v) = HamtMap(HEntry(k, v))

  -- Re-export the HEntry constructors under Map-local names so pattern
  -- matching stays inside this module.
  ptype HEntry(k, v) =
    HEmpty
    | HLeaf(Int, k, v)
    | HBranch(Int, List(HEntry(k, v)))
    | HCollision(Int, List((k, v)))

  -- ── Private helpers ────────────────────────────────────────────────────────

  pfn lst_rev(lst) do
    fn go(xs, acc) do
      match xs do
      Nil -> acc
      Cons(h, t) -> go(t, Cons(h, acc))
      end
    end
    go(lst, Nil)
  end

  -- Derive equality from a less-than comparator.
  pfn cmp_eq(cmp, a, b) do
    let lt_ab = cmp(a)
    let lt_ba = cmp(b)
    if lt_ab(b) do false
    else if lt_ba(a) do false
    else true end end
  end

  -- Hash a key (uses the built-in polymorphic hash, masked to 30 bits).
  pfn key_hash(k) do
    int_and(hash(k), 1073741823)
  end

  -- ── Low-level bit helpers (duplicated from Hamt for self-containedness) ───

  pfn hash_slot(h, level) do
    int_and(int_shr(h, level * 5), 31)
  end

  pfn bitmap_has(bitmap, idx) do
    int_and(int_shr(bitmap, idx), 1) == 1
  end

  pfn bitmap_rank(bitmap, idx) do
    int_popcount(int_and(bitmap, int_shl(1, idx) - 1))
  end

  pfn bitmap_set(bitmap, idx) do
    int_or(bitmap, int_shl(1, idx))
  end

  pfn bitmap_clear(bitmap, idx) do
    int_and(bitmap, int_not(int_shl(1, idx)))
  end

  -- ── Dense-list helpers ─────────────────────────────────────────────────────

  pfn list_insert_at(lst, idx, elem) do
    fn rev_onto(rev_xs, ys) do
      match rev_xs do
      Nil -> ys
      Cons(h, t) -> rev_onto(t, Cons(h, ys))
      end
    end
    fn go(xs, i, acc) do
      if i == 0 do rev_onto(acc, Cons(elem, xs))
      else match xs do
        Nil        -> rev_onto(acc, Cons(elem, Nil))
        Cons(h, t) -> go(t, i - 1, Cons(h, acc))
        end end
    end
    go(lst, idx, Nil)
  end

  pfn list_replace_at(lst, idx, elem) do
    fn rev_onto(rev_xs, ys) do
      match rev_xs do
      Nil -> ys
      Cons(h, t) -> rev_onto(t, Cons(h, ys))
      end
    end
    fn go(xs, i, acc) do
      match xs do
      Nil -> rev_onto(acc, Nil)
      Cons(h, t) -> do
        if i == 0 do rev_onto(acc, Cons(elem, t))
        else go(t, i - 1, Cons(h, acc)) end
      end
      end
    end
    go(lst, idx, Nil)
  end

  pfn list_delete_at(lst, idx) do
    fn rev_onto(rev_xs, ys) do
      match rev_xs do
      Nil -> ys
      Cons(h, t) -> rev_onto(t, Cons(h, ys))
      end
    end
    fn go(xs, i, acc) do
      match xs do
      Nil -> rev_onto(acc, Nil)
      Cons(h, t) -> do
        if i == 0 do rev_onto(acc, t)
        else go(t, i - 1, Cons(h, acc)) end
      end
      end
    end
    go(lst, idx, Nil)
  end

  pfn list_nth_safe(lst, n) do
    match lst do
    Nil -> panic("Map: HAMT node index out of range")
    Cons(h, t) ->
      if n == 0 do h else list_nth_safe(t, n - 1) end
    end
  end

  -- ── Collision helpers ──────────────────────────────────────────────────────

  pfn coll_find(pairs, key, eq) do
    match pairs do
    Nil -> None
    Cons(pair, rest) -> do
      let (k, v) = pair
      if eq(k, key) do Some(v)
      else coll_find(rest, key, eq) end
    end
    end
  end

  pfn coll_insert(pairs, key, val, eq) do
    fn rev_onto(rev_xs, ys) do
      match rev_xs do
      Nil -> ys
      Cons(h, t) -> rev_onto(t, Cons(h, ys))
      end
    end
    fn go(ps, acc) do
      match ps do
      Nil -> rev_onto(acc, Cons((key, val), Nil))
      Cons(pair, rest) -> do
        let (k, v) = pair
        if eq(k, key) do rev_onto(acc, Cons((key, val), rest))
        else go(rest, Cons(pair, acc)) end
      end
      end
    end
    go(pairs, Nil)
  end

  pfn coll_remove(pairs, key, eq) do
    fn rev_onto(rev_xs, ys) do
      match rev_xs do
      Nil -> ys
      Cons(h, t) -> rev_onto(t, Cons(h, ys))
      end
    end
    fn go(ps, acc) do
      match ps do
      Nil -> rev_onto(acc, Nil)
      Cons(pair, rest) -> do
        let (k, v) = pair
        if eq(k, key) do rev_onto(acc, rest)
        else go(rest, Cons(pair, acc)) end
      end
      end
    end
    go(pairs, Nil)
  end

  -- ── HAMT core ─────────────────────────────────────────────────────────────

  pfn node_get(node, key, h, eq, level) do
    match node do
    HEmpty -> None
    HLeaf(lh, lk, lv) -> do
      if lh == h do
        if eq(lk, key) do Some(lv) else None end
      else None end
    end
    HCollision(ch, pairs) -> do
      if ch == h do coll_find(pairs, key, eq)
      else None end
    end
    HBranch(bitmap, children) -> do
      let slot = hash_slot(h, level)
      if bitmap_has(bitmap, slot) do
        let idx = bitmap_rank(bitmap, slot)
        let child = list_nth_safe(children, idx)
        node_get(child, key, h, eq, level + 1)
      else None end
    end
    end
  end

  pfn make_branch(h1, k1, v1, h2, k2, v2, level) do
    fn apply_slots(node, slots) do
      match slots do
      Nil -> node
      Cons(s, rest) ->
        apply_slots(HBranch(bitmap_set(0, s), Cons(node, Nil)), rest)
      end
    end
    fn go(lvl, slots_acc) do
      if lvl > 6 do
        apply_slots(HCollision(h1, Cons((k1, v1), Cons((k2, v2), Nil))), slots_acc)
      else do
        let s1 = hash_slot(h1, lvl)
        let s2 = hash_slot(h2, lvl)
        if s1 == s2 do
          go(lvl + 1, Cons(s1, slots_acc))
        else do
          let leaf1 = HLeaf(h1, k1, v1)
          let leaf2 = HLeaf(h2, k2, v2)
          let bm = bitmap_set(bitmap_set(0, s1), s2)
          let base_node =
            if s1 < s2 do HBranch(bm, Cons(leaf1, Cons(leaf2, Nil)))
            else HBranch(bm, Cons(leaf2, Cons(leaf1, Nil))) end
          apply_slots(base_node, slots_acc) end
        end end
      end
    end
    go(level, Nil)
  end

  pfn node_insert(node, key, val, h, eq, level) do
    match node do
    HEmpty -> HLeaf(h, key, val)
    HLeaf(lh, lk, lv) -> do
      if lh == h do
        if eq(lk, key) do HLeaf(h, key, val)
        else HCollision(h, Cons((lk, lv), Cons((key, val), Nil))) end
      else
        make_branch(lh, lk, lv, h, key, val, level)
      end
    end
    HCollision(ch, pairs) -> do
      if ch == h do
        HCollision(ch, coll_insert(pairs, key, val, eq))
      else do
        fn expand(nd, ps) do
          match ps do
          Nil -> nd
          Cons(pair, rest) -> do
            let (ck, cv) = pair
            expand(node_insert(nd, ck, cv, ch, eq, level), rest)
          end
          end
        end
        expand(node_insert(HEmpty, key, val, h, eq, level), pairs) end
      end
    end
    HBranch(bitmap, children) -> do
      let slot = hash_slot(h, level)
      if bitmap_has(bitmap, slot) do
        let idx = bitmap_rank(bitmap, slot)
        let child = list_nth_safe(children, idx)
        let new_child = node_insert(child, key, val, h, eq, level + 1)
        HBranch(bitmap, list_replace_at(children, idx, new_child))
      else do
        let idx = bitmap_rank(bitmap, slot)
        HBranch(bitmap_set(bitmap, slot), list_insert_at(children, idx, HLeaf(h, key, val)))
      end end
    end
    end
  end

  pfn node_remove(node, key, h, eq, level) do
    match node do
    HEmpty -> HEmpty
    HLeaf(lh, lk, lv) -> do
      if lh == h do
        if eq(lk, key) do HEmpty else node end
      else node end
    end
    HCollision(ch, pairs) -> do
      if ch != h do node
      else do
        let new_pairs = coll_remove(pairs, key, eq)
        match new_pairs do
        Nil -> HEmpty
        Cons(sole, Nil) -> do
          let (ok, ov) = sole
          HLeaf(ch, ok, ov)
        end
        _ -> HCollision(ch, new_pairs)
        end end
      end
    end
    HBranch(bitmap, children) -> do
      let slot = hash_slot(h, level)
      if bitmap_has(bitmap, slot) do
        let idx = bitmap_rank(bitmap, slot)
        let child = list_nth_safe(children, idx)
        let new_child = node_remove(child, key, h, eq, level + 1)
        match new_child do
        HEmpty -> do
          let new_bm = bitmap_clear(bitmap, slot)
          let new_children = list_delete_at(children, idx)
          match new_children do
          Nil -> HEmpty
          Cons(sole, Nil) ->
            match sole do
            HLeaf(_, _, _) -> sole
            HCollision(_, _) -> sole
            _ -> HBranch(new_bm, new_children)
            end
          _ -> HBranch(new_bm, new_children)
          end
        end
        _ ->
          HBranch(bitmap, list_replace_at(children, idx, new_child))
        end
      else node end
    end
    end
  end

  -- Left fold over all (key, value) pairs.  f(acc, key, val) = new_acc
  pfn node_fold(acc, node, f) do
    match node do
    HEmpty -> acc
    HLeaf(_, k, v) -> f(acc, k, v)
    HCollision(_, pairs) -> do
      fn go(a, ps) do
        match ps do
        Nil -> a
        Cons(pair, rest) -> do
          let (k, v) = pair
          go(f(a, k, v), rest)
        end
        end
      end
      go(acc, pairs)
    end
    HBranch(_, children) -> do
      fn go(a, cs) do
        match cs do
        Nil -> a
        Cons(child, rest) ->
          go(node_fold(a, child, f), rest)
        end
      end
      go(acc, children)
    end
    end
  end

  pfn node_size(node) do
    match node do
    HEmpty -> 0
    HLeaf(_, _, _) -> 1
    HCollision(_, pairs) -> do
      fn count(ps, n) do
        match ps do
        Nil -> n
        Cons(_, rest) -> count(rest, n + 1)
        end
      end
      count(pairs, 0)
    end
    HBranch(_, children) -> do
      fn go(acc, cs) do
        match cs do
        Nil -> acc
        Cons(child, rest) -> go(acc + node_size(child), rest)
        end
      end
      go(0, children)
    end
    end
  end

  -- ── Public API ─────────────────────────────────────────────────────────────

  doc """
  Returns an empty map.

  ## Examples

      march> Map.is_empty(Map.empty())
      true
      march> Map.size(Map.empty())
      0

  This contract is ASSUMED, not proved: the set of keys is a fact about the
  abstract map (`keys`) the refinement checker takes on faith, and it holds
  only when `cmp` is a strict total order consistent with `==` on the key
  type. See docs/refinement-types.md, "Set Refinements".
  """
  @[assume]
  fn empty() : {Map(k, v) | keys(_) == empty} do
    HamtMap(HEmpty)
  end

  doc """
  Returns a map containing exactly one key-value pair.  Needs no comparator.

  ## Examples

      march> Map.to_list(Map.singleton("a", 1))
      [("a", 1)]

  This contract is ASSUMED, not proved: the set of keys is a fact about the
  abstract map (`keys`) the refinement checker takes on faith, and it holds
  only when `cmp` is a strict total order consistent with `==` on the key
  type. See docs/refinement-types.md, "Set Refinements".
  """
  @[assume]
  fn singleton(key : k, val : v) : {Map(k, v) | keys(_) == singleton(key)} do
    let h = key_hash(key)
    HamtMap(HLeaf(h, key, val))
  end

  -- ── Default comparators ───────────────────────────────────────────────────
  -- Convenience comparators for the common key types so callers don't have to
  -- write `fn a -> fn b -> a < b` at every Map.insert / Map.get / Map.from_list
  -- call site.

  doc """
  Curried less-than comparator for Int keys: `int_cmp(a)(b)` is `a < b`.
  Pass to Map.* functions.

  ## Examples

      march> let lt1 = Map.int_cmp(1)
      march> lt1(2)
      true
      march> let lt1 = Map.int_cmp(1)
      march> lt1(1)
      false
  """
  fn int_cmp(a) do fn b -> a < b end

  doc """
  Curried less-than comparator for String keys (lexicographic):
  `str_cmp(a)(b)` is `a < b`.  Pass to Map.* functions.

  ## Examples

      march> let lt_b = Map.str_cmp("b")
      march> lt_b("a")
      false
      march> let lt_b = Map.str_cmp("b")
      march> lt_b("c")
      true
  """
  fn str_cmp(a) do fn b -> a < b end

  doc """
  Build a `Map(String, v)` from a list of pairs using the default String
  comparator.  Equivalent to `Map.from_list(pairs, Map.str_cmp)`; later pairs
  overwrite earlier ones with the same key.

  ## Examples

      march> Map.get(Map.from_list_string([("a", 1), ("b", 2)]), "b", fn a -> fn b -> a < b)
      Some(2)
  """
  fn from_list_string(pairs) do
    from_list(pairs, str_cmp)
  end

  doc """
  Build a `Map(Int, v)` from a list of pairs using the default Int
  comparator.  Equivalent to `Map.from_list(pairs, Map.int_cmp)`; later pairs
  overwrite earlier ones with the same key.

  ## Examples

      march> Map.size(Map.from_list_int([(1, "a"), (2, "b")]))
      2
  """
  fn from_list_int(pairs) do
    from_list(pairs, int_cmp)
  end

  -- ---- Query ----

  doc """
  Returns true if the map contains no entries.  O(1).

  ## Examples

      march> Map.is_empty(Map.singleton(1, "a"))
      false
      march> Map.is_empty(Map.remove(Map.singleton(1, "a"), 1, fn a -> fn b -> a < b))
      true

  This contract is ASSUMED, not proved: the set of keys is a fact about the
  abstract map (`keys`) the refinement checker takes on faith, and it holds
  only when `cmp` is a strict total order consistent with `==` on the key
  type. See docs/refinement-types.md, "Set Refinements".
  """
  @[assume]
  fn is_empty(m) : {Bool | _ == (keys(m) == empty)} do
    match m do
    HamtMap(HEmpty) -> true
    _               -> false
    end
  end

  doc """
  Returns the number of key-value pairs in the map. O(n): the count is not
  cached, every call walks the trie.

  ## Examples

      march> Map.size(Map.from_list([(1, "a"), (2, "b"), (1, "c")], fn a -> fn b -> a < b))
      2

  This contract is ASSUMED, not proved: the pair count is a fact about the
  abstract map (`card(keys(m))`) the refinement checker takes on faith, and it
  holds only when `cmp` is a strict total order consistent with `==` on the
  key type. See docs/refinement-types.md, "Set Refinements".
  """
  @[assume]
  fn size(m) : {Int | _ == card(keys(m))} do
    match m do
    HamtMap(node) -> node_size(node)
    end
  end

  doc """
  Returns Some(value) if key is present, or None.
  cmp : k -> k -> Bool where cmp(a)(b) = true means a < b.

  ## Examples

      march> let m = Map.from_list([("a", 1), ("b", 2)], fn a -> fn b -> a < b)
      march> Map.get(m, "b", fn a -> fn b -> a < b)
      Some(2)
      march> let m = Map.from_list([("a", 1), ("b", 2)], fn a -> fn b -> a < b)
      march> Map.get(m, "z", fn a -> fn b -> a < b)
      None

  This contract is ASSUMED, not proved: the set of keys is a fact about the
  abstract map (`keys`) the refinement checker takes on faith, and it holds
  only when `cmp` is a strict total order consistent with `==` on the key
  type. See docs/refinement-types.md, "Set Refinements".
  """
  @[assume]
  fn get(m : Map(k, v), key : k, cmp : k -> k -> Bool) : {Option(v) | is_Some(_) == member(key, keys(m))} do
    match m do
    HamtMap(node) -> do
      let h = key_hash(key)
      let eq = fn (a, b) -> cmp_eq(cmp, a, b)
      node_get(node, key, h, eq, 0)
    end
    end
  end

  doc """
  Returns the value for key, or default if the key is absent.
  cmp : k -> k -> Bool where cmp(a)(b) = true means a < b.

  ## Examples

      march> Map.get_or(Map.singleton("a", 1), "a", 0, fn a -> fn b -> a < b)
      1
      march> Map.get_or(Map.singleton("a", 1), "z", 0, fn a -> fn b -> a < b)
      0
  """
  fn get_or(m : Map(k, v), key : k, default : v, cmp : k -> k -> Bool) : v do
    match get(m, key, cmp) do
    Some(v) -> v
    None    -> default
    end
  end

  doc """
  Returns true if key is present in the map.
  cmp : k -> k -> Bool where cmp(a)(b) = true means a < b.

  ## Examples

      march> Map.contains_key(Map.singleton(1, "a"), 1, fn a -> fn b -> a < b)
      true
      march> Map.contains_key(Map.empty(), 1, fn a -> fn b -> a < b)
      false

  This contract is ASSUMED, not proved: the set of keys is a fact about the
  abstract map (`keys`) the refinement checker takes on faith, and it holds
  only when `cmp` is a strict total order consistent with `==` on the key
  type. See docs/refinement-types.md, "Set Refinements".
  """
  @[assume]
  fn contains_key(m, key, cmp) : {Bool | _ == member(key, keys(m))} do
    match get(m, key, cmp) do
    Some(_) -> true
    None    -> false
    end
  end

  -- ---- Modification ----

  doc """
  Inserts or updates a key-value pair. Returns the new map.
  If the key is already present its value is replaced.
  cmp : k -> k -> Bool where cmp(a)(b) = true means a < b.

  ## Examples

      march> let m1 = Map.insert(Map.singleton("a", 1), "a", 5, fn a -> fn b -> a < b)
      march> Map.to_list(m1)
      [("a", 5)]
      march> let m1 = Map.insert(Map.singleton("a", 1), "a", 5, fn a -> fn b -> a < b)
      march> Map.size(Map.insert(m1, "b", 2, fn a -> fn b -> a < b))
      2

  This contract is ASSUMED, not proved: the set of keys is a fact about the
  abstract map (`keys`) the refinement checker takes on faith, and it holds
  only when `cmp` is a strict total order consistent with `==` on the key
  type. See docs/refinement-types.md, "Set Refinements".
  """
  @[assume]
  fn insert(m : Map(k, v), key : k, val : v, cmp : k -> k -> Bool) : {Map(k, v) | keys(_) == union(keys(m), singleton(key))} do
    match m do
    HamtMap(node) -> do
      let h = key_hash(key)
      let eq = fn (a, b) -> cmp_eq(cmp, a, b)
      HamtMap(node_insert(node, key, val, h, eq, 0))
    end
    end
  end

  doc """
  Removes a key from the map. Returns the map unchanged if the key is absent.
  cmp : k -> k -> Bool where cmp(a)(b) = true means a < b.

  ## Examples

      march> let m2 = Map.from_list([(1, "a"), (2, "b")], fn a -> fn b -> a < b)
      march> Map.to_list(Map.remove(m2, 1, fn a -> fn b -> a < b))
      [(2, "b")]
      march> let m2 = Map.from_list([(1, "a"), (2, "b")], fn a -> fn b -> a < b)
      march> Map.size(Map.remove(m2, 9, fn a -> fn b -> a < b))
      2

  This contract is ASSUMED, not proved: the set of keys is a fact about the
  abstract map (`keys`) the refinement checker takes on faith, and it holds
  only when `cmp` is a strict total order consistent with `==` on the key
  type. See docs/refinement-types.md, "Set Refinements".
  """
  @[assume]
  fn remove(m : Map(k, v), key : k, cmp : k -> k -> Bool) : {Map(k, v) | keys(_) == diff(keys(m), singleton(key))} do
    match m do
    HamtMap(node) -> do
      let h = key_hash(key)
      let eq = fn (a, b) -> cmp_eq(cmp, a, b)
      HamtMap(node_remove(node, key, h, eq, 0))
    end
    end
  end

  -- ---- Traversal ----

  doc """
  Left fold over all entries.  Argument order: collection first, init
  second, callback last (uncurried-collection convention).
  The callback `f` is called uncurried as `f(acc, key, val) = new_acc`.
  Entries are visited in hash-traversal order, so `f` should not depend on
  the order. Generic in the accumulator `b`, so a refinement demanded of the
  result is checked as an invariant of `acc` (see docs/refinement-types.md,
  "Folds").

  ## Examples

      march> Map.fold(Map.from_list([(1, 10), (2, 20)], fn a -> fn b -> a < b), 0, fn (acc, k, v) -> acc + k + v)
      33
      march> Map.fold(Map.empty(), 7, fn (acc, k, v) -> acc + k + v)
      7
  """
  fn fold(m : Map(k, v), acc : b, f : b -> k -> v -> b) : b do
    match m do
    HamtMap(node) -> node_fold(acc, node, f)
    end
  end

  doc """
  Returns all keys as a list (hash-traversal order, not sorted).

  ## Examples

      march> List.sort_by(Map.keys(Map.from_list([("b", 2), ("a", 1)], fn a -> fn b -> a < b)), fn (x, y) -> x < y)
      ["a", "b"]

  This contract is ASSUMED, not proved: the set of keys is a fact about the
  abstract map (`keys`) the refinement checker takes on faith, and it holds
  only when `cmp` is a strict total order consistent with `==` on the key
  type. See docs/refinement-types.md, "Set Refinements".
  """
  @[assume]
  fn keys(m : Map(k, v)) : {List(k) | elts(_) == keys(m)} do
    let pairs = fold(m, Nil, fn (acc, k, _v) -> Cons(k, acc))
    lst_rev(pairs)
  end

  doc """
  Returns all values as a list (hash-traversal order, the same order as
  `keys`).

  ## Examples

      march> List.sort_by(Map.values(Map.from_list([("b", 2), ("a", 1)], fn a -> fn b -> a < b)), fn (x, y) -> x < y)
      [1, 2]
  """
  fn values(m : Map(k, v)) : List(v) do
    let vals = fold(m, Nil, fn (acc, _k, v) -> Cons(v, acc))
    lst_rev(vals)
  end

  doc """
  Returns all (key, value) pairs as a list (hash-traversal order).  Same as
  `to_list`.

  ## Examples

      march> List.sort_by(Map.entries(Map.from_list([("b", 2), ("a", 1)], fn a -> fn b -> a < b)), fn (x, y) -> x < y)
      [("a", 1), ("b", 2)]
  """
  fn entries(m) do
    let es = fold(m, Nil, fn (acc, k, v) -> Cons((k, v), acc))
    lst_rev(es)
  end

  -- ---- Conversion ----

  doc """
  Builds a map from a list of (key, value) pairs.
  Later entries overwrite earlier ones for duplicate keys.
  cmp : k -> k -> Bool where cmp(a)(b) = true means a < b.

  ## Examples

      march> let m3 = Map.from_list([(1, "a"), (2, "b"), (1, "c")], fn a -> fn b -> a < b)
      march> Map.get(m3, 1, fn a -> fn b -> a < b)
      Some("c")
      march> Map.is_empty(Map.from_list([], fn a -> fn b -> a < b))
      true
  """
  fn from_list(pairs, cmp) do
    fn go(lst, acc) do
      match lst do
      Nil -> acc
      Cons(pair, rest) -> do
        let (k, v) = pair
        go(rest, insert(acc, k, v, cmp))
      end
      end
    end
    go(pairs, empty())
  end

  doc """
  Converts a map to a list of (key, value) pairs (hash-traversal order, not
  sorted; sort the result if order matters).

  ## Examples

      march> Map.to_list(Map.empty())
      []
      march> List.sort_by(Map.to_list(Map.from_list([(2, "b"), (1, "a")], fn a -> fn b -> a < b)), fn (x, y) -> x < y)
      [(1, "a"), (2, "b")]
  """
  fn to_list(m) do
    entries(m)
  end

  -- ---- Transformation ----

  doc """
  Applies f to each value, returning a new map with the same keys.  `f`
  takes the value only (not the key).  Needs no comparator.

  ## Examples

      march> Map.to_list(Map.map_values(Map.singleton("a", 2), fn v -> v * 10))
      [("a", 20)]

  This contract is ASSUMED, not proved: the set of keys is a fact about the
  abstract map (`keys`) the refinement checker takes on faith, and it holds
  only when `cmp` is a strict total order consistent with `==` on the key
  type. See docs/refinement-types.md, "Set Refinements".
  """
  @[assume]
  fn map_values(m : Map(k, v), f : v -> w) : {Map(k, w) | keys(_) == keys(m)} do
    fn go(node) do
      match node do
      HEmpty -> HEmpty
      HLeaf(h, k, v) -> HLeaf(h, k, f(v))
      HBranch(bm, children) -> do
        fn map_cs(cs) do
          fn go_cs(lst, acc) do
            match lst do
            Nil -> lst_rev(acc)
            Cons(c, rest) -> go_cs(rest, Cons(go(c), acc))
            end
          end
          go_cs(cs, Nil)
        end
        HBranch(bm, map_cs(children))
      end
      HCollision(h, pairs) -> do
        fn map_ps(ps) do
          fn go_ps(lst, acc) do
            match lst do
            Nil -> lst_rev(acc)
            Cons(pair, rest) -> do
              let (k, v) = pair
              go_ps(rest, Cons((k, f(v)), acc))
            end
            end
          end
          go_ps(ps, Nil)
        end
        HCollision(h, map_ps(pairs))
      end
      end
    end
    match m do
    HamtMap(node) -> HamtMap(go(node))
    end
  end

  doc """
  Returns a map containing only entries where pred(key)(value) is true.
  cmp : k -> k -> Bool where cmp(a)(b) = true means a < b.
  pred : k -> v -> Bool (curried).  Rebuilds the map by re-inserting the
  kept entries, O(n log n).

  ## Examples

      march> let m4 = Map.from_list([(1, 10), (2, 20), (3, 30)], fn a -> fn b -> a < b)
      march> List.sort_by(Map.keys(Map.filter(m4, fn k -> fn v -> v > 15, fn a -> fn b -> a < b)), fn (x, y) -> x < y)
      [2, 3]

  This contract is ASSUMED, not proved: the set of keys is a fact about the
  abstract map (`keys`) the refinement checker takes on faith, and it holds
  only when `cmp` is a strict total order consistent with `==` on the key
  type. See docs/refinement-types.md, "Set Refinements". The checker also
  assumes that every entry satisfies `pred`: a caller demanding
  `Map(String, {Int | _ > 0})` of `Map.filter(m, fn _k -> fn v -> v > 0, cmp)`
  gets it (an abstract refinement of two arguments, `k -> v -> Bool[p]`).
  """
  @[assume]
  fn filter(m : Map(k, v), pred : k -> v -> Bool[p], cmp : k -> k -> Bool) : {Map(k[p], v[p]) | subset(keys(_), keys(m))} do
    fn go(lst, acc) do
      match lst do
      Nil -> acc
      Cons(pair, rest) -> do
        let (k, v) = pair
        let p = pred(k)
        if p(v) do go(rest, insert(acc, k, v, cmp))
        else go(rest, acc) end
      end
      end
    end
    go(entries(m), empty())
  end

  doc """
  Merges two maps. When a key appears in both maps, the value from b takes
  precedence. O(n log n) in the size of b.
  cmp : k -> k -> Bool where cmp(a)(b) = true means a < b.

  ## Examples

      march> let ma = Map.from_list([(1, "a"), (2, "b")], fn a -> fn b -> a < b)
      march> let mb = Map.from_list([(2, "B"), (3, "C")], fn a -> fn b -> a < b)
      march> List.sort_by(Map.to_list(Map.merge(ma, mb, fn a -> fn b -> a < b)), fn (x, y) -> x < y)
      [(1, "a"), (2, "B"), (3, "C")]

  This contract is ASSUMED, not proved: the set of keys is a fact about the
  abstract map (`keys`) the refinement checker takes on faith, and it holds
  only when `cmp` is a strict total order consistent with `==` on the key
  type. See docs/refinement-types.md, "Set Refinements".
  """
  @[assume]
  fn merge(a : Map(k, v), b : Map(k, v), cmp : k -> k -> Bool) : {Map(k, v) | keys(_) == union(keys(a), keys(b))} do
    fn go(lst, acc) do
      match lst do
      Nil -> acc
      Cons(pair, rest) -> do
        let (k, v) = pair
        go(rest, insert(acc, k, v, cmp))
      end
      end
    end
    go(entries(b), a)
  end

  doc """
  Merges two maps with a combining function for conflicting keys.
  merge_with(a, b, f, cmp): when key exists in both, value: f(val_a)(val_b).
  Keys present in only one map keep their value.
  cmp : k -> k -> Bool; f : v -> v -> v (curried).  O(n log n) in the size
  of b.

  ## Examples

      march> let ca = Map.from_list([("x", 1), ("y", 2)], fn a -> fn b -> a < b)
      march> let cb = Map.from_list([("y", 10), ("z", 5)], fn a -> fn b -> a < b)
      march> List.sort_by(Map.to_list(Map.merge_with(ca, cb, fn x -> fn y -> x + y, fn a -> fn b -> a < b)), fn (p, q) -> p < q)
      [("x", 1), ("y", 12), ("z", 5)]
  """
  fn merge_with(a, b, f, cmp) do
    fn go(lst, acc) do
      match lst do
      Nil -> acc
      Cons(pair, rest) -> do
        let (k, v) = pair
        let new_val =
          match get(acc, k, cmp) do
          None    -> v
          Some(existing) -> do
            let combine = f(existing)
            combine(v)
          end
          end
        go(rest, insert(acc, k, new_val, cmp))
      end
      end
    end
    go(entries(b), a)
  end

end
