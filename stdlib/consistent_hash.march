-- ConsistentHash: consistent hashing ring for distributed load balancing.
--
-- Virtual nodes (replicas) are distributed evenly across the hash ring.
-- Each physical node `n` gets `replicas` virtual nodes inserted at
-- SHA-256(name ++ "#" ++ i) for i in 0..replicas-1.
--
-- Lookup: hash the key, walk the sorted ring to find the first virtual node
-- whose position >= the key's hash; wrap around to the first node if none.
--
-- The internal ring is a sorted List((Hash, node)) — O(replicas) per add/remove,
-- O(replicas) per lookup. Suitable for small-to-medium cluster sizes.
-- (More precisely: add/remove/get are linear in the total number of virtual
-- nodes on the ring, nodes * replicas, since the ring is a plain list.)
--
-- doc: try

mod ConsistentHash do

  -- (sorted_ring, name_map, replicas)
  -- sorted_ring: List((hash_str, node)) sorted by hash string
  -- name_map: Map(String, a) name -> node (for removal)
  -- replicas: virtual nodes per physical node
  ptype HashRing(a) = HashRing(List((String, a)), Map(String, a), Int)

  doc """
  An empty ring that will place `replicas` virtual nodes per physical node.
  More replicas spread keys more evenly at the cost of a longer ring.
  `replicas` of 0 or less makes `add` register the name without putting any
  virtual node on the ring, so `get` keeps returning `None`.

  ## Examples

      march> ConsistentHash.is_empty(ConsistentHash.new(3))
      true
      march> ConsistentHash.size(ConsistentHash.new(3))
      0
  """
  fn new(replicas : Int) : HashRing(a) do
    HashRing(Nil, Map.empty(), replicas)
  end

  doc """
  Add physical node `node` under `name`, inserting `replicas` virtual nodes at
  `Crypto.sha256(name ++ "#" ++ i)` for i in 0..replicas-1. Adding a name that
  is already present replaces its entry in the name map but inserts a second
  set of virtual nodes, which still point at the old value; `remove` the name
  first to replace a node cleanly.

  ## Examples

      march> ConsistentHash.size(ConsistentHash.add(ConsistentHash.add(ConsistentHash.new(3), "n1", 1), "n2", 2))
      2
  """
  fn add(ring : HashRing(a), name : String, node : a) : HashRing(a) do
    match ring do
    HashRing(lst, nodes, replicas) ->
      let new_nodes = Map.insert(nodes, name, node, Map.str_cmp)
      let new_lst = add_replicas(lst, name, node, replicas, 0)
      HashRing(new_lst, new_nodes, replicas)
    end
  end

  pfn add_replicas(lst : List((String, a)), name : String, node : a, replicas : Int, i : Int) : List((String, a)) do
    if i >= replicas do lst
    else
      let h = Crypto.sha256(name ++ "#" ++ int_to_string(i))
      add_replicas(ring_insert(lst, h, node), name, node, replicas, i + 1)
    end
  end

  pfn ring_insert(lst : List((String, a)), h : String, node : a) : List((String, a)) do
    match lst do
    Nil -> Cons((h, node), Nil)
    Cons((hd, nd), rest) ->
      if h < hd do Cons((h, node), lst)
      else Cons((hd, nd), ring_insert(rest, h, node))
      end
    end
  end

  doc """
  Remove the node registered under `name` and all its virtual nodes. Removing
  an unknown name returns an equivalent ring.

      let ring = ConsistentHash.add(ConsistentHash.new(3), "n1", 1)
      ConsistentHash.size(ConsistentHash.remove(ring, "n1"))   -- 0
  """
  fn remove(ring : HashRing(a), name : String) : HashRing(a) do
    match ring do
    HashRing(lst, nodes, replicas) ->
      let hashes = List.map(List.range(0, replicas), fn i ->
        Crypto.sha256(name ++ "#" ++ int_to_string(i)))
      let new_lst = List.filter(lst, fn pair ->
        let (h, _) = pair
        not(List.any(hashes, fn hr -> hr == h)))
      let new_nodes = Map.remove(nodes, name, Map.str_cmp)
      HashRing(new_lst, new_nodes, replicas)
    end
  end

  doc """
  The node responsible for `key`: the first virtual node whose position (hex
  SHA-256 string, compared lexicographically) is >= `Crypto.sha256(key)`.
  Returns `None` only when the ring has no virtual nodes. With a single
  physical node every key maps to it.

  ## Examples

      march> ConsistentHash.get(ConsistentHash.new(3), "user:42")
      None
      march> ConsistentHash.get(ConsistentHash.add(ConsistentHash.new(3), "n1", "node-1"), "user:42")
      Some("node-1")
  """
  fn get(ring : HashRing(a), key : String) : Option(a) do
    match ring do
    HashRing(lst, _, _) ->
      let h = Crypto.sha256(key)
      successor(lst, h)
    end
  end

  pfn successor(lst : List((String, a)), target : String) : Option(a) do
    match lst do
    Nil -> None
    Cons((h, nd), rest) ->
      if h >= target do Some(nd)
      else
        match successor(rest, target) do
        Some(x) -> Some(x)
        None    -> Some(nd)  -- wrap around: first element
        end
      end
    end
  end

  doc """
  All physical node values, one per registered name, in the name map's
  hash-traversal order (not ring order and not insertion order).

  ## Examples

      march> ConsistentHash.nodes(ConsistentHash.add(ConsistentHash.new(3), "n1", "node-1"))
      ["node-1"]
  """
  fn nodes(ring : HashRing(a)) : List(a) do
    match ring do
    HashRing(_, name_map, _) -> Map.values(name_map)
    end
  end

  doc """
  All registered node names, in the name map's hash-traversal order.

  ## Examples

      march> ConsistentHash.node_names(ConsistentHash.add(ConsistentHash.new(3), "n1", "node-1"))
      ["n1"]
  """
  fn node_names(ring : HashRing(a)) : List(String) do
    match ring do
    HashRing(_, name_map, _) -> Map.keys(name_map)
    end
  end

  doc """
  True when no physical node is registered.

  ## Examples

      march> ConsistentHash.is_empty(ConsistentHash.add(ConsistentHash.new(3), "n1", 1))
      false
  """
  fn is_empty(ring : HashRing(a)) : Bool do
    match ring do
    HashRing(_, name_map, _) -> Map.is_empty(name_map)
    end
  end

  doc """
  Number of registered physical nodes (names), not virtual nodes.

  ## Examples

      march> ConsistentHash.size(ConsistentHash.add(ConsistentHash.new(8), "n1", 1))
      1
  """
  fn size(ring : HashRing(a)) : Int do
    match ring do
    HashRing(_, name_map, _) -> Map.size(name_map)
    end
  end

end
