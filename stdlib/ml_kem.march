-- MlKem: ML-KEM-768 key encapsulation (FIPS 203), the NIST post-quantum KEM.
--
-- Two parties agree on a 32-byte shared secret: the receiver publishes an
-- encapsulation (public) key, the sender encapsulates against it and sends the
-- ciphertext, and the receiver decapsulates the ciphertext with its secret
-- key. Use the secret as input keying material (HKDF), and combine it with a
-- classical exchange (X25519) where you need a hybrid.
--
-- Backed by the vendored mlkem-native (runtime/pqc.c, runtime/third_party/),
-- portable C, the same code on the compiled and interpreted backends. The
-- builtins are deterministic: this module draws the randomness from
-- Crypto.random_bytes, and the *_from_seed / encapsulate_with_coins variants
-- take it explicitly (for test vectors).
mod MlKem do
  needs IO.Random

  type KeyPair = { public_key : Bytes, secret_key : Bytes }

  doc "Encapsulation (public) key size in bytes: 1184."
  fn public_key_bytes() : Int do 1184 end

  doc "Decapsulation (secret) key size in bytes: 2400."
  fn secret_key_bytes() : Int do 2400 end

  doc "Ciphertext size in bytes: 1088."
  fn ciphertext_bytes() : Int do 1088 end

  doc "Shared-secret size in bytes: 32."
  fn shared_secret_bytes() : Int do 32 end

  pfn len_err(what : String, want : Int, got : Bytes) : String do
    "MlKem: " ++ what ++ " must be " ++ int_to_string(want) ++ " bytes, got "
      ++ int_to_string(Bytes.length(got))
  end

  doc """
  The key pair a 64-byte seed (d || z, FIPS 203 ML-KEM.KeyGen_internal)
  determines. Err for a seed of any other length.
  """
  fn keypair_from_seed(seed : Bytes) : Result(KeyPair, String) do
    let sk = mlkem768_keypair(seed)
    if Bytes.is_empty(sk) do Err(len_err("a key seed", 64, seed))
    else Ok({ public_key: Bytes.slice(sk, 1152, 1184), secret_key: sk })
    end
  end

  doc """
  A fresh key pair from 64 random bytes.

      let kp = MlKem.keypair()
      -- kp.public_key: 1184 bytes, kp.secret_key: 2400 bytes
  """
  fn keypair() : KeyPair do
    match keypair_from_seed(Crypto.random_bytes(64)) do
      Ok(kp) -> kp
      Err(e) -> panic(e)
    end
  end

  doc """
  Encapsulate against [public_key] with explicit 32-byte [coins]:
  Ok((ciphertext, shared_secret)). Err for a wrong-length argument or a public
  key that fails FIPS 203's modulus check. Prefer `encapsulate/1`; reusing
  coins reuses the secret.
  """
  fn encapsulate_with_coins(public_key : Bytes, coins : Bytes) : Result((Bytes, Bytes), String) do
    if Bytes.length(public_key) != 1184 do Err(len_err("a public key", 1184, public_key))
    else if Bytes.length(coins) != 32 do Err(len_err("coins", 32, coins))
    else
      let out = mlkem768_encaps(public_key, coins)
      if Bytes.is_empty(out) do Err("MlKem: invalid public key")
      else Ok((Bytes.slice(out, 0, 1088), Bytes.slice(out, 1088, 32)))
      end
    end end
  end

  doc """
  Encapsulate a fresh shared secret against [public_key]:
  Ok((ciphertext, shared_secret)). Send the ciphertext; keep the secret.

      match MlKem.encapsulate(peer_public_key) do
        Ok((ct, secret)) -> ...
        Err(e) -> ...
      end
  """
  fn encapsulate(public_key : Bytes) : Result((Bytes, Bytes), String) do
    encapsulate_with_coins(public_key, Crypto.random_bytes(32))
  end

  doc """
  The shared secret a [ciphertext] carries, recovered with [secret_key]. Err
  for a wrong-length argument or a corrupted secret key. A ciphertext made for
  a different key, or tampered with, is NOT an error: ML-KEM's implicit
  rejection returns an unrelated pseudorandom secret, so the parties' keys
  simply disagree (authenticate what you derive from it).
  """
  fn decapsulate(secret_key : Bytes, ciphertext : Bytes) : Result(Bytes, String) do
    if Bytes.length(secret_key) != 2400 do Err(len_err("a secret key", 2400, secret_key))
    else if Bytes.length(ciphertext) != 1088 do Err(len_err("a ciphertext", 1088, ciphertext))
    else
      let ss = mlkem768_decaps(secret_key, ciphertext)
      if Bytes.is_empty(ss) do Err("MlKem: invalid secret key")
      else Ok(ss)
      end
    end end
  end

end
