-- Bytes module: raw byte manipulation.
--
-- Bytes wraps a String, which in the runtime is an array-backed buffer:
-- `march_string` is {rc, tag, pad, len, data[]} — one allocation, an explicit
-- length field, and a contiguous NUL-safe payload.  Nothing here treats a
-- String as text: `string_byte_at`, `string_slice`, `string_chars` and
-- `char_from_int` are all byte-indexed in both backends.
--
-- This replaced `Bytes(List(Int))`, which cost one ~32-byte cons cell per
-- byte and made `length` O(n), `get` O(i) and `slice` O(start+len).  Measured
-- on a 64 000-byte payload (interpreted): `length` 544 ms/call, `get(last)`
-- 1063 ms, `slice` 1057 ms.  See specs/plans/2026-08-10-array-backed-bytes-design.md.
--
-- The wrapper constructor is deliberately kept (a Bytes value is still a
-- one-field boxed ADT cell with its payload at offset 16), because
-- lib/tir/repr.ml, llvm_case.ml and drop.ml all encode assumptions about that
-- shape, and because the C runtime builds these cells by hand.
--
-- to_list/from_list were O(1) under the old representation and are O(n) now.
-- That is the one regression; see the design doc's audit of the callers.
--
-- This module is self-contained: it does not depend on List.* or String.*
-- being loaded, so it can be tested or used in isolation.
--
-- doc: try

mod Bytes do

  type Bytes = Bytes(String)

  -- ---- Internal helpers (self-contained) ----

  pfn rev(xs, acc) do
    match xs do
    Nil -> acc
    Cons(h, t) -> rev(t, Cons(h, acc))
    end
  end

  pfn join_strings(xs) do
    -- O(total) single-pass join. The old `acc ++ s` left-fold was O(n^2)
    -- (each ++ copies the whole accumulated string).
    string_join(xs, "")
  end

  -- ---- Construction ----

  pfn from_list_go(xs, acc) do
    match xs do
    Nil -> rev(acc, Nil)
    Cons(n, rest) -> from_list_go(rest, Cons(byte_to_char(n), acc))
    end
  end

  doc """
  Wrap a List(Int) of byte values (0-255) as Bytes. O(n).
  Values outside 0-255 are not supported: the native backends keep only
  the low 8 bits, while the in-browser REPL raises an error.

  ## Examples

      march> Bytes.to_list(Bytes.from_list([72, 105, 0, 255]))
      [72, 105, 0, 255]
      march> Bytes.to_string(Bytes.from_list([72, 105]))
      "Hi"
  """
  fn from_list(xs) do
    Bytes(string_from_chars(from_list_go(xs, Nil)))
  end

  pfn to_list_go(s, i, acc) do
    if i < 0 do acc
    else to_list_go(s, i - 1, Cons(string_byte_at(s, i), acc))
    end
  end

  doc """
  Unwrap Bytes to a List(Int) of byte values (each 0-255). O(n).

  ## Examples

      march> Bytes.to_list(Bytes.from_string("hé"))
      [104, 195, 169]
      march> Bytes.to_list(Bytes.empty())
      []
  """
  fn to_list(b) do
    match b do
    Bytes(s) -> to_list_go(s, string_byte_length(s) - 1, Nil)
    end
  end

  doc """
  An empty Bytes value.

  ## Examples

      march> Bytes.length(Bytes.empty())
      0
  """
  fn empty() do Bytes("") end

  doc """
  Convert a String to Bytes (its raw UTF-8 byte values, each 0-255). O(1).

  ## Examples

      march> Bytes.length(Bytes.from_string("héllo"))
      6
  """
  fn from_string(s) do Bytes(s) end

  doc """
  Convert Bytes back to a String (bytes interpreted as UTF-8, not
  validated). O(1).

  ## Examples

      march> Bytes.to_string(Bytes.from_list([109, 97, 114, 99, 104]))
      "march"
  """
  fn to_string(b) do
    match b do
    Bytes(s) -> s
    end
  end

  -- ---- Measurement ----

  doc """
  Number of bytes (not characters). O(1).

  ## Examples

      march> Bytes.length(Bytes.from_list([1, 2, 3]))
      3
      march> Bytes.length(Bytes.from_string("é"))
      2
  """
  fn length(b) do
    match b do
    Bytes(s) -> string_byte_length(s)
    end
  end

  doc """
  True if the Bytes is empty. O(1).

  ## Examples

      march> Bytes.is_empty(Bytes.empty())
      true
      march> Bytes.is_empty(Bytes.from_list([0]))
      false
  """
  fn is_empty(b) do
    match b do
    Bytes(s) -> string_is_empty(s)
    end
  end

  -- ---- Access ----

  doc """
  Byte at position i (0-based), as an Int 0-255. Panics if i is negative
  or >= `length(b)`. O(1).

  ## Examples

      march> Bytes.get(Bytes.from_string("abc"), 1)
      98
  """
  fn get(b, i) do
    match b do
    Bytes(s) -> do
      -- string_byte_at returns -1 out of range (it is built for scanners that
      -- want end-of-input to fall out of the same comparison as any other
      -- terminator).  Bytes.get's contract is to panic, so re-impose it here.
      let v = string_byte_at(s, i)
      if v < 0 do panic("Bytes.get: index out of bounds") else v end
    end
    end
  end

  doc """
  Sub-slice: `len` bytes starting at position `start`. Out-of-range
  arguments are clamped rather than panicking: a negative `start` is
  treated as 0, a slice running past the end is cut short, and a `start`
  at or past the end gives empty Bytes. O(len).

  ## Examples

      march> Bytes.to_string(Bytes.slice(Bytes.from_string("hello world"), 6, 5))
      "world"
      march> Bytes.to_string(Bytes.slice(Bytes.from_string("hello"), 3, 10))
      "lo"
      march> Bytes.is_empty(Bytes.slice(Bytes.from_string("hello"), 9, 2))
      true
  """
  fn slice(b, start, len) do
    match b do
    -- string_slice clamps start and len to the buffer, which is the same
    -- out-of-range behaviour list_drop/list_take gave.
    Bytes(s) -> Bytes(string_slice(s, start, len))
    end
  end

  -- ---- Combination ----

  doc """
  Concatenate two Bytes values. O(n).

  ## Examples

      march> Bytes.to_list(Bytes.concat(Bytes.from_list([1, 2]), Bytes.from_list([3])))
      [1, 2, 3]
  """
  fn concat(b1, b2) do
    match (b1, b2) do
    (Bytes(x), Bytes(y)) -> Bytes(string_concat(x, y))
    end
  end

  -- ---- NativeU8Arr bridge ----

  doc """
  Copy [b]'s bytes into a fresh NativeU8Arr for SIMD/numeric work. O(n) copy: the layouts cannot be shared.

  ## Examples

      march> Bytes.to_list(Bytes.from_u8_arr(Bytes.to_u8_arr(Bytes.from_list([1, 2, 3]))))
      [1, 2, 3]
  """
  fn to_u8_arr(b) do bytes_to_u8_arr(b) end

  doc """
  Copy [a]'s bytes into a fresh immutable Bytes. O(n) copy.

  ## Examples

      march> Bytes.length(Bytes.from_u8_arr(Bytes.to_u8_arr(Bytes.from_string("abcd"))))
      4
  """
  fn from_u8_arr(a) do u8_arr_to_bytes(a) end

  -- ---- UTF-8 encoding ----

  doc """
  Encode a String as UTF-8 bytes. Equivalent to `from_string` for March strings.

  ## Examples

      march> Bytes.to_list(Bytes.encode_utf8("ü"))
      [195, 188]
  """
  fn encode_utf8(s) do from_string(s) end

  doc """
  Decode UTF-8 bytes to a String. Always returns `Ok(s)` (same as
  `to_string`): the bytes are not validated, so invalid UTF-8 is not
  reported as an error.

  ## Examples

      march> Bytes.decode_utf8(Bytes.from_list([104, 105]))
      Ok("hi")
  """
  fn decode_utf8(b) do Ok(to_string(b)) end

  -- ---- Hex encoding ----

  pfn hex_digit(n) do
    if n < 10 do int_to_string(n)
    else char_from_int(87 + n)  -- 87 = ord('a') - 10, returns String directly
    end
  end

  pfn byte_to_hex_str(n) do
    hex_digit(n / 16) ++ hex_digit(n % 16)
  end

  pfn to_hex_go(s, i, acc) do
    if i < 0 do acc
    else to_hex_go(s, i - 1, Cons(byte_to_hex_str(string_byte_at(s, i)), acc))
    end
  end

  doc """
  Encode Bytes as a lowercase hexadecimal string, two digits per byte.

  ## Examples

      march> Bytes.to_hex(Bytes.from_list([0, 15, 171, 255]))
      "000fabff"
      march> Bytes.to_hex(Bytes.empty())
      ""
  """
  fn to_hex(b) do
    match b do
    Bytes(s) -> join_strings(to_hex_go(s, string_byte_length(s) - 1, Nil))
    end
  end

  pfn hex_val(code) do
    if code >= 48 && code <= 57 do code - 48        -- '0'–'9'
    else if code >= 65 && code <= 70 do code - 55   -- 'A'–'F'
    else if code >= 97 && code <= 102 do code - 87  -- 'a'–'f'
    else -1 end end end
  end

  pfn from_hex_go(s, i, n, acc) do
    if i >= n do Ok(Bytes(string_from_chars(rev(acc, Nil))))
    else do
      let hi = hex_val(string_byte_at(s, i))
      let lo = hex_val(string_byte_at(s, i + 1))
      if hi < 0 || lo < 0 do Err("invalid hex character")
      else from_hex_go(s, i + 2, n, Cons(byte_to_char(hi * 16 + lo), acc)) end
    end
    end
  end

  doc """
  Parse a hex string (upper- or lowercase digits, no `0x` prefix or
  separators) to Bytes. Returns `Err("hex string must have even length")`
  for an odd-length input and `Err("invalid hex character")` for any
  non-hex character.

  ## Examples

      march> Result.map(Bytes.from_hex("00ffAb"), Bytes.to_list)
      Ok([0, 255, 171])
      march> Bytes.from_hex("abc")
      Err("hex string must have even length")
      march> Bytes.from_hex("zz")
      Err("invalid hex character")
  """
  fn from_hex(s) do
    let n = string_byte_length(s)
    if n % 2 != 0 do Err("hex string must have even length")
    else from_hex_go(s, 0, n, Nil) end
  end

  -- ---- Base64 encoding ----

  let b64_alphabet = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"

  pfn b64_char(n) do
    string_slice(b64_alphabet, n, 1)
  end

  pfn encode_base64_go(s, i, n, acc) do
    if i + 3 <= n do do
      let b0 = string_byte_at(s, i)
      let b1 = string_byte_at(s, i + 1)
      let b2 = string_byte_at(s, i + 2)
      let c0 = b64_char(b0 / 4)
      let c1 = b64_char((b0 % 4) * 16 + b1 / 16)
      let c2 = b64_char((b1 % 16) * 4 + b2 / 64)
      let c3 = b64_char(b2 % 64)
      encode_base64_go(s, i + 3, n, Cons(c3, Cons(c2, Cons(c1, Cons(c0, acc)))))
    end
    else if i + 2 == n do do
      let b0 = string_byte_at(s, i)
      let b1 = string_byte_at(s, i + 1)
      let c0 = b64_char(b0 / 4)
      let c1 = b64_char((b0 % 4) * 16 + b1 / 16)
      let c2 = b64_char((b1 % 16) * 4)
      join_strings(rev(Cons("=", Cons(c2, Cons(c1, Cons(c0, acc)))), Nil))
    end
    else if i + 1 == n do do
      let b0 = string_byte_at(s, i)
      let c0 = b64_char(b0 / 4)
      let c1 = b64_char((b0 % 4) * 16)
      join_strings(rev(Cons("=", Cons("=", Cons(c1, Cons(c0, acc)))), Nil))
    end
    else join_strings(rev(acc, Nil))
    end end end
  end

  doc """
  Encode Bytes as a standard Base64 string (`+`, `/` alphabet, with `=` padding).

  ## Examples

      march> Bytes.encode_base64(Bytes.from_string("Man"))
      "TWFu"
      march> Bytes.encode_base64(Bytes.from_string("M"))
      "TQ=="
      march> Bytes.encode_base64(Bytes.empty())
      ""
  """
  fn encode_base64(b) do
    match b do
    Bytes(s) -> encode_base64_go(s, 0, string_byte_length(s), Nil)
    end
  end

  pfn b64_val(code) do
    if code >= 65 && code <= 90 do code - 65          -- A–Z → 0–25
    else if code >= 97 && code <= 122 do code - 71    -- a–z → 26–51
    else if code >= 48 && code <= 57 do code + 4      -- 0–9 → 52–61
    else if code == 43 do 62                          -- '+'
    else if code == 47 do 63                          -- '/'
    else -1 end end end end end
  end

  pfn decode_base64_go(s, i, n, acc) do
    if i >= n do Ok(Bytes(string_from_chars(rev(acc, Nil))))
    else do
      let c0 = string_byte_at(s, i)
      let c1 = string_byte_at(s, i + 1)
      let c2 = string_byte_at(s, i + 2)
      let c3 = string_byte_at(s, i + 3)
      let v0 = b64_val(c0)
      let v1 = b64_val(c1)
      if v0 < 0 || v1 < 0 do Err("invalid base64 character")
      else if c2 == 61 && c3 == 61 do
        Ok(Bytes(string_from_chars(rev(Cons(byte_to_char((v0 * 4 + v1 / 16) % 256), acc), Nil))))
      else if c3 == 61 do do
        let v2 = b64_val(c2)
        if v2 < 0 do Err("invalid base64 character")
        else do
          let byte0 = (v0 * 4 + v1 / 16) % 256
          let byte1 = ((v1 % 16) * 16 + v2 / 4) % 256
          Ok(Bytes(string_from_chars(rev(Cons(byte_to_char(byte1), Cons(byte_to_char(byte0), acc)), Nil))))
        end
        end
      end
      else do
        let v2 = b64_val(c2)
        let v3 = b64_val(c3)
        if v2 < 0 || v3 < 0 do Err("invalid base64 character")
        else do
          let byte0 = (v0 * 4 + v1 / 16) % 256
          let byte1 = ((v1 % 16) * 16 + v2 / 4) % 256
          let byte2 = ((v2 % 4) * 64 + v3) % 256
          decode_base64_go(s, i + 4, n,
            Cons(byte_to_char(byte2), Cons(byte_to_char(byte1), Cons(byte_to_char(byte0), acc))))
        end
        end
      end
      end end end
    end
    end
  end

  doc """
  Decode a padded standard Base64 string to Bytes. Returns `Err` if the
  length is not a multiple of 4 or a character is outside the Base64
  alphabet. Decoding stops at the first padded group, so anything after
  it is ignored.

  ## Examples

      march> Result.map(Bytes.decode_base64("TWE="), Bytes.to_string)
      Ok("Ma")
      march> Bytes.decode_base64("TWF")
      Err("invalid base64: length must be a multiple of 4")
      march> Bytes.decode_base64("T!Fu")
      Err("invalid base64 character")
  """
  fn decode_base64(s) do
    let n = string_byte_length(s)
    if n % 4 != 0 do Err("invalid base64: length must be a multiple of 4")
    else decode_base64_go(s, 0, n, Nil) end
  end

  impl Eq(Bytes) do
    fn eq(a, b) do Bytes.to_string(a) == Bytes.to_string(b) end
  end

end
