-- ClusterNode: one running cluster node -- it joins from seed addresses, runs
-- SWIM continuously over one persistent authenticated connection pair per
-- peer, and tells subscribers when a peer is suspected, dead or back.
--
-- Design: specs/progress/2026-09-18-cluster-node-service.md. The parts it
-- assembles were already here (Membership/Swim/SwimDriver, NetKernel's
-- handshake, PeerReader, NodeQueue); what was missing was a node that stays
-- up and uses them together.
--
-- Shape: a PURE core (`core_*`, `CnState -> ... -> (CnState, List(CnEffect))`,
-- unit-tested under the eval harness, which cannot run sockets) inside ONE
-- actor (`ClusterNodeActor`) that owns the state and performs the effects, plus a few
-- tasks around it:
--
--   acceptor   blocking tcp_accept loop; each connection is handshaked in its
--              own task (deadline-bounded) and reported as `Accepted`
--   dialer     one task per attempt: connect_timeout + handshake, control
--              then data, reported as `Dialed` / `DialFailed`
--   readers    one per connection (PeerReader.serve): control frames go to
--              the actor as `CtlFrame`; end of stream is `LinkClosed(id, gen)`
--   ticker     `Tick` every tick_ms; the SWIM period, the redial backoff and
--              the stale-dial expiry all run off it
--   CtlWriter  one per peer: EVERY write to a control socket goes through it
--              (two writers on one socket interleave frames)
--
-- Connections. One control + one data connection per peer, reused by
-- everything. Two nodes dialling each other at once each end up with two
-- pairs; both keep the pair dialled by the LOWER node_id (a symmetric rule,
-- no message needed). Each pair has a generation; a close from a replaced
-- generation is ignored. A closed connection is a HINT: the member goes
-- Suspect and is redialled at once; a redial REFUSED (nothing listening) is
-- definite and makes it Dead. When SWIM declares a node Dead the node shuts
-- both its connections. Healing: SWIM never probes a Dead member, so the
-- node redials every Dead member's advertised address on a backoff; when a
-- redial lands, MEMBERS_SYNC in both directions lets each side refute what
-- the other believed.
--
-- Names (the registry replica). The node holds a GlobalRegistry replica: a
-- local `register` is pushed at once to every linked peer (REGISTRY_SYNC_RESP
-- with the changed leaves), every new link exchanges the whole registry, and
-- a 30 s anti-entropy round (REGISTRY_SYNC_REQ with the root hash) repairs
-- what a push missed. A registration's clock is the name's current clock
-- with our slot bumped, so a takeover after seeing a binding is causally
-- newer and never falls to the tiebreak. `lookup` sees only VISIBLE
-- bindings: one whose holder is Dead here, or whose holder has restarted
-- since (a stale creation), is hidden -- not tombstoned; it reappears if the
-- holder rejoins with the same creation. The owner tombstones its own
-- stale-creation bindings when it learns of them. A global name is AP, not a
-- lock: during a partition both sides can hold one; after the heal the CRDT
-- picks one winner everywhere, and the loser's watchers get `Lost`.
--
-- Everything the node knows about members and names is also mirrored into
-- Vaults (`members`, `addr_of`, `lookup`), so readers need no round trip to
-- the actor.
--
-- The node is a capability: `start(io, cfg)` returns a `Cap(ClusterNode.Live)`
-- whose dictionary (`ClusterOps`) every public operation calls through, and a test
-- can `attach(io, ops)` its own (D35; see "the capability" below).
mod ClusterNode do
  needs IO
  needs IO.NetListen
  needs IO.NetConnect
  needs IO.Spawn
  needs IO.Mut
  needs IO.Clock
  needs IO.Process
  needs IO.Random

  -- ── configuration ───────────────────────────────────────────────────────

  -- `advertise` is the "host:port" peers dial; `seeds` are "host:port" too.
  -- `creation` must grow across restarts of the same node (the default is
  -- the start time in ms). Durations in ms.
  --
  -- `auth` is how the node authenticates peers: `ClusterAuth.Secret(secret)`
  -- (what `config` sets from [secret]) or `ClusterAuth.Certified(creds)`, a
  -- node certificate (`config_from_env` with MARCH_NODE_CERT, or a record
  -- update). `secret` is kept for code that reads it; the handshake uses
  -- `auth`.
  type CnConfig = { name : String, listen_port : Int, advertise : String, seeds : List(String),
                    secret : String, creation : Int, swim : Swim.Config, period_ms : Int,
                    tick_ms : Int, redial_min_ms : Int, redial_max_ms : Int,
                    dial_timeout_ms : Int, handshake_timeout_ms : Int, auth : ClusterAuth.Auth,
                    revocations : List(NodeCert.SignedRevocation) }

  doc """
  A configuration with the defaults: SWIM period 1 s, ack timeout 500 ms,
  suspect timeout 3 s, 2 indirect helpers, tick 100 ms, redial backoff
  200 ms doubling to 5 s, dial and handshake timeouts 2 s. [advertise] ""
  means `127.0.0.1:<listen_port>`. The SWIM timings trade detection speed
  for false suspicions on a loaded host (a 300 ms ack timeout suspected
  healthy peers on a busy CI runner); override `swim` / `period_ms` with a
  record update to tune them.
  """
  fn config(name : String, listen_port : Int, advertise : String, seeds : List(String),
            secret : String, creation : Int) : CnConfig do
    let adv = if String.is_empty(advertise) do "127.0.0.1:" ++ int_to_string(listen_port) else advertise end
    { name: name, listen_port: listen_port, advertise: adv, seeds: seeds, secret: secret,
      creation: creation, swim: Swim.config(500, 3000, 2), period_ms: 1000, tick_ms: 100,
      redial_min_ms: 200, redial_max_ms: 5000, dial_timeout_ms: 2000, handshake_timeout_ms: 2000,
      auth: ClusterAuth.Secret(secret), revocations: Nil }
  end

  pfn env_or(name : String, dflt : String) : String do
    match System.env(name) do
      Some(v) -> if String.is_empty(v) do dflt else v end
      None -> dflt
    end
  end

  -- An environment value, or -- when it names a readable file -- that
  -- file's contents (keys and certificates are usually mounted as files).
  pfn env_file(name : String) : String do
    let v = env_or(name, "")
    if String.is_empty(v) do ""
    else if File.exists(v) do
      match File.read(v) do
        Ok(text) -> String.trim(text)
        Err(_) -> v
      end
    else v end end
  end

  doc """
  Certificate credentials for node [name] from their text forms: the node's
  ed25519 secret key (hex, 64 bytes), its certificate (NodeCert text form)
  and the operator public key (hex, 32 bytes). The certificate must verify
  under the operator key now, name [name], and name the secret key's public
  key -- a misconfigured node fails here, with the reason, rather than at
  every handshake.
  """
  fn credentials(name : String, key_hex : String, cert_text : String, operator_hex : String)
      : Result(NodeCert.Credentials, String) do
    match (NodeCert.key_from_hex(key_hex, 64), NodeCert.from_text(cert_text),
           NodeCert.key_from_hex(operator_hex, 32)) do
      (Err(e), _, _) -> Err("cluster_node: MARCH_NODE_KEY: " ++ e)
      (_, Err(e), _) -> Err("cluster_node: MARCH_NODE_CERT: " ++ e)
      (_, _, Err(e)) -> Err("cluster_node: MARCH_CLUSTER_OPERATOR_PUBKEY: " ++ e)
      (Ok(sk), Ok(signed), Ok(op)) ->
        match NodeCert.verify(signed, op, unix_time_ms() / 1000) do
          Err(e) -> Err("cluster_node: this node's own certificate: " ++ e)
          Ok(c) ->
            if NodeCert.node_name(c.node) != name do
              Err("cluster_node: the certificate names " ++ c.node ++ ", but this node is " ++ name)
            else if c.pubkey != Bytes.to_hex(NodeCert.public_key(sk)) do
              Err("cluster_node: MARCH_NODE_KEY is not the key the certificate names")
            else
              Ok({ signed: signed, secret_key: sk, operator_pubkey: op, revoked: fn _ -> false })
            end end
        end
    end
  end

  doc """
  Revocation tokens (`forge cluster revoke`'s output) separated by
  whitespace or commas, each verified against the operator key.
  """
  fn revocations_from_text(text : String, operator_pubkey : Bytes) : Result(List(NodeCert.SignedRevocation), String) do
    let toks = List.filter(String.split(String.replace_all(String.replace_all(text, "\n", ","), " ", ","), ","),
                           fn t -> not(String.is_empty(String.trim(t))))
    List.fold_right(toks, Ok(Nil), fn (t, acc) ->
      match acc do
        Err(e) -> Err(e)
        Ok(rest) ->
          match NodeCert.revocation_from_text(t) do
            Err(e) -> Err(e)
            Ok(r) ->
              match NodeCert.verify_revocation(r, operator_pubkey) do
                Err(e) -> Err(e)
                Ok(_) -> Ok(Cons(r, rest))
              end
          end
      end)
  end

  doc """
  Configuration from the environment: MARCH_NODE_NAME, MARCH_NODE_PORT,
  MARCH_NODE_ADVERTISE (default 127.0.0.1:<port>), MARCH_CLUSTER_NODES
  (seeds, host:port,...), MARCH_CLUSTER_SECRET, MARCH_NODE_CREATION (default:
  the current time in ms, which grows across restarts on one host).

  Certificate mode: with MARCH_NODE_CERT set, the node authenticates with a
  certificate instead of the secret, and MARCH_NODE_KEY and
  MARCH_CLUSTER_OPERATOR_PUBKEY must be set too (each may name a file
  holding the value). MARCH_CLUSTER_SECRET is then ignored: both set means
  certificate mode. Without MARCH_NODE_CERT the node runs in shared-secret
  mode, as before (MARCH_NODE_KEY alone is an error, not a silent fallback).
  MARCH_CLUSTER_REVOCATIONS (certificate mode; tokens or a file of them)
  seeds the node's revocation list.
  """
  fn config_from_env() : Result(CnConfig, String) do
    match System.env("MARCH_NODE_NAME") do
      None -> Err("cluster_node: MARCH_NODE_NAME is not set")
      Some(name) ->
        match String.to_int(env_or("MARCH_NODE_PORT", "")) do
          Err(_) -> Err("cluster_node: MARCH_NODE_PORT is not a port number")
          Ok(port) ->
            let seeds = List.filter(List.map(String.split(env_or("MARCH_CLUSTER_NODES", ""), ","), String.trim),
                                    fn s -> not(String.is_empty(s)))
            let creation = match String.to_int(env_or("MARCH_NODE_CREATION", "")) do
              Ok(c) -> c
              Err(_) -> unix_time_ms()
            end
            let cfg = config(name, port, env_or("MARCH_NODE_ADVERTISE", ""), seeds,
                             env_or("MARCH_CLUSTER_SECRET", "march-cluster"), creation)
            let cert = env_file("MARCH_NODE_CERT")
            let key = env_file("MARCH_NODE_KEY")
            if String.is_empty(cert) do
              if String.is_empty(key) do Ok(cfg)
              else Err("cluster_node: MARCH_NODE_KEY is set but MARCH_NODE_CERT is not") end
            else
              match credentials(name, key, cert, env_file("MARCH_CLUSTER_OPERATOR_PUBKEY")) do
                Err(e) -> Err(e)
                Ok(creds) ->
                  match revocations_from_text(env_file("MARCH_CLUSTER_REVOCATIONS"), creds.operator_pubkey) do
                    Err(e) -> Err("cluster_node: MARCH_CLUSTER_REVOCATIONS: " ++ e)
                    Ok(revs) -> Ok({ cfg with auth: ClusterAuth.Certified(creds), revocations: revs })
                  end
              end
            end
        end
    end
  end

  -- A node's id: the hash of its public key (NodeIdentity.derive_id). Every
  -- caller in the stdlib still passes "pk-" ++ name for the key; real keys
  -- are an open question of the design.
  fn node_id_of(name : String) : String do NodeIdentity.name_id(name) end

  -- ── what subscribers see ────────────────────────────────────────────────

  type NodeInfo = { node_id : String, name : String, addr : String, creation : Int, incarnation : Int }

  type NodeEvent = NodeUp(NodeInfo) | NodeSuspect(NodeInfo) | NodeDead(NodeInfo, String) | NodeRejoined(NodeInfo)

  -- What `on_security_event` subscribers see:
  --   HandshakeRejected(who, why)  a peer's handshake refused: `who` is the
  --                                address we dialled, or "inbound"
  --   FrameRejected(node_id, n)    a frame from that peer failed its MAC and
  --                                was dropped; n is the count on that
  --                                connection (NetKernel.mac_failure_limit()
  --                                of them close it)
  type SecurityEvent = HandshakeRejected(String, String) | FrameRejected(String, Int)

  fn security_text(ev : SecurityEvent) : String do
    match ev do
      HandshakeRejected(who, why) -> "handshake with " ++ who ++ " rejected: " ++ why
      FrameRejected(id, n) -> "frame from " ++ id ++ " failed its MAC (" ++ int_to_string(n) ++ " on that connection)"
    end
  end

  fn info_of(m : Member) : NodeInfo do
    { node_id: m.node_id, name: m.name, addr: m.addr, creation: m.creation, incarnation: m.incarnation }
  end

  fn event_text(ev : NodeEvent) : String do
    match ev do
      NodeUp(i) -> i.name ++ " up"
      NodeSuspect(i) -> i.name ++ " suspect"
      NodeDead(i, why) -> i.name ++ " dead: " ++ why
      NodeRejoined(i) -> i.name ++ " rejoined"
    end
  end

  -- ── the pure core ───────────────────────────────────────────────────────

  -- One peer's connection pair. `dialer` is the node_id that opened it; `cw`
  -- is its control writer's pid (as an Int: opaque to the core); `creation`
  -- the peer's creation, from its hello.
  type CnLink = { node_id : String, gen : Int, cfd : Int, dfd : Int, dialer : String, cw : Int, creation : Int }

  -- A half-assembled inbound pair: the control and data connections of one
  -- peer arrive as two accepts, in either order (each is handshaked in its
  -- own task). -1 for the half not yet here.
  type CnHalf = { cfd : Int, dfd : Int, name : String, addr : String, creation : Int }

  type CnState = {
    cfg : CnConfig,
    me : String,
    driver : SwimDriver.State,
    links : Map(String, CnLink),
    halves : Map(String, CnHalf),
    gen : Int,
    dialing : Map(String, Int),          -- addr -> when an in-flight attempt is given up
    backoff : Map(String, (Int, Int)),   -- addr -> (next try at, current delay)
    pending : List(SwimDriver.Event),    -- folded into SWIM at the next tick
    relays : Map(String, List(String)),  -- ping-req target -> requesters awaiting its ack
    refused : List(String),              -- node_ids refused since the last tick
    seed_ids : Map(String, String),      -- dialled seed "host:port" -> the node it reached
    rejoining : List(String),            -- restarted nodes not yet seen Alive at their new creation
    stopped : Bool,
    reg : GlobalRegistry.Names,          -- the registry replica
    regs : Map(String, (Int, Int)),      -- names registered HERE: name -> (pid, watcher pid)
    vis : Map(String, GlobalPid.Pid),    -- the visible binding of every name, as last reported
    certs : Map(String, NodeCert.Cert),  -- each certificate-mode peer's verified certificate
    revs : List(NodeCert.SignedRevocation), -- every operator-signed revocation known here
    cert_dead : Map(String, String)      -- peers dropped for their certificate -> why
  }

  -- What a watcher of a name sees. `Lost` goes to watchers on the node that
  -- held the name when a binding made HERE is superseded by another holder's.
  type NameEvent = Bound(String, GlobalPid.Pid) | Unbound(String) | Lost(String, GlobalPid.Pid)

  type RegisterError = Taken(GlobalPid.Pid) | Stopped

  -- What the I/O layer must do after a core transition.
  type CnEffect =
      Send(String, List(Int))    -- a control frame to this node_id (dropped if no link)
    | Dial(String)               -- open a pair to this "host:port"
    | Install(CnLink)            -- a new link is current: start its readers
    | Drop(CnLink, String)       -- shut this link's sockets and stop its writers; the
                                 -- string is why, for the routes told of the close
    | Discard(CnLink)            -- a pair never installed (a rejected duplicate): close it
    | Emit(NodeEvent)            -- tell every subscriber
    | Named(String, NameEvent)   -- tell every watcher of this name
    | Unwatch(Int)               -- stop the Down-watcher with this pid

  fn core_new(cfg : CnConfig, seed : Int) : CnState do
    let me = node_id_of(cfg.name)
    let self_m = Membership.member(me, cfg.name, cfg.advertise, cfg.creation, Alive, 1)
    let ms = Membership.observe(Membership.empty(), self_m)
    { cfg: cfg, me: me, driver: SwimDriver.make(me, 1, ms, cfg.swim, cfg.period_ms, seed),
      links: Map.empty(), halves: Map.empty(), gen: 0, dialing: Map.empty(), backoff: Map.empty(),
      pending: Nil, relays: Map.empty(), refused: Nil, seed_ids: Map.empty(), rejoining: Nil, stopped: false,
      reg: GlobalRegistry.empty(), regs: Map.empty(), vis: Map.empty(), certs: Map.empty(),
      revs: List.filter(cfg.revocations, fn r -> Result.is_ok(check_revocation(cfg, r))), cert_dead: Map.empty() }
  end

  -- ── revocation and expiry ──────────────────────────────────────────────
  -- A peer's certificate is rechecked every tick: one that has expired, or
  -- that a known revocation names, has its link dropped and the member
  -- declared Dead with the reason ("certificate expired" / "certificate
  -- revoked"), so subscribers see NodeDead(info, why) and sessions with it
  -- are cancelled through the existing NodeDead path. Its handshakes are
  -- refused from then on (NodeCert.Credentials.revoked reads this node's
  -- list; expiry is checked in every handshake). Revocations travel as
  -- REVOCATIONS control frames (tag 15): the whole list to every new link,
  -- each new one to every linked peer. Only the operator's signature makes
  -- one count, so a member cannot revoke another.

  fn tag_revocations() : Int do 15 end

  fn encode_revocations(rs : List(NodeCert.SignedRevocation)) : List(Int) do
    Msgpack.encode(Msgpack.array([Msgpack.int(tag_revocations()),
      Msgpack.array(List.map(rs, fn r -> Msgpack.bin(NodeCert.revocation_to_bytes(r))))]))
  end

  fn decode_revocations(frame : List(Int)) : List(NodeCert.SignedRevocation) do
    match Msgpack.decode(frame) do
      Ok(Msgpack.Array([Msgpack.Int(15), Msgpack.Array(bins)])) ->
        List.filter_map(bins, fn b ->
          match b do
            Msgpack.Bin(bs) -> Result.to_option(NodeCert.revocation_from_bytes(bs))
            _ -> None
          end)
      _ -> Nil
    end
  end

  pfn operator_key(cfg : CnConfig) : Option(Bytes) do
    match cfg.auth do
      ClusterAuth.Certified(c) -> Some(c.operator_pubkey)
      ClusterAuth.Secret(_) -> None
    end
  end

  -- Is [r] signed by this cluster's operator? (Shared-secret nodes have no
  -- operator and accept no revocations.)
  fn check_revocation(cfg : CnConfig, r : NodeCert.SignedRevocation) : Result(NodeCert.Revocation, String) do
    match operator_key(cfg) do
      None -> Err("this node runs in shared-secret mode; revocations need certificate mode")
      Some(op) -> NodeCert.verify_revocation(r, op)
    end
  end

  fn core_revocations(st : CnState) : List(NodeCert.Revocation) do List.map(st.revs, fn r -> r.rev) end

  doc """
  Add a revocation (from the API or a peer): kept and passed on to every
  linked peer if it is the operator's and new here, ignored otherwise. The
  certificates it names are dropped at the next tick.
  """
  fn core_revoke(st : CnState, r : NodeCert.SignedRevocation) : (CnState, List(CnEffect)) do
    let known = List.any(st.revs, fn k -> k.body == r.body)
    if known || Result.is_err(check_revocation(st.cfg, r)) do (st, Nil)
    else
      let st1 = { st with revs: Cons(r, st.revs) }
      let frame = encode_revocations(Cons(r, Nil))
      let out = (st1, List.map(linked_ids(st1), fn id -> Send(id, frame)))
      out
    end
  end

  -- Why [c] no longer admits its node at [now_s], if it does not.
  pfn cert_problem(st : CnState, c : NodeCert.Cert, now_s : Int) : Option(String) do
    if NodeCert.is_revoked(c, core_revocations(st)) do Some("certificate revoked")
    else if NodeCert.expired(c, now_s) do Some("certificate expired")
    else None end end
  end

  doc """
  Recheck every linked peer's certificate at [now_s] (unix seconds): drop the
  link of one that has expired or been revoked, and queue the member Dead
  with that reason (the tick that follows reports it).
  """
  fn core_check_certs(st : CnState, now_s : Int) : (CnState, List(CnEffect)) do
    List.fold_left(Map.entries(st.links), (st, Nil), fn (acc, kv) ->
      match (acc, kv) do
        ((s, effs), (id, l)) ->
          match Map.get(s.certs, id, Map.str_cmp) do
            None -> (s, effs)
            Some(c) ->
              match cert_problem(s, c, now_s) do
                None -> (s, effs)
                Some(why) ->
                  let s1 = queue({ s with links: Map.remove(s.links, id, Map.str_cmp),
                                          certs: Map.remove(s.certs, id, Map.str_cmp),
                                          cert_dead: Map.insert(s.cert_dead, id, why, Map.str_cmp) },
                                 SwimDriver.PeerDown(id))
                  (s1, Cons(Drop(l, why), effs))
              end
          end
      end)
  end

  doc """
  The certificate peer [id] presented in its latest verified handshake
  (certificate mode); what `peer_cert` answers and step 11b checks.
  """
  fn core_peer_cert(st : CnState, id : String, cert : Option(NodeCert.Cert)) : CnState do
    match cert do
      Some(c) -> { st with certs: Map.insert(st.certs, id, c, Map.str_cmp) }
      None -> st
    end
  end

  fn core_members(st : CnState) : List(Member) do Membership.members(st.driver.swim.members) end

  fn core_member(st : CnState, id : String) : Option(Member) do Membership.get(st.driver.swim.members, id) end

  pfn linked_ids(st : CnState) : List(String) do Map.keys(st.links) end

  pfn is_linked(st : CnState, id : String) : Bool do Map.contains_key(st.links, id, Map.str_cmp) end

  pfn queue(st : CnState, ev : SwimDriver.Event) : CnState do
    { st with pending: Cons(ev, st.pending) }
  end

  -- ── events: what changed between two member views ──────────────────────

  -- [dead_cause] names why a node that went Dead in this step did.
  -- [rejoining]: nodes whose new creation first appeared NOT Alive (a
  -- duplicate pair shut by the peer just as it was installed reads as a lost
  -- connection, so the restarted node is Suspect at its new creation until it
  -- refutes); their first Alive is reported as the rejoin it is, not as `up`.
  pfn member_events(before : Members, after : Members, me : String, dead_cause : String -> String,
                    rejoining : List(String)) : List(NodeEvent) do
    List.flat_map(Membership.members(after), fn m ->
      if m.node_id == me do
        Nil
      else
        match Membership.get(before, m.node_id) do
          None ->
            match m.status do
              Alive -> Cons(NodeUp(info_of(m)), Nil)
              _ -> Nil
            end
          Some(o) ->
            if o.creation != m.creation do
              let gone = match o.status do
                Dead -> Nil
                _ -> Cons(NodeDead(info_of(o), "restarted as creation " ++ int_to_string(m.creation)), Nil)
              end
              let now_ev = match m.status do
                Alive -> Cons(NodeRejoined(info_of(m)), Nil)
                _ -> Nil
              end
              List.append(gone, now_ev)
            else
              match (o.status, m.status) do
                (Alive, Suspect) -> Cons(NodeSuspect(info_of(m)), Nil)
                (Alive, Dead) -> Cons(NodeDead(info_of(m), dead_cause(m.node_id)), Nil)
                (Suspect, Dead) -> Cons(NodeDead(info_of(m), dead_cause(m.node_id)), Nil)
                (Suspect, Alive) ->
                  if List.member(rejoining, m.node_id) do Cons(NodeRejoined(info_of(m)), Nil)
                  else Cons(NodeUp(info_of(m)), Nil) end
                (Dead, Alive) -> Cons(NodeRejoined(info_of(m)), Nil)
                _ -> Nil
              end
            end
        end
      end)
  end

  -- The rejoin set after a step: add a node whose creation changed to a
  -- non-Alive status; drop one that is Alive now (its rejoin was reported).
  pfn next_rejoining(before : Members, after : Members, rejoining : List(String)) : List(String) do
    List.filter_map(Membership.members(after), fn m ->
      let was = match Membership.get(before, m.node_id) do
        Some(o) -> o.creation != m.creation
        None -> false
      end
      let alive = match m.status do
        Alive -> true
        _ -> false
      end
      if alive do None
      else if was || List.member(rejoining, m.node_id) do Some(m.node_id)
      else None end end)
  end

  -- The effects of a set of events: emit each, and drop the links of every
  -- node that just went Dead (the edge, not the level: a node still Dead
  -- after a heal redial keeps its fresh link until it refutes).
  pfn event_effects(st : CnState, evs : List(NodeEvent)) : (CnState, List(CnEffect)) do
    event_effects_acc(st, evs, Nil)
  end

  -- Plain recursion, not a fold with a lambda: the lambda form made the
  -- compiled backend emit a call to an undefined global named after a
  -- let-binding inside it (see the progress record).
  pfn event_effects_acc(st : CnState, evs : List(NodeEvent), acc : List(CnEffect)) : (CnState, List(CnEffect)) do
    match evs do
      Nil -> (st, List.reverse(acc))
      Cons(ev, rest) ->
        match ev do
          NodeDead(i, _) ->
            match Map.get(st.links, i.node_id, Map.str_cmp) do
              Some(l) ->
                let without = { st with links: Map.remove(st.links, i.node_id, Map.str_cmp) }
                let why = "node " ++ i.name ++ " dead: " ++ (match ev do NodeDead(_, w) -> w | _ -> "" end)
                event_effects_acc(without, rest, Cons(Emit(ev), Cons(Drop(l, why), acc)))
              None -> event_effects_acc(st, rest, Cons(Emit(ev), acc))
            end
          _ -> event_effects_acc(st, rest, Cons(Emit(ev), acc))
        end
    end
  end

  -- ── ticks ──────────────────────────────────────────────────────────────

  -- The member whose advertised address is [addr], if any.
  pfn member_at(st : CnState, addr : String) : Option(Member) do
    List.find(core_members(st), fn m -> m.addr == addr && m.node_id != st.me)
  end

  -- Every address worth a dial right now: members with a known address and
  -- no link (Alive ones from gossip: the full mesh; Suspect and Dead ones:
  -- the heal path), and seeds no linked member advertises. Never ourselves,
  -- never an address with an attempt in flight or still backing off.
  pfn dial_targets(st : CnState, now : Int) : List(String) do
    let from_members = List.filter_map(core_members(st), fn m ->
      if m.node_id == st.me || String.is_empty(m.addr) || is_linked(st, m.node_id) do None else Some(m.addr) end)
    let linked_addrs = List.filter_map(core_members(st), fn m ->
      if is_linked(st, m.node_id) do Some(m.addr) else None end)
    -- A seed is satisfied when a linked member advertises it, or when a dial
    -- of it reached a node that is linked or is us: a seed can be spelled
    -- differently from the address its node advertises (a hostname, another
    -- interface), and redialling it would replace the live pair every time.
    let from_seeds = List.filter(st.cfg.seeds, fn a ->
      not(List.member(linked_addrs, a)) && not(seed_reached(st, a)))
    let all = List.dedup(List.append(from_members, from_seeds))
    List.filter(all, fn a ->
      a != st.cfg.advertise &&
      not(Map.contains_key(st.dialing, a, Map.str_cmp)) &&
      (match Map.get(st.backoff, a, Map.str_cmp) do
         None -> true
         Some((at, _)) -> at <= now
       end))
  end

  pfn seed_reached(st : CnState, a : String) : Bool do
    match Map.get(st.seed_ids, a, Map.str_cmp) do
      Some(id) -> id == st.me || is_linked(st, id)
      None -> false
    end
  end

  -- Forget attempts past their deadline (a dial task that is still parked
  -- in a connect will report later; a late success is still a link).
  pfn expire_dials(st : CnState, now : Int) : CnState do
    let live = Map.filter(st.dialing, fn _a -> fn until -> until > now, Map.str_cmp)
    { st with dialing: live }
  end

  pfn plan_dials(st : CnState, now : Int) : (CnState, List(CnEffect)) do
    let st1 = expire_dials(st, now)
    let targets = dial_targets(st1, now)
    let until = now + st1.cfg.dial_timeout_ms * 2 + st1.cfg.handshake_timeout_ms * 2
    let dialing = List.fold_left(targets, st1.dialing, fn (m, a) -> Map.insert(m, a, until, Map.str_cmp))
    let out = ({ st1 with dialing: dialing }, List.map(targets, fn a -> Dial(a)))
    out
  end

  pfn swim_frames(st : CnState, acts : List(Swim.Action)) : List(CnEffect) do
    let ids = linked_ids(st)
    List.flat_map(acts, fn a ->
      List.map(SwimDriver.action_frames(a, st.me, ids), fn pair ->
        match pair do (dest, bytes) -> Send(dest, bytes) end))
  end

  doc """
  One tick at [now]: fold the queued SWIM events and step the driver (its
  actions become control frames to linked peers), derive the member events,
  and plan the dials this tick allows.
  """
  fn core_tick(st0 : CnState, now : Int) : (CnState, List(CnEffect)) do
    let (st, cert_effs) = core_check_certs(st0, now / 1000)
    let before = st.driver.swim.members
    let timed_out = List.filter_map(Map.entries(st.driver.swim.suspect_deadlines), fn kv ->
      match kv do (id, dl) -> if dl <= now do Some(id) else None end end)
    let refused = st.refused
    let evs_in = List.reverse(st.pending)
    match SwimDriver.step(st.driver, now, evs_in) do
      (d2, acts) ->
        let st2 = { st with driver: d2, pending: Nil, refused: Nil }
        let frames = swim_frames(st2, acts)
        let cert_dead = st.cert_dead
        let cause = fn id ->
          match Map.get(cert_dead, id, Map.str_cmp) do
            Some(why) -> why
            None ->
          if List.member(refused, id) do "connection refused"
          else if List.member(timed_out, id) do "suspect timeout"
          else "gossip" end end
          end
        let evs = member_events(before, d2.swim.members, st.me, cause, st.rejoining)
        let rejoining = next_rejoining(before, d2.swim.members, st.rejoining)
        match event_effects({ st2 with rejoining: rejoining }, evs) do
          (st3, ev_effs) ->
            match plan_dials(st3, now) do
              (st4, dials) ->
                let ae_peers = List.filter(SwimDriver.anti_entropy_peers(st4.driver, now), fn id -> is_linked(st4, id))
                let st5 = if List.is_empty(ae_peers) do st4 else { st4 with driver: SwimDriver.bump_anti_entropy(st4.driver, now) } end
                let req = NetKernel.encode_registry_sync_req(GlobalRegistry.root_hash(st5.reg))
                let ae = List.map(ae_peers, fn id -> Send(id, req))
                match refresh_names(st5) do
                  (st6, name_effs) ->
                    let out = (st6, List.append(cert_effs, List.append(frames, List.append(ev_effs, List.append(dials, List.append(ae, name_effs))))))
                    out
                end
            end
        end
    end
  end

  -- ── links ──────────────────────────────────────────────────────────────

  -- The pair two nodes both keep when each dialled the other: the one
  -- dialled by the lower node_id.
  -- A pair from a newer creation of the peer always wins: the old one is to
  -- a process that is gone, even if no RST has told us yet.
  pfn keeps_new(st : CnState, old : CnLink, new_l : CnLink) : Bool do
    if new_l.creation != old.creation do
      new_l.creation > old.creation
    else if old.dialer == new_l.dialer do
      true
    else
      let lower = if st.me < new_l.node_id do st.me else new_l.node_id end
      new_l.dialer == lower
    end end
  end

  doc """
  A pair to [id] is up ([cfd]/[dfd], opened by [dialer], its control writer
  [cw]). Applies the duplicate rule, gives it a generation, records what the
  handshake said about the peer (name, advertised address, creation) as an
  Alive observation. A completed authenticated link directly proves a peer
  previously declared Dead or Suspect is alive, so its observation advances
  that peer's incarnation; otherwise a split brain can leave both sides
  retaining Dead records that neither can independently refute. It then sends
  our whole member view.
  """
  fn core_linked(st : CnState, id : String, name : String, addr : String, creation : Int,
                 cfd : Int, dfd : Int, dialer : String, cw : Int) : (CnState, List(CnEffect)) do
    let gen = st.gen + 1
    let l = { node_id: id, gen: gen, cfd: cfd, dfd: dfd, dialer: dialer, cw: cw, creation: creation }
    let st1 = { st with gen: gen }
    let (st2, drops) = match Map.get(st1.links, id, Map.str_cmp) do
      None -> (st1, Nil)
      Some(old) ->
        if keeps_new(st1, old, l) do
          (st1, Cons(Drop(old, "replaced"), Nil))
        else
          (st1, Cons(Discard(l), Nil))
        end
    end
    let kept_new = match drops do
      Cons(Discard(_), Nil) -> false
      _ -> true
    end
    if kept_new do
      let known_incarnation = match core_member(st2, id) do
        Some(m) ->
          if m.creation == creation do
            match m.status do
              Alive -> m.incarnation
              _ -> m.incarnation + 1
            end
          else 0 end
        None -> 0
      end
      let obs = Membership.member(id, name, addr, creation, Alive, known_incarnation)
      let st3 = queue({ st2 with links: Map.insert(st2.links, id, l, Map.str_cmp),
                                 cert_dead: Map.remove(st2.cert_dead, id, Map.str_cmp),
                                 backoff: Map.remove(st2.backoff, addr, Map.str_cmp),
                                 dialing: Map.remove(st2.dialing, addr, Map.str_cmp) },
                      SwimDriver.GossipFrame(obs))
      let sync = SwimDriver.encode_members_sync(List.append(core_members(st3), Cons(obs, Nil)))
      let regsync = NetKernel.encode_registry_sync_resp(GlobalRegistry.root_hash(st3.reg), GlobalRegistry.all_entries(st3.reg))
      let revsync = if List.is_empty(st3.revs) do Nil else Cons(Send(id, encode_revocations(st3.revs)), Nil) end
      let out = (st3, List.append(drops, Cons(Install(l), Cons(Send(id, sync), Cons(Send(id, regsync), revsync)))))
      out
    else
      (st2, drops)
    end
  end

  doc """
  A pair WE dialled to [dialed] ("host:port" as dialled -- a seed may be
  spelled differently from the peer's advertised [peer_addr]) is up: record
  which node that address reaches, clear its dial state, and link it.
  """
  fn core_dialed(st : CnState, dialed : String, id : String, name : String, peer_addr : String,
                 creation : Int, cfd : Int, dfd : Int, cw : Int) : (CnState, List(CnEffect)) do
    let a = if String.is_empty(peer_addr) do dialed else peer_addr end
    let st1 = { st with seed_ids: Map.insert(st.seed_ids, dialed, id, Map.str_cmp),
                        dialing: Map.remove(st.dialing, dialed, Map.str_cmp),
                        backoff: Map.remove(st.backoff, dialed, Map.str_cmp) }
    core_linked(st1, id, name, a, creation, cfd, dfd, st1.me, cw)
  end

  doc "A dial of [addr] reached this node itself (a seed list naming us): never dial it again."
  fn core_seed_self(st : CnState, addr : String) : CnState do
    { st with seed_ids: Map.insert(st.seed_ids, addr, st.me, Map.str_cmp),
              dialing: Map.remove(st.dialing, addr, Map.str_cmp) }
  end

  doc """
  A connection of the current pair to [id], generation [gen], ended. A close
  from a replaced generation is ignored. Otherwise the link is gone, the
  member is suspected (a hint, not a verdict) and redialled at once.
  """
  fn core_link_closed(st : CnState, id : String, gen : Int) : (CnState, List(CnEffect)) do
    match Map.get(st.links, id, Map.str_cmp) do
      None -> (st, Nil)
      Some(l) ->
        if l.gen != gen do
          (st, Nil)
        else
          let st1 = { st with links: Map.remove(st.links, id, Map.str_cmp) }
          let addr = match core_member(st1, id) do
            Some(m) -> m.addr
            None -> ""
          end
          let st2 = { st1 with backoff: Map.remove(st1.backoff, addr, Map.str_cmp) }
          let out = (queue(st2, SwimDriver.ConnLost(id)), Cons(Drop(l, "connection lost"), Nil))
          out
        end
    end
  end

  doc """
  A dial to [addr] failed. [refused]: nothing listens there -- for a member
  we know at that address that is not already Dead, that is definite
  (PeerDown: Dead at the next tick, cause "connection refused"). Either way
  the address backs off, doubling to redial_max_ms.
  """
  fn core_dial_failed(st : CnState, now : Int, addr : String, refused : Bool) : CnState do
    let delay = match Map.get(st.backoff, addr, Map.str_cmp) do
      None -> st.cfg.redial_min_ms
      Some((_, d)) -> if d * 2 > st.cfg.redial_max_ms do st.cfg.redial_max_ms else d * 2 end
    end
    let st1 = { st with dialing: Map.remove(st.dialing, addr, Map.str_cmp),
                        backoff: Map.insert(st.backoff, addr, (now + delay, delay), Map.str_cmp) }
    if refused do
      match member_at(st1, addr) do
        Some(m) ->
          match m.status do
            Dead -> st1
            _ -> queue({ st1 with refused: Cons(m.node_id, st1.refused) }, SwimDriver.PeerDown(m.node_id))
          end
        None -> st1
      end
    else
      st1
    end
  end

  -- ── control frames ─────────────────────────────────────────────────────

  pfn relay_ack(st : CnState, target : String) : (CnState, List(CnEffect)) do
    match Map.get(st.relays, target, Map.str_cmp) do
      None -> (st, Nil)
      Some(reqs) ->
        let ack = SwimDriver.encode_msg(SwimDriver.SwimPingAck(target))
        let out = ({ st with relays: Map.remove(st.relays, target, Map.str_cmp) },
                   List.map(reqs, fn r -> Send(r, ack)))
        out
    end
  end

  doc """
  A control frame from [from] (tag [tag]). SWIM pings are answered at once;
  acks, gossip and member syncs are queued for the next tick; a ping-req is
  relayed (we ping the target, and pass its ack back to the requester).
  Frames of other families are ignored here (the registry and the data
  plane handle theirs).
  """
  fn core_frame(st : CnState, from : String, tag : Int, frame : List(Int)) : (CnState, List(CnEffect)) do
    if tag == 13 do
      match SwimDriver.decode_member_gossip(frame) do
        Ok(m) -> (queue(st, SwimDriver.GossipFrame(m)), Nil)
        Err(_) -> (st, Nil)
      end
    else if tag == 14 do
      match SwimDriver.decode_members_sync(frame) do
        Ok(ms) -> (List.fold_left(ms, st, fn (s, m) -> queue(s, SwimDriver.GossipFrame(m))), Nil)
        Err(_) -> (st, Nil)
      end
    else if tag == 5 || tag == 6 do
      registry_frame(st, from, tag, frame)
    else if tag == tag_revocations() do
      List.fold_left(decode_revocations(frame), (st, Nil), fn (acc, r) ->
        match acc do
          (s, effs) ->
            match core_revoke(s, r) do
              (s2, e2) -> (s2, List.append(effs, e2))
            end
        end)
    else if tag >= 0 && tag <= 3 do
      match SwimDriver.decode_msg(frame) do
        Err(_) -> (st, Nil)
        Ok(msg) ->
          match msg do
            SwimDriver.SwimPing(_) ->
              (st, Cons(Send(from, SwimDriver.encode_msg(SwimDriver.SwimPingAck(st.me))), Nil))
            SwimDriver.SwimPingAck(sender) ->
              relay_ack(queue(st, SwimDriver.PingAck(sender)), sender)
            SwimDriver.SwimPingReq(requester, target) ->
              if is_linked(st, target) do
                let reqs = match Map.get(st.relays, target, Map.str_cmp) do
                  None -> Cons(requester, Nil)
                  Some(rs) -> Cons(requester, rs)
                end
                ({ st with relays: Map.insert(st.relays, target, reqs, Map.str_cmp) },
                 Cons(Send(target, SwimDriver.encode_msg(SwimDriver.SwimPing(st.me))), Nil))
              else
                (st, Nil)
              end
            _ ->
              match SwimDriver.msg_to_event(msg) do
                Some(ev) -> (queue(st, ev), Nil)
                None -> (st, Nil)
              end
          end
      end
    else
      (st, Nil)
    end end end end end
  end

  -- ── names ──────────────────────────────────────────────────────────────

  fn core_lookup(st : CnState, name : String) : Option(GlobalPid.Pid) do
    Map.get(st.vis, name, Map.str_cmp)
  end

  -- Is binding [e] visible here: held by a node that is not Dead in our view
  -- and has not restarted since it registered? A holder we have not heard of
  -- yet is visible (the binding came from someone who has).
  pfn visible(st : CnState, e : GlobalRegistry.Entry) : Bool do
    if not(e.present) do false
    else if e.node_id == st.me do e.creation == st.cfg.creation
    else
      match core_member(st, e.node_id) do
        None -> true
        Some(m) ->
          let live = match m.status do
            Dead -> false
            _ -> true
          end
          live && m.creation == e.creation
      end
    end end
  end

  pfn visible_map(st : CnState) : Map(String, GlobalPid.Pid) do
    List.fold_left(GlobalRegistry.all_entries(st.reg), Map.empty(), fn (acc, kv) ->
      match kv do
        (name, e) ->
          if visible(st, e) do
            Map.insert(acc, name, GlobalPid.make(e.node_id, e.pid, e.creation), Map.str_cmp)
          else acc end
      end)
  end

  pfn is_ours(st : CnState, name : String, p : GlobalPid.Pid) : Bool do
    let mine = match Map.get(st.regs, name, Map.str_cmp) do
      Some((pid, _)) -> pid == p.local_pid
      None -> false
    end
    mine && p.node_id == st.me
  end

  -- The current winner of [name] in the replica, visible or not.
  pfn winner_of(st : CnState, name : String) : Option(GlobalPid.Pid) do
    match GlobalRegistry.entry(st.reg, name) do
      Some(e) -> if e.present do Some(GlobalPid.make(e.node_id, e.pid, e.creation)) else None end
      None -> None
    end
  end

  -- Recompute visibility and report every change: to watchers (Named), and
  -- by forgetting local registrations another holder has taken (Lost).
  pfn refresh_names(st : CnState) : (CnState, List(CnEffect)) do
    let new_vis = visible_map(st)
    let names = List.dedup(List.append(Map.keys(st.vis), Map.keys(new_vis)))
    let out = List.fold_left(names, (st, Nil), fn (acc, name) ->
      match acc do
        (s, effs) ->
          let before = Map.get(s.vis, name, Map.str_cmp)
          let after = Map.get(new_vis, name, Map.str_cmp)
          name_change(s, effs, name, before, after)
      end)
    match out do
      (st2, effs) ->
        let done = ({ st2 with vis: new_vis }, effs)
        done
    end
  end

  pfn name_change(s : CnState, effs : List(CnEffect), name : String, before : Option(GlobalPid.Pid),
                  after : Option(GlobalPid.Pid)) : (CnState, List(CnEffect)) do
    match (before, after) do
      (None, None) -> (s, effs)
      (None, Some(p)) -> (s, List.append(effs, Cons(Named(name, Bound(name, p)), Nil)))
      (Some(o), _) ->
        let changed = match after do
          None -> true
          Some(p) -> not(GlobalPid.eq(o, p))
        end
        if not(changed) do
          (s, effs)
        else if is_ours(s, name, o) do
          -- A binding made here lost to another holder's (visible or not).
          let winner = match after do
            Some(p) -> Some(p)
            None -> winner_of(s, name)
          end
          match winner do
            Some(w) ->
              if GlobalPid.eq(w, o) do
                (s, List.append(effs, Cons(Named(name, Unbound(name)), Nil)))
              else
                let watcher = match Map.get(s.regs, name, Map.str_cmp) do
                  Some((_, wp)) -> Cons(Unwatch(wp), Nil)
                  None -> Nil
                end
                let s2 = { s with regs: Map.remove(s.regs, name, Map.str_cmp) }
                let out = (s2, List.append(effs, Cons(Named(name, Lost(name, w)), watcher)))
                out
              end
            None -> (s, List.append(effs, Cons(Named(name, Unbound(name)), Nil)))
          end
        else
          match after do
            Some(p) -> (s, List.append(effs, Cons(Named(name, Bound(name, p)), Nil)))
            None -> (s, List.append(effs, Cons(Named(name, Unbound(name)), Nil)))
          end
        end end
    end
  end

  -- Frames carrying registry leaves to every linked peer.
  pfn push_leaves(st : CnState, leaves : List((String, GlobalRegistry.Entry))) : List(CnEffect) do
    let bytes = NetKernel.encode_registry_sync_resp(GlobalRegistry.root_hash(st.reg), leaves)
    List.map(linked_ids(st), fn id -> Send(id, bytes))
  end

  pfn leaf(st : CnState, name : String) : List((String, GlobalRegistry.Entry)) do
    match GlobalRegistry.entry(st.reg, name) do
      Some(e) -> Cons((name, e), Nil)
      None -> Nil
    end
  end

  -- Tombstone our own bindings from an earlier creation (a restart reuses
  -- local pids, so they name whatever process has that pid now).
  pfn retire_stale(st : CnState) : (CnState, List(String)) do
    let stale = List.filter(GlobalRegistry.all_entries(st.reg), fn kv ->
      match kv do (_n, e) -> e.present && e.node_id == st.me && e.creation != st.cfg.creation end)
    List.fold_left(stale, (st, Nil), fn (acc, kv) ->
      match acc do
        (s, names) ->
          match kv do
            (name, e) ->
              let clock = GlobalRegistry.next_clock(s.reg, name, s.me)
              match GlobalRegistry.unregister_own(s.reg, name, s.me, e.creation, e.pid, clock) do
                Some(r) ->
                  let out = ({ s with reg: r }, Cons(name, names))
                  out
                None -> (s, names)
              end
          end
      end)
  end

  doc """
  Register [name] -> local pid [pid] (its Down-watcher is [watcher]). Refused
  if another holder's binding is visible here -- the API checked the mirror
  first, so that is a race lost: the watcher is retired and the name's
  watchers get `Lost(name, holder)`.
  """
  fn core_register(st : CnState, name : String, pid : Int, watcher : Int) : (CnState, List(CnEffect)) do
    match core_lookup(st, name) do
      Some(p) ->
        if p.node_id == st.me && p.local_pid == pid do
          core_register_ok(st, name, pid, watcher)
        else
          -- register() checked the mirror and returned Ok; another binding got
          -- here first. Tell the name's watchers who holds it.
          let out = (st, Cons(Unwatch(watcher), Cons(Named(name, Lost(name, p)), Nil)))
          out
        end
      None -> core_register_ok(st, name, pid, watcher)
    end
  end

  pfn core_register_ok(st : CnState, name : String, pid : Int, watcher : Int) : (CnState, List(CnEffect)) do
    let clock = GlobalRegistry.next_clock(st.reg, name, st.me)
    let old_watch = match Map.get(st.regs, name, Map.str_cmp) do
      Some((_, w)) -> if w != watcher do Cons(Unwatch(w), Nil) else Nil end
      None -> Nil
    end
    let st2 = { st with reg: GlobalRegistry.register_at(st.reg, name, st.me, st.cfg.creation, pid, clock),
                        regs: Map.insert(st.regs, name, (pid, watcher), Map.str_cmp) }
    match refresh_names(st2) do
      (st3, effs) ->
        let out = (st3, List.append(old_watch, List.append(push_leaves(st3, leaf(st3, name)), effs)))
        out
    end
  end

  doc "Unregister [name] if this node holds it (compare-and-delete)."
  fn core_unregister(st : CnState, name : String) : (CnState, List(CnEffect)) do
    match Map.get(st.regs, name, Map.str_cmp) do
      None -> (st, Nil)
      Some((pid, w)) ->
        let st1 = { st with regs: Map.remove(st.regs, name, Map.str_cmp) }
        let clock = GlobalRegistry.next_clock(st1.reg, name, st1.me)
        match GlobalRegistry.unregister_own(st1.reg, name, st1.me, st1.cfg.creation, pid, clock) do
          None -> (st1, Cons(Unwatch(w), Nil))
          Some(r) ->
            let st2 = { st1 with reg: r }
            match refresh_names(st2) do
              (st3, effs) ->
                let out = (st3, Cons(Unwatch(w), List.append(push_leaves(st3, leaf(st3, name)), effs)))
                out
            end
        end
    end
  end

  doc "A locally registered process died: unregister every name it held."
  fn core_local_down(st : CnState, pid : Int) : (CnState, List(CnEffect)) do
    let names = List.filter_map(Map.entries(st.regs), fn kv ->
      match kv do (name, (p, _)) -> if p == pid do Some(name) else None end end)
    List.fold_left(names, (st, Nil), fn (acc, name) ->
      match acc do
        (s, effs) ->
          match core_unregister(s, name) do
            (s2, e2) ->
              let out = (s2, List.append(effs, e2))
              out
          end
      end)
  end

  -- A REGISTRY_SYNC_REQ / RESP from [from].
  pfn registry_frame(st : CnState, from : String, tag : Int, frame : List(Int)) : (CnState, List(CnEffect)) do
    if tag == 5 do
      match NetKernel.decode_registry_sync_req(frame) do
        Err(_) -> (st, Nil)
        Ok(rh) ->
          if rh == GlobalRegistry.root_hash(st.reg) do (st, Nil)
          else
            let bytes = NetKernel.encode_registry_sync_resp(GlobalRegistry.root_hash(st.reg), GlobalRegistry.all_entries(st.reg))
            (st, Cons(Send(from, bytes), Nil))
          end
      end
    else
      match NetKernel.decode_registry_sync_resp(frame) do
        Err(_) -> (st, Nil)
        Ok((rh, leaves)) ->
          let merged = GlobalRegistry.diff_entries(st.reg, rh, leaves)
          match retire_stale({ st with reg: merged }) do
            (st2, retired) ->
              let mine = GlobalRegistry.root_hash(st2.reg)
              -- Answer with everything when the sender's state (its root) is
              -- not what we now hold, so it can merge ours: two rounds at most,
              -- since after merging both hold the join.
              let reply = if mine != rh do
                Cons(Send(from, NetKernel.encode_registry_sync_resp(mine, GlobalRegistry.all_entries(st2.reg))), Nil)
              else Nil end
              let retire_push = List.flat_map(retired, fn n -> push_leaves(st2, leaf(st2, n)))
              match refresh_names(st2) do
                (st3, effs) ->
                  let out = (st3, List.append(reply, List.append(retire_push, effs)))
                  out
              end
          end
      end
    end
  end

  -- ── the I/O layer ───────────────────────────────────────────────────────

  -- One peer's control writer: every control frame to that peer is written
  -- here, in mailbox order. A failed write marks it dead (the reader will
  -- see the connection end and report it).
  actor CtlWriter do
    state { fd : Int, dead : Bool }
    init  { fd: -1, dead: false }
    on CtlUse(fd : Int) do
      { fd: fd, dead: false }
    end
    on CtlWrite(bytes : List(Int)) do
      if state.dead || state.fd < 0 do
        state
      else
        match NetKernel.send_frame(state.fd, bytes) do
          Ok(_) -> state
          Err(_) -> { fd: state.fd, dead: true }
        end
      end
    end
    on CtlStop() do
      { fd: state.fd, dead: true }
    end
    -- Close the socket here, after every write queued before it (see
    -- release_link): a close from anywhere else could race a queued write
    -- onto a reused fd number.
    on CtlClose() do
      if state.fd >= 0 do tcp_close(state.fd) else () end
      { fd: -1, dead: true }
    end
  end

  -- The node's backing record: what the real dictionary (`ops_of`) closes
  -- over; `start` returns it wrapped in a `Cap(ClusterNode.Live)`, never
  -- bare. `pid` is the Node actor's pid as an Int; the Vaults are its mirrors.
  type CnHandle = { pid : Int, name : String, node_id : String, advertise : String,
                  members : Vault(Member), subs : Vault(NodeEvent -> Unit), meta : Vault(Int),
                  names : Vault(GlobalPid.Pid), watches : Vault(NameEvent -> Unit),
                  links : Vault(CnLink), qs : Vault(Int), causes : Vault(String),
                  routes : Vault(NodeSend.Delivery -> Result((), String)),
                  closes : Vault(String -> String -> Unit),
                  downs : Vault(DistLink.DownReason -> Unit), fired : Vault(List(Int)),
                  failed : Vault(Int -> String -> Unit),
                  certs : Vault(NodeCert.Cert), sec : Vault(SecurityEvent -> Unit),
                  revs : Vault(NodeCert.Revocation), op_pub : Bytes }

  -- Watches one registered process: its `Down` unregisters its names. `Down`
  -- is a raw mailbox message, so the watcher reads it with `receive` (the
  -- SessionNode.HostWatch pattern); `register` sets the monitor from outside.
  actor RegWatch do
    state { n : Int }
    init  { n: 0 }
    on WatchPid(node : Int, pid : Int) do
      match receive() do
        Down.Down(_, _, _) -> discard(send(pid_of_int(node), LocalDown(pid)))
      end
      { n: state.n + 1 }
    end
  end

  actor ClusterNodeActor do
    state { st : CnState, h : CnHandle, started : Bool }
    init  { st: core_new(config("", 0, "", Nil, "", 0), 0),
            h: { pid: 0, name: "", node_id: "", advertise: "",
                 members: Vault.new("cluster_node_unset_members"),
                 subs: Vault.new("cluster_node_unset_subs"),
                 meta: Vault.new("cluster_node_unset_meta"),
                 names: Vault.new("cluster_node_unset_names"),
                 watches: Vault.new("cluster_node_unset_watches"),
                 links: Vault.new("cluster_node_unset_links"),
                 qs: Vault.new("cluster_node_unset_qs"),
                 causes: Vault.new("cluster_node_unset_causes"),
                 routes: Vault.new("cluster_node_unset_routes"),
                 closes: Vault.new("cluster_node_unset_closes"),
                 downs: Vault.new("cluster_node_unset_downs"),
                 fired: Vault.new("cluster_node_unset_fired"),
                 failed: Vault.new("cluster_node_unset_failed"),
                 certs: Vault.new("cluster_node_unset_certs"),
                 sec: Vault.new("cluster_node_unset_sec"),
                 revs: Vault.new("cluster_node_unset_revs"), op_pub: Bytes.empty() },
            started: false }
    on Boot(st0 : CnState, h0 : CnHandle) do
      { st: st0, h: h0, started: true }
    end
    on Tick(now : Int) do
      if state.started do
        resend_fires(state.st, state.h, now)
        step_io(state.st, state.h, core_tick(state.st, now), state.started)
      else state end
    end
    on Accepted(fd : Int, id : String, name : String, role : String, addr : String, creation : Int,
                cert : Option(NodeCert.Cert)) do
      if state.started do
        on_accepted(core_peer_cert(state.st, id, cert), state.h, fd, id, name, role, addr, creation)
      else
        -- A handshake that finished after stop(): nothing may be installed.
        tcp_close(fd)
        state
      end
    end
    on Dialed(addr : String, id : String, name : String, peer_addr : String, creation : Int, cfd : Int, dfd : Int,
              cert : Option(NodeCert.Cert)) do
      if state.started do
        let cw = start_writers(state.h, cfd, dfd)
        let st1 = core_peer_cert(state.st, id, cert)
        step_io(st1, state.h, core_dialed(st1, addr, id, name, peer_addr, creation, cfd, dfd, cw), state.started)
      else
        tcp_close(cfd)
        tcp_close(dfd)
        state
      end
    end
    on SeedIsSelf(addr : String) do
      { st: core_seed_self(state.st, addr), h: state.h, started: state.started }
    end
    on DialFailed(addr : String, now : Int, refused : Bool) do
      { st: core_dial_failed(state.st, now, addr, refused), h: state.h, started: state.started }
    end
    on CtlFrame(from : String, gen : Int, tag : Int, frame : List(Int)) do
      if current_gen(state.st, from, gen) do
        step_io(state.st, state.h, core_frame(state.st, from, tag, frame), state.started)
      else
        state
      end
    end
    on LinkClosed(id : String, gen : Int) do
      step_io(state.st, state.h, core_link_closed(state.st, id, gen), state.started)
    end
    on Register(name : String, pid : Int, watcher : Int) do
      -- Checked HERE, in the actor's turn: a pid that died before this turn
      -- has had its Down (and the watcher's LocalDown) race this message, so
      -- registering it would leave a binding to a dead process forever. One
      -- that dies after this check is unregistered by the LocalDown that is
      -- then queued behind this turn.
      if is_alive(pid_of_int(pid)) do
        step_io(state.st, state.h, core_register(state.st, name, pid, watcher), state.started)
      else
        step_io(state.st, state.h, (state.st, Cons(Unwatch(watcher), Nil)), state.started)
      end
    end
    on Revoke(r : NodeCert.SignedRevocation) do
      step_io(state.st, state.h, core_revoke(state.st, r), state.started)
    end
    on Unregister(name : String) do
      step_io(state.st, state.h, core_unregister(state.st, name), state.started)
    end
    on LocalDown(pid : Int) do
      step_io(state.st, state.h, core_local_down(state.st, pid), state.started)
    end
    on Shutdown() do
      let h = state.h
      let _ = List.map(Map.values(state.st.links), fn l -> do
        drop_link(l)
        release_link(h, l, 3)
      end)
      -- Half-assembled inbound pairs own their fds outright.
      let _ = List.map(Map.values(state.st.halves), fn hf -> close_half(hf))
      { st: { state.st with stopped: true, links: Map.empty(), halves: Map.empty() }, h: state.h, started: false }
    end
  end

  type NodeActorState = { st : CnState, h : CnHandle, started : Bool }

  pfn node_pid(h : CnHandle) do pid_of_int(h.pid) end

  -- Evaluate for effect. (`let _ = x` followed by a `()` line parses as the
  -- application `x()`: the let-then-paren trap.)
  pfn discard(_x) : () do () end

  pfn current_gen(st : CnState, id : String, gen : Int) : Bool do
    match Map.get(st.links, id, Map.str_cmp) do
      Some(l) -> l.gen == gen
      None -> false
    end
  end

  pfn start_writer(fd : Int) : Int do
    let w = spawn(CtlWriter)
    send(w, CtlUse(fd))
    pid_to_int(w)
  end

  pfn data_budget() : Int do 262144 end

  -- A link's two writers: the control writer (its pid is the link's `cw`)
  -- and the data connection's NodeQueue writer (credit flow control), kept
  -- in the handle's `qs` by the control fd.
  pfn start_writers(h : CnHandle, cfd : Int, dfd : Int) : Int do
    let cw = start_writer(cfd)
    match NodeQueue.start(dfd, data_budget()) do
      (w, _) -> Vault.set(h.qs, "q" ++ int_to_string(cfd), pid_to_int(w))
    end
    cw
  end

  pfn drop_link(l : CnLink) : () do
    send(pid_of_int(l.cw), CtlStop())
    tcp_shutdown(l.cfd)
    if l.dfd >= 0 do tcp_shutdown(l.dfd) else () end
  end

  -- A link's fds are closed once EVERY party that may touch them is done:
  -- the node's drop (after which nothing new is queued to its writers) and
  -- both readers (a close under a parked reader drops its kqueue/epoll
  -- registration and it never wakes). Closing earlier would also let a
  -- later shutdown -- or a queued write -- land on the fd number after the OS
  -- reused it for another connection. The close itself goes through each
  -- writer's mailbox, behind any write already queued. [need] is 3 for an
  -- installed link (drop + two readers), 1 for one never installed.
  pfn release_link(h : CnHandle, l : CnLink, need : Int) : () do
    let key = "rel" ++ int_to_string(l.gen)
    let n = Vault.incr(h.meta, key, 1)
    if n == need do
      Vault.drop(h.meta, key)
      -- Every reader is done: the connection's MAC state goes with it (the
      -- fd numbers are about to be reused).
      NetKernel.forget(l.cfd)
      if l.dfd >= 0 do NetKernel.forget(l.dfd) else () end
      discard(send(pid_of_int(l.cw), CtlClose()))
      let qk = "q" ++ int_to_string(l.cfd)
      match Vault.get(h.qs, qk) do
        Some(w) ->
          Vault.drop(h.qs, qk)
          NodeQueue.close_fd((pid_of_int(w), l.dfd))
        None -> tcp_close(l.dfd)
      end
    else () end
  end

  pfn close_half(hf : CnHalf) : () do
    if hf.cfd >= 0 do
      NetKernel.forget(hf.cfd)
      tcp_close(hf.cfd)
    else () end
    if hf.dfd >= 0 do
      NetKernel.forget(hf.dfd)
      tcp_close(hf.dfd)
    else () end
  end

  -- Pair up an accepted connection with its other half; a complete pair is
  -- a link (dialled by the peer).
  pfn on_accepted(st : CnState, h : CnHandle, fd : Int, id : String, name : String, role : String,
                  addr : String, creation : Int) : NodeActorState do
    let old = match Map.get(st.halves, id, Map.str_cmp) do
      Some(hf) -> if hf.creation == creation do hf else { cfd: -1, dfd: -1, name: name, addr: addr, creation: creation } end
      None -> { cfd: -1, dfd: -1, name: name, addr: addr, creation: creation }
    end
    let hf = if role == Handshake.role_data() do { old with dfd: fd } else { old with cfd: fd } end
    if hf.cfd >= 0 && hf.dfd >= 0 do
      let st1 = { st with halves: Map.remove(st.halves, id, Map.str_cmp) }
      let cw = start_writers(h, hf.cfd, hf.dfd)
      step_io(st1, h, core_linked(st1, id, hf.name, hf.addr, hf.creation, hf.cfd, hf.dfd, id, cw), true)
    else
      { st: { st with halves: Map.insert(st.halves, id, hf, Map.str_cmp) }, h: h, started: true }
    end
  end

  -- Perform a core transition's effects and mirror the member view.
  pfn step_io(_st0 : CnState, h : CnHandle, out : (CnState, List(CnEffect)), started : Bool) : NodeActorState do
    match out do
      (st, effs) ->
        let _ = List.map(effs, fn e -> perform(st, h, e))
        mirror(st, h)
        { st: st, h: h, started: started }
    end
  end

  pfn perform(st : CnState, h : CnHandle, e : CnEffect) : () do
    match e do
      Send(id, bytes) ->
        match Map.get(st.links, id, Map.str_cmp) do
          Some(l) -> discard(send(pid_of_int(l.cw), CtlWrite(bytes)))
          None -> ()
        end
      Dial(addr) ->
        let me = NodeIdentity.make(st.cfg.name, "pk-" ++ st.cfg.name, st.cfg.creation)
        let node = pid_of_int(h.pid)
        let cfg = st.cfg
        discard(task_spawn(fn _ -> dial(node, h, cfg, me, addr)))
      Install(l) ->
        let node = pid_of_int(h.pid)
        let _ = task_spawn(fn _ -> read_control(node, h, l))
        discard(task_spawn(fn _ -> read_data(node, h, st.cfg.creation, l)))
      Drop(l, why) ->
        -- The data reader reads the cause when its connection ends, and
        -- tells the routes; set before the sockets are shut.
        Vault.set(h.causes, "c" ++ int_to_string(l.cfd), why)
        drop_link(l)
        release_link(h, l, 3)
      Discard(l) ->
        -- Never installed: no reader will ever release it.
        drop_link(l)
        release_link(h, l, 1)
      Named(name, ev) -> tell_watchers(h, name ++ watch_sep(), ev)
      Unwatch(w) -> if w > 0 do kill(pid_of_int(w)) else () end
      Emit(NodeDead(i, why)) ->
        monitors_node_down(h, i.node_id)
        let _ = dist_monitor_forget_node(i.node_id)
        emit_all(h, NodeDead(i, why))
      Emit(ev) -> emit_all(h, ev)
    end
  end

  pfn emit_all(h : CnHandle, ev : NodeEvent) : () do
    discard(List.map(Vault.all(h.subs), fn kv -> emit_one(kv, ev)))
  end

  pfn emit_one(kv : (String, NodeEvent -> Unit), ev : NodeEvent) : () do
    match kv do
      (_k, f) -> f(ev)
    end
  end

  pfn tell_watchers(h : CnHandle, prefix : String, ev : NameEvent) : () do
    discard(List.map(Vault.all(h.watches), fn kv -> tell_watcher(kv, prefix, ev)))
  end

  pfn tell_watcher(kv : (String, NameEvent -> Unit), prefix : String, ev : NameEvent) : () do
    match kv do
      (k, f) -> if String.starts_with(k, prefix) do f(ev) else () end
    end
  end

  pfn mirror(st : CnState, h : CnHandle) : () do
    let _ = List.map(core_members(st), fn m -> Vault.set(h.members, m.node_id, m))
    let _ = Vault.set(h.meta, "links", Map.size(st.links))
    let _ = List.map(Map.entries(st.certs), fn kv -> match kv do (k, c) -> Vault.set(h.certs, k, c) end)
    let _ = List.map(Vault.keys(h.certs), fn k ->
      if Map.contains_key(st.certs, k, Map.str_cmp) do () else Vault.drop(h.certs, k) end)
    let _ = List.map(st.revs, fn r -> Vault.set(h.revs, Bytes.to_hex(r.signature), r.rev))
    let _ = List.map(Vault.keys(h.links), fn k ->
      if Map.contains_key(st.links, k, Map.str_cmp) do () else Vault.drop(h.links, k) end)
    let _ = List.map(Map.entries(st.links), fn kv -> match kv do (k, l) -> Vault.set(h.links, k, l) end)
    -- Our own present bindings from an earlier creation: retire_stale keeps
    -- this at 0 once the registry has synced (observable for tests).
    let stale = List.length(List.filter(GlobalRegistry.all_entries(st.reg), fn kv ->
      match kv do (_n, e) -> e.present && e.node_id == st.me && e.creation != st.cfg.creation end))
    let _ = Vault.set(h.meta, "stale_bindings", stale)
    let _ = List.map(Vault.keys(h.names), fn k ->
      if Map.contains_key(st.vis, k, Map.str_cmp) do () else Vault.drop(h.names, k) end)
    discard(List.map(Map.entries(st.vis), fn kv -> match kv do (k, p) -> Vault.set(h.names, k, p) end))
  end

  -- ── tasks ──────────────────────────────────────────────────────────────

  pfn split_addr(addr : String) : Option((String, Int)) do
    match String.split_first(addr, ":") do
      None -> None
      Some((host, p)) ->
        match String.to_int(p) do
          Ok(port) -> Some((host, port))
          Err(_) -> None
        end
    end
  end

  pfn refused_msg(e : String) : Bool do
    String.contains(e, "refused")
  end

  pfn dial_one(h : CnHandle, cfg : CnConfig, me : NodeIdentity.Identity, host : String, port : Int, role : String)
      : Result((Int, NetKernel.Authed), (String, Bool)) do
    match Socket.connect_timeout(host, port, cfg.dial_timeout_ms) do
      Err(e) ->
        let msg = Socket.error_message(e)
        Err((msg, refused_msg(msg)))
      Ok(fd) ->
        match NetKernel.handshake_auth(fd, me, cfg.auth, NetKernel.fresh_nonce(), role,
                                       cfg.advertise, cfg.handshake_timeout_ms) do
          Err(e) ->
            tcp_close(fd)
            security(h, HandshakeRejected(host ++ ":" ++ int_to_string(port), e))
            Err((e, false))
          Ok(a) -> Ok((fd, a))
        end
    end
  end

  pfn security(h : CnHandle, ev : SecurityEvent) : () do
    discard(List.map(Vault.all(h.sec), fn kv -> match kv do (_k, f) -> f(ev) end))
  end

  -- Open a pair to [addr]: control, then data (the order the acceptor's
  -- pairing does not depend on, but a pre-split peer would).
  pfn dial(node, h : CnHandle, cfg : CnConfig, me : NodeIdentity.Identity, addr : String) : Int do
    match split_addr(addr) do
      None ->
        send(node, DialFailed(addr, unix_time_ms(), false))
        0
      Some((host, port)) ->
        match dial_one(h, cfg, me, host, port, Handshake.role_control()) do
          Err((_, refused)) ->
            send(node, DialFailed(addr, unix_time_ms(), refused))
            0
          Ok((cfd, a)) ->
            let peer = a.identity
            let peer_addr = a.addr
            match dial_one(h, cfg, me, host, port, Handshake.role_data()) do
              Err((_, refused)) ->
                tcp_close(cfd)
                send(node, DialFailed(addr, unix_time_ms(), refused))
                0
              Ok((dfd, a2)) ->
                if a2.identity.node_id != peer.node_id do
                  -- Two dials of one address reached two nodes: trust neither.
                  tcp_close(cfd)
                  tcp_close(dfd)
                  send(node, DialFailed(addr, unix_time_ms(), false))
                  0
                else if peer.node_id == node_id_of(cfg.name) do
                  -- We dialled ourselves (a seed list naming this node).
                  tcp_close(cfd)
                  tcp_close(dfd)
                  send(node, SeedIsSelf(addr))
                  0
                else
                  send(node, Dialed(addr, peer.node_id, peer.name, peer_addr, peer.incarnation, cfd, dfd, a.cert))
                  1
                end end
            end
        end
    end
  end

  -- The control reader. SWIM, member and registry frames go to the node
  -- actor (the core's); the data plane's control frames are handled here,
  -- in the reader's own turn, since they touch no core state:
  --   7 MONITOR_REQ   register the remote watcher with the C registry. With
  --                   fd -1: the fire's own write then fails at once and it
  --                   waits in the registry's pending list, which the node
  --                   resends through this link's control writer -- every
  --                   byte on a control socket has ONE writer
  --   8 MONITOR_FIRE  a monitored process died: call the local watchers,
  --                   ack (every copy: the resend is at-least-once)
  --   10 DELIVERY_FAILED  to the failure handler
  --   11 CREDIT       to this link's data queue
  --   12 MONITOR_ACK  forget the pending fire
  pfn read_control(node, h : CnHandle, l : CnLink) : Int do
    let _ = PeerReader.serve(l.cfd, Nil, fn (tag, frame) -> do
      if tag == 7 do
        match DistLink.decode_req(frame) do
          Ok((_claimed, watcher_ref, target_pid)) -> dist_monitor_register(target_pid, l.node_id, watcher_ref, -1)
          Err(_) -> ()
        end
      else if tag == 8 do
        on_fire(h, l, frame)
      else if tag == 10 do
        match NodeSend.decode_failed(frame) do
          Ok((seq, reason)) ->
            match Vault.get(h.failed, "f") do
              Some(f) -> f(seq, reason)
              None -> ()
            end
          Err(_) -> ()
        end
      else if tag == 11 do
        match NodeQueue.decode_credit(frame) do
          Ok(total) ->
            match Vault.get(h.qs, "q" ++ int_to_string(l.cfd)) do
              Some(w) -> NodeQueue.credit((pid_of_int(w), l.dfd), total)
              None -> ()
            end
          Err(_) -> ()
        end
      else if tag == 12 do
        match DistLink.decode_ack(frame) do
          Ok((target_pid, watcher_ref)) -> dist_monitor_ack(target_pid, watcher_ref)
          Err(_) -> ()
        end
      else
        discard(send(node, CtlFrame(l.node_id, l.gen, tag, frame)))
      end end end end end
      Ok(true)
    end)
    send(node, LinkClosed(l.node_id, l.gen))
    release_link(h, l, 3)
    0
  end

  -- The data reader: every ACTOR_MSG goes to its route -- by destination
  -- pid, else by message type -- in this reader's turn (the node actor is
  -- never on the data path). A stale creation, no route, or a route's Err is
  -- answered with DELIVERY_FAILED on the control connection. Consumption is
  -- announced with CREDIT (the receiver half of NodeQueue's flow control).
  -- When the connection ends, every close handler hears (peer, why): why is
  -- the cause the node recorded before shutting it ("node X dead: ...", or
  -- "replaced"), else "connection lost". Told from THIS task, behind every
  -- delivery it made, so a route that forwards both to one mailbox sees the
  -- close after the last delivery (the ordering SessionNode's drain rule
  -- depends on).
  pfn read_data(node, h : CnHandle, creation : Int, l : CnLink) : Int do
    let _ = PeerReader.serve(l.dfd, Nil, fn (tag, frame) -> do
      if tag == NodeSend.tag_actor_msg() do
        match NodeSend.decode_msg(frame) do
          Err(_) -> ()
          Ok(d) ->
            announce_consumed(h, l, List.length(frame) + 4)
            let outcome = if d.to_creation != creation do
              Err("stale creation " ++ int_to_string(d.to_creation) ++ ", node is at " ++ int_to_string(creation))
            else deliver_local(h, d) end
            match outcome do
              Ok(_) -> ()
              Err(reason) -> discard(send(pid_of_int(l.cw), CtlWrite(NodeSend.encode_failed(d.seq, reason))))
            end
        end
      else ()
      end
      Ok(true)
    end)
    let why = Vault.get_or(h.causes, "c" ++ int_to_string(l.cfd), "connection lost")
    Vault.drop(h.causes, "c" ++ int_to_string(l.cfd))
    discard(List.map(Vault.all(h.closes), fn kv -> match kv do (_k, f) -> f(l.node_id, why) end))
    send(node, LinkClosed(l.node_id, l.gen))
    release_link(h, l, 3)
    0
  end

  pfn deliver_local(h : CnHandle, d : NodeSend.Delivery) : Result((), String) do
    match Vault.get(h.routes, "p" ++ int_to_string(d.to_local_pid)) do
      Some(f) -> f(d)
      None ->
        match Vault.get(h.routes, "t" ++ d.type_tag) do
          Some(f) -> f(d)
          None -> Err("no route to pid " ++ int_to_string(d.to_local_pid) ++ " for " ++ d.type_tag)
        end
    end
  end

  -- CREDIT every quarter budget consumed (NodeQueue.consumed's rule), sent
  -- through the control writer rather than written to the socket directly.
  pfn announce_consumed(h : CnHandle, l : CnLink, len : Int) : () do
    let key = "credit" ++ int_to_string(l.cfd)
    let total = Vault.incr(h.meta, key, len)
    let last = Vault.get_or(h.meta, key ++ "_sent", 0)
    if total - last >= data_budget() / 4 do
      Vault.set(h.meta, key ++ "_sent", total)
      discard(send(pid_of_int(l.cw), CtlWrite(NodeQueue.encode_credit(total))))
    else () end
  end

  -- ── remote monitors ────────────────────────────────────────────────────
  -- A local watcher of a remote process is a closure under
  -- "m<node>|<target_pid>|<ref>"; the ref is what goes on the wire as the
  -- watcher pid (MONITOR_REQ's third field), so a fire for a target reaches
  -- every watcher of it here and each is acked by its ref.

  pfn mkey(node_id : String, target_pid : Int) : String do
    "m" ++ node_id ++ "|" ++ int_to_string(target_pid) ++ "|"
  end

  pfn ref_of_key(k : String) : Int do
    match List.reverse(String.split(k, "|")) do
      Cons(r, _) ->
        match String.to_int(r) do
          Ok(n) -> n
          Err(_) -> 0
        end
      Nil -> 0
    end
  end

  pfn on_fire(h : CnHandle, l : CnLink, frame : List(Int)) : () do
    match DistLink.decode_fire(frame) do
      Err(_) -> ()
      Ok((target_pid, reason)) ->
        let prefix = mkey(l.node_id, target_pid)
        let live = List.filter(Vault.all(h.downs), fn kv -> match kv do (k, _f) -> String.starts_with(k, prefix) end)
        let refs = List.map(live, fn kv -> match kv do (k, _f) -> ref_of_key(k) end)
        let _ = List.map(live, fn kv ->
          match kv do
            (k, f) ->
              Vault.drop(h.downs, k)
              f(reason)
          end)
        -- Remember whom we delivered to, so a resent copy is acked too.
        let fkey = "f" ++ l.node_id ++ "|" ++ int_to_string(target_pid)
        let all_refs = List.dedup(List.append(refs, Vault.get_or(h.fired, fkey, Nil)))
        Vault.set(h.fired, fkey, all_refs)
        discard(List.map(all_refs, fn r -> send(pid_of_int(l.cw), CtlWrite(DistLink.encode_ack(target_pid, r)))))
    end
  end

  -- Every remote monitor on a node that just went Dead fires NodeDown here.
  pfn monitors_node_down(h : CnHandle, node_id : String) : () do
    let prefix = "m" ++ node_id ++ "|"
    discard(List.map(Vault.all(h.downs), fn kv ->
      match kv do
        (k, f) ->
          if String.starts_with(k, prefix) do
            Vault.drop(h.downs, k)
            f(DistLink.NodeDown)
          else () end
      end))
  end

  -- Resend every pending (fired, unacked) MONITOR_FIRE to its watcher's
  -- current link, once a second.
  pfn resend_fires(st : CnState, h : CnHandle, now : Int) : () do
    if now < Vault.get_or(h.meta, "resend_at", 0) do () else
      Vault.set(h.meta, "resend_at", now + 1000)
      discard(List.map(dist_monitor_pending(), fn entry ->
        match entry do
          (target_pid, (watcher_node, (_ref, (rtag, rmsg)))) ->
            match Map.get(st.links, watcher_node, Map.str_cmp) do
              Some(l) -> discard(send(pid_of_int(l.cw), CtlWrite(DistLink.encode_fire(target_pid, DistLink.reason_of_tag(rtag, rmsg)))))
              None -> ()
            end
        end))
    end
  end

  pfn handshake_in(node, h : CnHandle, cfg : CnConfig, me : NodeIdentity.Identity, fd : Int) : Int do
    match NetKernel.handshake_auth(fd, me, cfg.auth, NetKernel.fresh_nonce(), Handshake.role_control(),
                                   cfg.advertise, cfg.handshake_timeout_ms) do
      Err(e) ->
        tcp_close(fd)
        -- The stop() wake-up connection says nothing and closes: not an attack.
        if Vault.get(h.meta, "stopped") == None do security(h, HandshakeRejected("inbound", e)) else () end
        0
      Ok(a) ->
        let peer = a.identity
        send(node, Accepted(fd, peer.node_id, peer.name, a.role, a.addr, peer.incarnation, a.cert))
        1
    end
  end

  pfn accept_loop(node, h : CnHandle, cfg : CnConfig, me : NodeIdentity.Identity, listen_fd : Int, meta : Vault(Int)) : Int do
    match tcp_accept(listen_fd) do
      Err(_) -> 0
      Ok(fd) ->
        if Vault.get(meta, "stopped") != None do
          tcp_close(fd)
          tcp_close(listen_fd)
          0
        else
          let _ = task_spawn(fn _ -> handshake_in(node, h, cfg, me, fd))
          accept_loop(node, h, cfg, me, listen_fd, meta)
        end
    end
  end

  pfn tick_loop(node, tick_ms : Int, meta : Vault(Int)) : Int do
    sleep_ms(tick_ms)
    if Vault.get(meta, "stopped") != None do
      0
    else
      send(node, Tick(unix_time_ms()))
      tick_loop(node, tick_ms, meta)
    end
  end

  -- ── the capability ─────────────────────────────────────────────────────

  -- A running node is a `Cap(ClusterNode.Live)` (D35 of
  -- specs/plans/2026-09-21-distributed-authority-and-deploys-plan.md), on the
  -- model of `Cap(Session.Live)`: `start` mints it over the node's `CnHandle`
  -- record with the real dictionary (`ops_of`), and every public operation
  -- below dispatches through `cap_dict`. A test attaches its own dictionary
  -- with `attach(io, ops)` -- membership, names and the data plane then come
  -- from the test, with no sockets. `CnHandle` stays the dictionary's backing
  -- value: the node actor, the readers and the Vault mirrors all still work on
  -- it, and the Vault reads (`members`, `lookup`, `queue_for`, ...) cost what
  -- they did plus one indirect call.
  --
  -- One field per operation; `global_pid` and `await_members` are derived
  -- (from `node_id`/`creation` and from `members`). `node_id` is this node's
  -- id; `next_id(key)` is a per-node counter (SessionAP numbers its sessions
  -- with it).
  type ClusterOps = {
    node_id            : String,
    stop               : () -> (),
    subscribe          : (NodeEvent -> Unit) -> Int,
    unsubscribe        : Int -> (),
    members            : () -> List(NodeInfo),
    all_members        : () -> List(Member),
    addr_of            : String -> Option(String),
    name_of            : String -> Option(String),
    link_count         : () -> Int,
    register           : String -> Int -> Result((), RegisterError),
    unregister         : String -> (),
    lookup             : String -> Option(GlobalPid.Pid),
    names              : () -> List(String),
    watch              : String -> (NameEvent -> Unit) -> Int,
    unwatch            : Int -> (),
    stale_bindings     : () -> Int,
    creation           : () -> Int,
    next_id            : String -> Int,
    queue_for          : String -> Option((Pid(NodeQueue.WriterState), Int)),
    send_msg           : GlobalPid.Pid -> String -> List(Int) -> NodeQueue.Policy -> Result(Int, NodeQueue.EnqueueError),
    route              : Int -> (NodeSend.Delivery -> Result((), String)) -> String,
    route_type         : String -> (NodeSend.Delivery -> Result((), String)) -> String,
    unroute            : String -> (),
    on_peer_closed     : (String -> String -> Unit) -> Int,
    off_peer_closed    : Int -> (),
    on_delivery_failed : (Int -> String -> Unit) -> (),
    monitor_remote     : GlobalPid.Pid -> (DistLink.DownReason -> Unit) -> Result(Int, String),
    demonitor_remote   : GlobalPid.Pid -> Int -> (),
    peer_cert          : String -> Option(NodeCert.Cert),
    frames_rejected    : () -> Int,
    revoke             : String -> Result((), String),
    revocations        : () -> List(NodeCert.Revocation),
    on_security_event  : (SecurityEvent -> Unit) -> Int,
    off_security_event : Int -> ()
  }

  proof cap Live with ClusterOps

  doc """
  Attach a cluster dictionary. With `start`, the only way to obtain a
  `Cap(ClusterNode.Live)`; this one is the test seam: a test builds `ops`
  (usually `{ ClusterNode.ops_stub(id) with members: ..., subscribe: ... }`)
  and hands the cap to code written against a real node.
  """
  fn attach(io : Cap(IO), ops : ClusterOps) : Cap(ClusterNode.Live) do
    cap_impl(mint_cap(io), ops)
  end

  pfn unsupported(op : String) do
    panic("ClusterNode: this cluster dictionary does not provide `" ++ op ++ "`")
  end

  doc """
  A dictionary for node [node_id] in which every operation panics, naming
  itself. Override the fields a test uses with record update.
  """
  fn ops_stub(node_id : String) : ClusterOps do
    { node_id: node_id,
      stop: fn _ -> unsupported("stop"),
      subscribe: fn _ -> unsupported("subscribe"),
      unsubscribe: fn _ -> unsupported("unsubscribe"),
      members: fn _ -> unsupported("members"),
      all_members: fn _ -> unsupported("all_members"),
      addr_of: fn _ -> unsupported("addr_of"),
      name_of: fn _ -> unsupported("name_of"),
      link_count: fn _ -> unsupported("link_count"),
      register: fn (_, _) -> unsupported("register"),
      unregister: fn _ -> unsupported("unregister"),
      lookup: fn _ -> unsupported("lookup"),
      names: fn _ -> unsupported("names"),
      watch: fn (_, _) -> unsupported("watch"),
      unwatch: fn _ -> unsupported("unwatch"),
      stale_bindings: fn _ -> unsupported("stale_bindings"),
      creation: fn _ -> unsupported("creation"),
      next_id: fn _ -> unsupported("next_id"),
      queue_for: fn _ -> unsupported("queue_for"),
      send_msg: fn (_, _, _, _) -> unsupported("send_msg"),
      route: fn (_, _) -> unsupported("route"),
      route_type: fn (_, _) -> unsupported("route_type"),
      unroute: fn _ -> unsupported("unroute"),
      on_peer_closed: fn _ -> unsupported("on_peer_closed"),
      off_peer_closed: fn _ -> unsupported("off_peer_closed"),
      on_delivery_failed: fn _ -> unsupported("on_delivery_failed"),
      monitor_remote: fn (_, _) -> unsupported("monitor_remote"),
      demonitor_remote: fn (_, _) -> unsupported("demonitor_remote"),
      peer_cert: fn _ -> unsupported("peer_cert"),
      frames_rejected: fn _ -> unsupported("frames_rejected"),
      revoke: fn _ -> unsupported("revoke"),
      revocations: fn _ -> unsupported("revocations"),
      on_security_event: fn _ -> unsupported("on_security_event"),
      off_security_event: fn _ -> unsupported("off_security_event") }
  end

  -- The real dictionary: every operation over the node's backing record.
  pfn ops_of(h : CnHandle) : ClusterOps do
    { node_id: h.node_id,
      stop: fn _ -> h_stop(h),
      subscribe: fn f -> h_subscribe(h, f),
      unsubscribe: fn id -> Vault.drop(h.subs, int_to_string(id)),
      members: fn _ -> h_members(h),
      all_members: fn _ -> List.map(Vault.all(h.members), fn kv -> match kv do (_k, m) -> m end),
      addr_of: fn id -> h_addr_of(h, id),
      name_of: fn id -> h_name_of(h, id),
      link_count: fn _ -> Vault.get_or(h.meta, "links", 0),
      register: fn (name, p) -> h_register(h, name, p),
      unregister: fn name -> discard(send(node_pid(h), Unregister(name))),
      lookup: fn name -> Vault.get(h.names, name),
      names: fn _ -> Vault.keys(h.names),
      watch: fn (name, f) -> h_watch(h, name, f),
      unwatch: fn id -> h_unwatch(h, id),
      stale_bindings: fn _ -> Vault.get_or(h.meta, "stale_bindings", 0),
      creation: fn _ -> Vault.get_or(h.meta, "creation", 0),
      next_id: fn key -> Vault.incr(h.meta, "next_id#" ++ key, 1),
      queue_for: fn id -> h_queue_for(h, id),
      send_msg: fn (to, tag, payload, policy) -> h_send_msg(h, to, tag, payload, policy),
      route: fn (pid, deliver) -> h_route(h, "p" ++ int_to_string(pid), deliver),
      route_type: fn (tag, deliver) -> h_route(h, "t" ++ tag, deliver),
      unroute: fn key -> Vault.drop(h.routes, key),
      on_peer_closed: fn f -> h_on_peer_closed(h, f),
      off_peer_closed: fn id -> Vault.drop(h.closes, int_to_string(id)),
      on_delivery_failed: fn f -> Vault.set(h.failed, "f", f),
      monitor_remote: fn (target, on_down) -> h_monitor_remote(h, target, on_down),
      demonitor_remote: fn (target, r) -> Vault.drop(h.downs, mkey(target.node_id, target.local_pid) ++ int_to_string(r)),
      peer_cert: fn id -> Vault.get(h.certs, id),
      frames_rejected: fn _ -> Vault.get_or(h.meta, "frames_rejected", 0),
      revoke: fn token -> h_revoke(h, token),
      revocations: fn _ -> List.map(Vault.all(h.revs), fn kv -> match kv do (_k, r) -> r end),
      on_security_event: fn f -> h_on_security_event(h, f),
      off_security_event: fn id -> Vault.drop(h.sec, int_to_string(id)) }
  end

  pfn no_cluster() do
    panic("ClusterNode: no cluster dictionary attached to this capability")
  end

  pfn ops(c : Cap(ClusterNode.Live)) : ClusterOps do
    match cap_dict(c) do
      Some(d) -> d
      None -> no_cluster()
    end
  end

  -- ── the node behind the real dictionary ────────────────────────────────

  pfn h_stop(h : CnHandle) : () do
    Vault.set(h.meta, "stopped", 1)
    send(node_pid(h), Shutdown())
    -- Wake the acceptor, parked in tcp_accept, with a connection of our
    -- own: it sees the stop flag and returns. (Closing the listen socket
    -- under a parked accept does not wake it on every platform.)
    match split_addr(h.advertise) do
      Some((_host, port)) ->
        match Socket.connect_timeout("127.0.0.1", port, 500) do
          Ok(fd) -> tcp_close(fd)
          Err(_) -> ()
        end
      None -> ()
    end
    -- The acceptor closes the listen socket itself once it sees the flag:
    -- closing it here could land between the wake-up connection and the
    -- scheduler delivering the acceptor's readiness, and a close drops the
    -- fd's kqueue/epoll registration -- the acceptor then never wakes and
    -- the process never exits (seen 2 in 8 runs of cluster_stall).
  end

  pfn h_subscribe(h : CnHandle, on_event : NodeEvent -> Unit) : Int do
    let id = Vault.incr(h.meta, "next_sub", 1)
    Vault.set(h.subs, int_to_string(id), on_event)
    let _ = List.map(h_members(h), fn i -> on_event(NodeUp(i)))
    id
  end

  pfn h_members(h : CnHandle) : List(NodeInfo) do
    List.filter_map(Vault.all(h.members), fn kv ->
      match kv do
        (_k, m) ->
          if m.node_id == h.node_id do None
          else
            match m.status do
              Alive -> Some(info_of(m))
              _ -> None
            end
          end
      end)
  end

  pfn h_addr_of(h : CnHandle, node_id : String) : Option(String) do
    match Vault.get(h.members, node_id) do
      Some(m) -> if String.is_empty(m.addr) do None else Some(m.addr) end
      None -> None
    end
  end

  pfn h_name_of(h : CnHandle, node_id : String) : Option(String) do
    match Vault.get(h.members, node_id) do
      Some(m) -> Some(m.name)
      None -> None
    end
  end

  pfn watch_sep() : String do "#watch#" end

  pfn h_register(h : CnHandle, name : String, p : Int) : Result((), RegisterError) do
    if Vault.get(h.meta, "stopped") != None do
      Err(Stopped)
    else
      let taken = match Vault.get(h.names, name) do
        Some(holder) -> if holder.node_id == h.node_id && holder.local_pid == p do None else Some(holder) end
        None -> None
      end
      match taken do
        Some(holder) -> Err(Taken(holder))
        None ->
          let w = spawn(RegWatch)
          send(w, WatchPid(h.pid, p))
          let _ = monitor(w, pid_of_int(p))
          send(node_pid(h), Register(name, p, pid_to_int(w)))
          Ok(())
      end
    end
  end

  pfn h_watch(h : CnHandle, name : String, on_event : NameEvent -> Unit) : Int do
    let id = Vault.incr(h.meta, "next_watch", 1)
    Vault.set(h.watches, name ++ watch_sep() ++ int_to_string(id), on_event)
    match Vault.get(h.names, name) do
      Some(p) -> on_event(Bound(name, p))
      None -> ()
    end
    id
  end

  pfn h_unwatch(h : CnHandle, id : Int) : () do
    let suffix = watch_sep() ++ int_to_string(id)
    discard(List.map(Vault.keys(h.watches), fn k ->
      if String.ends_with(k, suffix) do Vault.drop(h.watches, k) else () end))
  end

  pfn h_queue_for(h : CnHandle, node_id : String) : Option((Pid(NodeQueue.WriterState), Int)) do
    if node_id == h.node_id do loopback(h) else
    match Vault.get(h.links, node_id) do
      None -> None
      Some(l) ->
        match Vault.get(h.qs, "q" ++ int_to_string(l.cfd)) do
          Some(w) -> Some((pid_of_int(w), l.dfd))
          None -> None
        end
    end end
  end

  -- The LOOPBACK link: a node's queue to itself (made once, at `start`, so
  -- every sender to this node shares one queue and one order). Its writer
  -- hands each frame to `deliver_loopback` instead of a socket, and credit
  -- is bypassed: there is no peer to grant it. Two roles of one session on
  -- one node, and an initiator inviting its own node's offer, go through it
  -- (distributed-deploys plan II.3).
  pfn loopback(h : CnHandle) : Option((Pid(NodeQueue.WriterState), Int)) do
    match Vault.get(h.qs, "loop") do
      Some(w) -> Some((pid_of_int(w), Vault.get_or(h.meta, "loop_fd", -1)))
      None -> None
    end
  end

  -- An ACTOR_MSG this node sent itself: routed as the data reader routes one
  -- from a peer; a failure goes to the DELIVERY_FAILED handler directly.
  pfn deliver_loopback(h : CnHandle, frame : Bytes) : () do
    match NetFrame.decode(Bytes.to_list(frame)) do
      None -> ()
      Some((body, _)) ->
        match NodeSend.decode_msg(body) do
          Err(_) -> ()
          Ok(d) ->
            let outcome = if d.to_creation != Vault.get_or(h.meta, "creation", 0) do
              Err("stale creation " ++ int_to_string(d.to_creation) ++ ", node is at " ++ int_to_string(Vault.get_or(h.meta, "creation", 0)))
            else deliver_local(h, d) end
            match outcome do
              Ok(_) -> ()
              Err(reason) ->
                match Vault.get(h.failed, "f") do
                  Some(f) -> f(d.seq, reason)
                  None -> ()
                end
            end
        end
    end
  end

  pfn h_send_msg(h : CnHandle, to : GlobalPid.Pid, type_tag : String, payload : List(Int),
                 policy : NodeQueue.Policy) : Result(Int, NodeQueue.EnqueueError) do
    match h_queue_for(h, to.node_id) do
      None -> Err(NodeQueue.NoConnection)
      Some(q) ->
        let seq = Vault.incr(h.meta, "send_seq", 1)
        match NodeQueue.cast(q, seq, to, type_tag, payload, policy) do
          Ok(_) -> Ok(seq)
          Err(e) -> Err(e)
        end
    end
  end

  pfn h_route(h : CnHandle, k : String, deliver : NodeSend.Delivery -> Result((), String)) : String do
    Vault.set(h.routes, k, deliver)
    k
  end

  pfn h_on_peer_closed(h : CnHandle, f : String -> String -> Unit) : Int do
    let id = Vault.incr(h.meta, "next_close", 1)
    Vault.set(h.closes, int_to_string(id), f)
    id
  end

  pfn live_revoked(revs : Vault(NodeCert.Revocation), c : NodeCert.Cert) : Bool do
    NodeCert.is_revoked(c, List.map(Vault.all(revs), fn kv -> match kv do (_k, r) -> r end))
  end

  pfn with_live_revocations(cfg : CnConfig, revs : Vault(NodeCert.Revocation)) : CnConfig do
    match cfg.auth do
      ClusterAuth.Certified(cr) ->
        let inner = cr.revoked
        let checked = { cr with revoked: fn c -> inner(c) || live_revoked(revs, c) }
        { cfg with auth: ClusterAuth.Certified(checked) }
      ClusterAuth.Secret(_) -> cfg
    end
  end

  pfn h_revoke(h : CnHandle, token : String) : Result((), String) do
    if Bytes.is_empty(h.op_pub) do Err("cluster_node: this node runs in shared-secret mode; revocations need certificate mode")
    else
      match NodeCert.revocation_from_text(token) do
        Err(e) -> Err("cluster_node: " ++ e)
        Ok(r) ->
          match NodeCert.verify_revocation(r, h.op_pub) do
            Err(e) -> Err("cluster_node: " ++ e)
            Ok(_) ->
              send(node_pid(h), Revoke(r))
              Ok(())
          end
      end
    end
  end

  pfn on_bad_frame(h : CnHandle, fd : Int, n : Int) : () do
    match List.find(Vault.all(h.links), fn kv -> match kv do (_k, l) -> l.cfd == fd || l.dfd == fd end) do
      Some((id, _l)) ->
        let _ = Vault.incr(h.meta, "frames_rejected", 1)
        security(h, FrameRejected(id, n))
      None -> ()
    end
  end

  pfn h_on_security_event(h : CnHandle, f : SecurityEvent -> Unit) : Int do
    let id = Vault.incr(h.meta, "next_sec", 1)
    Vault.set(h.sec, int_to_string(id), f)
    id
  end

  pfn h_monitor_remote(h : CnHandle, target : GlobalPid.Pid, on_down : DistLink.DownReason -> Unit) : Result(Int, String) do
    match Vault.get(h.links, target.node_id) do
      None -> Err("cluster_node: no link to " ++ target.node_id)
      Some(l) ->
        let r = Vault.incr(h.meta, "next_monitor", 1)
        Vault.set(h.downs, mkey(target.node_id, target.local_pid) ++ int_to_string(r), on_down)
        send(pid_of_int(l.cw), CtlWrite(DistLink.encode_req(h.node_id, r, target.local_pid)))
        Ok(r)
    end
  end

  -- ── the API ────────────────────────────────────────────────────────────

  doc """
  Start a node: listen on `cfg.listen_port`, begin SWIM, dial the seeds.
  Returns at once -- a node that reaches no seed runs as a cluster of one
  and keeps redialling them (use `subscribe` or `await_members` to wait for
  peers). Err only if the listen socket cannot be opened. The node is a
  `Cap(ClusterNode.Live)` minted from [io]; pass it on to everything that
  uses the cluster.
  """
  fn start(io : Cap(IO), cfg : CnConfig) : Result(Cap(ClusterNode.Live), String) do
    match tcp_listen(cfg.listen_port) do
      Err(e) -> Err("cluster_node: listen on " ++ int_to_string(cfg.listen_port) ++ ": " ++ e)
      Ok(listen_fd) ->
        let node = spawn(ClusterNodeActor)
        -- The node's Vaults hold its routes, names, membership and its
        -- `stopped` flag: Cap(ClusterNode.Live) is meant to be the only way
        -- in (D35). A Vault name is a global handle anyone with IO.Mut can
        -- `Vault.whereis`, so the name carries 128 random bits; name + pid
        -- alone was found by a scan over the pid range.
        let tag = cfg.name ++ "." ++ int_to_string(pid_to_int(node)) ++ "." ++ Crypto.random_hex(16)
        let h = { pid: pid_to_int(node), name: cfg.name, node_id: node_id_of(cfg.name), advertise: cfg.advertise,
                  members: Vault.new("cluster_node_members_" ++ tag),
                  names: Vault.new("cluster_node_names_" ++ tag),
                  watches: Vault.new("cluster_node_watches_" ++ tag),
                  links: Vault.new("cluster_node_links_" ++ tag),
                  qs: Vault.new("cluster_node_qs_" ++ tag),
                  causes: Vault.new("cluster_node_causes_" ++ tag),
                  routes: Vault.new("cluster_node_routes_" ++ tag),
                  closes: Vault.new("cluster_node_closes_" ++ tag),
                  downs: Vault.new("cluster_node_downs_" ++ tag),
                  fired: Vault.new("cluster_node_fired_" ++ tag),
                  failed: Vault.new("cluster_node_failed_" ++ tag),
                  certs: Vault.new("cluster_node_certs_" ++ tag),
                  sec: Vault.new("cluster_node_sec_" ++ tag),
                  revs: Vault.new("cluster_node_revs_" ++ tag),
                  op_pub: match operator_key(cfg) do
                    Some(k) -> k
                    None -> Bytes.empty()
                  end,
                  subs: Vault.new("cluster_node_subs_" ++ tag),
                  meta: Vault.new("cluster_node_meta_" ++ tag) }
        Vault.set(h.meta, "listen_fd", listen_fd)
        Vault.set(h.meta, "creation", cfg.creation)
        match NodeQueue.start_local(fn frame -> deliver_loopback(h, frame)) do
          (w, fd) ->
            Vault.set(h.qs, "loop", pid_to_int(w))
            Vault.set(h.meta, "loop_fd", fd)
        end
        -- The handshake's revocation check reads this node's live list.
        let cfg = with_live_revocations(cfg, h.revs)
        let st0 = core_new(cfg, cfg.creation)
        mirror(st0, h)
        send(node, Boot(st0, h))
        let me = NodeIdentity.make(cfg.name, "pk-" ++ cfg.name, cfg.creation)
        let meta = h.meta
        let _ = task_spawn(fn _ -> accept_loop(node, h, cfg, me, listen_fd, meta))
        let _ = task_spawn(fn _ -> tick_loop(node, cfg.tick_ms, meta))
        -- Frames that fail their MAC on one of this node's links: counted
        -- and reported by peer (the hook is process-wide; other nodes'
        -- fds are not in our links).
        let _ = NetKernel.on_frame_rejected(fn (fd, n) -> on_bad_frame(h, fd, n))
        Ok(attach(io, ops_of(h)))
    end
  end

  doc "Stop the node: close every link and the listener, stop the ticker."
  fn stop(c : Cap(ClusterNode.Live)) : () do
    let d = ops(c)
    d.stop(())
  end

  doc "This node's id."
  fn node_id(c : Cap(ClusterNode.Live)) : String do
    let d = ops(c)
    d.node_id
  end

  doc """
  Call [on_event] (in the node actor's turn: it must only `send`) for every
  membership change. A subscriber added late gets `NodeUp` at once for
  every member currently Alive. Returns an id for `unsubscribe`.
  """
  fn subscribe(c : Cap(ClusterNode.Live), on_event : NodeEvent -> Unit) : Int do
    let d = ops(c)
    d.subscribe(on_event)
  end

  fn unsubscribe(c : Cap(ClusterNode.Live), id : Int) : () do
    let d = ops(c)
    d.unsubscribe(id)
  end

  doc "Every other node this node knows as Alive."
  fn members(c : Cap(ClusterNode.Live)) : List(NodeInfo) do
    let d = ops(c)
    d.members(())
  end

  doc "Every member this node knows of, in any status, itself included."
  fn all_members(c : Cap(ClusterNode.Live)) : List(Member) do
    let d = ops(c)
    d.all_members(())
  end

  doc "The advertised address of [node_id], if this node has heard it."
  fn addr_of(c : Cap(ClusterNode.Live), node_id : String) : Option(String) do
    let d = ops(c)
    d.addr_of(node_id)
  end

  doc "The name of [node_id], if known."
  fn name_of(c : Cap(ClusterNode.Live), node_id : String) : Option(String) do
    let d = ops(c)
    d.name_of(node_id)
  end

  doc "How many peers this node currently has a connection pair to."
  fn link_count(c : Cap(ClusterNode.Live)) : Int do
    let d = ops(c)
    d.link_count(())
  end

  doc """
  A per-node counter: the next value (from 1) under [key]. Code that needs
  ids unique on this node (SessionAP's session numbers) draws them here.
  """
  fn next_id(c : Cap(ClusterNode.Live), key : String) : Int do
    let d = ops(c)
    d.next_id(key)
  end

  -- ── names ──────────────────────────────────────────────────────────────

  doc """
  Register [name] -> [pid] (a process on this node) cluster-wide. Refused
  with `Taken(holder)` if another holder's binding is visible here. `Ok`
  means the binding is made here and pushed to every peer; it is not a lock
  -- a node on the far side of a partition can hold the same name, and after
  the heal one binding wins everywhere (watch the name to hear `Lost`). The
  check is against this node's view; if another binding reaches the node
  first, the registration is refused there and the name's watchers get
  `Lost(name, holder)`. A process already dead by then is not registered.
  The process is monitored: its death unregisters the name.
  """
  fn register(c : Cap(ClusterNode.Live), name : String, pid) : Result((), RegisterError) do
    let d = ops(c)
    d.register(name, pid_to_int(pid))
  end

  doc "This node's creation (its incarnation number, part of every global pid it issues)."
  fn creation(c : Cap(ClusterNode.Live)) : Int do
    let d = ops(c)
    d.creation(())
  end

  doc "A global pid for the local actor [pid] on this node (to hand to a peer as a reply address)."
  fn global_pid(c : Cap(ClusterNode.Live), pid : Int) : GlobalPid.Pid do
    let d = ops(c)
    GlobalPid.make(d.node_id, pid, d.creation(()))
  end

  doc "Unregister [name], if this node holds it. A name another node holds is left alone."
  fn unregister(c : Cap(ClusterNode.Live), name : String) : () do
    let d = ops(c)
    d.unregister(name)
  end

  doc "The process bound to [name] cluster-wide, as this node sees it (a Vault read)."
  fn lookup(c : Cap(ClusterNode.Live), name : String) : Option(GlobalPid.Pid) do
    let d = ops(c)
    d.lookup(name)
  end

  doc "Every name with a visible binding here."
  fn names(c : Cap(ClusterNode.Live)) : List(String) do
    let d = ops(c)
    d.names(())
  end

  doc """
  Call [on_event] (in the node actor's turn: it must only `send`) on every
  change to [name]'s visible binding: `Bound(name, pid)`, `Unbound(name)`,
  or `Lost(name, winner)` when a binding made on THIS node is superseded by
  another holder's (after a partition heals, say). A watcher added while the
  name is bound gets `Bound` at once. Returns an id for `unwatch`.
  """
  fn watch(c : Cap(ClusterNode.Live), name : String, on_event : NameEvent -> Unit) : Int do
    let d = ops(c)
    d.watch(name, on_event)
  end

  fn unwatch(c : Cap(ClusterNode.Live), id : Int) : () do
    let d = ops(c)
    d.unwatch(id)
  end

  doc "How many present bindings of this node's from an earlier creation the replica holds (0 once retired)."
  fn stale_bindings(c : Cap(ClusterNode.Live)) : Int do
    let d = ops(c)
    d.stale_bindings(())
  end

  fn name_event_text(ev : NameEvent) : String do
    match ev do
      Bound(n, p) -> n ++ " bound to " ++ p.node_id
      Unbound(n) -> n ++ " unbound"
      Lost(n, p) -> n ++ " lost to " ++ p.node_id
    end
  end

  -- ── the shared data plane ───────────────────────────────────────────────

  doc """
  The outbound queue of the data connection to [node_id], for
  `Node.enqueue(q, to, msg, policy)` (the typed send) or `NodeQueue.cast`.
  Every write to a data socket goes through this one writer, so this is the
  only way to send on it: `Node.send(peer, ...)` writes the socket directly
  and would interleave with the queue.
  """
  fn queue_for(c : Cap(ClusterNode.Live), node_id : String) : Option((Pid(NodeQueue.WriterState), Int)) do
    let d = ops(c)
    d.queue_for(node_id)
  end

  doc """
  Send [payload] (an encoded message of type [type_tag]) to the remote
  process [to] through its node's data queue. `Ok(seq)` means admitted, not
  delivered: a delivery failure comes back as DELIVERY_FAILED (see
  `on_delivery_failed`). `Err(NoConnection)` when this node has no link to
  [to]'s node.
  """
  fn send_msg(c : Cap(ClusterNode.Live), to : GlobalPid.Pid, type_tag : String, payload : List(Int),
              policy : NodeQueue.Policy) : Result(Int, NodeQueue.EnqueueError) do
    let d = ops(c)
    d.send_msg(to, type_tag, payload, policy)
  end

  doc """
  Deliver every ACTOR_MSG addressed to local pid [pid] to [deliver], called
  in the data reader's task (it should only `send`). Its `Err(reason)` goes
  back to the sender as DELIVERY_FAILED. Returns the key for `unroute`.
  """
  fn route(c : Cap(ClusterNode.Live), pid : Int, deliver : NodeSend.Delivery -> Result((), String)) : String do
    let d = ops(c)
    d.route(pid, deliver)
  end

  doc "As `route`, for every message of [type_tag] with no pid route (typed receivers)."
  fn route_type(c : Cap(ClusterNode.Live), type_tag : String, deliver : NodeSend.Delivery -> Result((), String)) : String do
    let d = ops(c)
    d.route_type(type_tag, deliver)
  end

  fn unroute(c : Cap(ClusterNode.Live), key : String) : () do
    let d = ops(c)
    d.unroute(key)
  end

  doc """
  Call [f](peer_node_id, why) whenever a data connection ends, from that
  connection's reader, after its last delivery. [why] is "node <name> dead:
  <cause>" when SWIM declared the peer dead, "replaced" when a duplicate pair
  was closed, else "connection lost". Returns an id for `off_peer_closed`.
  """
  fn on_peer_closed(c : Cap(ClusterNode.Live), f : String -> String -> Unit) : Int do
    let d = ops(c)
    d.on_peer_closed(f)
  end

  fn off_peer_closed(c : Cap(ClusterNode.Live), id : Int) : () do
    let d = ops(c)
    d.off_peer_closed(id)
  end

  doc "Call [f](seq, reason) for every DELIVERY_FAILED a peer sends back."
  fn on_delivery_failed(c : Cap(ClusterNode.Live), f : Int -> String -> Unit) : () do
    let d = ops(c)
    d.on_delivery_failed(f)
  end

  doc """
  Monitor the remote process [target]: [on_down] gets its DownReason once,
  when it exits (Normal/Killed/Crash) or when its node is declared dead
  (NodeDown). The fire is at-least-once on the wire and delivered once here.
  Err when this node has no link to [target]'s node.
  """
  fn monitor_remote(c : Cap(ClusterNode.Live), target : GlobalPid.Pid, on_down : DistLink.DownReason -> Unit) : Result(Int, String) do
    let d = ops(c)
    d.monitor_remote(target, on_down)
  end

  fn demonitor_remote(c : Cap(ClusterNode.Live), target : GlobalPid.Pid, r : Int) : () do
    let d = ops(c)
    d.demonitor_remote(target, r)
  end

  doc """
  Wait (polling every 50 ms) until at least [n] other nodes are Alive, or
  [timeout_ms] passes. True if they are.
  """
  fn await_members(c : Cap(ClusterNode.Live), n : Int, timeout_ms : Int) : Bool do
    if List.length(members(c)) >= n do
      true
    else
      if timeout_ms <= 0 do
        false
      else
        sleep_ms(50)
        await_members(c, n, timeout_ms - 50)
      end
    end
  end

  -- ── certificates (distributed-deploys step 11a) ──────────────────────────

  doc """
  The certificate peer [node_id] presented in its latest verified handshake
  (certificate mode), or None (shared-secret mode, or no such peer). Step
  11b checks role permissions and the raw-send flag against it.
  """
  fn peer_cert(c : Cap(ClusterNode.Live), node_id : String) : Option(NodeCert.Cert) do
    let d = ops(c)
    d.peer_cert(node_id)
  end

  doc """
  Call [f] on every security event: a handshake refused (the peer's
  certificate did not verify, it runs in the other mode, the wrong secret,
  ...). Returns an id for `off_security_event`.
  """
  fn on_security_event(c : Cap(ClusterNode.Live), f : SecurityEvent -> Unit) : Int do
    let d = ops(c)
    d.on_security_event(f)
  end

  fn off_security_event(c : Cap(ClusterNode.Live), id : Int) : () do
    let d = ops(c)
    d.off_security_event(id)
  end

  doc """
  Frames from this node's peers dropped because they failed their MAC
  (sealed connections: see specs/lang/clustering.md, "Per-frame MAC").
  """
  fn frames_rejected(c : Cap(ClusterNode.Live)) : Int do
    let d = ops(c)
    d.frames_rejected(())
  end

  doc """
  Revoke a certificate cluster-wide: [token] is `forge cluster revoke`'s
  output, signed by the operator key. The node drops any link whose
  certificate it names (the peer is reported NodeDead(_, "certificate
  revoked")), refuses that certificate's handshakes, and passes the
  revocation on to every peer. Err for a token that does not parse or is not
  the operator's, or on a shared-secret node.
  """
  fn revoke(c : Cap(ClusterNode.Live), token : String) : Result((), String) do
    let d = ops(c)
    d.revoke(token)
  end

  doc "Every revocation this node knows (from MARCH_CLUSTER_REVOCATIONS, `revoke`, or its peers)."
  fn revocations(c : Cap(ClusterNode.Live)) : List(NodeCert.Revocation) do
    let d = ops(c)
    d.revocations(())
  end

end
