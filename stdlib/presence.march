-- Presence module: per-topic user presence tracking for Channels.
--
-- Presence tracks which users are connected to a topic, with metadata.
-- Key features:
--   Multi-device: one user (key) can have multiple connections (metas).
--   Diffs: when a user joins or leaves a topic, a "presence_diff" broadcast
--          is sent.  Clients maintain a local mirror and apply diffs.
--   Pure layer: PresenceState is an immutable data structure fully testable
--               without the actor runtime.
--
-- Data model:
--   PresenceState = Map(topic, Map(key, List(PresenceMeta)))
--   key   — identifies the user (e.g. user id string)
--   meta  — arbitrary JSON string with per-device metadata
--   pid   — channel process pid (used to distinguish multi-device entries)
--
-- Pure API:
--   new_state/0               — empty PresenceState
--   track_state/5             — add a (pid, meta) entry for (topic, key)
--   untrack_state/4           — remove entries for (topic, key, pid)
--   list_state/2              — get Map(key, PresenceEntry) for a topic
--   entry_metas/1             — get the List(PresenceMeta) from an entry
--   meta_pid/1                — extract pid from a PresenceMeta
--   meta_data/1               — extract data string from a PresenceMeta
--   count_presences/2         — number of distinct keys present on a topic
--   is_present/3, connection_count/3
--   join_diff_json/2, leave_diff_json/2 — presence_diff payloads
--
-- Runtime helpers (require actor runtime):
--   track/3   — track(socket, key, meta_json): broadcast a join diff
--   untrack/3 — untrack(socket, key, meta_json): broadcast a leave diff
-- Neither updates a PresenceState; the caller keeps that with
-- track_state/untrack_state.
--
-- doc: try

mod Presence do

  -- ── PresenceMeta ──────────────────────────────────────────────────────────

  -- One presence entry for a single connection.
  --   pid  — the channel process pid for this connection
  --   data — JSON-encoded metadata string (e.g. {"name":"Alice","online_at":0})
  type PresenceMeta = PresenceMeta(Int, String)

  doc """
  One connection's presence: the channel `pid` and its JSON metadata.

  ## Examples

      march> Presence.make_meta(7, "{}")
      PresenceMeta(7, "{}")
  """
  fn make_meta(pid, data_json) do
    PresenceMeta(pid, data_json)
  end

  doc """
  The channel pid of a PresenceMeta.

  ## Examples

      march> Presence.meta_pid(Presence.make_meta(7, "{}"))
      7
  """
  fn meta_pid(m) do
    match m do | PresenceMeta(p, _) -> p end
  end

  doc """
  The JSON metadata string of a PresenceMeta.

  ## Examples

      march> Presence.meta_data(Presence.make_meta(7, "{\"device\":\"phone\"}"))
      "{\"device\":\"phone\"}"
  """
  fn meta_data(m) do
    match m do | PresenceMeta(_, d) -> d end
  end

  -- ── PresenceEntry ─────────────────────────────────────────────────────────

  -- All presence entries for one user key on a topic.
  -- Holds a list of PresenceMeta (one per active device/connection).
  type PresenceEntry = PresenceEntry(List(PresenceMeta))

  doc """
  A PresenceEntry holding `metas` (one per connection).

  ## Examples

      march> Presence.entry_metas(Presence.make_entry([Presence.make_meta(1, "{}")]))
      [PresenceMeta(1, "{}")]
  """
  fn make_entry(metas) do
    PresenceEntry(metas)
  end

  doc """
  The metas of an entry; `track_state` puts the newest connection first.

  ## Examples

      march> Presence.entry_metas(Presence.make_entry([]))
      []
  """
  fn entry_metas(e) do
    match e do | PresenceEntry(ms) -> ms end
  end

  doc """
  Number of connections (metas) in this entry. O(n).

      Presence.entry_count(Presence.make_entry([Presence.make_meta(1, "{}"), Presence.make_meta(2, "{}")]))
      -- 2
  """
  fn entry_count(e) do
    list_len_pr(entry_metas(e))
  end

  -- ── PresenceState ─────────────────────────────────────────────────────────

  -- Immutable presence state: Map(topic, Map(key, PresenceEntry)).
  -- Both levels use String keys with the standard string comparator.
  type PresenceState = PresenceState(Map(String, Map(String, PresenceEntry)))

  doc """
  An empty PresenceState: nobody is present on any topic.

  ## Examples

      march> Presence.count_presences(Presence.new_state(), "room:lobby")
      0
  """
  fn new_state() do
    PresenceState(Map.empty())
  end

  -- ── Internal helpers ──────────────────────────────────────────────────────

  pfn str_cmp(a) do fn b -> a < b end

  pfn list_len_pr(lst) do
    fn go(xs, acc) do
      match xs do
      Nil -> acc
      Cons(_, t) -> go(t, acc + 1)
      end
    end
    go(lst, 0)
  end

  pfn list_remove_meta(lst, pid) do
    match lst do
    Nil -> Nil
    Cons(m, rest) ->
      if meta_pid(m) == pid do list_remove_meta(rest, pid)
      else Cons(m, list_remove_meta(rest, pid)) end
    end
  end

  -- Get or create the inner Map(key, PresenceEntry) for a topic.
  pfn get_topic_map(pst, topic) do
    match pst do
    PresenceState(outer) ->
      match Map.get(outer, topic, str_cmp) do
      Some(inner) -> inner
      None        -> Map.empty()
      end
    end
  end

  -- ── track_state ───────────────────────────────────────────────────────────

  doc """
  Add a presence entry for `key` on `topic` with the given channel `pid` and
  `meta_json` metadata string.  Returns the updated state.
  Multiple calls with different pids add multiple entries (multi-device support).
  The new meta is prepended to the key's list. Tracking the same pid twice
  adds a second meta for it (both are removed by one `untrack_state`).

      let s = Presence.track_state(Presence.new_state(), "room:lobby", "alice", 7, "{}")
      let s2 = Presence.track_state(s, "room:lobby", "alice", 8, "{}")
      Presence.count_presences(s2, "room:lobby")             -- 1
      Presence.connection_count(s2, "room:lobby", "alice")   -- 2
  """
  fn track_state(pst, topic, key, pid, meta_json) do
    match pst do
    PresenceState(outer) ->
      do
        let inner    = get_topic_map(pst, topic)
        let new_meta = PresenceMeta(pid, meta_json)
        let entry    = match Map.get(inner, key, str_cmp) do
          Some(PresenceEntry(metas)) -> PresenceEntry(Cons(new_meta, metas))
          None                       -> PresenceEntry(Cons(new_meta, Nil))
        end
        let new_inner = Map.insert(inner, key, entry, str_cmp)
        PresenceState(Map.insert(outer, topic, new_inner, str_cmp))
      end
    end
  end

  -- ── untrack_state ─────────────────────────────────────────────────────────

  doc """
  Remove all presence metas for `pid` under `key` on `topic`.
  If the entry becomes empty, the key is removed from the topic map.
  Returns the updated state; unchanged when the key is not present (an
  unknown pid under a present key re-stores the same entry).

      let s = Presence.track_state(Presence.new_state(), "room:lobby", "alice", 7, "{}")
      Presence.is_present(Presence.untrack_state(s, "room:lobby", "alice", 7), "room:lobby", "alice")   -- false

  ## Examples

      march> Presence.count_presences(Presence.untrack_state(Presence.new_state(), "room:lobby", "alice", 7), "room:lobby")
      0
  """
  fn untrack_state(pst, topic, key, pid) do
    match pst do
    PresenceState(outer) ->
      do
        let inner = get_topic_map(pst, topic)
        match Map.get(inner, key, str_cmp) do
        None -> pst
        Some(PresenceEntry(metas)) ->
          do
            let trimmed = list_remove_meta(metas, pid)
            let new_inner = match trimmed do
              Nil -> Map.remove(inner, key, str_cmp)
              _   -> Map.insert(inner, key, PresenceEntry(trimmed), str_cmp)
            end
            PresenceState(Map.insert(outer, topic, new_inner, str_cmp))
          end
        end
      end
    end
  end

  -- ── list_state ────────────────────────────────────────────────────────────

  doc """
  Return the Map(key, PresenceEntry) for `topic`.
  Empty map if no one is present. A topic whose last key was untracked stays
  in the state with an empty map.

  ## Examples

      march> Map.size(Presence.list_state(Presence.new_state(), "room:lobby"))
      0
  """
  fn list_state(pst, topic) do
    match pst do
    PresenceState(outer) ->
      match Map.get(outer, topic, str_cmp) do
      Some(inner) -> inner
      None        -> Map.empty()
      end
    end
  end

  doc """
  Number of distinct user keys currently present on `topic` (a user on
  several devices counts once).

  ## Examples

      march> Presence.count_presences(Presence.new_state(), "room:lobby")
      0
  """
  fn count_presences(pst, topic) do
    Map.size(list_state(pst, topic))
  end

  doc """
  True when `key` has at least one active presence on `topic`.

  ## Examples

      march> Presence.is_present(Presence.new_state(), "room:lobby", "alice")
      false
  """
  fn is_present(pst, topic, key) do
    let inner = list_state(pst, topic)
    match Map.get(inner, key, str_cmp) do
    Some(_) -> true
    None    -> false
    end
  end

  doc """
  Number of active connections (metas) for `key` on `topic`.
  Useful for multi-device detection (> 1 means multiple devices).
  0 when the key is not present.

  ## Examples

      march> Presence.connection_count(Presence.new_state(), "room:lobby", "alice")
      0
  """
  fn connection_count(pst, topic, key) do
    let inner = list_state(pst, topic)
    match Map.get(inner, key, str_cmp) do
    Some(entry) -> entry_count(entry)
    None        -> 0
    end
  end

  -- ── Diff helpers ──────────────────────────────────────────────────────────

  doc """
  Build a JSON presence-diff string for a single join event.
  Format: {"joins":{"key":{"metas":[meta_json]}},"leaves":{}}
  The key is escaped for `"` and backslash; `meta_json` is embedded verbatim.

  ## Examples

      march> Presence.join_diff_json("alice", "{}")
      "{\"joins\":{\"alice\":{\"metas\":[{}]}},\"leaves\":{}}"
  """
  fn join_diff_json(key, meta_json) do
    string_concat(
      string_concat(
        string_concat(
          string_concat(
            "{\"joins\":{\"",
            json_escape_pr(key)),
          "\":{\"metas\":["),
        meta_json),
      "]}},\"leaves\":{}}")
  end

  doc """
  Build a JSON presence-diff string for a single leave event.
  Format: {"joins":{},"leaves":{"key":{"metas":[meta_json]}}}
  The key is escaped for `"` and backslash; `meta_json` is embedded verbatim.

  ## Examples

      march> Presence.leave_diff_json("alice", "{}")
      "{\"joins\":{},\"leaves\":{\"alice\":{\"metas\":[{}]}}}"
  """
  fn leave_diff_json(key, meta_json) do
    string_concat(
      string_concat(
        string_concat(
          string_concat(
            "{\"joins\":{},\"leaves\":{\"",
            json_escape_pr(key)),
          "\":{\"metas\":["),
        meta_json),
      "]}}}")
  end

  pfn json_escape_pr(s) do
    let s1 = string_replace_all(s, "\\", "\\\\")
    string_replace_all(s1, "\"", "\\\"")
  end

  -- ── Runtime API stubs ──────────────────────────────────────────────────────
  -- These require a running Channel socket with a channel_pid.

  doc """
  Track the current user on the socket's topic: casts a
  `ChannelBroadcast(topic, "presence_diff", join_diff_json(key, meta_json))`
  to the socket's channel pid. It does not touch any PresenceState; keep one
  with `track_state`.
  Requires actor runtime and a running PubSub.

      Presence.track(sock, "alice", "{\"device\":\"phone\"}")
  """
  fn track(sock, key, meta_json) do
    let topic = Channel.socket_topic(sock)
    let pid   = Channel.socket_channel_pid(sock)
    -- Broadcast join diff to all topic subscribers
    actor_cast(pid, ChannelBroadcast(topic, "presence_diff",
                                     join_diff_json(key, meta_json)))
  end

  doc """
  Untrack the current user from the socket's topic: casts a
  `ChannelBroadcast(topic, "presence_diff", leave_diff_json(key, meta_json))`
  to the socket's channel pid. It ALWAYS broadcasts the leave: it does not
  check whether this was the user's last connection, and it does not touch
  any PresenceState (use `untrack_state` and `connection_count` for that).
  Requires actor runtime.

      Presence.untrack(sock, "alice", "{\"device\":\"phone\"}")
  """
  fn untrack(sock, key, meta_json) do
    let topic = Channel.socket_topic(sock)
    let pid   = Channel.socket_channel_pid(sock)
    actor_cast(pid, ChannelBroadcast(topic, "presence_diff",
                                     leave_diff_json(key, meta_json)))
  end

end
