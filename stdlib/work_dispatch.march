-- WorkDispatch: capacity-aware RPC routing (P4 L6).
--
-- Routes function calls to the cluster node with the most spare capacity
-- using the power-of-two-choices algorithm. Falls back to local execution
-- when no peer is healthier by DISPATCH_THRESHOLD_MILLI (200 millis = 20%
-- of a core) or when all load readings are stale.
--
-- Load readings decay: a NodeLoad sampled_at older than LOAD_STALE_MS (10s)
-- is excluded from routing candidates.
--
-- ConsistentHash affinity: dispatch_affine routes by key hash for
-- data-local work (same key always hits the same shard node unless it's down,
-- in which case it falls back to load-aware dispatch).
mod WorkDispatch do

  pfn load_stale_ms() : Int do 10000 end
  pfn dispatch_threshold_milli() : Int do 200 end

  doc """
  Pick a dispatch target from [members]: keep the fresh loads (sampled at
  most 10 s before [now_ms]), then return whichever of the FIRST and LAST
  fresh entries scores higher under [scorer] (the first on a tie). Returns
  `None` when fewer than 2 loads are fresh. The choice is deterministic: for
  power-of-two-choices, pass a shuffled or randomly sampled [members] list
  (the transport owns the RNG), or use `pick_two`.
  """
  fn pick_dispatch_target(
    members : List(NodeLoad),
    scorer : NodeLoad -> Int,
    now_ms : Int
  ) : Option(NodeLoad) do
    let fresh = List.filter(members, fn nl ->
      now_ms - nl.sampled_at <= load_stale_ms())
    let n = List.length(fresh)
    if n < 2 do
      None
    else
      -- Pick two distinct indices without replacement using list indexing.
      -- We use the first and last elements of the fresh list as a deterministic
      -- "random" choice; real usage should pass a shuffled or randomly-sampled
      -- slice (the transport layer owns the RNG).
      let a = List.head(fresh)
      let b = List.last(fresh)
      if scorer(a) >= scorer(b) do Some(a) else Some(b) end
    end
  end

  doc """
  Like `pick_dispatch_target`, but compares the fresh loads at indices
  [idx_a] and [idx_b] (taken modulo the number of fresh loads), for a caller
  that has already sampled indices from an RNG. The two indices may name the
  same entry. Returns `None` when fewer than 2 loads are fresh, or when an
  index is negative (the remainder stays negative).
  """
  fn pick_two(
    members : List(NodeLoad),
    idx_a : Int,
    idx_b : Int,
    scorer : NodeLoad -> Int,
    now_ms : Int
  ) : Option(NodeLoad) do
    let fresh = List.filter(members, fn nl ->
      now_ms - nl.sampled_at <= load_stale_ms())
    let n = List.length(fresh)
    if n < 2 do
      None
    else
      let safe_a = idx_a - (idx_a / n) * n
      let safe_b = idx_b - (idx_b / n) * n
      match List.nth_opt(fresh, safe_a) do
        None -> None
        Some(a) ->
          match List.nth_opt(fresh, safe_b) do
            None -> None
            Some(b) ->
              if scorer(a) >= scorer(b) do Some(a) else Some(b) end
          end
      end
    end
  end

  doc """
  Route a call of [fn_ref] with [args] to the best peer in [peers], or run it
  locally with [invoke_local]:

  1. `pick_dispatch_target` over [peers] scored by spare CPU; with fewer than
     two fresh peers the call runs locally.
  2. Unless the target's spare CPU exceeds [local_spare] by more than 200
     milli-cores (a fifth of a core), the call runs locally.
  3. [fd_for] maps the target to its RPC connection; `None` runs locally.
  4. Otherwise `NodeCall.call` with deadline `now_ms + timeout_ms`; a
     `NoConnection` or `DeadlineExceeded` falls back to [invoke_local], any
     other result (including `TypeMismatch`) is returned as is.

  Note that the remote attempt may already have used up the timeout before
  the local fallback runs.
  """
  fn dispatch(
    peers : List(NodeLoad),
    now_ms : Int,
    fn_ref : RemoteRef,
    args : List(Int),
    local_pid : Pid,
    timeout_ms : Int,
    local_spare : Int,
    fd_for : NodeLoad -> Option(Int),
    invoke_local : () -> Result(List(Int), CallError)
  ) : Result(List(Int), CallError) do
    match pick_dispatch_target(peers, ClusterLoad.spare_cpu_milli, now_ms) do
      None -> invoke_local()
      Some(target) ->
        let target_spare = ClusterLoad.spare_cpu_milli(target)
        if target_spare <= local_spare + dispatch_threshold_milli() do
          invoke_local()
        else
          match fd_for(target) do
            None -> invoke_local()
            Some(fd) ->
              let deadline = now_ms + timeout_ms
              let result = NodeCall.call(fd, fn_ref, args, local_pid, deadline, 1, now_ms)
              match result do
                Err(NoConnection)     -> invoke_local()
                Err(DeadlineExceeded) -> invoke_local()
                other                 -> other
              end
          end
        end
    end
  end

  doc """
  Consistent-hash affinity dispatch: call [fn_ref] on the ring owner of [key]
  in [ring] through `fd_for(owner_id)`, so the same key keeps hitting the same
  node. Falls back to load-aware `dispatch` (with the same [now_ms]) when the
  ring is empty, the owner has no connection, or the call fails with
  `NoConnection` or `DeadlineExceeded`; any other result is returned as is.
  """
  fn dispatch_affine(
    ring : ConsistentHash.HashRing(String),
    peers : List(NodeLoad),
    now_ms : Int,
    fn_ref : RemoteRef,
    key : String,
    args : List(Int),
    local_pid : Pid,
    timeout_ms : Int,
    local_spare : Int,
    fd_for : String -> Option(Int),
    invoke_local : () -> Result(List(Int), CallError)
  ) : Result(List(Int), CallError) do
    match ConsistentHash.get(ring, key) do
      None -> dispatch(peers, now_ms, fn_ref, args, local_pid, timeout_ms,
                       local_spare, fn nl -> fd_for(nl.node_id), invoke_local)
      Some(owner_id) ->
        match fd_for(owner_id) do
          None ->
            -- Owner unreachable; fall back to load-aware dispatch.
            dispatch(peers, now_ms, fn_ref, args, local_pid, timeout_ms,
                     local_spare, fn nl -> fd_for(nl.node_id), invoke_local)
          Some(fd) ->
            let deadline = now_ms + timeout_ms
            let result = NodeCall.call(fd, fn_ref, args, local_pid, deadline, 1, now_ms)
            match result do
              Err(NoConnection)     ->
                dispatch(peers, now_ms, fn_ref, args, local_pid, timeout_ms,
                         local_spare, fn nl -> fd_for(nl.node_id), invoke_local)
              Err(DeadlineExceeded) ->
                dispatch(peers, now_ms, fn_ref, args, local_pid, timeout_ms,
                         local_spare, fn nl -> fd_for(nl.node_id), invoke_local)
              other -> other
            end
        end
    end
  end

end
