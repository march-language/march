-- ClusterConn: the net-kernel connection lifecycle (distributed P1, L2).
--
-- Ties the transport (NetKernel.handshake) to the peer table (PeerRegistry):
-- dial out to a peer or accept an inbound connection, run the authenticated
-- handshake, and on success register the peer (one connection per NodeId).
-- A handshake failure closes the socket and returns the reason.
--
-- This is socket + scheduler glue, runtime-exercised — the eval-based stdlib
-- test harness does not run sockets (same convention as NetKernel/ChannelServer).
-- It composes only already-unit-tested logic (NetKernel byte bridge + Handshake
-- + ClusterAuth + PeerRegistry).
mod ClusterConn do
  needs IO.NetListen

  -- Open a listening socket on [port].
  fn listen(port : Int) : Result(Int, String) do
    tcp_listen(port)
  end

  pfn register_after_handshake(reg : PeerRegistry.Registry, fd : Int,
                               result : Result(NodeIdentity.Identity, String))
      : Result((PeerRegistry.Registry, PeerRegistry.Peer), String) do
    match result do
      Err(e) ->
        Socket.close(fd)
        Err(e)
      Ok(peer_id) ->
        let peer = { node_id: peer_id.node_id, identity: peer_id, fd: fd }
        Ok((PeerRegistry.add(reg, peer), peer))
    end
  end

  -- Dial [host]:[port], run the handshake as our [my_id]/[secret], and on
  -- success register the authenticated peer.
  fn connect_to_peer(reg : PeerRegistry.Registry, host : String, port : Int,
                     my_id : NodeIdentity.Identity, secret : String)
      : Result((PeerRegistry.Registry, PeerRegistry.Peer), String) do
    match Socket.connect(host, port) do
      Err(e) -> Err(Socket.error_message(e))
      Ok(fd) ->
        register_after_handshake(reg, fd,
          NetKernel.handshake(fd, my_id, secret, NetKernel.fresh_nonce()))
    end
  end

  -- Accept one inbound connection on [listen_fd], handshake, and register.
  fn accept_one(reg : PeerRegistry.Registry, listen_fd : Int,
                my_id : NodeIdentity.Identity, secret : String)
      : Result((PeerRegistry.Registry, PeerRegistry.Peer), String) do
    match tcp_accept(listen_fd) do
      Err(e) -> Err(e)
      Ok(fd) ->
        register_after_handshake(reg, fd,
          NetKernel.handshake(fd, my_id, secret, NetKernel.fresh_nonce()))
    end
  end

end
