-- HttpServer module: server-side HTTP types and pipeline runner.
--
-- Built on top of Http (for Method, Header types) and WebSocket modules.
-- Provides the Conn type, pipeline composition, and server startup.
--
-- Usage:
--   HttpServer.new(4000)
--   |> HttpServer.max_connections(500)
--   |> HttpServer.idle_timeout(30)
--   |> HttpServer.plug(logger)
--   |> HttpServer.plug(router)
--   |> HttpServer.listen()

mod HttpServer do
  -- This module's listen/spawn_n/wait_for functions call the http_server_listen /
  -- http_server_spawn_n / http_server_wait builtins, which the body-scan
  -- classifies as Cap(IO.NetListen).  Declare the capability so the enforcement
  -- (typecheck.ml builtin_cap_table) is satisfied here rather than warning at
  -- every call site inside the module.
  needs IO.NetListen
  -- HTTPS adds no module-level `needs`: a module importing HttpServer must
  -- declare all of them (import_cap_missing), and Bastion/forgepm declare
  -- only IO.NetListen. The TLS builtins (configure, reload) are classified
  -- IO.NetListen, and the file-reading ACME plug lives in HttpAcme.

  -- Upgrade type for WebSocket connections
  type Upgrade = NoUpgrade | WebSocketUpgrade(WsSocket -> Unit)

  -- The Conn type: holds everything about a request-response cycle.
  -- Modeled on Plug.Conn from Elixir.
  -- The method field is an Atom (e.g. :get, :post) — interned i64 hash,
  -- allocation-free and safe for pattern matching in compiled mode.
  type Conn = Conn(
    Socket,                 -- the connection, borrowed from the server (see `test_conn`)
    Atom,                   -- request method (:get, :post, :put, etc.)
    String,                 -- request path (raw, e.g. "/users/42")
    List(String),           -- path_info (split on "/", empty filtered)
    String,                 -- query_string (raw, e.g. "page=1&limit=10")
    List(Header),           -- request headers
    String,                 -- request body
    Int,                    -- response status (0 = not yet set)
    List(Header),           -- response headers
    String,                 -- response body
    Bool,                   -- halted? (true after send_resp)
    List((String, String)), -- assigns (user-defined key-value store)
    Upgrade                 -- websocket upgrade (NoUpgrade by default)
  )

  -- Conn accessors

  doc "Return the request method atom (`:get`, `:post`, …) of a `Conn`."
  fn method(conn) do
    match conn do
    Conn(_, m, _, _, _, _, _, _, _, _, _, _, _) -> m
    end
  end

  doc """
  Convert a request-method atom to its uppercase string name, suitable
  for logging, response bodies, or rebuilding a request line.  Returns
  `"UNKNOWN"` for any atom that is not one of the recognized HTTP verbs.
  Atoms use lowercase by convention: `:get`, `:post`, `:put`, `:patch`,
  `:delete`, `:head`, `:options`, `:trace`, `:connect`.

  ## Examples

      march> HttpServer.method_to_string(:get)
      "GET"
      march> HttpServer.method_to_string(:patch)
      "PATCH"
      march> HttpServer.method_to_string(:not_a_verb)
      "UNKNOWN"
  """
  fn method_to_string(m) do
    if m == :get do "GET"
    else if m == :post do "POST"
    else if m == :put do "PUT"
    else if m == :patch do "PATCH"
    else if m == :delete do "DELETE"
    else if m == :head do "HEAD"
    else if m == :options do "OPTIONS"
    else if m == :trace do "TRACE"
    else if m == :connect do "CONNECT"
    else "UNKNOWN" end end end end end end end end end
  end

  doc "The raw request path without the query string, e.g. `/users/42`."
  fn path(conn) do
    match conn do
    Conn(_, _, p, _, _, _, _, _, _, _, _, _, _) -> p
    end
  end

  doc "The request path split on `/` with empty segments removed: `/users/42/` gives a two-element list of `users` and `42`."
  fn path_info(conn) do
    match conn do
    Conn(_, _, _, pi, _, _, _, _, _, _, _, _, _) -> pi
    end
  end

  doc "The raw query string after the `?`, e.g. `page=1&limit=10`; empty when the URL has none."
  fn query_string(conn) do
    match conn do
    Conn(_, _, _, _, qs, _, _, _, _, _, _, _, _) -> qs
    end
  end

  doc "All request headers as a `List(Header)`. The runtime builds the list by prepending, so it is in reverse wire order."
  fn req_headers(conn) do
    match conn do
    Conn(_, _, _, _, _, rh, _, _, _, _, _, _, _) -> rh
    end
  end

  doc "The request body (the Content-Length bytes) as a String; empty when there is none."
  fn req_body(conn) do
    match conn do
    Conn(_, _, _, _, _, _, rb, _, _, _, _, _, _) -> rb
    end
  end

  doc "The response status set so far: 0 until `send_resp` or a helper sets it. A conn returned with status 0 is sent as 200."
  fn status(conn) do
    match conn do
    Conn(_, _, _, _, _, _, _, s, _, _, _, _, _) -> s
    end
  end

  doc "The response headers set so far, most recently put first."
  fn resp_headers(conn) do
    match conn do
    Conn(_, _, _, _, _, _, _, _, rh, _, _, _, _) -> rh
    end
  end

  doc "The response body set so far; empty until a response is sent."
  fn resp_body(conn) do
    match conn do
    Conn(_, _, _, _, _, _, _, _, _, rb, _, _, _) -> rb
    end
  end

  doc "True once the conn has been responded to or halted; `run_pipeline` then skips the remaining plugs."
  fn halted(conn) do
    match conn do
    Conn(_, _, _, _, _, _, _, _, _, _, h, _, _) -> h
    end
  end

  doc "All assigns as a `List((String, String))`, most recent first (see `assign`)."
  fn assigns(conn) do
    match conn do
    Conn(_, _, _, _, _, _, _, _, _, _, _, a, _) -> a
    end
  end

  doc "The conn's upgrade request: `NoUpgrade` (the default), or `WebSocketUpgrade(handler)` to hand the socket to a WebSocket handler after the pipeline."
  fn conn_upgrade(conn) do
    match conn do
    Conn(_, _, _, _, _, _, _, _, _, _, _, _, u) -> u
    end
  end

  -- The connection's Socket: a TCP_BORROWED box the server runtime made
  -- over the descriptor it owns (or, for `test_conn`, a closed one).
  pfn socket(conn) do
    match conn do
    Conn(s, _, _, _, _, _, _, _, _, _, _, _, _) -> s
    end
  end

  doc """
  A `Conn` for a handler unit test, as the server would build it for a
  request with this method, target, headers and body, but backed by no
  connection: its socket is already closed, so `peer_addr` is `""` and
  `scheme` is `"http"`. A `?` in `path` splits off the query string.

  ## Examples

      let c = my_router(HttpServer.test_conn(:get, "/users/42?full=1", [], ""))
      assert (HttpServer.status(c) == 200)
  """
  fn test_conn(method : Atom, path : String, headers : List(Header), body : String) : Conn do
    let s = Socket.borrow(-1)
    let _ = Socket.close(s)
    let (p, qs) = match string_split_first(path, "?") do
      Some((before, after)) -> (before, after)
      None -> (path, "")
    end
    let pi = List.filter(string_split(p, "/"), fn seg -> not(string_is_empty(seg)))
    Conn(s, method, p, pi, qs, headers, body, 0, Nil, "", false, Nil, NoUpgrade)
  end

  doc """
  The descriptor under the conn's socket, for standard-library code that
  hands it to the runtime; -1 when no live connection backs the conn (a
  `test_conn`, or a conn kept past its request).
  """
  @[stdlib_internal]
  fn fd(conn) do
    Socket.raw_fd(socket(conn))
  end

  doc """
  Return the numeric IP address of the connected peer (the socket's
  remote address), e.g. "203.0.113.7" or "2001:db8::1".

  This is the transport-level address — it cannot be spoofed by request
  headers, unlike `X-Forwarded-For`.  Behind a reverse proxy it is the
  proxy's address, not the end client's.

  Returns "" when no live socket backs the conn (e.g. test conns).
  """
  fn peer_addr(conn) do
    match Socket.peer_addr(socket(conn)) do
    Ok(addr) -> addr
    Err(_) -> ""
    end
  end

  doc """
  Look up a request header by name, case-insensitively. Returns
  `Some(value)` for the first match in `req_headers` order, or `None`.

  ## Examples

      match HttpServer.get_req_header(conn, "Authorization") do
        Some(v) -> check_token(conn, v)
        None -> HttpServer.text(conn, 401, "unauthorized")
      end
  """
  fn get_req_header(conn, name) do
    let lower_name = string_to_lowercase(name)
    fn find(hs) do
      match hs do
      Nil -> None
      Cons(Header(n, v), rest) -> do
        if string_to_lowercase(n) == lower_name do Some(v)
        else find(rest) end
      end
      end
    end
    find(req_headers(conn))
  end

  doc """
  Look up a response header set so far, case-insensitively. Because
  `put_resp_header` prepends, this returns the most recently put value.
  """
  fn get_resp_header(conn, name) do
    let lower_name = string_to_lowercase(name)
    fn find(hs) do
      match hs do
      Nil -> None
      Cons(Header(n, v), rest) -> do
        if string_to_lowercase(n) == lower_name do Some(v)
        else find(rest) end
      end
      end
    end
    find(resp_headers(conn))
  end

  doc """
  Look up a value stored with `assign`: `Some(value)` for the most recent
  assignment to `key`, or `None`.

  ## Examples

      let conn = HttpServer.assign(conn, "user", "ann")
      HttpServer.get_assign(conn, "user")   -- Some("ann")
  """
  fn get_assign(conn, key) do
    fn find(pairs) do
      match pairs do
      Nil -> None
      Cons((k, v), rest) -> do
        if k == key do Some(v)
        else find(rest) end
      end
      end
    end
    find(assigns(conn))
  end

  -- Conn transforms

  doc """
  Add a response header. The header is prepended and existing headers with
  the same name are NOT replaced, so putting a name twice sends it twice.
  """
  fn put_resp_header(conn, name, value) do
    match conn do
    Conn(sock, m, p, pi, qs, rh, rb, s, rhs, rbody, h, a, u) ->
      Conn(sock, m, p, pi, qs, rh, rb, s, Cons(Header(name, value), rhs), rbody, h, a, u)
    end
  end

  doc """
  Store a key/value pair in the conn's assigns (a per-request store plugs
  use to pass data along the pipeline). Later assignments to the same key
  shadow earlier ones for `get_assign`; all are kept in `assigns`.
  """
  fn assign(conn, key, value) do
    match conn do
    Conn(sock, m, p, pi, qs, rh, rb, s, rhs, rbody, h, a, u) ->
      Conn(sock, m, p, pi, qs, rh, rb, s, rhs, rbody, h, Cons((key, value), a), u)
    end
  end

  doc """
  Set the response status and body and mark the conn halted. This is the
  primary way to respond; later plugs in the pipeline are skipped. The
  response is written by the runtime after the pipeline returns.

  Panics if the conn is already halted (by `send_resp`, a helper such as
  `text`/`json`, or `halt`): a double response is always a handler bug, and
  silently overwriting the first reply would mask it.

  ## Examples

      conn
      |> HttpServer.put_resp_header("cache-control", "no-store")
      |> HttpServer.send_resp(200, "ok")
  """
  fn send_resp(conn, resp_status, body) do
    match conn do
    Conn(sock, m, p, pi, qs, rh, rb, _, rhs, _, h, a, u) ->
      if h do
        panic("HttpServer.send_resp: conn is already halted — cannot send twice")
      else
        Conn(sock, m, p, pi, qs, rh, rb, resp_status, rhs, body, true, a, u)
      end
    end
  end

  doc """
  Mark the conn halted without setting a response, so remaining plugs are
  skipped. The status stays whatever it was (0 if never set). A later
  `send_resp` on the halted conn panics.
  """
  fn halt(conn) do
    match conn do
    Conn(sock, m, p, pi, qs, rh, rb, s, rhs, rbody, _, a, u) ->
      Conn(sock, m, p, pi, qs, rh, rb, s, rhs, rbody, true, a, u)
    end
  end

  -- Convenience response helpers

  doc """
  Respond with a plain-text body: adds `content-type: text/plain; charset=utf-8`
  and calls `send_resp`. Panics if the conn is already halted.

  ## Examples

      fn hello(conn) do
        HttpServer.text(conn, 200, "hello, " ++ HttpServer.path(conn))
      end
  """
  fn text(conn, resp_status, body) do
    conn
    |> put_resp_header("content-type", "text/plain; charset=utf-8")
    |> send_resp(resp_status, body)
  end

  doc """
  Respond with a JSON body (already-encoded String): adds
  `content-type: application/json` and calls `send_resp`. Panics if the conn
  is already halted.
  """
  fn json(conn, resp_status, body) do
    conn
    |> put_resp_header("content-type", "application/json")
    |> send_resp(resp_status, body)
  end

  doc """
  Respond with an HTML body: adds `content-type: text/html; charset=utf-8`
  and calls `send_resp`. Panics if the conn is already halted.
  """
  fn html(conn, resp_status, body) do
    conn
    |> put_resp_header("content-type", "text/html; charset=utf-8")
    |> send_resp(resp_status, body)
  end

  doc """
  Respond `302 Found` with a `location: url` header and an empty body.
  Panics if the conn is already halted.
  """
  fn redirect(conn, url) do
    conn
    |> put_resp_header("location", url)
    |> send_resp(302, "")
  end

  doc """
  Run a list of plugs (`Conn -> Conn` functions) in order, threading the
  conn through. Before each plug the conn is checked: once it is halted the
  remaining plugs are skipped and the halted conn is returned.

  ## Examples

      HttpServer.run_pipeline(conn, [logger, auth, router])
  """
  fn run_pipeline(conn, plugs) do
    match plugs do
    Nil -> conn
    Cons(f, rest) -> do
      if halted(conn) do conn
      else run_pipeline(f(conn), rest) end
    end
    end
  end

  -- Where an HTTPS server's certificate and private key come from:
  -- TlsFiles(cert_path, key_path) reads PEM files (a full chain, leaf first,
  -- such as certbot's fullchain.pem, and its key); TlsPem(cert, key) takes
  -- the PEM text itself.
  type TlsSource = TlsFiles(String, String) | TlsPem(String, String)

  -- HTTPS and timeout options, set by the builders below.
  -- The tls field holds the call that configures TLS (built by `tls`, given
  -- the poll interval and the bootstrap flag), not the TlsSource itself, so
  -- a plain-HTTP program never references the TLS builtin and links no
  -- OpenSSL (runtime/march_tls_ops.h).
  type ServerOpts = ServerOpts(
    Option((Int, Int) -> Result(Int, String)),   -- tls (None = plain HTTP)
    Int,                 -- TLS handshake timeout secs (default 10)
    Int,                 -- certificate file poll interval secs (default 60, 0 = off)
    Bool,                -- wait for a missing certificate (bootstrap mode)
    Int,                 -- header timeout secs (default 30)
    Int,                 -- body/response progress timeout secs (default 30)
    Int,                 -- extra plain-HTTP listener port (0 = none)
    List(Conn -> Conn)   -- its plugs
  )

  -- Server config type
  type Server = Server(
    Int,                 -- port
    List(Conn -> Conn),  -- pipeline (list of plugs)
    Int,                 -- max_connections (default 1000)
    Int,                 -- idle_timeout_secs (default 60)
    ServerOpts           -- HTTPS and timeouts
  )

  doc """
  A server config listening on `port` with no plugs, `max_connections`
  1000 and `idle_timeout` 60 seconds. Nothing is bound until `listen` or
  `spawn_n`.

  ## Examples

      HttpServer.new(4000)
      |> HttpServer.plug(fn conn -> HttpServer.text(conn, 200, "ok"))
      |> HttpServer.listen()
  """
  fn new(port) do
    Server(port, Nil, 1000, 60, ServerOpts(None, 10, 60, false, 30, 30, 0, Nil))
  end

  doc """
  Append a plug (`Conn -> Conn`) to the end of the server's pipeline. Plugs
  run in the order they were added.
  """
  fn plug(server, p) do
    match server do
    Server(port, plugs, mc, it, o) ->
      Server(port, List.append(plugs, Cons(p, Nil)), mc, it, o)
    end
  end

  doc "Set the maximum number of concurrent connections (default 1000)."
  fn max_connections(server, n) do
    match server do
    Server(port, plugs, _, it, o) -> Server(port, plugs, n, it, o)
    end
  end

  doc """
  Close a keep-alive connection after `secs` seconds with no request in
  progress (default 60). Applies to both server modes; an upgraded WebSocket
  is not subject to it.
  """
  fn idle_timeout(server, secs) do
    match server do
    Server(port, plugs, mc, _, o) -> Server(port, plugs, mc, secs, o)
    end
  end

  pfn opts(server) do
    match server do
    Server(_, _, _, _, o) -> o
    end
  end

  pfn with_opts(server, o) do
    match server do
    Server(port, plugs, mc, it, _) -> Server(port, plugs, mc, it, o)
    end
  end

  doc """
  Serve HTTPS on the server's port with the certificate and key from `src`.
  `listen` refuses to start (it panics, naming the file and the reason)
  when they cannot be loaded or do not match, unless `tls_wait_for_cert`
  was set and the files are merely missing. An expired certificate at
  startup is served with a warning. With `TlsFiles`, the files are re-read
  every `tls_poll_interval` seconds and a renewed pair is picked up without
  a restart. Needs a compiled build (`march --compile`, `forge build`).

  ## Examples

      HttpServer.new(443)
      |> HttpServer.tls(HttpServer.TlsFiles(
           "/etc/letsencrypt/live/example.com/fullchain.pem",
           "/etc/letsencrypt/live/example.com/privkey.pem"))
      |> HttpServer.plug(router)
      |> HttpServer.listen()
  """
  fn tls(server, src) do
    match opts(server) do
    ServerOpts(_, hs, poll, wait, hdr, prog, pp, pplugs) -> do
      let configure = match src do
        TlsFiles(c, k) -> tls_configure_call(0, c, k)
        TlsPem(c, k) -> tls_configure_call(1, c, k)
      end
      with_opts(server, ServerOpts(Some(configure), hs, poll, wait, hdr, prog, pp, pplugs))
    end
    end
  end

  -- The closure `tls` stores: configure TLS from (kind, a, b) given the poll
  -- interval and the bootstrap flag. It captures the two strings themselves
  -- and binds the builtin's result before returning it: the first version
  -- matched a captured TlsSource and returned the call directly, and ASAN
  -- caught the closure freeing the captured path strings before the builtin
  -- (which borrows them) read them. That compiler bug is fixed
  -- (specs/progress/2026-11-06-closure-borrowed-tail-call-uaf.md); this
  -- shape stays because it is the one ASAN has run clean.
  pfn tls_configure_call(kind, a, b) do
    fn pw ->
      match pw do
      (poll_secs, wait_flag) ->
        let r = http_server_tls_configure(kind, a, b, poll_secs, wait_flag)
        r
      end
  end

  doc "Close a connection whose TLS handshake has not finished within `secs` seconds (default 10)."
  fn tls_handshake_timeout(server, secs) do
    match opts(server) do
    ServerOpts(t, _, poll, wait, hdr, prog, pp, pplugs) ->
      with_opts(server, ServerOpts(t, secs, poll, wait, hdr, prog, pp, pplugs))
    end
  end

  doc """
  Re-read the `TlsFiles` certificate pair every `secs` seconds (default 60)
  and install it when its content changed. `0` turns polling off;
  `reload_tls` still works.
  """
  fn tls_poll_interval(server, secs) do
    match opts(server) do
    ServerOpts(t, hs, _, wait, hdr, prog, pp, pplugs) ->
      with_opts(server, ServerOpts(t, hs, secs, wait, hdr, prog, pp, pplugs))
    end
  end

  doc """
  Bootstrap mode for a first certificate: when the `TlsFiles` do not exist
  yet, `listen` starts anyway, serving only the `plain_listener` (where an
  ACME challenge can be answered), and binds the HTTPS port as soon as the
  poller or `reload_tls` installs a valid pair. Files that exist but are
  invalid still stop `listen`.
  """
  fn tls_wait_for_cert(server) do
    match opts(server) do
    ServerOpts(t, hs, poll, _, hdr, prog, pp, pplugs) ->
      with_opts(server, ServerOpts(t, hs, poll, true, hdr, prog, pp, pplugs))
    end
  end

  doc "Close a connection that has not sent a request's complete headers within `secs` seconds of its first byte (default 30)."
  fn header_timeout(server, secs) do
    match opts(server) do
    ServerOpts(t, hs, poll, wait, _, prog, pp, pplugs) ->
      with_opts(server, ServerOpts(t, hs, poll, wait, secs, prog, pp, pplugs))
    end
  end

  doc """
  Close a connection when reading a request body or writing a response makes
  no progress for `secs` seconds (default 30). A slow transfer that keeps
  moving is never cut.
  """
  fn progress_timeout(server, secs) do
    match opts(server) do
    ServerOpts(t, hs, poll, wait, hdr, _, pp, pplugs) ->
      with_opts(server, ServerOpts(t, hs, poll, wait, hdr, secs, pp, pplugs))
    end
  end

  doc """
  Also serve plain HTTP on `port`, with its own `plugs`, from the same
  `listen`. Typical use on an HTTPS server: answer ACME challenges and
  redirect everything else.

  ## Examples

      HttpServer.new(443)
      |> HttpServer.tls(HttpServer.TlsFiles(cert, key))
      |> HttpServer.plain_listener(80, [HttpAcme.webroot("/var/www/acme"),
                                        HttpServer.redirect_to_https(443)])
      |> HttpServer.plug(router)
      |> HttpServer.listen()
  """
  fn plain_listener(server, port, plugs) do
    match opts(server) do
    ServerOpts(t, hs, poll, wait, hdr, prog, _, _) ->
      with_opts(server, ServerOpts(t, hs, poll, wait, hdr, prog, port, plugs))
    end
  end

  doc """
  Install a new certificate and key on the running HTTPS server. New
  connections use it; open ones keep the one they started with. A pair that
  does not load, does not match, or has expired is refused with `Err` and
  the current certificate stays. Needs `IO.NetListen`, like serving.
  """
  fn reload_tls(src) do
    let r = match src do
      TlsFiles(c, k) -> http_server_reload_tls(0, c, k)
      TlsPem(c, k) -> http_server_reload_tls(1, c, k)
    end
    match r do
    Ok(_) -> Ok(())
    Err(e) -> Err(e)
    end
  end

  doc "`\"https\"` when the conn arrived over TLS, else `\"http\"`."
  fn scheme(conn) do
    if http_conn_is_tls(fd(conn)) do "https" else "http" end
  end

  -- ── Plugs for an HTTPS deployment ────────────────────────────────────

  pfn acme_challenge_prefix() do
    "/.well-known/acme-challenge/"
  end

  -- The rest of the path when it is under the ACME challenge prefix.
  pfn acme_token(conn) do
    let p = path(conn)
    let pre = acme_challenge_prefix()
    if string_starts_with(p, pre) do
      let n = string_byte_length(pre)
      Some(string_slice(p, n, string_byte_length(p) - n))
    else
      None
    end
  end

  -- base64url: [A-Za-z0-9_-], non-empty. Anything else (dots, slashes,
  -- percent escapes) is refused before any lookup or file access.
  pfn valid_acme_token(t) do
    let n = string_byte_length(t)
    fn ok_from(i) do
      if i >= n do true
      else
        let b = string_byte_at(t, i)
        let good = (b >= 65 && b <= 90) || (b >= 97 && b <= 122)
                   || (b >= 48 && b <= 57) || b == 95 || b == 45
        if good do ok_from(i + 1) else false end
      end
    end
    n > 0 && ok_from(0)
  end

  pfn not_found(conn) do
    conn
    |> put_resp_header("content-type", "text/plain")
    |> send_resp(404, "Not Found")
  end

  doc """
  A plug that answers ACME HTTP-01 challenges from memory: for
  `GET /.well-known/acme-challenge/<token>` it calls `lookup(token)` and
  responds 200 `text/plain` with `Some(key_authorization)`, or 404 for
  `None`. Tokens outside the base64url alphabet are 404 without a lookup.
  Other requests pass through untouched.

  ## Examples

      HttpServer.plain_listener(server, 80, [
        HttpServer.acme_responder(fn token -> Vault.get(challenges, token)),
        HttpServer.redirect_to_https(443)
      ])
  """
  fn acme_responder(lookup) do
    fn conn ->
      match acme_token(conn) do
      None -> conn
      Some(t) ->
        let m = method(conn)
        if (m == :get || m == :head) && valid_acme_token(t) do
          match lookup(t) do
          Some(body) ->
            conn
            |> put_resp_header("content-type", "text/plain")
            |> send_resp(200, body)
          None -> not_found(conn)
          end
        else
          not_found(conn)
        end
      end
  end

  -- "example.com:8080" -> "example.com", "[::1]:80" -> "[::1]".
  pfn host_without_port(h) do
    if string_starts_with(h, "[") do
      match string_index_of(h, "]") do
      Some(i) -> string_slice(h, 0, i + 1)
      None -> h
      end
    else
      match string_last_index_of(h, ":") do
      Some(i) -> string_slice(h, 0, i)
      None -> h
      end
    end
  end

  doc """
  A plug that redirects every request to the same URL over HTTPS on `port`:
  `https://<Host without its port>[:port unless 443]<path>[?query]`. GET and
  HEAD get 301; other methods get 308 so the method and body are kept. A
  request without a `Host` header gets 400. ACME challenge paths
  (`/.well-known/acme-challenge/`) pass through, so it works before or after
  `HttpAcme.webroot` in a `plain_listener`.

  ## Examples

      HttpServer.new(443)
      |> HttpServer.tls(HttpServer.TlsFiles(cert, key))
      |> HttpServer.plain_listener(80, [HttpServer.redirect_to_https(443)])
  """
  fn redirect_to_https(port) do
    fn conn ->
      match acme_token(conn) do
      Some(_) -> conn
      None ->
        match get_req_header(conn, "host") do
        None ->
          conn
          |> put_resp_header("content-type", "text/plain")
          |> send_resp(400, "Bad Request: no Host header")
        Some(h) ->
          let port_part = if port == 443 do "" else ":" ++ int_to_string(port) end
          let qs = query_string(conn)
          let q = if qs == "" do "" else "?" ++ qs end
          let m = method(conn)
          let code = if m == :get || m == :head do 301 else 308 end
          conn
          |> put_resp_header("location", "https://" ++ host_without_port(h) ++ port_part ++ path(conn) ++ q)
          |> send_resp(code, "")
        end
      end
  end

  -- Hand the HTTPS, timeout and plain-listener settings to the runtime
  -- before the listen builtin reads them. A certificate that cannot be used
  -- stops the program here, before anything is bound.
  pfn configure_runtime(o) do
    match o do
    ServerOpts(t, hs, poll, wait, hdr, prog, pp, pplugs) -> do
      match t do
      None -> ()
      Some(configure) ->
        let w = if wait do 1 else 0 end
        match configure((poll, w)) do
        Ok(_) -> ()
        Err(msg) -> panic("HttpServer.listen: " ++ msg)
        end
      end
      http_server_set_timeouts(hs, hdr, prog)
      if pp > 0 do
        let plain_fn = fn conn -> run_pipeline(conn, pplugs)
        http_server_plain_listener(pp, plain_fn)
      else
        ()
      end
    end
    end
  end

  -- Consume one handler result. The parameter is typed so the compiler
  -- synthesizes the shape-aware deep drop for Conn (lib/tir/drop.ml); an
  -- erased parameter would compile to the shallow runtime decrc and leak
  -- the children exactly like the runtime did.
  pfn release_conn(c : Conn) do
    ()
  end

  doc """
  Bind the configured port and serve requests forever with the plug
  pipeline (via the runtime's `http_server_listen`). Each request becomes a
  `Conn`; the pipeline's result is written back as the response, or handed
  to the WebSocket handler if `conn_upgrade` is a `WebSocketUpgrade`.
  Does not return in normal operation. Requires `IO.NetListen`.
  """
  fn listen(server) do
    match server do
    Server(port, plugs, mc, it, o) -> do
      configure_runtime(o)
      -- Build a server config heap object for the C runtime:
      -- The C runtime expects (port, max_conns, idle_timeout) at fields 0,1,2.
      -- The pipeline is passed separately.
      -- For now, we pass the pipeline as a function that runs run_pipeline.
      let pipeline_fn = fn conn -> run_pipeline(conn, plugs)
      -- release_conn is called by the runtime on every handler result once
      -- its response is written. The runtime's own decrc is shallow (it
      -- frees one cell and orphans the children), so the result Conn and
      -- the strings/lists it owns leaked once per request until this
      -- existed; the compiled body of release_conn is the deep drop.
      http_server_listen(port, mc, it, pipeline_fn, release_conn)
    end
    end
  end

  doc """
  Start the server in a forked subprocess that handles exactly `n` requests
  and then exits. Returns a handle (the child PID) for `wait_for`. A
  readiness pipe makes the call return only after the child has bound the
  port, so the caller can connect immediately. Intended for tests.

  ## Examples

      let h = HttpServer.new(18080)
        |> HttpServer.plug(fn conn -> HttpServer.text(conn, 200, "pong"))
        |> HttpServer.spawn_n(1)
      let resp = HttpClient.get(HttpClient.new_client(), "http://127.0.0.1:18080/")
      HttpServer.wait_for(h)
  """
  fn spawn_n(server, n) do
    match server do
    Server(port, plugs, mc, it, o) -> do
      configure_runtime(o)
      let pipeline_fn = fn conn -> run_pipeline(conn, plugs)
      http_server_spawn_n(port, n, mc, it, pipeline_fn)
    end
    end
  end

  doc """
  Bind later servers to `host`, a dotted IPv4 address such as "127.0.0.1",
  instead of every interface. Call it before `listen` or `spawn_n`; it panics
  on anything that isn't an IPv4 address.
  """
  fn bind_host(host : String) : Unit do
    http_server_bind_host(host)
  end

  doc "Block until the server subprocess started by `spawn_n` (given its handle) exits."
  fn wait_for(handle) do
    http_server_wait(handle)
  end

end
