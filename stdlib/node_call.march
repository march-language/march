-- NodeCall: caller-side Node.call and server-side RPC dispatch loop (P3 L4).
--
-- The glue between the transport (NetKernel) and the RPC core (NodeRpc):
-- the caller sends a CallRequest frame and waits for the matching CallReply;
-- the server-side dispatch loop reads request frames and sends reply frames.
-- Uses dedicated RPC connections (not shared with SWIM gossip connections).
--
-- `call` is synchronous: it blocks the calling task until the reply arrives
-- or the connection closes. March's green-thread scheduler yields on socket I/O,
-- so a blocked call lets the server task run and vice versa.
--
-- Type annotations use bare names (Targets, RemoteRef, Pid, CallError) rather
-- than qualified paths (NodeRpc.Targets, etc.) to avoid qualified-vs-bare
-- unification failures at call sites.
mod NodeCall do

  -- ── Caller side ─────────────────────────────────────────────────────────────

  doc """
  Send one RPC request for [fref] with MessagePack-encoded [args] on [fd]
  and block until the reply carrying [correlation] arrives. Frames that are
  not that reply are skipped. [now_ms] is compared against [deadline_ms]
  once, up front (pass the current unix time in ms): when
  `now_ms >= deadline_ms` it returns `Err(DeadlineExceeded)` without
  sending. After the request is sent the deadline is only carried to the
  peer, not enforced here: the call waits until a matching reply or a
  socket error.

  Returns `Ok(payload)` (the MessagePack-encoded return value), or `Err`:
  `DeadlineExceeded`; `Forbidden` when certificate mode refuses raw frames
  on [fd] (counted, nothing sent); `NoConnection` when the send or a read
  fails; or the error the peer replied with (`NoTarget`, `TypeMismatch`,
  `VersionSkew`, `RemoteExit(reason)`, `Forbidden`).

      let fref = RemoteCall.remote_ref("Math", "add", sig_hash, impl_hash)
      match NodeCall.call(fd, fref, Msgpack.encode(args), me, deadline, 1, now) do
        Ok(bytes) -> Msgpack.decode(bytes)
        Err(e) -> Err(RemoteCall.error_message(e))
      end
  """
  fn call(fd : Int, fref : RemoteRef, args : List(Int),
          my_pid : Pid, deadline_ms : Int, correlation : Int,
          now_ms : Int) : Result(List(Int), CallError) do
    if NodeRpc.timed_out(now_ms, deadline_ms) do
      Err(DeadlineExceeded)
    else if NetKernel.raw_allowed(fd) == false do
      -- RemoteCall is a raw primitive (step 11b): on a certificate-mode
      -- connection without raw_send at both ends it is refused, counted,
      -- and never sent.
      NetKernel.note_raw_refused(fd)
      Err(Forbidden)
    else
      let req = RemoteCall.request(fref, args, my_pid, deadline_ms, correlation)
      match NetKernel.send_frame(fd, RemoteCall.encode_request(req)) do
        Err(_) -> Err(RemoteCall.NoConnection)
        Ok(_) -> recv_reply(fd, correlation, Nil)
      end
    end end
  end

  -- Read frames from [fd] until one decodes as a CallReply matching [correlation].
  -- Non-matching or malformed frames are skipped (they may be from a prior call
  -- or a different multiplexed stream). A socket error returns NoConnection.
  pfn recv_reply(fd : Int, correlation : Int,
                 buf : List(Int)) : Result(List(Int), CallError) do
    match NetKernel.recv_frame(fd, buf) do
      Err(_) -> Err(RemoteCall.NoConnection)
      Ok(fr) ->
        let frame_bytes = match fr do (f, _) -> f end
        let rest = match fr do (_, r) -> r end
        match RemoteCall.decode_reply(frame_bytes) do
          Err(_) -> recv_reply(fd, correlation, rest)
          Ok(reply) ->
            if reply.correlation == correlation do
              NodeRpc.interpret(reply)
            else
              recv_reply(fd, correlation, rest)
            end
        end
    end
  end

  -- ── Server side ──────────────────────────────────────────────────────────────

  doc """
  Read one RPC request frame from [fd], dispatch it against [targets]
  (`NodeRpc.handle_frame`, which falls back to the compiler-registered
  remote stubs), and send the reply frame back. A frame that does not decode
  as a request is dropped with no reply (there is no correlation to echo
  back), and is still `Ok`. On a connection that refuses raw frames
  (certificate mode without `raw_send`) the request is not dispatched: it is
  counted and answered `Forbidden`. Returns `Err` with the message on a read
  or write failure.
  """
  fn serve_one(targets : Targets, fd : Int) : Result((), String) do
    match NetKernel.recv_frame(fd, Nil) do
      Err(e) -> Err(e)
      Ok(fr) ->
        let frame_bytes = match fr do (f, _) -> f end
        match serve_verdict(targets, fd, frame_bytes) do
          None -> Ok(())
          Some(reply) ->
            match NetKernel.send_frame(fd, RemoteCall.encode_reply(reply)) do
              Err(e) -> Err(e)
              Ok(_) -> Ok(())
            end
        end
    end
  end

  -- A request on a connection that refuses raw frames (step 11b) is not
  -- dispatched: counted, and answered `Forbidden` (so the caller, blocked
  -- in `call` until a reply, is not left waiting). Otherwise NodeRpc's.
  pfn serve_verdict(targets : Targets, fd : Int, frame_bytes : List(Int)) : Option(CallReply) do
    if NetKernel.raw_allowed(fd) do NodeRpc.handle_frame(targets, frame_bytes)
    else
      NetKernel.note_raw_refused(fd)
      match RemoteCall.decode_request(frame_bytes) do
        Ok(req) -> Some(RemoteCall.err_reply(req.correlation, Forbidden))
        Err(_) -> None
      end
    end
  end

  doc """
  Serve RPC requests on [fd] (`serve_one`, repeatedly) until the connection
  closes or an I/O error occurs, then return `()`. Blocks the calling task;
  run it in its own task per connection.

      NodeCall.serve_loop(NodeRpc.empty(), fd)
  """
  fn serve_loop(targets : Targets, fd : Int) : () do
    match serve_one(targets, fd) do
      Err(_) -> ()
      Ok(_) -> serve_loop(targets, fd)
    end
  end

end
