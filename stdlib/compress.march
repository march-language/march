-- Compress module: gzip, deflate, zstd, and brotli compression.
--
-- All one-shot encode/decode functions operate on Bytes values and return
-- Result(Bytes, Compress.Error).  Streaming variants take a Seq of Bytes
-- chunks and return a lazy Seq of per-chunk Result(Bytes, Compress.Error).
--
-- Sub-modules are scoped by algorithm so callers can import selectively:
--
--     let compressed = Compress.Gzip.encode(data)
--     let restored   = Compress.Gzip.decode(compressed)
--
-- Level types let callers trade speed for ratio without magic numbers:
--
--     Compress.Gzip.encode_level(data, Gzip.BestCompression)
--     Compress.Zstd.encode_level(data, Zstd.Fast(3))
--
-- Implementation note: the underlying work is done by zlib (gzip/deflate),
-- libzstd (zstd), and libbrotlienc/libbrotlidec (brotli) via C FFI.  Each
-- algorithm shim lives in runtime/march_compress.c.

mod Compress do

  -- Shared error type across all sub-modules.
  --   InvalidInput(msg)   the input was not valid compressed data (decode),
  --                       or was too large to hand to the codec (encode)
  --   InsufficientOutput  decoding hit the decompressed-output size cap
  --   Io(msg)             an environment failure: out of memory, a codec
  --                       that failed to initialise, or a library not built in
  -- `msg` is the codec's own message, e.g. "gzip_decode: inflate failed".
  type Error =
      InvalidInput(String)
    | InsufficientOutput
    | Io(String)

  -- ── Error mapping ─────────────────────────────────────────────────────────

  -- The gzip/deflate/zstd/brotli builtins report failure as a plain message
  -- string (runtime/march_compress.c compiled, lib/eval/compress_stubs.c
  -- interpreted; both spell the same messages). The classifiers below turn
  -- that string into the structured `Error` every public signature promises,
  -- keeping the original message as the payload where there is one.
  --
  -- Encoding: an oversized input is the caller's input; anything else (out
  -- of memory, a failed encoder init, a missing library) is an environment
  -- failure.
  pfn encode_error(msg : String) : Error do
    if string_contains(msg, "input too large") do InvalidInput(msg)
    else Io(msg) end
  end

  -- Decoding: hitting the output size cap is `InsufficientOutput`; out of
  -- memory, a failed decoder init or a missing library is `Io`; every other
  -- failure (corrupt stream, truncated data, a zstd frame error) means the
  -- input was not valid compressed data.
  pfn decode_error(msg : String) : Error do
    if string_contains(msg, "size limit exceeded")
       || string_contains(msg, "exceeds limit") do InsufficientOutput
    else if string_contains(msg, "out of memory")
            || string_contains(msg, "Init")
            || string_contains(msg, "not available") do Io(msg)
    else InvalidInput(msg)
    end end
  end

  -- The sub-modules below call the two lifts by their bare names: a nested
  -- module sees its enclosing module's `pfn`s. (Until 2026-09-25 the compiled
  -- call was left unqualified and failed to link, so these were public; see
  -- specs/progress/2026-09-25-nested-module-parent-call.md.)

  doc """
  Convert a raw encoder result, whose error is the codec's message string,
  into `Result(Bytes, Compress.Error)`. Used by every `encode*` wrapper; an
  oversized input becomes `InvalidInput(msg)`, anything else `Io(msg)`.
  """
  pfn lift_encode_error(r : Result(Bytes, String)) : Result(Bytes, Error) do
    match r do
    Ok(b) -> Ok(b)
    Err(msg) -> Err(encode_error(msg))
    end
  end

  doc """
  Convert a raw decoder result, whose error is the codec's message string,
  into `Result(Bytes, Compress.Error)`. Used by every `decode*` wrapper:
  corrupt or truncated data becomes `InvalidInput(msg)`, hitting the output
  size cap `InsufficientOutput`, and an environment failure `Io(msg)`.
  """
  pfn lift_decode_error(r : Result(Bytes, String)) : Result(Bytes, Error) do
    match r do
    Ok(b) -> Ok(b)
    Err(msg) -> Err(decode_error(msg))
    end
  end

  -- ── Gzip ─────────────────────────────────────────────────────────────────

  mod Gzip do

    -- Compression level for gzip encoding.
    type Level =
        BestSpeed        -- zlib level 1
      | Default          -- zlib default (~6)
      | BestCompression  -- zlib level 9
      | Custom(Int)      -- explicit 1–9

    pfn level_int(l) do
      match l do
      BestSpeed       -> 1
      Default         -> -1  -- Z_DEFAULT_COMPRESSION
      BestCompression -> 9
      Custom(n)       ->
        if n < 1 || n > 9 do
          panic("Compress.Gzip: level must be 1–9, got " ++ int_to_string(n))
        else n end
      end
    end

    doc """
    Compress bytes with gzip at the default compression level.

        let b = Bytes.from_string("hello, world!")
        match Compress.Gzip.encode(b) do
        Ok(compressed) -> compressed
        Err(e) -> panic("encode failed")
        end
    """
    fn encode(data : Bytes) : Result(Bytes, Compress.Error) do
      lift_encode_error(stdlib_gzip_encode(data, -1))
    end

    doc """
    Compress bytes with gzip at an explicit level.

        Compress.Gzip.encode_level(data, Gzip.BestSpeed)
        Compress.Gzip.encode_level(data, Gzip.Custom(6))
    """
    fn encode_level(data : Bytes, level : Level) : Result(Bytes, Compress.Error) do
      lift_encode_error(stdlib_gzip_encode(data, level_int(level)))
    end

    doc """
    Decompress gzip-compressed bytes.

        match Compress.Gzip.decode(compressed) do
        Ok(original) -> original
        Err(e) -> panic("decode failed")
        end
    """
    fn decode(data : Bytes) : Result(Bytes, Compress.Error) do
      lift_decode_error(stdlib_gzip_decode(data))
    end

    doc """
    Compress a sequence of byte chunks, producing a lazy sequence of
    Result values.  Each chunk is compressed independently; errors are
    surfaced per-chunk rather than silently dropped.

        let chunks = Seq.from_list([chunk1, chunk2])   -- a Seq of Bytes
        let compressed =                              -- a Seq of Result(Bytes, Compress.Error)
          Compress.Gzip.encode_stream(chunks)
    """
    -- The streaming functions are deliberately unannotated. `Seq(a)`'s
    -- parameter is the church-encoded fold closure, not the element type
    -- (see stdlib/seq.march), so `Seq(Bytes)` names no real sequence and an
    -- annotation spelled that way cannot typecheck.
    fn encode_stream(input) do
      Seq.map(input, fn chunk -> lift_encode_error(stdlib_gzip_encode(chunk, -1)))
    end

    doc """
    Decompress a sequence of gzip-compressed byte chunks.  Errors are
    surfaced per-chunk rather than silently dropped.

        let decompressed =                            -- a Seq of Result(Bytes, Compress.Error)
          Compress.Gzip.decode_stream(compressed_chunks)
    """
    fn decode_stream(input) do
      Seq.map(input, fn chunk -> lift_decode_error(stdlib_gzip_decode(chunk)))
    end

  end

  -- ── Deflate ──────────────────────────────────────────────────────────────

  mod Deflate do

    doc """
    Compress bytes with raw deflate (no gzip header).

        match Compress.Deflate.encode(data) do
        Ok(compressed) -> compressed
        Err(_) -> panic("encode failed")
        end
    """
    fn encode(data : Bytes) : Result(Bytes, Compress.Error) do
      lift_encode_error(stdlib_deflate_encode(data))
    end

    doc """
    Decompress raw deflate-compressed bytes (no gzip header expected).

        match Compress.Deflate.decode(compressed) do
        Ok(original) -> original
        Err(_) -> panic("decode failed")
        end
    """
    fn decode(data : Bytes) : Result(Bytes, Compress.Error) do
      lift_decode_error(stdlib_deflate_decode(data))
    end

  end

  -- ── Zstd ─────────────────────────────────────────────────────────────────

  mod Zstd do

    -- Compression level for zstd encoding.
    type Level =
        Fast(Int)  -- zstd levels: negative (e.g. Fast(-1)) are ultra-fast,
                   -- positive (e.g. Fast(1)) are faster than Default
      | Default    -- zstd default (level 3)
      | Best       -- zstd level 22 (maximum ratio, slowest)

    pfn level_int(l) do
      match l do
      Fast(n)  -> n  -- pass through; zstd accepts negative levels natively
      Default  -> 3
      Best     -> 22
      end
    end

    doc """
    Compress bytes with zstd at the default level (3).

        match Compress.Zstd.encode(data) do
        Ok(compressed) -> compressed
        Err(InvalidInput(msg)) -> panic("zstd encode failed: " ++ msg)
        Err(_) -> panic("zstd encode failed")
        end
    """
    fn encode(data : Bytes) : Result(Bytes, Compress.Error) do
      lift_encode_error(stdlib_zstd_encode(data, 3))
    end

    doc """
    Compress bytes with zstd at an explicit level.

        Compress.Zstd.encode_level(data, Zstd.Best)
        Compress.Zstd.encode_level(data, Zstd.Fast(1))
    """
    fn encode_level(data : Bytes, level : Level) : Result(Bytes, Compress.Error) do
      lift_encode_error(stdlib_zstd_encode(data, level_int(level)))
    end

    doc """
    Decompress zstd-compressed bytes.

        match Compress.Zstd.decode(compressed) do
        Ok(original) -> original
        Err(InvalidInput(msg)) -> panic("zstd decode failed: " ++ msg)
        Err(_) -> panic("zstd decode failed")
        end
    """
    fn decode(data : Bytes) : Result(Bytes, Compress.Error) do
      lift_decode_error(stdlib_zstd_decode(data))
    end

    doc """
    Compress a sequence of byte chunks with zstd at the default level.
    Errors are surfaced per-chunk rather than silently dropped.
    """
    fn encode_stream(input) do
      Seq.map(input, fn chunk -> lift_encode_error(stdlib_zstd_encode(chunk, 3)))
    end

    doc """
    Decompress a sequence of zstd-compressed byte chunks.
    Errors are surfaced per-chunk rather than silently dropped.
    """
    fn decode_stream(input) do
      Seq.map(input, fn chunk -> lift_decode_error(stdlib_zstd_decode(chunk)))
    end

  end

  -- ── Brotli ───────────────────────────────────────────────────────────────

  mod Brotli do

    -- Encoding mode hint for brotli.
    type Mode =
        Generic  -- default; any data
      | Text     -- UTF-8 text (better ratio for prose/HTML)
      | Font     -- WOFF/WOFF2 font data

    -- Compression level for brotli (0–11).
    type Level = Level(Int)

    pfn mode_int(m) do
      match m do
      Generic -> 0
      Text    -> 1
      Font    -> 2
      end
    end

    pfn level_int(l) do
      match l do
      Level(n) ->
        if n < 0 || n > 11 do
          panic("Compress.Brotli: level must be 0–11, got " ++ int_to_string(n))
        else n end
      end
    end

    doc """
    Compress bytes with brotli at the default level (6) in Generic mode.

        match Compress.Brotli.encode(data) do
        Ok(compressed) -> compressed
        Err(InvalidInput(msg)) -> panic("brotli encode failed: " ++ msg)
        Err(_) -> panic("brotli encode failed")
        end
    """
    fn encode(data : Bytes) : Result(Bytes, Compress.Error) do
      lift_encode_error(stdlib_brotli_encode(data, 0, 6))
    end

    doc """
    Compress bytes with brotli at an explicit mode and level.

        Compress.Brotli.encode_mode(data, Brotli.Text, Brotli.Level(9))
    """
    fn encode_mode(data : Bytes, mode : Mode, level : Level) : Result(Bytes, Compress.Error) do
      lift_encode_error(stdlib_brotli_encode(data, mode_int(mode), level_int(level)))
    end

    doc """
    Decompress brotli-compressed bytes.

        match Compress.Brotli.decode(compressed) do
        Ok(original) -> original
        Err(InvalidInput(msg)) -> panic("brotli decode failed: " ++ msg)
        Err(_) -> panic("brotli decode failed")
        end
    """
    fn decode(data : Bytes) : Result(Bytes, Compress.Error) do
      lift_decode_error(stdlib_brotli_decode(data))
    end

  end

  -- ── HTTP helpers ─────────────────────────────────────────────────────────

  doc """
  List the content-encoding tokens from an Accept-Encoding header value.
  Strips quality parameters (`q=`) and excludes encodings with `q=0`
  (which the client explicitly rejects).

      Compress.accept_encoding("gzip, deflate, br")
      -- ["gzip", "deflate", "br"]

      Compress.accept_encoding("gzip;q=0.9, br;q=0.5")
      -- ["gzip", "br"]

      Compress.accept_encoding("gzip;q=0, br")
      -- ["br"]

  Returns an empty list if the header is absent or empty.
  """
  fn accept_encoding(header_value : String) : List(String) do
    let parts = string_split(header_value, ",")
    fn is_zero_q(params) do
      match params do
      Nil -> false
      Cons(p, rest) ->
        let pt = string_trim(p)
        if pt == "q=0" || pt == "q=0.0" || pt == "q=0.00" do true
        else is_zero_q(rest) end
      end
    end
    fn collect(xs, acc) do
      match xs do
      Nil -> acc
      Cons(s, rest) ->
        let directives = string_split(string_trim(s), ";")
        match directives do
        Nil -> collect(rest, acc)
        Cons(name, params) ->
          let trimmed = string_trim(name)
          if is_zero_q(params) || string_byte_length(trimmed) == 0 do
            collect(rest, acc)
          else
            collect(rest, Cons(trimmed, acc))
          end
        end
      end
    end
    fn rev(xs, acc) do
      match xs do
      Nil -> acc
      Cons(h, t) -> rev(t, Cons(h, acc))
      end
    end
    rev(collect(parts, Nil), Nil)
  end

  doc """
  Choose the best compression encoding supported by the client, given the
  parsed Accept-Encoding tokens.  Prefers zstd > br > gzip in that order.
  Returns None if no supported encoding was advertised.

      Compress.best_encoding(["gzip", "br"])
      -- Some("br")

      Compress.best_encoding(["identity"])
      -- None
  """
  fn best_encoding(tokens : List(String)) : Option(String) do
    fn has(tok) do
      fn go(xs) do
        match xs do
        Nil -> false
        Cons(t, rest) -> if t == tok do true else go(rest) end
        end
      end
      go(tokens)
    end
    if has("zstd") do Some("zstd")
    else if has("br") do Some("br")
    else if has("gzip") do Some("gzip")
    else None
    end end end
  end

end
