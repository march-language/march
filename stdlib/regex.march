-- Regex module: simple regular expression engine (pure March implementation).
--
-- Supports:
--   literal chars       exact character match
--   .                   any single character
--   *                   zero or more of preceding atom (greedy)
--   +                   one or more of preceding atom (greedy)
--   ?                   zero or one of preceding atom (greedy)
--   ^                   anchor at start of string
--   $                   anchor at end of string
--   [abc]               character class (any of a, b, c)
--   [a-z]               character range in a class
--   [^abc]              negated character class
--   \d  \D              digit / non-digit
--   \w  \W              word char (alphanumeric + _) / non-word
--   \s  \S              whitespace / non-whitespace
--   \\  \.  \*  etc.    literal special characters
--
-- Functions:
--   match(pattern, string)                -> Bool
--   find(pattern, string)                 -> Option(String)
--   find_all(pattern, string)             -> List(String)
--   replace(pattern, replacement, string) -> String
--   split(pattern, string)                -> List(String)

mod Regex do

  -- ── Internal types ────────────────────────────────────────────────────────
  --
  -- Both the pattern compiler and the matcher work over byte codes (Ints),
  -- not one-char Strings.  `RALit` and `RAClass` used to carry 1-char
  -- Strings; matching a pattern like "[a-zA-Z0-9_]+" against every position
  -- of the haystack called `char_at`, which does a `string_slice` (a fresh
  -- heap allocation) for EVERY byte inspected, and `compile` exploded the
  -- whole pattern into one 1-char String per byte via `string_chars` before
  -- parsing it.  A 49-byte pattern matched once allocated ~285 strings — 5.8
  -- per pattern byte.  `string_byte_at` returns a byte (0..255, or -1 past
  -- the end) with no allocation at all, so representing atoms and classes as
  -- Ints instead removes essentially all of that.
  --
  -- This is safe for the same reason it is in `Json`/`Toml`: `string_chars`
  -- (and the old `char_at`) actually split a String into raw BYTES, not
  -- decoded Unicode characters (see `march_string_chars` in the runtime), so
  -- switching to `string_byte_at` changes nothing about which characters a
  -- pattern can match — including UTF-8 multibyte input, whose continuation
  -- bytes are >= 0x80 and can never collide with an ASCII regex metachar.

  ptype RegexAtom =
      RALit(Int)                  -- byte code of the literal
    | RAAny
    | RAClass(Bool, List(Int))    -- Bool = negated; Int = byte code
    | RADigit
    | RAWord
    | RASpace
    | RANotDigit
    | RANotWord
    | RANotSpace

  ptype RegexQuant = QOne | QZeroOrMore | QOneOrMore | QOptional

  ptype RegexItem = RegexItem(RegexAtom, RegexQuant)

  ptype RegexPattern = RegexPattern(Bool, List(RegexItem), Bool)
  -- RegexPattern(anchor_start, items, anchor_end)

  -- ── Private helpers ───────────────────────────────────────────────────────

  pfn rev(xs, acc) do
    match xs do
    Nil -> acc
    Cons(h, t) -> rev(t, Cons(h, acc))
    end
  end

  pfn list_contains_int(xs, x) do
    match xs do
    Nil -> false
    Cons(h, t) -> if h == x do true else list_contains_int(t, x) end
    end
  end

  -- Byte-code classifiers (ASCII only), mirroring the runtime's
  -- `march_char_is_digit` / `march_char_is_alphanumeric` /
  -- `march_char_is_whitespace`, but over a byte code rather than a 1-char
  -- String so no allocation is needed to test a position.
  pfn is_digit_byte(b) do
    b >= 48 && b <= 57
  end

  pfn is_alnum_byte(b) do
    is_digit_byte(b) || (b >= 97 && b <= 122) || (b >= 65 && b <= 90)
  end

  pfn is_word_byte(b) do
    is_alnum_byte(b) || b == 95   -- '_'
  end

  pfn is_space_byte(b) do
    b == 32 || b == 9 || b == 10 || b == 13 || b == 12 || b == 11
  end

  -- Test whether the atom matches the byte at position pos in string s.
  pfn atom_matches(atom, s, pos) do
    let c = string_byte_at(s, pos)
    if c < 0 do false
    else match atom do
    RALit(lit) -> c == lit
    RAAny -> true
    RADigit -> is_digit_byte(c)
    RAWord -> is_word_byte(c)
    RASpace -> is_space_byte(c)
    RANotDigit -> !is_digit_byte(c)
    RANotWord -> !is_word_byte(c)
    RANotSpace -> !is_space_byte(c)
    RAClass(negated, class_bytes) -> do
      let found = list_contains_int(class_bytes, c)
      if negated do !found else found end
    end
    end
    end
  end

  -- Count maximum consecutive matches of atom starting at pos.
  pfn count_atom_max(atom, s, pos) do
    fn go(p, n) do
      if atom_matches(atom, s, p) do go(p + 1, n + 1)
      else n end
    end
    go(pos, 0)
  end

  -- ── Linear-time matcher (NFA simulation) ─────────────────────────────────
  --
  -- `match_at` above is a BACKTRACKING matcher: each quantifier tries its
  -- longest run first and retries shorter ones on failure, and `find_match`
  -- retries every start position. Repeated quantifiers over the same class
  -- followed by a byte that never matches therefore cost O(n^k). Measured on
  -- `a*a*a*a*b` against a run of `a` (compiled, --opt 2):
  --
  --     n=20  0.013s     n=40  0.22s     n=60  1.40s     n=80  5.67s
  --
  -- 80 bytes of input, five seconds. That is a denial of service reachable
  -- from a pattern in a config file plus a short user-supplied string. Note
  -- it is POLYNOMIAL, not the exponential of the classic `(a+)+$` — that
  -- pattern is not even expressible here, because this engine has neither
  -- groups nor alternation.
  --
  -- That same narrowness is what makes the linear matcher small. The language
  -- is a FLAT sequence of quantified atoms, so the NFA is a line of states:
  -- state `i` means "items[0..i) have been consumed". No general Thompson
  -- construction is needed.
  --
  --   epsilon : i -> i+1   when item i may match zero times
  --   byte c  : i -> i+1   when atom i matches c and the quantifier is spent
  --             i -> i     when atom i matches c and may repeat
  --
  -- Simulating the SET of reachable states costs O(n * m) and cannot blow up:
  -- there are only m+1 states, so no amount of adversarial input can make the
  -- work per byte grow.

  -- Rewrite `X+` as `X X*` so the simulation only has to handle three
  -- quantifiers instead of four. `X+` is exactly one mandatory occurrence
  -- followed by any number of optional ones.
  pfn expand_plus(items, acc) do
    match items do
    Nil -> rev(acc, Nil)
    Cons(RegexItem(atom, quant), rest) ->
      match quant do
      QOneOrMore ->
        expand_plus(rest, Cons(RegexItem(atom, QZeroOrMore),
                               Cons(RegexItem(atom, QOne), acc)))
      _ -> expand_plus(rest, Cons(RegexItem(atom, quant), acc))
      end
    end
  end

  -- Sorted insert, skipping duplicates: the active set must not grow past
  -- m+1 entries or the linear bound is lost.
  pfn set_add(xs, v) do
    match xs do
    Nil -> Cons(v, Nil)
    Cons(h, t) ->
      if v < h do Cons(v, Cons(h, t))
      else if v == h do Cons(h, t)
      else Cons(h, set_add(t, v)) end end
    end
  end

  pfn list_len(xs, n) do
    match xs do
    Nil -> n
    Cons(_, t) -> list_len(t, n + 1)
    end
  end

  pfn item_at(items, i) do
    match items do
    Nil -> None
    Cons(h, t) -> if i <= 0 do Some(h) else item_at(t, i - 1) end
    end
  end

  -- Whether item i may match zero times, i.e. whether state i has an epsilon
  -- edge to i+1.
  pfn skippable(items, i) do
    match item_at(items, i) do
    None -> false
    Some(RegexItem(_, quant)) ->
      match quant do
      QZeroOrMore -> true
      QOptional -> true
      _ -> false
      end
    end
  end

  -- Add `i` and everything reachable from it by epsilon edges.
  pfn eclose_from(items, m, i, acc) do
    if i > m do
      acc
    else
      if list_contains_int(acc, i) do
        acc
      else
        let acc2 = set_add(acc, i)
        if i < m && skippable(items, i) do
          eclose_from(items, m, i + 1, acc2)
        else
          acc2
        end
      end
    end
  end

  pfn eclose(items, m, states, acc) do
    match states do
    Nil -> acc
    Cons(h, t) -> eclose(items, m, t, eclose_from(items, m, h, acc))
    end
  end

  -- One byte step: advance every active state that can consume `c`.
  pfn step_states(items, m, states, c, acc) do
    match states do
    Nil -> acc
    Cons(i, t) ->
      let acc2 = step_one(items, m, i, c, acc)
      step_states(items, m, t, c, acc2)
    end
  end

  pfn step_one(items, m, i, c, acc) do
    if i >= m do
      acc
    else
      match item_at(items, i) do
      None -> acc
      Some(RegexItem(atom, quant)) ->
        if !atom_matches_byte(atom, c) do
          acc
        else
          match quant do
          QZeroOrMore -> set_add(acc, i)
          _ -> set_add(acc, i + 1)
          end
        end
      end
    end
  end

  -- Byte-level atom test, shared with the backtracking matcher's semantics.
  pfn atom_matches_byte(atom, c) do
    if c < 0 do false
    else match atom do
    RALit(lit) -> c == lit
    RAAny -> true
    RADigit -> is_digit_byte(c)
    RAWord -> is_word_byte(c)
    RASpace -> is_space_byte(c)
    RANotDigit -> !is_digit_byte(c)
    RANotWord -> !is_word_byte(c)
    RANotSpace -> !is_space_byte(c)
    RAClass(negated, class_bytes) -> do
      let found = list_contains_int(class_bytes, c)
      if negated do !found else found end
    end
    end
    end
  end

  pfn nfa_loop(items, m, s, slen, pos, active, astart, aend) do
    if accepts_here(active, m, pos, slen, aend) do
      true
    else
      if pos >= slen do
        false
      else
        let c = string_byte_at(s, pos)
        let stepped = step_states(items, m, active, c, Nil)
        let seeded = if astart do stepped else set_add(stepped, 0) end
        nfa_loop(items, m, s, slen, pos + 1,
                 eclose(items, m, seeded, Nil), astart, aend)
      end
    end
  end

  pfn accepts_here(active, m, pos, slen, aend) do
    if !list_contains_int(active, m) do
      false
    else
      if aend do pos == slen else true end
    end
  end

  -- ── Linear-time SEARCH (match positions, not just a boolean) ────────────
  --
  -- `matches_linear` answers "is there a match" and needs no positions. The
  -- find/replace/split family needs a (start, end) span, so each active state
  -- additionally carries the EARLIEST input offset that reached it. When the
  -- accepting state is live, that offset is the match start.
  --
  -- Semantics: leftmost, then longest. Once a match starting at s0 is known,
  -- no new start states are seeded — a later start cannot be more leftmost —
  -- and the end is extended while states carrying s0 keep accepting. That is
  -- asserted to agree with the backtracking engine's answers by differential
  -- test rather than assumed; greedy backtracking and leftmost-longest are
  -- not the same rule in general.

  -- One entry per state, keeping the SMALLEST start offset seen for it.
  pfn ins_state(xs, st, sp) do
    match xs do
    Nil -> Cons((st, sp), Nil)
    Cons((s0, p0), t) ->
      if st < s0 do
        Cons((st, sp), Cons((s0, p0), t))
      else
        if st == s0 do
          if sp < p0 do Cons((st, sp), t) else Cons((s0, p0), t) end
        else
          Cons((s0, p0), ins_state(t, st, sp))
        end
      end
    end
  end

  pfn lookup_state(xs, st) do
    match xs do
    Nil -> None
    Cons((s0, p0), t) -> if s0 == st do Some(p0) else lookup_state(t, st) end
    end
  end

  pfn eclose_run(items, m, st, sp, acc) do
    if st > m do
      acc
    else
      let acc2 = ins_state(acc, st, sp)
      if st < m && skippable(items, st) do
        eclose_run(items, m, st + 1, sp, acc2)
      else
        acc2
      end
    end
  end

  pfn eclose2(items, m, xs, acc) do
    match xs do
    Nil -> acc
    Cons((st, sp), t) -> eclose2(items, m, t, eclose_run(items, m, st, sp, acc))
    end
  end

  pfn step2_one(items, m, st, sp, c, acc) do
    if st >= m do
      acc
    else
      match item_at(items, st) do
      None -> acc
      Some(RegexItem(atom, quant)) ->
        if !atom_matches_byte(atom, c) do
          acc
        else
          match quant do
          QZeroOrMore -> ins_state(acc, st, sp)
          _ -> ins_state(acc, st + 1, sp)
          end
        end
      end
    end
  end

  pfn step2(items, m, xs, c, acc) do
    match xs do
    Nil -> acc
    Cons((st, sp), t) -> step2(items, m, t, c, step2_one(items, m, st, sp, c, acc))
    end
  end

  -- Leftmost wins; at the same start, longest wins.
  pfn best_update(active, m, pos, slen, aend, best) do
    match lookup_state(active, m) do
    None -> best
    Some(sp) ->
      if aend && pos != slen do
        best
      else
        match best do
        None -> Some((sp, pos))
        Some((bs, be)) ->
          if sp < bs do
            Some((sp, pos))
          else
            if sp == bs && pos > be do Some((sp, pos)) else Some((bs, be)) end
          end
        end
      end
    end
  end

  pfn nfa_find_loop(items, m, s, slen, pos, active, astart, aend, best) do
    let best2 = best_update(active, m, pos, slen, aend, best)
    if pos >= slen do
      best2
    else
      let c = string_byte_at(s, pos)
      let stepped = step2(items, m, active, c, Nil)
      -- Seed a fresh start at pos+1 only while no match is known: once one
      -- starts at s0, a later start can never be more leftmost.
      let seeded =
        if astart do
          stepped
        else
          match best2 do
          Some(_) -> stepped
          None -> ins_state(stepped, 0, pos + 1)
          end
        end
      nfa_find_loop(items, m, s, slen, pos + 1,
                    eclose2(items, m, seeded, Nil), astart, aend, best2)
    end
  end

  -- Same contract as `find_match`: Some((match_start, match_end)) or None.
  pfn find_match_linear(rpat, s, slen, start) do
    match rpat do
    RegexPattern(astart, items0, aend) ->
      let items = expand_plus(items0, Nil)
      let m = list_len(items, 0)
      if astart && start > 0 do
        None
      else
        let start_states = eclose2(items, m, Cons((0, start), Nil), Nil)
        nfa_find_loop(items, m, s, slen, start, start_states, astart, aend, None)
      end
    end
  end

  doc """
  Whether `pattern` matches anywhere in `s`, in time linear in the input.

  Same answer as `matches`, without the backtracking blowup: this simulates
  the set of reachable NFA states, so the work per input byte is bounded by
  the pattern length no matter what the input is.
  """
  fn matches_linear(pattern : String, s : String) : Bool do
    match compile(pattern) do
    Err(_) -> false
    Ok(RegexPattern(astart, items0, aend)) -> do
      let items = expand_plus(items0, Nil)
      let m = list_len(items, 0)
      nfa_loop(items, m, s, string_byte_length(s), 0,
               eclose(items, m, Cons(0, Nil), Nil), astart, aend)
    end
    end
  end

  -- Try to match items starting at position pos in string s.
  -- anchor_end: if true, the match must consume the rest of the string.
  -- Returns Some(end_pos) on success, None on failure.
  pfn match_at(items, s, slen, pos, anchor_end) do
    match items do
    Nil -> do
      if anchor_end do
        if pos == slen do Some(pos) else None end
      else Some(pos) end
    end
    Cons(RegexItem(atom, quant), rest_items) -> do
      match quant do
      QOne ->
        if atom_matches(atom, s, pos) do
          match_at(rest_items, s, slen, pos + 1, anchor_end)
        else None end
      QOptional ->
        if atom_matches(atom, s, pos) do
          match match_at(rest_items, s, slen, pos + 1, anchor_end) do
          Some(r) -> Some(r)
          None -> match_at(rest_items, s, slen, pos, anchor_end)
          end
        else match_at(rest_items, s, slen, pos, anchor_end) end
      QZeroOrMore -> do
        let max_n = count_atom_max(atom, s, pos)
        fn try_n(n) do
          if n < 0 do None
          else match match_at(rest_items, s, slen, pos + n, anchor_end) do
            Some(r) -> Some(r)
            None -> try_n(n - 1)
            end end
        end
        try_n(max_n)
      end
      QOneOrMore ->
        if !atom_matches(atom, s, pos) do None
        else do
          let max_n = count_atom_max(atom, s, pos)
          fn try_n(n) do
            if n < 1 do None
            else match match_at(rest_items, s, slen, pos + n, anchor_end) do
              Some(r) -> Some(r)
              None -> try_n(n - 1)
              end end
          end
          try_n(max_n) end
        end
      end
    end
    end
  end

  -- Try to match the pattern anywhere in s starting from position `start`.
  -- Returns Some((match_start, match_end)) or None.
  pfn find_match(rpat, s, slen, start) do
    match rpat do
    RegexPattern(anchor_start, items, anchor_end) -> do
      if anchor_start do
        if start > 0 do None
        else match match_at(items, s, slen, 0, anchor_end) do
          None -> None
          Some(end_pos) -> Some((0, end_pos))
          end end
      else do
        fn try_pos(pos) do
          if pos > slen do None
          else match match_at(items, s, slen, pos, anchor_end) do
            Some(end_pos) -> Some((pos, end_pos))
            None -> try_pos(pos + 1)
            end end
        end
        try_pos(start) end
      end
    end
    end
  end

  -- ── Pattern parser ────────────────────────────────────────────────────────
  --
  -- Byte-index scanner over the pattern string, in the same style as
  -- `Json.parse` / `Toml.parse`: `i` is the current byte offset into
  -- `pattern`, inspected with `string_byte_at` (no allocation).  The only
  -- allocation on this path is `char_from_int` when building an error
  -- message — an off-the-hot-path cost, same as `Json.char_at`.
  --
  -- Byte codes used below: '*'=42 '+'=43 '-'=45 '.'=46 '?'=63 '['=91 '\\'=92
  -- ']'=93 '^'=94 '$'=36 'd'=100 'D'=68 'w'=119 'W'=87 's'=115 'S'=83
  -- 'n'=110 'r'=114 't'=116.

  -- Parse a character class body (between [ and ]), starting at byte `i`
  -- (the byte just after '[' or "[^").
  -- Returns Ok((class_bytes, next_i)) or Err(message).
  pfn parse_class_body(pattern, i, acc) do
    let b = string_byte_at(pattern, i)
    if b < 0 do Err("unterminated character class '[...]'")
    else if b == 93 do Ok((rev(acc, Nil), i + 1))
    else if b == 92 do do
      let e = string_byte_at(pattern, i + 1)
      if e < 0 do Err("unterminated character class '[...]'")
      else do
        let ch =
          if e == 110 do 10
          else if e == 114 do 13
          else if e == 116 do 9
          else e end end end
        parse_class_body(pattern, i + 2, Cons(ch, acc))
      end
    end
    end
    else do
      -- Possible range notation: b '-' c2 expands b..c2 inclusive.
      let dash = string_byte_at(pattern, i + 1)
      if dash == 45 do
        let c2 = string_byte_at(pattern, i + 2)
        if c2 == 93 || c2 < 0 do
          -- '-' at end (or class truncated): treat '-' as literal.
          parse_class_body(pattern, i + 1, Cons(b, acc))
        else do
          let lo = b
          let hi = c2
          fn add_range(code, a) do
            if code > hi do a
            else add_range(code + 1, Cons(code, a)) end
          end
          parse_class_body(pattern, i + 3, add_range(lo, acc))
        end
        end
      else
        parse_class_body(pattern, i + 1, Cons(b, acc))
      end
    end
    end end end
  end

  -- Parse one atom from the pattern starting at byte `i`.
  -- Returns Ok((atom, next_i)) or Err(message).
  pfn parse_atom(pattern, i) do
    let b = string_byte_at(pattern, i)
    if b < 0 do Err("expected atom but reached end of pattern")
    else if b == 46 do Ok((RAAny, i + 1))
    else if b == 92 do do
      let e = string_byte_at(pattern, i + 1)
      if e < 0 do
        -- Trailing lone backslash: treat as a literal backslash.
        Ok((RALit(92), i + 1))
      else do
        let atom =
          if e == 100 do RADigit
          else if e == 68 do RANotDigit
          else if e == 119 do RAWord
          else if e == 87 do RANotWord
          else if e == 115 do RASpace
          else if e == 83 do RANotSpace
          else RALit(e) end end end end end end
        Ok((atom, i + 2))
      end
      end
    end
    else if b == 91 do do
      let (negated, i2) =
        if string_byte_at(pattern, i + 1) == 94 do (true, i + 2)
        else (false, i + 1) end
      match parse_class_body(pattern, i2, Nil) do
      Err(e) -> Err(e)
      Ok((class_bytes, next_i)) -> Ok((RAClass(negated, class_bytes), next_i))
      end
    end
    else do
      if b == 42 || b == 43 || b == 63 do
        Err("quantifier '" ++ char_from_int(b) ++ "' without preceding atom")
      else Ok((RALit(b), i + 1)) end
    end
    end end end end
  end

  -- Parse the quantifier (if any) starting at byte `i`.
  pfn parse_quant(pattern, i) do
    let b = string_byte_at(pattern, i)
    if b == 42 do (QZeroOrMore, i + 1)
    else if b == 43 do (QOneOrMore, i + 1)
    else if b == 63 do (QOptional, i + 1)
    else (QOne, i) end end end
  end

  -- Parse all items from the pattern, stopping at end or '$'.
  -- Returns Ok((items, anchor_end, next_i)) or Err(message).
  pfn parse_items(pattern, i, acc) do
    let b = string_byte_at(pattern, i)
    if b < 0 do Ok((rev(acc, Nil), false, i))
    else if b == 36 do
      -- '$' anchors the end.  A '$' in the middle of the pattern is
      -- treated the same way (simplification): parsing simply stops here.
      Ok((rev(acc, Nil), true, i + 1))
    else do
      match parse_atom(pattern, i) do
      Err(e) -> Err(e)
      Ok((atom, i2)) -> do
        let (quant, i3) = parse_quant(pattern, i2)
        parse_items(pattern, i3, Cons(RegexItem(atom, quant), acc))
      end
      end
    end
    end end
  end

  -- Parse a complete regex pattern string.
  -- Returns Ok(RegexPattern) or Err(message).
  pfn compile(pattern) do
    let (anchor_start, i0) =
      if string_byte_at(pattern, 0) == 94 do (true, 1)
      else (false, 0) end
    match parse_items(pattern, i0, Nil) do
    Err(e) -> Err(e)
    Ok((items, anchor_end, _)) -> Ok(RegexPattern(anchor_start, items, anchor_end))
    end
  end

  -- ── Public API ────────────────────────────────────────────────────────────

  -- Regex matching options.  Pass to the `*_opts` variants of the
  -- public match functions.
  --
  -- - case_insensitive: when true, ASCII letters in both the pattern
  --   and the input are folded to lowercase before matching.
  -- - multiline: reserved for future use.  Currently `^` always matches
  --   string start and `$` always matches string end; line-aware
  --   behaviour is not yet implemented.
  type RegexOpts = { case_insensitive : Bool, multiline : Bool }

  doc "Default options: all flags disabled (case-sensitive, single-line)."
  fn default_opts() : RegexOpts do
    { case_insensitive: false, multiline: false }
  end

  -- Apply the case-insensitive transform to both pattern and input.
  -- ASCII-only fold: non-ASCII bytes pass through unchanged.
  pfn fold_case(opts : RegexOpts, pattern : String, string : String) : (String, String) do
    if opts.case_insensitive do
      (string_to_lowercase(pattern), string_to_lowercase(string))
    else
      (pattern, string)
    end
  end

  doc """
  Test whether `pattern` matches anywhere in `string`.
  If pattern starts with '^', the match is anchored to the start.
  If pattern ends with '$', the match is anchored to the end.

      Regex.matches("\\d+", "hello 42 world")  -- true
      Regex.matches("^hello", "hello world")   -- true
      Regex.matches("^hello", "say hello")     -- false
  """
  fn matches(pattern, string) do
    matches_opts(pattern, string, default_opts())
  end

  doc """
  Like `matches`, but accepts a `RegexOpts` record for per-call flags.

      Regex.matches_opts("HELLO", "hello world",
                         { case_insensitive: true, multiline: false })
      -- true
  """
  fn matches_opts(pattern, string, opts) do
    -- Routed through the NFA simulation, not the backtracking matcher: a
    -- boolean "does it match" needs no match positions, so the linear engine
    -- answers it exactly and cannot be made to blow up. `fold_case` is a
    -- pre-transform on the pattern and subject, so the option flags compose
    -- with either engine unchanged.
    let (p, s) = fold_case(opts, pattern, string)
    matches_linear(p, s)
  end

  doc """
  The original backtracking `matches`, retained for differential testing.

  Kept public and named so the parity tests can compare the two engines; a
  test that compared the linear engine against itself would prove nothing.
  Do not use it on untrusted input — see `matches_linear` for why.
  """
  fn find_backtracking(pattern : String, string : String) : Option(String) do
    match compile(pattern) do
    Err(_) -> None
    Ok(rpat) -> do
      let slen = string_byte_length(string)
      match find_match(rpat, string, slen, 0) do
      None -> None
      Some((ms, me)) -> Some(string_slice(string, ms, me - ms))
      end
    end
    end
  end

  doc """
  The original backtracking `find`, retained for differential testing only.
  Do not use it on untrusted input.
  """
  fn find_linear(pattern : String, string : String) : Option(String) do
    match compile(pattern) do
    Err(_) -> None
    Ok(rpat) -> do
      let slen = string_byte_length(string)
      match find_match_linear(rpat, string, slen, 0) do
      None -> None
      Some((ms, me)) -> Some(string_slice(string, ms, me - ms))
      end
    end
    end
  end

  fn matches_backtracking(pattern : String, string : String) : Bool do
    match compile(pattern) do
    Err(_) -> false
    Ok(rpat) -> do
      let slen = string_byte_length(string)
      match find_match(rpat, string, slen, 0) do
      None -> false
      Some(_) -> true
      end
    end
    end
  end

  doc """
  Find the first match of `pattern` in `string`.
  Returns Some(matched_substring) or None.

      Regex.find("\\d+", "price: 42 dollars")  -- Some("42")
      Regex.find("xyz", "hello")               -- None
  """
  fn find(pattern, string) do
    match compile(pattern) do
    Err(_) -> None
    Ok(rpat) -> do
      let slen = string_byte_length(string)
      match find_match_linear(rpat, string, slen, 0) do
      None -> None
      Some((s, e)) -> Some(string_slice(string, s, e - s))
      end
    end
    end
  end

  doc """
  Find all non-overlapping matches of `pattern` in `string`.
  Returns a list of matched substrings in order.

      Regex.find_all("\\d+", "a1 b22 c333")  -- ["1", "22", "333"]
  """
  fn find_all(pattern, string) do
    match compile(pattern) do
    Err(_) -> Nil
    Ok(rpat) -> do
      let slen = string_byte_length(string)
      fn go(pos, acc) do
        if pos > slen do rev(acc, Nil)
        else match find_match_linear(rpat, string, slen, pos) do
          None -> rev(acc, Nil)
          Some((s, e)) -> do
            let matched = string_slice(string, s, e - s)
            -- Advance at least 1 to avoid infinite loops on zero-length matches
            let next = if e > s do e else s + 1 end
            go(next, Cons(matched, acc))
          end
          end
          end
      end
      go(0, Nil)
    end
    end
  end

  doc """
  Replace the first match of `pattern` in `string` with `replacement`.
  Returns the resulting string.

      Regex.replace("\\d+", "NUM", "price 42")  -- "price NUM"
  """
  fn replace(pattern, replacement, string) do
    match compile(pattern) do
    Err(_) -> string
    Ok(rpat) -> do
      let slen = string_byte_length(string)
      match find_match_linear(rpat, string, slen, 0) do
      None -> string
      Some((s, e)) ->
        string_slice(string, 0, s) ++ replacement ++ string_slice(string, e, slen - e)
      end
    end
    end
  end

  doc """
  Replace all non-overlapping matches of `pattern` in `string` with `replacement`.
  Returns the resulting string.

      Regex.replace_all("\\d", "X", "a1b2c3")  -- "aXbXcX"
  """
  fn replace_all(pattern, replacement, string) do
    match compile(pattern) do
    Err(_) -> string
    Ok(rpat) -> do
      let slen = string_byte_length(string)
      fn go(pos, acc_parts) do
        if pos > slen do
          let parts = rev(acc_parts, Nil)
          string_join(parts, "")
        else match find_match_linear(rpat, string, slen, pos) do
          None -> do
            let tail = string_slice(string, pos, slen - pos)
            let parts = rev(Cons(tail, acc_parts), Nil)
            string_join(parts, "")
          end
          Some((s, e)) -> do
            let before = string_slice(string, pos, s - pos)
            let next = if e > s do e else s + 1 end
            go(next, Cons(replacement, Cons(before, acc_parts)))
          end
          end
        end
      end
      go(0, Nil)
    end
    end
  end

  doc """
  Split `string` on matches of `pattern`.
  Returns the list of substrings between matches.

      Regex.split("\\s+", "hello   world  foo")  -- ["hello", "world", "foo"]
      Regex.split(",", "a,b,c")                   -- ["a", "b", "c"]
  """
  fn split(pattern, string) do
    match compile(pattern) do
    Err(_) -> Cons(string, Nil)
    Ok(rpat) -> do
      let slen = string_byte_length(string)
      fn go(pos, acc) do
        if pos > slen do rev(acc, Nil)
        else match find_match_linear(rpat, string, slen, pos) do
          None -> do
            let tail = string_slice(string, pos, slen - pos)
            rev(Cons(tail, acc), Nil)
          end
          Some((s, e)) -> do
            let segment = string_slice(string, pos, s - pos)
            let next = if e > s do e else s + 1 end
            go(next, Cons(segment, acc))
          end
          end
        end
      end
      go(0, Nil)
    end
    end
  end

end
