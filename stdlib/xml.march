-- Non-validating XML parser (pure March, no FFI, namespace-unaware).
--
-- Supports: elements, attributes (double/single-quoted), text nodes,
-- CDATA sections, comments, processing instructions, XML declaration,
-- DOCTYPE declarations (skipped), entity references (&lt; &gt; &amp;
-- &quot; &apos;), self-closing tags.
--
-- Public API:
--   Xml.parse(src)             : Result(XmlDoc, XmlError)
--   Xml.parse_exn(src)         : XmlDoc  (panics on error)
--   Xml.to_string(doc)         : String
--   Xml.to_string_pretty(doc)  : String
--   Xml.root(doc)              : XmlNode
--   Xml.tag(node)              : Option(String)
--   Xml.text(node)             : Option(String)
--   Xml.attr(node, name)       : Option(String)
--   Xml.children(node)         : List(XmlNode)
--   Xml.elements(node)         : List(XmlNode)
--   Xml.find(node, path)       : Option(XmlNode)
--   Xml.find_all(node, path)   : List(XmlNode)
--   Xml.elem(tag, attrs, kids) : XmlNode
--   Xml.text_node(s)           : XmlNode

mod Xml do

  type XmlNode
    = Element(String, List((String, String)), List(XmlNode))
    | Text(String)
    | CData(String)
    | Comment(String)
    | ProcessingInstruction(String, String)

  type XmlDoc = XmlDoc(Option(String), XmlNode)

  type XmlError = XmlError(String, Int, Int)

  -- Stack frame used by the iterative parser (open element being built).
  type XmlFrame = XmlFrame(String, List((String, String)), List(XmlNode))

  -- ── Scanning discipline ───────────────────────────────────────────────────
  --
  -- Byte-index cursor over the source string, following the pattern used for
  -- Json.parse (commit 556cf7e9) and Toml.parse (commit "perf(toml): rewrite
  -- parser as a byte-index scanner"): a scan step inspects bytes with
  -- `string_byte_at` (no allocation) and each token is materialised with a
  -- single `string_slice` (or, for text/attribute content containing entity
  -- references, a handful of slices joined once). The previous parser did
  -- `string_split(src, "")` up front and built every token via `acc ++ c` --
  -- one fresh heap string per character, and O(n^2) copying for an n-byte
  -- token.
  --
  -- Structural XML characters are all ASCII, and every byte of a multibyte
  -- UTF-8 sequence is >= 0x80, so scanning raw bytes never mistakes a
  -- multibyte character for a delimiter; multibyte text just passes through
  -- inside a token slice untouched.
  --
  -- State is (src, byte_index, line, col). `col` counts BYTES rather than
  -- decoded characters (a minor, deliberate divergence from the previous
  -- char-list parser, matching the Json/Toml rewrites' precedent).

  -- ── Parser state ──────────────────────────────────────────────────────────

  pfn make_state(src) do (src, 0, 1, 0) end

  pfn st_line(st) do match st do (_, _, l, _) -> l end end
  pfn st_col(st)  do match st do (_, _, _, c) -> c end end

  pfn cur_byte(st) do
    match st do (s, i, _, _) -> string_byte_at(s, i) end
  end

  pfn advance(st) do
    match st do
    (s, i, line, col) ->
      let b = string_byte_at(s, i)
      if b < 0 do st
      else if b == 10 do (s, i + 1, line + 1, 0)
      else (s, i + 1, line, col + 1)
      end end
    end
  end

  pfn at_end(st) do cur_byte(st) < 0 end

  -- The byte one past the cursor (used for two-character lookahead).
  pfn next_byte(st) do
    match st do (s, i, _, _) -> string_byte_at(s, i + 1) end
  end

  -- Recompute (line, col) after jumping the cursor to byte index `j`,
  -- counting any newlines crossed. Used after a raw byte-index scan (which
  -- never touches the state tuple) to rebuild a consistent state once.
  pfn reposition_go(s, j, k, line, col) do
    if k >= j do (s, j, line, col)
    else
      let b = string_byte_at(s, k)
      if b == 10 do reposition_go(s, j, k + 1, line + 1, 0)
      else reposition_go(s, j, k + 1, line, col + 1)
      end
    end
  end

  pfn reposition(st, j) do
    match st do (s, i0, line0, col0) -> reposition_go(s, j, i0, line0, col0) end
  end

  pfn err(st, msg) do
    Err(XmlError(msg, st_line(st), st_col(st)))
  end

  pfn err_at(st, fail_i, msg) do
    err(reposition(st, fail_i), msg)
  end

  -- Byte width of the UTF-8 character starting with lead byte `b`. Used only
  -- to slice a whole character back out for an error message.
  pfn utf8_width(b) do
    if b < 128 do 1
    else if b < 224 do 2
    else if b < 240 do 3
    else 4 end end end
  end

  pfn char1(s, i) do string_slice(s, i, utf8_width(string_byte_at(s, i))) end

  pfn char1_at(st) do
    match st do (s, i, _, _) -> char1(s, i) end
  end

  -- ── Segment-slicing helpers (shared by text/attr-value scanners) ─────────

  -- Push the run [start, i) onto `acc` (newest first) if it's non-empty.
  pfn push_seg(s, start, i, acc) do
    if i > start do Cons(string_slice(s, start, i - start), acc) else acc end
  end

  -- Materialise `acc` plus the trailing run [start, i): a single slice in the
  -- common no-entity case, one string_join if the token was split by entity
  -- references.
  pfn finish_join(s, start, i, acc) do
    match acc do
    Nil -> string_slice(s, start, i - start)
    _   -> string_join(List.reverse(push_seg(s, start, i, acc)), "")
    end
  end

  -- Match a literal `lit` at byte `i`. Returns the index just past it, or -1
  -- on mismatch. `lit` is itself indexed with string_byte_at, so no list of
  -- expected chars is ever built.
  pfn match_lit_go(s, i, lit, j) do
    let e = string_byte_at(lit, j)
    if e < 0 do i
    else
      let c = string_byte_at(s, i)
      if c == e do match_lit_go(s, i + 1, lit, j + 1)
      else -1
      end
    end
  end

  -- True if `lit` matches starting at the cursor.
  pfn starts_with(st, lit) do
    match st do (s, i, _, _) -> match_lit_go(s, i, lit, 0) >= 0 end
  end

  -- Advance the cursor past `n` bytes of an already-matched ASCII literal
  -- (never crosses a newline in practice, but reposition stays correct
  -- either way).
  pfn skip_n(st, n) do
    match st do (_, i, _, _) -> reposition(st, i + n) end
  end

  -- Find the first byte index >= i at which `lit` matches, or -1 if `lit`
  -- never occurs before the end of the string.
  pfn find_lit(s, i, lit) do
    if match_lit_go(s, i, lit, 0) >= 0 do i
    else
      let b = string_byte_at(s, i)
      if b < 0 do -1
      else find_lit(s, i + 1, lit)
      end
    end
  end

  -- Find the first ';' at or after byte index i, or -1 if none.
  pfn find_semi(s, i) do
    let b = string_byte_at(s, i)
    if b < 0 do -1
    else if b == 59 do i
    else find_semi(s, i + 1)
    end end
  end

  -- ── Byte-class predicates ─────────────────────────────────────────────────

  pfn is_ws_byte(b) do b == 32 || b == 9 || b == 10 || b == 13 end

  pfn is_name_start_byte(n) do
    (n >= 65 && n <= 90) || (n >= 97 && n <= 122) || n == 95 || n == 58
  end

  pfn is_name_char_byte(n) do
    (n >= 65 && n <= 90) || (n >= 97 && n <= 122) || (n >= 48 && n <= 57) ||
    n == 95 || n == 58 || n == 45 || n == 46
  end

  -- ── Skip whitespace ───────────────────────────────────────────────────────

  pfn skip_ws(st) do
    if is_ws_byte(cur_byte(st)) do skip_ws(advance(st))
    else st
    end
  end

  -- ── Parse a name (tag name / attribute name) ─────────────────────────────

  pfn name_end(s, i) do
    if is_name_char_byte(string_byte_at(s, i)) do name_end(s, i + 1) else i end
  end

  pfn parse_name(st) do
    match st do
    (s, i, _, _) ->
      let b = string_byte_at(s, i)
      if b < 0 do err(st, "expected name but got end of input")
      else if is_name_start_byte(b) do
        let j = name_end(s, i)
        Ok((string_slice(s, i, j - i), reposition(st, j)))
      else err(st, "expected name start char, got '" ++ char1_at(st) ++ "'")
      end end
    end
  end

  -- ── Entity reference ──────────────────────────────────────────────────────

  -- `i` is the byte index right after '&'. Returns Ok((decoded, next_index))
  -- or Err((message, failure_index)).
  pfn parse_entity_at(s, i) do
    let b = string_byte_at(s, i)
    if b < 0 do Err(("unterminated entity reference", i))
    else if b == 108 do
      -- &lt;
      let j = match_lit_go(s, i, "lt;", 0)
      if j < 0 do Err(("unknown entity", i))
      else Ok(("<", j))
      end
    else if b == 103 do
      -- &gt;
      let j = match_lit_go(s, i, "gt;", 0)
      if j < 0 do Err(("unknown entity", i))
      else Ok((">", j))
      end
    else if b == 97 do
      -- &amp; or &apos;
      let j1 = match_lit_go(s, i, "amp;", 0)
      if j1 >= 0 do Ok(("&", j1))
      else
        let j2 = match_lit_go(s, i, "apos;", 0)
        if j2 >= 0 do Ok(("'", j2))
        else Err(("unknown entity", i))
        end
      end
    else if b == 113 do
      -- &quot;
      let j = match_lit_go(s, i, "quot;", 0)
      if j < 0 do Err(("unknown entity", i))
      else Ok(("\"", j))
      end
    else if b == 35 do
      -- Numeric character reference: skip to ';' and return '?'
      let j = find_semi(s, i + 1)
      if j < 0 do Err(("unterminated entity", i))
      else Ok(("?", j + 1))
      end
    else
      -- Unknown entity: skip to ';'
      let j = find_semi(s, i)
      if j < 0 do Err(("unterminated entity", i))
      else Ok(("?", j + 1))
      end
    end end end end end end end

  -- ── Collect text with entity expansion (stops at '<') ────────────────────

  pfn collect_text_go(s, i, start, acc) do
    let b = string_byte_at(s, i)
    if b < 0 do Ok((finish_join(s, start, i, acc), i))
    else if b == 60 do Ok((finish_join(s, start, i, acc), i))
    else if b == 38 do
      match parse_entity_at(s, i + 1) do
      Err(e) -> Err(e)
      Ok((ch, ni)) -> collect_text_go(s, ni, ni, Cons(ch, push_seg(s, start, i, acc)))
      end
    else collect_text_go(s, i + 1, start, acc)
    end end end
  end

  pfn collect_text(st) do
    match st do
    (s, i, _, _) ->
      match collect_text_go(s, i, i, Nil) do
      Err((msg, fi)) -> err_at(st, fi, msg)
      Ok((v, j)) -> Ok((v, reposition(st, j)))
      end
    end
  end

  -- ── Collect attr value (stops at quote byte, expands entities) ───────────

  pfn collect_attr_value_go(s, i, start, acc, quote_byte) do
    let b = string_byte_at(s, i)
    if b < 0 do Err(("unterminated attribute value", i))
    else if b == quote_byte do Ok((finish_join(s, start, i, acc), i + 1))
    else if b == 38 do
      match parse_entity_at(s, i + 1) do
      Err(e) -> Err(e)
      Ok((ch, ni)) -> collect_attr_value_go(s, ni, ni, Cons(ch, push_seg(s, start, i, acc)), quote_byte)
      end
    else collect_attr_value_go(s, i + 1, start, acc, quote_byte)
    end end end
  end

  pfn collect_attr_value(st, quote_byte) do
    match st do
    (s, i, _, _) ->
      match collect_attr_value_go(s, i, i, Nil, quote_byte) do
      Err((msg, fi)) -> err_at(st, fi, msg)
      Ok((v, j)) -> Ok((v, reposition(st, j)))
      end
    end
  end

  -- ── Parse attributes ─────────────────────────────────────────────────────

  pfn parse_attrs(st, acc) do
    let st1 = skip_ws(st)
    let b = cur_byte(st1)
    if b < 0 do err(st1, "unexpected EOF in attributes")
    else if b == 47 do Ok((List.reverse(acc), st1))
    else if b == 62 do Ok((List.reverse(acc), st1))
    else if is_name_start_byte(b) do
      match parse_name(st1) do
      Err(e) -> Err(e)
      Ok(p) ->
        match p do
        (attr_name, st2) ->
          let st3 = skip_ws(st2)
          if cur_byte(st3) == 61 do
            let st4 = skip_ws(advance(st3))
            let b4 = cur_byte(st4)
            if b4 == 34 do
              match collect_attr_value(advance(st4), 34) do
              Err(e) -> Err(e)
              Ok(p2) ->
                match p2 do
                (val, st5) -> parse_attrs(st5, Cons((attr_name, val), acc))
                end
              end
            else if b4 == 39 do
              match collect_attr_value(advance(st4), 39) do
              Err(e) -> Err(e)
              Ok(p2) ->
                match p2 do
                (val, st5) -> parse_attrs(st5, Cons((attr_name, val), acc))
                end
              end
            else err(st4, "expected quote after '='")
            end end
          else
            -- Boolean attribute (no value)
            parse_attrs(st3, Cons((attr_name, ""), acc))
          end
        end
      end
    else err(st1, "unexpected '" ++ char1_at(st1) ++ "' in attributes")
    end end end end
  end

  -- ── Collect comment body <!-- ... --> ────────────────────────────────────

  pfn collect_comment_body(st) do
    match st do
    (s, i, _, _) ->
      let j = find_lit(s, i, "-->")
      if j < 0 do err(st, "unterminated comment")
      else Ok((string_slice(s, i, j - i), reposition(st, j + 3)))
      end
    end
  end

  -- ── Collect CDATA body <![CDATA[ ... ]]> ─────────────────────────────────

  pfn collect_cdata_body(st) do
    match st do
    (s, i, _, _) ->
      let j = find_lit(s, i, "]]>")
      if j < 0 do err(st, "unterminated CDATA")
      else Ok((string_slice(s, i, j - i), reposition(st, j + 3)))
      end
    end
  end

  -- ── Collect PI body <?target data?> ──────────────────────────────────────

  pfn collect_pi_body(st) do
    match st do
    (s, i, _, _) ->
      let j = find_lit(s, i, "?>")
      if j < 0 do err(st, "unterminated PI")
      else Ok((string_slice(s, i, j - i), reposition(st, j + 2)))
      end
    end
  end

  -- ── Skip DOCTYPE <!DOCTYPE ...> ──────────────────────────────────────────

  -- max_chars guards against stack overflow from malformed DOCTYPE with
  -- deeply nested brackets (e.g. <!DOCTYPE [[[[...); 65536 is far beyond
  -- any legitimate DOCTYPE declaration.
  pfn skip_doctype(st, depth, max_chars) do
    if max_chars == 0 do
      err(st, "DOCTYPE too large")
    else
      let b = cur_byte(st)
      if b < 0 do err(st, "unterminated DOCTYPE")
      else if b == 62 do
        if depth == 0 do Ok(advance(st))
        else skip_doctype(advance(st), depth - 1, max_chars - 1)
        end
      else if b == 91 do skip_doctype(advance(st), depth + 1, max_chars - 1)
      else skip_doctype(advance(st), depth, max_chars - 1)
      end end end
    end
  end

  -- ── Iterative stack-based XML parser ─────────────────────────────────────
  --
  -- Uses an explicit stack of XmlFrame to avoid mutual recursion between
  -- element and content parsing (March requires all recursive calls to be
  -- in tail position).  Each iteration processes one "token" and tail-calls
  -- itself with the updated state and stack.
  --
  -- stack = [] means we are at prolog/epilog level (before/after root).
  -- stack = [frame, ...] means we are inside open elements.

  pfn xml_loop(st, stack) do
    let st1 = skip_ws(st)
    let b = cur_byte(st1)
    if b < 0 do
      match stack do
      Nil -> err(st1, "empty document: no root element")
      Cons(XmlFrame(t, _, _), _) ->
        err(st1, "unexpected EOF: unclosed tag <" ++ t ++ ">")
      end
    else if b == 60 do
      let st2 = advance(st1)
      let b2 = cur_byte(st2)

      if b2 == 47 do
        -- Closing tag </name>
        let st3 = advance(st2)
        match parse_name(st3) do
        Err(e) -> Err(e)
        Ok(pname) ->
          match pname do
          (close_name, st4) ->
            let st5 = skip_ws(st4)
            if cur_byte(st5) == 62 do
              let st6 = advance(st5)
              match stack do
              Nil ->
                err(st5, "unexpected closing tag </" ++ close_name ++ ">")
              Cons(XmlFrame(open_name, attrs, rev_kids), parent_stack) ->
                if close_name != open_name do
                  err(st5, "mismatched tag: </" ++ open_name ++ "> expected, got </" ++ close_name ++ ">")
                else
                  let element = Element(open_name, attrs, List.reverse(rev_kids))
                  match parent_stack do
                  Nil ->
                    -- Root element complete; only whitespace/EOF may follow
                    let st7 = skip_ws(st6)
                    if at_end(st7) do Ok(element)
                    else err(st7, "trailing content after root element")
                    end
                  Cons(XmlFrame(pt, pa, pkids), gps) ->
                    xml_loop(st6, Cons(XmlFrame(pt, pa, Cons(element, pkids)), gps))
                  end
                end
              end
            else err(st5, "expected '>' after closing tag name")
            end
          end
        end

      else if b2 == 33 do
        let st3 = advance(st2)
        let b3 = cur_byte(st3)
        if b3 == 45 do
          -- Comment: <!--
          if next_byte(st3) == 45 do
            match collect_comment_body(advance(advance(st3))) do
            Err(e) -> Err(e)
            Ok(p) ->
              match p do
              (body, st4) ->
                match stack do
                Nil -> xml_loop(st4, stack)
                Cons(XmlFrame(t, a, kids), rest) ->
                  xml_loop(st4, Cons(XmlFrame(t, a, Cons(Comment(body), kids)), rest))
                end
              end
            end
          else err(st3, "expected '--' for comment")
          end
        else if b3 == 91 do
          -- CDATA: <![CDATA[
          if starts_with(st3, "[CDATA[") do
            match collect_cdata_body(skip_n(st3, 7)) do
            Err(e) -> Err(e)
            Ok(p) ->
              match p do
              (body, st4) ->
                match stack do
                Nil -> err(st3, "CDATA before root element")
                Cons(XmlFrame(t, a, kids), rest) ->
                  xml_loop(st4, Cons(XmlFrame(t, a, Cons(CData(body), kids)), rest))
                end
              end
            end
          else err(st3, "expected CDATA section")
          end
        else
          -- DOCTYPE or other declaration: skip to matching '>'
          match skip_doctype(st3, 0, 65536) do
          Err(e) -> Err(e)
          Ok(st4) -> xml_loop(st4, stack)
          end
        end end

      else if b2 == 63 do
        -- Processing instruction
        let st3 = advance(st2)
        match parse_name(st3) do
        Err(e) -> Err(e)
        Ok(p) ->
          match p do
          (pi_target, st4) ->
            let st5 = skip_ws(st4)
            match collect_pi_body(st5) do
            Err(e) -> Err(e)
            Ok(p2) ->
              match p2 do
              (pi_data, st6) ->
                match stack do
                Nil -> xml_loop(st6, stack)
                Cons(XmlFrame(t, a, kids), rest) ->
                  xml_loop(st6, Cons(XmlFrame(t, a, Cons(ProcessingInstruction(pi_target, pi_data), kids)), rest))
                end
              end
            end
          end
        end

      else
        -- Opening element tag (or the root element)
        match parse_name(st2) do
        Err(e) -> Err(e)
        Ok(p) ->
          match p do
          (tag_name, st3) ->
            let st4 = skip_ws(st3)
            match parse_attrs(st4, []) do
            Err(e) -> Err(e)
            Ok(p2) ->
              match p2 do
              (attrs, st5) ->
                let b5 = cur_byte(st5)
                if b5 == 47 do
                  -- Self-closing <tag ... />
                  let st6 = advance(st5)
                  if cur_byte(st6) == 62 do
                    let st7 = advance(st6)
                    let self_elem = Element(tag_name, attrs, [])
                    match stack do
                    Nil ->
                      let st8 = skip_ws(st7)
                      if at_end(st8) do Ok(self_elem)
                      else err(st8, "trailing content after root element")
                      end
                    Cons(XmlFrame(t, a, kids), rest) ->
                      xml_loop(st7, Cons(XmlFrame(t, a, Cons(self_elem, kids)), rest))
                    end
                  else err(st6, "expected '>' after '/'")
                  end
                else if b5 == 62 do
                  -- Opening tag: push new frame
                  xml_loop(advance(st5), Cons(XmlFrame(tag_name, attrs, []), stack))
                else if b5 < 0 do
                  err(st5, "unexpected EOF in tag")
                else
                  err(st5, "unexpected '" ++ char1_at(st5) ++ "' in tag")
                end end end
              end
            end
          end
        end
      end end end

    else
      -- Text content (including entities)
      match stack do
      Nil ->
        err(st1, "text content before root element")
      Cons(XmlFrame(t, a, kids), rest) ->
        match collect_text(st1) do
        Err(e) -> Err(e)
        Ok(p) ->
          match p do
          (txt, st2) ->
            let new_kids =
              match txt do
              "" -> kids
              _  -> Cons(Text(txt), kids)
              end
            xml_loop(st2, Cons(XmlFrame(t, a, new_kids), rest))
          end
        end
      end
    end end
  end

  -- ── Public API ────────────────────────────────────────────────────────────

  doc """
  Parse an XML string. Returns Ok(XmlDoc) on success or Err(XmlError) on failure.
  This is a non-validating parser: it does not check DTDs or enforce constraints
  beyond well-formedness.

      Xml.parse("<root><item>hello</item></root>")
      -- Ok(XmlDoc(None, Element("root", [], [Element("item", [], [Text("hello")])])))
  """
  fn parse(src : String) : Result(XmlDoc, XmlError) do
    let st = make_state(src)
    match xml_loop(st, []) do
    Err(e) -> Err(e)
    Ok(root_node) -> Ok(XmlDoc(None, root_node))
    end
  end

  doc "Parse XML, panicking on error."
  fn parse_exn(src : String) : XmlDoc do
    match parse(src) do
    Ok(xdoc) -> xdoc
    Err(e) ->
      match e do
      XmlError(msg, line, col) ->
        panic("XML parse error at " ++ int_to_string(line) ++ ":" ++ int_to_string(col) ++ ": " ++ msg)
      end
    end
  end

  doc "Get the root element of a document."
  fn root(xdoc : XmlDoc) : XmlNode do
    match xdoc do XmlDoc(_, r) -> r end
  end

  doc "Get the tag name of an element node, or None for non-element nodes."
  fn tag(node : XmlNode) : Option(String) do
    match node do
    Element(t, _, _) -> Some(t)
    _                -> None
    end
  end

  doc "Get the concatenated direct text content of a node, or None if no text children."
  fn text(node : XmlNode) : Option(String) do
    match node do
    Text(s) -> Some(s)
    CData(s) -> Some(s)
    Element(_, _, children) ->
      let texts = List.filter_map(children, fn child ->
        match child do
        Text(s) -> Some(s)
        CData(s) -> Some(s)
        _ -> None
        end)
      match texts do
      Nil -> None
      _   -> Some(String.join(texts, ""))
      end
    _ -> None
    end
  end

  doc "Get the value of an attribute by name, or None if absent."
  fn attr(node : XmlNode, name : String) : Option(String) do
    match node do
    Element(_, attrs, _) ->
      match List.find(attrs, fn p -> match p do (k, _) -> k == name end) do
      None -> None
      Some(p) -> match p do (_, v) -> Some(v) end
      end
    _ -> None
    end
  end

  doc "Get all child nodes of an element (text, elements, comments, etc.)."
  fn children(node : XmlNode) : List(XmlNode) do
    match node do
    Element(_, _, kids) -> kids
    _                   -> []
    end
  end

  doc "Get only element-type children (filters out text, comments, etc.)."
  fn elements(node : XmlNode) : List(XmlNode) do
    match node do
    Element(_, _, kids) ->
      List.filter(kids, fn kid ->
        match kid do
        Element(_, _, _) -> true
        _ -> false
        end)
    _ -> []
    end
  end

  doc """
  Navigate to the first node matching a slash-delimited tag path.

      Xml.find(root, "item/name")  -- finds <item><name>...</name></item>
  """
  fn find(node : XmlNode, path : String) : Option(XmlNode) do
    let parts = string_split(path, "/")
    find_path(node, parts)
  end

  pfn find_path(node, parts) do
    match parts do
    Nil -> Some(node)
    Cons(seg, rest) ->
      match find_child_by_tag(node, seg) do
      None -> None
      Some(child) -> find_path(child, rest)
      end
    end
  end

  pfn find_child_by_tag(node, tag_name) do
    find_child_by_tag_in(elements(node), tag_name)
  end

  pfn find_child_by_tag_in(kids, tag_name) do
    match kids do
    Nil -> None
    Cons(e, rest) ->
      match e do
      Element(t, _, _) ->
        if t == tag_name do Some(e)
        else find_child_by_tag_in(rest, tag_name)
        end
      _ -> find_child_by_tag_in(rest, tag_name)
      end
    end
  end

  doc """
  Find all element children at the last segment of a slash-delimited path.

      Xml.find_all(root, "items/item")  -- all <item> inside <items>
  """
  fn find_all(node : XmlNode, path : String) : List(XmlNode) do
    let parts = string_split(path, "/")
    match List.reverse(parts) do
    Nil -> []
    Cons(last_seg, rev_prefix) ->
      let prefix = List.reverse(rev_prefix)
      let parent_node = find_path(node, prefix)
      match parent_node do
      None -> []
      Some(parent) ->
        List.filter(elements(parent), fn kid ->
          match kid do
          Element(t, _, _) -> t == last_seg
          _ -> false
          end)
      end
    end
  end

  doc "Construct an element node."
  fn elem(tag_name : String, attrs : List((String, String)), kids : List(XmlNode)) : XmlNode do
    Element(tag_name, attrs, kids)
  end

  doc "Construct a text node."
  fn text_node(s : String) : XmlNode do
    Text(s)
  end

  -- ── Serialization ─────────────────────────────────────────────────────────

  pfn escape_xml_text_go(s, i, start, acc) do
    let b = string_byte_at(s, i)
    if b < 0 do finish_join(s, start, i, acc)
    else if b == 60 do escape_xml_text_go(s, i + 1, i + 1, Cons("&lt;", push_seg(s, start, i, acc)))
    else if b == 62 do escape_xml_text_go(s, i + 1, i + 1, Cons("&gt;", push_seg(s, start, i, acc)))
    else if b == 38 do escape_xml_text_go(s, i + 1, i + 1, Cons("&amp;", push_seg(s, start, i, acc)))
    else escape_xml_text_go(s, i + 1, start, acc)
    end end end end
  end

  pfn escape_xml_text(s) do escape_xml_text_go(s, 0, 0, Nil) end

  pfn escape_xml_attr_go(s, i, start, acc) do
    let b = string_byte_at(s, i)
    if b < 0 do finish_join(s, start, i, acc)
    else if b == 60 do escape_xml_attr_go(s, i + 1, i + 1, Cons("&lt;", push_seg(s, start, i, acc)))
    else if b == 62 do escape_xml_attr_go(s, i + 1, i + 1, Cons("&gt;", push_seg(s, start, i, acc)))
    else if b == 38 do escape_xml_attr_go(s, i + 1, i + 1, Cons("&amp;", push_seg(s, start, i, acc)))
    else if b == 34 do escape_xml_attr_go(s, i + 1, i + 1, Cons("&quot;", push_seg(s, start, i, acc)))
    else escape_xml_attr_go(s, i + 1, start, acc)
    end end end end end
  end

  pfn escape_xml_attr(s) do escape_xml_attr_go(s, 0, 0, Nil) end

  pfn node_to_string(node) do
    match node do
    Text(s) -> escape_xml_text(s)
    CData(s) -> "<![CDATA[" ++ s ++ "]]>"
    Comment(s) -> "<!--" ++ s ++ "-->"
    ProcessingInstruction(target, data) ->
      if data == "" do "<?" ++ target ++ "?>"
      else "<?" ++ target ++ " " ++ data ++ "?>"
      end
    Element(t, attrs, kids) ->
      let attr_str = String.join(
        List.map(attrs, fn p -> match p do (k, v) -> " " ++ k ++ "=\"" ++ escape_xml_attr(v) ++ "\"" end),
        "")
      match kids do
      Nil -> "<" ++ t ++ attr_str ++ "/>"
      _   ->
        let body = String.join(List.map(kids, fn k -> node_to_string(k)), "")
        "<" ++ t ++ attr_str ++ ">" ++ body ++ "</" ++ t ++ ">"
      end
    end
  end

  doc "Serialize an XmlDoc to a compact XML string."
  fn to_string(xdoc : XmlDoc) : String do
    match xdoc do
    XmlDoc(_, root_node) -> node_to_string(root_node)
    end
  end

  pfn node_to_string_pretty(node, indent) do
    let pad = String.join(List.map(List.range(0, indent), fn _ -> "  "), "")
    match node do
    Text(s) ->
      let trimmed = string_trim(s)
      if trimmed == "" do ""
      else pad ++ escape_xml_text(trimmed) ++ "\n"
      end
    CData(s) -> pad ++ "<![CDATA[" ++ s ++ "]]>\n"
    Comment(s) -> pad ++ "<!--" ++ s ++ "-->\n"
    ProcessingInstruction(target, data) ->
      if data == "" do pad ++ "<?" ++ target ++ "?>\n"
      else pad ++ "<?" ++ target ++ " " ++ data ++ "?>\n"
      end
    Element(t, attrs, kids) ->
      let attr_str = String.join(
        List.map(attrs, fn p -> match p do (k, v) -> " " ++ k ++ "=\"" ++ escape_xml_attr(v) ++ "\"" end),
        "")
      match kids do
      Nil -> pad ++ "<" ++ t ++ attr_str ++ "/>\n"
      _   ->
        let child_strs = List.filter(
          List.map(kids, fn k -> node_to_string_pretty(k, indent + 1)),
          fn s -> s != "")
        let body = String.join(child_strs, "")
        pad ++ "<" ++ t ++ attr_str ++ ">\n" ++ body ++ pad ++ "</" ++ t ++ ">\n"
      end
    end
  end

  doc "Serialize an XmlDoc to a pretty-printed XML string."
  fn to_string_pretty(xdoc : XmlDoc) : String do
    match xdoc do
    XmlDoc(_, root_node) -> node_to_string_pretty(root_node, 0)
    end
  end

end
