-- Iterable module: sequence operations over List(a).
--
-- This module provides a unified set of sequence operations: map, filter,
-- fold, take, drop, zip, enumerate, flat_map, any, all, find, count.
--
-- All functions operate on List(a). When the runtime gains interface dispatch,
-- these will be generalised to work over any type implementing Iterable(a).
--
-- The Iterable interface (future):
--
--   interface Iterable(a) do
--     fn next(self : Self) : Option((a, Self))
--   end
--
--   impl Iterable(a) for List(a) do
--     fn next(xs : List(a)) : Option((a, List(a))) do
--       match xs do
--       Nil        -> None
--       Cons(h, t) -> Some((h, t))
--       end
--     end
--   end
--
-- Until then, every function here takes and returns List(a).
--
-- doc: try

mod Iterable do

  -- Internal reverse helper (avoid depending on Prelude order)
  pfn rev(xs : List(a)) : List(a) do
    fn go(lst : List(a), acc : List(a)) : List(a) do
      match lst do
      Nil        -> acc
      Cons(h, t) -> go(t, Cons(h, acc))
      end
    end
    go(xs, Nil)
  end

  -- ---- Transformation ----

  doc """
  Applies `f` to each element, returning a new list of results in order.

  ## Examples

      march> Iterable.map([1, 2, 3], fn x -> x * 10)
      [10, 20, 30]
      march> Iterable.map([], fn x -> x * 10)
      []
  """
  fn map(xs : List(a), f : a -> b) : List(b) do
    fn go(lst : List(a), acc : List(b)) : List(b) do
      match lst do
      Nil        -> rev(acc)
      Cons(h, t) -> go(t, Cons(f(h), acc))
      end
    end
    go(xs, Nil)
  end

  doc """
  Applies `f` to each element and concatenates the resulting lists, in order.
  O(total output length).

  ## Examples

      march> Iterable.flat_map([1, 2, 3], fn x -> [x, x])
      [1, 1, 2, 2, 3, 3]
      march> Iterable.flat_map([1, 2], fn _ -> [])
      []
  """
  fn flat_map(xs : List(a), f : a -> List(b)) : List(b) do
    -- O(total output): accumulate each f(h) reversed onto acc, reverse once at
    -- the end. The old append-based version was O(total^2) and non-tail.
    fn prepend_reversed(sub : List(b), acc : List(b)) : List(b) do
      match sub do
      Nil           -> acc
      Cons(x, rest) -> prepend_reversed(rest, Cons(x, acc))
      end
    end
    fn go(lst : List(a), acc : List(b)) : List(b) do
      match lst do
      Nil        -> rev(acc)
      Cons(h, t) -> go(t, prepend_reversed(f(h), acc))
      end
    end
    go(xs, Nil)
  end

  doc """
  Returns only the elements for which `pred` returns true, preserving order.

  ## Examples

      march> Iterable.filter([1, 2, 3, 4], fn x -> x % 2 == 0)
      [2, 4]
  """
  fn filter(xs : List(a), pred : a -> Bool) : List(a) do
    fn go(lst : List(a), acc : List(a)) : List(a) do
      match lst do
      Nil        -> rev(acc)
      Cons(h, t) -> do
        if pred(h) do go(t, Cons(h, acc))
        else go(t, acc) end
      end
      end
    end
    go(xs, Nil)
  end

  -- ---- Reduction ----

  doc """
  Left fold: reduces the list from left to right using an accumulator.
  Argument order: collection first, init second, callback last
  (uncurried-collection convention).  Callback `f(acc, x)` returns the
  new accumulator. Returns `zero` for an empty list.

  ## Examples

      march> Iterable.fold([1, 2, 3], 0, fn (acc, x) -> acc + x)
      6
      march> Iterable.fold(["a", "b", "c"], "", fn (acc, x) -> acc ++ x)
      "abc"
  """
  fn fold(xs : List(a), zero : b, f : b -> a -> b) : b do
    fn go(lst : List(a), acc : b) : b do
      match lst do
      Nil        -> acc
      Cons(h, t) -> go(t, f(acc, h))
      end
    end
    go(xs, zero)
  end

  doc """
  Returns the number of elements in the list. O(n).

  ## Examples

      march> Iterable.count([1, 2, 3])
      3
      march> Iterable.count([])
      0
  """
  fn count(xs : List(a)) : Int do
    fn go(lst : List(a), acc : Int) : Int do
      match lst do
      Nil        -> acc
      Cons(_, t) -> go(t, acc + 1)
      end
    end
    go(xs, 0)
  end

  doc """
  Returns true if any element satisfies `pred`, stopping at the first match.
  False for an empty list.

  ## Examples

      march> Iterable.any([1, 2, 3], fn x -> x > 2)
      true
      march> Iterable.any([], fn x -> x > 2)
      false
  """
  fn any(xs : List(a), pred : a -> Bool) : Bool do
    match xs do
    Nil        -> false
    Cons(h, t) -> do
      if pred(h) do true
      else any(t, pred) end
    end
    end
  end

  doc """
  Returns true if every element satisfies `pred`, stopping at the first
  failure. True for an empty list.

  ## Examples

      march> Iterable.all([1, 2, 3], fn x -> x > 0)
      true
      march> Iterable.all([1, -2, 3], fn x -> x > 0)
      false
      march> Iterable.all([], fn x -> x > 0)
      true
  """
  fn all(xs : List(a), pred : a -> Bool) : Bool do
    match xs do
    Nil        -> true
    Cons(h, t) -> do
      if pred(h) do all(t, pred)
      else false end
    end
    end
  end

  doc """
  Returns the first element satisfying `pred` as `Some`, or `None` if there
  is none.

  ## Examples

      march> Iterable.find([1, 2, 3, 4], fn x -> x > 2)
      Some(3)
      march> Iterable.find([1, 2], fn x -> x > 5)
      None
  """
  fn find(xs : List(a), pred : a -> Bool) : Option(a) do
    match xs do
    Nil        -> None
    Cons(h, t) -> do
      if pred(h) do Some(h)
      else find(t, pred) end
    end
    end
  end

  -- ---- Slicing ----

  doc """
  Returns the first `n` elements. Returns the whole list if `n >= length`
  and `[]` if `n <= 0`.

  ## Examples

      march> Iterable.take([1, 2, 3], 2)
      [1, 2]
      march> Iterable.take([1, 2, 3], 5)
      [1, 2, 3]
      march> Iterable.take([1, 2, 3], -1)
      []
  """
  fn take(xs : List(a), n : Int) : List(a) do
    -- Tail-recursive accumulator + single reverse (the Cons-wrapped recursion
    -- below was non-tail and built O(n) stack).
    fn go(lst : List(a), k : Int, acc : List(a)) : List(a) do
      if k <= 0 do rev(acc)
      else match lst do
        Nil        -> rev(acc)
        Cons(h, t) -> go(t, k - 1, Cons(h, acc))
        end end
    end
    go(xs, n, Nil)
  end

  doc """
  Drops the first `n` elements. Returns `[]` if `n >= length` and the whole
  list if `n <= 0`.

  ## Examples

      march> Iterable.drop([1, 2, 3], 2)
      [3]
      march> Iterable.drop([1, 2, 3], 5)
      []
      march> Iterable.drop([1, 2, 3], -1)
      [1, 2, 3]
  """
  fn drop(xs : List(a), n : Int) : List(a) do
    if n <= 0 do xs
    else match xs do
      Nil        -> Nil
      Cons(_, t) -> drop(t, n - 1)
      end end
  end

  -- ---- Combining ----

  doc """
  Pairs up elements from two lists. Stops at the shorter list; the extra
  elements of the longer one are dropped.

  ## Examples

      march> Iterable.zip([1, 2, 3], ["a", "b"])
      [(1, "a"), (2, "b")]
  """
  fn zip(xs : List(a), ys : List(b)) : List((a, b)) do
    -- Tail-recursive accumulator + single reverse (the Cons-wrapped recursion
    -- was non-tail and built O(min(n,m)) stack).
    fn go(al : List(a), bl : List(b), acc : List((a, b))) : List((a, b)) do
      match al do
      Nil -> rev(acc)
      Cons(x, xt) -> do
        match bl do
        Nil -> rev(acc)
        Cons(y, yt) -> go(xt, yt, Cons((x, y), acc))
        end
      end
      end
    end
    go(xs, ys, Nil)
  end

  doc """
  Pairs each element with its 0-based index, index first.

  ## Examples

      march> Iterable.enumerate(["a", "b"])
      [(0, "a"), (1, "b")]
      march> Iterable.enumerate([])
      []
  """
  fn enumerate(xs : List(a)) : List((Int, a)) do
    fn go(lst : List(a), i : Int, acc : List((Int, a))) : List((Int, a)) do
      match lst do
      Nil        -> rev(acc)
      Cons(h, t) -> go(t, i + 1, Cons((i, h), acc))
      end
    end
    go(xs, 0, Nil)
  end

end
