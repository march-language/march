-- SortedSet module: AVL tree-based sorted set.
--
-- Same AVL design as OrderedMap, storing elements only (its own tree type,
-- not an OrderedMap underneath).
-- Keys are ordered by a user-supplied comparator function:
--   cmp(a, b) < 0  means a < b
--   cmp(a, b) = 0  means a = b
--   cmp(a, b) > 0  means a > b
-- The built-in `compare` works for Int, String and other ordered values.
-- add / remove / member are O(log n); to_list and fold run in ascending order.
-- Binary operations (union, intersect, difference, subset) use each
-- argument's own comparator for its own tree; the result of union,
-- intersect and difference keeps `a`'s comparator.
--
-- doc: try

mod SortedSet do

  -- Internal AVL tree (same as OrderedMap, keyed by element, value: unit).
  -- Named apart from OrderedMap's `Tree`/`Leaf`/`Node`: the refinement checker
  -- does not qualify datatype or constructor names by module, and the proofs
  -- below need this tree's constructors to be its own.
  type AvlTree(a) = AvlLeaf | AvlNode(AvlTree(a), a, AvlTree(a), Int)

  -- ---- Internal helpers ----

  -- The elements of a tree, as a set.  Logic only: the refinement checker
  -- proves the tree operations below against it.
  @[measure]
  pfn sorted_set_elts(t : AvlTree(a)) : Set(a) do
    match t do
    AvlLeaf -> empty
    AvlNode(l, k, r, _) -> union(sorted_set_elts(l), union(singleton(k), sorted_set_elts(r)))
    end
  end

  -- The comparator law, stated once: every proof below that needs `x` to be
  -- the element `k` it compared equal to reads it from here.  ASSUMED: it
  -- holds when `cmp` returns 0 exactly for equal elements, the same trust the
  -- module's documented comparator contract already asks for.
  @[assume]
  pfn compare_by(cmp : a -> a -> Int, x : a, k : a) : {Int | (_ == 0) == (x == k)} do
    cmp(x, k)
  end

  pfn height(t : AvlTree(a)) : Int do
    match t do
    AvlLeaf -> 0
    AvlNode(_, _, _, h) -> h
    end
  end

  pfn make_node(l : AvlTree(a), k : a, r : AvlTree(a)) : {AvlTree(a) | sorted_set_elts(_) == union(sorted_set_elts(l), union(singleton(k), sorted_set_elts(r)))} do
    let lh = height(l)
    let rh = height(r)
    let h = if lh > rh do lh + 1 else rh + 1 end
    AvlNode(l, k, r, h)
  end

  pfn rotate_right(t : AvlTree(a)) : {AvlTree(a) | sorted_set_elts(_) == sorted_set_elts(t)} do
    match t do
    AvlNode(AvlNode(ll, lk, lr, _), k, r, _) ->
      let new_r = make_node(lr, k, r)
      make_node(ll, lk, new_r)
    _ -> t
    end
  end

  pfn rotate_left(t : AvlTree(a)) : {AvlTree(a) | sorted_set_elts(_) == sorted_set_elts(t)} do
    match t do
    AvlNode(l, k, AvlNode(rl, rk, rr, _), _) ->
      let new_l = make_node(l, k, rl)
      make_node(new_l, rk, rr)
    _ -> t
    end
  end

  pfn bf(t : AvlTree(a)) : Int do
    match t do
    AvlLeaf -> 0
    AvlNode(l, _, r, _) -> height(l) - height(r)
    end
  end

  pfn balance(t : AvlTree(a)) : {AvlTree(a) | sorted_set_elts(_) == sorted_set_elts(t)} do
    match t do
    AvlLeaf -> AvlLeaf
    AvlNode(l, k, r, _) ->
      let b = height(l) - height(r)
      if b > 1 do
        if bf(l) < 0 do
          rotate_right(make_node(rotate_left(l), k, r))
        else
          rotate_right(t)
        end
      else
        if b < -1 do
          if bf(r) > 0 do
            rotate_left(make_node(l, k, rotate_right(r)))
          else
            rotate_left(t)
          end
        else
          make_node(l, k, r)
        end
      end
    end
  end

  pfn tree_insert(t : AvlTree(a), cmp : a -> a -> Int, x : a) : {AvlTree(a) | sorted_set_elts(_) == union(sorted_set_elts(t), singleton(x))} do
    match t do
    AvlLeaf -> AvlNode(AvlLeaf, x, AvlLeaf, 1)
    AvlNode(l, k, r, _) ->
      let c = compare_by(cmp, x, k)
      if c < 0 do
        balance(make_node(tree_insert(l, cmp, x), k, r))
      else
        if c > 0 do
          balance(make_node(l, k, tree_insert(r, cmp, x)))
        else
          t
        end
      end
    end
  end

  pfn tree_member(t : AvlTree(a), cmp : a -> a -> Int, x : a) : Bool do
    match t do
    AvlLeaf -> false
    AvlNode(l, k, r, _) ->
      let c = compare_by(cmp, x, k)
      if c < 0 do
        tree_member(l, cmp, x)
      else
        if c > 0 do
          tree_member(r, cmp, x)
        else
          true
        end
      end
    end
  end

  pfn tree_min(t : AvlTree(a)) : Option(a) do
    match t do
    AvlLeaf -> None
    AvlNode(AvlLeaf, k, _, _) -> Some(k)
    AvlNode(l, _, _, _) -> tree_min(l)
    end
  end

  pfn tree_delete_min(t : AvlTree(a)) : {AvlTree(a) | subset(sorted_set_elts(_), sorted_set_elts(t))} do
    match t do
    AvlLeaf -> AvlLeaf
    AvlNode(AvlLeaf, _, r, _) -> r
    AvlNode(l, k, r, _) -> balance(make_node(tree_delete_min(l), k, r))
    end
  end

  pfn tree_delete(t : AvlTree(a), cmp : a -> a -> Int, x : a) : AvlTree(a) do
    match t do
    AvlLeaf -> AvlLeaf
    AvlNode(l, k, r, _) ->
      let c = compare_by(cmp, x, k)
      if c < 0 do
        balance(make_node(tree_delete(l, cmp, x), k, r))
      else
        if c > 0 do
          balance(make_node(l, k, tree_delete(r, cmp, x)))
        else
          match tree_min(r) do
          None -> l
          Some(rk) -> balance(make_node(l, rk, tree_delete_min(r)))
          end
        end
      end
    end
  end

  pfn tree_to_list(t : AvlTree(a), acc : List(a)) : {List(a) | elts(_) == union(sorted_set_elts(t), elts(acc))} do
    match t do
    AvlLeaf -> acc
    AvlNode(l, k, r, _) -> tree_to_list(l, Cons(k, tree_to_list(r, acc)))
    end
  end

  pfn tree_size(t : AvlTree(a)) : Int do
    match t do
    AvlLeaf -> 0
    AvlNode(l, _, r, _) -> 1 + tree_size(l) + tree_size(r)
    end
  end

  pfn tree_fold(t : AvlTree(a), acc : b, f : b -> a -> b) : b do
    match t do
    AvlLeaf -> acc
    AvlNode(l, k, r, _) ->
      let acc2 = tree_fold(l, acc, f)
      let acc3 = f(acc2, k)
      tree_fold(r, acc3, f)
    end
  end

  pfn tree_max(t : AvlTree(a)) : Option(a) do
    match t do
    AvlLeaf -> None
    AvlNode(_, k, AvlLeaf, _) -> Some(k)
    AvlNode(_, _, r, _) -> tree_max(r)
    end
  end

  -- ---- Public API ----

  doc """
  Creates a new empty sorted set with the given comparator.

  ## Examples

      march> SortedSet.is_empty(SortedSet.new(compare))
      true
  """
  fn new(cmp : a -> a -> Int) : {cmp: a -> a -> Int, tree: AvlTree(a)} do
    {cmp: cmp, tree: AvlLeaf}
  end

  doc """
  Adds element v to the set. No-op if already present.  O(log n).

  ## Examples

      march> SortedSet.to_list(SortedSet.add(SortedSet.from_list([3, 1], compare), 2))
      [1, 2, 3]
      march> SortedSet.size(SortedSet.add(SortedSet.from_list([1], compare), 1))
      1
  """
  fn add(s : {cmp: a -> a -> Int, tree: AvlTree(a)}, v : a) : {cmp: a -> a -> Int, tree: AvlTree(a)} do
    {cmp: s.cmp, tree: tree_insert(s.tree, s.cmp, v)}
  end

  doc """
  Removes element v from the set. No-op if not present.  O(log n).

  ## Examples

      march> SortedSet.to_list(SortedSet.remove(SortedSet.from_list([1, 2, 3], compare), 2))
      [1, 3]
      march> SortedSet.to_list(SortedSet.remove(SortedSet.from_list([1, 2, 3], compare), 9))
      [1, 2, 3]
  """
  fn remove(s : {cmp: a -> a -> Int, tree: AvlTree(a)}, v : a) : {cmp: a -> a -> Int, tree: AvlTree(a)} do
    {cmp: s.cmp, tree: tree_delete(s.tree, s.cmp, v)}
  end

  doc """
  Returns true if v is in the set.  O(log n).

  ## Examples

      march> SortedSet.member(SortedSet.from_list(["a", "b"], compare), "b")
      true
      march> SortedSet.member(SortedSet.from_list(["a", "b"], compare), "c")
      false
  """
  fn member(s : {cmp: a -> a -> Int, tree: AvlTree(a)}, v : a) : Bool do
    tree_member(s.tree, s.cmp, v)
  end

  doc """
  Returns all elements in ascending order.

  ## Examples

      march> SortedSet.to_list(SortedSet.from_list(["pear", "apple", "fig"], compare))
      ["apple", "fig", "pear"]
      march> SortedSet.to_list(SortedSet.new(compare))
      []
  """
  fn to_list(s : {cmp: a -> a -> Int, tree: AvlTree(a)}) : List(a) do
    tree_to_list(s.tree, Nil)
  end

  doc """
  Builds a set from a list of elements; duplicates are kept once.  O(n log n).

  ## Examples

      march> SortedSet.to_list(SortedSet.from_list([3, 1, 2, 3, 1], compare))
      [1, 2, 3]
  """
  fn from_list(items : List(a), cmp : a -> a -> Int) : {cmp: a -> a -> Int, tree: AvlTree(a)} do
    List.fold_left(items, new(cmp), fn (s, v) -> add(s, v))
  end

  doc """
  Returns the number of elements in the set.  O(n): the count is not cached.

  ## Examples

      march> SortedSet.size(SortedSet.from_list([5, 5, 6], compare))
      2
  """
  fn size(s : {cmp: a -> a -> Int, tree: AvlTree(a)}) : Int do
    tree_size(s.tree)
  end

  doc """
  Returns the smallest element, or None if empty.  O(log n).

  ## Examples

      march> SortedSet.min(SortedSet.from_list([3, 1, 2], compare))
      Some(1)
      march> SortedSet.min(SortedSet.new(compare))
      None
  """
  fn min(s : {cmp: a -> a -> Int, tree: AvlTree(a)}) : Option(a) do
    tree_min(s.tree)
  end

  doc """
  Returns the largest element, or None if empty.  O(log n).

  ## Examples

      march> SortedSet.max(SortedSet.from_list([3, 1, 2], compare))
      Some(3)
      march> SortedSet.max(SortedSet.new(compare))
      None
  """
  fn max(s : {cmp: a -> a -> Int, tree: AvlTree(a)}) : Option(a) do
    tree_max(s.tree)
  end

  doc """
  Returns a set containing all elements in either a or b (adds each element
  of b to a; the result keeps a's comparator).

  ## Examples

      march> SortedSet.to_list(SortedSet.union(SortedSet.from_list([1, 3], compare), SortedSet.from_list([2, 3], compare)))
      [1, 2, 3]
  """
  fn union(a : {cmp: k -> k -> Int, tree: AvlTree(k)}, b : {cmp: k -> k -> Int, tree: AvlTree(k)}) : {cmp: k -> k -> Int, tree: AvlTree(k)} do
    List.fold_left(to_list(b), a, fn (s, v) -> add(s, v))
  end

  doc """
  Returns a set containing only elements in both a and b (the result keeps
  a's comparator).

  ## Examples

      march> SortedSet.to_list(SortedSet.intersect(SortedSet.from_list([1, 2, 3], compare), SortedSet.from_list([2, 3, 4], compare)))
      [2, 3]
      march> SortedSet.is_empty(SortedSet.intersect(SortedSet.from_list([1], compare), SortedSet.from_list([2], compare)))
      true
  """
  fn intersect(a : {cmp: k -> k -> Int, tree: AvlTree(k)}, b : {cmp: k -> k -> Int, tree: AvlTree(k)}) : {cmp: k -> k -> Int, tree: AvlTree(k)} do
    List.fold_left(to_list(a), new(a.cmp), fn (s, v) ->
      if tree_member(b.tree, b.cmp, v) do add(s, v) else s end)
  end

  doc """
  Returns a set of elements in a that are not in b (removes each element of
  b from a; the result keeps a's comparator).

  ## Examples

      march> SortedSet.to_list(SortedSet.difference(SortedSet.from_list([1, 2, 3], compare), SortedSet.from_list([2, 9], compare)))
      [1, 3]
  """
  fn difference(a : {cmp: k -> k -> Int, tree: AvlTree(k)}, b : {cmp: k -> k -> Int, tree: AvlTree(k)}) : {cmp: k -> k -> Int, tree: AvlTree(k)} do
    List.fold_left(to_list(b), a, fn (s, v) -> remove(s, v))
  end

  doc """
  Folds over the set in ascending order: f(acc, element) -> acc.

  ## Examples

      march> SortedSet.fold(SortedSet.from_list([3, 1, 2], compare), 0, fn (acc, x) -> acc * 10 + x)
      123
  """
  fn fold(s : {cmp: a -> a -> Int, tree: AvlTree(a)}, acc : b, f : b -> a -> b) : b do
    tree_fold(s.tree, acc, f)
  end

  doc """
  Returns true if the set is empty.  O(1).

  ## Examples

      march> SortedSet.is_empty(SortedSet.remove(SortedSet.from_list([1], compare), 1))
      true
      march> SortedSet.is_empty(SortedSet.from_list([1], compare))
      false
  """
  fn is_empty(s : {cmp: a -> a -> Int, tree: AvlTree(a)}) : Bool do
    match s.tree do
    AvlLeaf -> true
    _ -> false
    end
  end

  doc """
  Returns true if a is a subset of b (every element of a is in b).  The
  empty set is a subset of every set.

  ## Examples

      march> SortedSet.subset(SortedSet.from_list([1, 3], compare), SortedSet.from_list([1, 2, 3], compare))
      true
      march> SortedSet.subset(SortedSet.from_list([1, 4], compare), SortedSet.from_list([1, 2, 3], compare))
      false
      march> SortedSet.subset(SortedSet.new(compare), SortedSet.from_list([1], compare))
      true
  """
  fn subset(a : {cmp: k -> k -> Int, tree: AvlTree(k)}, b : {cmp: k -> k -> Int, tree: AvlTree(k)}) : Bool do
    List.all(to_list(a), fn v -> tree_member(b.tree, b.cmp, v))
  end

end
