-- SwimDriver: runtime I/O glue for the pure Swim state machine (P2 L3).
--
-- Owns the RNG and period timer so the transport layer just calls
-- step(state, now, events) each tick. The driver picks probe targets and
-- indirect helpers randomly, advances the Swim FSM, and returns the Actions
-- the transport must perform (send ping, send ping-req, gossip). The
-- transport reads frames, decodes them into Events, and calls step again.
--
-- Wire protocol (Msgpack array, first element is the tag):
--   0 SwimPing(sender_id)
--   1 SwimPingAck(sender_id)
--   2 SwimPingReq(requester_id, target_id)
--   3 SwimGossip(node_id, status_int, incarnation)
--     status_int: 0=Alive, 1=Suspect, 2=Dead
--   3 SwimGossipLoad(node_id, status_int, incarnation, [load_ints])
--     5-element frame: the 5th element is a Msgpack array of NodeLoad ints
--     (same tag 3, distinguished by element count)
--
-- Period lifecycle (period_ms ≈ 1000–5000 ms is typical):
--   1. step() at period boundary: end prior probe → expire suspects →
--      refute if suspected → begin new period (pick random target).
--   2. step() mid-period: if ack_timeout has elapsed and probe is unacked,
--      escalate to k-way indirect ping-req.
--   3. Transport delivers PingAck events when acks arrive; GossipFrame events
--      when gossip frames are decoded; PeerDown events on socket close.
--
-- Anti-entropy (P5a):
--   anti_entropy_peers(s, now) returns live peers when the 30s timer fires.
--   The transport calls this each tick and sends REGISTRY_SYNC_REQ to peers.
--   bump_anti_entropy(s, now) resets the timer after firing.
--
-- Load gossip (P4):
--   peer_loads tracks the last NodeLoad heard from each live peer, stamped
--   with its receipt time on this node's clock (never the sender's).
--   dispatch_all_with_load embeds the local NodeLoad in outgoing Gossip frames.
mod SwimDriver do

  pfn load_stale_ms() : Int do 10000 end
  pfn anti_entropy_period_ms() : Int do 30000 end

  type State = {
    swim               : Swim.State,
    rng                : Random.Rng,
    period_ms          : Int,
    period_end         : Int,     -- unix_time_ms when the current period expires (0 = not started)
    peer_loads         : Map(String, NodeLoad),  -- last NodeLoad heard from each peer
    anti_entropy_next  : Int      -- unix_time_ms of next anti-entropy sweep (0 = fire immediately)
  }

  -- Events delivered from the transport layer each tick.
  type Event =
      PingAck(String)                    -- received a PingAck from this node_id
    | GossipFrame(Member)                -- received and decoded a gossip member update
    | GossipWithLoad(Member, NodeLoad)   -- gossip + piggybacked load sample
    | PeerDown(String)                   -- transport confirmed this peer is gone (definitive: Dead)
    | ConnLost(String)                   -- a connection to this peer closed (a hint: Suspect)

  -- Wire messages.
  type WireMsg =
      SwimPing(String)                         -- sender_id
    | SwimPingAck(String)                      -- sender_id
    | SwimPingReq(String, String)              -- requester_id, target_id
    | SwimGossip(String, MemberStatus, Int)    -- node_id, status, incarnation
    | SwimGossipLoad(String, MemberStatus, Int, NodeLoad)  -- with piggybacked load

  doc """
  A driver for node [me] wrapping a fresh `Swim.make(me, incarnation, members,
  swim_cfg)`, with an RNG seeded from [seed] and a protocol period of
  [period_ms]. The period timer and the anti-entropy timer both start at 0, so
  the first `step` begins a period and the first `anti_entropy_peers` fires.
  """
  fn make(me : String, incarnation : Int, members : Members, swim_cfg : Swim.Config,
          period_ms : Int, seed : Int) : State do
    { swim: Swim.make(me, incarnation, members, swim_cfg),
      rng:  Random.seed(seed),
      period_ms: period_ms,
      period_end: 0,
      peer_loads: Map.empty(),
      anti_entropy_next: 0 }
  end

  -- ── target / helper selection ─────────────────────────────────────────────

  pfn alive_others(s : State) : List(String) do
    let alive = Membership.alive_members(s.swim.members)
    let others = List.filter(alive, fn m -> m.node_id != s.swim.me)
    List.map(others, fn m -> m.node_id)
  end

  pfn pick_target(s : State) : (State, Option(String)) do
    let candidates = alive_others(s)
    match candidates do
      Nil ->
        let out = (s, None)
        out
      _ ->
        let choice = Random.choice(s.rng, candidates)
        let node_id = match choice do (n, _) -> n end
        let rng2 = match choice do (_, r) -> r end
        let out = ({ s with rng: rng2 }, Some(node_id))
        out
    end
  end

  pfn pick_helpers(s : State, target : String, k : Int) : (State, List(String)) do
    let candidates = List.filter(alive_others(s), fn id -> id != target)
    let n = List.length(candidates)
    let take = if k < n do k else n end
    let drawn = Random.sample(s.rng, candidates, take)
    let chosen = match drawn do (c, _) -> c end
    let rng2 = match drawn do (_, r) -> r end
    let out = ({ s with rng: rng2 }, chosen)
    out
  end

  -- ── event processing ──────────────────────────────────────────────────────

  pfn apply_event(swim : Swim.State, now : Int, ev : Event) : (Swim.State, List(Swim.Action)) do
    match ev do
      PingAck(node_id) ->
        (Swim.on_ack(swim, node_id), Nil)
      GossipFrame(member) ->
        (Swim.on_gossip(swim, member), Nil)
      GossipWithLoad(member, _nl) ->
        -- Apply membership update; load table update is handled by apply_load_events.
        (Swim.on_gossip(swim, member), Nil)
      PeerDown(node_id) ->
        -- Definitive failure: skip Suspect, go straight to Dead at current incarnation
        -- so the verdict supersedes any prior Alive/Suspect for the same incarnation.
        let current_inc = match Membership.get(swim.members, node_id) do
          Some(m) -> m.incarnation
          None    -> 0
        end
        let dead_m = Membership.verdict(swim.members, node_id, Dead, current_inc)
        let swim2 = Swim.on_gossip(swim, dead_m)
        let out = (swim2, Cons(Gossip(dead_m), Nil))
        out
      ConnLost(node_id) -> Swim.suspect_member(swim, now, node_id)
    end
  end

  -- Fold load samples from events into the peer_loads map, restamped with
  -- [now]: a stored load's `sampled_at` is when THIS node received it. The
  -- sender's stamp is on the sender's clock, and staleness is `now -
  -- sampled_at` on ours, so a peer whose clock ran ahead sent reports that
  -- never went stale and one behind sent reports stale on arrival
  -- (test/two_node/skew).
  pfn apply_load_events(peer_loads : Map(String, NodeLoad), evs : List(Event), now : Int) : Map(String, NodeLoad) do
    List.fold_left(evs, peer_loads, fn (acc, ev) ->
      match ev do
        GossipWithLoad(_member, nl) ->
          let received = { node_id: nl.node_id, cpu_count: nl.cpu_count, cpu_load_milli: nl.cpu_load_milli,
                           mem_total_mb: nl.mem_total_mb, mem_avail_mb: nl.mem_avail_mb, sampled_at: now }
          Map.insert(acc, nl.node_id, received, Map.str_cmp)
        _ -> acc
      end)
  end

  pfn apply_events(swim : Swim.State, now : Int, evs : List(Event)) : (Swim.State, List(Swim.Action)) do
    List.fold_left(evs, (swim, Nil), fn (acc, ev) ->
      match acc do
        (sw, acts) ->
          match apply_event(sw, now, ev) do
            (sw2, new_acts) -> (sw2, List.append(acts, new_acts))
          end
      end)
  end

  -- ── main step ─────────────────────────────────────────────────────────────

  doc """
  Advance the driver one tick at [now] (Unix ms), folding in the transport
  [events] received since the last call. Returns the updated state and the
  actions to execute, in order: the actions the events produced (a `PeerDown`
  gossips a Dead verdict, a `ConnLost` gossips a Suspect), then:

  - at a period boundary (`now >= period_end`): end the previous probe (may
    suspect its target), expire overdue suspects to Dead, refute if we are
    suspected, then ping a randomly chosen Alive peer (no ping when there is
    none) and roll the period timer to `now + period_ms`;
  - mid-period: escalate the probe to indirect ping-reqs through up to
    `indirect_k` randomly sampled helpers once the ack timeout has passed.

  `GossipWithLoad` samples are stored in the peer-load table restamped with
  [now]. Deterministic for a given seed and event sequence.

  ## Examples

      let d = SwimDriver.make("n1", 0, view, Swim.config(500, 5000, 3), 1000, 42)
      match SwimDriver.step(d, now, Nil) do      -- first call begins a period
        (d2, acts) -> SwimDriver.dispatch_all(acts, peers, "n1")
      end
  """
  fn step(s : State, now : Int, events : List(Event)) : (State, List(Swim.Action)) do
    -- 1. Fold in transport events.
    let ev_out = apply_events(s.swim, now, events)
    let swim1 = match ev_out do (sw, _) -> sw end
    let ev_acts = match ev_out do (_, a) -> a end

    -- 1b. Update peer load table from any GossipWithLoad events.
    let new_peer_loads = apply_load_events(s.peer_loads, events, now)

    -- 2. Period boundary?
    if now >= s.period_end do
      -- End the outgoing probe period (may Suspect the target).
      let ep_out = Swim.end_period(swim1, now)
      let swim2 = match ep_out do (sw, _) -> sw end
      let end_acts = match ep_out do (_, a) -> a end

      -- Promote expired Suspects to Dead.
      let ex_out = Swim.expire_suspects(swim2, now)
      let swim3 = match ex_out do (sw, _) -> sw end
      let exp_acts = match ex_out do (_, a) -> a end

      -- Refute if we ourselves are suspected or dead.
      let rf_out = Swim.refute(swim3)
      let swim4 = match rf_out do (sw, _) -> sw end
      let rf_act = match rf_out do
        (_, opt) ->
          match opt do
            None    -> Nil
            Some(a) -> Cons(a, Nil)
          end
      end

      -- Begin a new probe period: pick a random alive peer.
      let tgt_out = pick_target({ s with swim: swim4 })
      let s_with_rng = match tgt_out do (st, _) -> st end
      let tgt_opt = match tgt_out do (_, t) -> t end

      match tgt_opt do
        None ->
          -- No alive peers to probe; just roll the period timer.
          let s2 = { s_with_rng with swim: swim4, period_end: now + s.period_ms,
                                     peer_loads: new_peer_loads }
          let all_acts = List.append(ev_acts,
                           List.append(end_acts,
                             List.append(exp_acts, rf_act)))
          let out = (s2, all_acts)
          out
        Some(target) ->
          let bp_out = Swim.begin_period(swim4, now, target)
          let swim5 = match bp_out do (sw, _) -> sw end
          let bp_act = match bp_out do (_, a) -> Cons(a, Nil) end
          let s2 = { s_with_rng with swim: swim5, period_end: now + s.period_ms,
                                     peer_loads: new_peer_loads }
          let all_acts = List.append(ev_acts,
                           List.append(end_acts,
                             List.append(exp_acts,
                               List.append(rf_act, bp_act))))
          let out = (s2, all_acts)
          out
      end

    else
      -- Mid-period: escalate to indirect if the direct ping is overdue.
      let k = s.swim.config.indirect_k
      let cur_target = match s.swim.probe do
        None    -> ""
        Some(p) -> p.target
      end
      let h_out = pick_helpers({ s with swim: swim1 }, cur_target, k)
      let s_rng2 = match h_out do (st, _) -> st end
      let helpers = match h_out do (_, h) -> h end
      let esc_out = Swim.escalate_indirect(swim1, now, helpers)
      let swim2 = match esc_out do (sw, _) -> sw end
      let esc_acts = match esc_out do (_, a) -> a end
      let s2 = { s_rng2 with swim: swim2, peer_loads: new_peer_loads }
      let all_acts = List.append(ev_acts, esc_acts)
      let out = (s2, all_acts)
      out
    end
  end

  -- ── Anti-entropy helpers (P5a) ─────────────────────────────────────────────

  doc """
  The Alive peers other than ourselves (the anti-entropy targets) when the
  anti-entropy timer has fired at [now], else `Nil`. The transport calls this
  each tick and sends a registry sync request to each returned peer, then
  calls `bump_anti_entropy`.
  """
  fn anti_entropy_peers(s : State, now : Int) : List(String) do
    if now >= s.anti_entropy_next do
      alive_others(s)
    else
      Nil
    end
  end

  doc "Re-arm the anti-entropy timer for 30 s after [now]; call it right after `anti_entropy_peers` returned a non-empty list."
  fn bump_anti_entropy(s : State, now : Int) : State do
    { s with anti_entropy_next: now + anti_entropy_period_ms() }
  end

  -- ── Load queries (P4) ─────────────────────────────────────────────────────

  doc "The last load sample heard from [node_id], or `None` if none was heard or it is more than 10 s old at [now] (receipt time on this node's clock)."
  fn peer_load(s : State, node_id : String, now : Int) : Option(NodeLoad) do
    match Map.get(s.peer_loads, node_id, Map.str_cmp) do
      None -> None
      Some(nl) ->
        if now - nl.sampled_at <= load_stale_ms() do Some(nl) else None end
    end
  end

  doc "Every peer load sample received at most 10 s before [now], in unspecified order."
  fn fresh_peer_loads(s : State, now : Int) : List(NodeLoad) do
    let all = Map.values(s.peer_loads)
    List.filter(all, fn nl -> now - nl.sampled_at <= load_stale_ms())
  end

  -- ── wire codec ────────────────────────────────────────────────────────────

  pfn status_to_int(s : MemberStatus) : Int do
    match s do
      Alive   -> 0
      Suspect -> 1
      Dead    -> 2
    end
  end

  pfn int_to_status(n : Int) : Result(MemberStatus, String) do
    match n do
      0 -> Ok(Alive)
      1 -> Ok(Suspect)
      2 -> Ok(Dead)
      _ -> Err("swim_driver: bad status int " ++ String.from_int(n))
    end
  end

  doc """
  Encode a wire message as a MessagePack array whose first element is its tag
  (0 ping, 1 ack, 2 ping-req, 3 gossip; `SwimGossipLoad` is tag 3 with a fifth
  element holding the `ClusterLoad.to_ints` of its load).
  """
  fn encode_msg(msg : WireMsg) : List(Int) do
    match msg do
      SwimPing(sender) ->
        Msgpack.encode(
          Msgpack.array(Cons(Msgpack.int(0), Cons(Msgpack.str(sender), Nil))))
      SwimPingAck(sender) ->
        Msgpack.encode(
          Msgpack.array(Cons(Msgpack.int(1), Cons(Msgpack.str(sender), Nil))))
      SwimPingReq(requester, target) ->
        Msgpack.encode(
          Msgpack.array(Cons(Msgpack.int(2),
            Cons(Msgpack.str(requester),
            Cons(Msgpack.str(target), Nil)))))
      SwimGossip(node_id, status, incarnation) ->
        Msgpack.encode(
          Msgpack.array(Cons(Msgpack.int(3),
            Cons(Msgpack.str(node_id),
            Cons(Msgpack.int(status_to_int(status)),
            Cons(Msgpack.int(incarnation), Nil))))))
      SwimGossipLoad(node_id, status, incarnation, nl) ->
        let load_vals = List.map(ClusterLoad.to_ints(nl), fn i -> Msgpack.int(i))
        Msgpack.encode(
          Msgpack.array(Cons(Msgpack.int(3),
            Cons(Msgpack.str(node_id),
            Cons(Msgpack.int(status_to_int(status)),
            Cons(Msgpack.int(incarnation),
            Cons(Msgpack.array(load_vals), Nil)))))))
    end
  end

  doc """
  Decode bytes produced by `encode_msg`. Returns `Err` for invalid
  MessagePack, a non-array, an unknown tag, the wrong element count or types
  for a tag, or a status int outside 0..2. In a tag-3 load frame, non-integer
  load elements are silently dropped before `ClusterLoad.from_ints`.
  """
  fn decode_msg(bytes : List(Int)) : Result(WireMsg, String) do
    match Msgpack.decode(bytes) do
      Err(e) -> Err(e)
      Ok(v) ->
        match v do
          Msgpack.Array(Cons(Msgpack.Int(tag), rest)) ->
            match tag do
              0 ->
                match rest do
                  Cons(Msgpack.Str(sender), Nil) -> Ok(SwimPing(sender))
                  _ -> Err("swim_driver: bad SwimPing frame")
                end
              1 ->
                match rest do
                  Cons(Msgpack.Str(sender), Nil) -> Ok(SwimPingAck(sender))
                  _ -> Err("swim_driver: bad SwimPingAck frame")
                end
              2 ->
                match rest do
                  Cons(Msgpack.Str(req), Cons(Msgpack.Str(tgt), Nil)) ->
                    Ok(SwimPingReq(req, tgt))
                  _ -> Err("swim_driver: bad SwimPingReq frame")
                end
              3 ->
                match rest do
                  Cons(Msgpack.Str(nid),
                    Cons(Msgpack.Int(st),
                    Cons(Msgpack.Int(inc),
                    Cons(Msgpack.Array(load_vals), Nil)))) ->
                      match int_to_status(st) do
                        Err(e) -> Err(e)
                        Ok(status) ->
                          let ints = List.filter_map(load_vals, fn v ->
                            match v do Msgpack.Int(i) -> Some(i) | _ -> None end)
                          Ok(SwimGossipLoad(nid, status, inc, ClusterLoad.from_ints(nid, ints)))
                      end
                  Cons(Msgpack.Str(nid),
                    Cons(Msgpack.Int(st),
                    Cons(Msgpack.Int(inc), Nil))) ->
                      match int_to_status(st) do
                        Ok(status) -> Ok(SwimGossip(nid, status, inc))
                        Err(e)     -> Err(e)
                      end
                  _ -> Err("swim_driver: bad SwimGossip frame")
                end
              _ -> Err("swim_driver: unknown tag " ++ String.from_int(tag))
            end
          _ -> Err("swim_driver: expected Msgpack array")
        end
    end
  end

  -- ── full-member frames (the cluster node service) ────────────────────────
  -- Tag 3 is already overloaded by element count, so a member with its
  -- origin fields travels under its own tags:
  --   13 MEMBER_GOSSIP  [13, node_id, name, addr, creation, status_int, incarnation]
  --   14 MEMBERS_SYNC   [14, [[node_id, name, addr, creation, status_int, incarnation], ...]]
  -- MEMBERS_SYNC is the whole view, exchanged both ways on every new
  -- connection: SWIM's push-pull join, and the heal path.

  doc "The wire tag of a full-member MEMBER_GOSSIP frame (13)."
  fn tag_member_gossip() : Int do 13 end
  doc "The wire tag of a MEMBERS_SYNC frame carrying a whole member view (14)."
  fn tag_members_sync() : Int do 14 end

  pfn member_fields(m : Member) do
    Cons(Msgpack.str(m.node_id),
    Cons(Msgpack.str(m.name),
    Cons(Msgpack.str(m.addr),
    Cons(Msgpack.int(m.creation),
    Cons(Msgpack.int(status_to_int(m.status)),
    Cons(Msgpack.int(m.incarnation), Nil))))))
  end

  pfn member_of_fields(fields) : Result(Member, String) do
    match fields do
      Cons(Msgpack.Str(nid), Cons(Msgpack.Str(name), Cons(Msgpack.Str(addr),
        Cons(Msgpack.Int(cr), Cons(Msgpack.Int(st), Cons(Msgpack.Int(inc), Nil)))))) ->
          match int_to_status(st) do
            Err(e) -> Err(e)
            Ok(status) -> Ok(Membership.member(nid, name, addr, cr, status, inc))
          end
      _ -> Err("swim_driver: bad member record")
    end
  end

  doc """
  Encode one member with its origin fields as a MEMBER_GOSSIP frame:
  `[13, node_id, name, addr, creation, status_int, incarnation]`.
  """
  fn encode_member_gossip(m : Member) : List(Int) do
    Msgpack.encode(Msgpack.array(Cons(Msgpack.int(tag_member_gossip()), member_fields(m))))
  end

  doc """
  Decode a MEMBER_GOSSIP frame. Returns `Err` for invalid MessagePack, a frame
  with another tag, a malformed member record, or a bad status int.
  """
  fn decode_member_gossip(bytes : List(Int)) : Result(Member, String) do
    match Msgpack.decode(bytes) do
      Err(e) -> Err(e)
      Ok(Msgpack.Array(Cons(Msgpack.Int(13), fields))) -> member_of_fields(fields)
      Ok(_) -> Err("swim_driver: not a MEMBER_GOSSIP frame")
    end
  end

  doc """
  Encode a whole member view as a MEMBERS_SYNC frame:
  `[14, [[node_id, name, addr, creation, status_int, incarnation], ...]]`.
  Exchanged both ways on every new connection (push-pull join and heal).
  """
  fn encode_members_sync(ms : List(Member)) : List(Int) do
    let recs = List.map(ms, fn m -> Msgpack.array(member_fields(m)))
    Msgpack.encode(Msgpack.array(Cons(Msgpack.int(tag_members_sync()), Cons(Msgpack.array(recs), Nil))))
  end

  doc """
  Decode a MEMBERS_SYNC frame into its members, in frame order. A malformed
  record is skipped, not fatal, so the rest of the view still merges. Returns
  `Err` only for invalid MessagePack or a frame that is not
  `[14, [records...]]`.
  """
  fn decode_members_sync(bytes : List(Int)) : Result(List(Member), String) do
    match Msgpack.decode(bytes) do
      Err(e) -> Err(e)
      Ok(Msgpack.Array(Cons(Msgpack.Int(14), Cons(Msgpack.Array(recs), Nil)))) ->
        Ok(List.filter_map(recs, fn r ->
          match r do
            Msgpack.Array(fields) ->
              match member_of_fields(fields) do
                Ok(m) -> Some(m)
                Err(_) -> None
              end
            _ -> None
          end))
      Ok(_) -> Err("swim_driver: not a MEMBERS_SYNC frame")
    end
  end

  doc """
  The frames one `Swim.Action` turns into, as (destination node_id, payload)
  pairs, for a transport that writes through its own per-peer writers instead
  of `dispatch`'s direct fd writes. A ping or ping-req yields one pair; a
  `Gossip` yields one full-member MEMBER_GOSSIP frame per id in [peer_ids] (no
  pairs when [peer_ids] is empty).
  """
  fn action_frames(action : Swim.Action, my_id : String, peer_ids : List(String)) : List((String, List(Int))) do
    match action do
      SendPing(target) -> Cons((target, encode_msg(SwimPing(my_id))), Nil)
      SendPingReq(helper, target) -> Cons((helper, encode_msg(SwimPingReq(my_id, target))), Nil)
      Gossip(m) ->
        let bytes = encode_member_gossip(m)
        List.map(peer_ids, fn id -> (id, bytes))
    end
  end

  doc """
  The driver `Event` for a decoded wire message: an ack becomes `PingAck`, a
  tag-3 gossip becomes `GossipFrame`/`GossipWithLoad` with an origin-less
  member (creation 0, name = node id, addr ""). Returns `None` for
  `SwimPing` and `SwimPingReq`, which the transport answers directly.
  """
  fn msg_to_event(msg : WireMsg) : Option(Event) do
    match msg do
      SwimPingAck(sender)            -> Some(PingAck(sender))
      SwimGossip(node_id, status, incarnation) ->
        Some(GossipFrame(Membership.member(node_id, node_id, "", 0, status, incarnation)))
      SwimGossipLoad(node_id, status, incarnation, nl) ->
        Some(GossipWithLoad(Membership.member(node_id, node_id, "", 0, status, incarnation), nl))
      _ -> None
    end
  end

  -- ── transport dispatch (requires I/O; not eval-testable) ─────────────────

  pfn send_to_peer(peers : PeerRegistry.Registry, node_id : String, bytes : List(Int)) : () do
    match PeerRegistry.lookup(peers, node_id) do
      None -> ()
      Some(peer) ->
        match NetKernel.send_frame(peer.fd, bytes) do
          Ok(_) -> ()
          Err(_) -> ()
        end
    end
  end

  doc """
  Execute one `Swim.Action` by writing the wire frame straight to the peer's
  fd from [peers]: a ping or ping-req to its one destination, a `Gossip` to
  every registered peer as a legacy tag-3 frame (status and incarnation only;
  the member's name, addr and creation are not sent). Destinations missing
  from [peers] and send errors are silently ignored.
  """
  fn dispatch(action : Swim.Action, peers : PeerRegistry.Registry, my_id : String) : () do
    match action do
      SendPing(target_id) ->
        send_to_peer(peers, target_id, encode_msg(SwimPing(my_id)))
      SendPingReq(helper_id, target_id) ->
        send_to_peer(peers, helper_id, encode_msg(SwimPingReq(my_id, target_id)))
      Gossip(member) ->
        let ps = PeerRegistry.peers(peers)
        let encoded = encode_msg(SwimGossip(member.node_id, member.status, member.incarnation))
        List.fold_left(ps, (), fn (_, p) ->
          send_to_peer(peers, p.node_id, encoded))
    end
  end

  doc "Execute each action in order with `dispatch`."
  fn dispatch_all(actions : List(Swim.Action), peers : PeerRegistry.Registry, my_id : String) : () do
    List.fold_left(actions, (), fn (_, action) ->
      dispatch(action, peers, my_id))
  end

  doc "Like `dispatch`, but a `Gossip` is sent as a tag-3 load frame that piggybacks [my_load]."
  fn dispatch_with_load(action : Swim.Action, peers : PeerRegistry.Registry,
                        my_id : String, my_load : NodeLoad) : () do
    match action do
      Gossip(member) ->
        let ps = PeerRegistry.peers(peers)
        let encoded = encode_msg(SwimGossipLoad(member.node_id, member.status,
                                                member.incarnation, my_load))
        List.fold_left(ps, (), fn (_, p) ->
          send_to_peer(peers, p.node_id, encoded))
      _ -> dispatch(action, peers, my_id)
    end
  end

  doc "Execute each action in order with `dispatch_with_load`."
  fn dispatch_all_with_load(actions : List(Swim.Action), peers : PeerRegistry.Registry,
                             my_id : String, my_load : NodeLoad) : () do
    List.fold_left(actions, (), fn (_, action) ->
      dispatch_with_load(action, peers, my_id, my_load))
  end

end
