-- Membership: SWIM-style cluster membership with a CRDT member view (P1 L3).
--
-- Each node is tracked as { status, incarnation }. A node refutes a false
-- suspicion/death by incrementing its own incarnation and re-announcing Alive,
-- so the merge rule is: higher incarnation wins; at the same incarnation the
-- more-severe status wins (Dead > Suspect > Alive). That order makes `merge`
-- a lexicographic max over (incarnation, severity) — associative, commutative,
-- and idempotent — so gossiped member views converge regardless of order
-- (the anti-entropy CRDT join for the small member set; no Merkle needed).
--
-- This is the pure membership state + merge + transitions; the SWIM probe loop
-- (direct/indirect ping, suspicion timers) drives it from the runtime layer.
--
-- Origin fields (the cluster node service,
-- specs/progress/2026-09-18-cluster-node-service.md): a member also carries its
-- human `name`, its advertised listen address `addr` ("host:port", "" when
-- unknown) and its `creation` (bumped each time the node process restarts).
-- The merge order is lexicographic over (creation, incarnation, severity): a
-- restarted node outranks every verdict about its previous life, whatever
-- that verdict's incarnation, and name/addr travel with the winning
-- observation. Still a max, so still a join. The two-argument constructors
-- (`alive(id, inc)` ...) build creation 0 / name = id / addr "" -- the shape
-- every pre-service caller and the legacy tag-3 gossip frame produce.
mod Membership do

  type MemberStatus = Alive | Suspect | Dead
  derive Eq for MemberStatus

  type Member = { node_id : String, status : MemberStatus, incarnation : Int,
                  creation : Int, name : String, addr : String }
  derive Eq for Member

  type Members = Members(Map(String, Member))

  pfn severity(s : MemberStatus) : Int do
    match s do
      Alive   -> 0
      Suspect -> 1
      Dead    -> 2
    end
  end

  doc """
  An `Alive` observation of [node_id] at [incarnation], origin-less: creation 0, name = [node_id], addr "".
  """
  fn alive(node_id : String, incarnation : Int) : Member do
    { node_id: node_id, status: Alive, incarnation: incarnation, creation: 0, name: node_id, addr: "" }
  end
  doc """
  A `Suspect` observation of [node_id] at [incarnation], origin-less: creation 0, name = [node_id], addr "".
  """
  fn suspect(node_id : String, incarnation : Int) : Member do
    { node_id: node_id, status: Suspect, incarnation: incarnation, creation: 0, name: node_id, addr: "" }
  end
  doc """
  A `Dead` observation of [node_id] at [incarnation], origin-less: creation 0, name = [node_id], addr "".
  """
  fn dead(node_id : String, incarnation : Int) : Member do
    { node_id: node_id, status: Dead, incarnation: incarnation, creation: 0, name: node_id, addr: "" }
  end

  doc """
  A member observation with every field given: [name] is the human node name,
  [addr] its advertised "host:port" ("" when unknown), [creation] its restart
  counter.
  """
  fn member(node_id : String, name : String, addr : String, creation : Int,
            status : MemberStatus, incarnation : Int) : Member do
    { node_id: node_id, status: status, incarnation: incarnation, creation: creation, name: name, addr: addr }
  end

  doc """
  [m] with a new [status] and [incarnation], keeping its node_id, name, addr
  and creation.
  """
  fn with_status(m : Member, status : MemberStatus, incarnation : Int) : Member do
    member(m.node_id, m.name, m.addr, m.creation, status, incarnation)
  end

  doc """
  A verdict about [node_id] at [incarnation], carrying the origin fields
  (name, addr, creation) this view already holds for it, so a Suspect/Dead
  about creation 5 is about creation 5 rather than a creation-0 observation
  the known member outranks. An unknown node gets the origin-less shape
  (creation 0, name = [node_id], addr ""). The view is not modified; pass the
  result to `observe` to record it.
  """
  fn verdict(ms : Members, node_id : String, status : MemberStatus, incarnation : Int) : Member do
    match get(ms, node_id) do
      Some(m) -> with_status(m, status, incarnation)
      None -> member(node_id, node_id, "", 0, status, incarnation)
    end
  end

  doc "An empty member view."
  fn empty() : Members do Members(Map.empty()) end
  doc "The number of distinct node ids in the view (members of every status, Dead included)."
  fn size(ms : Members) : Int do match ms do Members(m) -> Map.size(m) end end
  doc "The current winning observation for [node_id], or `None` if the view has never seen it."
  fn get(ms : Members, node_id : String) : Option(Member) do
    match ms do Members(m) -> Map.get(m, node_id, Map.str_cmp) end
  end
  doc """
  Every member in the view, of every status (Dead and Suspect included), in
  unspecified (hash) order.
  """
  fn members(ms : Members) : List(Member) do
    match ms do Members(m) -> Map.values(m) end
  end

  -- Does observation [b] win over [a] for the same node? Lexicographic max
  -- over (creation, incarnation, severity): a later creation wins outright;
  -- then higher incarnation; ties broken by the more-severe status
  -- (Dead > Suspect > Alive). >= on a tie keeps the merge idempotent
  -- (b == a still "wins", harmlessly).
  pfn supersedes(b : Member, a : Member) : Bool do
    if b.creation != a.creation do
      b.creation > a.creation
    else
      if b.incarnation == a.incarnation do
        severity(b.status) >= severity(a.status)
      else
        b.incarnation > a.incarnation
      end
    end
  end

  doc """
  Fold one observation into the view, keeping the winner for its node id.
  The winner is the lexicographic max over (creation, incarnation, severity)
  with Dead > Suspect > Alive; on a full tie [obs] replaces the stored entry
  (so its name/addr win). An unknown node id is simply added.

  ## Examples

      let v = Membership.observe(Membership.empty(), Membership.alive("n1", 1))
      let v = Membership.observe(v, Membership.suspect("n1", 1))   -- same inc: Suspect wins
      let v = Membership.observe(v, Membership.alive("n1", 0))     -- older inc: ignored
      -- Membership.get(v, "n1") is Some(suspect("n1", 1))
  """
  fn observe(ms : Members, obs : Member) : Members do
    match ms do
      Members(m) ->
        let winner = match Map.get(m, obs.node_id, Map.str_cmp) do
          None -> obs
          Some(existing) -> if supersedes(obs, existing) do obs else existing end
        end
        Members(Map.insert(m, obs.node_id, winner, Map.str_cmp))
    end
  end

  doc """
  CRDT join of two member views: every member of [b] is observed into [a].
  The result keeps, per node id, the winner under the `observe` order, so
  merging is associative and idempotent and, up to the name/addr of exact
  ties, commutative.
  """
  fn merge(a : Members, b : Members) : Members do
    match b do
      Members(mb) -> Map.fold(mb, a, fn (acc, _k, member) -> observe(acc, member))
    end
  end

  doc "The members whose status is `Alive`, in unspecified (hash) order."
  fn alive_members(ms : Members) : List(Member) do
    List.filter(members(ms), fn m ->
      match m.status do
        Alive -> true
        _     -> false
      end)
  end

end
