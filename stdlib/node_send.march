-- NodeSend: an actor message to a process on another node (distributed actors 1/4).
--
-- Everything cross-node used to be a CALL (NodeCall, synchronous, typed by a
-- RemoteRef) or a MONITOR frame. This is the missing primitive: a one-way
-- message to a GlobalPid, the way `send(pid, msg)` is one-way locally.
--
-- Wire (msgpack payload behind the NetFrame length prefix; tag byte first,
-- the P5 convention in NetKernel):
--   0x09 ACTOR_MSG        [tag=9,  seq:Int, to_local_pid:Int, to_creation:Int,
--                          type_tag:Str, payload:Bin, schema:Str?]
--   0x0A DELIVERY_FAILED  [tag=10, seq:Int, reason:Str]
--
-- `seq` is the sender's correlation number, echoed by DELIVERY_FAILED so the
-- sender can tell which message a failure is about. `to_creation` is the
-- receiving node's creation counter as the sender last knew it: a node that
-- restarted reuses local pids, and a message carrying the old creation must
-- be refused rather than delivered to whatever now owns that pid.
-- `type_tag` names the message type (fully qualified), so a receiver can
-- refuse a type it does not host without decoding the payload. `schema`
-- (optional, distributed-deploys build step 9) is the message type's schema
-- hash, a digest of its structure that the typed send puts in: a receiver
-- that knows its own can tell a same-named type of another shape. It is sent
-- only by a typed send; a frame without it decodes with `schema: ""`. A node
-- built before the field existed refuses a seven-element frame.
--
-- The receiving side is INJECTED, like NodeRpc's Targets: `serve_one` decodes
-- the frame, checks the creation, and hands a `Delivery` to the caller's
-- dispatch function, which knows which local actor hosts which type and
-- which constructor to wrap the payload in (a constructor is minted by the
-- actor that declares it; a library cannot name it). Any failure -- stale
-- creation, a rejected type, a dead pid, an undecodable payload -- goes back
-- to the sender as DELIVERY_FAILED. A remote send is not fire-and-forget.
--
-- Payload codec: the sender encodes its message with the type's derived
-- codec (`derive Json` today, as `@[endpoints]` does) into bytes; this layer
-- carries bytes. Design record: specs/progress/2026-09-14-remote-send-to-a-global-pid.md.
--
-- Type annotations use bare names where a qualified path would not unify
-- (the NodeCall convention).
mod NodeSend do
  needs IO.Mut

  doc "The frame tag of an ACTOR_MSG: 9."
  fn tag_actor_msg() : Int do 9 end
  doc "The frame tag of a DELIVERY_FAILED: 10."
  fn tag_delivery_failed() : Int do 10 end

  type SendError = NoConnection | Refused(Int, String)

  -- `from_node` is the node id of the connection the frame arrived on,
  -- filled in by the receiver (ClusterNode's data reader, or its own id for
  -- the loopback), never read off the wire: "" from `decode_msg`. An access
  -- point checks the sender's certificate by it (step 11b), so it must be
  -- the link's verified peer, not anything the sender claims.
  type Delivery = {
    seq : Int,
    to_local_pid : Int,
    to_creation : Int,
    type_tag : String,
    payload : List(Int),
    schema : String,
    from_node : String
  }

  -- ── session traffic (distributed-deploys step 11b) ─────────────────────
  -- In certificate mode a raw ACTOR_MSG (Node.send, @[remote], any user
  -- type) crosses a connection only when both nodes' certificates carry
  -- `raw_send` (NetKernel.raw_allowed; ClusterNode for its own links).
  -- Session traffic is exempt: these type tags, before any "#<sid>" suffix.

  doc """
  The ACTOR_MSG type tags that are session traffic (SessionAP's and
  SessionNode's frames), which cross a connection even when certificate
  mode refuses raw sends: "SessionAP.Invite", "SessionAP.Withdraw",
  "SessionAP.Answer" and the seven "SessionNode.*" tags (Hello, Deliver,
  Bye, Cancel, Ping, Undelivered, Drained).
  """
  fn session_tags() : List(String) do
    ["SessionAP.Invite", "SessionAP.Withdraw", "SessionAP.Answer",
     "SessionNode.Hello", "SessionNode.Deliver", "SessionNode.Bye", "SessionNode.Cancel",
     "SessionNode.Ping", "SessionNode.Undelivered", "SessionNode.Drained"]
  end

  doc """
  Is [type_tag] session traffic? True when the tag, with anything from its
  first "#" on removed (a "#<sid>" suffix), is one of `session_tags()`.

      NodeSend.is_session_tag("SessionNode.Deliver#42")   -- true
      NodeSend.is_session_tag("Chat.Msg")                 -- false
  """
  fn is_session_tag(type_tag : String) : Bool do
    let kind = match String.split_first(type_tag, "#") do
      Some((k, _)) -> k
      None -> type_tag
    end
    List.member(session_tags(), kind)
  end

  -- ── frames ──────────────────────────────────────────────────────────────

  doc """
  An ACTOR_MSG frame payload (MessagePack, not yet length-framed) for
  message [seq] to [to], with [type_tag] and [payload]: the six-element
  frame every node reads (no schema).
  """
  fn encode_msg(seq : Int, to : Pid, type_tag : String, payload : List(Int)) : List(Int) do
    encode_msg_schema(seq, to, type_tag, "", payload)
  end

  doc """
  An ACTOR_MSG carrying the message type's schema hash [schema] as a
  seventh element. With [schema] `""` it is exactly `encode_msg`: the
  six-element frame every node reads.
  """
  fn encode_msg_schema(seq : Int, to : Pid, type_tag : String, schema : String, payload : List(Int)) : List(Int) do
    let tail = if schema == "" do Nil else Cons(Msgpack.str(schema), Nil) end
    Msgpack.encode(Msgpack.array(
      Cons(Msgpack.int(tag_actor_msg()),
      Cons(Msgpack.int(seq),
      Cons(Msgpack.int(to.local_pid),
      Cons(Msgpack.int(to.creation),
      Cons(Msgpack.str(type_tag),
      Cons(Msgpack.bin(payload), tail))))))))
  end

  doc """
  Decode an ACTOR_MSG frame payload (six or seven elements) into a
  `Delivery`: `schema` is "" for a six-element frame, and `from_node` is
  always "" (the receiver fills it in from the connection, never from the
  wire). `Err` for bytes that are not MessagePack or not an ACTOR_MSG.
  """
  fn decode_msg(bytes : List(Int)) : Result(Delivery, String) do
    match Msgpack.decode(bytes) do
      Err(e) -> Err(e)
      Ok(v) ->
        match v do
          Msgpack.Array(Cons(Msgpack.Int(9),
                        Cons(Msgpack.Int(seq),
                        Cons(Msgpack.Int(lp),
                        Cons(Msgpack.Int(cr),
                        Cons(Msgpack.Str(tt),
                        Cons(Msgpack.Bin(pl), Nil))))))) ->
            Ok({ seq: seq, to_local_pid: lp, to_creation: cr, type_tag: tt, payload: pl, schema: "", from_node: "" })
          Msgpack.Array(Cons(Msgpack.Int(9),
                        Cons(Msgpack.Int(seq),
                        Cons(Msgpack.Int(lp),
                        Cons(Msgpack.Int(cr),
                        Cons(Msgpack.Str(tt),
                        Cons(Msgpack.Bin(pl), Cons(Msgpack.Str(sh), Nil)))))))) ->
            Ok({ seq: seq, to_local_pid: lp, to_creation: cr, type_tag: tt, payload: pl, schema: sh, from_node: "" })
          _ -> Err("node_send: not an ACTOR_MSG frame")
        end
    end
  end

  doc "A DELIVERY_FAILED frame payload (MessagePack, not yet length-framed) for message [seq], carrying [reason]."
  fn encode_failed(seq : Int, reason : String) : List(Int) do
    Msgpack.encode(Msgpack.array(
      Cons(Msgpack.int(tag_delivery_failed()),
      Cons(Msgpack.int(seq),
      Cons(Msgpack.str(reason), Nil)))))
  end

  doc "Decode a DELIVERY_FAILED frame payload into (seq, reason). `Err` for bytes that are not MessagePack or not a DELIVERY_FAILED."
  fn decode_failed(bytes : List(Int)) : Result((Int, String), String) do
    match Msgpack.decode(bytes) do
      Err(e) -> Err(e)
      Ok(v) ->
        match v do
          Msgpack.Array(Cons(Msgpack.Int(10),
                        Cons(Msgpack.Int(seq),
                        Cons(Msgpack.Str(reason), Nil)))) -> Ok((seq, reason))
          _ -> Err("node_send: not a DELIVERY_FAILED frame")
        end
    end
  end

  -- ── sender ──────────────────────────────────────────────────────────────

  doc """
  Write one ACTOR_MSG for message [seq] to [to] on [fd] (`cast`: `send` is
  the local actor primitive's reserved name). Returns `Ok(())` once the
  frame is written; a delivery failure arrives later as a DELIVERY_FAILED
  frame (see `recv_failure`, `on_failure`), not here. A failed write is
  `Err(NoConnection)`.

  On a certificate-mode connection where raw sends are refused
  (`NetKernel.raw_allowed`), anything but session traffic is
  `Err(Refused(seq, "not authorized: ..."))`, counted, never written.

      NodeSend.cast(fd, 1, to, "Chat.Msg", Bytes.to_list(Bytes.from_string("{}")))
  """
  fn cast(fd : Int, seq : Int, to : Pid, type_tag : String, payload : List(Int)) : Result((), SendError) do
    cast_schema(fd, seq, to, type_tag, "", payload)
  end

  doc """
  `cast` with the message type's schema hash [schema] in the frame
  (`encode_msg_schema`; `""` for none). The raw-send check (step 11b) is
  here, so both spellings get it.
  """
  fn cast_schema(fd : Int, seq : Int, to : Pid, type_tag : String, schema : String, payload : List(Int)) : Result((), SendError) do
    if is_session_tag(type_tag) == false && NetKernel.raw_allowed(fd) == false do
      NetKernel.note_raw_refused(fd)
      Err(Refused(seq, "not authorized: raw send of " ++ type_tag ++ " (certificate mode: both nodes' certificates need raw_send)"))
    else
    match NetKernel.send_frame(fd, encode_msg_schema(seq, to, type_tag, schema, payload)) do
      Err(_) -> Err(NoConnection)
      Ok(_) ->
        -- A remote send never reaches march_sched_send, so count it on the
        -- sender here (its msgs_out: Recon, forge top). Every typed and raw
        -- remote send comes through this function.
        observe_count_send(())
        Ok(())
    end end
  end

  doc """
  Read frames off [fd] (starting from already-buffered bytes [buf]) until
  one is a DELIVERY_FAILED, and return its (seq, reason). Other frames are
  skipped and lost (they belong to another consumer of this connection).
  Blocks; `Err` on a read failure.
  """
  @[diverges] fn recv_failure(fd : Int, buf : List(Int)) : Result((Int, String), String) do
    match NetKernel.recv_frame(fd, buf) do
      Err(e) -> Err(e)
      Ok(fr) ->
        let frame_bytes = match fr do (f, _) -> f end
        let rest = match fr do (_, r) -> r end
        match decode_failed(frame_bytes) do
          Ok(f) -> Ok(f)
          Err(_) -> recv_failure(fd, rest)
        end
    end
  end

  -- ── failures as messages ────────────────────────────────────────────────
  -- A remote send is made by an ACTOR, and its failure should reach that
  -- actor's mailbox -- the way a monitor's Down does -- not a synchronous
  -- read in main (`recv_failure`, kept for the simple cases). `cast_from`
  -- records the sender under the seq before writing; `on_failure` decodes a
  -- DELIVERY_FAILED frame from the per-peer reader, finds the sender,
  -- forgets the seq, and hands (sender, seq, reason) to the caller's
  -- dispatch, which mints the actor's own constructor (a library cannot
  -- name it). One table per node process; the seq space is the caller's.

  pfn pending() do
    match Vault.whereis("node_send_pending") do
      Some(t) -> t
      None -> Vault.new("node_send_pending")
    end
  end

  doc """
  `cast`, first recording [from] (the sending actor) under [seq] in this
  process's pending table, so a later DELIVERY_FAILED for [seq] reaches it
  through `on_failure`. The record is kept even when the cast fails, and a
  message that is delivered keeps its entry (only a failure removes it).
  """
  fn cast_from(fd : Int, seq : Int, from, to : Pid, type_tag : String, payload : List(Int)) : Result((), SendError) do
    Vault.set(pending(), int_to_string(seq), from)
    cast(fd, seq, to, type_tag, payload)
  end

  doc """
  Handle a DELIVERY_FAILED [frame] from the per-peer reader: find the sender
  `cast_from` recorded under its seq, forget the entry, and call
  [deliver](sender, seq, reason), which turns it into the actor's own
  message. `Err` for a frame that is not a DELIVERY_FAILED, or a seq with no
  recorded sender (nothing is delivered).

      NodeSend.on_failure(frame, fn (p, seq, reason) -> send(p, SendFailed(seq, reason)))
  """
  fn on_failure(frame : List(Int), deliver) : Result((), String) do
    match decode_failed(frame) do
      Err(e) -> Err(e)
      Ok((seq, reason)) ->
        let t = pending()
        let key = int_to_string(seq)
        match Vault.get(t, key) do
          None -> Err("node_send: no sender recorded for seq " ++ key)
          Some(p) ->
            Vault.drop(t, key)
            deliver(p, seq, reason)
            Ok(())
        end
    end
  end

  -- ── receiver ────────────────────────────────────────────────────────────

  doc """
  Read one frame from [fd] and handle it (`handle_frame`, replying on the
  same [fd]). An ACTOR_MSG whose creation matches [my_creation] is handed to
  [dispatch]; a stale creation, a refused raw send, or a dispatch that
  returns `Err` is answered with a DELIVERY_FAILED carrying the reason. A
  frame that is not an ACTOR_MSG is ignored, with no reply. Returns `Err`
  only on I/O failure.

      NodeSend.serve_one(fd, my_creation, fn d ->
        if Node.tag_is(d, "Chat.Msg") do Ok(()) else Err("no host for " ++ d.type_tag) end)
  """
  fn serve_one(fd : Int, my_creation : Int, dispatch : Delivery -> Result((), String)) : Result((), String) do
    serve_one_reply(fd, fd, my_creation, dispatch)
  end

  doc """
  As `serve_one`, but DELIVERY_FAILED goes on [reply_fd]: with the
  control/data split the message arrives on the data connection [fd] and
  the failure travels back on the control one. The raw-send check is made
  against [reply_fd].
  """
  fn serve_one_reply(fd : Int, reply_fd : Int, my_creation : Int, dispatch : Delivery -> Result((), String)) : Result((), String) do
    match NetKernel.recv_frame(fd, Nil) do
      Err(e) -> Err(e)
      Ok(fr) ->
        let frame_bytes = match fr do (f, _) -> f end
        handle_frame(frame_bytes, reply_fd, my_creation, dispatch)
    end
  end

  doc """
  The frame-level half of `serve_one_reply`, for a reader that already has
  the frame in hand (a `PeerReader` dispatching by tag: ACTOR_MSG here,
  MONITOR_REQ to the registry, ...). A frame that is not an ACTOR_MSG is
  ignored (`Ok`). Otherwise, in order: a raw (non-session) message on a
  [reply_fd] that refuses raw sends is refused and counted; a creation other
  than [my_creation] is stale; else [dispatch] decides. A refusal, stale
  creation or dispatch `Err` is answered on [reply_fd] with DELIVERY_FAILED.
  `Err` only when writing that reply fails.
  """
  fn handle_frame(frame : List(Int), reply_fd : Int, my_creation : Int, dispatch : Delivery -> Result((), String)) : Result((), String) do
    match decode_msg(frame) do
      Err(_) -> Ok(())
      Ok(d) ->
        let outcome =
          -- Raw frames from a peer whose connection refuses them (step
          -- 11b): dropped, counted, and answered DELIVERY_FAILED.
          if is_session_tag(d.type_tag) == false && NetKernel.raw_allowed(reply_fd) == false do
            NetKernel.note_raw_refused(reply_fd)
            Err("not authorized: raw send of " ++ d.type_tag ++ " refused (certificate mode: both nodes' certificates need raw_send)")
          else if d.to_creation != my_creation do
            Err("stale creation " ++ int_to_string(d.to_creation) ++ ", node is at " ++ int_to_string(my_creation))
          else
            dispatch(d)
          end end
        match outcome do
          Ok(_) -> Ok(())
          Err(reason) ->
            match NetKernel.send_frame(reply_fd, encode_failed(d.seq, reason)) do
              Err(e) -> Err(e)
              Ok(_) -> Ok(())
            end
        end
    end
  end

end
