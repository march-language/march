-- DistLink: cross-node process monitors and bidirectional links (P5c).
--
-- Monitor protocol (two-step):
--   1. Local: call monitor(target_pid, timeout_ms) → sends MONITOR_REQ to
--      the node that hosts target_pid, returns Ok(MonitorRef).
--   2. Remote node: receives MONITOR_REQ, calls march_dist_monitor_register
--      in its C runtime.  On actor exit it sends MONITOR_FIRE back.
--   3. Local net-kernel loop: receives MONITOR_FIRE, delivers
--      Down(ref, pid, reason) to the watcher's mailbox.
--
-- Node-down: when the peer connection drops (PeerDown from SwimDriver), the
-- DistLink actor sweeps its pending_monitors table and fires Down(NodeDown)
-- locally to all watchers of targets on that node.
--
-- Links build on monitors: both sides call monitor on each other.  A Down
-- message triggers EXIT propagation in the linked process (unless trapping).
--
-- Down reason:
--   Normal | Killed | Crash(String) | NodeDown
--
-- MonitorRef is an opaque integer; demonitor(ref) cancels the monitor.
mod DistLink do
  needs IO.NetConnect   -- resend_pending writes MONITOR_FIRE frames

  type DownReason = Normal | Killed | Crash(String) | NodeDown

  -- Opaque monitor reference returned by monitor/2.
  type MonitorRef = MonitorRef(Int)

  -- Internal: one entry in the pending monitor table.
  type PendingMonitor = {
    ref         : MonitorRef,
    target_node : String,
    target_pid  : Int,
    watcher_pid : GlobalPid.Pid
  }

  doc """
  Convert a wire reason tag to a `DownReason`: 0 `Normal`, 1 `Killed`, 2
  `Crash(msg)`, and any other tag (3, or anything unexpected, negative
  included) `NodeDown`. [msg] is ignored except for tag 2.
  """
  fn reason_of_tag(tag : Int, msg : String) : DownReason do
    match tag do
      0 -> Normal
      1 -> Killed
      2 -> Crash(msg)
      _ -> NodeDown
    end
  end

  doc """
  Convert a `DownReason` to its wire (tag, message) pair; the message is "" except for `Crash(msg)`.
  """
  fn tag_of_reason(r : DownReason) : (Int, String) do
    match r do
      Normal       -> (0, "")
      Killed       -> (1, "")
      Crash(msg)   -> (2, msg)
      NodeDown     -> (3, "")
    end
  end

  -- ── Wire encode/decode helpers ────────────────────────────────────────────

  doc "Encode a MONITOR_REQ frame (tag 7) asking the target's node to watch [target_pid] on behalf of [watcher_pid] at [watcher_node]."
  fn encode_req(watcher_node : String, watcher_pid : Int, target_pid : Int) : List(Int) do
    NetKernel.encode_monitor_req(watcher_node, watcher_pid, target_pid)
  end

  doc """
  Encode a MONITOR_FIRE frame (tag 8) reporting that [target_pid] exited with
  [reason]; `resend_pending` uses it to re-send unacked fires.
  """
  fn encode_fire(target_pid : Int, reason : DownReason) : List(Int) do
    let tag_msg = tag_of_reason(reason)
    let tag = match tag_msg do (t, _) -> t end
    let msg = match tag_msg do (_, m) -> m end
    NetKernel.encode_monitor_fire(target_pid, tag, msg)
  end

  doc """
  Decode an inbound MONITOR_FIRE frame into (target_pid, reason). Returns
  `Err` for invalid MessagePack or a frame that is not
  `[8, target_pid, reason_tag, reason_msg]`; an unknown reason tag decodes as
  `NodeDown`.
  """
  fn decode_fire(bytes : List(Int)) : Result((Int, DownReason), String) do
    match NetKernel.decode_monitor_fire(bytes) do
      Err(e) -> Err(e)
      Ok(r) ->
        match r do
          (tp, rt, rm) -> Ok((tp, reason_of_tag(rt, rm)))
        end
    end
  end

  doc "The wire tag of a MONITOR_ACK frame (12): the watcher's node has delivered the Down, so the firing node forgets the pending fire."
  fn tag_ack() : Int do 12 end

  doc "Encode a MONITOR_ACK frame `[12, target_pid, watcher_pid]`."
  fn encode_ack(target_pid : Int, watcher_pid : Int) : List(Int) do
    Msgpack.encode(Msgpack.array(
      Cons(Msgpack.int(tag_ack()), Cons(Msgpack.int(target_pid), Cons(Msgpack.int(watcher_pid), Nil)))))
  end

  doc """
  Decode a MONITOR_ACK frame into (target_pid, watcher_pid). Returns `Err` for
  invalid MessagePack or any frame that is not exactly
  `[12, target_pid, watcher_pid]`.
  """
  fn decode_ack(bytes : List(Int)) : Result((Int, Int), String) do
    match Msgpack.decode(bytes) do
      Err(e) -> Err(e)
      Ok(Msgpack.Array(Cons(Msgpack.Int(12), Cons(Msgpack.Int(tp), Cons(Msgpack.Int(wp), Nil))))) -> Ok((tp, wp))
      Ok(_) -> Err("DistLink: not a MONITOR_ACK frame")
    end
  end

  doc """
  At-least-once delivery: resend every fired-but-unacked MONITOR_FIRE (from
  the runtime's pending-fire table) to the watcher node's CURRENT control
  connection, looked up in [reg], since the fd the fire was first written on
  may be gone. Returns how many frames were written; entries whose node is
  not in [reg], or whose write fails, wait for the next call. Entries stay
  pending until a MONITOR_ACK arrives. Call from a timer or after a
  reconnect.
  """
  fn resend_pending(reg : PeerRegistry.Registry) : Int do
    List.fold_left(dist_monitor_pending(), 0, fn (n, entry) ->
      match entry do
        (target_pid, (watcher_node, (_watcher_pid, (rtag, rmsg)))) ->
          match PeerRegistry.lookup(reg, watcher_node) do
            None -> n
            Some(peer) ->
              match NetKernel.send_frame(peer.fd, encode_fire(target_pid, reason_of_tag(rtag, rmsg))) do
                Ok(_) -> n + 1
                Err(_) -> n
              end
          end
      end)
  end

  doc """
  Decode an inbound MONITOR_REQ frame into (watcher_node, watcher_pid,
  target_pid). Returns `Err` for invalid MessagePack or a frame that is not
  `[7, watcher_node, watcher_pid, target_pid]`.
  """
  fn decode_req(bytes : List(Int)) : Result((String, Int, Int), String) do
    NetKernel.decode_monitor_req(bytes)
  end

  -- ── Pending monitor table ─────────────────────────────────────────────────
  -- Used by the transport layer to track outgoing monitors and fire
  -- Down(NodeDown) locally when a peer disconnects.

  type MonitorTable = MonitorTable(Map(Int, PendingMonitor))

  doc "An empty pending-monitor table."
  fn empty_table() : MonitorTable do MonitorTable(Map.empty()) end

  pfn ref_key(ref : MonitorRef) : Int do
    match ref do MonitorRef(n) -> n end
  end

  doc "Add [m] to the table keyed by its monitor ref, replacing any entry with the same ref."
  fn insert_monitor(tbl : MonitorTable, m : PendingMonitor) : MonitorTable do
    match tbl do
      MonitorTable(mp) ->
        MonitorTable(Map.insert(mp, ref_key(m.ref), m, Map.int_cmp))
    end
  end

  doc "Remove the entry for [ref]; the table is unchanged if it has none."
  fn remove_monitor(tbl : MonitorTable, ref : MonitorRef) : MonitorTable do
    match tbl do
      MonitorTable(mp) ->
        MonitorTable(Map.remove(mp, ref_key(ref), Map.int_cmp))
    end
  end

  doc """
  The first monitor whose `target_pid` is [target_pid], or `None`. O(n) scan.
  When several monitors (several watchers, or the same pid number on
  different nodes) match, which one is returned is unspecified: the target
  node is not compared.
  """
  fn find_by_target_pid(tbl : MonitorTable, target_pid : Int) : Option(PendingMonitor) do
    match tbl do
      MonitorTable(mp) ->
        let matches = List.filter_map(Map.entries(mp), fn pair ->
          match pair do
            (_, m) -> if m.target_pid == target_pid do Some(m) else None end
          end)
        List.head_opt(matches)
    end
  end

  doc "Every monitor whose target lives on [node_id], in unspecified order; used for the NodeDown sweep when that peer disconnects. O(n)."
  fn monitors_on_node(tbl : MonitorTable, node_id : String) : List(PendingMonitor) do
    match tbl do
      MonitorTable(mp) ->
        List.filter_map(Map.entries(mp), fn pair ->
          match pair do
            (_, m) -> if m.target_node == node_id do Some(m) else None end
          end)
    end
  end

  doc "Construct a `PendingMonitor`. Keeps record construction inside the module so callers avoid the bare-vs-qualified type name mismatch."
  fn make_monitor(ref : MonitorRef, target_node : String, target_pid : Int,
                  watcher_pid : GlobalPid.Pid) : PendingMonitor do
    { ref: ref, target_node: target_node, target_pid: target_pid,
      watcher_pid: watcher_pid }
  end

  -- ── Eq instances ─────────────────────────────────────────────────────────

  impl Eq(MonitorRef) do
    fn eq(a, b) do
      match (a, b) do
        (MonitorRef(x), MonitorRef(y)) -> x == y
      end
    end
  end

  impl Eq(DownReason) do
    fn eq(a, b) do
      match (a, b) do
        (Normal,    Normal)    -> true
        (Killed,    Killed)    -> true
        (NodeDown,  NodeDown)  -> true
        (Crash(x),  Crash(y))  -> x == y
        _                      -> false
      end
    end
  end

  -- ── Down message helpers ──────────────────────────────────────────────────

  doc """
  The `(ref, target_pid, reason)` Down tuple a watcher should receive for
  monitor [m]. Delivering it to the watcher's mailbox is the runtime glue's
  job.
  """
  fn down_msg(m : PendingMonitor, reason : DownReason) : (MonitorRef, Int, DownReason) do
    (m.ref, m.target_pid, reason)
  end

end
