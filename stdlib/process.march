-- Process module: OS process interaction.
--
-- run/2 runs a command and waits for it to finish, returning the exit code
-- and captured stdout.  run_stream/2 returns a Seq(String) of output lines
-- for pipeline-style processing without buffering the whole output.
--
-- The command is looked up in PATH.  A command that cannot be executed (not
-- found, not executable) is an Err from the spawning call itself
-- ("cannot execute <cmd>: <reason>"), never an Ok with exit code 127.  The
-- child inherits the current working directory and environment (including
-- set_env), starts with no signals blocked and every signal at its default
-- action.
--
-- env/1 and set_env/2 read and write OS environment variables.
-- cwd/0, argv/0, pid/0 expose the current process context.
-- exit/1 terminates the VM with the given exit code.
--
-- Every one of those, and every spawn, is a capability operation (IO.Process;
-- the target is the variable or the program) and returns
-- `Result(T, CapError)`: `Err` when the current authority refuses it
-- (specs/2026-11-10-object-capability-design.md §15). A spawn that already
-- returned a `Result` returns it inside: `Ok(Err(msg))` is a program that
-- could not start, `Err(CapError(...))` one that was not permitted.
--
-- spawn_async returns a `Process`: an opaque, reference-counted handle, not
-- a pid (ocap phase 2, spec §6). Reading, writing, killing and waiting on a
-- `Process` you hold need no authority: the spawn was checked. wait_proc
-- reaps the child and closes the handle; every later use is `Err(Closed)`.
-- A `Process` dropped without wait_proc is reaped when its last reference
-- goes: its pipes are closed and a child still running is sent SIGTERM, so
-- it does not linger as a zombie.

mod Process do

  -- Result of a completed subprocess.
  -- ProcessResult(exit_code, stdout, stderr)
  type ProcessResult = ProcessResult(Int, String, String)

  -- What a Process handle's operations can fail with. `Closed`: the handle
  -- was already waited on (wait_proc closes it). `ProcessFailed(msg)`: the
  -- command could not be started ("cannot execute <cmd>: <reason>").
  ptype ProcessError = Closed | ProcessFailed(String)
  derive Eq for ProcessError

  -- The raw builtins' view of a live child: LiveProcess(pid, stream_slot).
  -- Stdlib-internal: user code holds a `Process` handle (kind PROCESS, raw =
  -- stream slot, aux = pid) and never sees one of these.
  opaque type LiveProcess = LiveProcess(Int, Int)

  -- ---- Subprocess execution ----

  doc """
  Run command with args, wait for it to finish. Returns Ok(ProcessResult)
  with the exit code and captured stdout/stderr, or Err(msg) when the
  command could not be started: "cannot execute <cmd>: <reason>" for a
  missing or non-executable program. A program that runs and fails is still
  Ok, with its non-zero exit code.

      match Process.run("git", ["status"]) do
        Ok(Ok(r))    -> println(Process.stdout(r))
        Ok(Err(msg)) -> println(msg)   -- e.g. "cannot execute git: No such file or directory"
        Err(e)       -> println(Authority.describe(e))
      end
  """
  fn run(command : String, args : List(String)) : Result(Result(ProcessResult, String), CapError) do
    let? _ = Authority.check("IO.Process", command)
    Ok(process_spawn_sync(command, args))
  end

  doc "Run command and return its stdout as a Seq(String) of lines. Returns Ok(Seq), or Err(msg) when the command cannot be executed (as for run). The command runs to completion and its stdout is read in full before the Seq is returned; the Seq is not a live stream of the running process."
  fn run_stream(command : String, args : List(String)) do
    let? _ = Authority.check("IO.Process", command)
    match process_spawn_lines(command, args) do
      Ok(out) -> Ok(Ok(Seq.from_string_lines(out)))
      Err(e) -> Ok(Err(e))
    end
  end

  -- ---- Environment ----

  doc "Get the value of an environment variable: Ok(Some(value)), Ok(None) when it is not set, or Err(CapError(...)) when reading it is refused, which is never mistaken for unset."
  fn env(name : String) : Result(Option(String), CapError) do
    let? _ = Authority.check("IO.Process", name)
    Ok(process_env(name))
  end

  doc "Set an environment variable."
  fn set_env(name : String, value : String) : Result((), CapError) do
    let? _ = Authority.check("IO.Process", name)
    process_set_env(name, value)
    Ok(())
  end

  -- ---- Current process ----

  doc "Returns the current working directory."
  fn cwd() : Result(String, CapError) do
    let? _ = Authority.check("IO.Process", "")
    Ok(process_cwd())
  end

  doc "Terminate the process with the given exit code. Returns only when that is refused: Err(CapError(...))."
  fn exit(code : Int) : Result((), CapError) do
    let? _ = Authority.check("IO.Process", "")
    process_exit(code)
    Ok(())
  end

  doc "Returns the command-line arguments as List(String) (argv[0] is the executable)."
  fn argv() : Result(List(String), CapError) do
    let? _ = Authority.check("IO.Process", "")
    Ok(process_argv())
  end

  doc "Returns the OS-level PID of the current process."
  fn pid() : Result(Int, CapError) do
    let? _ = Authority.check("IO.Process", "")
    Ok(process_pid())
  end

  -- ---- Async subprocess management ----

  doc """
  Spawn a command asynchronously (non-blocking).
  Returns Ok(Ok(p)) immediately, `p` a `Process` handle: the child process
  starts running in the background. Use read_line to consume its stdout,
  write to feed its stdin, kill to terminate it, and wait_proc to reap its
  exit code. Ok(Err(ProcessFailed(msg))) when the command cannot be
  executed ("cannot execute <cmd>: <reason>"); Err(CapError(...)) when the
  current authority refuses the spawn (IO.Process on the command).

      match Authority.must(Process.spawn_async("cat", [])) do
        Ok(p) ->
          let _ = Process.write(p, "hi\n")
          let line = Process.read_line(p)   -- Ok(Some("hi"))
          let _ = Process.kill(p)
          Process.wait_proc(p)              -- Ok(exit code)
        Err(e) -> Err(e)
      end
  """
  fn spawn_async(command : String, args : List(String)) : Result(Result(Process, ProcessError), CapError) do
    let? _ = Authority.check("IO.Process", command)
    match process_spawn_async(command, args) do
      Err(msg) -> Ok(Err(ProcessFailed(msg)))
      Ok(lp) ->
        match lp do
          LiveProcess(pid, slot) ->
            let p : Process = handle_new(9, slot, pid)
            Ok(Ok(p))
        end
    end
  end

  -- Every use of a Process goes through here, as File.with_raw does for a
  -- File.Handle: enter the box (refused once it is closed), rebuild the raw
  -- LiveProcess(pid, slot) the builtins take, run the operation, then leave.
  pfn with_live(p : Process, f : LiveProcess -> Result(b, ProcessError)) : Result(b, ProcessError) do
    let slot = handle_enter(p, 9)
    if slot == -1 do Err(Closed) else
      let r = f(LiveProcess(handle_aux(p), slot))
      handle_leave(p)
      r
    end
  end

  doc """
  Read one line from the process's stdout, without its newline.
  Returns Ok(Some(line)) for each output line, Ok(None) once the process
  has closed its stdout (typically on exit), or Err(Closed) after
  wait_proc. Blocks until a full line is available.
  """
  fn read_line(p : Process) : Result(Option(String), ProcessError) do
    with_live(p, fn lp -> Ok(process_read_line(lp)))
  end

  doc """
  Write raw bytes to the process's stdin. Returns Ok(()), or Err(Closed)
  after wait_proc. The data is flushed immediately so the child process
  sees it without delay. Include a trailing newline if the child reads
  line-by-line.
  """
  fn write(p : Process, data : String) : Result((), ProcessError) do
    with_live(p, fn lp ->
      process_write(lp, data)
      Ok(()))
  end

  doc "Send SIGTERM to the process. Returns Ok(()), or Err(Closed) after wait_proc (a reaped child's pid may already belong to another process)."
  fn kill(p : Process) : Result((), ProcessError) do
    with_live(p, fn lp ->
      process_kill_proc(lp)
      Ok(()))
  end

  doc """
  Wait for the process to exit and return its exit code: Ok(code), or
  Err(Closed) when it was already waited on. Closes the process's streams
  and then the handle, so every later use of `p` is Err(Closed). Call it
  after the process exits (read_line returned Ok(None)) or after kill.
  """
  fn wait_proc(p : Process) : Result(Int, ProcessError) do
    let r = with_live(p, fn lp -> Ok(process_wait_proc(lp)))
    let _ = handle_close(p)
    r
  end

  -- ---- ProcessResult helpers ----

  doc "Extract the exit code from a ProcessResult."
  fn exit_code(r) do
    match r do
    ProcessResult(code, _, _) -> code
    end
  end

  doc "Extract captured stdout from a ProcessResult."
  fn stdout(r) do
    match r do
    ProcessResult(_, out, _) -> out
    end
  end

  doc "Extract captured stderr from a ProcessResult."
  fn stderr(r) do
    match r do
    ProcessResult(_, _, err) -> err
    end
  end

  doc "True if the command exited with code 0."
  fn ok(r) do
    match r do
    ProcessResult(code, _, _) -> code == 0
    end
  end

end
