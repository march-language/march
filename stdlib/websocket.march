-- WebSocket module: types and API for WebSocket connections.
--
-- WebSocket connections are upgraded from HTTP via WebSocket.upgrade(conn, handler).
-- The handler is a function WsSocket -> Unit that uses tail recursion and
-- pattern matching on received frames.

mod WebSocket do

  needs IO.WebSocket

  type WsFrame = TextFrame(String) | BinaryFrame(String) | Ping | Pong | Close(Int, String)

  type WsSocket = WsSocket(Int)

  type SelectResult = WsData(WsFrame) | ActorMsg | Timeout

  -- Conn, Header and Upgrade are NOT re-declared here: March has a single
  -- global type namespace, so `upgrade` below resolves them to the ONE
  -- declaration each — Http.Header, HttpServer.Upgrade, HttpServer.Conn.
  --
  -- They used to be duplicated here "to mirror Http/HttpServer (no imports in
  -- March)".  That silently stopped working when same-short-name types in
  -- different modules started getting globally-unique constructor tags
  -- (lib/tir/collision_set.ml): HttpServer.Conn's tag moved off 0, so the C
  -- runtime's march_conn_from_parsed (which writes tag 0) built a value that
  -- matched no arm — every compiled HTTP request panicked with
  -- "non-exhaustive pattern match" — and a WebSocket.Conn returned from
  -- `upgrade` was a different type from the HttpServer.Conn going in.

  doc """
  Mark an `HttpServer.Conn` for upgrade to a WebSocket. Returns the conn
  with status 101, response headers and body cleared, halted, and
  `WebSocketUpgrade(handler)` set; after the pipeline returns, the server
  runtime performs the handshake and calls `handler(socket)`.

  This function does not itself check the request's `Upgrade` /
  `Sec-WebSocket-Key` headers, nor whether the conn was already halted
  (an earlier response is overwritten); do that in the plug first.

  ## Examples

      fn ws_plug(conn) do
        if HttpServer.path(conn) == "/ws" do
          WebSocket.upgrade(conn, echo_loop)
        else
          conn
        end
      end
  """
  fn upgrade(conn, handler) do
    match conn do
    Conn(fd, m, p, pi, qs, rh, rb, _, _, _, _, assigns, _) ->
      Conn(fd, m, p, pi, qs, rh, rb, 101, Nil, "", true, assigns,
           WebSocketUpgrade(handler))
    end
  end

  doc """
  Receive the next frame, parking the calling task until one arrives.
  Returns `TextFrame(s)`, `BinaryFrame(s)`, `Ping`, `Pong` or
  `Close(code, reason)`. A read error or peer disconnect yields
  `Close(1001, "going away")`; a frame over 16 MiB likewise; an unknown
  opcode (including continuation frames of a fragmented message) yields
  `Close(1002, "unknown opcode")`. Pings are not answered automatically.

  ## Examples

      fn echo_loop(socket) do
        match WebSocket.recv(socket) do
          TextFrame(s) ->
            WebSocket.send_frame(socket, TextFrame(s))
            echo_loop(socket)
          Ping ->
            WebSocket.send_frame(socket, Pong)
            echo_loop(socket)
          Close(_, _) -> ()
          _ -> echo_loop(socket)
        end
      end
  """
  fn recv(socket) do
    match socket do
    WsSocket(fd) -> ws_recv(fd)
    end
  end

  doc """
  Send one frame (server to client, unmasked) on the socket. Returns `()`.

  ## Examples

      WebSocket.send_frame(socket, TextFrame("hello"))
  """
  fn send_frame(socket, frame) do
    match socket do
    WsSocket(fd) -> ws_send(fd, frame)
    end
  end

  doc """
  Send a `Close(code, reason)` frame (e.g. 1000 for a normal closure). The
  handler should then return; the runtime closes the TCP connection.

  ## Examples

      WebSocket.close(socket, 1000, "bye")
  """
  fn close(socket, code, reason) do
    send_frame(socket, Close(code, reason))
  end

  doc """
  Wait up to `timeout_ms` milliseconds for a frame. Returns `WsData(frame)`
  (the frame as `recv` would give it) or `Timeout`; a `timeout_ms` of 0 or
  less waits indefinitely. A wait error is reported as `Timeout`.

  `ActorMsg` is part of the result type, but this function passes no actor
  notification pipe to the runtime, so it is never returned here.

  ## Examples

      match WebSocket.select(socket, 30000) do
        WsData(TextFrame(s)) -> handle(s)
        WsData(_) -> ()
        _ -> WebSocket.send_frame(socket, Ping)
      end
  """
  fn select(socket, timeout_ms) do
    match socket do
    WsSocket(fd) -> ws_select(fd, 0, timeout_ms)
    end
  end

end
