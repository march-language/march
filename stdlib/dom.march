-- Dom — browser DOM bindings for March compiled with --target js.
--
-- Provides typed wrappers over the browser's Document Object Model.
-- Requires --target js; calling these functions from a native build panics.
--
-- Usage:
--   match Dom.find("counter") do
--     None    -> ()
--     Some(el) ->
--       Dom.set_text(el, "0")
--       Dom.on(el, "click", fn _ -> Dom.set_text(el, "clicked!"))
--   end
--
-- Note: set_timeout/set_interval/on_frame callbacks take one ignored Int
-- argument (`fn _ -> ...`), not a true zero-arg lambda (`fn -> ...`). A
-- zero-arg March lambda types to its body's result directly with no arrow
-- wrapper, so it can never satisfy a declared `Unit -> Unit` parameter.

mod Dom do
  needs Ffi

  -- Opaque handle to a DOM Element.
  resource Node

  -- Opaque handle to a browser Event.
  resource Event

  extern "dom" : Cap(Ffi) do
    -- ── Query ──────────────────────────────────────────────────────────
    fn dom_get_element_by_id(id: String)        : Option(Node) = "march_dom_get_element_by_id"
    fn dom_query_selector(sel: String)          : Option(Node) = "march_dom_query_selector"
    fn dom_query_selector_all(sel: String)      : List(Node)   = "march_dom_query_selector_all"

    -- ── Document ───────────────────────────────────────────────────────
    fn dom_body()                               : Node         = "march_dom_body"
    fn dom_document_element()                   : Node         = "march_dom_document_element"

    -- ── Construction ───────────────────────────────────────────────────
    fn dom_create_element(tag: String)          : Node         = "march_dom_create_element"
    fn dom_create_text_node(text: String)       : Node         = "march_dom_create_text_node"
    fn dom_clone(el: Node)                      : Node         = "march_dom_clone"

    -- ── Tree manipulation ──────────────────────────────────────────────
    fn dom_append_child(parent: Node, child: Node)   : Unit = "march_dom_append_child"
    fn dom_prepend_child(parent: Node, child: Node)  : Unit = "march_dom_prepend_child"
    fn dom_remove_child(parent: Node, child: Node)   : Unit = "march_dom_remove_child"
    fn dom_replace_child(parent: Node, new_child: Node, old_child: Node) : Unit = "march_dom_replace_child"
    fn dom_remove(el: Node)                          : Unit = "march_dom_remove"
    fn dom_parent(el: Node)                          : Option(Node) = "march_dom_parent"
    fn dom_children(el: Node)                        : List(Node)   = "march_dom_children"
    fn dom_first_child(el: Node)                     : Option(Node) = "march_dom_first_child"
    fn dom_last_child(el: Node)                      : Option(Node) = "march_dom_last_child"
    fn dom_clear_children(el: Node)                  : Unit = "march_dom_clear_children"

    -- ── Content ────────────────────────────────────────────────────────
    fn dom_get_text(el: Node)                   : String = "march_dom_get_text"
    fn dom_set_text(el: Node, text: String)     : Unit   = "march_dom_set_text"
    fn dom_get_html(el: Node)                   : String = "march_dom_get_html"
    fn dom_set_html(el: Node, html: String)     : Unit   = "march_dom_set_html"

    -- ── Attributes ─────────────────────────────────────────────────────
    fn dom_get_attribute(el: Node, name: String)            : Option(String) = "march_dom_get_attribute"
    fn dom_set_attribute(el: Node, name: String, val: String) : Unit         = "march_dom_set_attribute"
    fn dom_remove_attribute(el: Node, name: String)         : Unit           = "march_dom_remove_attribute"
    fn dom_has_attribute(el: Node, name: String)            : Bool           = "march_dom_has_attribute"

    -- ── CSS classes ────────────────────────────────────────────────────
    fn dom_class_add(el: Node, cls: String)     : Unit = "march_dom_class_add"
    fn dom_class_remove(el: Node, cls: String)  : Unit = "march_dom_class_remove"
    fn dom_class_toggle(el: Node, cls: String)  : Unit = "march_dom_class_toggle"
    fn dom_class_contains(el: Node, cls: String): Bool = "march_dom_class_contains"

    -- ── Inline style ───────────────────────────────────────────────────
    fn dom_set_style(el: Node, prop: String, val: String)   : Unit   = "march_dom_set_style"
    fn dom_get_style(el: Node, prop: String)                : String = "march_dom_get_style"

    -- ── Form values ────────────────────────────────────────────────────
    fn dom_get_value(el: Node)                  : String = "march_dom_get_value"
    fn dom_set_value(el: Node, val: String)     : Unit   = "march_dom_set_value"

    -- ── Events ─────────────────────────────────────────────────────────
    fn dom_add_event_listener(el: Node, event: String, handler: Event -> Unit) : Unit = "march_dom_add_event_listener"
    fn dom_remove_event_listener(el: Node, event: String, handler: Event -> Unit) : Unit = "march_dom_remove_event_listener"

    -- ── Event properties ───────────────────────────────────────────────
    fn dom_event_target(ev: Event)              : Node   = "march_dom_event_target"
    fn dom_event_type(ev: Event)                : String = "march_dom_event_type"
    fn dom_event_key(ev: Event)                 : String = "march_dom_event_key"
    fn dom_prevent_default(ev: Event)           : Unit   = "march_dom_prevent_default"
    fn dom_stop_propagation(ev: Event)          : Unit   = "march_dom_stop_propagation"
    fn dom_event_x(ev: Event)                   : Int    = "march_dom_event_x"
    fn dom_event_y(ev: Event)                   : Int    = "march_dom_event_y"
    fn dom_taps(el: Node)                       : List((Int, Int)) = "march_dom_taps"
    fn dom_key_presses()                        : List(String) = "march_dom_key_presses"
    fn dom_store_get(key: String)               : Option(String) = "march_dom_store_get"
    fn dom_store_set(key: String, val: String)  : Unit = "march_dom_store_set"

    -- ── Window ─────────────────────────────────────────────────────────
    fn dom_alert(msg: String)                   : Unit   = "march_dom_alert"
    fn dom_href()                               : String = "march_dom_href"
    fn dom_set_href(url: String)                : Unit   = "march_dom_set_href"
    -- cb takes a dummy Int arg (ignored) rather than Unit: a zero-arg March
    -- lambda (`fn -> body`) types to its body's result directly (no arrow
    -- wrapper — see T-Abs in specs/lang/core-march-types.md), so it can never
    -- unify with a declared `Unit -> Unit` parameter. Same idiom as
    -- `task_spawn`'s thunk param; pass `fn _ -> body` and ignore the arg.
    fn dom_set_timeout(ms: Int, cb: Int -> Unit) : Unit = "march_dom_set_timeout"
    fn dom_set_interval(ms: Int, cb: Int -> Unit) : Unit = "march_dom_set_interval"
    fn dom_request_animation_frame(cb: Int -> Unit) : Unit = "march_dom_request_animation_frame"
  end

  -- ── Public API ─────────────────────────────────────────────────────────

  doc "Look up an element by its `id` attribute. Returns `None` if no element with that id exists."
  fn find(id)                          do dom_get_element_by_id(id) end

  doc "Find the first element matching a CSS selector string (e.g. \".my-class\", \"h1\", \"[data-foo]\"). Returns `None` if nothing matches."
  fn select(selector)                  do dom_query_selector(selector) end

  doc "Find all elements matching a CSS selector. Returns a `List(Node)`, empty when nothing matches."
  fn select_all(selector)              do dom_query_selector_all(selector) end

  doc "The document `<body>` element."
  fn body()                            do dom_body() end

  doc "Create a new element with the given HTML tag name (e.g. \"div\", \"span\", \"button\"). The element is detached until appended to the tree."
  fn create(tag)                       do dom_create_element(tag) end

  doc "Create a text node containing the given string. Use `append` to attach it to an element."
  fn text_node(text)                   do dom_create_text_node(text) end

  doc "Append `child` as the last child of `parent`. If `child` is already in the tree it is moved."
  fn append(parent, child)             do dom_append_child(parent, child) end

  doc "Insert `child` before all existing children of `parent`. If `child` is already in the tree it is moved."
  fn prepend(parent, child)            do dom_prepend_child(parent, child) end

  doc "Remove `child` from `parent`. Panics if `child` is not a direct child of `parent`; prefer `remove` when the parent is unknown."
  fn remove_child(parent, child)       do dom_remove_child(parent, child) end

  doc "Detach `el` from its parent and remove it from the DOM. No-op if `el` has no parent."
  fn remove(el)                        do dom_remove(el) end

  doc "Return the direct parent element of `el`, or `None` if `el` is the root or detached."
  fn parent(el)                        do dom_parent(el) end

  doc "Return a `List(Node)` of the direct element children of `el` (text nodes excluded)."
  fn children(el)                      do dom_children(el) end

  doc "Remove all child nodes from `el`, leaving it empty."
  fn clear(el)                         do dom_clear_children(el) end

  doc "Return the `textContent` of `el` (all descendant text, concatenated)."
  fn get_text(el)                      do dom_get_text(el) end

  doc "Set the `textContent` of `el`. Replaces all children with a single text node; HTML is not interpreted."
  fn set_text(el, text)                do dom_set_text(el, text) end

  doc "Return the `innerHTML` of `el` as a string."
  fn get_html(el)                      do dom_get_html(el) end

  doc "Set the `innerHTML` of `el`. The string is parsed as HTML; use `set_text` when the content is plain text."
  fn set_html(el, html)                do dom_set_html(el, html) end

  doc "Return the value of the named attribute, or `None` if the attribute is absent."
  fn get_attr(el, name)                do dom_get_attribute(el, name) end

  doc "Set the value of the named attribute on `el` (e.g. `set_attr(el, \"href\", \"#top\")`)."
  fn set_attr(el, name, val)           do dom_set_attribute(el, name, val) end

  doc "Remove the named attribute from `el`. No-op if the attribute is absent."
  fn remove_attr(el, name)             do dom_remove_attribute(el, name) end

  doc "Return `true` if `el` has the named attribute, `false` otherwise."
  fn has_attr(el, name)                do dom_has_attribute(el, name) end

  doc "Add CSS class `cls` to `el`'s classList. No-op if already present."
  fn add_class(el, cls)                do dom_class_add(el, cls) end

  doc "Remove CSS class `cls` from `el`'s classList. No-op if absent."
  fn remove_class(el, cls)             do dom_class_remove(el, cls) end

  doc "Toggle CSS class `cls` on `el`: add it if absent, remove it if present."
  fn toggle_class(el, cls)             do dom_class_toggle(el, cls) end

  doc "Return `true` if `el`'s classList contains `cls`."
  fn has_class(el, cls)                do dom_class_contains(el, cls) end

  doc "Set an inline CSS property on `el` (e.g. `set_style(el, \"color\", \"red\")` or `set_style(el, \"transform\", \"translateX(40px)\")`). Pass an empty string to remove the property."
  fn set_style(el, prop, val)          do dom_set_style(el, prop, val) end

  doc "Return the inline CSS value for `prop` on `el`. Returns an empty string if the property is not set inline."
  fn get_style(el, prop)               do dom_get_style(el, prop) end

  doc "Return the current `value` property of a form input, textarea, or select element."
  fn get_value(el)                     do dom_get_value(el) end

  doc "Set the `value` property of a form input, textarea, or select element."
  fn set_value(el, val)                do dom_set_value(el, val) end

  doc "Attach `handler` to `el` for DOM event `event` (e.g. \"click\", \"input\", \"keydown\", \"mouseover\"). The handler receives the `Event` object. Use `event_target` to get the element that triggered it."
  fn listen(el, event, handler)        do dom_add_event_listener(el, event, handler) end

  doc "Remove a previously attached event listener. `handler` must be the same function value passed to `listen`."
  fn unlisten(el, event, handler)      do dom_remove_event_listener(el, event, handler) end

  doc "Return the element that triggered `ev` (the `event.target` node)."
  fn event_target(ev)                  do dom_event_target(ev) end

  doc "Return the event type string for `ev` (e.g. \"click\", \"input\")."
  fn event_type(ev)                    do dom_event_type(ev) end

  doc "Return the key that triggered a `\"keydown\"`/`\"keyup\"` event (e.g. \"ArrowLeft\", \"a\", \" \" for space)."
  fn event_key(ev)                     do dom_event_key(ev) end

  doc "Prevent the browser's default action for `ev` (e.g. stop a link from navigating, a form from submitting)."
  fn prevent_default(ev)               do dom_prevent_default(ev) end

  doc "Stop `ev` from bubbling up to parent elements."
  fn stop_propagation(ev)              do dom_stop_propagation(ev) end

  doc "Return the x-coordinate of `ev` relative to the target element (`event.offsetX`). Useful for hit-testing pointer/click events against a `<canvas>`."
  fn event_x(ev)                       do dom_event_x(ev) end

  doc "Return the y-coordinate of `ev` relative to the target element (`event.offsetY`)."
  fn event_y(ev)                       do dom_event_y(ev) end

  doc "Drain and return the pointer taps (pointerdown events) on `el` since the last call, as element-relative `(x, y)` integer pairs. The first call installs the buffering listener. Poll this once per animation frame for game input."
  fn taps(el)                          do dom_taps(el) end

  doc "Drain and return the keyboard keys (keydown `event.key` strings, e.g. \" \", \"ArrowLeft\", \"a\") pressed since the last call. The first call installs a document-level buffering listener which prevents the browser default ONLY for space and arrow keys (so game input doesn't scroll the page). Poll once per animation frame."
  fn key_presses()                     do dom_key_presses() end

  doc "Read `key` from the browser's localStorage. Returns `None` if the key is absent or storage is unavailable (e.g. private browsing)."
  fn store_get(key)                    do dom_store_get(key) end

  doc "Write `val` under `key` in the browser's localStorage. Silently does nothing if storage is unavailable."
  fn store_set(key, val)               do dom_store_set(key, val) end

  doc "Show a blocking browser `alert()` dialog with `msg`."
  fn alert(msg)                        do dom_alert(msg) end

  doc "Return the current page URL (`window.location.href`)."
  fn href()                            do dom_href() end

  doc "Navigate to `url` by setting `window.location.href`. This replaces the current page."
  fn navigate(url)                     do dom_set_href(url) end

  doc "Call `cb` once after `ms` milliseconds (non-blocking, runs on the event loop). Equivalent to `setTimeout`. `cb` takes one ignored Int argument — pass `fn _ -> ...` (a zero-arg `fn -> ...` lambda cannot be used here; see the module doc)."
  fn set_timeout(ms, cb)               do dom_set_timeout(ms, cb) end

  doc "Call `cb` repeatedly every `ms` milliseconds. Equivalent to `setInterval`. Returns no handle — cancel by keeping a flag in the DOM. `cb` takes one ignored Int argument — pass `fn _ -> ...`."
  fn set_interval(ms, cb)              do dom_set_interval(ms, cb) end

  doc "Schedule `cb` to run before the next browser repaint (`requestAnimationFrame`). Use for smooth 60 fps animations. `cb` takes one ignored Int argument — pass `fn _ -> ...`."
  fn on_frame(cb)                      do dom_request_animation_frame(cb) end

end
