-- Json module: JSON encoding and decoding.
--
-- Types:
--   JsonValue = Null
--             | Bool(Bool)
--             | Number(Float)
--             | Str(String)
--             | Array(List(JsonValue))
--             | Object(List((String, JsonValue)))
--
-- Note: Object uses an association list (ordered, allows duplicate keys).
-- Key lookup uses the first occurrence.
--
-- Functions:
--   parse(String)                      -> Result(JsonValue, String)
--   to_string(JsonValue)               -> String
--   get(JsonValue, String)             -> Option(JsonValue)
--   get_in(JsonValue, List(String))    -> Option(JsonValue)
--   encode_null()                      -> JsonValue
--   encode_bool(Bool)                  -> JsonValue
--   encode_number(Float)               -> JsonValue
--   encode_int(Int)                    -> JsonValue
--   encode_string(String)              -> JsonValue
--   encode_array(List(JsonValue))      -> JsonValue
--   encode_object(List((String, JsonValue))) -> JsonValue

mod Json do

  type JsonValue =
      Null
    | Bool(Bool)
    | Number(Float)
    | Str(String)
    | Array(List(JsonValue))
    | Object(List((String, JsonValue)))

  -- One step of a JSONPath. Steps are stored OUTERMOST-FIRST, so a decoder
  -- descending into a field prepends -- see decode_error_under.
  type JsonPathStep = JPathField(String) | JPathIndex(Int)

  -- A typed decoding failure: what was wrong, where in the document
  -- structure, and (when known) the absolute byte offset of the record it
  -- came from. The offset is 0 - 1 when unknown -- decoding a value already
  -- in memory has no byte position.
  --
  -- Path shape follows aeson and Jackson: a flat list of steps rendered
  -- JSONPath-style. Elm's recursive error tree exists to support `oneOf`,
  -- which reports several failed branches at one position; with no
  -- combinator layer a flat list carries the same information for less.
  -- Revisit if `oneOf` is ever added.
  type DecodeError = DecodeError(String, List(JsonPathStep), Int)

  -- ── Private helpers ───────────────────────────────────────────────────────

  pfn rev(xs, acc) do
    match xs do
    Nil -> acc
    Cons(h, t) -> rev(t, Cons(h, acc))
    end
  end

  -- ── Scanning discipline ───────────────────────────────────────────────────
  --
  -- The scanner is a byte-index cursor over the source string: it inspects one
  -- byte at a time with `string_byte_at` (which allocates nothing) and
  -- materialises each token with a single `string_slice`.
  --
  -- The previous parser instead did `string_split(src, "")` up front, which
  -- allocates one heap string per input byte and dominated the cost of
  -- `parse`: on a 239-byte document holding ~20 distinct strings it allocated
  -- 486 strings per parse — 2.03 per input byte, 90% of them <=7 bytes — so
  -- the cost scaled with the size of the document rather than with the number
  -- of strings in it.
  --
  -- Scanning BYTES rather than decoded characters is safe here and is what
  -- keeps this simple: every JSON structural character is ASCII, and every
  -- byte of a UTF-8 multibyte sequence is >= 0x80, so a multibyte character
  -- can never be mistaken for a delimiter.  Multibyte text is stepped over one
  -- byte at a time and passes through untouched inside the token slice, so no
  -- decoding and no byte/character offset mapping is needed anywhere.
  --
  -- `string_byte_at` returns -1 past the end of the string, which is not a
  -- valid byte, so end-of-input falls out of the same comparison as any other
  -- terminator and needs no separate length check.

  -- Byte width of the UTF-8 character starting with lead byte `b`.  Used only
  -- to slice a whole character back out for an error message.
  pfn utf8_width(b) do
    if b < 128 do 1
    else if b < 224 do 2
    else if b < 240 do 3
    else 4 end end end
  end

  -- The offending character at byte `i`, for an error message.  Error paths
  -- only, so this allocation is off the hot path.
  pfn char_at(s, i) do
    string_slice(s, i, utf8_width(string_byte_at(s, i)))
  end

  -- Skip ASCII whitespace, returning the next byte index.
  pfn skip_ws(s, i) do
    let c = string_byte_at(s, i)
    if c == 32 || c == 9 || c == 10 || c == 13 do skip_ws(s, i + 1)
    else i end
  end

  -- Match keyword `lit` at byte `i`.  Returns Ok(index just past it).
  -- `lit` is itself indexed with string_byte_at, so no char list is built.
  pfn match_lit_go(s, i, lit, j) do
    let e = string_byte_at(lit, j)
    if e < 0 do Ok(i)
    else do
      let c = string_byte_at(s, i)
      if c == e do match_lit_go(s, i + 1, lit, j + 1)
      else if c < 0 do Err("unexpected end of input, expected: " ++ lit)
      else Err("expected '" ++ lit ++ "' but found '" ++ char_at(s, i) ++ "'") end end
    end end
  end

  pfn match_lit(s, i, lit) do
    match_lit_go(s, i, lit, 0)
  end

  -- Value of a hex digit byte, or -1 for anything else (including the -1 that
  -- string_byte_at returns past the end of the input).
  pfn hex_val(b) do
    if b >= 48 && b <= 57 do b - 48
    else if b >= 97 && b <= 102 do b - 87
    else if b >= 65 && b <= 70 do b - 55
    else -1 end end end
  end

  -- Read exactly the four hex digits of a `\uXXXX` escape starting at `i`.
  pfn hex4(s, i) do
    let d0 = hex_val(string_byte_at(s, i))
    let d1 = hex_val(string_byte_at(s, i + 1))
    let d2 = hex_val(string_byte_at(s, i + 2))
    let d3 = hex_val(string_byte_at(s, i + 3))
    if d0 < 0 || d1 < 0 || d2 < 0 || d3 < 0 do
      Err("invalid \\u escape: expected four hex digits")
    else Ok(d0 * 4096 + d1 * 256 + d2 * 16 + d3) end
  end

  -- Encode one code point as UTF-8.  byte_to_char emits ONE byte, so a
  -- multi-byte sequence is assembled one continuation byte at a time --
  -- this is a byte builder, not a code-point builder.  (char_from_int is
  -- now equivalent, both being `n & 0xFF` in every backend; it used to
  -- yield "" above 127 in the interpreter, which is how this encoder came
  -- to be written against byte_to_char.  The name still says what is meant.)
  pfn utf8_encode(cp) do
    if cp < 128 do byte_to_char(cp)
    else if cp < 2048 do
      byte_to_char(192 + int_shr(cp, 6))
        ++ byte_to_char(128 + int_and(cp, 63))
    else if cp < 65536 do
      byte_to_char(224 + int_shr(cp, 12))
        ++ byte_to_char(128 + int_and(int_shr(cp, 6), 63))
        ++ byte_to_char(128 + int_and(cp, 63))
    else
      byte_to_char(240 + int_shr(cp, 18))
        ++ byte_to_char(128 + int_and(int_shr(cp, 12), 63))
        ++ byte_to_char(128 + int_and(int_shr(cp, 6), 63))
        ++ byte_to_char(128 + int_and(cp, 63))
    end end end
  end

  -- Decode a `\uXXXX` escape.  `i` is the index of the first hex digit (the
  -- caller has already consumed the backslash and the `u`).  A high surrogate
  -- must be followed by a second `\uXXXX` low surrogate, which together encode
  -- one astral code point; a surrogate appearing alone is rejected rather than
  -- silently emitted, since it is not a valid Unicode scalar value.
  -- Returns Ok((utf8, index just past the escape)).
  pfn unescape_u(s, i) do
    match hex4(s, i) do
    Err(msg) -> Err(msg)
    Ok(u) ->
      if u >= 55296 && u <= 56319 do
        if string_byte_at(s, i + 4) == 92 && string_byte_at(s, i + 5) == 117 do
          match hex4(s, i + 6) do
          Err(msg) -> Err(msg)
          Ok(lo) ->
            if lo >= 56320 && lo <= 57343 do
              Ok((utf8_encode(65536 + (u - 55296) * 1024 + (lo - 56320)), i + 10))
            else Err("invalid \\u escape: high surrogate not followed by a low surrogate") end
          end
        else Err("invalid \\u escape: unpaired high surrogate") end
      else if u >= 56320 && u <= 57343 do
        Err("invalid \\u escape: unpaired low surrogate")
      else Ok((utf8_encode(u), i + 4)) end end
    end
  end

  -- Decode one escape sequence body (the byte AFTER the backslash).
  -- `\u` is handled separately by unescape_u — it is the only escape whose
  -- length is not fixed at two bytes.
  pfn unescape(s, i, e) do
    if e == 34 do Ok("\"")
    else if e == 92 do Ok("\\")
    else if e == 47 do Ok("/")
    else if e == 110 do Ok(char_from_int(10))
    else if e == 114 do Ok(char_from_int(13))
    else if e == 116 do Ok(char_from_int(9))
    else if e == 98 do Ok(char_from_int(8))
    else if e == 102 do Ok(char_from_int(12))
    else Err("unknown escape sequence: \\" ++ char_at(s, i)) end end end end end end end end
  end

  -- Scan a string body.  `i` is the current byte, `start` the byte where the
  -- current unescaped run began, `acc` the already-materialised segments
  -- (newest first).  Returns Ok((value, index just past the closing quote)).
  --
  -- The common case — no escapes — reaches the closing quote with `acc` still
  -- Nil and returns ONE slice for the whole token.  Escapes split the token
  -- into runs, and each run is still sliced once rather than assembled byte by
  -- byte.
  pfn scan_string(s, i, start, acc) do
    let c = string_byte_at(s, i)
    if c < 0 do Err("unterminated string literal")
    else if c == 34 do
      match acc do
      Nil -> Ok((string_slice(s, start, i - start), i + 1))
      _ -> do
        let acc2 =
          if i > start do Cons(string_slice(s, start, i - start), acc)
          else acc end
        Ok((string_join(rev(acc2, Nil), ""), i + 1))
      end
      end
    else if c == 92 do do
      let e = string_byte_at(s, i + 1)
      if e < 0 do Err("unexpected end of input in string escape")
      else if e == 117 do
        match unescape_u(s, i + 2) do
        Err(msg) -> Err(msg)
        Ok((ch, next)) -> do
          let acc2 =
            if i > start do Cons(string_slice(s, start, i - start), acc)
            else acc end
          scan_string(s, next, next, Cons(ch, acc2))
        end
        end
      else
        match unescape(s, i + 1, e) do
        Err(msg) -> Err(msg)
        Ok(ch) -> do
          let acc2 =
            if i > start do Cons(string_slice(s, start, i - start), acc)
            else acc end
          scan_string(s, i + 2, i + 2, Cons(ch, acc2))
        end
        end
      end end
    end
    else scan_string(s, i + 1, start, acc) end end end
  end

  -- Number scanning follows RFC 8259's grammar directly:
  --   number = ["-"] int [frac] [exp]
  --   int    = "0" / (digit1-9 *DIGIT)
  --   frac   = "." 1*DIGIT
  --   exp    = ("e" / "E") ["+" / "-"] 1*DIGIT
  -- Bytes: '+'=43, '-'=45, '.'=46, '0'=48, '9'=57, 'E'=69, 'e'=101.
  -- string_byte_at returns -1 past the end, so every scan terminates there.
  --
  -- The shape is validated here rather than deferred to string_to_float: that
  -- builtin is strtod/float_of_string-backed and admits forms JSON does not
  -- ("+1", "Infinity", "0x10", "1.", "01").
  pfn is_digit_byte(c) do
    c >= 48 && c <= 57
  end

  -- Index just past a run of ASCII digits starting at `i` (may be `i` itself).
  pfn scan_digits(s, i) do
    if is_digit_byte(string_byte_at(s, i)) do scan_digits(s, i + 1)
    else i end
  end

  -- The number occupying [start, e) — used to quote the offender in errors.
  pfn bad_number(s, start, e) do
    Err("invalid number: " ++ string_slice(s, start, e - start))
  end

  -- int = "0" / (digit1-9 *DIGIT).  A leading zero may not be followed by
  -- another digit, so "01" is rejected.
  pfn scan_int(s, i, start) do
    let c = string_byte_at(s, i)
    if c == 48 do
      if is_digit_byte(string_byte_at(s, i + 1)) do
        Err("invalid number: leading zeros are not allowed in "
            ++ string_slice(s, start, i + 2 - start))
      else Ok(i + 1) end
    else if is_digit_byte(c) do Ok(scan_digits(s, i + 1))
    else bad_number(s, start, i + 1) end end
  end

  -- frac = "." 1*DIGIT.  Absent is fine; a '.' with no digits after it is not.
  pfn scan_frac(s, i, start) do
    if string_byte_at(s, i) == 46 do
      let e = scan_digits(s, i + 1)
      if e == i + 1 do bad_number(s, start, e)
      else Ok(e) end
    else Ok(i) end
  end

  -- exp = ("e" / "E") ["+" / "-"] 1*DIGIT.  The sign is accepted ONLY here,
  -- immediately after the exponent marker — treating '+'/'-' as ordinary
  -- number bytes would make "1-2" scan as the single token "1-2" and change
  -- the error reported for malformed input.
  pfn scan_exp(s, i, start) do
    let c = string_byte_at(s, i)
    if c == 101 || c == 69 do
      let sgn = string_byte_at(s, i + 1)
      let d0 = if sgn == 43 || sgn == 45 do i + 2 else i + 1 end
      let e = scan_digits(s, d0)
      if e == d0 do bad_number(s, start, e)
      else Ok(e) end
    else Ok(i) end
  end

  -- Parse a JSON number.  `i` is at '-' or a digit.
  pfn parse_number(s, i) do
    let i2 = if string_byte_at(s, i) == 45 do i + 1 else i end
    match scan_int(s, i2, i) do
    Err(e) -> Err(e)
    Ok(i3) ->
      match scan_frac(s, i3, i) do
      Err(e) -> Err(e)
      Ok(i4) ->
        match scan_exp(s, i4, i) do
        Err(e) -> Err(e)
        Ok(e2) -> do
          let num_str = string_slice(s, i, e2 - i)
          match string_to_float(num_str) do
          None -> Err("invalid number: " ++ num_str)
          Some(f) -> Ok((Number(f), e2))
          end
        end
        end
      end
    end
  end

  -- Parse a JSON value.  Returns Ok((JsonValue, next byte index)).
  pfn parse_value(s, i0) do
    let i = skip_ws(s, i0)
    let c = string_byte_at(s, i)
    if c < 0 do Err("unexpected end of input")
    else if c == 110 do
      match match_lit(s, i, "null") do
      Err(e) -> Err(e)
      Ok(j) -> Ok((Null, j))
      end
    else if c == 116 do
      match match_lit(s, i, "true") do
      Err(e) -> Err(e)
      Ok(j) -> Ok((Bool(true), j))
      end
    else if c == 102 do
      match match_lit(s, i, "false") do
      Err(e) -> Err(e)
      Ok(j) -> Ok((Bool(false), j))
      end
    else if c == 34 do
      match scan_string(s, i + 1, i + 1, Nil) do
      Err(e) -> Err(e)
      Ok((str, j)) -> Ok((Str(str), j))
      end
    else if c == 91 do parse_array(s, skip_ws(s, i + 1))
    else if c == 123 do parse_object(s, skip_ws(s, i + 1))
    else if (c >= 48 && c <= 57) || c == 45 do parse_number(s, i)
    else Err("unexpected character: '" ++ char_at(s, i) ++ "'")
    end end end end end end end end
  end

  -- Inner loop for parse_array.
  pfn parse_array_elements(s, i, acc) do
    match parse_value(s, i) do
    Err(e) -> Err(e)
    Ok((v, j)) -> do
      let k = skip_ws(s, j)
      let sep = string_byte_at(s, k)
      if sep < 0 do Err("unterminated array, expected ',' or ']'")
      else if sep == 93 do Ok((Array(rev(Cons(v, acc), Nil)), k + 1))
      else if sep == 44 do parse_array_elements(s, skip_ws(s, k + 1), Cons(v, acc))
      else Err("expected ',' or ']' in array, found: '" ++ char_at(s, k) ++ "'")
      end end end
    end
    end
  end

  -- Parse a JSON array (`i` is just AFTER the '[').
  pfn parse_array(s, i) do
    let c = string_byte_at(s, i)
    if c < 0 do Err("unterminated array")
    else if c == 93 do Ok((Array(Nil), i + 1))
    else parse_array_elements(s, i, Nil) end end
  end

  -- Inner loop for parse_object.
  pfn parse_pairs(s, i0, acc) do
    let i = skip_ws(s, i0)
    let q = string_byte_at(s, i)
    if q < 0 do Err("unterminated object")
    else if q == 34 do
      match scan_string(s, i + 1, i + 1, Nil) do
      Err(e) -> Err(e)
      Ok((key, j)) -> do
        let k = skip_ws(s, j)
        let colon = string_byte_at(s, k)
        if colon < 0 do Err("expected ':' after object key")
        else if colon == 58 do
          match parse_value(s, skip_ws(s, k + 1)) do
          Err(e) -> Err(e)
          Ok((v, m)) -> do
            let p = skip_ws(s, m)
            let sep = string_byte_at(s, p)
            if sep < 0 do Err("unterminated object, expected ',' or '}'")
            else if sep == 125 do Ok((Object(rev(Cons((key, v), acc), Nil)), p + 1))
            else if sep == 44 do parse_pairs(s, skip_ws(s, p + 1), Cons((key, v), acc))
            else Err("expected ',' or '}' in object, found: '" ++ char_at(s, p) ++ "'")
            end end end
          end
          end
        else Err("expected ':' after object key, found: '" ++ char_at(s, k) ++ "'")
        end end
      end
      end
    else Err("expected '\"' for object key, found: '" ++ char_at(s, i) ++ "'")
    end end
  end

  -- Parse a JSON object (`i` is just AFTER the '{').
  pfn parse_object(s, i) do
    let c = string_byte_at(s, i)
    if c < 0 do Err("unterminated object")
    else if c == 125 do Ok((Object(Nil), i + 1))
    else parse_pairs(s, i, Nil) end end
  end

  -- ── Escaping (output side) ────────────────────────────────────────────────
  --
  -- Same slice-per-run discipline as scan_string, for the same reason: the
  -- previous version split every emitted string into one heap string per
  -- character.  A string needing no escapes is returned as-is, allocating
  -- nothing at all.

  pfn escape_of(c) do
    if c == 34 do Some("\\\"")
    else if c == 92 do Some("\\\\")
    else if c == 10 do Some("\\n")
    else if c == 13 do Some("\\r")
    else if c == 9  do Some("\\t")
    else if c == 8  do Some("\\b")
    else if c == 12 do Some("\\f")
    else None end end end end end end end
  end

  pfn escape_go(s, i, start, acc) do
    let c = string_byte_at(s, i)
    if c < 0 do
      match acc do
      Nil -> s
      _ -> do
        let acc2 =
          if i > start do Cons(string_slice(s, start, i - start), acc)
          else acc end
        string_join(rev(acc2, Nil), "")
      end
      end
    else
      match escape_of(c) do
      None -> escape_go(s, i + 1, start, acc)
      Some(esc) -> do
        let acc2 =
          if i > start do Cons(string_slice(s, start, i - start), acc)
          else acc end
        escape_go(s, i + 1, i + 1, Cons(esc, acc2))
      end
      end
    end
  end

  pfn escape_str(s) do
    escape_go(s, 0, 0, Nil)
  end

  pfn map_list(xs, f, acc) do
    match xs do
    Nil -> rev(acc, Nil)
    Cons(h, t) -> map_list(t, f, Cons(f(h), acc))
    end
  end

  -- ── Public API ────────────────────────────────────────────────────────────

  doc """
  Parse a JSON string into a JsonValue.
  Returns Ok(value) on success, Err(message) on parse error.

      Json.parse("null")           -- Ok(Null)
      Json.parse("42")             -- Ok(Number(42.0))
      Json.parse("[1, 2, 3]")      -- Ok(Array([Number(1.0), ...]))
      Json.parse("{\"x\": 1}")     -- Ok(Object([("x", Number(1.0))]))
  """
  fn parse(s) do
    match parse_value(s, 0) do
    Err(e) -> Err(e)
    Ok((v, i)) -> do
      let j = skip_ws(s, i)
      if string_byte_at(s, j) < 0 do Ok(v)
      else Err("unexpected character after JSON value: '" ++ char_at(s, j) ++ "'") end
    end
    end
  end

  doc """
  Convert a JsonValue to its JSON string representation.

      Json.to_string(Null)         -- "null"
      Json.to_string(Bool(true))   -- "true"
      Json.to_string(Number(3.14)) -- "3.14"
      Json.to_string(Str("hi"))    -- "\"hi\""
  """
  fn to_string(jv) do
    match jv do
    Null -> "null"
    Bool(b) -> if b do "true" else "false" end
    Number(f) -> do
      let fi = float_to_int(f)
      if int_to_float(fi) == f do int_to_string(fi)
      else float_to_string(f) end
    end
    Str(s) -> "\"" ++ escape_str(s) ++ "\""
    Array(xs) -> do
      let strs = map_list(xs, fn x -> to_string(x), Nil)
      "[" ++ string_join(strs, ",") ++ "]"
    end
    Object(kvs) -> do
      let strs = map_list(kvs, fn kv -> match kv do
        (k, v) -> "\"" ++ escape_str(k) ++ "\":" ++ to_string(v)
        end, Nil)
      "{" ++ string_join(strs, ",") ++ "}"
    end
    end
  end

  doc """
  Retrieve a field from a JSON Object by key.
  Returns Some(value) if found, or None otherwise.
  If jv is not an Object, returns None.

      Json.get(Object([("x", Number(1.0))]), "x") -- Some(Number(1.0))
      Json.get(Null, "x")                          -- None
  """
  fn get(jv : JsonValue, key : String) : Option(JsonValue) do
    match jv do
    Object(kvs) -> do
      fn find(pairs : List((String, JsonValue))) : Option(JsonValue) do
        match pairs do
        Nil -> None
        Cons(kv, rest) -> do
          let (k, v) = kv
          if k == key do Some(v)
          else find(rest) end
        end
        end
      end
      find(kvs)
    end
    _ -> None
    end
  end

  doc """
  Look up a key in a JSON object's raw key-value list directly -- the list
  already bound by matching `Object(kvs)`, rather than a `JsonValue`. Returns
  Some(value) if found, or None otherwise. Used by the generated `from_json`
  record decoder, which destructures `Object(kvs)` once and then looks up
  each field by name without re-matching the wrapper each time.

      Json.get_field([("x", Number(1.0))], "x") -- Some(Number(1.0))
      Json.get_field([], "x")                    -- None
  """
  fn get_field(kvs : List((String, JsonValue)), key : String) : Option(JsonValue) do
    match kvs do
    Nil -> None
    Cons(kv, rest) -> do
      let (k, v) = kv
      if k == key do Some(v)
      else get_field(rest, key) end
    end
    end
  end

  doc """
  Nested field access: traverse a path of keys into nested JSON Objects.
  Returns Some(value) if the full path exists, or None if any step fails.

      Json.get_in(obj, ["a", "b", "c"]) -- equivalent to obj.a.b.c

  Object-only.  For paths that include array indices, use `get_path`.
  """
  fn get_in(jv : JsonValue, keys : List(String)) : Option(JsonValue) do
    match keys do
    Nil -> Some(jv)
    Cons(k, rest) -> do
      match get(jv, k) do
      None -> None
      Some(v) -> get_in(v, rest)
      end
    end
    end
  end

  -- A single step in a JSON path: either an object key or an array index.
  type JsonPath = Key(String) | Index(Int)

  doc """
  Retrieve a JSON Array element by 0-based index.
  Returns Some(value) if in range, or None otherwise (also None if jv
  is not an Array, or if i is negative).

      Json.get_at(Array([Number(1.0), Number(2.0)]), 1)
      -- Some(Number(2.0))
      Json.get_at(Array([Number(1.0)]), 5)
      -- None
  """
  fn get_at(jv : JsonValue, i : Int) : Option(JsonValue) do
    match jv do
    Array(xs) -> do
      if i < 0 do None
      else do
        fn nth(lst, n) do
          match lst do
          Nil -> None
          Cons(h, t) -> if n == 0 do Some(h) else nth(t, n - 1) end
          end
        end
        nth(xs, i)
      end end
    end
    _ -> None
    end
  end

  doc """
  Mixed-segment path access for JSON values nested in objects and arrays.
  Each step is `Key("name")` for an object lookup or `Index(i)` for an
  array index.  Returns Some(value) if the full path exists, or None
  if any step fails.

      Json.get_path(jv, [Key("items"), Index(0), Key("name")])
      -- equivalent to jv.items[0].name
  """
  fn get_path(jv : JsonValue, path : List(JsonPath)) : Option(JsonValue) do
    match path do
    Nil -> Some(jv)
    Cons(seg, rest) -> do
      let next = match seg do
        Key(k)   -> get(jv, k)
        Index(i) -> get_at(jv, i)
        end
      match next do
      None    -> None
      Some(v) -> get_path(v, rest)
      end
    end
    end
  end

  doc "Construct a JSON null value."
  fn encode_null() do Null end

  doc "Construct a JSON boolean value."
  fn encode_bool(b) do Bool(b) end

  doc "Construct a JSON number value from a Float."
  fn encode_number(f) do Number(f) end

  doc "Construct a JSON number value from an Int."
  fn encode_int(n) do Number(int_to_float(n)) end

  doc "Construct a JSON string value."
  fn encode_string(s) do Str(s) end

  doc "Construct a JSON array value."
  fn encode_array(xs) do Array(xs) end

  doc "Construct a JSON object value from a list of (key, value) pairs."
  fn encode_object(kvs) do Object(kvs) end

  doc "Push `step` onto the front of a DecodeError's path, as a decoder does when it descends."
  fn decode_error_under(step, e) do
    match e do
    DecodeError(msg, path, off) -> DecodeError(msg, Cons(step, path), off)
    end
  end

  doc "Attach an absolute byte offset to a DecodeError."
  fn decode_error_at(off, e) do
    match e do
    DecodeError(msg, path, _) -> DecodeError(msg, path, off)
    end
  end

  pfn render_path(steps, acc) do
    match steps do
    Nil -> acc
    Cons(h, t) -> do
      let new_acc = match h do
        JPathField(f) -> acc ++ "." ++ f
        JPathIndex(i) -> acc ++ "[" ++ int_to_string(i) ++ "]"
      end
      render_path(t, new_acc)
    end
    end
  end

  doc """
  Render a `DecodeError` as `$.users[3].id: expected Int`, with the byte
  offset when known: `$.id (byte 4096): expected Int`.
  """
  fn decode_error_to_string(e) do
    match e do
    DecodeError(msg, path, off) -> do
      let p = render_path(path, "$")
      if off < 0 do p ++ ": " ++ msg
      else p ++ " (byte " ++ int_to_string(off) ++ "): " ++ msg end
    end
    end
  end

end
