-- TOML v1.0 parser (pure March, no FFI)
--
-- Supports: strings (basic, literal, multiline), integers, floats, booleans,
-- arrays, inline tables, table headers [x], array-of-tables [[x]],
-- dotted keys, quoted keys, comments.
--
-- Public API:
--   Toml.parse(src)           : Result(TomlValue, TomlError)
--   Toml.parse_exn(src)       : TomlValue  (panics on error)
--   Toml.to_string(v)         : String
--   Toml.get(v, key)          : Option(TomlValue)
--   Toml.get_in(v, keys)      : Option(TomlValue)
--   Toml.get_str(v, key)      : Option(String)
--   Toml.get_int(v, key)      : Option(Int)
--   Toml.get_float(v, key)    : Option(Float)
--   Toml.get_bool(v, key)     : Option(Bool)
--   Toml.get_table(v, key)    : Option(TomlValue)
--   Toml.get_array(v, key)    : Option(List(TomlValue))

mod Toml do

  type TomlValue
    = TStr(String)
    | TInt(Int)
    | TFloat(Float)
    | TBool(Bool)
    | TNull
    | TDatetime(String)
    | TArray(List(TomlValue))
    | TTable(List((String, TomlValue)))

  type TomlError = TomlError(String, Int, Int)

  -- ── Scanning discipline ───────────────────────────────────────────────────
  --
  -- Byte-index cursor over the source string, following the pattern from the
  -- Json parser rewrite (see commit 556cf7e9): a scan step inspects bytes with
  -- `string_byte_at` (no allocation) and each token is materialised with a
  -- single `string_slice` (or, for strings containing escapes, a handful of
  -- slices joined once). The previous parser did `string_split(src, "")` up
  -- front and built every token via `acc ++ c` -- one fresh heap string per
  -- character, and O(n^2) copying for an n-byte token -- which measured at
  -- 3.72 string allocations per input byte.
  --
  -- Structural TOML characters are all ASCII, and every byte of a multibyte
  -- UTF-8 sequence is >= 0x80, so scanning raw bytes never mistakes a
  -- multibyte character for a delimiter; multibyte text just passes through
  -- inside a token slice untouched.
  --
  -- State is (src, byte_index, line, col). `line`/`col` are maintained for
  -- error reporting; `col` counts BYTES rather than decoded characters
  -- (a minor, deliberate divergence from the previous char-list parser,
  -- matching the Json rewrite's precedent).

  pfn is_digit_byte(n) do n >= 48 && n <= 57 end

  pfn is_bare_key_byte(n) do
    (n >= 65 && n <= 90) || (n >= 97 && n <= 122) ||
    (n >= 48 && n <= 57) || n == 45 || n == 95
  end

  -- ── Parser state ──────────────────────────────────────────────────────────

  pfn make_state(src) do (src, 0, 1, 0) end

  pfn st_line(st) do match st do (_, _, l, _) -> l end end
  pfn st_col(st)  do match st do (_, _, _, c) -> c end end

  pfn cur_byte(st) do
    match st do (s, i, _, _) -> string_byte_at(s, i) end
  end

  pfn advance(st) do
    match st do
    (s, i, line, col) ->
      let b = string_byte_at(s, i)
      if b < 0 do st
      else if b == 10 do (s, i + 1, line + 1, 0)
      else (s, i + 1, line, col + 1)
      end end
    end
  end

  pfn at_end(st) do cur_byte(st) < 0 end

  -- Recompute (line, col) after jumping the cursor to byte index `j`,
  -- counting any newlines crossed. Used after a raw byte-index scan (which
  -- never touches the state tuple) to rebuild a consistent state once.
  pfn reposition_go(s, j, k, line, col) do
    if k >= j do (s, j, line, col)
    else
      let b = string_byte_at(s, k)
      if b == 10 do reposition_go(s, j, k + 1, line + 1, 0)
      else reposition_go(s, j, k + 1, line, col + 1)
      end
    end
  end

  pfn reposition(st, j) do
    match st do (s, i0, line0, col0) -> reposition_go(s, j, i0, line0, col0) end
  end

  pfn err(st, msg) do
    Err(TomlError(msg, st_line(st), st_col(st)))
  end

  pfn err_at(st, fail_i, msg) do
    err(reposition(st, fail_i), msg)
  end

  -- Byte width of the UTF-8 character starting with lead byte `b`. Used only
  -- to slice a whole character back out for an error message.
  pfn utf8_width(b) do
    if b < 128 do 1
    else if b < 224 do 2
    else if b < 240 do 3
    else 4 end end end
  end

  pfn char1(s, i) do string_slice(s, i, utf8_width(string_byte_at(s, i))) end

  pfn char1_at(st) do
    match st do (s, i, _, _) -> char1(s, i) end
  end

  -- ── Skip whitespace & comments ────────────────────────────────────────────

  pfn skip_ws(st) do
    let b = cur_byte(st)
    if b == 32 || b == 9 do skip_ws(advance(st))
    else st
    end
  end

  pfn skip_line(st) do
    let b = cur_byte(st)
    if b < 0 do st
    else if b == 10 do advance(st)
    else if b == 13 do
      let st2 = advance(st)
      if cur_byte(st2) == 10 do advance(st2) else st2 end
    else skip_line(advance(st))
    end end end
  end

  pfn skip_ws_comments(st) do
    let st1 = skip_ws(st)
    let b = cur_byte(st1)
    if b == 35 do skip_ws_comments(skip_line(st1))
    else if b == 10 do skip_ws_comments(advance(st1))
    else if b == 13 do
      let st2 = advance(st1)
      if cur_byte(st2) == 10 do skip_ws_comments(advance(st2))
      else skip_ws_comments(st2)
      end
    else st1
    end end end
  end

  pfn skip_ws_inline(st) do
    -- Skip whitespace but not newlines
    let st1 = skip_ws(st)
    if cur_byte(st1) == 35 do skip_line(st1)  -- comment ends line
    else st1
    end
  end

  pfn skip_ml_leading_newline(s, i) do
    let b = string_byte_at(s, i)
    if b == 10 do i + 1
    else if b == 13 do
      if string_byte_at(s, i + 1) == 10 do i + 2 else i + 1 end
    else i
    end end
  end

  -- ── Expect a specific character ───────────────────────────────────────────

  pfn expect_char(st, expected) do
    let b = cur_byte(st)
    if b < 0 do err(st, "expected '" ++ expected ++ "' but got end of input")
    else if b == string_byte_at(expected, 0) do Ok(advance(st))
    else err(st, "expected '" ++ expected ++ "' but got '" ++ char1_at(st) ++ "'")
    end end
  end

  -- Match a literal `lit` at byte `i`. Returns the index just past it, or -1
  -- on mismatch. `lit` itself is indexed with string_byte_at, so no list of
  -- expected chars is ever built.
  pfn match_lit_go(s, i, lit, j) do
    let e = string_byte_at(lit, j)
    if e < 0 do i
    else
      let c = string_byte_at(s, i)
      if c == e do match_lit_go(s, i + 1, lit, j + 1)
      else -1
      end
    end
  end

  -- ── Segment-slicing helpers (shared by string/digit scanners) ────────────

  -- Push the run [start, i) onto `acc` (newest first) if it's non-empty.
  pfn push_seg(s, start, i, acc) do
    if i > start do Cons(string_slice(s, start, i - start), acc) else acc end
  end

  -- Materialise `acc` plus the trailing run [start, i): a single slice in the
  -- common no-escapes case, one string_join if the token was split by escapes.
  pfn finish_join(s, start, i, acc) do
    match acc do
    Nil -> string_slice(s, start, i - start)
    _   -> string_join(List.reverse(push_seg(s, start, i, acc)), "")
    end
  end

  -- ── Parse basic string (double-quoted) ───────────────────────────────────

  -- Decode one escape sequence body (the byte after the backslash). `\u` and
  -- `\U` are passed through literally as "\u"/"\U" -- matching the previous
  -- parser's behaviour, which never decoded the following hex digits either.
  pfn unescape_basic(s, epos, e) do
    if e == 34 do Ok("\"")
    else if e == 92 do Ok("\\")
    else if e == 110 do Ok("\n")
    else if e == 116 do Ok("\t")
    else if e == 114 do Ok("\r")
    else if e == 98 do Ok("\x08")
    else if e == 102 do Ok("\x0c")
    else if e == 47 do Ok("/")
    else if e == 117 do Ok("\\u")
    else if e == 85 do Ok("\\U")
    else Err("unknown escape sequence: \\" ++ char1(s, epos)) end end end end end end end end end end
  end

  -- Single-line basic-string body. `i` is the first content byte (right
  -- after the opening quote). Returns Ok((value, index past closing quote))
  -- or Err((message, failure_index)).
  pfn scan_basic_go(s, i, start, acc) do
    let c = string_byte_at(s, i)
    if c < 0 do Err(("unterminated string", i))
    else if c == 34 do Ok((finish_join(s, start, i, acc), i + 1))
    else if c == 92 do
      let e = string_byte_at(s, i + 1)
      if e < 0 do Err(("unexpected end of input in escape sequence", i + 1))
      else
        match unescape_basic(s, i + 1, e) do
        Err(msg) -> Err((msg, i + 1))
        Ok(esc) ->
          scan_basic_go(s, i + 2, i + 2, Cons(esc, push_seg(s, start, i, acc)))
        end
      end
    else if c == 10 || c == 13 do Err(("newline in basic string", i))
    else scan_basic_go(s, i + 1, start, acc)
    end end end end
  end

  -- Multiline basic-string body: allows literal newlines, terminates only on
  -- an unescaped `"""`. A lone or double `"` that isn't followed by a third
  -- is ordinary content and is simply scanned past.
  pfn scan_ml_basic_go(s, i, start, acc) do
    let c = string_byte_at(s, i)
    if c < 0 do Err(("unterminated multiline string", i))
    else if c == 34 do
      if string_byte_at(s, i + 1) == 34 && string_byte_at(s, i + 2) == 34 do
        Ok((finish_join(s, start, i, acc), i + 3))
      else scan_ml_basic_go(s, i + 1, start, acc) end
    else if c == 92 do
      let e = string_byte_at(s, i + 1)
      if e < 0 do Err(("unexpected end of input in escape sequence", i + 1))
      else
        match unescape_basic(s, i + 1, e) do
        Err(msg) -> Err((msg, i + 1))
        Ok(esc) ->
          scan_ml_basic_go(s, i + 2, i + 2, Cons(esc, push_seg(s, start, i, acc)))
        end
      end
    else scan_ml_basic_go(s, i + 1, start, acc)
    end end end
  end

  -- Scan a single-line basic-string body starting right at `st`'s cursor
  -- (already past the opening quote). Shared by string values and quoted
  -- keys, neither of which supports the triple-quoted multiline form.
  pfn scan_basic_body(st) do
    match st do
    (s, i, _, _) ->
      match scan_basic_go(s, i, i, Nil) do
      Err((msg, fi)) -> err_at(st, fi, msg)
      Ok((v, j)) -> Ok((v, reposition(st, j)))
      end
    end
  end

  pfn parse_basic_string(st) do
    -- st is already past the opening "
    match st do
    (s, i, _, _) ->
      let b1 = string_byte_at(s, i)
      let b2 = string_byte_at(s, i + 1)
      if b1 == 34 && b2 == 34 do
        -- Triple-quoted multiline
        let i2 = i + 2
        let i3 = skip_ml_leading_newline(s, i2)
        match scan_ml_basic_go(s, i3, i3, Nil) do
        Err((msg, fi)) -> err_at(st, fi, msg)
        Ok((v, j)) -> Ok((TStr(v), reposition(st, j)))
        end
      else if b1 == 34 do
        -- Empty string ""
        Ok((TStr(""), reposition(st, i + 1)))
      else
        match scan_basic_body(st) do
        Err(e) -> Err(e)
        Ok((v, st2)) -> Ok((TStr(v), st2))
        end
      end end
    end
  end

  -- ── Parse literal string (single-quoted) ─────────────────────────────────

  pfn scan_literal_go(s, i, start) do
    let c = string_byte_at(s, i)
    if c < 0 do Err(("unterminated literal string", i))
    else if c == 39 do Ok((string_slice(s, start, i - start), i + 1))
    else if c == 10 || c == 13 do Err(("newline in literal string", i))
    else scan_literal_go(s, i + 1, start)
    end end end
  end

  pfn scan_ml_literal_go(s, i, start) do
    let c = string_byte_at(s, i)
    if c < 0 do Err(("unterminated multiline literal string", i))
    else if c == 39 do
      if string_byte_at(s, i + 1) == 39 && string_byte_at(s, i + 2) == 39 do
        Ok((string_slice(s, start, i - start), i + 3))
      else scan_ml_literal_go(s, i + 1, start) end
    else scan_ml_literal_go(s, i + 1, start)
    end end
  end

  pfn scan_literal_body(st) do
    match st do
    (s, i, _, _) ->
      match scan_literal_go(s, i, i) do
      Err((msg, fi)) -> err_at(st, fi, msg)
      Ok((v, j)) -> Ok((v, reposition(st, j)))
      end
    end
  end

  pfn parse_literal_string(st) do
    match st do
    (s, i, _, _) ->
      let b1 = string_byte_at(s, i)
      let b2 = string_byte_at(s, i + 1)
      if b1 == 39 && b2 == 39 do
        let i2 = i + 2
        let i3 = skip_ml_leading_newline(s, i2)
        match scan_ml_literal_go(s, i3, i3) do
        Err((msg, fi)) -> err_at(st, fi, msg)
        Ok((v, j)) -> Ok((TStr(v), reposition(st, j)))
        end
      else if b1 == 39 do
        Ok((TStr(""), reposition(st, i + 1)))
      else
        match scan_literal_body(st) do
        Err(e) -> Err(e)
        Ok((v, st2)) -> Ok((TStr(v), st2))
        end
      end end
    end
  end

  -- ── Parse number (int or float) ───────────────────────────────────────────

  -- Collect a run of digits with '_' separators (dropped from the output).
  -- Underscores are only consumed when both flanked by digits, matching the
  -- previous char-list parser exactly.
  pfn digits_go(s, i, start, acc) do
    let c = string_byte_at(s, i)
    if is_digit_byte(c) do digits_go(s, i + 1, start, acc)
    else if c == 95 do
      if is_digit_byte(string_byte_at(s, i + 1)) do
        digits_go(s, i + 1, i + 1, push_seg(s, start, i, acc))
      else (finish_join(s, start, i, acc), i)
      end
    else (finish_join(s, start, i, acc), i)
    end end
  end

  pfn parse_digits(st) do
    match st do
    (s, i, _, _) ->
      match digits_go(s, i, i, Nil) do
      (val, j) -> (val, reposition(st, j))
      end
    end
  end

  pfn digits_to_int_go(s, i, len, acc) do
    if i >= len do acc
    else digits_to_int_go(s, i + 1, len, acc * 10 + (string_byte_at(s, i) - 48))
    end
  end

  pfn digits_to_int(s) do
    digits_to_int_go(s, 0, string_byte_length(s), 0)
  end

  -- Parse exponent part after decimal (e/E [+/-] digits). Returns ("e+NNN", st').
  pfn parse_exp_part(st) do
    let b = cur_byte(st)
    if b == 101 do
      let st2 = advance(st)
      let b2 = cur_byte(st2)
      if b2 == 43 do
        let (ds, st3) = parse_digits(advance(st2))
        ("e+" ++ ds, st3)
      else if b2 == 45 do
        let (ds, st3) = parse_digits(advance(st2))
        ("e-" ++ ds, st3)
      else
        let (ds, st3) = parse_digits(st2)
        ("e+" ++ ds, st3)
      end end
    else if b == 69 do
      let (ds, st3) = parse_digits(advance(st))
      ("e+" ++ ds, st3)
    else ("", st)
    end end
  end

  pfn parse_number(st, sign) do
    -- sign: 1 or -1
    let b = cur_byte(st)
    if b < 0 do err(st, "expected number")
    else if not (is_digit_byte(b)) do err(st, "expected digit, got '" ++ char1_at(st) ++ "'")
    else
      let (int_str, st2) = parse_digits(st)
      let int_val = digits_to_int(int_str)
      let b2 = cur_byte(st2)
      if b2 == 46 do
        let st3 = advance(st2)
        let (frac_str, st4) = parse_digits(st3)
        let (exp_str, st5) = parse_exp_part(st4)
        let float_src = int_to_string(int_val) ++ "." ++ frac_str ++ exp_str
        let f = match string_to_float(float_src) do Some(x) -> x | None -> 0.0 end
        let f2 = if sign < 0 do 0.0 -. f else f end
        Ok((TFloat(f2), st5))
      else if b2 == 101 || b2 == 69 do
        let (exp_str, st5) = parse_exp_part(st2)
        let float_src = int_to_string(int_val) ++ ".0" ++ exp_str
        let f = match string_to_float(float_src) do Some(x) -> x | None -> 0.0 end
        let f2 = if sign < 0 do 0.0 -. f else f end
        Ok((TFloat(f2), st5))
      else
        let n = if sign < 0 do 0 - int_val else int_val end
        Ok((TInt(n), st2))
      end end
    end end
  end

  -- ── Parse value ───────────────────────────────────────────────────────────

  pfn parse_value(st) do
    let st1 = skip_ws(st)
    match st1 do
    (s, i1, _, _) ->
      let b = string_byte_at(s, i1)
      if b < 0 do err(st1, "expected value, got end of input")
      else if b == 34 do parse_basic_string(advance(st1))
      else if b == 39 do parse_literal_string(advance(st1))
      else if b == 91 do parse_array(advance(st1))
      else if b == 123 do parse_inline_table(advance(st1))
      else if b == 116 do
        let j = match_lit_go(s, i1, "true", 0)
        if j < 0 do err(st1, "expected 'true'")
        else Ok((TBool(true), reposition(st1, j))) end
      else if b == 102 do
        let j = match_lit_go(s, i1, "false", 0)
        if j < 0 do err(st1, "expected 'false'")
        else Ok((TBool(false), reposition(st1, j))) end
      else if b == 105 do
        let j = match_lit_go(s, i1, "inf", 0)
        if j < 0 do err(st1, "expected 'inf'")
        else Ok((TFloat(match string_to_float("inf") do Some(x) -> x | None -> 0.0 end), reposition(st1, j))) end
      else if b == 110 do
        let j = match_lit_go(s, i1, "nan", 0)
        if j < 0 do err(st1, "expected 'nan'")
        else Ok((TFloat(match string_to_float("nan") do Some(x) -> x | None -> 0.0 end), reposition(st1, j))) end
      else if b == 43 do
        if string_byte_at(s, i1 + 1) == 105 do
          let j = match_lit_go(s, i1 + 1, "inf", 0)
          if j < 0 do err_at(st1, i1 + 2, "expected 'inf'")
          else Ok((TFloat(match string_to_float("inf") do Some(x) -> x | None -> 0.0 end), reposition(st1, j))) end
        else parse_number(advance(st1), 1)
        end
      else if b == 45 do
        if string_byte_at(s, i1 + 1) == 105 do
          let j = match_lit_go(s, i1 + 1, "inf", 0)
          if j < 0 do err_at(st1, i1 + 2, "expected 'inf'")
          else Ok((TFloat(match string_to_float("-inf") do Some(x) -> x | None -> 0.0 end), reposition(st1, j))) end
        else if string_byte_at(s, i1 + 1) == 110 do
          let j = match_lit_go(s, i1 + 1, "nan", 0)
          if j < 0 do err_at(st1, i1 + 2, "expected 'nan'")
          else Ok((TFloat(match string_to_float("nan") do Some(x) -> x | None -> 0.0 end), reposition(st1, j))) end
        else parse_number(advance(st1), -1)
        end end
      else if is_digit_byte(b) do parse_number(st1, 1)
      else err(st1, "unexpected character '" ++ char1_at(st1) ++ "' in value")
      end end end end end end end end end end end end
    end
  end

  -- ── Parse array ───────────────────────────────────────────────────────────

  pfn parse_array_items(st, acc) do
    let st1 = skip_ws_comments(st)
    let b = cur_byte(st1)
    if b < 0 do err(st1, "unterminated array")
    else if b == 93 do Ok((List.reverse(acc), advance(st1)))
    else
      match parse_value(st1) do
      Err(e) -> Err(e)
      Ok((v, st2)) ->
        let st3 = skip_ws_comments(st2)
        let b2 = cur_byte(st3)
        if b2 == 44 do parse_array_items(advance(st3), Cons(v, acc))
        else if b2 == 93 do Ok((List.reverse(Cons(v, acc)), advance(st3)))
        else err(st3, "expected ',' or ']' in array")
        end end
      end
    end end
  end

  pfn parse_array(st) do
    match parse_array_items(st, Nil) do
    Err(e) -> Err(e)
    Ok((items, st2)) -> Ok((TArray(items), st2))
    end
  end

  -- ── Parse inline table ────────────────────────────────────────────────────

  pfn parse_inline_table_pairs(st, acc) do
    let st1 = skip_ws(st)
    let b = cur_byte(st1)
    if b < 0 do err(st1, "unterminated inline table")
    else if b == 125 do Ok((List.reverse(acc), advance(st1)))
    else
      match parse_key(st1) do
      Err(e) -> Err(e)
      Ok((key_parts, st2)) ->
        let st3 = skip_ws(st2)
        match expect_char(st3, "=") do
        Err(e) -> Err(e)
        Ok(st4) ->
          match parse_value(skip_ws(st4)) do
          Err(e) -> Err(e)
          Ok((v, st5)) ->
            let st6 = skip_ws(st5)
            let entry = (String.join(key_parts, "."), v)
            let b2 = cur_byte(st6)
            if b2 == 44 do parse_inline_table_pairs(advance(st6), Cons(entry, acc))
            else if b2 == 125 do Ok((List.reverse(Cons(entry, acc)), advance(st6)))
            else err(st6, "expected ',' or '}' in inline table")
            end end
          end
        end
      end
    end end
  end

  pfn parse_inline_table(st) do
    match parse_inline_table_pairs(st, Nil) do
    Err(e) -> Err(e)
    Ok((pairs, st2)) -> Ok((TTable(pairs), st2))
    end
  end

  -- ── Parse key ─────────────────────────────────────────────────────────────

  pfn bare_key_end(s, i) do
    if is_bare_key_byte(string_byte_at(s, i)) do bare_key_end(s, i + 1) else i end
  end

  pfn parse_bare_key(st) do
    match st do
    (s, i, _, _) ->
      let j = bare_key_end(s, i)
      (string_slice(s, i, j - i), reposition(st, j))
    end
  end

  pfn parse_key_segment(st) do
    let b = cur_byte(st)
    if b < 0 do err(st, "expected key")
    else if b == 34 do scan_basic_body(advance(st))
    else if b == 39 do scan_literal_body(advance(st))
    else if is_bare_key_byte(b) do
      match parse_bare_key(st) do
      (k, st2) ->
        if k == "" do err(st, "empty key")
        else Ok((k, st2))
        end
      end
    else err(st, "expected key, got '" ++ char1_at(st) ++ "'")
    end end end end
  end

  pfn parse_key(st) do
    match parse_key_segment(st) do
    Err(e) -> Err(e)
    Ok((first, st2)) ->
      let st3 = skip_ws(st2)
      if cur_byte(st3) == 46 do
        let st4 = skip_ws(advance(st3))
        match parse_key(st4) do
        Err(e) -> Err(e)
        Ok((rest, st5)) -> Ok((Cons(first, rest), st5))
        end
      else Ok(([first], st3))
      end
    end
  end

  -- ── Table helpers ─────────────────────────────────────────────────────────

  pfn table_get(pairs, key) do
    match pairs do
    Nil -> None
    Cons(p, rest) ->
      match p do
      (k, v) ->
        if k == key do Some(v)
        else table_get(rest, key)
        end
      end
    end
  end

  pfn table_put(pairs, key, val) do
    -- Remove existing entry with this key, then prepend
    let filtered = List.filter(pairs, fn p -> match p do (k, _) -> k != key end)
    Cons((key, val), filtered)
  end

  pfn table_has(pairs, key) do
    match table_get(pairs, key) do
    Some(_) -> true
    None -> false
    end
  end

  -- Returns true if pairs is an error sentinel list from set_nested.
  pfn is_err_marker(pairs) do
    match pairs do
    Cons(("__toml_dup__", _), Nil) -> true
    Cons(("__toml_conflict__", _), Nil) -> true
    _ -> false
    end
  end

  -- Set a nested value via key path. Creates intermediate tables as needed.
  -- When navigating through a TArray, updates the last element.
  -- Returns a sentinel [("__toml_dup__", TNull)] or [("__toml_conflict__", TNull)]
  -- on error; callers must check is_err_marker before wrapping the result.
  pfn set_nested(pairs, keys, val) do
    match keys do
    Nil -> pairs
    Cons(k, Nil) ->
      if table_has(pairs, k) do
        [("__toml_dup__", TNull)]
      else
        Cons((k, val), pairs)
      end
    Cons(k, rest) ->
      match table_get(pairs, k) do
      Some(TTable(sub)) ->
        let sub2 = set_nested(sub, rest, val)
        if is_err_marker(sub2) do sub2
        else table_put(pairs, k, TTable(sub2))
        end
      Some(TArray(arr)) ->
        let rev = List.reverse(arr)
        match rev do
        Cons(TTable(last_pairs), rest_rev) ->
          let last2 = set_nested(last_pairs, rest, val)
          if is_err_marker(last2) do last2
          else
            let arr2 = List.reverse(Cons(TTable(last2), rest_rev))
            table_put(pairs, k, TArray(arr2))
          end
        _ -> [("__toml_conflict__", TNull)]
        end
      None ->
        let sub2 = set_nested(Nil, rest, val)
        if is_err_marker(sub2) do sub2
        else table_put(pairs, k, TTable(sub2))
        end
      _ -> [("__toml_conflict__", TNull)]
      end
    end
  end

  -- ── Parse document ────────────────────────────────────────────────────────

  -- Result of parsing the document: accumulates key-value pairs and current table path
  -- We use a simple approach: parse into a flat representation

  pfn parse_keyval(st, root, path) do
    -- Parse "key = value" and return updated root
    match parse_key(st) do
    Err(e) -> Err(e)
    Ok(p) ->
      match p do
      (key_parts, st2) ->
        let st3 = skip_ws(st2)
        match expect_char(st3, "=") do
        Err(e) -> Err(e)
        Ok(st4) ->
          match parse_value(skip_ws(st4)) do
          Err(e) -> Err(e)
          Ok(p2) ->
            match p2 do
            (v, st5) ->
              let full_path = List.append(path, key_parts)
              let new_root = set_nested(root, full_path, v)
              -- Check for duplicate/conflict error sentinel from set_nested.
              -- is_err_marker handles both __toml_dup__ and __toml_conflict__,
              -- including when the error occurs at any nesting depth.
              if is_err_marker(new_root) do
                match new_root do
                Cons(("__toml_dup__", _), _) ->
                  err(st, "duplicate key: " ++ String.join(full_path, "."))
                _ ->
                  err(st, "type conflict at key: " ++ String.join(full_path, "."))
                end
              else Ok((new_root, st5))
              end
            end
          end
        end
      end
    end
  end

  pfn parse_table_header(st) do
    -- Already consumed '['
    match parse_key(st) do
    Err(e) -> Err(e)
    Ok(p) ->
      match p do
      (keys, st2) ->
        let st3 = skip_ws(st2)
        match expect_char(st3, "]") do
        Err(e) -> Err(e)
        Ok(st4) -> Ok((keys, st4))
        end
      end
    end
  end

  pfn parse_array_table_header(st) do
    -- Already consumed '[['
    match parse_key(st) do
    Err(e) -> Err(e)
    Ok(p) ->
      match p do
      (keys, st2) ->
        let st3 = skip_ws(st2)
        match expect_char(st3, "]") do
        Err(e) -> Err(e)
        Ok(st4) ->
          match expect_char(st4, "]") do
          Err(e) -> Err(e)
          Ok(st5) -> Ok((keys, st5))
          end
        end
      end
    end
  end

  -- Navigate to a path in root, returning the table pairs at that location
  pfn get_at_path(root, path) do
    match path do
    Nil -> Some(root)
    Cons(k, rest) ->
      match table_get(root, k) do
      Some(TTable(sub)) -> get_at_path(sub, rest)
      _ -> None
      end
    end
  end

  -- Insert a TTable at a path, creating intermediate tables
  pfn ensure_table_at_path(root, path) do
    match path do
    Nil -> root
    Cons(k, rest) ->
      let sub = match table_get(root, k) do
        Some(TTable(p)) -> p
        None -> Nil
        _ -> [("__toml_conflict__", TNull)]
        end
      if is_err_marker(sub) do sub
      else
        let sub2 = ensure_table_at_path(sub, rest)
        if is_err_marker(sub2) do sub2
        else table_put(root, k, TTable(sub2))
        end
      end
    end
  end

  -- Append a new table entry to an array-of-tables at path
  pfn append_aot(root, path) do
    match path do
    Nil -> root  -- shouldn't happen
    Cons(k, Nil) ->
      let existing = match table_get(root, k) do
        Some(TArray(a)) -> a
        None -> Nil
        _ -> Nil
        end
      table_put(root, k, TArray(List.append(existing, [TTable(Nil)])))
    Cons(k, rest) ->
      let sub = match table_get(root, k) do
        Some(TTable(p)) -> p
        None -> Nil
        _ -> Nil
        end
      let sub2 = append_aot(sub, rest)
      table_put(root, k, TTable(sub2))
    end
  end

  -- Update the last table in an array-of-tables
  pfn update_last_aot(root, path, new_pairs) do
    match path do
    Nil -> root
    Cons(k, Nil) ->
      match table_get(root, k) do
      Some(TArray(arr)) ->
        let rev = List.reverse(arr)
        let updated = match rev do
          Cons(_, rest) -> List.reverse(Cons(TTable(new_pairs), rest))
          Nil -> [TTable(new_pairs)]
          end
        table_put(root, k, TArray(updated))
      _ -> root
      end
    Cons(k, rest) ->
      let sub = match table_get(root, k) do
        Some(TTable(p)) -> p
        None -> Nil
        _ -> Nil
        end
      let sub2 = update_last_aot(sub, rest, new_pairs)
      table_put(root, k, TTable(sub2))
    end
  end

  pfn parse_document(st, root, current_path, aot_path) do
    let st1 = skip_ws_comments(st)
    if at_end(st1) do Ok(root)
    else
      let b = cur_byte(st1)
      if b == 91 do
        let st2 = advance(st1)
        if cur_byte(st2) == 91 do
          -- Array of tables [[...]]
          match parse_array_table_header(advance(st2)) do
          Err(e) -> Err(e)
          Ok((path, st3)) ->
            let root2 = append_aot(root, path)
            parse_document(st3, root2, path, path)
          end
        else
          -- Regular table [...]
          match parse_table_header(st2) do
          Err(e) -> Err(e)
          Ok((path, st3)) ->
            let root2 = ensure_table_at_path(root, path)
            if is_err_marker(root2) do
              err(st3, "type conflict at table header: " ++ String.join(path, "."))
            else parse_document(st3, root2, path, Nil)
            end
          end
        end
      else
        -- key = value
        match parse_keyval(st1, root, current_path) do
        Err(e) -> Err(e)
        Ok((new_root, st2)) ->
          let st3 = skip_ws_inline(st2)
          -- Expect end of line (newline or end of input)
          if at_end(st3) do Ok(new_root)
          else
            let b3 = cur_byte(st3)
            if b3 == 10 do parse_document(advance(st3), new_root, current_path, aot_path)
            else if b3 == 13 do
              let st4 = advance(st3)
              if cur_byte(st4) == 10 do parse_document(advance(st4), new_root, current_path, aot_path)
              else parse_document(st4, new_root, current_path, aot_path) end
            else if b3 == 35 do parse_document(skip_line(st3), new_root, current_path, aot_path)
            else err(st3, "unexpected '" ++ char1_at(st3) ++ "' after value")
            end end end
          end
        end
      end end
    end

  -- ── Public API ────────────────────────────────────────────────────────────

  doc """
  Parse a TOML document string. Returns Ok(TomlValue) on success or
  Err(TomlError(message, line, col)) on failure.

      Toml.parse("port = 8080")  -- Ok(TTable([("port", TInt(8080))]))
  """
  fn parse(src : String) : Result(TomlValue, TomlError) do
    let st = make_state(src)
    match parse_document(st, Nil, Nil, Nil) do
    Err(e) -> Err(e)
    Ok(pairs) -> Ok(TTable(List.reverse(pairs)))
    end
  end

  doc """
  Parse TOML, panicking on error. Useful for compile-time literals.
  """
  fn parse_exn(src : String) : TomlValue do
    match parse(src) do
    Ok(v) -> v
    Err(e) ->
      match e do
      TomlError(msg, line, col) ->
        panic("TOML parse error at " ++ int_to_string(line) ++ ":" ++ int_to_string(col) ++ ": " ++ msg)
      end
    end
  end

  doc """
  Convert a TomlValue to a string representation.
  """
  fn to_string(v : TomlValue) : String do
    match v do
    TStr(s)      -> "\"" ++ s ++ "\""
    TInt(n)      -> int_to_string(n)
    TFloat(f)    -> float_to_string(f)
    TBool(true)  -> "true"
    TBool(false) -> "false"
    TNull        -> "null"
    TDatetime(s) -> s
    TArray(xs)   -> "[" ++ String.join(List.map(xs, fn x -> to_string(x)), ", ") ++ "]"
    TTable(ps)   ->
      let pairs = List.map(ps, fn p -> match p do (k, v2) -> k ++ " = " ++ to_string(v2) end)
      "{ " ++ String.join(pairs, ", ") ++ " }"
    end
  end

  doc """
  Look up a top-level key in a TOML table value.

      Toml.get(table, "port")  -- Some(TInt(8080)) or None
  """
  fn get(v : TomlValue, key : String) : Option(TomlValue) do
    match v do
    TTable(pairs) -> table_get(pairs, key)
    _             -> None
    end
  end

  doc """
  Look up a nested key path.

      Toml.get_in(v, ["server", "host"])
  """
  fn get_in(v : TomlValue, keys : List(String)) : Option(TomlValue) do
    match keys do
    Nil -> Some(v)
    Cons(k, rest) ->
      match get(v, k) do
      None    -> None
      Some(v2) -> get_in(v2, rest)
      end
    end
  end

  doc "Get a string value by key, or None if absent or wrong type."
  fn get_str(v : TomlValue, key : String) : Option(String) do
    match get(v, key) do
    Some(TStr(s)) -> Some(s)
    _             -> None
    end
  end

  doc "Get an integer value by key, or None if absent or wrong type."
  fn get_int(v : TomlValue, key : String) : Option(Int) do
    match get(v, key) do
    Some(TInt(n)) -> Some(n)
    _             -> None
    end
  end

  doc "Get a float value by key, or None if absent or wrong type."
  fn get_float(v : TomlValue, key : String) : Option(Float) do
    match get(v, key) do
    Some(TFloat(f)) -> Some(f)
    _               -> None
    end
  end

  doc "Get a boolean value by key, or None if absent or wrong type."
  fn get_bool(v : TomlValue, key : String) : Option(Bool) do
    match get(v, key) do
    Some(TBool(b)) -> Some(b)
    _              -> None
    end
  end

  doc "Get a table value by key, or None if absent or wrong type."
  fn get_table(v : TomlValue, key : String) : Option(TomlValue) do
    match get(v, key) do
    Some(t) ->
      match t do
      TTable(_) -> Some(t)
      _         -> None
      end
    _ -> None
    end
  end

  doc "Get an array value by key, or None if absent or wrong type."
  fn get_array(v : TomlValue, key : String) : Option(List(TomlValue)) do
    match get(v, key) do
    Some(TArray(xs)) -> Some(xs)
    _                -> None
    end
  end

end
