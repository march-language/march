-- PeerRegistry: the net-kernel's one-connection-per-peer table.
--
-- After a successful handshake, a peer is registered under its NodeId along
-- with the socket fd of its connection. Re-registering the same NodeId
-- replaces the prior entry (the newer connection wins) — so there is at most
-- one live connection per peer, the invariant the L2 net-kernel maintains.
mod PeerRegistry do

  -- `fd` is the CONTROL connection; `data_fd` the data one, -1 until it is
  -- up (a pre-split peer never opens one). See the control/data split in
  -- specs/progress/2026-09-14-distributed-plane-flow-control-and-control-channel.md.
  type Peer = { node_id : String, identity : NodeIdentity.Identity, fd : Int, data_fd : Int }

  doc """
  The sentinel fd (-1) meaning "no connection", used for `data_fd` until a peer's data connection is up.
  """
  fn no_fd() : Int do -1 end

  type Registry = Registry(Map(String, Peer))

  doc "An empty peer table."
  fn empty() : Registry do Registry(Map.empty()) end

  doc "The number of registered peers."
  fn size(reg : Registry) : Int do
    match reg do Registry(m) -> Map.size(m) end
  end

  doc "Register [peer] under its node_id, replacing any existing entry for that node (the newer connection wins)."
  fn add(reg : Registry, peer : Peer) : Registry do
    match reg do
      Registry(m) -> Registry(Map.insert(m, peer.node_id, peer, Map.str_cmp))
    end
  end

  doc """
  Attach the data connection [data_fd] to the already-registered peer
  [node_id], replacing any previous data fd. Returns `Err` if [node_id] is
  not registered.
  """
  fn add_data(reg : Registry, node_id : String, data_fd : Int) : Result(Registry, String) do
    match lookup(reg, node_id) do
      None -> Err("PeerRegistry: data connection for unknown peer " ++ node_id)
      Some(p) -> Ok(add(reg, { p with data_fd: data_fd }))
    end
  end

  doc "Whether [p] has a data connection (its `data_fd` is not `no_fd()`)."
  fn has_data(p : Peer) : Bool do p.data_fd != no_fd() end

  doc "The peer registered under [node_id], or `None`."
  fn lookup(reg : Registry, node_id : String) : Option(Peer) do
    match reg do Registry(m) -> Map.get(m, node_id, Map.str_cmp) end
  end

  doc "Whether a peer is registered under [node_id]."
  fn contains(reg : Registry, node_id : String) : Bool do
    match reg do Registry(m) -> Map.contains_key(m, node_id, Map.str_cmp) end
  end

  doc "Drop the entry for [node_id]; the table is unchanged if it has none. The connections are not closed."
  fn remove(reg : Registry, node_id : String) : Registry do
    match reg do Registry(m) -> Registry(Map.remove(m, node_id, Map.str_cmp)) end
  end

  doc "Every registered peer, in unspecified order."
  fn peers(reg : Registry) : List(Peer) do
    match reg do Registry(m) -> Map.values(m) end
  end

end
