-- URI module: URL/URI parsing, encoding, and query-string manipulation.
--
-- Types:
--   URI(scheme, host, port, path, query, fragment)
--     scheme   -- e.g. "https", "http", "" if absent
--     host     -- e.g. "example.com"
--     port     -- Some(443) or None
--     path     -- e.g. "/api/users" (includes leading /)
--     query    -- raw query string e.g. "q=hello&page=2"
--     fragment -- fragment identifier e.g. "section-1"
--
-- Percent-encoding follows RFC 3986: unreserved chars (A-Z a-z 0-9 - _ . ~)
-- are left as-is; all other bytes are encoded as %XX (uppercase hex).
--
-- encode_query / decode_query work with List((String, String)) association
-- lists (not Map) so this module has no stdlib dependencies.
--
-- doc: try

mod Uri do

  type URI = URI(String, String, Option(Int), String, String, String)

  -- ── Private helpers ───────────────────────────────────────────────────────

  pfn rev_list(xs) do
    fn go(lst, acc) do
      match lst do
      Nil -> acc
      Cons(h, t) -> go(t, Cons(h, acc))
      end
    end
    go(xs, Nil)
  end

  -- Is the given byte value an unreserved URI character?
  -- Unreserved: A-Z (65-90), a-z (97-122), 0-9 (48-57), - (45), _ (95), . (46), ~ (126)
  pfn is_unreserved(code) do
    (code >= 65 && code <= 90)  ||
    (code >= 97 && code <= 122) ||
    (code >= 48 && code <= 57)  ||
    code == 45 || code == 95 || code == 46 || code == 126
  end

  -- Upper-case hex character for nibble n (0–15).
  pfn hex_nibble(n) do
    if n < 10 do int_to_string(n)
    else char_from_int(55 + n)  -- 'A' = 65; 65 - 10 = 55
    end
  end

  -- Percent-encode a single byte value.
  pfn percent_encode_byte(code) do
    "%" ++ hex_nibble(code / 16) ++ hex_nibble(code % 16)
  end

  -- Decode a hex digit BYTE VALUE (as from string_byte_at, not a char) to
  -- its numeric value 0–15. Returns -1 on bad input (including -1 itself,
  -- string_byte_at's past-the-end sentinel).
  pfn hex_digit_val(code) do
    if code >= 48 && code <= 57 do code - 48         -- '0'–'9'
    else if code >= 65 && code <= 70 do code - 55    -- 'A'–'F'
    else if code >= 97 && code <= 102 do code - 87   -- 'a'–'f'
    else -1 end end end
  end

  -- A candidate scheme (the text before "://"): non-empty, and free of the
  -- characters that end a scheme -- '/', '?', '#'.
  pfn is_scheme(sch) do
    not (string_is_empty(sch)) &&
    not (string_contains(sch, "/")) &&
    not (string_contains(sch, "?")) &&
    not (string_contains(sch, "#"))
  end

  -- A scheme-less reference: (scheme, rest, has_authority). A leading "//"
  -- introduces an authority (network-path reference); anything else is a
  -- path (RFC 3986 §4.2).
  pfn no_scheme_split(s) do
    if string_starts_with(s, "//") do
      ("", string_slice(s, 2, string_byte_length(s) - 2), true)
    else ("", s, false) end
  end

  -- RFC 3986 §5.2.4 remove_dot_segments over a whole path. Returns
  -- (path, escaped): `escaped` is true when a ".." had nothing left to pop,
  -- i.e. the path tried to climb above its root. Such a ".." is dropped,
  -- as the RFC does. An absolute input keeps its leading "/": the empty
  -- string before it is the root marker, NOT a segment a ".." may pop.
  -- A trailing "." or ".." leaves a trailing "/" ("/a/b/.." is "/a/").
  pfn remove_dot_segments(path) do
    let absolute = string_starts_with(path, "/")
    let segs = match string_split(path, "/") do
      Cons(first, rest) -> if absolute do rest else Cons(first, rest) end
      Nil -> Nil
      end
    fn go(xs, acc, escaped) do
      match xs do
      Nil -> (acc, escaped)
      Cons(seg, rest) ->
        let dir_end = match rest do
          Nil -> true
          _   -> false
          end
        if seg == "." do
          go(rest, if dir_end do Cons("", acc) else acc end, escaped)
        else if seg == ".." do
          let (popped, esc) = match acc do
            Nil           -> (Nil, true)
            Cons(_, prev) -> (prev, escaped)
            end
          go(rest, if dir_end do Cons("", popped) else popped end, esc)
        else go(rest, Cons(seg, acc), escaped)
        end end
      end
    end
    let (rev_segs, escaped) = go(segs, Nil, false)
    let joined = string_join(rev_list(rev_segs), "/")
    (if absolute do "/" ++ joined else joined end, escaped)
  end

  -- RFC 3986 §5.2.3 merge: the base path's directory joined with a
  -- relative-path reference. A base with an authority and an empty path
  -- merges as "/" ++ rpath.
  pfn merge_paths(base_has_authority, bpath, rpath) do
    if base_has_authority && string_is_empty(bpath) do "/" ++ rpath
    else
      match string_last_index_of(bpath, "/") do
      Some(i) -> string_slice(bpath, 0, i + 1) ++ rpath
      None    -> rpath
      end
    end
  end

  -- RFC 3986 §5.2.2 reference resolution, shared by `merge` and
  -- `merge_strict`: (target URI, escaped). `escaped` is remove_dot_segments'
  -- flag for the target path.
  pfn resolve_reference(base, relative) do
    match (base, relative) do
    (URI(bs, bh, bp, bpath, bq, _), URI(rs, rh, rp, rpath, rq, rf)) ->
      if not (string_is_empty(rs)) do
        -- Absolute reference: everything from the relative
        let (p, esc) = remove_dot_segments(rpath)
        (URI(rs, rh, rp, p, rq, rf), esc)
      else if not (string_is_empty(rh)) do
        -- Network-path reference: base scheme, the rest from the relative
        let (p, esc) = remove_dot_segments(rpath)
        (URI(bs, rh, rp, p, rq, rf), esc)
      else if string_is_empty(rpath) do
        -- Same-document / query-only reference: base path, and the base
        -- query unless the relative has one
        let q = if string_is_empty(rq) do bq else rq end
        (URI(bs, bh, bp, bpath, q, rf), false)
      else do
        let target = if string_starts_with(rpath, "/") do rpath
                     else merge_paths(not (string_is_empty(bh)), bpath, rpath) end
        let (p, esc) = remove_dot_segments(target)
        (URI(bs, bh, bp, p, rq, rf), esc)
      end end end end
    end
  end

  -- ── Public API ────────────────────────────────────────────────────────────

  doc """
  Parse a URI string into its components, per RFC 3986 §3 / §4.2.

      march> Uri.parse("https://example.com:8080/api/users?q=hello#top")
      URI("https", "example.com", Some(8080), "/api/users", "q=hello", "top")
      march> Uri.parse("http://localhost/path")
      URI("http", "localhost", None, "/path", "", "")
      march> Uri.parse("/relative/path?foo=bar")
      URI("", "", None, "/relative/path", "foo=bar", "")

  Relative references (no scheme) are supported.  Only `//` introduces an
  authority: a network-path reference (`//host/path`) has a host and
  port, while a relative-path reference (`../d`, `a/b`) and an
  absolute-path reference (`/a/b`) have an empty host and port `None`,
  and the whole string before any `?` or `#` is the path:

      march> Uri.parse("../d")
      URI("", "", None, "../d", "", "")
      march> Uri.parse("//other.com:81/x")
      URI("", "other.com", Some(81), "/x", "", "")
      march> Uri.parse("a/b?q=1")
      URI("", "", None, "a/b", "q=1", "")

  A scheme is recognised only before a `://` with no `/`, `?` or `#`
  ahead of it, so `/go?to=http://x` is a path with a query.
  """
  fn parse(s) do
    -- Split off the scheme and say whether an authority follows. A scheme
    -- is the text before the first "://" provided it contains no '/', '?'
    -- or '#' (otherwise the "://" sits inside a path or query). Without a
    -- scheme, only a leading "//" introduces an authority (RFC 3986 §4.2):
    -- every other scheme-less string is a path.
    let (scheme, rest1, has_authority) = match string_split_first(s, "://") do
      Some((sch, rest)) ->
        if is_scheme(sch) do (sch, rest, true)
        else no_scheme_split(s) end
      None -> no_scheme_split(s)
      end
    -- Extract fragment (after "#")
    let (rest2, fragment) = match string_split_first(rest1, "#") do
      Some((r, frag)) -> (r, frag)
      None -> (rest1, "")
      end
    -- Extract query (after "?")
    let (rest3, raw_query) = match string_split_first(rest2, "?") do
      Some((r, q)) -> (r, q)
      None -> (rest2, "")
      end
    -- Extract authority (host:port) and path (split on first "/")
    let (authority, path) =
      if has_authority do
        match string_split_first(rest3, "/") do
        Some((auth, p)) -> (auth, "/" ++ p)
        None -> (rest3, "")
        end
      else ("", rest3) end
    -- Parse host and optional port from authority
    let (host, port) = match string_split_first(authority, ":") do
      Some((h, p_str)) ->
        match string_to_int(p_str) do
        Some(p) -> (h, Some(p))
        None    -> (authority, None)
        end
      None -> (authority, None)
      end
    URI(scheme, host, port, path, raw_query, fragment)
  end

  doc """
  Convert a URI back to its string representation.

      march> Uri.to_string(URI("https", "example.com", None, "/path", "q=1", "top"))
      "https://example.com/path?q=1#top"
      march> Uri.to_string(URI("http", "localhost", Some(4000), "/", "", ""))
      "http://localhost:4000/"
      march> Uri.to_string(Uri.parse("//other.com/x"))
      "//other.com/x"
  """
  fn to_string(uri) do
    match uri do
    URI(scheme, host, port, path, query, fragment) ->
      -- A scheme is followed by "://"; a scheme-less reference with a
      -- host is a network-path reference and keeps its "//".
      let scheme_part =
        if not (string_is_empty(scheme)) do scheme ++ "://"
        else if not (string_is_empty(host)) do "//"
        else "" end end
      let port_part = match port do
        None    -> ""
        Some(p) -> ":" ++ int_to_string(p)
        end
      let query_part =
        if string_is_empty(query) do ""
        else "?" ++ query end
      let frag_part =
        if string_is_empty(fragment) do ""
        else "#" ++ fragment end
      scheme_part ++ host ++ port_part ++ path ++ query_part ++ frag_part
    end
  end

  doc """
  Percent-encode a string for safe use in a URI component.

  Unreserved characters (A–Z, a–z, 0–9, -, _, ., ~) are left unchanged;
  all other bytes are encoded as %XX (uppercase hex).

      march> Uri.encode("hello world")
      "hello%20world"
      march> Uri.encode("foo=bar&baz")
      "foo%3Dbar%26baz"
      march> Uri.encode("café")
      "caf%C3%A9"
  """
  fn encode(s) do
    let len = string_length(s)
    -- Byte-index cursor: `start` marks the beginning of the current run of
    -- unreserved bytes that can be sliced out in one call. `acc` holds
    -- already-materialised segments (newest first). The common case — a
    -- string with no bytes needing escaping — reaches the end with `acc`
    -- still Nil and returns a single slice of the whole string.
    fn scan(i, start, acc) do
      if i >= len do
        match acc do
        Nil -> string_slice(s, start, i - start)
        _ ->
          let acc2 = if i > start do Cons(string_slice(s, start, i - start), acc) else acc end
          string_join(rev_list(acc2), "")
        end
      else do
        let code = string_byte_at(s, i)
        if is_unreserved(code) do scan(i + 1, start, acc)
        else do
          let acc2 = if i > start do Cons(string_slice(s, start, i - start), acc) else acc end
          scan(i + 1, i + 1, Cons(percent_encode_byte(code), acc2))
        end
        end
      end
      end
    end
    scan(0, 0, Nil)
  end

  -- Shared byte-index scanner for percent-decoding. `start` marks the
  -- beginning of the current un-escaped run; `acc` holds already-materialised
  -- segments (newest first). The common case — no %XX escapes and (when
  -- `plus_is_space` is false) no '+' — reaches the end with `acc` still Nil
  -- and returns a single slice of the whole string, exactly like `encode`
  -- above and `Json.scan_string`.
  --
  -- `plus_is_space` lets `decode_query` fold the "+" == space convention
  -- into the same single pass instead of pre-processing the string with
  -- string_replace_all before decoding it.
  pfn decode_scan(s, len, i, start, acc, plus_is_space) do
    if i >= len do
      match acc do
      Nil -> string_slice(s, start, i - start)
      _ ->
        let acc2 = if i > start do Cons(string_slice(s, start, i - start), acc) else acc end
        string_join(rev_list(acc2), "")
      end
    else do
      let c = string_byte_at(s, i)
      if c == 37 do -- '%'
        let hi = string_byte_at(s, i + 1)
        let lo = string_byte_at(s, i + 2)
        let h = hex_digit_val(hi)
        let l = hex_digit_val(lo)
        if h >= 0 && l >= 0 do
          let acc2 = if i > start do Cons(string_slice(s, start, i - start), acc) else acc end
          let byte_val = h * 16 + l
          decode_scan(s, len, i + 3, i + 3, Cons(char_from_int(byte_val), acc2), plus_is_space)
        else
          decode_scan(s, len, i + 1, start, acc, plus_is_space)
        end
      else if plus_is_space && c == 43 do -- '+'
        let acc2 = if i > start do Cons(string_slice(s, start, i - start), acc) else acc end
        decode_scan(s, len, i + 1, i + 1, Cons(" ", acc2), plus_is_space)
      else
        decode_scan(s, len, i + 1, start, acc, plus_is_space)
      end
      end
    end
    end
  end

  doc """
  Percent-decode a URI component.

  %XX sequences are decoded to their byte values; + is left unchanged
  (use decode_query for form-encoded values where + means space).

      march> Uri.decode("hello%20world")
      "hello world"
      march> Uri.decode("caf%C3%A9") == "café"  -- the REPL prints non-ASCII bytes escaped
      true
      march> Uri.decode("no-encoding")
      "no-encoding"
  """
  fn decode(s) do
    decode_scan(s, string_length(s), 0, 0, Nil, false)
  end

  doc """
  Encode a list of key-value pairs as a URL query string.

  Keys and values are percent-encoded; pairs are joined with "&".

      march> Uri.encode_query([("q", "hello world"), ("page", "2")])
      "q=hello%20world&page=2"
      march> Uri.encode_query([])
      ""
  """
  fn encode_query(pairs) do
    fn encode_pair(kv) do
      match kv do
      (k, v) -> encode(k) ++ "=" ++ encode(v)
      end
    end
    fn go(ps, acc) do
      match ps do
      Nil -> string_join(rev_list(acc), "&")
      Cons(p, rest) -> go(rest, Cons(encode_pair(p), acc))
      end
    end
    go(pairs, Nil)
  end

  doc """
  Decode a URL query string into a list of key-value pairs.

  Percent-encoded sequences are decoded; "+" is treated as a space
  (application/x-www-form-urlencoded convention).

      march> Uri.decode_query("q=hello+world&page=2")
      [("q", "hello world"), ("page", "2")]
      march> Uri.decode_query("")
      []
  """
  fn decode_query(s) do
    if string_is_empty(s) do Nil
    else
      let pairs = string_split(s, "&")
      fn decode_plus(t) do
        decode_scan(t, string_length(t), 0, 0, Nil, true)
      end
      fn go(ps, acc) do
        match ps do
        Nil -> rev_list(acc)
        Cons(pair, rest) ->
          match string_split_first(pair, "=") do
          Some((k, v)) -> go(rest, Cons((decode_plus(k), decode_plus(v)), acc))
          None         -> go(rest, Cons((decode_plus(pair), ""), acc))
          end
        end
      end
      go(pairs, Nil)
    end
  end

  doc """
  Resolve a relative URI reference against a base URI per RFC 3986 §5.2.

  - If the relative URI has a scheme, it is used as-is (absolute
    reference), with its dot segments removed.
  - If it has an authority (host), the base scheme is kept and the
    rest comes from the relative.
  - Empty relative path → keep the base path; the query comes from the
    relative if it has one, else from the base; the fragment always
    comes from the relative.
  - Absolute relative path (starts with `/`) → replace the base path.
  - Otherwise → merge with the base path's directory (§5.2.3).

  In every case with a path, dot segments are removed per §5.2.4
  ("Remove Dot Segments"), and an absolute path keeps its leading `/`.

  A `..` that would climb above the root is dropped, as the RFC
  specifies, so `../../../x` against `/a/b/c` resolves to `/x`, the
  same as `../../x`.  Use `merge_strict` if you need to *detect* such
  over-traversal.

      march> Uri.to_string(Uri.merge(Uri.parse("https://example.com/a/b/c"), Uri.parse("../d")))
      "https://example.com/a/d"
      march> Uri.to_string(Uri.merge(Uri.parse("https://example.com/a/b/c"), Uri.parse("//other.com/x")))
      "https://other.com/x"
      march> Uri.to_string(Uri.merge(Uri.parse("https://example.com/a/b/c"), Uri.parse("/x?y=1")))
      "https://example.com/x?y=1"
      march> Uri.to_string(Uri.merge(Uri.parse("https://example.com/a/b/c"), Uri.parse("../../../x")))
      "https://example.com/x"
      march> Uri.to_string(Uri.merge(Uri.parse("https://example.com/a/b/c"), Uri.parse("./")))
      "https://example.com/a/b/"
  """
  fn merge(base, relative) do
    match resolve_reference(base, relative) do
    (target, _) -> target
    end
  end

  doc """
  Like `merge`, but returns `Err("...")` if the resolved path would
  escape "above" the root of the path it is resolved into — that is, if
  any `..` segment has no segment left to remove.  Useful when the
  relative reference comes from untrusted input and you want to reject
  directory-traversal attempts rather than silently absorb them.

  Against `/a/b/c` (directory `/a/b/`), `../../x` reaches the root and is
  allowed; a third `..` climbs above it and is rejected:

      march> Uri.merge_strict(Uri.parse("https://example.com/a/b/c"), Uri.parse("../d"))
      Ok(URI("https", "example.com", None, "/a/d", "", ""))
      march> Uri.merge_strict(Uri.parse("https://example.com/a/b/c"), Uri.parse("../../etc/passwd"))
      Ok(URI("https", "example.com", None, "/etc/passwd", "", ""))
      march> Uri.merge_strict(Uri.parse("https://example.com/a/b/c"), Uri.parse("../../../etc/passwd"))
      Err("Uri.merge_strict: relative reference traverses above base")
      march> Uri.merge_strict(Uri.parse("https://example.com/a/b/c"), Uri.parse("/../etc/passwd"))
      Err("Uri.merge_strict: relative reference traverses above base")
  """
  fn merge_strict(base, relative) do
    match resolve_reference(base, relative) do
    (_, true)       -> Err("Uri.merge_strict: relative reference traverses above base")
    (target, false) -> Ok(target)
    end
  end

  -- ── Field accessors ───────────────────────────────────────────────────────

  doc "Extract the scheme component (e.g. \"https\")."
  fn scheme(uri) do
    match uri do URI(s, _, _, _, _, _) -> s end
  end

  doc "Extract the host component (e.g. \"example.com\")."
  fn host(uri) do
    match uri do URI(_, h, _, _, _, _) -> h end
  end

  doc "Extract the port as Some(n) or None."
  fn port(uri) do
    match uri do URI(_, _, p, _, _, _) -> p end
  end

  doc "Extract the path component (e.g. \"/api/users\")."
  fn path(uri) do
    match uri do URI(_, _, _, p, _, _) -> p end
  end

  doc "Extract the raw query string (e.g. \"q=hello&page=2\")."
  fn query(uri) do
    match uri do URI(_, _, _, _, q, _) -> q end
  end

  doc "Extract the fragment identifier (e.g. \"section-1\")."
  fn fragment(uri) do
    match uri do URI(_, _, _, _, _, f) -> f end
  end

end
