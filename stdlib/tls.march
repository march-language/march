-- stdlib/tls.march — TLS (Transport Layer Security) support for March.
--
-- Wraps OpenSSL 3 via C builtins to provide TLS client and server
-- functionality over existing TCP file descriptors.
--
-- Architecture:
--   TlsCtx  — an SSL_CTX (configuration + CA store), long-lived, shareable
--   TlsConn — a single SSL * connection over one TCP socket, which it owns
--
-- Both are opaque handles (ocap phase 2): they cannot be built from an
-- integer, and a use after `close` / `ctx_free` is `Err(TlsError.Closed)`. A
-- successful `connect` / `accept` takes the `Socket` over: closing the
-- `TlsConn` closes the TCP connection too, and the `Socket` itself reports
-- `Err(TlsError.Closed)` from then on.
--
-- Typical client usage:
--   let config = Tls.default_client_config()
--   match Tls.client_ctx(config) do
--   Ok(ctx) ->
--     match Socket.connect("example.com", 443) do
--     Ok(s) ->
--       -- Bound reads against a peer that accepts and then goes silent.
--       -- Must be set BEFORE the handshake to bound the handshake too.
--       Socket.set_recv_timeout(s, 30000)
--       match Tls.connect(s, ctx, "example.com") do
--       Ok(conn) ->
--         Tls.write(conn, "GET / HTTP/1.1\r\nHost: example.com\r\n\r\n")
--         Tls.read(conn, 4096)
--         Tls.close(conn)
--       Err(e) ->
--         Socket.close(s)
--         Err(e)
--       end
--     Err(e) -> Err(TlsHandshakeFailed(Socket.error_message(e)))
--     end
--   Err(e) -> Err(e)
--   end

mod Tls do
  needs IO.NetConnect.TLS

  -- TlsVersion: minimum accepted TLS protocol version
  type TlsVersion = Tls12 | Tls13

  -- TlsError: all failure modes for TLS operations
  type TlsError =
    TlsHandshakeFailed(String)
    | TlsCertError(String)
    | TlsReadError(String)
    | TlsWriteError(String)
    | TlsContextError(String)
    -- A read deadline expired with the peer still silent.  Distinct from
    -- TlsReadError because only one of the two says anything about the peer:
    -- OpenSSL reports both an expired SO_RCVTIMEO and a connection reset as
    -- SSL_ERROR_SYSCALL, and a caller that cannot tell them apart cannot say
    -- why a stream ended.
    | TlsReadTimeout
    -- The connection or context was closed (`close`, `ctx_free`) before or
    -- during this use.
    | Closed

  -- TlsConfig: configuration for creating a TLS context
  --
  -- Fields:
  --   cert_file    — path to PEM certificate (chain); "" for client-only ctx
  --   key_file     — path to PEM private key; "" for client-only ctx
  --   ca_file      — path to PEM CA bundle; "" → system/default roots
  --   alpn         — ALPN protocol list, e.g. ["h2", "http/1.1"]
  --   min_version  — minimum TLS version (Tls12 or Tls13)
  --   verify_peer  — true → verify the server cert against ca_file (or the
  --                  system roots); false → SSL_VERIFY_NONE (client ctx only;
  --                  server_ctx ignores it)
  type TlsConfig =
    TlsConfig(
      String,
      String,
      String,
      List(String),
      TlsVersion,
      Bool
    )

  -- TlsCtx: opaque TLS context handle, a handle box of kind TLS_CTX over
  -- an SSL_CTX *.
  opaque type TlsCtx = TlsCtx(Socket)

  -- TlsConn: opaque TLS connection handle, a handle box of kind TLS over an
  -- SSL *, with the TCP fd it owns as the box's aux (runtime/march_handle.c
  -- releases both).
  opaque type TlsConn = TlsConn(Socket)

  -- MARCH_HANDLE_* (runtime/march_runtime.h).
  pfn kind_tcp() : Int do 3 end
  pfn kind_tls() : Int do 7 end
  pfn kind_tls_ctx() : Int do 8 end

  pfn new_ctx(h : Int) : TlsCtx do
    let b : Socket = handle_new(kind_tls_ctx(), h, 0)
    TlsCtx(b)
  end

  -- Run f on the SSL * inside conn, or Err(TlsError.Closed). A failure that came
  -- from another task closing conn meanwhile is Err(TlsError.Closed) too.
  pfn with_conn(conn : TlsConn, f : Int -> Result(a, TlsError)) : Result(a, TlsError) do
    match conn do
    TlsConn(b) ->
      let h = handle_enter(b, kind_tls())
      if h == -1 do Err(TlsError.Closed) else
        let r = f(h)
        handle_leave(b)
        match r do
        Err(_) -> if handle_is_closed(b) do Err(TlsError.Closed) else r end
        Ok(_) -> r
        end
      end
    end
  end

  pfn with_ctx(ctx : TlsCtx, f : Int -> Result(a, TlsError)) : Result(a, TlsError) do
    match ctx do
    TlsCtx(b) ->
      let h = handle_enter(b, kind_tls_ctx())
      if h == -1 do Err(TlsError.Closed) else
        let r = f(h)
        handle_leave(b)
        r
      end
    end
  end

  -- The handshake shared by connect and accept: run it on the fd inside s
  -- with the SSL_CTX * inside ctx. On success the new TlsConn takes the fd
  -- over: s is detached (closed without closing the fd) and the fd becomes
  -- the TLS box's aux. On failure s is left open and the caller's.
  pfn handshake(s : Socket, ctx : TlsCtx, run) : Result(TlsConn, TlsError) do
    with_ctx(ctx, fn h ->
      let fd = handle_enter(s, kind_tcp())
      if fd == -1 do Err(TlsError.Closed) else
        match run(fd, h) do
        Err(msg) ->
          handle_leave(s)
          if handle_is_closed(s) do Err(TlsError.Closed) else Err(TlsHandshakeFailed(msg)) end
        Ok(ssl) ->
          -- Detach while still in flight, so no concurrent close can release
          -- the fd between the handshake and the hand-over.
          let raw = handle_detach(s)
          handle_leave(s)
          if raw == -1 do
            -- s was closed during the handshake; its release closes the fd.
            tls_close(ssl)
            Err(TlsError.Closed)
          else
            let b : Socket = handle_new(kind_tls(), ssl, raw)
            Ok(TlsConn(b))
          end
        end
      end)
  end

  -- ── Config accessors ──────────────────────────────────────────────────

  doc "Path to the PEM certificate (chain) of a TlsConfig; empty for a client-only config."
  fn cert_file(c) do
    match c do TlsConfig(cert, _, _, _, _, _) -> cert end
  end

  doc "Path to the PEM private key of a TlsConfig; empty for a client-only config."
  fn key_file(c) do
    match c do TlsConfig(_, key, _, _, _, _) -> key end
  end

  doc "Path to the PEM CA bundle of a TlsConfig; empty means the system default roots."
  fn ca_file(c) do
    match c do TlsConfig(_, _, ca, _, _, _) -> ca end
  end

  doc "The ALPN protocol list offered by a TlsConfig, in preference order."
  fn alpn(c) do
    match c do TlsConfig(_, _, _, a, _, _) -> a end
  end

  doc "The minimum accepted TLS version (`Tls12` or `Tls13`) of a TlsConfig."
  fn min_version(c) do
    match c do TlsConfig(_, _, _, _, v, _) -> v end
  end

  doc "Whether a client context built from this TlsConfig verifies the server certificate."
  fn verify_peer(c) do
    match c do TlsConfig(_, _, _, _, _, vp) -> vp end
  end

  -- ── Default configs ───────────────────────────────────────────────────

  doc """
  Default client configuration: verify the server cert against the system
  roots, TLS 1.2+, HTTP/1.1 ALPN, no client certificate.

  ## Examples

      Tls.verify_peer(Tls.default_client_config())   -- true
      Tls.alpn(Tls.default_client_config())          -- ["http/1.1"]
  """
  fn default_client_config() do
    TlsConfig("", "", "", ["http/1.1"], Tls12, true)
  end

  doc """
  Client config for HTTPS offering ALPN `["h2", "http/1.1"]`; otherwise the
  same as `default_client_config` (verify peer, TLS 1.2+). Check
  `negotiated_alpn` after the handshake to see which one the server chose.
  """
  fn h2_client_config() do
    TlsConfig("", "", "", ["h2", "http/1.1"], Tls12, true)
  end

  doc """
  Server configuration with a PEM cert+key and no client-cert verification:
  HTTP/1.1 ALPN, TLS 1.2+, empty `ca_file`. The files are only read by
  `server_ctx`.

  ## Examples

      let config = Tls.server_config("/etc/ssl/server.pem", "/etc/ssl/server.key")
  """
  fn server_config(cert_path, key_path) do
    TlsConfig(cert_path, key_path, "", ["http/1.1"], Tls12, false)
  end

  -- ── TlsVersion helpers ────────────────────────────────────────────────

  doc """
  Convert a TlsVersion to a human-readable string.

  ## Examples

      Tls.version_to_string(Tls12)   -- "TLS 1.2"
      Tls.version_to_string(Tls13)   -- "TLS 1.3"
  """
  fn version_to_string(v) do
    match v do
    Tls12 -> "TLS 1.2"
    Tls13 -> "TLS 1.3"
    end
  end

  doc "The runtime's encoding of a TlsVersion: 0 for `Tls12`, 1 for `Tls13`."
  fn version_to_int(v) do
    match v do
    Tls12 -> 0
    Tls13 -> 1
    end
  end

  -- ── Context creation ──────────────────────────────────────────────────

  doc """
  Create a client-side TLS context from a TlsConfig (uses `ca_file`, `alpn`,
  `min_version`, `verify_peer`; the cert/key fields are ignored).
  Returns `Ok(TlsCtx)` or `Err(TlsContextError(msg))`, e.g. when the CA file
  cannot be loaded. The ctx can be shared across many connections
  (thread-safe); release it with `ctx_free`.

  ## Examples

      match Tls.client_ctx(Tls.default_client_config()) do
        Ok(ctx) -> use_ctx(ctx)
        Err(e) -> println(Tls.error_to_string(e))
      end
  """
  fn client_ctx(config) do
    let ca    = ca_file(config)
    let a     = alpn(config)
    let ver   = version_to_int(min_version(config))
    let vp    = if verify_peer(config) do 1 else 0 end
    match tls_client_ctx(ca, a, ver, vp) do
    Err(msg) -> Err(TlsContextError(msg))
    Ok(h)    -> Ok(new_ctx(h))
    end
  end

  doc """
  Create a server-side TLS context from a TlsConfig.
  cert_file and key_file must be non-empty PEM paths. `verify_peer` is not
  used. Returns `Ok(TlsCtx)` or `Err(TlsContextError(msg))` (missing or
  mismatched cert/key, bad CA file).

  ## Examples

      let ctx = Result.unwrap(Tls.server_ctx(Tls.server_config("cert.pem", "key.pem")))
  """
  fn server_ctx(config) do
    let cert  = cert_file(config)
    let key   = key_file(config)
    let ca    = ca_file(config)
    let a     = alpn(config)
    let ver   = version_to_int(min_version(config))
    match tls_server_ctx(cert, key, ca, a, ver) do
    Err(msg) -> Err(TlsContextError(msg))
    Ok(h)    -> Ok(new_ctx(h))
    end
  end

  -- ── Handshake ─────────────────────────────────────────────────────────

  doc """
  Perform a TLS client handshake on a connected `Socket`.
  `hostname` is used for SNI and certificate hostname verification.
  Returns `Ok(TlsConn)` or `Err(TlsHandshakeFailed(msg))` (including
  certificate verification failures).

  On success the `TlsConn` owns the TCP connection: `Tls.close(conn)`
  closes both, and `s` is closed (its uses return `Err(TlsError.Closed)`). On
  failure `s` stays open and is still the caller's to close.

  ## Examples

      match Tls.connect(s, ctx, "example.com") do
        Ok(conn) -> Tls.write(conn, request)
        Err(e) ->
          Socket.close(s)
          Err(e)
      end
  """
  fn connect(s : Socket, ctx : TlsCtx, hostname : String) : Result(TlsConn, TlsError) do
    handshake(s, ctx, fn (fd, h) -> tls_connect(fd, h, hostname))
  end

  doc """
  Perform a TLS server handshake on an accepted `Socket` with a context from
  `server_ctx`. Returns `Ok(TlsConn)` or `Err(TlsHandshakeFailed(msg))`.
  As with `connect`, a successful handshake hands `s` over to the
  `TlsConn`; on failure `s` stays open and the caller's.
  """
  fn accept(s : Socket, ctx : TlsCtx) : Result(TlsConn, TlsError) do
    handshake(s, ctx, fn (fd, h) -> tls_accept(fd, h))
  end

  -- ── I/O ───────────────────────────────────────────────────────────────

  doc """
  Read up to max_bytes from a TLS connection.
  Returns Ok(String) or Err(TlsError). Ok("") signals a clean shutdown.

  This read has no deadline of its own and will wait indefinitely for a peer
  that has gone silent.  To bound it, call Socket.set_recv_timeout(s, ms) on
  the underlying socket BEFORE Tls.connect -- SO_RCVTIMEO is the only mechanism
  that reaches a read made through OpenSSL, and setting it before the
  handshake bounds the handshake too.  A deadline that fires part-way through
  a TLS record leaves the session unusable, so treat an expired read as
  "close the connection", not as something to retry.

  When that deadline expires this returns Err(TlsReadTimeout), which is a
  different fact from Err(TlsReadError(...)) -- the peer was silent, rather
  than the connection failing.  Both still mean close it.
  """
  fn read(conn : TlsConn, max_bytes : Int) : Result(String, TlsError) do
    with_conn(conn, fn h ->
      match tls_read(h, max_bytes) do
      -- "recv: timed out" is the runtime's one spelling of an expired
      -- deadline (MARCH_RECV_TIMEOUT_MSG), matched exactly here the way
      -- Socket.recv_timeout matches it.
      Err(msg) -> if msg == "recv: timed out" do Err(TlsReadTimeout) else Err(TlsReadError(msg)) end
      Ok(data) -> Ok(data)
      end)
  end

  doc """
  Read up to max_bytes from a TLS connection, waiting at most timeout_ms.

  `Ok(None)` is the cap expiring with nothing readable — the absence of an
  event, not a broken connection. `Ok(Some(""))` signals a clean shutdown,
  exactly as `read` does. Other failures are `Err(TlsReadError(msg))`.

  ## Examples

      match Tls.read_timeout(conn, 4096, 1000) do
        Ok(Some(data)) -> handle(data)
        Ok(None) -> keep_waiting()
        Err(e) -> Tls.close(conn)
      end
  """
  fn read_timeout(conn : TlsConn, max_bytes : Int, timeout_ms : Int) : Result(Option(String), TlsError) do
    with_conn(conn, fn h ->
      match tls_read_timeout(h, max_bytes, timeout_ms) do
      Err(msg) -> Err(TlsReadError(msg))
      Ok(data) -> Ok(data)
      end)
  end

  doc """
  Write data to a TLS connection.
  Returns `Ok(Int)` (bytes written) or `Err(TlsWriteError(msg))`.

  ## Examples

      Tls.write(conn, "GET / HTTP/1.1\r\nHost: example.com\r\n\r\n")
  """
  fn write(conn : TlsConn, data : String) : Result(Int, TlsError) do
    with_conn(conn, fn h ->
      match tls_write(h, data) do
      Err(msg) -> Err(TlsWriteError(msg))
      Ok(n)    -> Ok(n)
      end)
  end

  -- ── Teardown ──────────────────────────────────────────────────────────

  doc """
  Perform TLS shutdown, free the connection object and close its TCP
  connection. Returns `()`. A task blocked in `read` on the conn wakes
  with `Err(TlsError.Closed)`; every later use is `Err(TlsError.Closed)`. Closing it again
  does nothing.
  """
  fn close(conn : TlsConn) : () do
    match conn do
    TlsConn(b) ->
      let _ = handle_close(b)
      ()
    end
  end

  doc """
  Free a TLS context. Connections already made from it keep working
  (OpenSSL counts its references); a later `connect` / `accept` /
  `set_groups` with it is `Err(TlsError.Closed)`. Freeing it again does nothing.
  """
  fn ctx_free(ctx : TlsCtx) : () do
    match ctx do
    TlsCtx(b) ->
      let _ = handle_close(b)
      ()
    end
  end

  -- ── Introspection ─────────────────────────────────────────────────────

  doc """
  Return the negotiated ALPN protocol as `Some(name)` (e.g. `Some("h2")`),
  or `None` if none was selected.
  """
  fn negotiated_alpn(conn : TlsConn) : Option(String) do
    match with_conn(conn, fn h -> Ok(tls_negotiated_alpn(h))) do
    Ok(a) -> a
    Err(_) -> None
    end
  end

  doc """
  Return the peer's certificate Common Name, or None if unavailable
  (including on a closed conn).
  """
  fn peer_cn(conn : TlsConn) : Option(String) do
    match with_conn(conn, fn h -> Ok(tls_peer_cn(h))) do
    Ok(cn) -> cn
    Err(_) -> None
    end
  end

  -- ── Key exchange (post-quantum) ───────────────────────────────────────

  doc """
  Whether this program's OpenSSL supports the hybrid post-quantum key
  exchange X25519MLKEM768 (OpenSSL 3.5 or later). When it does, every
  context from `client_ctx` / `server_ctx` offers it first, ahead of the
  classical X25519, P-256, P-384 and P-521, so a session with a peer that also
  supports it is protected against an attacker who records it now and breaks
  it later with a quantum computer. When it does not, contexts keep the
  library's own default groups. Always false in the interpreter, which has no
  real TLS.
  """
  fn post_quantum_available() : Bool do
    tls_pq_available()
  end

  doc """
  Replace the key-exchange groups a context offers, in preference order, by
  their OpenSSL names, e.g. `["X25519MLKEM768"]` to require post-quantum key
  exchange, or `["X25519", "P-256"]` for a classical-only peer. Applies to
  connections made from the context afterwards. `Err(TlsContextError(msg))`
  for an empty list or a group the linked OpenSSL does not know; the context
  is then unchanged.

      match Tls.set_groups(ctx, ["X25519MLKEM768"]) do
        Ok(_) -> connect_pq_only(ctx)
        Err(e) -> println(Tls.error_to_string(e))
      end
  """
  fn set_groups(ctx : TlsCtx, groups : List(String)) : Result((), TlsError) do
    with_ctx(ctx, fn h ->
      match tls_ctx_set_groups(h, String.join(groups, ":")) do
      Err(msg) -> Err(TlsContextError(msg))
      Ok(_)    -> Ok(())
      end)
  end

  doc """
  The key-exchange group the handshake agreed on, as OpenSSL names it:
  `Some("X25519MLKEM768")` for the hybrid post-quantum group,
  `Some("x25519")`, `Some("secp256r1")`, ...; `None` if unavailable.
  """
  fn negotiated_group(conn : TlsConn) : Option(String) do
    match with_conn(conn, fn h -> Ok(tls_negotiated_group(h))) do
    Ok(g) -> g
    Err(_) -> None
    end
  end

  doc """
  Whether a connection's key exchange was post-quantum (an ML-KEM group).
  """
  fn is_post_quantum(conn) : Bool do
    match negotiated_group(conn) do
    Some(g) -> String.contains(String.to_uppercase(g), "MLKEM")
    None -> false
    end
  end

  -- ── High-level helpers ────────────────────────────────────────────────

  doc """
  Full HTTPS GET convenience function.
  Connects to host:port, performs TLS handshake (verifying the cert for
  `host`), sends a minimal HTTP/1.1 GET request with `Connection: close`,
  reads the response, tears down TLS and the TCP connection.
  Returns `Ok(response_string)` (the raw response: status line, headers and
  body, unparsed) or `Err(TlsError)`; a TCP connect failure is reported as
  `TlsHandshakeFailed("tcp_connect: ...")`. A host or path that would smuggle
  a second request (a CR, LF, space, or a path byte outside RFC 3986 that was
  not percent-encoded) gives `TlsWriteError(reason)` before connecting.

  The response is a single `read` of at most 1 MiB, so a response spanning
  several TLS records may come back truncated; use `HttpTransport.request`
  for a complete, parsed response. No read timeout is set.

  ## Examples

      match Tls.https_get("example.com", 443, "/") do
        Ok(raw) -> println(raw)
        Err(e) -> println(Tls.error_to_string(e))
      end
  """
  fn https_get(host, port, path) do
    -- The request goes through the HTTP serializer's field checks, so a host
    -- or path carrying a CR, LF, space or other byte the request line cannot
    -- carry is refused (TlsWriteError, nothing connected or sent) instead of
    -- smuggling a second request.
    match http_serialize_request("GET", host, path, None, Cons(Header("Connection", "close"), Nil), "") do
    Err(msg) -> Err(TlsWriteError(msg))
    Ok(req) -> https_get_raw(host, port, req)
    end
  end

  pfn https_get_raw(host, port, req) do
    let config = default_client_config()
    match client_ctx(config) do
    Err(e) -> Err(e)
    Ok(ctx) ->
      let result = match tcp_connect(host, port) do
        Err(msg) -> Err(TlsHandshakeFailed("tcp_connect: " ++ msg))
        Ok(fd) ->
          let s = Socket.adopt(fd)
          match connect(s, ctx, host) do
          Err(e) ->
            let _ = Socket.close(s)
            Err(e)
          Ok(conn) ->
            let r = match write(conn, req) do
              Err(e) -> Err(e)
              Ok(_) -> read(conn, 1048576)
            end
            close(conn)
            r
          end
      end
      ctx_free(ctx)
      result
    end
  end

  -- ── Error helpers ─────────────────────────────────────────────────────

  doc """
  Convert a TlsError to a human-readable string.

  ## Examples

      Tls.error_to_string(TlsHandshakeFailed("timeout"))  -- "TLS handshake failed: timeout"
      Tls.error_to_string(TlsCertError("invalid CN"))     -- "TLS certificate error: invalid CN"
      Tls.error_to_string(TlsReadError("EOF"))            -- "TLS read error: EOF"
      Tls.error_to_string(TlsReadTimeout)                 -- "TLS read timed out"
      Tls.error_to_string(TlsWriteError("broken pipe"))   -- "TLS write error: broken pipe"
      Tls.error_to_string(TlsContextError("bad cert"))    -- "TLS context error: bad cert"
  """
  fn error_to_string(e) do
    match e do
    TlsHandshakeFailed(msg) -> "TLS handshake failed: " ++ msg
    TlsCertError(msg)       -> "TLS certificate error: " ++ msg
    TlsReadError(msg)       -> "TLS read error: " ++ msg
    TlsReadTimeout          -> "TLS read timed out"
    TlsWriteError(msg)      -> "TLS write error: " ++ msg
    TlsContextError(msg)    -> "TLS context error: " ++ msg
    TlsError.Closed                  -> "TLS connection is closed"
    end
  end

end
