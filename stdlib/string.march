-- String module: functions for working with UTF-8 encoded strings.
--
-- March strings are immutable UTF-8 byte sequences.  Every string is a
-- refcounted heap allocation with a 24-byte header — there is NO small-string
-- optimisation, so even a 3-byte string costs a malloc.  (This comment
-- previously claimed a fat-pointer representation with 15-byte inline storage.
-- That was never true; see specs/2026-07-26-string-performance-profile.md for
-- what the representation actually costs, measured.)
--
-- Key naming conventions:
-- - Functions with `byte_` in their name operate on raw byte offsets (O(1)).
-- - `codepoint_count` counts Unicode codepoints (NOT user-perceived
--   graphemes — combining characters and emoji clusters count as multiple
--   codepoints).  `grapheme_count` is a legacy ALIAS for it and counts
--   codepoints too, despite the name: `"e" ++ combining-acute` is one grapheme
--   but both functions return 2, and a ZWJ emoji sequence is one grapheme but
--   both return 3.  Prefer `codepoint_count`, whose name matches what it does.
-- - Use `byte_size` for performance-critical paths.
--
-- doc: try

mod String do

  doc """
  Return the number of bytes in the UTF-8 encoding of `s`.

      march> String.byte_size("hello")
      5
      march> String.byte_size("é")  -- 2-byte UTF-8 sequence
      2
      march> String.byte_size("")
      0

  Cost: O(1) — reads a stored length field.
  """
  fn byte_size(s) do string_byte_length(s) end

  doc """
  Return a byte-indexed substring of `s` starting at byte offset `start`
  with length `len` bytes.

      march> String.slice_bytes("hello world", 6, 5)
      "world"
      march> String.slice_bytes("hello", 0, 100)  -- clamped
      "hello"

  Both `start` and `len` are clamped to valid byte ranges; no exception is
  raised for out-of-bounds values.  The returned string is a copy (the
  interpreter does not yet implement GC slices).

  Cost: O(len) for the copy.
  """
  fn slice_bytes(s, start, len) do string_slice(s, start, len) end

  doc "Alias for slice_bytes: extract len bytes starting at start."
  fn slice(s, start, len) do string_slice(s, start, len) end

  doc """
  Return `true` if `substring` appears anywhere in `s`.

      march> String.contains("hello world", "world")
      true
      march> String.contains("hello world", "xyz")
      false
      march> String.contains("abc", "")  -- empty is always found
      true

  Cost: O(n * m) worst case, where n = byte_size(s) and m = byte_size(substring).
  """
  fn contains(s, substring) do string_contains(s, substring) end

  doc """
  Return `true` if `s` begins with `prefix`.

      march> String.starts_with("hello", "he")
      true
      march> String.starts_with("hello", "lo")
      false
      march> String.starts_with("hello", "")
      true

  Cost: O(|prefix|).
  """
  fn starts_with(s, prefix) do string_starts_with(s, prefix) end

  doc """
  Return `true` if `s` ends with `suffix`.

      march> String.ends_with("hello", "lo")
      true
      march> String.ends_with("hello", "he")
      false
      march> String.ends_with("hello", "")
      true

  Cost: O(|suffix|).
  """
  fn ends_with(s, suffix) do string_ends_with(s, suffix) end

  doc """
  Concatenate two strings.

      march> String.concat("foo", "bar")
      "foobar"

  Prefer the `++` operator for inline concatenation.  Use `IOList` when
  building many string segments to avoid O(n²) copying.

  Cost: O(|a| + |b|) — allocates a new string.
  """
  fn concat(a, b) do string_concat(a, b) end

  doc """
  Replace the **first** occurrence of `old` in `s` with `new`.

      march> String.replace("aabbaa", "a", "x")
      "xabbaa"
      march> String.replace("hello", "xyz", "!")  -- no match
      "hello"

  If `old` is the empty string, `s` is returned unchanged.
  See `replace_all` to replace every occurrence.

  Cost: O(n) scan + O(n) for the result string.
  """
  fn replace(s, old, new) do string_replace(s, old, new) end

  doc """
  Replace **every** non-overlapping occurrence of `old` in `s` with `new`.

      march> String.replace_all("aabbaa", "a", "x")
      "xxbbxx"
      march> String.replace_all("hello", "l", "r")
      "herro"

  If `old` is the empty string, `s` is returned unchanged.

  Cost: O(n) where n = byte_size(s).
  """
  fn replace_all(s, old, new) do string_replace_all(s, old, new) end

  doc """
  Split `s` on every occurrence of `sep`, returning a `List(String)`.

      march> String.split("a,b,c", ",")
      ["a", "b", "c"]
      march> String.split("abc", "")  -- empty sep: one string per byte
      ["a", "b", "c"]
      march> String.split("aXbXc", "X")
      ["a", "b", "c"]

  Adjacent separators produce empty strings in the result list.

  An empty `sep` splits into single **bytes**, not characters: ASCII text comes
  apart one character per string, but a multi-byte UTF-8 character is cut into
  invalid pieces (`String.split("é", "")` gives two one-byte strings). To work
  character by character, use `String.to_codepoints`.

  Cost: O(n) where n = byte_size(s).
  """
  fn split(s, sep) do string_split(s, sep) end

  doc """
  Split `s` on the **first** occurrence of `sep`.
  Returns `Some((head, tail))` if `sep` is found, or `None` if not found.

      march> String.split_first("a:b:c", ":")
      Some(("a", "b:c"))
      march> String.split_first("hello", ":")
      None
      march> String.split_first("key=val", "=")
      Some(("key", "val"))

  Useful for parsing key-value pairs or protocols where only the first
  delimiter matters.

  Cost: O(n) scan.
  """
  fn split_first(s, sep) do string_split_first(s, sep) end

  doc """
  Join a list of strings with a separator inserted between each element.

      march> String.join(["a", "b", "c"], "-")
      "a-b-c"
      march> String.join([], ",")
      ""
      march> String.join(["solo"], ",")
      "solo"

  Cost: O(total bytes in list + (n-1) * |sep|).
  """
  fn join(xs, sep) do string_join(xs, sep) end

  doc """
  Remove leading and trailing ASCII whitespace (spaces, tabs, newlines, CR).

      march> String.trim("  hello  ")
      "hello"
      march> String.trim("\thello\n")
      "hello"
      march> String.trim("hello")
      "hello"

  Cost: O(n).
  """
  fn trim(s) do string_trim(s) end

  doc """
  Remove leading ASCII whitespace only.

      march> String.trim_start("  hello  ")
      "hello  "

  Cost: O(n).
  """
  fn trim_start(s) do string_trim_start(s) end

  doc """
  Remove trailing ASCII whitespace only.

      march> String.trim_end("  hello  ")
      "  hello"

  Cost: O(n).
  """
  fn trim_end(s) do string_trim_end(s) end

  doc """
  Convert all ASCII letters in `s` to uppercase.

      march> String.to_uppercase("Hello World")
      "HELLO WORLD"

  Only ASCII letters (A–Z, a–z) are affected.  For full Unicode case mapping
  use an external library.

  Cost: O(n).
  """
  fn to_uppercase(s) do string_to_uppercase(s) end

  doc """
  Convert all ASCII letters in `s` to lowercase.

      march> String.to_lowercase("HELLO WORLD")
      "hello world"

  Only ASCII letters are affected.

  Cost: O(n).
  """
  fn to_lowercase(s) do string_to_lowercase(s) end

  doc """
  Repeat `s` exactly `n` times.

      march> String.repeat("ab", 3)
      "ababab"
      march> String.repeat("x", 0)
      ""
      march> String.repeat("x", 1)
      "x"

  Cost: O(n * |s|) — allocates a new string.
  """
  fn repeat(s, n) do string_repeat(s, n) end

  doc """
  Return `s` with its **bytes** reversed.

      march> String.reverse("hello")
      "olleh"
      march> String.reverse("racecar")
      "racecar"

  Note: byte-reversal is not the same as grapheme-reversal for multi-byte
  UTF-8 codepoints.  This function is primarily useful for ASCII strings.

  Cost: O(n).
  """
  fn reverse(s) do string_reverse(s) end

  doc """
  Pad `s` on the left with `fill` until the byte length reaches `width`.
  If `byte_size(s) >= width`, `s` is returned unchanged.

      march> String.pad_left("hi", 5, "0")
      "000hi"
      march> String.pad_left("hello", 3, "0")  -- already long enough
      "hello"

  `fill` must be a single-byte string (single ASCII character).

  Cost: O(width).
  """
  fn pad_left(s, width, fill) do string_pad_left(s, width, fill) end

  doc """
  Pad `s` on the right with `fill` until the byte length reaches `width`.
  If `byte_size(s) >= width`, `s` is returned unchanged.

      march> String.pad_right("hi", 5, ".")
      "hi..."
      march> String.pad_right("hello", 3, ".")
      "hello"

  `fill` must be a single-byte string (single ASCII character).

  Cost: O(width).
  """
  fn pad_right(s, width, fill) do string_pad_right(s, width, fill) end

  doc """
  Return `true` if `s` contains no bytes.

      march> String.is_empty("")
      true
      march> String.is_empty("x")
      false
      march> String.is_empty("  ")
      false

  Cost: O(1).
  """
  fn is_empty(s) do string_is_empty(s) end

  doc """
  Count the number of Unicode **codepoints** in the UTF-8 string `s`.

  For ASCII strings this equals the number of visible characters.
  For strings with multi-byte UTF-8 sequences, this counts codepoints,
  NOT grapheme clusters — combining marks (`á` = `a` + ◌́), emoji
  modifiers, and ZWJ sequences each count as multiple codepoints.

      march> String.codepoint_count("hello")
      5
      march> String.codepoint_count("é")  -- NFC: one codepoint, two bytes
      1
      march> String.codepoint_count("e" ++ Option.unwrap(String.from_codepoint(769)))  -- NFD: e + combining acute
      2
      march> String.codepoint_count("")
      0

  Use a dedicated Unicode library when you need true grapheme cluster
  segmentation (for cursor-position arithmetic in a text editor, for
  example).

  Cost: O(n) — scans the byte sequence.
  """
  fn codepoint_count(s) do string_grapheme_count(s) end

  doc """
  Legacy alias for `codepoint_count`.  Despite the name, this function
  counts codepoints, not grapheme clusters; new code should call
  `codepoint_count` directly.  Retained for backward compatibility.
  """
  fn grapheme_count(s) do codepoint_count(s) end

  doc """
  Find the byte offset of the first occurrence of `substring` in `s`.
  Returns `Some(offset)` if found, `None` if not found.

      march> String.index_of("hello", "ll")
      Some(2)
      march> String.index_of("hello", "xyz")
      None
      march> String.index_of("hello", "")
      Some(0)

  Cost: O(n * m) worst case.
  """
  fn index_of(s, substring) do string_index_of(s, substring) end

  doc """
  Find the first occurrence of `substring` at or after byte offset `start`.

  The result is an index into `s` itself, not relative to `start`, so it can be
  fed straight back in as the next `start` when tokenizing.

  Prefer this over slicing off the tail and searching again: the tail form
  re-copies the remaining bytes on every step, making a full tokenize O(n²)
  in bytes copied.

      march> String.index_of_from("a,b,c", ",", 0)
      Some(1)
      march> String.index_of_from("a,b,c", ",", 2)
      Some(3)
      march> String.index_of_from("a,b,c", ",", 4)
      None

  A negative `start` is treated as 0; a `start` past the end returns `None`;
  an empty `substring` matches at `start`.

  Cost: O((n - start) * m) worst case.
  """
  fn index_of_from(s, substring, start) do
    string_index_of_from(s, substring, start)
  end

  doc """
  Parse `s` as a decimal integer.
  Returns `Ok(n)` on success, `Err(msg)` if the string is not a valid integer.

      march> String.to_int("42")
      Ok(42)
      march> String.to_int("-7")
      Ok(-7)
      march> String.to_int("abc")
      Err("not a valid integer: abc")

  Cost: O(n).
  """
  fn to_int(s) do
    match string_to_int(s) do
    Some(n) -> Ok(n)
    None    -> Err("not a valid integer: " ++ s)
    end
  end

  doc """
  Parse `s` as a floating-point number.
  Returns `Ok(f)` on success, `Err(msg)` if the string is not a valid float.

      march> String.to_float("3.14")
      Ok(3.14)
      march> String.to_float("1e10") == Ok(10000000000.0)
      true
      march> String.to_float("abc")
      Err("not a valid float: abc")

  Cost: O(n).
  """
  fn to_float(s) do
    match string_to_float(s) do
    Some(f) -> Ok(f)
    None    -> Err("not a valid float: " ++ s)
    end
  end

  doc """
  Convert an integer to its decimal string representation.

      march> String.from_int(42)
      "42"
      march> String.from_int(-7)
      "-7"
      march> String.from_int(0)
      "0"

  Cost: O(digits).
  """
  fn from_int(n) do int_to_string(n) end

  doc """
  Convert a float to a string using OCaml's default float formatting.

      march> String.from_float(3.14)
      "3.14"
      march> String.from_float(1.0)
      "1."
      march> String.from_float(10000000000.0)
      "10000000000."

  The exact format matches OCaml's `string_of_float`.
  Cost: O(1).
  """
  fn from_float(f) do float_to_string(f) end

  doc """
  Find the byte offset of the **last** occurrence of `substring` in `s`.
  Returns `Some(offset)` if found, `None` if not found.

      march> String.last_index_of("hello.world.txt", ".")
      Some(11)
      march> String.last_index_of("hello", "xyz")
      None
      march> String.last_index_of("hello", "")
      Some(5)

  Cost: O(n * m) worst case.
  """
  fn last_index_of(s, sub) do string_last_index_of(s, sub) end

  -- Encode a validated codepoint to its UTF-8 byte list (1-4 bytes).
  -- Types are annotated so monomorphization pins concrete types even when the
  -- function is reachable but not driven by a concrete call site (an unpinned
  -- List(a) would otherwise mono to a non-pointer scrutinee — the mono
  -- dangling-TVar hazard).
  pfn encode_cp(cp : Int) : List(Int) do
    if cp <= 127 do
      Cons(cp, Nil)
    else if cp <= 2047 do
      Cons(int_or(192, int_shr(cp, 6)),
      Cons(int_or(128, int_and(cp, 63)), Nil))
    else if cp <= 65535 do
      Cons(int_or(224, int_shr(cp, 12)),
      Cons(int_or(128, int_and(int_shr(cp, 6), 63)),
      Cons(int_or(128, int_and(cp, 63)), Nil)))
    else
      Cons(int_or(240, int_shr(cp, 18)),
      Cons(int_or(128, int_and(int_shr(cp, 12), 63)),
      Cons(int_or(128, int_and(int_shr(cp, 6), 63)),
      Cons(int_or(128, int_and(cp, 63)), Nil))))
    end end end
  end

  -- Pure-March UTF-8 encode. Reject out-of-range (> 0x10FFFF, < 0) and UTF-16
  -- surrogate codepoints (0xD800-0xDFFF). Pure March, no runtime extern.
  -- This was written because the `string_from_codepoint` builtin had no native
  -- impl, so any compiled program calling it failed to link. That was fixed on
  -- 2026-08-22 (`march_string_from_codepoint`), so this body is no longer
  -- load-bearing and could delegate — see
  -- specs/todos/2026-08-22-builtins-that-typecheck-but-do-not-link.md. Kept as
  -- is for now: it is tested, it agrees with the builtin on every case
  -- including truncated input, and swapping it is its own change.
  doc """
  Encode a Unicode codepoint as a UTF-8 string.
  Returns `Some(string)` if the codepoint is valid, `None` otherwise.

  Valid codepoints are in the range 0x0 to 0x10FFFF, excluding surrogate pairs
  (0xD800 to 0xDFFF).

      march> String.from_codepoint(65)  -- U+0041
      Some("A")
      march> String.from_codepoint(233) == Some("é")  -- U+00E9
      true
      march> String.from_codepoint(128512) == Some("😀")  -- U+1F600
      true
      march> String.from_codepoint(-1)  -- out of range
      None
      march> String.from_codepoint(55296)  -- U+D800, a surrogate
      None

  Cost: O(1).
  """
  fn from_codepoint(cp : Int) : Option(String) do
    if cp < 0 do
      None
    else if cp > 1114111 do
      None
    else if cp >= 55296 do
      if cp <= 57343 do None
      else Some(Bytes.to_string(Bytes.from_list(encode_cp(cp)))) end
    else
      Some(Bytes.to_string(Bytes.from_list(encode_cp(cp))))
    end end end
  end

  doc """
  Extract all Unicode codepoints from a string as an Int list.
  Each codepoint is yielded as a separate integer in the range 0x0 to 0x10FFFF.

  Returns a list ordered left-to-right. Invalid UTF-8 sequences are treated
  as individual byte values (0x0 to 0xFF); well-formed March strings will not
  encounter this case.

      march> String.to_codepoints("A")
      [65]
      march> String.to_codepoints("é")
      [233]
      march> String.to_codepoints("AB")
      [65, 66]
      march> String.to_codepoints("😀")
      [128512]

  Cost: O(n) where n is the byte length of the string.
  """
  -- Decode UTF-8 bytes to codepoints, accumulating in reverse (tail-recursive
  -- so the top-level pfn gets TCO). A truncated multi-byte sequence at the end
  -- falls back to the lead byte's raw value (mirrors the interpreter builtin).
  pfn decode_go(b : Bytes, n : Int, i : Int, acc : List(Int)) : List(Int) do
    if i >= n do
      List.reverse(acc)
    else
      let byte = Bytes.get(b, i)
      if byte < 128 do
        decode_go(b, n, i + 1, Cons(byte, acc))
      else if byte < 224 do
        if i + 1 < n do
          let b2 = Bytes.get(b, i + 1)
          decode_go(b, n, i + 2, Cons(int_or(int_shl(byte - 192, 6), b2 - 128), acc))
        else decode_go(b, n, i + 1, Cons(byte, acc)) end
      else if byte < 240 do
        if i + 2 < n do
          let b2 = Bytes.get(b, i + 1)
          let b3 = Bytes.get(b, i + 2)
          decode_go(b, n, i + 3,
            Cons(int_or(int_or(int_shl(byte - 224, 12), int_shl(b2 - 128, 6)), b3 - 128), acc))
        else decode_go(b, n, i + 1, Cons(byte, acc)) end
      else
        if i + 3 < n do
          let b2 = Bytes.get(b, i + 1)
          let b3 = Bytes.get(b, i + 2)
          let b4 = Bytes.get(b, i + 3)
          decode_go(b, n, i + 4,
            Cons(int_or(int_or(int_or(int_shl(byte - 240, 18), int_shl(b2 - 128, 12)),
                 int_shl(b3 - 128, 6)), b4 - 128), acc))
        else decode_go(b, n, i + 1, Cons(byte, acc)) end
      end end end
    end
  end

  -- Pure-March UTF-8 decode. Same story as `from_codepoint` above: written
  -- around a `string_to_codepoints` builtin that did not link when compiled,
  -- which was fixed on 2026-08-22.
  fn to_codepoints(s : String) : List(Int) do
    let b = Bytes.from_string(s)
    decode_go(b, Bytes.length(b), 0, Nil)
  end

end
