-- GlobalPid: a serializable, cluster-wide process handle (P1 L4 prerequisite).
--
-- Location-transparent `send`/`cast`/`call` need a process identity that
-- survives the wire. A global Pid is {NodeId, local_pid, creation}: the owning
-- node, the node-local scheduler pid (the runtime's integer PID), and a creation
-- counter that distinguishes a *restarted* node's reused local pids from the
-- originals (so a stale Pid from before a restart is detectably stale). It
-- round-trips through MessagePack to ride inside a NetFrame.
--
-- doc: try
mod GlobalPid do

  type Pid = { node_id : String, local_pid : Int, creation : Int }

  doc """
  A global pid for local pid [local_pid] on node [node_id] in that node's [creation].

  ## Examples

      march> let gp = GlobalPid.make("n1", 7, 2)
      march> gp.local_pid
      7
      march> let gp = GlobalPid.make("n1", 7, 2)
      march> gp.node_id
      "n1"
  """
  fn make(node_id : String, local_pid : Int, creation : Int) : Pid do
    { node_id: node_id, local_pid: local_pid, creation: creation }
  end

  doc """
  Whether [a] and [b] name the same process: same node, same local pid AND
  same creation, so a pid from before a node restart never equals one from
  after it.

  ## Examples

      march> GlobalPid.eq(GlobalPid.make("n1", 7, 1), GlobalPid.make("n1", 7, 1))
      true
      march> GlobalPid.eq(GlobalPid.make("n1", 7, 1), GlobalPid.make("n1", 7, 2))
      false
  """
  fn eq(a : Pid, b : Pid) : Bool do
    a.node_id == b.node_id && a.local_pid == b.local_pid && a.creation == b.creation
  end

  doc """
  The pid as a MessagePack value, the array `[node_id, local_pid, creation]`,
  for nesting inside a larger record. (The return type is left to inference:
  the Msgpack `Value` type collides in the global namespace.)
  """
  fn to_value(p : Pid) do
    Msgpack.array(
      Cons(Msgpack.str(p.node_id),
      Cons(Msgpack.int(p.local_pid),
      Cons(Msgpack.int(p.creation), Nil))))
  end

  doc """
  Read a pid back from a MessagePack value produced by `to_value`. Returns
  `Err("GlobalPid: malformed pid")` for anything that is not exactly a
  3-element array of (Str, Int, Int).
  """
  fn of_value(v) : Result(Pid, String) do
    match v do
      Msgpack.Array(Cons(Msgpack.Str(nid),
                    Cons(Msgpack.Int(lp),
                    Cons(Msgpack.Int(cr), Nil)))) ->
        Ok({ node_id: nid, local_pid: lp, creation: cr })
      _ -> Err("GlobalPid: malformed pid")
    end
  end

  doc """
  The pid's MessagePack wire bytes (`Msgpack.encode(to_value(p))`).

  ## Examples

      GlobalPid.decode(GlobalPid.encode(GlobalPid.make("n1", 7, 1)))
      -- Ok(GlobalPid.make("n1", 7, 1))
  """
  fn encode(p : Pid) : List(Int) do Msgpack.encode(to_value(p)) end

  doc "Decode bytes produced by `encode`. Returns `Err` for invalid MessagePack (the decoder's message) or a malformed pid."
  fn decode(bytes : List(Int)) : Result(Pid, String) do
    match Msgpack.decode(bytes) do
      Err(e) -> Err(e)
      Ok(v)  -> of_value(v)
    end
  end

end
