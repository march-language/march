-- NetKernel: the socket-level transport for distributed OTP (P1).
--
-- Bridges the pure protocol layer (NetFrame / NodeIdentity / ClusterAuth /
-- Handshake, all over List(Int) bytes) to real TCP sockets (Socket, over
-- String). It frames messages, reads complete frames off a byte stream
-- (partial-read safe), and runs the authenticated handshake that gates a peer
-- into the cluster.
--
-- The pure bridge (to_wire / str_to_bytes / bytes_to_str) is unit-tested; the
-- socket handshake is runtime-exercised (sockets/scheduler are not run by the
-- eval-based stdlib test harness, matching ChannelServer's convention).
--
-- P5 frame types (tag byte prepended before the msgpack payload):
--   0x05 REGISTRY_SYNC_REQ  [tag=5, root_hash:Str]
--   0x06 REGISTRY_SYNC_RESP [tag=6, root_hash:Str, leaves:[[name,nid,pid,present,clock,creation],...]]
--     clock: [[actor_id:Str, ts:Int],...]; a 4-element leaf (no clock, the
--     original encoding) still decodes, with an empty clock, and a
--     5-element one (no creation) with creation 0
--   0x07 MONITOR_REQ        [tag=7, watcher_node:Str, watcher_pid:Int, target_pid:Int]
--   0x08 MONITOR_FIRE       [tag=8, target_pid:Int, reason_tag:Int, reason_msg:Str]
--     reason_tag: 0=Normal, 1=Killed, 2=Crash, 3=NodeDown
mod NetKernel do

  -- ── byte bridge: List(Int) bytes <-> Socket String ─────────────────────────

  fn str_to_bytes(s : String) : List(Int) do Bytes.to_list(Bytes.from_string(s)) end
  fn bytes_to_str(b : List(Int)) : String do Bytes.to_string(Bytes.from_list(b)) end

  -- Frame [payload] and render it as the String the socket layer sends.
  fn to_wire(payload : List(Int)) : String do
    bytes_to_str(NetFrame.encode(payload))
  end

  -- A fresh random nonce for a handshake challenge.
  fn fresh_nonce() : String do Crypto.random_hex(16) end

  -- ── framed socket I/O ──────────────────────────────────────────────────────

  -- Frame [payload] and write it; sealed (NetFrame.seal) when the
  -- connection's handshake agreed a MAC key.
  fn send_frame(fd : Int, payload : List(Int)) : Result((), String) do
    match Vault.get(mac_table(), fk(fd)) do
      None -> send_raw(fd, payload)
      Some(keys) -> write_bytes(fd, seal_next(fd, keys, Bytes.from_list(payload)))
    end
  end

  doc """
  Write an already-framed (length-prefixed, unsealed) frame, sealing it
  first when [fd] is sealed: NodeQueue frames its messages when they are
  queued, before it knows when they will be written.
  """
  fn write_framed(fd : Int, framed : Bytes) : Result((), String) do
    match Vault.get(mac_table(), fk(fd)) do
      None -> write_bytes(fd, framed)
      Some(keys) -> write_bytes(fd, seal_next(fd, keys, Bytes.slice(framed, 4, Bytes.length(framed) - 4)))
    end
  end

  pfn write_bytes(fd : Int, b : Bytes) : Result((), String) do
    match Socket.write(fd, Bytes.to_string(b)) do
      Ok(_) -> Ok(())
      Err(e) -> Err(Socket.error_message(e))
    end
  end

  -- Number and seal one outgoing frame. The number is taken atomically
  -- (Vault.incr); two writers on one socket may still write in the other
  -- order, which the receiver's window allows.
  pfn seal_next(fd : Int, keys : MacKeys, payload : Bytes) : Bytes do
    let seq = Vault.incr(mac_counts(), "s" ++ fk(fd), 1) - 1
    NetFrame.seal(keys.tx_key, seq, payload)
  end

  -- One frame, never sealed: the handshake's own frames.
  pfn send_raw(fd : Int, payload : List(Int)) : Result((), String) do
    match Socket.write(fd, to_wire(payload)) do
      Ok(_) -> Ok(())
      Err(e) -> Err(Socket.error_message(e))
    end
  end

  -- Read one complete frame off [fd], starting from already-buffered [buf].
  -- Returns (payload, leftover_bytes); None-from-decode means read more.
  -- Linear in the frame size: once the 4-byte length prefix is in [buf],
  -- the rest of the body is read with ONE tcp_recv_exact and appended ONCE.
  -- The first version appended every 4 KiB chunk to the accumulated list,
  -- quadratic in the frame size -- a 16 MiB frame was impractical
  -- (specs/progress/2026-09-14-distributed-plane-flow-control-and-control-channel.md).
  -- Bytes read past the frame boundary come back as the leftover for the
  -- next call, as before.
  -- On a sealed connection each frame's MAC is checked (`unseal`): a frame
  -- that fails is dropped and the next one read; the connection's reader
  -- gets Err once `mac_failure_limit()` frames have failed.
  fn recv_frame(fd : Int, buf : List(Int)) : Result((List(Int), List(Int)), String) do
    match recv_frame_plain(fd, buf) do
      Err(e) -> Err(e)
      Ok((wire, rest)) ->
        match Vault.get(mac_table(), fk(fd)) do
          None -> Ok((wire, rest))
          Some(keys) ->
            match unseal(fd, keys, Bytes.from_list(wire)) do
              Err(e) -> Err(e)
              Ok(Some(payload)) -> Ok((payload, rest))
              Ok(None) -> recv_frame(fd, rest)
            end
        end
    end
  end

  pfn recv_frame_plain(fd : Int, buf : List(Int)) : Result((List(Int), List(Int)), String) do
    match NetFrame.decode(buf) do
      Some(result) -> Ok(result)
      None ->
        let have = List.length(buf)
        if have < 4 do
          match Socket.recv(fd, 4096) do
            Err(e) -> Err(Socket.error_message(e))
            Ok(chunk) ->
              if String.is_empty(chunk) do
                Err("net-kernel: connection closed mid-frame")
              else
                recv_frame_plain(fd, List.append(buf, str_to_bytes(chunk)))
              end
          end
        else
          let len = NetFrame.body_length(buf)
          match tcp_recv_exact(fd, len - (have - 4)) do
            Err(e) -> Err("net-kernel: " ++ e)
            Ok(rest) -> recv_frame_plain(fd, List.append(buf, Bytes.to_list(rest)))
          end
        end
    end
  end

  -- Read exactly one frame and not a byte more: the 4-byte prefix, then
  -- exactly the body. For the handshake, where the frames that follow
  -- belong to whoever the connection is handed to. `recv_frame` reads in
  -- chunks and returns the over-read as a leftover the caller must carry;
  -- the handshake used it and DROPPED that leftover, so a peer that
  -- finished its side of the handshake and immediately wrote (the
  -- control/data split's data stream) lost its first bytes whenever they
  -- landed in the same recv() as the proof -- 2 runs in 20 under load,
  -- never unloaded (control_channel_loopback, 2026-09-14).
  fn recv_frame_exact(fd : Int) : Result(List(Int), String) do
    match recv_frame_exact_raw(fd) do
      Err(e) -> Err(e)
      Ok(wire) ->
        match Vault.get(mac_table(), fk(fd)) do
          None -> Ok(wire)
          Some(keys) ->
            match unseal(fd, keys, Bytes.from_list(wire)) do
              Err(e) -> Err(e)
              Ok(Some(payload)) -> Ok(payload)
              Ok(None) -> recv_frame_exact(fd)
            end
        end
    end
  end

  pfn recv_frame_exact_raw(fd : Int) : Result(List(Int), String) do
    match tcp_recv_exact(fd, 4) do
      Err(e) -> Err("net-kernel: " ++ e)
      Ok(hdr) ->
        let hb = Bytes.to_list(hdr)
        match tcp_recv_exact(fd, NetFrame.body_length(hb)) do
          Err(e) -> Err("net-kernel: " ++ e)
          Ok(body) -> Ok(Bytes.to_list(body))
        end
    end
  end

  -- ── symmetric authenticated handshake ──────────────────────────────────────
  -- Both peers run the same sequence: send hello, recv hello, send proof bound
  -- to the peer's nonce, recv proof, authenticate (peer's proof must bind to
  -- the nonce WE issued). Returns the authenticated peer identity or a reason.
  -- Shared-secret mode; `handshake_auth` is the general form.
  fn handshake(fd : Int, my_id : NodeIdentity.Identity, secret : String,
               my_nonce : String) : Result(NodeIdentity.Identity, String) do
    match handshake_role(fd, my_id, secret, my_nonce, Handshake.role_control()) do
      Err(e) -> Err(e)
      Ok((id, _role)) -> Ok(id)
    end
  end

  -- The same handshake, opening a connection of [role] ("control" or "data",
  -- Handshake.role_*); returns the peer's identity AND the role the peer
  -- announced, so an acceptor knows which of a peer's two connections it
  -- just took. A pre-split peer announces no role and reads as control.
  -- Reads are exact (recv_frame_exact): nothing past the handshake's own two
  -- frames is consumed, so the connection is handed over with the peer's
  -- first real frame still unread in the socket.
  fn handshake_role(fd : Int, my_id : NodeIdentity.Identity, secret : String,
                    my_nonce : String, role : String) : Result((NodeIdentity.Identity, String), String) do
    match handshake_auth(fd, my_id, ClusterAuth.Secret(secret), my_nonce, role, "", 0) do
      Err(e) -> Err(e)
      Ok(a) -> Ok((a.identity, a.role))
    end
  end

  -- ── handshake with a deadline (the cluster node service) ─────────────────
  -- A peer that is SIGSTOPped still completes the TCP connect (its kernel
  -- answers from the listen backlog) and then never sends its hello, so an
  -- unbounded read would park the dialer for as long as the stop lasts.
  -- Every read below is bounded by one absolute deadline, and asks for at
  -- most the bytes still missing, so it never over-reads past the frame
  -- (the recv_frame_exact rule).

  pfn recv_exact_until(fd : Int, need : Int, deadline : Int, acc : List(Int)) : Result(List(Int), String) do
    if need <= 0 do
      Ok(acc)
    else
      let left = deadline - unix_time_ms()
      if left <= 0 do
        Err("net-kernel: handshake timed out")
      else
        match Socket.recv_timeout(fd, need, left) do
          Err(Socket.RecvTimeout(_)) -> Err("net-kernel: handshake timed out")
          Err(e) -> Err("net-kernel: " ++ Socket.error_message(e))
          Ok(chunk) ->
            if String.is_empty(chunk) do
              Err("net-kernel: connection closed during handshake")
            else
              let got = str_to_bytes(chunk)
              recv_exact_until(fd, need - List.length(got), deadline, List.append(acc, got))
            end
        end
      end
    end
  end

  -- One frame, exactly, before [deadline] (unix ms).
  fn recv_frame_until(fd : Int, deadline : Int) : Result(List(Int), String) do
    match recv_exact_until(fd, 4, deadline, Nil) do
      Err(e) -> Err(e)
      Ok(hdr) -> recv_exact_until(fd, NetFrame.body_length(hdr), deadline, Nil)
    end
  end

  -- The symmetric handshake of `handshake_role`, sending [addr] (this node's
  -- advertised listen address) in the hello and bounded by [timeout_ms].
  -- Returns the peer's identity, the role it announced and the address it
  -- advertised ("" from a peer that sends none).
  fn handshake_addr(fd : Int, my_id : NodeIdentity.Identity, secret : String, my_nonce : String,
                    role : String, addr : String, timeout_ms : Int)
      : Result((NodeIdentity.Identity, String, String), String) do
    match handshake_auth(fd, my_id, ClusterAuth.Secret(secret), my_nonce, role, addr, timeout_ms) do
      Err(e) -> Err(e)
      Ok(a) -> Ok((a.identity, a.role, a.addr))
    end
  end

  -- ── per-connection MAC state ─────────────────────────────────────────────
  -- A connection's keys live here, by fd, from the end of its handshake
  -- (`handshake_auth` installs them) until the next handshake on the same fd
  -- number or `forget(fd)`. Every framed read and write below consults it, so
  -- code above the net-kernel (PeerReader, NodeSend, NodeQueue, SessionNode,
  -- ClusterNode) seals and checks frames without knowing about keys. One
  -- WRITER-side counter per fd numbers the sealed frames; the reader keeps a
  -- receive window (NetFrame.window_accept). A frame that fails is dropped
  -- and counted; after `mac_failure_limit()` failures on one connection the
  -- read returns Err and the connection's reader ends, which closes it.
  --
  -- Rule for code that reuses framing on a socket WITHOUT a handshake (raw
  -- NodeSend/NodeCall fixtures): call `forget(fd)` first if that process
  -- ever ran a sealed connection, or a stale key on a reused fd number seals
  -- its frames.

  type MacKeys = { tx_key : Bytes, rx_key : Bytes }

  pfn mac_table() : Vault(MacKeys) do Vault.open("net_kernel_mac") end
  pfn mac_counts() : Vault(Int) do Vault.open("net_kernel_mac_counts") end
  pfn mac_hooks() : Vault(Int -> Int -> Unit) do Vault.open("net_kernel_mac_hooks") end
  pfn fk(fd : Int) : String do int_to_string(fd) end

  doc "Frames that may fail their MAC on one connection before it is closed."
  fn mac_failure_limit() : Int do 3 end

  -- Seal [fd]'s frames from now on with [keys].
  pfn install(fd : Int, keys : ClusterAuth.FrameKeys) : () do
    let c = mac_counts()
    Vault.set(c, "s" ++ fk(fd), 0)
    Vault.set(c, "hi" ++ fk(fd), -1)
    Vault.set(c, "mask" ++ fk(fd), 0)
    Vault.set(c, "bad" ++ fk(fd), 0)
    Vault.set(mac_table(), fk(fd), { tx_key: keys.tx_key, rx_key: keys.rx_key })
  end

  -- ── raw-send permission per connection (distributed-deploys step 11b) ──
  -- A certificate-mode handshake records whether raw frames (Node.send,
  -- RemoteCall: anything outside a session) may cross the connection: only
  -- when BOTH certificates carry `raw_send`. A connection with no entry
  -- (shared-secret mode, or never handshaked here) allows them.
  pfn raw_table() : Vault(Int) do Vault.open("net_kernel_raw") end

  doc """
  May raw frames (anything but session traffic) cross [fd]? False only on a
  certificate-mode connection where this node's or the peer's certificate
  lacks `raw_send`. Checked by `NodeSend` (Node.send) and `NodeCall`
  (RemoteCall); ClusterNode checks its own connections by certificate.
  """
  fn raw_allowed(fd : Int) : Bool do Vault.get_or(raw_table(), fk(fd), 1) == 1 end

  doc "Record a raw frame refused on a connection (`raw_allowed` false): counted in `raw_refused()`."
  fn note_raw_refused(_fd : Int) : () do
    let _ = Vault.incr(mac_counts(), "raw_refused_total", 1)
    ()
  end

  doc "Raw frames refused on connections this process handshaked, in either direction."
  fn raw_refused() : Int do Vault.get_or(mac_counts(), "raw_refused_total", 0) end

  doc "Drop [fd]'s MAC state: its frames are plain again (see the rule above)."
  fn forget(fd : Int) : () do
    Vault.drop(raw_table(), fk(fd))
    Vault.drop(mac_table(), fk(fd))
    let c = mac_counts()
    Vault.drop(c, "s" ++ fk(fd))
    Vault.drop(c, "hi" ++ fk(fd))
    Vault.drop(c, "mask" ++ fk(fd))
    Vault.drop(c, "bad" ++ fk(fd))
  end

  doc "Are [fd]'s frames sealed?"
  fn sealed(fd : Int) : Bool do Vault.get(mac_table(), fk(fd)) != None end

  doc "Frames dropped for a failed MAC, in this process, since it started."
  fn frames_rejected() : Int do Vault.get_or(mac_counts(), "bad_total", 0) end

  doc """
  Call [f](fd, failures_on_that_connection) whenever a frame fails its MAC
  (the connection's reader calls it, in its own task). Returns an id for
  `off_frame_rejected`.
  """
  fn on_frame_rejected(f : Int -> Int -> Unit) : Int do
    let id = Vault.incr(mac_counts(), "next_hook", 1)
    Vault.set(mac_hooks(), int_to_string(id), f)
    id
  end

  fn off_frame_rejected(id : Int) : () do Vault.drop(mac_hooks(), int_to_string(id)) end

  -- A sealed frame's body (after the length prefix) off [fd]: the payload,
  -- or None when it failed (dropped and counted), or Err once the
  -- connection has failed too often.
  pfn unseal(fd : Int, keys : MacKeys, body : Bytes) : Result(Option(List(Int)), String) do
    let c = mac_counts()
    let ok = match NetFrame.open(keys.rx_key, body) do
      Err(_) -> None
      Ok((seq, payload)) ->
        match NetFrame.window_accept(Vault.get_or(c, "hi" ++ fk(fd), -1), Vault.get_or(c, "mask" ++ fk(fd), 0), seq) do
          None -> None
          Some((hi, mask)) ->
            Vault.set(c, "hi" ++ fk(fd), hi)
            Vault.set(c, "mask" ++ fk(fd), mask)
            Some(Bytes.to_list(payload))
        end
    end
    match ok do
      Some(p) -> Ok(Some(p))
      None ->
        let n = Vault.incr(c, "bad" ++ fk(fd), 1)
        let _ = Vault.incr(c, "bad_total", 1)
        let _ = List.map(Vault.all(mac_hooks()), fn kv -> match kv do (_k, f) -> f(fd, n) end)
        if n >= mac_failure_limit() do
          Err("net-kernel: " ++ int_to_string(n) ++ " frames failed their MAC; closing the connection")
        else Ok(None) end
    end
  end

  -- ── the authenticated handshake (both modes) ──────────────────────────────
  -- What a finished handshake knows about the peer: its identity, the role it
  -- announced for this connection, its advertised address ("" when it sent
  -- none), its VERIFIED certificate (certificate mode) and whether the
  -- connection's frames are sealed from here on.
  type Authed = { identity : NodeIdentity.Identity, role : String, addr : String,
                  cert : Option(NodeCert.Cert), mac : Bool }

  -- The X25519 base point (u = 9).
  pfn x25519_base() : Bytes do Bytes.from_list(Cons(9, List.map(List.range(0, 31), fn _ -> 0))) end

  pfn now_s() : Int do unix_time_ms() / 1000 end

  -- One handshake frame: bounded by [deadline] (unix ms) when it is > 0, else
  -- an exact blocking read. Never over-reads and never MAC-checks: the
  -- handshake's own frames are plain.
  pfn hs_recv(fd : Int, deadline : Int) : Result(List(Int), String) do
    if deadline > 0 do recv_frame_until(fd, deadline) else recv_frame_exact_raw(fd) end
  end

  doc """
  The handshake, in either mode ([auth]): send a hello, read the peer's,
  check the modes agree, prove ourselves bound to the peer's nonce, check the
  peer's proof bound to ours. Shared-secret mode: an HMAC of the nonce under
  the secret (wire-compatible with pre-11a nodes). Certificate mode: the hello
  carries our certificate and an ephemeral X25519 key; we verify the peer's
  certificate (operator signature, expiry, revocation, name) and its
  ed25519 signature over our nonce and the transcript. When both sides
  support it, the connection's frames are sealed from then on (NetFrame.seal;
  `mac` in the result). [role] names the connection ("control"/"data"),
  [addr] is our advertised address ("" for none), [timeout_ms] bounds the
  whole exchange (<= 0: no bound).
  """
  fn handshake_auth(fd : Int, my_id : NodeIdentity.Identity, auth : ClusterAuth.Auth, my_nonce : String,
                    role : String, addr : String, timeout_ms : Int) : Result(Authed, String) do
    -- A connection on a reused fd number must not inherit the last one's key.
    forget(fd)
    let deadline = if timeout_ms > 0 do unix_time_ms() + timeout_ms else 0 end
    match auth do
      ClusterAuth.Secret(secret) -> handshake_secret(fd, my_id, secret, my_nonce ++ ClusterAuth.mac_suffix(), role, addr, deadline)
      ClusterAuth.Certified(creds) -> handshake_cert(fd, my_id, creds, my_nonce, role, addr, deadline)
    end
  end

  pfn handshake_secret(fd : Int, my_id : NodeIdentity.Identity, secret : String, nonce : String,
                       role : String, addr : String, deadline : Int) : Result(Authed, String) do
    let hello = Handshake.encode_hello(Handshake.make_hello_addr(my_id, nonce, role, addr))
    match send_raw(fd, hello) do
      Err(e) -> Err(e)
      Ok(_) ->
        match hs_recv(fd, deadline) do
          Err(e) -> Err(e)
          Ok(hbytes) ->
            match Handshake.decode_hello(hbytes) do
              Err(e) -> Err(e)
              Ok(peer) ->
                -- A peer that echoes our own nonce is reflecting our hello
                -- (and would then reflect our proof, which verifies): refused.
                match (Handshake.check_mode(ClusterAuth.Secret(secret), peer),
                       peer.nonce == nonce) do
                  (Err(e), _) -> Err(e)
                  (_, true) -> Err("Handshake: the peer echoed our nonce")
                  (Ok(_), false) ->
                    match send_raw(fd, str_to_bytes(ClusterAuth.prove(secret, peer.nonce))) do
                      Err(e) -> Err(e)
                      Ok(_) ->
                        match hs_recv(fd, deadline) do
                          Err(e) -> Err(e)
                          Ok(pbytes) ->
                            match Handshake.authenticate(secret, nonce, peer, bytes_to_str(pbytes)) do
                              Err(e) -> Err(e)
                              Ok(id) ->
                                -- Sealed when the peer offered it too (a pre-11a peer does not).
                                let mac = ClusterAuth.offers_mac(peer.nonce)
                                let _ = if mac do
                                  install(fd, ClusterAuth.frame_keys(Bytes.from_string(secret),
                                                ClusterAuth.transcript(hello, nonce, hbytes, peer.nonce), nonce, peer.nonce))
                                else () end
                                Ok({ identity: id, role: peer.role, addr: peer.addr, cert: None, mac: mac })
                            end
                        end
                    end
                end
            end
        end
    end
  end

  pfn handshake_cert(fd : Int, my_id : NodeIdentity.Identity, creds : NodeCert.Credentials, nonce : String,
                     role : String, addr : String, deadline : Int) : Result(Authed, String) do
    let eph_sk = Crypto.random_bytes(32)
    let eph_pub = x25519(eph_sk, x25519_base())
    let hello = Handshake.encode_hello(Handshake.make_hello_cert(my_id, nonce, role, addr,
                                         NodeCert.to_bytes(creds.signed), Bytes.to_list(eph_pub)))
    match send_raw(fd, hello) do
      Err(e) -> Err(e)
      Ok(_) ->
        match hs_recv(fd, deadline) do
          Err(e) -> Err(e)
          Ok(hbytes) ->
            match Handshake.decode_hello(hbytes) do
              Err(e) -> Err(e)
              Ok(peer) ->
                match Handshake.check_mode(ClusterAuth.Certified(creds), peer) do
                  Err(e) -> Err(e)
                  Ok(_) ->
                    if peer.nonce == nonce do Err("Handshake: the peer echoed our nonce")
                    else
                      match Handshake.verify_peer_cert(creds, peer, now_s()) do
                        Err(e) -> Err(e)
                        Ok((cert, peer_pk)) ->
                          let th = ClusterAuth.transcript(hello, nonce, hbytes, peer.nonce)
                          match send_raw(fd, Bytes.to_list(ClusterAuth.cert_prove(creds.secret_key, peer.nonce, th))) do
                            Err(e) -> Err(e)
                            Ok(_) ->
                              match hs_recv(fd, deadline) do
                                Err(e) -> Err(e)
                                Ok(pbytes) ->
                                  if not(ClusterAuth.cert_verify(peer_pk, nonce, th, Bytes.from_list(pbytes))) do
                                    Err("Handshake: peer " ++ peer.identity.name ++ " failed to prove it holds its certificate's key")
                                  else
                                    let peer_eph = match peer.cert do
                                      Some(hc) -> Bytes.from_list(hc.eph)
                                      None -> Bytes.empty()
                                    end
                                    -- The MAC key comes from an X25519 agreement between the
                                    -- two ephemeral keys, which the signed transcript binds to
                                    -- the two certificates: secret from an eavesdropper.
                                    let shared = x25519(eph_sk, peer_eph)
                                    if Bytes.is_empty(shared) do Err("Handshake: the peer's ephemeral key is not usable")
                                    else
                                      install(fd, ClusterAuth.frame_keys(shared, th, nonce, peer.nonce))
                                      let raw = NodeCert.has_flag(creds.signed.cert, "raw_send") && NodeCert.has_flag(cert, "raw_send")
                                      Vault.set(raw_table(), fk(fd), if raw do 1 else 0 end)
                                      Ok({ identity: peer.identity, role: peer.role, addr: peer.addr,
                                           cert: Some(cert), mac: true })
                                    end
                                  end
                              end
                          end
                      end
                    end
                end
            end
        end
    end
  end

  -- ── P5 frame codecs ──────────────────────────────────────────────────────────

  -- REGISTRY_SYNC_REQ: send our root hash, ask peer to diff.
  fn encode_registry_sync_req(root_hash : String) : List(Int) do
    Msgpack.encode(Msgpack.array(Cons(Msgpack.int(5), Cons(Msgpack.str(root_hash), Nil))))
  end

  -- REGISTRY_SYNC_RESP: our root hash + any leaves that differ.
  -- Each leaf is encoded as [name, node_id, pid, present_int, clock], clock
  -- the entry's VectorClock as [[actor_id, ts], ...]. The clock is what
  -- GlobalRegistry.merge orders bindings by: a leaf without it decodes as
  -- causally OLDER than any local claim, so after a partition each side kept
  -- its own binding and the replicas never converged (test/two_node/partition).
  fn encode_registry_sync_resp(root_hash : String,
                                leaves : List((String, GlobalRegistry.Entry))) : List(Int) do
    let leaf_vals = List.map(leaves, fn pair ->
      match pair do
        (name, e) ->
          let clock = Msgpack.array(List.map(VectorClock.entries(e.clock), fn kv ->
            match kv do
              (aid, ts) -> Msgpack.array(Cons(Msgpack.str(aid), Cons(Msgpack.int(ts), Nil)))
            end))
          Msgpack.array(Cons(Msgpack.str(name),
            Cons(Msgpack.str(e.node_id),
            Cons(Msgpack.int(e.pid),
            Cons(Msgpack.int(if e.present do 1 else 0 end),
            Cons(clock,
            Cons(Msgpack.int(e.creation), Nil)))))))
      end)
    Msgpack.encode(Msgpack.array(Cons(Msgpack.int(6),
      Cons(Msgpack.str(root_hash),
      Cons(Msgpack.array(leaf_vals), Nil)))))
  end

  -- A leaf's clock: [[actor_id, ts], ...]; a malformed pair is skipped.
  pfn decode_clock(pairs : List(Msgpack.Value)) : VectorClock do
    List.fold_left(pairs, VectorClock.new(), fn (vc, p) ->
      match p do
        Msgpack.Array(Cons(Msgpack.Str(aid), Cons(Msgpack.Int(ts), Nil))) -> VectorClock.advance(vc, aid, ts)
        _ -> vc
      end)
  end

  fn decode_registry_sync_req(bytes : List(Int)) : Result(String, String) do
    match Msgpack.decode(bytes) do
      Err(e) -> Err(e)
      Ok(v)  ->
        match v do
          Msgpack.Array(Cons(Msgpack.Int(5), Cons(Msgpack.Str(rh), Nil))) -> Ok(rh)
          _ -> Err("net_kernel: bad REGISTRY_SYNC_REQ")
        end
    end
  end

  fn decode_registry_sync_resp(bytes : List(Int)) : Result((String, List((String, GlobalRegistry.Entry))), String) do
    match Msgpack.decode(bytes) do
      Err(e) -> Err(e)
      Ok(v) ->
        match v do
          Msgpack.Array(Cons(Msgpack.Int(6),
            Cons(Msgpack.Str(rh),
            Cons(Msgpack.Array(leaf_vals), Nil)))) ->
              let leaves = List.filter_map(leaf_vals, fn lv ->
                match lv do
                  Msgpack.Array(Cons(Msgpack.Str(name),
                    Cons(Msgpack.Str(nid),
                    Cons(Msgpack.Int(pid),
                    Cons(Msgpack.Int(present_int), more))))) ->
                      let clock = match more do
                        Cons(Msgpack.Array(pairs), _) -> decode_clock(pairs)
                        _ -> VectorClock.new()
                      end
                      let creation = match more do
                        Cons(_, Cons(Msgpack.Int(cr), Nil)) -> cr
                        _ -> 0
                      end
                      let entry = { node_id: nid, pid: pid,
                                    clock: clock,
                                    present: present_int != 0,
                                    creation: creation,
                                    registrant: "" }
                      Some((name, entry))
                  _ -> None
                end)
              Ok((rh, leaves))
          _ -> Err("net_kernel: bad REGISTRY_SYNC_RESP")
        end
    end
  end

  -- MONITOR_REQ: register a remote watcher on a local target.
  fn encode_monitor_req(watcher_node : String, watcher_pid : Int, target_pid : Int) : List(Int) do
    Msgpack.encode(Msgpack.array(Cons(Msgpack.int(7),
      Cons(Msgpack.str(watcher_node),
      Cons(Msgpack.int(watcher_pid),
      Cons(Msgpack.int(target_pid), Nil))))))
  end

  fn decode_monitor_req(bytes : List(Int)) : Result((String, Int, Int), String) do
    match Msgpack.decode(bytes) do
      Err(e) -> Err(e)
      Ok(v) ->
        match v do
          Msgpack.Array(Cons(Msgpack.Int(7),
            Cons(Msgpack.Str(wn),
            Cons(Msgpack.Int(wp),
            Cons(Msgpack.Int(tp), Nil))))) -> Ok((wn, wp, tp))
          _ -> Err("net_kernel: bad MONITOR_REQ")
        end
    end
  end

  -- MONITOR_FIRE: remote process died; notify local watcher.
  -- reason_tag: 0=Normal 1=Killed 2=Crash 3=NodeDown
  fn encode_monitor_fire(target_pid : Int, reason_tag : Int, reason_msg : String) : List(Int) do
    Msgpack.encode(Msgpack.array(Cons(Msgpack.int(8),
      Cons(Msgpack.int(target_pid),
      Cons(Msgpack.int(reason_tag),
      Cons(Msgpack.str(reason_msg), Nil))))))
  end

  fn decode_monitor_fire(bytes : List(Int)) : Result((Int, Int, String), String) do
    match Msgpack.decode(bytes) do
      Err(e) -> Err(e)
      Ok(v) ->
        match v do
          Msgpack.Array(Cons(Msgpack.Int(8),
            Cons(Msgpack.Int(tp),
            Cons(Msgpack.Int(rt),
            Cons(Msgpack.Str(rm), Nil))))) -> Ok((tp, rt, rm))
          _ -> Err("net_kernel: bad MONITOR_FIRE")
        end
    end
  end

  -- Peek at the frame tag (first element of the outer array) without full decode.
  fn frame_tag(bytes : List(Int)) : Option(Int) do
    match Msgpack.decode(bytes) do
      Err(_) -> None
      Ok(v)  ->
        match v do
          Msgpack.Array(Cons(Msgpack.Int(tag), _)) -> Some(tag)
          _ -> None
        end
    end
  end

end
