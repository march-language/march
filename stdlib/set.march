-- Set module: persistent hash-array-mapped-trie set.
--
-- Set(a) is an immutable, hash-indexed collection backed by a HAMT via the
-- Map module (Set(a) ≅ Map(a, Unit) internally).  This gives O(log₃₂ n)
-- ≈ O(1) amortized membership tests, insert, and delete.
--
-- Operations that need key identity take an explicit comparator:
--   cmp : a -> a -> Bool    where cmp(a)(b) = true means a < b
--
-- Standard comparators:
--   fn a -> fn b -> a < b        for Int or String elements (String: lexicographic)
--   Map.int_cmp / Map.str_cmp    the same, as named functions
--
-- Elements are located by `hash`; the comparator only decides equality among
-- elements whose hashes match, so it must agree with `==`.
--
-- Iteration order is hash-traversal order (not sorted).
-- Use to_list then sort externally if sorted order is needed.
-- For a set kept in sorted order, see SortedSet.
--
-- doc: try

mod Set do

  -- ── Internal representation ────────────────────────────────────────────────

  -- Set(a) is a thin wrapper around Map(a, Unit).
  -- We inline the same HAMT structure directly rather than nesting the Map
  -- wrapper to avoid an extra allocation layer.

  ptype SEntry(a) =
    SEmpty
    | SLeaf(Int, a)
    | SBranch(Int, List(SEntry(a)))
    | SCollision(Int, List(a))

  ptype Set(a) = HamtSet(Int, SEntry(a))

  -- ── The abstract contents ─────────────────────────────────────────────────
  -- A node's elements and its child list's elements call each other across
  -- two types (a branch holds a List of children).  `set_elts` is what `elts`
  -- means for a Set inside this module (`@[abstraction(elts)]`); a caller
  -- elsewhere keeps the opaque view, so its proofs only read the contracts.

  @[measure]
  pfn sentry_elts(n : SEntry(a)) : Set(a) do
    match n do
    SEmpty -> empty
    SLeaf(_, x) -> singleton(x)
    SBranch(_, cs) -> sentries_elts(cs)
    SCollision(_, xs) -> elts(xs)
    end
  end

  @[measure]
  pfn sentries_elts(cs : List(SEntry(a))) : Set(a) do
    match cs do
    Nil -> empty
    Cons(c, rest) -> union(sentry_elts(c), sentries_elts(rest))
    end
  end

  @[measure]
  @[abstraction(elts)]
  pfn set_elts(s : Set(a)) : Set(a) do
    match s do
    HamtSet(_, node) -> sentry_elts(node)
    end
  end

  -- ── Private helpers ────────────────────────────────────────────────────────

  pfn lst_rev(lst) do
    fn go(xs, acc) do
      match xs do
      Nil -> acc
      Cons(h, t) -> go(t, Cons(h, acc))
      end
    end
    go(lst, Nil)
  end

  -- The one law the contents proofs trust: `cmp` is a strict total order
  -- that agrees with `==`, so "neither is below the other" is equality.  Every
  -- comparator-taking function documents the same requirement.
  @[assume]
  pfn cmp_eq(cmp : a -> a -> Bool, x : a, y : a) : {Bool | _ == (x == y)} do
    let lt_xy = cmp(x)
    let lt_yx = cmp(y)
    if lt_xy(y) do false
    else if lt_yx(x) do false
    else true end end
  end

  pfn key_hash(k) do
    int_and(hash(k), 1073741823)
  end

  pfn hash_slot(h, level) do
    int_and(int_shr(h, level * 5), 31)
  end

  pfn bitmap_has(bitmap, idx) do
    int_and(int_shr(bitmap, idx), 1) == 1
  end

  pfn bitmap_rank(bitmap, idx) do
    int_popcount(int_and(bitmap, int_shl(1, idx) - 1))
  end

  pfn bitmap_set(bitmap, idx) do
    int_or(bitmap, int_shl(1, idx))
  end

  pfn bitmap_clear(bitmap, idx) do
    int_and(bitmap, int_not(int_shl(1, idx)))
  end

  pfn insert_at(lst : List(SEntry(a)), idx : Int, e : SEntry(a)) : {List(SEntry(a)) | sentries_elts(_) == union(sentries_elts(lst), sentry_elts(e))} do
    match lst do
    Nil -> Cons(e, Nil)
    Cons(h, t) -> if idx == 0 do Cons(e, lst) else Cons(h, insert_at(t, idx - 1, e)) end
    end
  end

  pfn list_replace_at(lst, idx, elem) do
    fn rev_onto(rev_xs, ys) do
      match rev_xs do
      Nil -> ys
      Cons(h, t) -> rev_onto(t, Cons(h, ys))
      end
    end
    fn go(xs, i, acc) do
      match xs do
      Nil -> rev_onto(acc, Nil)
      Cons(h, t) -> do
        if i == 0 do rev_onto(acc, Cons(elem, t))
        else go(t, i - 1, Cons(h, acc)) end
      end
      end
    end
    go(lst, idx, Nil)
  end

  pfn list_delete_at(lst, idx) do
    fn rev_onto(rev_xs, ys) do
      match rev_xs do
      Nil -> ys
      Cons(h, t) -> rev_onto(t, Cons(h, ys))
      end
    end
    fn go(xs, i, acc) do
      match xs do
      Nil -> rev_onto(acc, Nil)
      Cons(h, t) -> do
        if i == 0 do rev_onto(acc, t)
        else go(t, i - 1, Cons(h, acc)) end
      end
      end
    end
    go(lst, idx, Nil)
  end

  pfn list_nth_safe(lst, n) do
    match lst do
    Nil -> panic("Set: HAMT node index out of range")
    Cons(h, t) ->
      if n == 0 do h else list_nth_safe(t, n - 1) end
    end
  end

  pfn coll_has(elems, x, eq) do
    match elems do
    Nil -> false
    Cons(e, rest) ->
      if eq(e, x) do true else coll_has(rest, x, eq) end
    end
  end

  pfn coll_mem(elems : List(a), x : a, cmp : a -> a -> Bool) : {Bool | _ == member(x, elts(elems))} do
    match elems do
    Nil -> false
    Cons(e, rest) -> if cmp_eq(cmp, e, x) do true else coll_mem(rest, x, cmp) end
    end
  end

  pfn coll_add(elems : List(a), x : a, cmp : a -> a -> Bool) : {List(a) | elts(_) == union(elts(elems), singleton(x))} do
    if coll_mem(elems, x, cmp) do elems else Cons(x, elems) end
  end

  pfn coll_remove_elem(elems, x, eq) do
    fn rev_onto(rev_xs, ys) do
      match rev_xs do
      Nil -> ys
      Cons(h, t) -> rev_onto(t, Cons(h, ys))
      end
    end
    fn go(es, acc) do
      match es do
      Nil -> rev_onto(acc, Nil)
      Cons(e, rest) -> do
        if eq(e, x) do rev_onto(acc, rest)
        else go(rest, Cons(e, acc)) end
      end
      end
    end
    go(elems, Nil)
  end

  -- ── HAMT core ─────────────────────────────────────────────────────────────

  pfn node_contains(node, x, h, eq, level) do
    match node do
    SEmpty -> false
    SLeaf(lh, lx) ->
      lh == h && eq(lx, x)
    SCollision(ch, elems) ->
      ch == h && coll_has(elems, x, eq)
    SBranch(bitmap, children) -> do
      let slot = hash_slot(h, level)
      if bitmap_has(bitmap, slot) do
        let idx = bitmap_rank(bitmap, slot)
        let child = list_nth_safe(children, idx)
        node_contains(child, x, h, eq, level + 1)
      else false end
    end
    end
  end

  -- Two nodes with distinct hashes, placed under the levels where their
  -- slots agree.  Each level a pair shares a slot wraps it in a one-child
  -- branch (`wrap_slots`, innermost first).
  pfn wrap_slots(nd : SEntry(a), slots : List(Int)) : {SEntry(a) | sentry_elts(_) == sentry_elts(nd)} do
    match slots do
    Nil -> nd
    Cons(s, rest) -> wrap_slots(SBranch(bitmap_set(0, s), Cons(nd, Nil)), rest)
    end
  end

  pfn wrap_pair(bm : Int, first : SEntry(a), second : SEntry(a), slots : List(Int)) : {SEntry(a) | sentry_elts(_) == union(sentry_elts(first), sentry_elts(second))} do
    wrap_slots(SBranch(bm, Cons(first, Cons(second, Nil))), slots)
  end

  -- Hashes are 30 bits (`key_hash`), five per level, so two distinct hashes
  -- differ at some level below 6 and the `lvl > 6` arm is unreachable.
  @[decreases(7 - lvl)]
  pfn branch_nodes(h1 : Int, n1 : SEntry(a), h2 : Int, n2 : SEntry(a), lvl : Int, acc : List(Int)) : {SEntry(a) | sentry_elts(_) == union(sentry_elts(n1), sentry_elts(n2))} do
    if lvl > 6 do panic("Set: two distinct hashes share every slot")
    else do
      let s1 = hash_slot(h1, lvl)
      let s2 = hash_slot(h2, lvl)
      if s1 == s2 do
        branch_nodes(h1, n1, h2, n2, lvl + 1, Cons(s1, acc))
      else do
        let bm = bitmap_set(bitmap_set(0, s1), s2)
        if s1 < s2 do wrap_pair(bm, n1, n2, acc) else wrap_pair(bm, n2, n1, acc) end
      end end
    end end
  end

  -- Insert into the child at `idx`, in one pass over the child list.
  pfn insert_child(cs : List(SEntry(a)), idx : Int, x : a, h : Int, cmp : a -> a -> Bool, level : Int) : {List(SEntry(a)) | sentries_elts(_) == union(sentries_elts(cs), singleton(x))} do
    match cs do
    Nil -> panic("Set: HAMT node index out of range")
    Cons(c, rest) ->
      if idx == 0 do Cons(node_insert(c, x, h, cmp, level), rest)
      else Cons(c, insert_child(rest, idx - 1, x, h, cmp, level)) end
    end
  end

  -- Membership by the hash path, first-order and structurally recursive (a
  -- branch's child is found by walking its list), so a function calling it
  -- keeps its induction hypotheses: `node_contains` recurses through a closure
  -- and through `list_nth_safe`'s result, which the checker cannot certify.
  pfn node_mem(node : SEntry(a), x : a, h : Int, cmp : a -> a -> Bool, level : Int) : Bool do
    match node do
    SEmpty -> false
    SLeaf(lh, lx) -> lh == h && cmp_eq(cmp, lx, x)
    SCollision(ch, elems) -> ch == h && coll_mem(elems, x, cmp)
    SBranch(bitmap, children) ->
      let slot = hash_slot(h, level)
      if bitmap_has(bitmap, slot) do child_mem(children, bitmap_rank(bitmap, slot), x, h, cmp, level + 1)
      else false end
    end
  end

  pfn child_mem(cs : List(SEntry(a)), idx : Int, x : a, h : Int, cmp : a -> a -> Bool, level : Int) : Bool do
    match cs do
    Nil -> panic("Set: HAMT node index out of range")
    Cons(c, rest) ->
      if idx == 0 do node_mem(c, x, h, cmp, level)
      else child_mem(rest, idx - 1, x, h, cmp, level) end
    end
  end

  pfn node_insert(node : SEntry(a), x : a, h : Int, cmp : a -> a -> Bool, level : Int) : {SEntry(a) | sentry_elts(_) == union(sentry_elts(node), singleton(x))} do
    match node do
    SEmpty -> SLeaf(h, x)
    SLeaf(lh, lx) ->
      if lh == h do
        if cmp_eq(cmp, lx, x) do node else SCollision(h, Cons(lx, Cons(x, Nil))) end
      else branch_nodes(lh, node, h, SLeaf(h, x), level, Nil) end
    SCollision(ch, elems) ->
      if ch == h do SCollision(ch, coll_add(elems, x, cmp))
      else branch_nodes(ch, node, h, SLeaf(h, x), level, Nil) end
    SBranch(bitmap, children) ->
      let slot = hash_slot(h, level)
      let idx = bitmap_rank(bitmap, slot)
      if bitmap_has(bitmap, slot) do SBranch(bitmap, insert_child(children, idx, x, h, cmp, level + 1))
      else SBranch(bitmap_set(bitmap, slot), insert_at(children, idx, SLeaf(h, x))) end
    end
  end

  pfn node_remove(node, x, h, eq, level) do
    match node do
    SEmpty -> SEmpty
    SLeaf(lh, lx) ->
      if lh == h && eq(lx, x) do SEmpty else node end
    SCollision(ch, elems) -> do
      if ch != h do node
      else do
        let new_elems = coll_remove_elem(elems, x, eq)
        match new_elems do
        Nil -> SEmpty
        Cons(sole, Nil) -> SLeaf(ch, sole)
        _ -> SCollision(ch, new_elems)
        end end
      end
    end
    SBranch(bitmap, children) -> do
      let slot = hash_slot(h, level)
      if bitmap_has(bitmap, slot) do
        let idx = bitmap_rank(bitmap, slot)
        let child = list_nth_safe(children, idx)
        let new_child = node_remove(child, x, h, eq, level + 1)
        match new_child do
        SEmpty -> do
          let new_bm = bitmap_clear(bitmap, slot)
          let new_children = list_delete_at(children, idx)
          match new_children do
          Nil -> SEmpty
          Cons(sole, Nil) ->
            match sole do
            SLeaf(_, _) -> sole
            SCollision(_, _) -> sole
            _ -> SBranch(new_bm, new_children)
            end
          _ -> SBranch(new_bm, new_children)
          end
        end
        _ ->
          SBranch(bitmap, list_replace_at(children, idx, new_child))
        end
      else node end
    end
    end
  end

  pfn node_fold(acc, node, f) do
    match node do
    SEmpty -> acc
    SLeaf(_, x) -> f(acc, x)
    SCollision(_, elems) -> do
      fn go(a, es) do
        match es do
        Nil -> a
        Cons(e, rest) -> go(f(a, e), rest)
        end
      end
      go(acc, elems)
    end
    SBranch(_, children) -> do
      fn go(a, cs) do
        match cs do
        Nil -> a
        Cons(child, rest) ->
          go(node_fold(a, child, f), rest)
        end
      end
      go(acc, children)
    end
    end
  end

  pfn node_size(node) do
    match node do
    SEmpty -> 0
    SLeaf(_, _) -> 1
    SCollision(_, elems) -> do
      fn count(es, n) do
        match es do
        Nil -> n
        Cons(_, rest) -> count(rest, n + 1)
        end
      end
      count(elems, 0)
    end
    SBranch(_, children) -> do
      fn go(acc, cs) do
        match cs do
        Nil -> acc
        Cons(child, rest) -> go(acc + node_size(child), rest)
        end
      end
      go(0, children)
    end
    end
  end

  -- ── First-order walks over the contents ────────────────────────────────────
  -- `union`, `from_list` and `to_list` visit elements in `node_fold`'s order
  -- (a collision's list in order, a branch's children in order) as plain
  -- recursion, so each states what it adds to its accumulator.

  pfn insert_list(acc : Set(a), xs : List(a), cmp : a -> a -> Bool) : {Set(a) | elts(_) == union(elts(acc), elts(xs))} do
    match xs do
    Nil -> acc
    Cons(x, rest) -> insert_list(insert(acc, x, cmp), rest, cmp)
    end
  end

  pfn insert_node(acc : Set(a), node : SEntry(a), cmp : a -> a -> Bool) : {Set(a) | elts(_) == union(elts(acc), sentry_elts(node))} do
    match node do
    SEmpty -> acc
    SLeaf(_, x) -> insert(acc, x, cmp)
    SCollision(_, xs) -> insert_list(acc, xs, cmp)
    SBranch(_, cs) -> insert_children(acc, cs, cmp)
    end
  end

  pfn insert_children(acc : Set(a), cs : List(SEntry(a)), cmp : a -> a -> Bool) : {Set(a) | elts(_) == union(elts(acc), sentries_elts(cs))} do
    match cs do
    Nil -> acc
    Cons(c, rest) -> insert_children(insert_node(acc, c, cmp), rest, cmp)
    end
  end

  pfn list_rev_onto(xs : List(a), acc : List(a)) : {List(a) | elts(_) == union(elts(xs), elts(acc))} do
    match xs do
    Nil -> acc
    Cons(x, rest) -> list_rev_onto(rest, Cons(x, acc))
    end
  end

  -- The elements in reverse traversal order, onto `acc`.
  pfn node_rev_onto(node : SEntry(a), acc : List(a)) : {List(a) | elts(_) == union(sentry_elts(node), elts(acc))} do
    match node do
    SEmpty -> acc
    SLeaf(_, x) -> Cons(x, acc)
    SCollision(_, xs) -> list_rev_onto(xs, acc)
    SBranch(_, cs) -> children_rev_onto(cs, acc)
    end
  end

  pfn children_rev_onto(cs : List(SEntry(a)), acc : List(a)) : {List(a) | elts(_) == union(sentries_elts(cs), elts(acc))} do
    match cs do
    Nil -> acc
    Cons(c, rest) -> children_rev_onto(rest, node_rev_onto(c, acc))
    end
  end

  -- ── Public API ─────────────────────────────────────────────────────────────

  doc """
  Returns an empty set.

  ## Examples

      march> Set.size(Set.empty())
      0

  This contract is proved against the trie. See docs/refinement-types.md,
  "Set Refinements".
  """
  fn empty() : {Set(a) | elts(_) == empty} do
    HamtSet(0, SEmpty)
  end

  doc """
  Returns a set containing exactly one element.

  ## Examples

      march> Set.to_list(Set.singleton("a"))
      ["a"]

  This contract is proved against the trie. See docs/refinement-types.md,
  "Set Refinements".
  """
  fn singleton(x : a) : {Set(a) | elts(_) == singleton(x)} do
    let h = key_hash(x)
    HamtSet(1, SLeaf(h, x))
  end

  -- ---- Query ----

  doc """
  Returns true if the set contains no elements.

  ## Examples

      march> Set.is_empty(Set.empty())
      true
      march> Set.is_empty(Set.from_list([1], fn a -> fn b -> a < b))
      false

  This contract is ASSUMED, not proved: the set of elements is a fact about
  the abstract set (`elts`) the refinement checker takes on faith, and it
  holds only when `cmp` is a strict total order consistent with `==` on the
  element type. See docs/refinement-types.md, "Set Refinements".
  """
  @[assume]
  fn is_empty(s) : {Bool | _ == (elts(s) == empty)} do
    match s do
    HamtSet(n, _) -> n == 0
    end
  end

  doc """
  Returns the number of elements in the set. O(1): the count is cached.

  ## Examples

      march> Set.size(Set.from_list([1, 2, 2, 3], fn a -> fn b -> a < b))
      3

  This contract is ASSUMED, not proved: the element count is a fact about the
  abstract set (`card(elts(s))`) the refinement checker takes on faith, and it
  holds only when `cmp` is a strict total order consistent with `==` on the
  element type. See docs/refinement-types.md, "Set Refinements".
  """
  @[assume]
  fn size(s) : {Int | _ == card(elts(s))} do
    match s do
    HamtSet(n, _) -> n
    end
  end

  doc """
  Returns true if the set contains elem.
  cmp : a -> a -> Bool where cmp(a)(b) = true means a < b.

  ## Examples

      march> let s1 = Set.from_list(["a", "b"], fn a -> fn b -> a < b)
      march> Set.contains(s1, "a", fn a -> fn b -> a < b)
      true
      march> let s1 = Set.from_list(["a", "b"], fn a -> fn b -> a < b)
      march> Set.contains(s1, "z", fn a -> fn b -> a < b)
      false

  This contract is ASSUMED, not proved: the set of elements is a fact about
  the abstract set (`elts`) the refinement checker takes on faith, and it
  holds only when `cmp` is a strict total order consistent with `==` on the
  element type. See docs/refinement-types.md, "Set Refinements".
  """
  @[assume]
  fn contains(s, elem, cmp) : {Bool | _ == member(elem, elts(s))} do
    match s do
    HamtSet(_, node) -> do
      let h = key_hash(elem)
      let eq = fn (a, b) -> cmp_eq(cmp, a, b)
      node_contains(node, elem, h, eq, 0)
    end
    end
  end

  -- ---- Modification ----

  doc """
  Inserts elem into the set. Returns the set unchanged if elem is already present.
  cmp : a -> a -> Bool where cmp(a)(b) = true means a < b.

  ## Examples

      march> let s2 = Set.insert(Set.singleton(1), 2, fn a -> fn b -> a < b)
      march> Set.size(s2)
      2
      march> let s2 = Set.insert(Set.singleton(1), 2, fn a -> fn b -> a < b)
      march> Set.size(Set.insert(s2, 1, fn a -> fn b -> a < b))
      2

  This contract is proved against the trie, trusting one law: `cmp` is a
  strict total order consistent with `==` on the element type. See
  docs/refinement-types.md, "Set Refinements".
  """
  fn insert(s : Set(a), elem : a, cmp : a -> a -> Bool) : {Set(a) | elts(_) == union(elts(s), singleton(elem))} do
    match s do
    HamtSet(n, node) -> do
      let h = key_hash(elem)
      let already = node_mem(node, elem, h, cmp, 0)
      HamtSet(if already do n else n + 1 end, node_insert(node, elem, h, cmp, 0))
    end
    end
  end

  doc """
  Removes elem from the set. Returns the set unchanged if elem is absent.
  cmp : a -> a -> Bool where cmp(a)(b) = true means a < b.

  ## Examples

      march> let s3 = Set.from_list([1, 2], fn a -> fn b -> a < b)
      march> Set.to_list(Set.remove(s3, 1, fn a -> fn b -> a < b))
      [2]
      march> let s3 = Set.from_list([1, 2], fn a -> fn b -> a < b)
      march> Set.size(Set.remove(s3, 9, fn a -> fn b -> a < b))
      2

  This contract is ASSUMED, not proved: the set of elements is a fact about
  the abstract set (`elts`) the refinement checker takes on faith, and it
  holds only when `cmp` is a strict total order consistent with `==` on the
  element type. See docs/refinement-types.md, "Set Refinements".
  """
  @[assume]
  fn remove(s, elem, cmp) : {Set(a) | elts(_) == diff(elts(s), singleton(elem))} do
    match s do
    HamtSet(n, node) -> do
      let h = key_hash(elem)
      let eq = fn (a, b) -> cmp_eq(cmp, a, b)
      let present = node_contains(node, elem, h, eq, 0)
      HamtSet(if present do n - 1 else n end, node_remove(node, elem, h, eq, 0))
    end
    end
  end

  -- ---- Set operations ----

  doc """
  Returns the union of two sets (all elements in either set).
  Inserts each element of b into a: O(m) inserts for m = size(b).
  cmp : a -> a -> Bool where cmp(a)(b) = true means a < b.

  ## Examples

      march> let ua = Set.from_list([1, 2], fn a -> fn b -> a < b)
      march> let ub = Set.from_list([2, 3], fn a -> fn b -> a < b)
      march> List.sort_by(Set.to_list(Set.union(ua, ub, fn a -> fn b -> a < b)), fn (x, y) -> x < y)
      [1, 2, 3]

  This contract is proved against the trie, trusting one law: `cmp` is a
  strict total order consistent with `==` on the element type. See
  docs/refinement-types.md, "Set Refinements".
  """
  fn union(a : Set(a), b : Set(a), cmp : a -> a -> Bool) : {Set(a) | elts(_) == union(elts(a), elts(b))} do
    match b do
    HamtSet(_, node) -> insert_node(a, node, cmp)
    end
  end

  doc """
  Returns the intersection of two sets (elements in both sets).
  cmp : a -> a -> Bool where cmp(a)(b) = true means a < b.

  ## Examples

      march> let ia = Set.from_list([1, 2, 3], fn a -> fn b -> a < b)
      march> List.sort_by(Set.to_list(Set.intersection(ia, Set.from_list([2, 3, 4], fn a -> fn b -> a < b), fn a -> fn b -> a < b)), fn (x, y) -> x < y)
      [2, 3]
      march> let ia = Set.from_list([1, 2, 3], fn a -> fn b -> a < b)
      march> Set.is_empty(Set.intersection(ia, Set.from_list([9], fn a -> fn b -> a < b), fn a -> fn b -> a < b))
      true

  This contract is ASSUMED, not proved: the set of elements is a fact about
  the abstract set (`elts`) the refinement checker takes on faith, and it
  holds only when `cmp` is a strict total order consistent with `==` on the
  element type. See docs/refinement-types.md, "Set Refinements".
  """
  @[assume]
  fn intersection(a, b, cmp) : {Set(a) | elts(_) == inter(elts(a), elts(b))} do
    fn go(acc, x) do
      if contains(b, x, cmp) do insert(acc, x, cmp)
      else acc end
    end
    match a do
    HamtSet(_, node) ->
      node_fold(empty(), node, go)
    end
  end

  doc """
  Returns elements in a that are not in b (set difference a \\ b).
  cmp : a -> a -> Bool where cmp(a)(b) = true means a < b.

  ## Examples

      march> let da = Set.from_list([1, 2, 3], fn a -> fn b -> a < b)
      march> List.sort_by(Set.to_list(Set.difference(da, Set.from_list([2, 9], fn a -> fn b -> a < b), fn a -> fn b -> a < b)), fn (x, y) -> x < y)
      [1, 3]

  This contract is ASSUMED, not proved: the set of elements is a fact about
  the abstract set (`elts`) the refinement checker takes on faith, and it
  holds only when `cmp` is a strict total order consistent with `==` on the
  element type. See docs/refinement-types.md, "Set Refinements".
  """
  @[assume]
  fn difference(a, b, cmp) : {Set(a) | elts(_) == diff(elts(a), elts(b))} do
    fn go(acc, x) do
      if contains(b, x, cmp) do acc
      else insert(acc, x, cmp) end
    end
    match a do
    HamtSet(_, node) ->
      node_fold(empty(), node, go)
    end
  end

  doc """
  Returns true if a is a subset of b (every element of a is in b).  The
  empty set is a subset of every set.
  cmp : a -> a -> Bool where cmp(a)(b) = true means a < b.

  ## Examples

      march> let sb = Set.from_list([1, 2, 3], fn a -> fn b -> a < b)
      march> Set.is_subset(Set.from_list([1, 3], fn a -> fn b -> a < b), sb, fn a -> fn b -> a < b)
      true
      march> let sb = Set.from_list([1, 2, 3], fn a -> fn b -> a < b)
      march> Set.is_subset(Set.from_list([1, 4], fn a -> fn b -> a < b), sb, fn a -> fn b -> a < b)
      false
      march> let sb = Set.from_list([1, 2, 3], fn a -> fn b -> a < b)
      march> Set.is_subset(Set.empty(), sb, fn a -> fn b -> a < b)
      true

  This contract is ASSUMED, not proved: the set of elements is a fact about
  the abstract set (`elts`) the refinement checker takes on faith, and it
  holds only when `cmp` is a strict total order consistent with `==` on the
  element type. See docs/refinement-types.md, "Set Refinements".
  """
  @[assume]
  fn is_subset(a, b, cmp) : {Bool | _ == subset(elts(a), elts(b))} do
    fn check(ok, x) do
      ok && contains(b, x, cmp)
    end
    match a do
    HamtSet(_, node) ->
      node_fold(true, node, check)
    end
  end

  -- ---- Traversal ----

  doc """
  Returns all elements as a list (hash-traversal order, not sorted).

  ## Examples

      march> List.sort_by(Set.to_list(Set.from_list(["b", "a", "b"], fn a -> fn b -> a < b)), fn (x, y) -> x < y)
      ["a", "b"]

  This contract is proved against the trie. See docs/refinement-types.md,
  "Set Refinements".
  """
  fn to_list(s : Set(a)) : {List(a) | elts(_) == elts(s)} do
    match s do
    HamtSet(_, node) -> list_rev_onto(node_rev_onto(node, Nil), Nil)
    end
  end

  doc """
  Builds a set from a list of elements; duplicates are kept once.
  cmp : a -> a -> Bool where cmp(a)(b) = true means a < b.

  ## Examples

      march> Set.size(Set.from_list([3, 1, 3, 2, 1], fn a -> fn b -> a < b))
      3
      march> Set.is_empty(Set.from_list([], fn a -> fn b -> a < b))
      true

  This contract is proved against the trie, trusting one law: `cmp` is a
  strict total order consistent with `==` on the element type. See
  docs/refinement-types.md, "Set Refinements".
  """
  fn from_list(xs : List(a), cmp : a -> a -> Bool) : {Set(a) | elts(_) == elts(xs)} do
    insert_list(empty(), xs, cmp)
  end

  doc """
  Left fold over all elements.  Argument order: collection first, init
  second, callback last (uncurried-collection convention).  The
  callback `f` is called uncurried as `f(acc, elem) = new_acc`.  Elements
  are visited in hash-traversal order. Generic in the accumulator `b`, so a
  refinement demanded of the result is checked as an invariant of `acc` (see
  docs/refinement-types.md, "Folds").

  ## Examples

      march> Set.fold(Set.from_list([1, 2, 3], fn a -> fn b -> a < b), 0, fn (acc, x) -> acc + x)
      6
  """
  fn fold(s : Set(a), acc : b, f : b -> a -> b) : b do
    match s do
    HamtSet(_, node) ->
      node_fold(acc, node, f)
    end
  end

  doc """
  Returns true if the two sets contain the same elements, regardless of
  the order they were inserted in.  O(n) membership checks.
  cmp : a -> a -> Bool where cmp(a)(b) = true means a < b.

  ## Examples

      march> Set.eq(Set.from_list([1, 2], fn a -> fn b -> a < b), Set.from_list([2, 1], fn a -> fn b -> a < b), fn a -> fn b -> a < b)
      true
      march> Set.eq(Set.from_list([1, 2], fn a -> fn b -> a < b), Set.from_list([1], fn a -> fn b -> a < b), fn a -> fn b -> a < b)
      false

  This contract is ASSUMED, not proved: the set of elements is a fact about
  the abstract set (`elts`) the refinement checker takes on faith, and it
  holds only when `cmp` is a strict total order consistent with `==` on the
  element type. See docs/refinement-types.md, "Set Refinements".
  """
  @[assume]
  fn eq(a, b, cmp) : {Bool | _ == (elts(a) == elts(b))} do
    let sa = size(a)
    let sb = size(b)
    if sa != sb do false
    else do
      fn check(ok, x) do
        ok && contains(b, x, cmp)
      end
      match a do
      HamtSet(_, node) ->
        node_fold(true, node, check)
      end end
    end
  end

end
