-- RRB.Vec — persistent sequence for bulk-parallel work.
--
-- v2: backed by Array (32-way trie, O(1) amortised push, O(log₃₂ n) get).
--
-- A Slice is a zero-copy window into a Vec: Slice(arr, lo, hi).
-- chunk(v, n) creates n Slices in O(n) — the underlying Array is shared.
-- fold(s, z, f) iterates [lo, hi) using O(1)-amortised Array.get.
--
-- Complexity summary:
--   empty, singleton, is_empty, length  O(1)
--   get, set                            O(log₃₂ n)
--   push                                O(1) amortised
--   concat(l, r)                        O(len(r) · log₃₂(len(l)+len(r)))
--   slice(v, lo, hi)                    O(1)
--   chunk(v, n)                         O(n)
--   fold(slice, z, f)                   O((hi-lo) · log₃₂ n)
--   from_list, to_list, tabulate, range O(n)
--   map, fold_left, each                O(n)
--
-- ## Examples
--
--     march> let v = RRB.from_list([1, 2, 3, 4, 5])
--     march> RRB.length(v)
--     5
--     march> let s = RRB.slice(v, 1, 4)
--     march> RRB.fold(s, 0, fn (acc, x) -> acc + x)
--     9

mod RRB do

  -- ── Internal helpers ──────────────────────────────────────────────────────

  pfn imax(a: Int, b: Int): Int do if a > b do a else b end end
  pfn imin(a: Int, b: Int): Int do if a < b do a else b end end

  -- ── Types ─────────────────────────────────────────────────────────────────

  -- Persistent sequence. Wraps the Array module's 32-way trie PVec.
  -- Constructors are private; use the public API below.
  ptype Vec(a) = Vec(Array(a))

  -- Zero-copy contiguous window into a Vec: [lo, hi).
  -- Created by slice/chunk; iterated by fold.
  ptype Slice(a) = Slice(Array(a), Int, Int)

  -- ── Construction ──────────────────────────────────────────────────────────

  doc "An empty `Vec`. O(1)."
  fn empty(): Vec(a) do Vec(Array.empty()) end

  doc "A `Vec` containing exactly one element. O(1)."
  fn singleton(x: a): Vec(a) do Vec(Array.push(Array.empty(), x)) end

  doc "Build a `Vec` from a list. O(n)."
  fn from_list(xs: List(a)): Vec(a) do Vec(Array.from_list(xs)) end

  doc "Wrap an `Array` as a `Vec`. O(1)."
  fn from_array(xs: Array(a)): Vec(a) do Vec(xs) end

  doc """
  Build a `Vec` of length `n` by calling `f(i)` for each index i ∈ [0, n).
  O(n).

  ## Examples

      march> RRB.to_list(RRB.tabulate(4, fn i -> i * i))
      [0, 1, 4, 9]
  """
  fn tabulate(n: Int, f: Int -> a): Vec(a) do
    let count = imax(n, 0)
    fn go(i: Int, arr): Vec(a) do
      if i >= count do Vec(arr)
      else go(i + 1, Array.push(arr, f(i)))
      end
    end
    go(0, Array.empty())
  end

  doc """
  Build a `Vec` of consecutive integers `[lo, lo+1, …, hi-1]`. O(hi-lo).

  ## Examples

      march> RRB.to_list(RRB.range(1, 5))
      [1, 2, 3, 4]
  """
  fn range(lo: Int, hi: Int): Vec(Int) do
    tabulate(imax(hi - lo, 0), fn i -> lo + i)
  end

  -- ── Basic access ──────────────────────────────────────────────────────────

  doc "Number of elements. O(1)."
  fn length(v: Vec(a)): Int do
    match v do Vec(arr) -> Array.length(arr) end
  end

  doc "True when the `Vec` is empty. O(1)."
  fn is_empty(v: Vec(a)): Bool do
    match v do Vec(arr) -> Array.is_empty(arr) end
  end

  doc """
  Return element at 0-based index `i`. O(log₃₂ n).
  Panics if out of bounds.

  ## Examples

      march> RRB.get(RRB.from_list([10, 20, 30]), 1)
      20
  """
  fn get(v: Vec(a), i: Int): a do
    match v do Vec(arr) ->
      if i < 0 || i >= Array.length(arr) do panic("RRB.get: index out of bounds")
      else Array.get(arr, i)
      end
    end
  end

  -- ── Modification ──────────────────────────────────────────────────────────

  doc "Append `x` at the end. Returns a new `Vec`. O(1) amortised."
  fn push(v: Vec(a), x: a): Vec(a) do
    match v do Vec(arr) -> Vec(Array.push(arr, x)) end
  end

  doc """
  Concatenate two `Vec`s: all elements of `l` followed by all of `r`.
  O(len(r) · log₃₂(len(l)+len(r))).

  ## Examples

      march> RRB.to_list(RRB.concat(RRB.from_list([1,2]), RRB.from_list([3,4])))
      [1, 2, 3, 4]
  """
  fn concat(l: Vec(a), r: Vec(a)): Vec(a) do
    match r do Vec(arr_r) ->
      Array.fold_left(arr_r, l, fn (acc, x) -> push(acc, x))
    end
  end

  -- ── Slices ────────────────────────────────────────────────────────────────

  doc """
  Create a `Slice` covering the half-open range [lo, hi). O(1).

  Indices are clamped to [0, length(v)]; lo > hi (after clamping) yields
  an empty slice.

  ## Examples

      march> RRB.fold(RRB.slice(RRB.range(0, 5), 1, 4), 0, fn (a, x) -> a + x)
      6
  """
  fn slice(v: Vec(a), lo: Int, hi: Int): Slice(a) do
    match v do Vec(arr) ->
      let total = Array.length(arr)
      let lo2 = imax(0, imin(lo, total))
      let hi2 = imax(lo2, imin(hi, total))
      Slice(arr, lo2, hi2)
    end
  end

  doc """
  Left fold over a `Slice` in index order. `f(acc, elem) = new_acc`.
  O((hi-lo) · log₃₂ n).

  This is the hot path inside each parallel worker: it visits only the
  elements in the slice's range without copying or allocating.

  ## Examples

      march> let s = RRB.slice(RRB.range(0, 5), 1, 4)
      march> RRB.fold(s, 0, fn (acc, x) -> acc + x)
      6
  """
  fn fold(s: Slice(a), zero: b, f): b do
    match s do Slice(arr, lo, hi) ->
      fn go(i: Int, acc: b): b do
        if i >= hi do acc
        else go(i + 1, f(acc, Array.get(arr, i)))
        end
      end
      go(lo, zero)
    end
  end

  doc """
  Split `v` into `n` roughly equal contiguous `Slice`s in index order.
  Returns an Array of Slices. Each Slice is a zero-copy view (O(1) to create).
  O(n) total.

  Edge cases:
  - `n <= 0` is treated as 1.
  - `n > length(v)` is clamped to `length(v)` (no empty slices).
  - Empty `v` returns an empty Array.

  ## Examples

      march> let v = RRB.range(0, 6)
      march> Array.length(RRB.chunk(v, 3))
      3
  """
  fn chunk(v: Vec(a), n: Int) do
    match v do Vec(arr) -> do
      let total = Array.length(arr)
      if total == 0 do Array.from_list(Nil)
      else do
        let workers = imax(1, imin(n, total))
        let base    = int_div(total, workers)
        let rem     = total - base * workers
        fn go(i: Int, acc: List(Slice(a))): List(Slice(a)) do
          if i < 0 do acc
          else do
            let lo    = i * base + imin(i, rem)
            let extra = if i < rem do 1 else 0 end
            let hi    = lo + base + extra
            go(i - 1, Cons(Slice(arr, lo, hi), acc))
          end
          end
        end
        Array.from_list(go(workers - 1, Nil))
      end
      end
    end
    end
  end

  -- ── Conversion ────────────────────────────────────────────────────────────

  doc "Return all elements as a list in index order. O(n)."
  fn to_list(v: Vec(a)): List(a) do
    match v do Vec(arr) -> Array.to_list(arr) end
  end

  doc "Return the underlying `Array`. O(1)."
  fn to_array(v: Vec(a)): Array(a) do
    match v do Vec(arr) -> arr end
  end

  -- ── Bulk operations ───────────────────────────────────────────────────────

  doc "Apply `f` to each element for side effects. O(n)."
  fn each(v: Vec(a), f: a -> Unit): Unit do
    fold_left(v, (), fn (_, x) -> f(x))
  end

  doc """
  Apply `f` to every element, collecting results in a new `Vec`. O(n).

  For parallel map, use `Parallel.pmap` instead — this is the sequential
  version.
  """
  fn map(v: Vec(a), f: a -> b): Vec(b) do
    match v do Vec(arr) -> Vec(Array.map(arr, f)) end
  end

  doc """
  Left fold over all elements. `f(acc, elem) = new_acc`. O(n).

  ## Examples

      march> RRB.fold_left(RRB.from_list([1, 2, 3]), 0, fn (acc, x) -> acc + x)
      6
  """
  fn fold_left(v: Vec(a), zero: b, f): b do
    let s = slice(v, 0, length(v))
    fold(s, zero, f)
  end

end
