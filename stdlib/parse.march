-- Parse module: parser combinator core.
--
-- Design: specs/plans/2026-08-09-parsing-and-string-search.md
--
-- Two commitments shape every type in here:
--
--   1. **Byte offsets, not code points.** Position is an Int index into the
--      input string, and input is inspected with `string_byte_at`, which
--      returns 0..255 (or -1 past the end) and allocates nothing.  March has
--      no character literal, so the byte primitive takes an Int code and the
--      ergonomic primitive is `lit`, which takes a String.
--
--   2. **Errors are the product, so the success path must not pay for them.**
--      `ROk` carries only integers alongside the value — in particular the
--      furthest offset any sub-parse failed at, which `alt` needs in order to
--      report the alternative that got deepest rather than the one listed
--      last.  Expected-sets and context stacks are built only on failure.
--
-- Failure is split into two constructors rather than a boolean flag, so that
-- ordered choice cannot forget to check it:
--
--   RFail  soft — `alt` may try the next alternative
--   RCut   hard — a commit point was passed; propagate, do not backtrack
--
-- Primitives:      lit, byte, byte_if, take_while, take_while1, eof, pure
-- Sequencing:      and_then, skip_then, skip_first, map, flat_map, delay
-- Optionality:     optional
-- Choice:          alt
-- Repetition:      many, many1, repeat, sep_by, sep_by1
-- Error control:   commit, then_commit, ctx, label, fence, recover
-- Running:         run
-- Rendering:       render, line_col
--
-- Still to come: the golden error-message corpus (plan §3.7), and an
-- OCaml-side renderer into lib/errors so library and compiler diagnostics
-- are indistinguishable.

mod Parse do

  -- What a parser was looking for at the offset it failed.  `ExpLabel` is the
  -- human-named class a `label` combinator substitutes for raw token soup.
  type Expected =
      ExpLit(String)
    | ExpLabel(String)
    | ExpEof

  -- A failure.  `pos` is the furthest byte offset reached, `expected` is the
  -- merged expected-set AT that offset, and `context` is a stack of
  -- (name, start_offset) frames pushed by commit points, used to render
  -- "expected `end` to close the `if` that started at 12:1".
  type ParseErr = {
    pos:      Int,
    expected: List(Expected),
    context:  List((String, Int))
  }

  -- ROk carries: value, new position, furthest-failure position so far.
  type ParseReply(a) =
      ROk(a, Int, Int)
    | RFail(ParseErr)
    | RCut(ParseErr)

  -- A parser is a function from (input, offset) to a ParseReply.  (The design
  -- doc calls this type `Reply`; it is `ParseReply` here because
  -- `channel.march` already declares a `Reply` constructor and the stdlib
  -- shares one namespace.)  The payload type is written curried — March's
  -- convention for multi-argument function types — but the function is called
  -- uncurried, as `f(s, i)`.
  type Parser(a) = Parser(String -> Int -> ParseReply(a))

  doc """
  Build a failure at `pos` expecting `exp`, with no context frames.
  """
  pfn fail_at(pos : Int, exp : Expected) : ParseErr do
    { pos: pos, expected: Cons(exp, Nil), context: Nil }
  end

  -- Byte-compare `s[k..n)` against `input[i+k..)`.  Written as a module-level
  -- tail-recursive helper rather than a local function inside `lit`'s lambda:
  -- a lambda body is `let`s followed by one expression, so it cannot host a
  -- local named recursive function.  Tail position keeps it TCO-eligible.
  pfn lit_matches(input : String, s : String, i : Int, k : Int, n : Int) : Bool do
    if k >= n do true
    else
      if string_byte_at(input, i + k) == string_byte_at(s, k) do
        lit_matches(input, s, i, k + 1, n)
      else false end
    end
  end

  doc """
  Run a parser over an input string.

  Both a soft and a hard failure surface as `Err` — the distinction between
  them matters to `alt` while parsing, not to the caller of `run`.
  """
  fn run(p : Parser(a), input : String) : Result(a, ParseErr) do
    match p do
      Parser(f) ->
        match f(input, 0) do
          ROk(v, _, _) -> Ok(v)
          RFail(e)     -> Err(e)
          RCut(e)      -> Err(e)
        end
    end
  end

  doc """
  Match a literal string at the current offset.

  Compares byte by byte with `string_byte_at`, so nothing is allocated while
  scanning and a mismatch past the end of the input behaves like any other
  mismatch (`string_byte_at` returns -1 there, which never equals a byte of
  the pattern).

  On failure the reported offset is where the literal *started*, not where the
  bytes diverged: a caller who wrote `lit("ab")` wants to be told that `ab`
  was expected here, not that `b` was expected one byte along.
  """
  fn lit(s : String) : Parser(String) do
    let n = string_byte_length(s)
    Parser(fn (input, i) ->
      if lit_matches(input, s, i, 0, n) do ROk(s, i + n, i)
      else RFail(fail_at(i, ExpLit(s))) end)
  end

  -- ── Failure merging (plan §3.2) ──────────────────────────────────────────
  --
  -- The single highest-leverage rule for message quality: when ordered choice
  -- exhausts its alternatives, report the failure that got FURTHEST into the
  -- input, and when several tie at the same offset, merge their expected-sets.
  --
  -- Without this, `alt` reports whichever alternative happened to be listed
  -- last — the classic "expected expression" at column 0 while the real
  -- mistake is at column 40.
  pfn merge_err(a : ParseErr, b : ParseErr) : ParseErr do
    if a.pos > b.pos do a
    else
      if b.pos > a.pos do b
      else
        { pos:      a.pos,
          expected: List.append(a.expected, b.expected),
          context:  a.context }
      end
    end
  end

  -- The furthest offset any sub-parse has failed at so far.  Threaded through
  -- SUCCESS replies too (the third field of ROk): a later failure at an
  -- earlier offset must not shadow an earlier sub-parse's deeper progress.
  pfn max_int2(a : Int, b : Int) : Int do
    if a > b do a else b end
  end

  -- Render a byte code for a message.  Printable ASCII shows as itself;
  -- anything else shows as its number, which beats emitting a control byte
  -- into a diagnostic.
  pfn byte_name(code : Int) : String do
    if code >= 32 && code < 127 do string_from_chars(Cons(byte_to_char(code), Nil))
    else "byte " ++ int_to_string(code) end
  end

  -- `many`'s loop, at module level and in tail position so TCO applies.
  --
  -- The `j == i` guard is load-bearing: a parser that succeeds WITHOUT
  -- consuming (say `lit("")`) would otherwise be retried at the same offset
  -- forever.  Stopping is the only sane answer — the alternative is a hang
  -- that looks like an infinite loop in the user's grammar.
  pfn many_go(f : String -> Int -> ParseReply(a), input : String, i : Int,
              acc : List(a), furthest : Int) : ParseReply(List(a)) do
    match f(input, i) do
      ROk(x, j, fp) ->
        if j == i do ROk(List.reverse(acc), i, max_int2(furthest, fp))
        else many_go(f, input, j, Cons(x, acc), max_int2(furthest, fp)) end
      RFail(e) -> ROk(List.reverse(acc), i, max_int2(furthest, e.pos))
      RCut(e)  -> RCut(e)
    end
  end

  -- Scan forward while `pred` holds; returns the offset one past the run.
  -- Tail-recursive. `string_byte_at` returns -1 past the end and a byte
  -- predicate rejects that, so end-of-input needs no special case.
  pfn scan_while(input : String, i : Int, pred : Int -> Bool) : Int do
    let b = string_byte_at(input, i)
    if b >= 0 && pred(b) do scan_while(input, i + 1, pred)
    else i end
  end

  -- `repeat`'s loop. Counts DOWN rather than checking a zero-width guard like
  -- `many_go`: a fixed count terminates on its own, and a zero-width `p` here
  -- should still produce `n` results rather than stopping early.
  pfn repeat_go(f : String -> Int -> ParseReply(a), input : String, i : Int,
                n : Int, acc : List(a), furthest : Int) : ParseReply(List(a)) do
    if n <= 0 do ROk(List.reverse(acc), i, furthest)
    else
      match f(input, i) do
        ROk(x, j, fp) -> repeat_go(f, input, j, n - 1, Cons(x, acc), max_int2(furthest, fp))
        RFail(e)      -> RFail(e)
        RCut(e)       -> RCut(e)
      end
    end
  end

  -- KNOWN LIMITATION of the Int-only success channel.  When `p` succeeds
  -- having internally failed deeper than the offset at which `q` later fails,
  -- we know a deeper failure happened (the Int survives) but not what it
  -- expected — `ROk` deliberately does not carry an expected-set, so that the
  -- success path allocates nothing.  `and_then` therefore reports `q`'s error,
  -- which at least has a real expected-set, rather than a bare position with
  -- nothing to say about it.
  --
  -- This is the same trade Parsec-family libraries make.  If it turns out to
  -- produce a misleading message in practice, the fix is to widen the success
  -- channel to carry `(pos, expected)` — and to pay for it — rather than to
  -- paper over it at the `and_then` call site.  Revisit once the JSON/TOML
  -- rewrite (plan §10 step 2) has real grammars to judge against.

  doc """
  Run `p`, then `q`, and pair their results.

  A failure in `q` is reported at `q`'s own offset, so the error points at
  where the input actually diverged rather than at the start of the sequence.
  A hard failure (`RCut`) from either side propagates without being turned
  into a soft failure — that is what makes a commit point stick.
  """
  fn and_then(p : Parser(a), q : Parser(b)) : Parser((a, b)) do
    match (p, q) do
      (Parser(pf), Parser(qf)) ->
        Parser(fn (input, i) ->
          match pf(input, i) do
            RFail(e) -> RFail(e)
            RCut(e)  -> RCut(e)
            ROk(x, j, fp) ->
              match qf(input, j) do
                RFail(e)      -> RFail(e)
                RCut(e)       -> RCut(e)
                ROk(y, k, fq) -> ROk((x, y), k, max_int2(fp, fq))
              end
          end)
    end
  end

  doc """
  Ordered choice: try `p`, and only if it fails *softly* try `q`.

  A hard failure from `p` — one raised past a commit point — is propagated
  rather than swallowed, which is the whole point of committing. When both
  alternatives fail softly the two errors are merged by `merge_err`, so the
  reported position is the furthest either one reached.
  """
  fn alt(p : Parser(a), q : Parser(a)) : Parser(a) do
    match (p, q) do
      (Parser(pf), Parser(qf)) ->
        Parser(fn (input, i) ->
          match pf(input, i) do
            ROk(x, j, fp) -> ROk(x, j, fp)
            RCut(e)       -> RCut(e)
            RFail(e1) ->
              match qf(input, i) do
                ROk(y, k, fq) -> ROk(y, k, max_int2(fq, e1.pos))
                RCut(e2)      -> RCut(e2)
                RFail(e2)     -> RFail(merge_err(e1, e2))
              end
          end)
    end
  end

  doc """
  Match one byte by its code (0..255).

  There is no character literal in March, so byte codes are the primitive and
  `lit` is the ergonomic form for anything spelled as text.
  """
  fn byte(code : Int) : Parser(Int) do
    Parser(fn (input, i) ->
      if string_byte_at(input, i) == code do ROk(code, i + 1, i)
      else RFail(fail_at(i, ExpLit(byte_name(code)))) end)
  end

  doc """
  Match one byte satisfying `pred`, described to the user as `name`.

  Named `byte_if` rather than the conventional `satisfy`: `satisfy` is a
  reserved keyword in March (it belongs to refinement types), so `fn satisfy`
  does not parse. `byte_if` also pairs with `byte` and says what it does.

  The name is what the reader sees in a message ("I was expecting a digit"),
  so it should name the class, not the predicate: "digit", not "is_digit".

  `string_byte_at` returns -1 past the end of the input, and a predicate over
  byte values will reject that, so end-of-input needs no special case.
  """
  fn byte_if(name : String, pred : Int -> Bool) : Parser(Int) do
    Parser(fn (input, i) ->
      let b = string_byte_at(input, i)
      if b >= 0 && pred(b) do ROk(b, i + 1, i)
      else RFail(fail_at(i, ExpLabel(name))) end)
  end

  doc """
  Succeed only at the end of the input.

  Without this a grammar silently accepts a valid prefix of invalid input —
  `1 + 2 )))` parses as `1 + 2` and the trailing garbage is never reported.
  """
  fn eof() : Parser(Unit) do
    Parser(fn (input, i) ->
      if string_byte_at(input, i) < 0 do ROk((), i, i)
      else RFail(fail_at(i, ExpEof)) end)
  end

  doc """
  Transform a parser's result, leaving its failure behaviour untouched.
  """
  fn map(p : Parser(a), f : a -> b) : Parser(b) do
    match p do
      Parser(pf) ->
        Parser(fn (input, i) ->
          match pf(input, i) do
            ROk(x, j, fp) -> ROk(f(x), j, fp)
            RFail(e)      -> RFail(e)
            RCut(e)       -> RCut(e)
          end)
    end
  end

  doc """
  Defer building a parser until it is run.

  Combinators are ordinary VALUES, built eagerly, so a rule that mentions
  itself would recurse while being *constructed* — before a byte of input is
  read — and never return. Every recursive or mutually recursive grammar
  therefore needs its back-edge wrapped:

      pfn value() : Parser(Json) do
        alt(number(), array_of(delay(fn -> value())))
      end

  This is not a March quirk; every combinator library in a strict language
  needs the same device (Scala's `P(...)`, OCaml's `fix`). It is the one piece
  of ceremony a grammar DSL would remove, since a DSL can see the recursion.
  """
  fn delay(thunk : Unit -> Parser(a)) : Parser(a) do
    Parser(fn (input, i) ->
      match thunk() do
        Parser(f) -> f(input, i)
      end)
  end

  doc """
  Match a run of one or more bytes satisfying `pred`, returned as one String.

  The reason this exists rather than `many(byte_if(...))`: that spelling
  allocates a list cell per byte and then needs a second pass to rebuild a
  string. This scans to the end of the run and takes a single slice — one
  allocation per token instead of one per character, which is the difference
  between a combinator lexer being usable and being a toy.
  """
  fn take_while1(name : String, pred : Int -> Bool) : Parser(String) do
    Parser(fn (input, i) ->
      let j = scan_while(input, i, pred)
      if j > i do ROk(string_slice(input, i, j - i), j, i)
      else RFail(fail_at(i, ExpLabel(name))) end)
  end

  doc """
  Match a run of zero or more bytes satisfying `pred`, returned as one String.

  Never fails, so it is the right shape for optional whitespace.
  """
  fn take_while(pred : Int -> Bool) : Parser(String) do
    Parser(fn (input, i) ->
      let j = scan_while(input, i, pred)
      ROk(string_slice(input, i, j - i), j, i))
  end

  doc """
  Try `p`; on a soft failure succeed with `None`, consuming nothing.

  A hard failure still propagates: past a commit point the construct was not
  optional.
  """
  fn optional(p : Parser(a)) : Parser(Option(a)) do
    match p do
      Parser(f) ->
        Parser(fn (input, i) ->
          match f(input, i) do
            ROk(x, j, fp) -> ROk(Some(x), j, fp)
            RFail(e)      -> ROk(None, i, e.pos)
            RCut(e)       -> RCut(e)
          end)
    end
  end

  doc """
  Sequence, where what to parse next DEPENDS on what was just parsed.

  This is the one combinator `map`, `and_then` and `alt` cannot replace
  between them. They all fix the shape of the rest of the parse in advance;
  `flat_map` chooses it from a value. Length-prefixed data, indentation
  sensitivity, and version negotiation all need exactly this — which is the
  formal difference between applicative and monadic sequencing, and the reason
  a grammar DSL built only on `/`, `*` and `?` cannot express them.

      -- a digit says how many items follow
      flat_map(digit(), fn n -> repeat(item(), n))

  The furthest-failure position is threaded through both halves, so an error
  in the dependent parser still competes correctly inside an `alt`.
  """
  fn flat_map(p : Parser(a), f : a -> Parser(b)) : Parser(b) do
    match p do
      Parser(pf) ->
        Parser(fn (input, i) ->
          match pf(input, i) do
            RFail(e) -> RFail(e)
            RCut(e)  -> RCut(e)
            ROk(x, j, fp) ->
              match f(x) do
                Parser(qf) ->
                  match qf(input, j) do
                    RFail(e)      -> RFail(e)
                    RCut(e)       -> RCut(e)
                    ROk(y, k, fq) -> ROk(y, k, max_int2(fp, fq))
                  end
              end
          end)
    end
  end

  doc """
  Exactly `n` occurrences of `p`, failing if there are fewer.

  Unlike `many`, a shortfall is an error rather than a shorter list: `n` came
  from somewhere — usually a length prefix — so falling short means the input
  disagrees with itself.
  """
  fn repeat(p : Parser(a), n : Int) : Parser(List(a)) do
    match p do
      Parser(pf) -> Parser(fn (input, i) -> repeat_go(pf, input, i, n, Nil, i))
    end
  end

  doc """
  Run `p`, then `q`, and keep **`p`'s** value.

  This is the pipe-friendly sequencing form: `a |> skip_then(sep)` reads as
  "a, then a separator I do not care about". Pairing with `and_then` gives the
  NimbleParsec-style pipeline the design notes describe — and the left-nested
  tuples that make the case for named binders past three elements.
  """
  fn skip_then(p : Parser(a), q : Parser(b)) : Parser(a) do
    map(and_then(p, q), fn (pr) -> match pr do (x, _) -> x end)
  end

  doc """
  Zero or more occurrences of `p`, in order.

  Stops at the first soft failure and succeeds with what it has. A HARD
  failure propagates instead: once a commit point inside an item has been
  passed, the item was not optional, and quietly ending the list there would
  turn a real error into a short parse.
  """
  fn many(p : Parser(a)) : Parser(List(a)) do
    match p do
      Parser(pf) -> Parser(fn (input, i) -> many_go(pf, input, i, Nil, i))
    end
  end

  doc """
  One or more occurrences of `p`.
  """
  fn many1(p : Parser(a)) : Parser(List(a)) do
    map(and_then(p, many(p)), fn (pr) -> match pr do (x, xs) -> Cons(x, xs) end)
  end

  doc """
  Zero or more occurrences of `p` separated by `sep`, discarding separators.
  """
  fn sep_by(p : Parser(a), sep : Parser(b)) : Parser(List(a)) do
    alt(sep_by1(p, sep), pure(Nil))
  end

  doc """
  One or more occurrences of `p` separated by `sep`.
  """
  fn sep_by1(p : Parser(a), sep : Parser(b)) : Parser(List(a)) do
    map(and_then(p, many(skip_first(sep, p))),
        fn (pr) -> match pr do (x, xs) -> Cons(x, xs) end)
  end

  doc """
  Succeed with `x` without consuming input.
  """
  fn pure(x : a) : Parser(a) do
    Parser(fn (_input, i) -> ROk(x, i, i))
  end

  doc """
  Run `p`, then `q`, and keep **`q`'s** value — the mirror of `skip_then`.
  """
  fn skip_first(p : Parser(a), q : Parser(b)) : Parser(b) do
    map(and_then(p, q), fn (pr) -> match pr do (_, y) -> y end)
  end

  doc """
  Commit: past this point, failure is a hard parse error rather than a
  backtrack into the next alternative.

  This is SNOBOL's `FENCE` and Prolog's cut. Without it a malformed `if`
  statement silently falls through to be parsed as something else, and the
  error message ends up pointing at the wrong construct entirely.

  A success is passed through untouched; only a soft failure is upgraded.
  """
  fn commit(p : Parser(a)) : Parser(a) do
    match p do
      Parser(f) ->
        Parser(fn (input, i) ->
          match f(input, i) do
            ROk(x, j, fp) -> ROk(x, j, fp)
            RFail(e)      -> RCut(e)
            RCut(e)       -> RCut(e)
          end)
    end
  end

  doc """
  Run `p`, then commit to `q` — the correct shape for "past this token, the
  construct is no longer optional".

  **Where a commit sits decides whether a later failure is reported at all**,
  and getting it wrong is silent. `commit(delimiter)` makes only the
  DELIMITER's own failure hard; everything sequenced after it stays soft, so
  an enclosing `sep_by` or `alt` quietly backtracks and replaces the real
  error with a shallow one:

      -- WRONG: commit on the ":" only
      and_then(key, and_then(commit(lit(":")), value))
      "{a:}"  ->  1:2: I was expecting `}`

      -- RIGHT: commit on everything after the key
      then_commit(key, skip_first(lit(":"), value))
      "{a:}"  ->  1:4: I was expecting a value in the member that started at 1:2

  Both accept `{}`, so the difference never shows up on valid input — only on
  the malformed input where the message mattered. This combinator exists so
  the right shape is the short one.
  """
  fn then_commit(p : Parser(a), q : Parser(b)) : Parser((a, b)) do
    and_then(p, commit(q))
  end

  doc """
  Name the construct a failure happened inside.

  On a hard failure, pushes `(name, start_offset)` onto the error's context
  stack. That stack is what turns

      error at 14:3: I was expecting `end`

  into

      error at 14:3: I was expecting `end` to close the `block` that started at 12:1

  Only hard failures carry context: a soft failure is a path not taken, and
  naming every alternative a parser merely tried would be noise, not context.
  """
  fn ctx(name : String, p : Parser(a)) : Parser(a) do
    match p do
      Parser(f) ->
        Parser(fn (input, i) ->
          match f(input, i) do
            ROk(x, j, fp) -> ROk(x, j, fp)
            RFail(e)      -> RFail(e)
            RCut(e)       ->
              RCut({ pos:      e.pos,
                     expected: e.expected,
                     context:  Cons((name, i), e.context) })
          end)
    end
  end

  doc """
  Replace a parser's expected-set with one human-named class.

  Raw expected-sets degrade into token soup — "expected `-`, `0`..`9`, `(`, or
  `fn`" — so every public nonterminal in a grammar should be labelled.

  The rule that keeps labels honest: the substitution happens ONLY when `p`
  failed **without consuming input**. If `p` got somewhere before failing, its
  inner error is more specific than the label and is kept, so a label can
  never hide real progress. Consumption is judged by comparing the failure
  offset against the offset the parser started at.

  A hard failure is never relabelled either: past a commit point the specific
  error is the whole point.
  """
  -- ── Recovery (plan §3.6) ─────────────────────────────────────────────────
  --
  -- Markdown never "fails" — every byte sequence is valid — but its structure
  -- parses fail locally, and a good tool reports ALL the problems rather than
  -- the first.  The same is true of a config file with three bad keys.
  --
  -- The design note imagined the driver threading a `List(ParseErr)` beside
  -- the AST.  That would mean a side channel in every reply.  It is not
  -- needed: make the recovered error a VALUE, and `many` composes with it for
  -- free — `many(recover(item, sync))` yields `List(Result(item, ParseErr))`,
  -- which is the partial AST and the full error list in one structure.

  -- Advance to just past the next point where `sync` matches, or to the end
  -- of the input.  Tail-recursive; scans a byte at a time, which is fine for
  -- a path only taken after an error has already occurred.
  pfn skip_to(sf : String -> Int -> ParseReply(b), input : String, i : Int) : Int do
    if string_byte_at(input, i) < 0 do i
    else
      match sf(input, i) do
        ROk(_, j, _) -> j
        RFail(_)     -> skip_to(sf, input, i + 1)
        RCut(_)      -> skip_to(sf, input, i + 1)
      end
    end
  end

  doc """
  Scope a commit point.

  Runs `p`, but converts a hard failure back into a soft one at this
  boundary, so one construct's `commit` cannot abort a sibling. This is the
  other half of SNOBOL's `FENCE`: committing is scoped, not global.
  """
  fn fence(p : Parser(a)) : Parser(a) do
    match p do
      Parser(f) ->
        Parser(fn (input, i) ->
          match f(input, i) do
            ROk(x, j, fp) -> ROk(x, j, fp)
            RFail(e)      -> RFail(e)
            RCut(e)       -> RFail(e)
          end)
    end
  end

  doc """
  Turn a failure into a value and resynchronize.

  If `p` succeeds the result is `Ok(value)`. If it fails — softly or hard —
  the error becomes `Err(err)`, the input is skipped forward past the next
  `sync` match, and the parser SUCCEEDS. Nothing above it sees a failure, so
  a driver can keep going and collect the rest.

  `many(recover(item, sync))` is the intended shape: it returns every item
  that parsed and every error that did not, from one pass.

  **Have the item consume its own separator.** Otherwise the parser is
  handed a separator where an item is expected, fails there too, and you get
  a spurious error per separator. On `"ok;BAD;ok;ALSOBAD"`:

      many(recover(lit("ok"), lit(";")))                     -- 4 errors
      many(recover(lit("ok") |> skip_then(opt_semi), sep))   -- 2 errors

  Both are "correct"; only the second reports what a reader would call the
  mistakes. Resync skips *past* the sync match, so a sync token the item
  does not own becomes the next thing tried.

  Note the interaction with `many`'s zero-width guard. At end of input `p`
  fails and `skip_to` cannot advance, so `recover` succeeds without
  consuming and `many` stops — which is the termination argument. Without
  that guard this pair would spin.
  """
  fn recover(p : Parser(a), sync : Parser(b)) : Parser(Result(a, ParseErr)) do
    match (p, sync) do
      (Parser(pf), Parser(sf)) ->
        Parser(fn (input, i) ->
          match pf(input, i) do
            ROk(x, j, fp) -> ROk(Ok(x), j, fp)
            RFail(e)      -> ROk(Err(e), skip_to(sf, input, i), e.pos)
            RCut(e)       -> ROk(Err(e), skip_to(sf, input, i), e.pos)
          end)
    end
  end

  -- ── Rendering (plan §3.5) ────────────────────────────────────────────────
  --
  -- Byte offset -> 1-based line/column happens ONCE, here, at render time.
  -- Never in the parse loop: the hot path deals in byte indices and nothing
  -- else, which is the whole reason positions are integers.
  pfn line_col_go(input : String, target : Int, i : Int,
                  line : Int, col : Int) : (Int, Int) do
    if i >= target do (line, col)
    else
      if string_byte_at(input, i) == 10 do
        line_col_go(input, target, i + 1, line + 1, 1)
      else line_col_go(input, target, i + 1, line, col + 1) end
    end
  end

  doc """
  Convert a byte offset into a 1-based `(line, column)` pair.
  """
  fn line_col(input : String, pos : Int) : (Int, Int) do
    line_col_go(input, pos, 0, 1, 1)
  end

  pfn expected_name(e : Expected) : String do
    match e do
      ExpLit(s)   -> "`" ++ s ++ "`"
      ExpLabel(s) -> s
      ExpEof      -> "end of input"
    end
  end

  pfn join_expected(xs : List(Expected)) : String do
    String.join(List.map(xs, fn e -> expected_name(e)), " or ")
  end

  pfn render_context(input : String, ctx : List((String, Int))) : String do
    match ctx do
      Nil -> ""
      Cons((name, start), _) ->
        let (l, c) = line_col(input, start)
        " in the " ++ name ++ " that started at "
          ++ int_to_string(l) ++ ":" ++ int_to_string(c)
    end
  end

  doc """
  Render a failure as a diagnostic in the March compiler's voice.

      2:3: I was expecting `Z` in the block that started at 1:1

  Only the innermost context frame is named. A full stack reads as a trace,
  and a parse error is not a stack trace — the construct you are inside is
  what locates the mistake.
  """
  fn render(input : String, e : ParseErr) : String do
    let (l, c) = line_col(input, e.pos)
    int_to_string(l) ++ ":" ++ int_to_string(c)
      ++ ": I was expecting " ++ join_expected(e.expected)
      ++ render_context(input, e.context)
  end

  fn label(name : String, p : Parser(a)) : Parser(a) do
    match p do
      Parser(f) ->
        Parser(fn (input, i) ->
          match f(input, i) do
            ROk(x, j, fp) -> ROk(x, j, fp)
            RCut(e)       -> RCut(e)
            RFail(e) ->
              if e.pos == i do
                RFail({ pos: i, expected: Cons(ExpLabel(name), Nil), context: e.context })
              else RFail(e) end
          end)
    end
  end

end
