mod Session do
  needs IO

  -- Session transport capability.
  --
  -- A `Cap(Session.Live)` carries a DICTIONARY — the transport — and every
  -- operation here dispatches through it. There is deliberately no ambient
  -- transport: a session with nothing attached is a programming error, not a
  -- fallback, because the whole point is that the transport is the thing you
  -- swap (a deterministic in-process one under test, a real one in production).
  --
  -- The dictionary is transport-level and protocol-agnostic: no field is named
  -- after a protocol, a role, or a message. Endpoints, roles and access points
  -- are opaque `Int` handles the transport hands out; a message is `Bytes`,
  -- because a transport must serialise anyway and the code that knows the real
  -- message type sits on both sides of it.
  --
  -- Derived by hand-projecting the `Stream` protocol (see
  -- `specs/todos/2026-08-31-cap-runtime-dictionaries.md`): `register`, `send`
  -- (spelled `emit` here — `send` is reserved for actors), `suspend`, `close`.
  -- No `recv`: an event-driven endpoint never blocks; delivery is the handler
  -- passed to `suspend`.

  -- The transport. `suspend(ep, from, handler)` installs `handler` for the next
  -- delivery on `ep` from a given role (0 = any) and yields; the handler
  -- receives `(from, msg, ep)` and
  -- returns the next suspension. It is tail-resumptive only: a handler
  -- resumes exactly once, in tail position, as a plain call through this
  -- record.  (A `doc` is only accepted before a function; on a `type` it is a
  -- parse error, which the stdlib loader reports as "Unknown module".)
  -- `fail(ep, why)`: the generated code could not deliver a message to
  -- `ep`'s continuation -- it did not decode, or it is one the state cannot
  -- receive.  The transport decides what that means: a hand-written test
  -- transport may just panic (the message is a bug in the program that sent
  -- it); `in_process` below cancels the receiving endpoint; a network one
  -- ends the session and reports it (`SessionNode`: `RunError.Protocol`).
  -- `on_cancel(ep, h)`: install `h` as the cancel handler for the
  -- continuation `suspend` installs next on `ep`; returns `ep`. The transport
  -- calls `h(role, cause, ep)` if that continuation's sender can send nothing
  -- more (a transport where nothing fails may ignore it). `leave(ep, why)`:
  -- this endpoint exits its session on purpose; the transport tells the
  -- peers. Both: specs/todos/2026-09-18-choreography-failure-handling.md.
  -- `on_crash(ep, role, h)`: install `h` as the CRASH continuation for
  -- `role` with the continuation `suspend` installs next on `ep`; returns
  -- `ep`. The transport calls `h(role, cause, ep)` if that continuation waits
  -- on `role`, `role` can send nothing more and nothing from it is queued:
  -- the endpoint then goes on from the crash branch instead of being
  -- cancelled (a generated `recv_<Msg>` with a crash branch installs it;
  -- specs/2026-09-19-choreography-access-points-and-crash-branches-design.md
  -- Part B). A transport where nothing fails may ignore it.
  type Ops = {
    register  : Int -> Int -> Int,
    emit      : Int -> Int -> Bytes -> Int,
    suspend   : Int -> Int -> (Int -> Bytes -> Int -> Int) -> Int,
    close     : Int -> (),
    fail      : Int -> String -> (),
    on_cancel : Int -> (Int -> String -> Int -> Int) -> Int,
    leave     : Int -> String -> (),
    on_crash  : Int -> Int -> (Int -> String -> Int -> Int) -> Int
  }

  proof cap Live with Ops

  doc "Attach a transport. The only way to obtain a `Cap(Session.Live)`."
  fn attach(io : Cap(IO), ops : Ops) : Cap(Session.Live) do
    cap_impl(mint_cap(io), ops)
  end

  pfn no_transport() do
    panic("Session: no transport attached to this capability")
  end

  doc "Join a session at access point `ap` in role `role`; returns the endpoint."
  fn register(c : Cap(Session.Live), ap : Int, role : Int) : Int do
    match cap_dict(c) do
      Some(d) -> d.register(ap, role)
      None    -> no_transport()
    end
  end

  doc "Send `msg` from `ep` to role `to`; returns the continuation endpoint."
  fn emit(c : Cap(Session.Live), ep : Int, to : Int, msg : Bytes) : Int do
    match cap_dict(c) do
      Some(d) -> d.emit(ep, to, msg)
      None    -> no_transport()
    end
  end

  doc """
  Install `handler` for the next delivery on `ep` and yield. `from` is the
  role the continuation expects to hear from -- the projection knows it at
  every receive -- or 0 for "any", which a same-thread transport and a
  two-party session pass. A transport that carries several peers uses it to
  park a delivery that arrives before the continuation that wants it
  (messages from different peers race; see `SessionNode`).
  """
  fn suspend(c : Cap(Session.Live), ep : Int, from : Int, handler : Int -> Bytes -> Int -> Int) : Int do
    match cap_dict(c) do
      Some(d) -> d.suspend(ep, from, handler)
      None    -> no_transport()
    end
  end

  doc """
  For generated `@[endpoints]` code only: take an epoch hold on the running
  actor while it hosts a started endpoint, so it stays on the code version the
  session formed under until the endpoint closes (hot reload's nesting rule).
  Paired with `release_epoch`; calling it anywhere else only delays a deploy
  (up to its hard drain deadline).
  """
  fn hold_epoch() : () do
    epoch_hold()
  end

  doc "For generated `@[endpoints]` code only: release the hold `hold_epoch` took."
  fn release_epoch() : () do
    epoch_release()
  end

  doc "Close endpoint `ep`."
  fn close(c : Cap(Session.Live), ep : Int) : () do
    match cap_dict(c) do
      Some(d) -> d.close(ep)
      None    -> no_transport()
    end
  end

  doc """
  Install `handler` as the cancel handler for the continuation that the next
  `suspend` on `ep` installs, and return `ep`. It runs as
  `handler(role, cause, ep)` if the role that continuation waits on can send
  nothing more and nothing from it is queued. The generated `recv_…_or` and
  `offer_…_or` call this.
  """
  fn on_cancel(c : Cap(Session.Live), ep : Int, handler : Int -> String -> Int -> Int) : Int do
    match cap_dict(c) do
      Some(d) -> d.on_cancel(ep, handler)
      None    -> no_transport()
    end
  end

  doc """
  Install `handler` as the crash continuation for `role` with the continuation
  that the next `suspend` on `ep` installs, and return `ep`. It runs as
  `handler(role, cause, ep)` if that continuation waits on `role` and `role`
  is gone with nothing from it queued; the endpoint stays live and goes on
  from the protocol's crash branch. The generated `recv_…` of a message step
  with `or crash do … end` calls this.
  """
  fn on_crash(c : Cap(Session.Live), ep : Int, role : Int, handler : Int -> String -> Int -> Int) : Int do
    match cap_dict(c) do
      Some(d) -> d.on_crash(ep, role, handler)
      None    -> no_transport()
    end
  end

  doc "Leave the session from endpoint `ep` on purpose, with a reason the peers are told."
  fn leave(c : Cap(Session.Live), ep : Int, why : String) : () do
    match cap_dict(c) do
      Some(d) -> d.leave(ep, why)
      None    -> no_transport()
    end
  end

  doc """
  A message for `ep` that its continuation cannot take (undecodable, or one
  the session state cannot receive): hand the transport [why]. The
  generated endpoint code calls this; what happens next is the transport's
  (`in_process` cancels the endpoint, `SessionNode` ends the session with
  `Protocol`, a hand-written test transport may panic).
  """
  fn fail(c : Cap(Session.Live), ep : Int, why : String) : () do
    match cap_dict(c) do
      Some(d) -> d.fail(ep, why)
      None    -> no_transport()
    end
  end

  -- ── a crash on the delivery route (actor-hosted roles) ──────────────────
  --
  -- An actor-hosted endpoint never runs the crash continuation itself: the
  -- actor owns the session state, so the crash has to reach the actor's own
  -- handler, and the route that already reaches it is the delivery one.
  -- A transport that hosts a role therefore forwards a crash as a delivery
  -- whose payload is `crash_payload(cause)` and whose sender is the crashed
  -- role, and the generated `resume` asks `crash_cause` before it decodes.
  -- The marker cannot collide with a message: every payload on the wire is
  -- `Json.to_string` of a variant, which never begins with `!`.

  pfn crash_marker() : String do "!session-crash!" end

  doc """
  The delivery payload that carries a crash of the sending role, with `cause`
  as the transport knows it. A transport that hosts a role in an actor sends
  this on the delivery route; nothing else produces it.
  """
  fn crash_payload(cause : String) : Bytes do
    Bytes.from_string(crash_marker() ++ cause)
  end

  doc """
  `Some(cause)` if `msg` is a forwarded crash rather than a protocol message,
  `None` otherwise. The generated `resume` of an actor-hosted role asks this
  before decoding.
  """
  fn crash_cause(msg : Bytes) : Option(String) do
    let s = Bytes.to_string(msg)
    let m = crash_marker()
    if String.starts_with(s, m) do
      Some(String.slice(s, String.byte_size(m), String.byte_size(s) - String.byte_size(m)))
    else
      None
    end
  end

  -- ── the in-process transport ────────────────────────────────────────────
  --
  -- Every role of one session in one program, no network: what a role's unit
  -- test attaches. `emit` only ENQUEUES; `drain` then delivers in FIFO order,
  -- so the interleaving is fixed and a trace is the same on every run. (A
  -- transport that delivered inside `emit` would be wrong for the generated
  -- code: an endpoint sends before it suspends, so a synchronous reply would
  -- arrive before its handler exists.)
  --
  -- Failure follows `SessionNode` (specs/todos/2026-09-18-choreography-failure-
  -- handling.md), with every role local:
  --   * a delivery a continuation is not waiting for (it waits on another
  --     role) is PARKED, left in the queue until one is;
  --   * a role that closed, left, was cancelled or crashed is GONE: messages
  --     to it are dropped;
  --   * an endpoint whose continuation waits on a gone role, with nothing
  --     from that role queued, takes that receive's crash branch if it
  --     installed one (`on_crash`), and is otherwise CANCELLED: its cancel
  --     handler (`on_cancel`) runs, and it is gone in turn, which is how a
  --     failure cascades;
  --   * `leave` cancels the leaving endpoint; `fail` (a delivery its
  --     continuation cannot take) cancels the receiving one, blaming the
  --     sender, where the network transport reports `Protocol`.
  -- `crash(role, cause)` makes a role gone without running any of its code:
  -- the test's stand-in for a node dying.
  --
  -- Endpoint ids are role numbers (`register` returns the role, as
  -- `SessionNode`'s does), so one transport carries ONE session, and each
  -- role registers once.

  type InProcess = {
    ops    : Ops,
    drain  : () -> (),
    take   : () -> Option((Int, Int, Bytes)),
    crash  : Int -> String -> (),
    queued : () -> Int
  }

  type InProcessState = {
    handlers  : Vault(Int -> Bytes -> Int -> Int),
    waiting   : Vault(Int),
    cancel_hs : Vault(Int -> String -> Int -> Int),
    crash_hs  : Vault(Int -> String -> Int -> Int),
    gone      : Vault(String),
    meta      : Vault(Int),
    roles     : Vault(List(Int)),
    queue     : Vault(List((Int, Int, Bytes))),
    trace     : String -> ()
  }

  pfn ip_key(n : Int) : String do int_to_string(n) end

  pfn ip_crash_key(ep : Int, role : Int) : String do
    int_to_string(ep) ++ "/" ++ int_to_string(role)
  end

  pfn ip_roles(st : InProcessState) : List(Int) do Vault.get_or(st.roles, "r", Nil) end

  pfn ip_queue(st : InProcessState) : List((Int, Int, Bytes)) do Vault.get_or(st.queue, "q", Nil) end

  pfn ip_is_gone(st : InProcessState, role : Int) : Bool do Vault.has(st.gone, ip_key(role)) end

  -- Forget the continuation installed on [ep], with its cancel and crash
  -- handlers. The "cur" cancel handler (the receive being resumed) stays:
  -- `fail` inside that resumption needs it.
  pfn ip_forget(st : InProcessState, ep : Int) : () do
    let _ = Vault.delete(st.handlers, ip_key(ep))
    let _ = Vault.delete(st.cancel_hs, ip_key(ep))
    let _ = List.map(ip_roles(st), fn r -> Vault.delete(st.crash_hs, ip_crash_key(ep, r)))
    ()
  end

  -- Cancel [ep] because of [role]: it is gone from now on (peers learn
  -- `outward`), and its cancel handler runs with [cause].
  pfn ip_cancel(st : InProcessState, ep : Int, role : Int, cause : String, outward : String) : () do
    if ip_is_gone(st, ep) do ()
    else
      Vault.set(st.gone, ip_key(ep), outward)
      let h = match Vault.get(st.cancel_hs, ip_key(ep)) do
        Some(f) -> Some(f)
        None -> Vault.get(st.cancel_hs, "cur" ++ ip_key(ep))
      end
      ip_forget(st, ep)
      let _ = Vault.delete(st.cancel_hs, "cur" ++ ip_key(ep))
      st.trace("cancel " ++ ip_key(ep) ++ ": " ++ outward)
      match h do
        Some(f) ->
          let _ = f(role, cause, ep)
          ()
        None -> ()
      end
    end
  end

  -- The first queued delivery a continuation can take -- to an endpoint with
  -- a handler, from the role it waits on (0 = any) -- and the queue without
  -- it. Deliveries skipped over stay queued, in order: they are parked.
  pfn ip_take(st : InProcessState, q : List((Int, Int, Bytes)), skipped : List((Int, Int, Bytes))) do
    match q do
      Nil -> None
      Cons(d, rest) ->
        match d do
          (to, from, _msg) ->
            let want = Vault.get_or(st.waiting, ip_key(to), 0)
            if Vault.has(st.handlers, ip_key(to)) && (want == 0 || want == from) do
              Some((d, List.append(List.reverse(skipped), rest)))
            else
              ip_take(st, rest, Cons(d, skipped))
            end
        end
    end
  end

  -- The role [ep]'s continuation waits on, if that role is gone. Nothing
  -- from it is queued for [ep] here: `ip_take` would have delivered it.
  pfn ip_blocked_on(st : InProcessState, ep : Int) : Option((Int, String)) do
    let want = Vault.get_or(st.waiting, ip_key(ep), 0)
    if want != 0 do
      match Vault.get(st.gone, ip_key(want)) do
        Some(why) -> Some((want, why))
        None -> None
      end
    else
      match List.filter(ip_roles(st), fn r -> r != ep) do
        Nil -> None
        Cons(first, peers) ->
          if List.all(Cons(first, peers), fn r -> ip_is_gone(st, r)) do
            Some((first, Vault.get_or(st.gone, ip_key(first), "gone")))
          else None end
      end
    end
  end

  pfn ip_stuck(st : InProcessState, eps : List(Int)) : Option((Int, Int, String)) do
    match eps do
      Nil -> None
      Cons(ep, rest) ->
        if Vault.has(st.handlers, ip_key(ep)) && !ip_is_gone(st, ep) do
          match ip_blocked_on(st, ep) do
            Some((role, why)) -> Some((ep, role, why))
            None -> ip_stuck(st, rest)
          end
        else ip_stuck(st, rest) end
    end
  end

  -- [to]'s continuation is being resumed by a delivery from [from]: forget
  -- it, and make its cancel handler the current one (`fail` inside the
  -- resumption cancels with it).
  pfn ip_enter(st : InProcessState, to : Int, from : Int) : () do
    let cur = Vault.get(st.cancel_hs, ip_key(to))
    ip_forget(st, to)
    let _ = Vault.delete(st.cancel_hs, "cur" ++ ip_key(to))
    match cur do
      Some(c) -> Vault.set(st.cancel_hs, "cur" ++ ip_key(to), c)
      None -> ()
    end
    Vault.set(st.meta, "from", from)
  end

  pfn ip_resume(st : InProcessState, to : Int, from : Int, msg : Bytes) : () do
    match Vault.get(st.handlers, ip_key(to)) do
      None -> ()
      Some(h) ->
        ip_enter(st, to, from)
        let _ = h(from, msg, to)
        let _ = Vault.delete(st.cancel_hs, "cur" ++ ip_key(to))
        ()
    end
  end

  -- `take`: the next delivery some endpoint is waiting for, removed from the
  -- queue with that endpoint's continuation forgotten, for a host that
  -- resumes the endpoint itself.
  pfn ip_take_next(st : InProcessState) : Option((Int, Int, Bytes)) do
    let q = List.filter(ip_queue(st), fn d -> match d do (to, _f, _m) -> !ip_is_gone(st, to) end)
    match ip_take(st, q, Nil) do
      None ->
        Vault.set(st.queue, "q", q)
        None
      Some((d, rest)) ->
        Vault.set(st.queue, "q", rest)
        match d do
          (to, from, _msg) -> ip_enter(st, to, from)
        end
        Some(d)
    end
  end

  pfn ip_drain(st : InProcessState) : () do
    -- Messages to an endpoint that is gone are dropped, as `emit` drops them.
    let q = List.filter(ip_queue(st), fn d -> match d do (to, _f, _m) -> !ip_is_gone(st, to) end)
    match ip_take(st, q, Nil) do
      Some((d, rest)) ->
        Vault.set(st.queue, "q", rest)
        match d do
          (to, from, msg) -> ip_resume(st, to, from, msg)
        end
        ip_drain(st)
      None ->
        Vault.set(st.queue, "q", q)
        match ip_stuck(st, ip_roles(st)) do
          None ->
            -- Stopped with deliveries nobody is waiting for: say so, since a
            -- silently stalled queue is how a lost message hides.
            match q do
              Nil -> ()
              _ -> st.trace("stalled: " ++ ip_key(List.length(q)) ++ " queued")
            end
          Some((ep, role, why)) ->
            let cause = if why == "closed" do "role " ++ ip_key(role) ++ " closed without sending" else why end
            match Vault.get(st.crash_hs, ip_crash_key(ep, role)) do
              Some(h) ->
                ip_forget(st, ep)
                st.trace("crash branch " ++ ip_key(ep) ++ ": role " ++ ip_key(role) ++ ": " ++ cause)
                let _ = h(role, cause, ep)
                ip_drain(st)
              None ->
                ip_cancel(st, ep, role, cause, "role " ++ ip_key(role) ++ ": " ++ cause)
                ip_drain(st)
            end
        end
    end
  end

  pfn ip_ops(st : InProcessState) : Ops do
    {
      register: fn (_ap, role) -> do
        let rs = ip_roles(st)
        if List.member(rs, role) do
          panic("Session.in_process: role " ++ ip_key(role) ++ " registered twice (one transport carries one session)")
        else
          Vault.set(st.roles, "r", List.append(rs, Cons(role, Nil)))
          role
        end
      end,
      emit: fn (ep, to, msg) -> do
        if ip_is_gone(st, ep) || ip_is_gone(st, to) do
          st.trace("dropped " ++ ip_key(ep) ++ " -> " ++ ip_key(to))
          ep
        else
          Vault.set(st.queue, "q", List.append(ip_queue(st), Cons((to, ep, msg), Nil)))
          ep
        end
      end,
      suspend: fn (ep, from, handler) -> do
        Vault.set(st.waiting, ip_key(ep), from)
        Vault.set(st.handlers, ip_key(ep), handler)
        ep
      end,
      close: fn ep -> do
        if ip_is_gone(st, ep) do () else Vault.set(st.gone, ip_key(ep), "closed") end
        ip_forget(st, ep)
        st.trace("close " ++ ip_key(ep))
      end,
      fail: fn (ep, why) -> do
        let from = Vault.get_or(st.meta, "from", 0)
        ip_cancel(st, ep, from, why, "role " ++ ip_key(from) ++ ": protocol: " ++ why)
      end,
      on_cancel: fn (ep, h) -> do
        Vault.set(st.cancel_hs, ip_key(ep), h)
        ep
      end,
      leave: fn (ep, why) -> ip_cancel(st, ep, ep, "left: " ++ why, "left: " ++ why),
      on_crash: fn (ep, role, h) -> do
        Vault.set(st.crash_hs, ip_crash_key(ep, role), h)
        ep
      end
    }
  end

  pfn ip_crash(st : InProcessState, role : Int, cause : String) : () do
    if ip_is_gone(st, role) do ()
    else
      Vault.set(st.gone, ip_key(role), cause)
      ip_forget(st, role)
      st.trace("crash " ++ ip_key(role) ++ ": " ++ cause)
    end
  end

  doc """
  An in-process transport, for running every role of one session in one
  program: attach its `ops`, drive each role to its first suspension, then
  `drain` to deliver.

      let t = Session.in_process()
      let s = Session.attach(io, t.ops)
      let _ = cons(s, Stream_Cons.register(s, 0), 2)
      let _ = prod(s, Stream_Prod.register(s, 0), 1)
      t.drain(())

  `emit` only enqueues; `drain` delivers in FIFO order until nothing more can
  run, so the run is deterministic. A delivery its endpoint is not yet waiting
  for stays queued (`queued(())` counts what is left). Failure behaves as on
  the network (`SessionNode`): a role that closed, left or crashed is gone,
  messages to it are dropped, and an endpoint waiting on it takes its crash
  branch or is cancelled. `crash(role, cause)` makes a role gone without
  running it -- a node dying -- and `fail` cancels the endpoint that got the
  bad message. One transport carries one session; each role registers once.

  An endpoint hosted in an actor (the generated event API) resumes itself
  from the actor's own turn, so its host routes deliveries instead of
  draining: `take(())` returns the next delivery an endpoint is waiting for,
  as `Some((to, from, msg))`, with that endpoint's continuation forgotten, or
  `None` when nothing queued can be taken. `take` runs no failure handling;
  `drain` does.
  """
  fn in_process() : InProcess do
    in_process_with(fn _ -> ())
  end

  doc """
  `in_process()`, reporting what the transport itself does to [trace], one
  line per event: `close <ep>`, `cancel <ep>: <cause>`, `crash <role>:
  <cause>`, `crash branch <ep>: role <role>: <cause>`, `dropped <from> ->
  <to>`, and `stalled: <n> queued` when a `drain` stops with deliveries no
  endpoint is waiting for. A test asserts on the failure paths through it.
  """
  fn in_process_with(trace : String -> ()) : InProcess do
    let tag = int_to_string(Vault.incr(Vault.open("session_in_process_ids"), "n", 1))
    let st = {
      handlers: Vault.new("session_in_process_handlers_" ++ tag),
      waiting: Vault.new("session_in_process_waiting_" ++ tag),
      cancel_hs: Vault.new("session_in_process_cancel_" ++ tag),
      crash_hs: Vault.new("session_in_process_crash_" ++ tag),
      gone: Vault.new("session_in_process_gone_" ++ tag),
      meta: Vault.new("session_in_process_meta_" ++ tag),
      roles: Vault.new("session_in_process_roles_" ++ tag),
      queue: Vault.new("session_in_process_queue_" ++ tag),
      trace: trace
    }
    Vault.set(st.roles, "r", Nil)
    Vault.set(st.queue, "q", Nil)
    {
      ops: ip_ops(st),
      drain: fn _ -> ip_drain(st),
      take: fn _ -> ip_take_next(st),
      crash: fn (role, cause) -> ip_crash(st, role, cause),
      queued: fn _ -> List.length(ip_queue(st))
    }
  end
end
