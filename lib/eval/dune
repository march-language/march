(executable
 (name discover_compress)
 (modules discover_compress)
 (libraries dune-configurator))

(rule
 (targets compress_cflags.sexp compress_libs.sexp)
 (action (run ./discover_compress.exe)))

(library
 (name march_eval)
 (modules (:standard \ discover_compress))
 (libraries march_ast march_errors march_ctxesc march_modules march_scheduler march_coverage march_doctest unix digestif march_ed25519 march_pqc)
 (foreign_stubs
  (language c)
  (names compress_stubs eval_ffi_stubs ffi_marshal)
  (flags (:standard (:include compress_cflags.sexp))))
 ; File.Dir: eval_beneath_stubs.c #includes runtime/march_file_beneath.c, so
 ; both backends resolve paths beneath a directory with the same C.
 (foreign_stubs
  (language c)
  (names eval_beneath_stubs)
  (include_dirs ../../runtime)
  (extra_deps ../../runtime/march_file_beneath.c))
 (c_library_flags (:include compress_libs.sexp)))
