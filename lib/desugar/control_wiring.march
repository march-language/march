-- The control plane's wiring (distributed-deploys step 12a), as declarations
-- for an entry module: the `Ctl` protocol with its role
-- bodies, the leader, the Agent, and the control API listener. It is not a
-- module: `lib/desugar/desugar_control.ml` embeds this text and
-- `bin/topology_gen.ml` splices it into the entry module of a topology app
-- whose topology has a `[control]` section, next to the generated `main`.
-- Nothing else loads it, so a program without a `[control]` section pays
-- nothing for it.
--
-- Why it is spliced into the entry module and not written as a stdlib
-- module: an `@[endpoints]` protocol typechecks only at an entry module's top
-- level (specs/todos/2026-09-28-endpoints-protocol-in-nested-module.md), and
-- in the eagerly loaded stdlib it would cost every program about 0.07 s warm.
-- The pure core (release format, executor, `agent_apply`) is `Control`.
--
-- Names are prefixed `Ctl`/`ctl_` so they do not collide with the app's own.
needs IO
needs IO.Console
needs IO.Mut
needs IO.Clock
needs IO.Spawn
needs IO.NetConnect
needs IO.NetListen
needs IO.FileRead
needs IO.FileWrite
needs Session.Live
needs ClusterNode.Live

-- ── the wire records (format version 1) ────────────────────────────────────

type CtlWireReport = {
  wire : Int, node : String, seq : Int, versions : String, topology : String,
  drained : Int, healthy : Bool, failed_seq : Int, failed_step : Int, failed_why : String,
  detail : String, pools : String, certs : String
}
derive Json for CtlWireReport
type CtlWireOrder = {
  wire : Int, seq : Int, release : String, step : Int, node : String, action : String,
  want : String, artifacts : String, lines : String
}
derive Json for CtlWireOrder
type CtlWireResult = { wire : Int, seq : Int, step : Int, node : String, ok : Bool, detail : String }
derive Json for CtlWireResult
pfn ctl_wire_report(r : Control.AgentReport) : CtlWireReport do
  { wire: 1, node: r.node, seq: r.seq, versions: r.versions, topology: r.topology, drained: r.drained,
    healthy: r.healthy, failed_seq: r.failed_seq, failed_step: r.failed_step, failed_why: r.failed_why,
    detail: r.detail, pools: r.pools, certs: r.certs }
end

-- A poll's report, without `detail` (see `ctl_agent_loop_`).
pfn ctl_wire_brief(r : Control.AgentReport) : CtlWireReport do
  { wire: 1, node: r.node, seq: r.seq, versions: r.versions, topology: r.topology, drained: r.drained,
    healthy: r.healthy, failed_seq: r.failed_seq, failed_step: r.failed_step, failed_why: r.failed_why,
    detail: "", pools: r.pools, certs: r.certs }
end

pfn ctl_report_of(w : CtlWireReport) : Control.AgentReport do
  { node: w.node, seq: w.seq, versions: w.versions, topology: w.topology, drained: w.drained,
    healthy: w.healthy, failed_seq: w.failed_seq, failed_step: w.failed_step, failed_why: w.failed_why,
    detail: w.detail, pools: w.pools, certs: w.certs }
end

pfn ctl_wire_order(o : Control.StepOrder) : CtlWireOrder do
  { wire: 1, seq: o.seq, release: o.release, step: o.step, node: o.node, action: o.action, want: o.want,
    artifacts: o.artifacts, lines: o.lines }
end

pfn ctl_order_of(w : CtlWireOrder) : Control.StepOrder do
  { seq: w.seq, release: w.release, step: w.step, node: w.node, action: w.action, want: w.want,
    artifacts: w.artifacts, lines: w.lines }
end

pfn ctl_wire_result(r : Control.StepResult) : CtlWireResult do
  { wire: 1, seq: r.seq, step: r.step, node: r.node, ok: r.ok, detail: r.detail }
end

pfn ctl_result_of(w : CtlWireResult) : Control.StepResult do
  { seq: w.seq, step: w.step, node: w.node, ok: w.ok, detail: w.detail }
end

-- ── the protocols (design section 7) ────────────────────────────────────────

-- The Agent initiates; Control is offered by the leader only, so the offer is
-- how an agent finds the leader. Every step is labelled (D25): this is the
-- protocol that must evolve across deploys of itself.
@[endpoints]
protocol Ctl do
  role Agent needs IO.NetConnect, IO.FileRead, IO.Mut, IO.Clock
  role Control needs IO.NetConnect, IO.FileRead, IO.FileWrite, IO.Mut, IO.Clock
  hello: Agent -> Control : CtlWireReport
  loop do
    choose by Control:
      apply -> Control -> Agent : CtlWireOrder
               stepped: Agent -> Control : CtlWireResult
      observe -> Control -> Agent : Int
                 report: Agent -> Control : CtlWireReport
      bye -> Control -> Agent : String
             stop
    end
  end
end

-- The Agent role of `Ctl`: say hello with a report, then answer every order
-- ([apply]) and poll until the leader says bye.
pfn ctl_agent_role(s : Cap(Session.Live), _nc : Cap(IO.NetConnect), _fr : Cap(IO.FileRead), _mu : Cap(IO.Mut), _ck : Cap(IO.Clock), st : Ctl_Agent.S_send_Hello, report : () -> Control.AgentReport, apply : Control.StepOrder -> Control.StepResult) : Ctl_Agent.Yield do
  ctl_agent_loop_(s, Ctl_Agent.send_Hello(s, st, ctl_wire_report(report())), report, apply)
end

pfn ctl_agent_loop_(s : Cap(Session.Live), st : Ctl_Agent.S_offer_apply_observe_bye, report : () -> Control.AgentReport, apply : Control.StepOrder -> Control.StepResult) : Ctl_Agent.Yield do
  Ctl_Agent.offer_apply_observe_bye(s, st,
    fn (o, st1) -> ctl_agent_loop_(s, Ctl_Agent.send_Stepped(s, st1, ctl_wire_result(apply(ctl_order_of(o)))), report, apply),
    -- A poll's report leaves `detail` out (the hello carried it): every byte
    -- of a session message costs more than a byte in the session runtime
    -- (specs/todos/2026-10-01-session-message-encoding-leak.md), and a poll
    -- comes every MARCH_CONTROL_POLL_MS.
    fn (_head, st1) -> ctl_agent_loop_(s, Ctl_Agent.send_Report(s, st1, ctl_wire_brief(report())), report, apply),
    fn (_why, st1) -> Ctl_Agent.close(s, st1))
end

-- The Control role of `Ctl` for one agent's session, driven by [ops].
pfn ctl_control_role(s : Cap(Session.Live), _nc : Cap(IO.NetConnect), _fr : Cap(IO.FileRead), _fw : Cap(IO.FileWrite), _mu : Cap(IO.Mut), _ck : Cap(IO.Clock), st : Ctl_Control.S_recv_Hello, ops : Control.ControlOps) : Ctl_Control.Yield do
  Ctl_Control.recv_Hello(s, st, fn (rep, st1) ->
    ops.report(ctl_report_of(rep))
    ctl_control_loop_(s, st1, rep.node, ops))
end

pfn ctl_control_loop_(s : Cap(Session.Live), st : Ctl_Control.S_choose_apply_observe_bye, node : String, ops : Control.ControlOps) : Ctl_Control.Yield do
  match ops.next(node) do
    Control.NextOrder(o) ->
      Ctl_Control.recv_Stepped(s, Ctl_Control.choose_apply(s, st, ctl_wire_order(o)), fn (res, st1) ->
        ops.stepped(ctl_result_of(res))
        ctl_control_loop_(s, st1, node, ops))
    Control.NextPoll ->
      Ctl_Control.recv_Report(s, Ctl_Control.choose_observe(s, st, ops.head()), fn (rep, st1) ->
        ops.report(ctl_report_of(rep))
        ctl_control_loop_(s, st1, node, ops))
    Control.NextBye(why) -> Ctl_Control.close(s, Ctl_Control.choose_bye(s, st, why))
  end
end

-- ── configuration and small helpers ─────────────────────────────────────────

-- The settings come from the environment, read once by `ctl_start` (which
-- holds the node's root capability) into this table: a role body may not read
-- the environment (`IO.Process`), only its grant.
pfn ctl_cfg(key : String, default : String) : String do Vault.get_or(ctl_memory(), "cfg:" ++ key, default) end

pfn ctl_cfg_int(key : String, default : Int) : Int do
  match string_to_int(ctl_cfg(key, "")) do
    Some(n) -> n
    None -> default
  end
end

-- How often a leader polls an agent that has nothing to do, and how many
-- exchanges one session lasts before the leader ends it. A leader that stops
-- leading ends its sessions at once (`ctl_next_for`), which is how an agent
-- finds the new one (the discovery model of design section 7); the budget is
-- only a backstop, and long: every session costs each side its session
-- tables, which the session runtime does not free yet
-- (specs/todos/2026-10-01-session-node-vault-tables-leak.md).
pfn ctl_poll_ms() : Int do ctl_cfg_int("poll_ms", 500) end
pfn ctl_session_polls() : Int do ctl_cfg_int("session_polls", 1200) end

-- Where a candidate keeps the releases it holds.
pfn ctl_dir() : String do ctl_cfg("dir", "/tmp/march-control") end

pfn ctl_words(s : String) : List(String) do
  List.filter(String.split(String.replace_all(s, ",", " "), " "), fn w -> w != "")
end

pfn ctl_field(line : String, key : String) : String do
  match List.find(ctl_words(line), fn w -> String.starts_with(w, key ++ ":")) do
    Some(w) -> String.slice(w, String.byte_size(key) + 1, String.byte_size(w) - String.byte_size(key) - 1)
    None -> ""
  end
end

pfn ctl_first(xs : List(String), f : String -> Option(String)) : Option(String) do
  match xs do
    Nil -> None
    Cons(x, rest) ->
      match f(x) do
        Some(v) -> Some(v)
        None -> ctl_first(rest, f)
      end
  end
end

pfn ctl_first_ep(xs : List((String, Int)), f : String -> Int -> Option(String)) : Option(String) do
  match xs do
    Nil -> None
    Cons((h, p), rest) ->
      match f(h, p) do
        Some(v) -> Some(v)
        None -> ctl_first_ep(rest, f)
      end
  end
end

pfn ctl_int(s : String) : Int do
  match string_to_int(s) do
    Some(n) -> n
    None -> 0
  end
end

-- The leader's state, kept ENCODED (`ctl_encode_leader`): a Vault releases a
-- value it overwrites only one level deep, so a record rewritten on every
-- poll leaked all it pointed to (gigabytes within a minute); a String has no
-- children.
pfn ctl_leaders() : Vault(String) do
  match Vault.whereis("ctl_leader") do
    Some(v) -> v
    None -> Vault.new("ctl_leader")
  end
end

pfn ctl_locks() : Vault(Int) do
  match Vault.whereis("ctl_locks") do
    Some(v) -> v
    None -> Vault.new("ctl_locks")
  end
end

pfn ctl_memory() : Vault(String) do
  match Vault.whereis("ctl_agent_memory") do
    Some(v) -> v
    None -> Vault.new("ctl_agent_memory")
  end
end

-- Tables are created once, before any session runs.
pfn ctl_init() : () do
  let _ = ctl_leaders()
  let _ = ctl_locks()
  let _ = ctl_memory()
  let _ = ctl_wants()
  ()
end

-- A short critical section over [name]: claimed with an atomic put-if-absent
-- that expires, so a session that dies inside it cannot hold it forever.
pfn ctl_lock(name : String, tries : Int) : Bool do
  if Vault.put_new_ttl(ctl_locks(), name, 1, 60) do true
  else if tries <= 0 do false
  else
    sleep_ms(10)
    ctl_lock(name, tries - 1)
  end end
end

pfn ctl_unlock(name : String) : () do Vault.drop(ctl_locks(), name) end

-- ── the node's reload server, and the CAS beside it ─────────────────────────

pfn ctl_node_state() : String do Control.state_line(Control.answer_lines(Control.relay_line("NODE_STATE"))) end

pfn ctl_cas_root() : String do ctl_field(ctl_node_state(), "cas") end

pfn ctl_artifact_path(h : String) : String do
  ctl_cas_root() ++ "/artifacts/" ++ String.slice(h, 0, 2) ++ "/" ++ String.slice(h, 2, String.byte_size(h) - 2)
end

-- The operator's public key this node was built to trust (`HCR_INFO`'s `key:`).
pfn ctl_pubkey() : Bytes do
  let info = Control.relay_line("HCR_INFO")
  match Bytes.from_hex(ctl_field(String.trim(info), "key")) do
    Ok(b) -> b
    Err(_) -> Bytes.empty()
  end
end

-- ── the Agent (every node) ──────────────────────────────────────────────────

pfn ctl_topology_applied(status : String) : Bool do
  let path = ctl_cfg("verified_file", "")
  if path == "" do false
  else match File.read(path) do
    Err(_) -> false
    Ok(text) ->
      match List.find(String.split(status, "\n"), fn l -> String.starts_with(l, "topology ")) do
        Some(l) -> String.trim(String.slice(l, 9, String.byte_size(l) - 9)) == Crypto.sha256(text)
        None -> false
      end
  end end
end

pfn ctl_status_of(node : Cap(ClusterNode.Live)) : (String, Bool) do
  let text = Topology.status_text(node)
  (text, ctl_topology_applied(text))
end

-- A signed line, relayed. A TOPOLOGY line's body is not in the release: it is
-- an artifact under its digest, read from this node's CAS and sent after the
-- line, as the reload socket expects. A COMMIT_BATCH (or an ACTIVATE) that
-- answers WAIT is asked again, as forge does: the activation is queued
-- server side until the epochs older than it have drained.
pfn ctl_relay(line : String, tries : Int) : String do
  let text = if String.contains(line, " TOPOLOGY ") do
    match ctl_first(ctl_words(line), fn w -> if String.byte_size(w) == 64 do Some(w) else None end) do
      Some(digest) ->
        match File.read(ctl_artifact_path(digest)) do
          Ok(body) -> line ++ "\n" ++ body
          Err(_) -> line
        end
      None -> line
    end
  else line end
  let resp = String.trim(String.replace_all(Control.relay_line(text), "READY\n", ""))
  if String.starts_with(resp, "WAIT") && tries > 0 do
    sleep_ms(500)
    ctl_relay(line, tries - 1)
  else resp end
end

pfn ctl_certs_of(node : Cap(ClusterNode.Live)) : String do
  Control.certs_text(ClusterNode.own_cert(node), ClusterNode.revocations(node))
end

pfn ctl_agent_ops(node : Cap(ClusterNode.Live)) : Control.AgentOps do
  let ops = Control.real_ops(Topology.node_name(node), ctl_cfg("pools", ""), fn -> ctl_status_of(node), fn -> ctl_certs_of(node), ctl_memory())
  { ops with request: fn line -> ctl_relay(line, 240) }
end

-- ── certificates and revocations (step 12b) ─────────────────────────────────
--
-- A `do:certs` order goes to `Control.agent_apply_certs` over this node's
-- `ClusterNode`: the certificate through `replace_cert` (keeping the node's
-- key: the control plane never carries a secret key), a revocation through
-- `revoke`, which gossips it on. A certificate taken is also written back to
-- the MARCH_NODE_CERT file (when the node was started from one), so a restart
-- comes back on it; the write happens in `ctl_prefetch_loop`, which holds the
-- node's root capability (a role body may not write files).

pfn ctl_own_serial(node : Cap(ClusterNode.Live)) : String do
  match ClusterNode.own_cert(node) do
    Some(c) -> c.serial
    None -> ""
  end
end

pfn ctl_cert_ops(node : Cap(ClusterNode.Live)) : Control.CertOps do
  { name: Topology.node_name(node), deploy_key: ctl_pubkey(), serial: fn -> ctl_own_serial(node),
    replace: fn text ->
      match ClusterNode.replace_cert(node, text, "") do
        Ok(c) ->
          Vault.set(ctl_memory(), "cert_persist", text)
          Ok(c.serial)
        Err(e) -> Err(e)
      end,
    revoke: fn t -> ClusterNode.revoke(node, t),
    floor: fn ->
      let head = ctl_int(ctl_field(ctl_node_state(), "head"))
      let taken = Control.cert_floor(ctl_memory())
      if head > taken do head else taken end }
end

-- Write a certificate this node took from a release to its MARCH_NODE_CERT
-- file (a temporary file renamed into place). The node's own file watch then
-- reads the same certificate back, which `replace_cert` takes as a no-op.
pfn ctl_persist_cert(io : Cap(IO)) : () do
  match Vault.get(ctl_memory(), "cert_persist") do
    None -> ()
    Some(text) ->
      Vault.drop(ctl_memory(), "cert_persist")
      let path = ctl_cfg("cert_file", "")
      if path == "" do ()
      else
        let tmp = path ++ ".delivered.tmp"
        match File.write(tmp, text ++ "\n") do
          Err(e) -> println("control: could not save the delivered certificate to " ++ path ++ ": " ++ to_string(e))
          Ok(_) ->
            match File.rename(tmp, path) do
              Ok(_) -> ()
              Err(e) -> println("control: could not save the delivered certificate to " ++ path ++ ": " ++ to_string(e))
            end
        end
      end
  end
end

-- Artifacts the Agent is waiting for: hash -> 1. An order that names an
-- artifact the node lacks puts it here and waits; `ctl_prefetch_loop`, which
-- holds the node's root capability (a role body may not), fetches it from a
-- candidate's control API (`CAS_GET`) and stores it through the node's own reload
-- server (`CAS_PUT`).
pfn ctl_wants() : Vault(Int) do
  match Vault.whereis("ctl_wants") do
    Some(v) -> v
    None -> Vault.new("ctl_wants")
  end
end

-- One artifact from a candidate's control API (`CAS_GET`), stored through
-- the node's own reload server (`CAS_PUT`). Artifacts travel as raw bytes over
-- the API, not as session messages: a session payload is a JSON value over a
-- list of byte Ints, and a 2 MB patch sent over it in chunks drove two nodes
-- past 2 GB (specs/progress/2026-09-30-dd-step12a-control-wiring.md).
pfn ctl_fetch_from(host : String, port : Int, hash : String) : Result(String, String) do
  match tcp_connect_timeout(host, port, 2000) do
    Err(e) -> Err(host ++ ":" ++ int_to_string(port) ++ ": " ++ e)
    Ok(fd) ->
      let _ = tcp_set_recv_timeout(fd, 30000)
      let out = match tcp_send_all(fd, "CAS_GET " ++ hash ++ "\n") do
        Err(e) -> Err(e)
        Ok(_) ->
          match ctl_read_line(fd, "", 0) do
            None -> Err("no answer")
            Some(l) ->
              if String.starts_with(l, "DATA ") do
                let size = ctl_int(String.slice(l, 5, String.byte_size(l) - 5))
                match tcp_recv_exact(fd, size) do
                  Ok(b) -> Ok(Bytes.to_string(b))
                  Err(e) -> Err(e)
                end
              else Err(l) end
          end
      end
      tcp_close(fd)
      out
  end
end

pfn ctl_fetch_any(eps : List((String, Int)), hash : String, why : String) : Result(String, String) do
  match eps do
    Nil -> Err(if why == "" do "no candidate to fetch from" else why end)
    Cons((h, p), rest) ->
      match ctl_fetch_from(h, p, hash) do
        Ok(body) -> Ok(body)
        Err(e) -> ctl_fetch_any(rest, hash, if why == "" do e else why ++ "; " ++ e end)
      end
  end
end

pfn ctl_fetch_one(node : Cap(ClusterNode.Live), hash : String) : Result((), String) do
  match ctl_fetch_any(ctl_others(node, ctl_cfg_int("port", 7947)), hash, "") do
    Err(e) -> Err(e)
    Ok(body) ->
      let resp = Control.relay_line("CAS_PUT " ++ hash ++ " " ++ int_to_string(String.byte_size(body)) ++ "\n" ++ body)
      if String.contains(resp, "OK ") do Ok(()) else Err("CAS_PUT: " ++ String.trim(resp)) end
  end
end

-- [wants] maps a hash to the time of its next attempt; a failed attempt waits
-- twice as long as the one before (1 s up to 30 s), so an artifact no
-- candidate can serve right now costs little.
pfn ctl_prefetch_one(io : Cap(IO), node : Cap(ClusterNode.Live), h : String) : () do
  let w = ctl_wants()
  let now = unix_time_ms()
  if now < Vault.get_or(w, h, 0) do ()
  else if String.starts_with(Control.relay_line("CAS_CHECK " ++ h), "PRESENT") do
    Vault.drop(w, h)
    Vault.drop(ctl_locks(), "fetch_backoff:" ++ h)
  else
    match ctl_fetch_one(node, h) do
      Ok(_) ->
        Vault.drop(w, h)
        Vault.drop(ctl_locks(), "fetch_backoff:" ++ h)
      Err(why) ->
        let back = Vault.get_or(ctl_locks(), "fetch_backoff:" ++ h, 1000)
        Vault.set(ctl_locks(), "fetch_backoff:" ++ h, if back * 2 > 30000 do 30000 else back * 2 end)
        Vault.set(w, h, now + back)
        println("control: fetching " ++ String.slice(h, 0, 12) ++ " failed (" ++ why ++ "); next try in " ++ int_to_string(back) ++ " ms")
    end
  end end
end

pfn ctl_prefetch_loop(io : Cap(IO), node : Cap(ClusterNode.Live)) : Int do
  List.each(Vault.keys(ctl_wants()), fn h -> ctl_prefetch_one(io, node, h))
  ctl_persist_cert(io)
  sleep_ms(200)
  ctl_prefetch_loop(io, node)
end

pfn ctl_wait_for(ops : Control.AgentOps, o : Control.StepOrder, left_ms : Int) : Bool do
  if Control.missing(ops, o) == Nil do true
  else if left_ms <= 0 do false
  else
    sleep_ms(100)
    ctl_wait_for(ops, o, left_ms - 100)
  end end
end

-- Apply one order: ask for what the node lacks and wait for it (a minute, at
-- most: past that `agent_apply` reports the missing artifacts and the release
-- halts), then relay (`agent_apply`). A `do:certs` order is the node's own
-- business, not its reload server's (`Control.agent_apply_certs`).
pfn ctl_apply(node : Cap(ClusterNode.Live), ops : Control.AgentOps, o : Control.StepOrder) : Control.StepResult do
  if o.action == "certs" do Control.agent_apply_certs_recording(ctl_cert_ops(node), ctl_memory(), o)
  else ctl_apply_relayed(ops, o) end
end

pfn ctl_apply_relayed(ops : Control.AgentOps, o : Control.StepOrder) : Control.StepResult do
  let need = Control.missing(ops, o)
  if need != Nil do
    List.each(need, fn h -> if Vault.get(ctl_wants(), h) == None do Vault.set(ctl_wants(), h, 0) else () end)
    let _ = ctl_wait_for(ops, o, 60000)
    ()
  else () end
  Control.agent_apply_recording(ops, ctl_memory(), o)
end

pfn ctl_agent_body(node : Cap(ClusterNode.Live), s : Cap(Session.Live), nc : Cap(IO.NetConnect), fr : Cap(IO.FileRead), mu : Cap(IO.Mut), ck : Cap(IO.Clock), st : Ctl_Agent.S_send_Hello) : Ctl_Agent.Yield do
  let ops = ctl_agent_ops(node)
  ctl_agent_role(s, nc, fr, mu, ck, st, fn -> ops.report(), fn o -> ctl_apply(node, ops, o))
end

-- Keep a `Ctl` session open with whoever offers `Control` now. A session ends
-- when the leader says bye or its node goes; the next one finds the leader as
-- it is then.
-- [backoff]: how long to wait after a failed attempt; it doubles up to 5 s
-- (an attempt costs session tables too) and starts over after a session.
--
-- A task runs the code of the epoch it was spawned in, so after a deploy of
-- this node every session it starts belongs to an epoch that is draining and
-- ends at its first loop boundary (D27): `Drained`. Retrying from here would
-- churn sessions for ever. The loop hands over to CtlRespawner instead, an
-- actor that has passed the deploy's marker, and the loop it spawns runs the
-- new code.
pfn ctl_agent_loop(io : Cap(IO), node : Cap(ClusterNode.Live), backoff : Int) : Int do
  match Ctl_Run.initiate_Agent(io, node, fn (s, nc, fr, mu, ck, st) -> ctl_agent_body(node, s, nc, fr, mu, ck, st)) do
    Ok(Session.Drained(_)) ->
      sleep_ms(200)
      match Vault.get(ctl_respawners(), "r") do
        Some(r) ->
          let _ = send(r, CtlRespawn(io, node))
          0
        None -> ctl_agent_loop(io, node, 250)
      end
    Ok(_) ->
      sleep_ms(100)
      ctl_agent_loop(io, node, 250)
    Err(e) ->
      -- Said once per distinct reason: the leader may simply not be up yet.
      let why = SessionNode.run_error_message(e)
      if Vault.get(ctl_memory(), "last_error") != Some(why) do
        Vault.set(ctl_memory(), "last_error", why)
        println("control: no session with a leader: " ++ why)
      else () end
      sleep_ms(backoff)
      ctl_agent_loop(io, node, if backoff * 2 > 5000 do 5000 else backoff * 2 end)
  end
end

type CtlRespawnerState = { ctl_respawns : Int }

actor CtlRespawner do
  state { ctl_respawns : Int }
  init  { ctl_respawns: 0 }
  on CtlRespawn(io : Cap(IO), node : Cap(ClusterNode.Live)) do
    let _ = task_spawn(fn _ -> ctl_agent_loop(io, node, 250))
    { ctl_respawns: state.ctl_respawns + 1 }
  end
end

pfn ctl_respawners() : Vault(Pid(CtlRespawnerState)) do
  match Vault.whereis("ctl_respawner") do
    Some(v) -> v
    None -> Vault.new("ctl_respawner")
  end
end

-- ── the leader ──────────────────────────────────────────────────────────────

pfn ctl_release_file(seq : Int) : String do
  ctl_dir() ++ "/releases/" ++ String.pad_left(int_to_string(seq), 12, "0") ++ ".release"
end

-- Write a release durably: a temporary file renamed into place. [text] is
-- its serialised form (taken before the release is handed to the leader).
pfn ctl_store_release(seq : Int, text : String) : Bool do
  let _ = Dir.mkdir_p(ctl_dir() ++ "/releases")
  let path = ctl_release_file(seq)
  let tmp = path ++ ".tmp"
  match File.write(tmp, text) do
    Err(_) -> false
    Ok(_) ->
      match File.rename(tmp, path) do
        Ok(_) -> true
        Err(_) -> false
      end
  end
end

pfn ctl_forget_release(seq : Int) : () do
  let _ = File.delete(ctl_release_file(seq))
  ()
end

-- The newest release this candidate holds on disk.
pfn ctl_load_newest() : Option(Control.CtlRelease) do
  match Dir.list(ctl_dir() ++ "/releases") do
    Err(_) -> None
    Ok(names) ->
      let files = List.sort_by(List.filter(names, fn n -> String.ends_with(n, ".release")), fn (a, b) -> a > b)
      match List.head_opt(files) do
        None -> None
        Some(f) ->
          match File.read(ctl_dir() ++ "/releases/" ++ f) do
            Err(_) -> None
            Ok(text) ->
              match Control.parse(text) do
                Ok(r) -> Some(r)
                Err(_) -> None
              end
          end
      end
  end
end

pfn ctl_head_seq(l : Control.CtlLeader) : Int do
  match l.release do
    Some(r) -> r.seq
    None -> 0
  end
end

-- A node that starts leading takes the newest release it holds on disk:
-- every reachable candidate got a copy before forge was told "accepted".
pfn ctl_ensure_loaded() : () do
  let lv = ctl_leaders()
  let held = Vault.get(lv, "leader") != None
  let cur = ctl_leader_state()
  match ctl_load_newest() do
    None -> if held do () else ctl_put_leader(cur) end
    Some(r) ->
      if r.seq > ctl_head_seq(cur) do
        match Control.leader_release(Control.leader_new(), r) do
          Ok(l) -> ctl_put_leader(l)
          Err(_) -> ctl_put_leader(cur)
        end
      else if held do () else ctl_put_leader(cur) end end
  end
end

pfn ctl_encode_obs(o : Control.CtlObs) : String do
  let since = match o.healthy_since do
    Some(t) -> int_to_string(t)
    None -> "-"
  end
  "obs " ++ since ++ " " ++ Json.to_string(to_json(ctl_wire_report(o.report))) ++ "\n"
end

-- The dynamic part only; the release is kept as a value of its own
-- (`ctl_releases`), written only when it changes: re-parsing it on every poll
-- cost about 10 KB a parse.
pfn ctl_encode_leader(l : Control.CtlLeader) : String do
  let halted = match l.halted do
    Some(Control.RolloutHalted(st, n, why)) -> int_to_string(st) ++ "\t" ++ n ++ "\t" ++ String.replace_all(why, "\n", " ")
    _ -> "-"
  end
  "inflight " ++ String.join(l.inflight, ",") ++ "\n" ++ "halted " ++ halted ++ "\n"
    ++ String.join(List.map(l.obs, fn o -> ctl_encode_obs(o)), "")
end

pfn ctl_report_from(js : String) : Option(Control.AgentReport) do
  match Json.parse(js) do
    Ok(jv) ->
      match from_json(jv) do
        Ok(w) -> Some(ctl_report_of(w))
        Err(_) -> None
      end
    Err(_) -> None
  end
end

pfn ctl_decode_obs(line : String) : Option(Control.CtlObs) do
  match String.split_first(String.slice(line, 4, String.byte_size(line) - 4), " ") do
    Some((since, js)) ->
      match ctl_report_from(js) do
        Some(rep) -> Some({ report: rep, healthy_since: if since == "-" do None else Some(ctl_int(since)) end })
        None -> None
      end
    None -> None
  end
end

pfn ctl_decode_halted(v : String) : Option(Control.CtlDecision) do
  if v == "-" do None
  else
    let parts = String.split(v, "\t")
    match parts do
      Cons(st, Cons(n, rest)) -> Some(Control.RolloutHalted(ctl_int(st), n, String.join(rest, "\t")))
      _ -> None
    end
  end
end

pfn ctl_decode_leader(text : String, release : Option(Control.CtlRelease)) : Control.CtlLeader do
  let lines = String.split(text, "\n")
  let inflight = match List.find(lines, fn x -> String.starts_with(x, "inflight ")) do
    Some(x) -> ctl_words(String.slice(x, 9, String.byte_size(x) - 9))
    None -> Nil
  end
  let halted = match List.find(lines, fn x -> String.starts_with(x, "halted ")) do
    Some(x) -> ctl_decode_halted(String.slice(x, 7, String.byte_size(x) - 7))
    None -> None
  end
  let obs = List.filter_map(List.filter(lines, fn x -> String.starts_with(x, "obs ")), fn x -> ctl_decode_obs(x))
  { release: release, obs: obs, inflight: inflight, halted: halted }
end

pfn ctl_releases() : Vault(Control.CtlRelease) do
  match Vault.whereis("ctl_release") do
    Some(v) -> v
    None -> Vault.new("ctl_release")
  end
end

pfn ctl_leader_state() : Control.CtlLeader do
  match Vault.get(ctl_leaders(), "leader") do
    Some(t) -> ctl_decode_leader(t, Vault.get(ctl_releases(), "r"))
    None -> Control.leader_new()
  end
end

pfn ctl_put_leader(l : Control.CtlLeader) : () do
  let held = match Vault.get(ctl_releases(), "r") do
    Some(r) -> r.seq
    None -> 0
  end
  match l.release do
    Some(r) -> if r.seq != held do Vault.set(ctl_releases(), "r", r) else () end
    None -> ()
  end
  Vault.set(ctl_leaders(), "leader", ctl_encode_leader(l))
end

-- ── the leader's audit log (design section 9) ──────────────────────────────
--
-- `<dir>/audit.jsonl` on every candidate: each release offered to a leader
-- (accepted, or refused and why), each order a leader sends, each answer, and
-- each release's halt or completion (`Control.audit_*` writes the lines). The
-- leader appends here and queues the line; `ctl_audit_copier` appends the
-- queue on the other reachable candidates (`AUDIT_COPY`), so the file outlives
-- a leader change. The control API's `AUDIT [n]` answers this candidate's file.

pfn ctl_audit_file() : String do ctl_dir() ++ "/audit.jsonl" end

pfn ctl_audit_append(text : String) : () do
  let _ = Dir.mkdir_p(ctl_dir())
  let _ = File.append(ctl_audit_file(), text)
  ()
end

pfn ctl_audit(line : String) : () do
  ctl_audit_append(line)
  if ctl_lock("audit", 200) do
    Vault.set(ctl_memory(), "audit_q", Vault.get_or(ctl_memory(), "audit_q", "") ++ line)
    ctl_unlock("audit")
  else () end
end

-- A candidate's copier: every second, the lines queued since are appended on
-- every other reachable candidate. A candidate that does not answer misses
-- them (as it misses a release copy).
pfn ctl_audit_copier(node : Cap(ClusterNode.Live), port : Int) : () do
  sleep_ms(1000)
  let batch = if ctl_lock("audit", 200) do
    let q = Vault.get_or(ctl_memory(), "audit_q", "")
    if q != "" do Vault.set(ctl_memory(), "audit_q", "") else () end
    ctl_unlock("audit")
    q
  else "" end
  if batch != "" do
    List.each(ctl_others(node, port), fn hp ->
      let (host, cport) = hp
      let _ = ctl_call(host, cport, "AUDIT_COPY " ++ int_to_string(String.byte_size(batch)) ++ "\n" ++ batch)
      ())
  else () end
  ctl_audit_copier(node, port)
end

-- The last [n] lines of this candidate's audit log (all when [n] is 0), as
-- the control API answers `AUDIT`.
pfn ctl_audit_answer(n : Int) : String do
  let lines = match File.read(ctl_audit_file()) do
    Ok(t) -> List.filter(String.split(t, "\n"), fn x -> x != "")
    Err(_) -> Nil
  end
  let total = List.length(lines)
  let keep = if n > 0 && n < total do List.drop(lines, total - n) else lines end
  "AUDIT " ++ int_to_string(List.length(keep)) ++ "\n" ++ String.join(List.map(keep, fn x -> x ++ "\n"), "") ++ "END\n"
end

pfn ctl_members_of(l : Control.CtlLeader) : List(Control.CtlMember) do
  List.map(l.obs, fn o -> { node: o.report.node, pools: ctl_words(o.report.pools) })
end

-- The leader passes only once every live agent has reported: a node that has
-- not said hello yet may belong to a step's pool, and the executor would
-- otherwise call the step done without it. An agent marks itself
-- (`ctl_mark_agent`) and is waited for until it reports. A member with no
-- mark is waited for only for a grace period from when this leader first saw
-- it (its mark may not have reached us yet); after that it is taken to run no
-- agent (a client joined to the cluster, an upgrade test's traffic), which
-- would otherwise hold every rollout forever.
pfn ctl_ready(node : Cap(ClusterNode.Live), l : Control.CtlLeader) : Bool do
  let seen = List.map(l.obs, fn o -> o.report.node)
  let agents = Topology.marked("Ctl.Agent", ClusterNode.names(node))
  let now = unix_time_ms()
  let grace = ctl_cfg_int("agent_grace_ms", 20000)
  List.all(List.filter(ClusterNode.all_members(node), fn m ->
    match m.status do
      Membership.Dead -> false
      _ -> not(List.member(seen, m.name))
    end), fn m ->
    if List.member(agents, m.node_id) do false
    else
      let key = "first_seen:" ++ m.name
      let first = match string_to_int(Vault.get_or(ctl_memory(), key, "")) do
        Some(t) -> t
        None ->
          Vault.set(ctl_memory(), key, int_to_string(now))
          now
      end
      now - first >= grace
    end)
end

-- Mark this node as running the Agent (the name `ctl_ready` looks for),
-- bound to an actor that lives as long as the node.
pfn ctl_mark_agent(node : Cap(ClusterNode.Live), pid : Pid(CtlRespawnerState)) : () do
  let name = Topology.marker("Ctl.Agent", ClusterNode.node_id(node))
  if ClusterNode.lookup(node, name) == None do
    let _ = ClusterNode.register(node, name, pid)
    ()
  else () end
end

pfn ctl_next_for(node : Cap(ClusterNode.Live), name : String) : Control.CtlNext do
  let polls = Vault.incr(ctl_locks(), "polls:" ++ name, 1)
  if not(ctl_is_leader(node)) do
    Vault.drop(ctl_locks(), "polls:" ++ name)
    Control.NextBye("no longer the leader; look for the new one")
  else if polls > ctl_session_polls() do
    Vault.drop(ctl_locks(), "polls:" ++ name)
    Control.NextBye("session over; look for the leader again")
  else
    let got = ctl_lock("leader", 500)
    let l = ctl_leader_state()
    let verdict = if not(ctl_ready(node, l)) do (l, None) else Control.leader_pass(l, ctl_members_of(l), unix_time_ms()) end
    let (l2, d) = verdict
    let _ = if got do ctl_put_leader(l2) else () end
    if got do ctl_unlock("leader") else () end
    if got do ctl_audit_end(node, l2, d) else () end
    match d do
      Some(Control.RolloutApply(_, os)) ->
        match List.find(os, fn o -> o.node == name) do
          Some(o) ->
            ctl_audit(Control.audit_order(unix_time_ms(), Topology.node_name(node), o))
            Control.NextOrder(o)
          None ->
            sleep_ms(ctl_poll_ms())
            Control.NextPoll
        end
      _ ->
        sleep_ms(ctl_poll_ms())
        Control.NextPoll
    end
  end end
end

-- A release's halt or completion, audited once per release (the verdict is
-- re-derived on every pass).
pfn ctl_audit_end(node : Cap(ClusterNode.Live), l : Control.CtlLeader, d : Option(Control.CtlDecision)) : () do
  match (l.release, d) do
    (Some(r), Some(dd)) ->
      match Control.audit_decision(unix_time_ms(), Topology.node_name(node), r.seq, dd) do
        Some(line) ->
          let key = "audited_end:" ++ int_to_string(r.seq)
          if Vault.get(ctl_memory(), key) == None do
            Vault.set(ctl_memory(), key, "1")
            ctl_audit(line)
          else () end
        None -> ()
      end
    _ -> ()
  end
end

pfn ctl_leader_ops(node : Cap(ClusterNode.Live)) : Control.ControlOps do
  { report: fn rep ->
      let got = ctl_lock("leader", 500)
      if got do
        ctl_put_leader(Control.leader_report(ctl_leader_state(), rep, unix_time_ms()))
        ctl_unlock("leader")
      else () end,
    stepped: fn res ->
      let _ = ctl_audit(Control.audit_step(unix_time_ms(), Topology.node_name(node), res))
      let got = ctl_lock("leader", 500)
      if got do
        ctl_put_leader(Control.leader_result(ctl_leader_state(), res, unix_time_ms()))
        ctl_unlock("leader")
      else () end,
    next: fn name -> ctl_next_for(node, name),
    head: fn -> ctl_head_seq(ctl_leader_state()) }
end

-- The body of the `Ctl.Control` role: one session per agent.
pfn ctl_control_session(node : Cap(ClusterNode.Live), s : Cap(Session.Live), nc : Cap(IO.NetConnect), fr : Cap(IO.FileRead), fw : Cap(IO.FileWrite), mu : Cap(IO.Mut), ck : Cap(IO.Clock), st : Ctl_Control.S_recv_Hello) : Ctl_Control.Yield do
  ctl_ensure_loaded()
  ctl_control_role(s, nc, fr, fw, mu, ck, st, ctl_leader_ops(node))
end

-- ── the control API (design section 9) ──────────────────────────────────────
--
-- A TCP line protocol on every candidate: the reload socket's unsigned verbs,
-- and `RELEASE <size>` (a release document follows), `STATUS`, `LEADER`,
-- `AUDIT [n]` (this candidate's audit log) and the candidates' own
-- `RELEASE_COPY <size>` and `AUDIT_COPY <size>`. A standby forwards `RELEASE`
-- and `STATUS` to the leader, so forge can talk to any candidate.

pfn ctl_read_line(fd : Int, acc : String, n : Int) : Option(String) do
  if n > 65536 do None
  else match tcp_recv_exact(fd, 1) do
    Err(_) -> if acc == "" do None else Some(acc) end
    Ok(b) ->
      let c = Bytes.to_string(b)
      if c == "\n" do Some(acc)
      else if c == "\r" do ctl_read_line(fd, acc, n)
      else ctl_read_line(fd, acc ++ c, n + 1) end end
  end end
end

pfn ctl_reply(fd : Int, text : String) : () do
  let _ = tcp_send_all(fd, text)
  ()
end

pfn ctl_host_of(addr : String) : String do
  let parts = String.split(addr, ":")
  String.join(List.take(parts, List.length(parts) - 1), ":")
end

-- One request to a candidate's control API: send [text], read the first
-- answer line.
pfn ctl_call(host : String, port : Int, text : String) : Option(String) do
  match tcp_connect_timeout(host, port, 2000) do
    Err(_) -> None
    Ok(fd) ->
      let _ = tcp_set_recv_timeout(fd, 15000)
      let out = match tcp_send_all(fd, text) do
        Err(_) -> None
        Ok(_) -> ctl_read_line(fd, "", 0)
      end
      tcp_close(fd)
      out
  end
end

-- The other candidates' control API addresses, as (host, port). Every
-- candidate serves the topology's port on its own host; a cluster of several
-- nodes on one machine (a test, `forge run --processes`) sets
-- MARCH_CONTROL_PORT_OFFSET, and a node's port is then its cluster port plus
-- the offset.
pfn ctl_others(node : Cap(ClusterNode.Live), port : Int) : List((String, Int)) do
  let me = ClusterNode.node_id(node)
  let offset = ctl_cfg_int("port_offset", 0)
  List.filter_map(Topology.role_candidates(node, "Ctl.Control"), fn m ->
    if m.node_id == me || m.addr == "" do None
    else
      let parts = String.split(m.addr, ":")
      let host = ctl_host_of(m.addr)
      if offset == 0 do Some((host, port))
      else match List.head_opt(List.reverse(parts)) do
        Some(p) -> Some((host, ctl_int(p) + offset))
        None -> None
      end end
    end)
end

pfn ctl_is_leader(node : Cap(ClusterNode.Live)) : Bool do Topology.offering(node, "Ctl.Control") end

-- The signature check on a release: the operator's key this node trusts.
pfn ctl_signed(r : Control.CtlRelease) : Bool do Control.verify(r, ctl_pubkey()) end

-- Replicate a release, and the artifacts it ships, to every other reachable
-- candidate; true when each reachable one stored the release.
pfn ctl_replicate(node : Cap(ClusterNode.Live), port : Int, body : String, hashes : List(String)) : String do
  let failures = List.filter_map(ctl_others(node, port), fn hp ->
    let (host, cport) = hp
    List.each(hashes, fn h -> ctl_push_artifact(host, cport, h))
    match ctl_call(host, cport, "RELEASE_COPY " ++ int_to_string(String.byte_size(body)) ++ "\n" ++ body) do
      Some(resp) -> if String.starts_with(resp, "OK") do None else Some(host ++ ":" ++ int_to_string(cport) ++ " answered " ++ resp) end
      None -> None
    end)
  String.join(failures, "; ")
end

-- Give a candidate an artifact it lacks.
pfn ctl_push_artifact(host : String, port : Int, h : String) : () do
  match ctl_call(host, port, "CAS_CHECK " ++ h ++ "\n") do
    Some(resp) ->
      if String.starts_with(resp, "MISSING") do
        match File.read(ctl_artifact_path(h)) do
          Ok(data) ->
            let _ = ctl_call_body(host, port, "CAS_PUT " ++ h ++ " " ++ int_to_string(String.byte_size(data)), data)
            ()
          Err(_) -> ()
        end
      else () end
    None -> ()
  end
end

-- A request with a body: the line, "READY" from the far end, then the body.
pfn ctl_call_body(host : String, port : Int, line : String, body : String) : Option(String) do
  ctl_call(host, port, line ++ "\n" ++ body)
end

-- The leader accepts a release: signature, the compare-and-set on `parent`
-- (`Control.leader_release`), durable on this node and on every reachable
-- candidate before the answer. Every release offered is audited, accepted or
-- refused.
pfn ctl_release(node : Cap(ClusterNode.Live), port : Int, text : String) : String do
  let me = Topology.node_name(node)
  match Control.parse(text) do
    Err(e) ->
      ctl_audit(Control.audit_release(unix_time_ms(), me, 0, "-", "err_parse", e))
      "ERR bad_release " ++ e
    Ok(r) ->
      if not(ctl_signed(r)) do
        ctl_audit(Control.audit_release(unix_time_ms(), me, r.seq, Control.digest(r), "err_sig", "bad signature"))
        "ERR bad_signature"
      else if not(ctl_lock("release", 1000)) do "ERR busy"
      else
        -- What is needed of the release after the leader takes it is read
        -- out first.
        let seq = r.seq
        let digest = Control.digest(r)
        let body = Control.serialize(r)
        let hashes = Cons(r.topology, List.map(r.builds, fn b -> b.manifest))
        ctl_ensure_loaded()
        let l = ctl_leader_state()
        let out = match Control.leader_release(l, r) do
          Err(e) ->
            ctl_audit(Control.audit_release(unix_time_ms(), me, seq, digest, Control.audit_refusal(e), e))
            "ERR " ++ e
          Ok(l2) ->
            if not(ctl_store_release(seq, body)) do
              ctl_audit(Control.audit_release(unix_time_ms(), me, seq, digest, "err_store", "could not store the release"))
              "ERR could_not_store"
            else
              let why = ctl_replicate(node, port, body, hashes)
              if why != "" do
                ctl_forget_release(seq)
                ctl_audit(Control.audit_release(unix_time_ms(), me, seq, digest, "err_replicate", why))
                "ERR could_not_replicate " ++ why
              else
                ctl_put_leader(l2)
                ctl_audit(Control.audit_release(unix_time_ms(), me, seq, digest, "ok", ""))
                "OK " ++ int_to_string(seq) ++ " " ++ digest
              end
            end
        end
        ctl_unlock("release")
        out
      end end
  end
end

-- A copy from the leader: store it (the leader has already accepted it).
pfn ctl_release_copy(text : String) : String do
  match Control.parse(text) do
    Err(e) -> "ERR bad_release " ++ e
    Ok(r) ->
      if not(ctl_signed(r)) do "ERR bad_signature"
      else if ctl_store_release(r.seq, Control.serialize(r)) do "OK stored" else "ERR could_not_store" end end
  end
end

pfn ctl_state_word(d : Option(Control.CtlDecision)) : String do
  match d do
    None -> "none"
    Some(Control.RolloutComplete) -> "complete"
    Some(Control.RolloutHalted(_, _, _)) -> "halted"
    Some(Control.RolloutBehind(_)) -> "behind"
    Some(_) -> "running"
  end
end

pfn ctl_node_line(o : Control.CtlObs) : String do
  let r = o.report
  "NODE " ++ r.node ++ " seq:" ++ int_to_string(r.seq) ++ " healthy:" ++ (if r.healthy do "yes" else "no" end)
    ++ " topology:" ++ r.topology ++ " drained:" ++ int_to_string(r.drained)
    ++ " versions:" ++ (if r.versions == "" do "-" else String.replace_all(r.versions, " ", ",") end)
    ++ " cert:" ++ (if Control.report_serial(r) == "" do "-" else Control.report_serial(r) end)
    ++ " failed:" ++ (if r.failed_seq == 0 do "-" else int_to_string(r.failed_seq) ++ "/" ++ int_to_string(r.failed_step) ++ ":" ++ String.replace_all(r.failed_why, " ", "_") end) ++ "\n"
end

-- Gates skipped, as this leader sees it. Placement chooses a leader and
-- nothing stops two leading at once across a partition (D40): each drives its
-- side toward the newest release, so one can order a later step on a node
-- while this leader is still inside an earlier step's gate. Releases stay
-- correct (the nodes enforce sequence, and an order already applied is a
-- no-op), but the canary window was not watched here, and STATUS says so.
pfn ctl_decision_step(d : Option(Control.CtlDecision)) : Int do
  match d do
    Some(Control.RolloutApply(s, _)) -> s
    Some(Control.RolloutWait(s, _)) -> s
    _ -> 0
  end
end

pfn ctl_done_nodes(stp : Control.CtlStep, r : Control.CtlRelease, l : Control.CtlLeader, sel : List(String)) : List(String) do
  List.filter(sel, fn n ->
    match List.find(l.obs, fn o -> o.report.node == n) do
      Some(o) -> Control.reports_state(o.report, Control.show_action(stp.action), Control.want_for(r, stp, n))
      None -> false
    end)
end

pfn ctl_skip_notes_from(steps : List(Control.CtlStep), r : Control.CtlRelease, l : Control.CtlLeader, members : List(Control.CtlMember), prior : List((Control.CtlStep, List(String))), open_step : Int) : List(String) do
  match steps do
    Nil -> Nil
    Cons(stp, rest) ->
      let sel = Control.select(stp, members, prior)
      let own = if stp.id > open_step do
        List.map(ctl_done_nodes(stp, r, l, sel), fn n -> "NOTE step " ++ int_to_string(stp.id) ++ " already applied on " ++ n ++ " while step " ++ int_to_string(open_step) ++ " is still open here: its gate was not observed by this leader\n")
      else Nil end
      List.append(own, ctl_skip_notes_from(rest, r, l, members, List.append(prior, [(stp, sel)]), open_step))
  end
end

pfn ctl_gate_notes(l : Control.CtlLeader, d : Option(Control.CtlDecision)) : String do
  match l.release do
    None -> ""
    Some(r) ->
      let open_step = ctl_decision_step(d)
      if open_step == 0 do "" else String.join(ctl_skip_notes_from(r.steps, r, l, ctl_members_of(l), Nil, open_step), "") end
  end
end

-- What forge follows: the head, the executor's verdict, each node's report.
pfn ctl_status(node : Cap(ClusterNode.Live)) : String do
  ctl_ensure_loaded()
  let l = ctl_leader_state()
  let d = if ctl_ready(node, l) do Tuple.second(Control.leader_pass(l, ctl_members_of(l), unix_time_ms())) else None end
  let head = match l.release do
    Some(r) -> int_to_string(r.seq) ++ " " ++ Control.digest(r)
    None -> "0 -"
  end
  "STATUS head:" ++ head ++ " state:" ++ ctl_state_word(d) ++ " leader:" ++ Topology.node_name(node) ++ "\n"
    ++ "DECISION " ++ (match d do
      Some(x) -> Control.show_decision(x)
      None -> if ctl_ready(node, l) do "no release" else "waiting for every node to report" end
    end) ++ "\n"
    ++ String.join(List.map(List.sort_by(l.obs, fn (a, b) -> a.report.node < b.report.node), fn o -> ctl_node_line(o)), "")
    ++ ctl_gate_notes(l, d)
    ++ "END\n"
end

-- Ask the other candidates until one is the leader; its answer is ours.
pfn ctl_forward(node : Cap(ClusterNode.Live), port : Int, text : String) : String do
  let rec_first = ctl_first_ep(ctl_others(node, port), fn (host, cport) ->
    match ctl_call(host, cport, "FORWARDED " ++ text) do
      Some(resp) -> if String.starts_with(resp, "ERR not_leader") do None else Some(resp) end
      None -> None
    end)
  match rec_first do
    Some(r) -> r
    None -> "ERR no_leader"
  end
end

-- Read the rest of a STATUS answer after its first line.
pfn ctl_forward_status(node : Cap(ClusterNode.Live), port : Int) : String do
  let rec_first = ctl_first_ep(ctl_others(node, port), fn (host, cport) ->
    match ctl_call_lines(host, cport, "FORWARDED STATUS\n") do
      Some(text) -> if String.starts_with(text, "ERR") do None else Some(text) end
      None -> None
    end)
  match rec_first do
    Some(t) -> t
    None -> "ERR no_leader\n"
  end
end

pfn ctl_call_lines(host : String, port : Int, text : String) : Option(String) do
  match tcp_connect_timeout(host, port, 2000) do
    Err(_) -> None
    Ok(fd) ->
      let _ = tcp_set_recv_timeout(fd, 15000)
      let out = match tcp_send_all(fd, text) do
        Err(_) -> None
        Ok(_) -> Some(ctl_read_until_end(fd, ""))
      end
      tcp_close(fd)
      out
  end
end

pfn ctl_read_until_end(fd : Int, acc : String) : String do
  match ctl_read_line(fd, "", 0) do
    None -> acc
    Some(l) -> if l == "END" do acc ++ "END\n" else ctl_read_until_end(fd, acc ++ l ++ "\n") end
  end
end

-- Verbs the control API passes to this node's reload server unchanged: the
-- unsigned reads. The signed verbs are not relayed here (a node takes its
-- orders over `Ctl`, and verifies them itself).
pfn ctl_passthrough(verb : String) : Bool do
  List.member(["PING", "VERSIONS", "VERSIONS_DETAIL", "PINS", "RELEASE_HEAD", "NODE_STATE", "HCR_INFO", "GET_EPOCH", "COMPACT"], verb)
end

-- One request on a connection; false when the connection is done.
pfn ctl_api_request(node : Cap(ClusterNode.Live), port : Int, fd : Int) : Bool do
  match ctl_read_line(fd, "", 0) do
    None -> false
    Some(line0) ->
      let fwd = String.starts_with(line0, "FORWARDED ")
      let line = if fwd do String.slice(line0, 10, String.byte_size(line0) - 10) else line0 end
      let ws = ctl_words(line)
      let verb = match List.head_opt(ws) do
        Some(v) -> v
        None -> ""
      end
      let arg = fn i -> match List.head_opt(List.drop(ws, i)) do
        Some(x) -> ctl_int(x)
        None -> 0
      end
      match verb do
        "RELEASE" -> ctl_api_release(node, port, fd, fwd, arg(1), false)
        "RELEASE_COPY" -> ctl_api_release(node, port, fd, fwd, arg(1), true)
        "STATUS" ->
          if ctl_is_leader(node) do ctl_reply(fd, ctl_status(node))
          else if fwd do ctl_reply(fd, "ERR not_leader\n")
          else ctl_reply(fd, ctl_forward_status(node, port)) end end
          true
        "CAS_GET" ->
          -- An artifact's bytes from this node's CAS: `DATA <size>` then the bytes.
          let h = match List.head_opt(List.drop(ws, 1)) do
            Some(x) -> x
            None -> ""
          end
          if String.byte_size(h) != 64 do ctl_reply(fd, "ERR bad_hash\n")
          else match File.read(ctl_artifact_path(h)) do
            Ok(data) -> ctl_reply(fd, "DATA " ++ int_to_string(String.byte_size(data)) ++ "\n" ++ data)
            Err(_) -> ctl_reply(fd, "ERR missing\n")
          end end
          true
        "AUDIT" ->
          ctl_reply(fd, ctl_audit_answer(arg(1)))
          true
        "AUDIT_COPY" ->
          -- `AUDIT_COPY <size>`: lines a leader audited, to append here.
          let size = arg(1)
          if size <= 0 || size > 1048576 do
            ctl_reply(fd, "ERR bad_size\n")
            true
          else match tcp_recv_exact(fd, size) do
            Err(_) -> false
            Ok(b) ->
              ctl_audit_append(Bytes.to_string(b))
              ctl_reply(fd, "OK\n")
              true
          end end
        "LEADER" ->
          ctl_reply(fd, (if ctl_is_leader(node) do "LEADER yes " else "LEADER no " end) ++ Topology.node_name(node) ++ "\n")
          true
        "CAS_PUT" ->
          -- `CAS_PUT <hash> <size>`, READY, <size> bytes, the verdict: the reload socket's own exchange.
          let size = arg(2)
          if size <= 0 do
            ctl_reply(fd, "ERR bad_size\n")
            true
          else
            ctl_reply(fd, "READY\n")
            match tcp_recv_exact(fd, size) do
              Err(_) -> false
              Ok(b) ->
                let resp = Control.relay_line(line ++ "\n" ++ Bytes.to_string(b))
                ctl_reply(fd, String.replace_all(resp, "READY\n", ""))
                true
            end
          end
        _ ->
          if ctl_passthrough(verb) || verb == "CAS_CHECK" do ctl_reply(fd, Control.relay_line(line))
          else ctl_reply(fd, "ERR unknown_command\n") end
          true
      end
  end
end

-- `RELEASE <size>` and `RELEASE_COPY <size>`: the document follows the line.
pfn ctl_api_release(node : Cap(ClusterNode.Live), port : Int, fd : Int, fwd : Bool, size : Int, copy : Bool) : Bool do
  if size <= 0 || size > 1048576 do
    ctl_reply(fd, "ERR bad_size\n")
    true
  else match tcp_recv_exact(fd, size) do
    Err(_) -> false
    Ok(b) ->
      let body = Bytes.to_string(b)
      if copy do ctl_reply(fd, ctl_release_copy(body) ++ "\n")
      else if ctl_is_leader(node) do ctl_reply(fd, ctl_release(node, port, body) ++ "\n")
      else if fwd do ctl_reply(fd, "ERR not_leader\n")
      else ctl_reply(fd, ctl_forward(node, port, "RELEASE " ++ int_to_string(size) ++ "\n" ++ body) ++ "\n") end end end
      true
  end end
end

pfn ctl_api_conn(node : Cap(ClusterNode.Live), port : Int, fd : Int) : () do
  if ctl_api_request(node, port, fd) do ctl_api_conn(node, port, fd) else tcp_close(fd) end
end

pfn ctl_api_accept(node : Cap(ClusterNode.Live), port : Int, lfd : Int) : Int do
  match tcp_accept(lfd) do
    Err(_) -> sleep_ms(200)
    Ok(fd) ->
      let _ = task_spawn(fn _ -> ctl_api_conn(node, port, fd))
      ()
  end
  ctl_api_accept(node, port, lfd)
end

-- ── starting it all ─────────────────────────────────────────────────────────

-- Called by the generated `main` after `Topology.place`: every node runs the
-- Agent; a candidate (a node carrying [label]) also serves the control API.
fn ctl_start(io : Cap(IO), node : Cap(ClusterNode.Live), label : String, port : Int) : () do
  ctl_init()
  let m = ctl_memory()
  Vault.set(m, "cfg:dir", Env.get("MARCH_CONTROL_DIR", "/tmp/march-control"))
  Vault.set(m, "cfg:poll_ms", Env.get("MARCH_CONTROL_POLL_MS", "500"))
  Vault.set(m, "cfg:session_polls", Env.get("MARCH_CONTROL_SESSION_POLLS", "1200"))
  Vault.set(m, "cfg:verified_file", Env.get("MARCH_TOPOLOGY_VERIFIED_FILE", ""))
  Vault.set(m, "cfg:port", int_to_string(port))
  Vault.set(m, "cfg:port_offset", Env.get("MARCH_CONTROL_PORT_OFFSET", "0"))
  Vault.set(m, "cfg:pools", String.join(ctl_words(Env.get("MARCH_POOLS", "")), " "))
  -- Where a certificate taken from a release is saved: MARCH_NODE_CERT, when
  -- it names a file (it may instead hold the certificate itself).
  let cert_env = Env.get("MARCH_NODE_CERT", "")
  Vault.set(m, "cfg:cert_file", if cert_env != "" && File.exists(cert_env) do cert_env else "" end)
  Vault.set(m, "cfg:agent_grace_ms", Env.get("MARCH_CONTROL_AGENT_GRACE_MS", "20000"))
  let respawner = spawn(CtlRespawner)
  Vault.set(ctl_respawners(), "r", respawner)
  ctl_mark_agent(node, respawner)
  let _ = task_spawn(fn _ -> ctl_agent_loop(io, node, 250))
  let _ = task_spawn(fn _ -> ctl_prefetch_loop(io, node))
  let offset = ctl_cfg_int("port_offset", 0)
  let listen_port = if offset == 0 do port else ctl_int(Env.get("MARCH_NODE_PORT", "0")) + offset end
  if List.member(Topology.node_labels(), label) do
    match tcp_listen(listen_port) do
      Ok(lfd) ->
        let _ = task_spawn(fn _ -> ctl_api_accept(node, port, lfd))
        let _ = task_spawn(fn _ -> ctl_audit_copier(node, port))
        println("control: API listening on port " ++ int_to_string(listen_port))
      Err(e) -> println("control: cannot listen on port " ++ int_to_string(listen_port) ++ ": " ++ e)
    end
  else () end
end
