-- An affine tree, used twice.
mod Own do
  type Tree = Leaf(Int) | Node(Tree, Tree)

  fn sum_leaves(t : Tree) : Int do
    match t do
    Leaf(n)    -> n
    Node(l, r) -> sum_leaves(l) + sum_leaves(r)
    end
  end

  fn twice(t : affine Tree) : Int do
    sum_leaves(t) + sum_leaves(t)
  end
end
