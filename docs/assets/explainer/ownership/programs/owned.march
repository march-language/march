-- One tree, transformed by ordinary functional code.
mod Own do
  needs IO.Console

  type Tree = Leaf(Int) | Node(Tree, Tree)

  fn inc_leaves(t : Tree) : Tree do
    match t do
    Leaf(n)    -> Leaf(n + 1)
    Node(l, r) -> Node(inc_leaves(l), inc_leaves(r))
    end
  end

  fn sum_leaves(t : Tree) : Int do
    match t do
    Leaf(n)    -> n
    Node(l, r) -> sum_leaves(l) + sum_leaves(r)
    end
  end

  fn build(depth : Int, seed : Int) : Tree do
    if depth == 0 do Leaf(seed) else Node(build(depth - 1, seed * 2), build(depth - 1, seed * 2 + 1)) end
  end

  fn main(_c : Cap(IO.Console)) : Unit do
    let t = build(4, 1)
    let t2 = inc_leaves(t)
    println(int_to_string(sum_leaves(t2)))
  end
end
