mod Main do
  type Client = Client
  type Server = Server

  protocol Echo do
    Client -> Server : Int
    Server -> Client : Int
  end

  fn main() do
    let (cc, sc) = Chan.new(Echo)
    let cc2 = Chan.send(cc, 42)
    let cc3 = Chan.send(cc2, 43)
    Chan.close(cc3)
    Chan.close(sc)
  end
end
