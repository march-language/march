.superpowers/

# Git worktrees
.worktrees/
*.ll
.march/
.forge/
docs/_site/
# Jekyll's destination is ../_site — i.e. the REPO ROOT, not docs/_site — for both CI
# (deploy-pages.yml) and scripts/serve-docs.sh. Pagefind then writes its index into it.
/_site/
.claude/worktrees/
march-phases/
docs/superpowers/

# march_doc generator, auto-cloned by scripts/gen-stdlib-docs.sh in CI
/march_doc/

# RPC demo cross-compile output (scripts/rpc/build-linux.sh)
/dist/
# Generated Scroll notebook downloads (regenerated in CI from docs pages)
docs/downloads/

# Python bytecode
__pycache__/

# Compiled compiler/tooling binaries (build with `dune build`)
/bin/march
/bin/forge
/bin/march-lsp

# Compiled benchmark binaries (build via bench/run_bench.sh)
/bench/*
!/bench/*.march
!/bench/*.ml
!/bench/*.exs
!/bench/*.rs
!/bench/*.sh
!/bench/*.mjs
!/bench/*.py
!/bench/dune
!/bench/*.md
!/bench/ocaml/
!/bench/elixir/
!/bench/rust/
!/bench/python/
!/bench/c/
!/bench/cpp/
!/bench/tfb/

