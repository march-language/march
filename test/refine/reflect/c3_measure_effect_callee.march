mod C3 do
  fn noisy(n : Int) : Int do
    println("hi")
    n
  end

  @[measure]
  fn sz(xs : List(Int)) : Int do
    match xs do
      Nil -> noisy(0)
      Cons(_, t) -> 1 + sz(t)
    end
  end

  fn need(xs : {List(Int) | sz(_) == 1}) : Int do 0 end

  fn main() : Unit do
    let _ = need(Cons(1, Nil))
    ()
  end
end
