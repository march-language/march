mod Dom1 do
  fn p(n : {Int | _ >= 0}) : Bool do
    if n >= 0 do true else not p(n) end
  end

  @[decreases(n)]
  fn q(n : {Int | _ >= 0}) : Bool do
    if n >= 0 do true else not q(n) end
  end

  fn cnt(n : {Int | _ >= 0}) : Int do
    if n == 0 do 0 else 1 + cnt(n - 1) end
  end

  fn guarded(xs : List(Int)) : Int do
    match xs do
      Cons(h, _) when h > 0 -> h
      Nil -> 0
    end
  end

  fn main() : Unit do
    let _ = p(1)
    let _ = q(1)
    let _ = cnt(3)
    let _ = guarded(Nil)
    ()
  end
end
