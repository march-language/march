mod G3 do
  needs IO.Console

  type P = P(Int, Int)

  impl Eq(P) do
    fn eq(a : P, b : P) : Bool do
      match (a, b) do
        (P(x, _), P(y, _)) -> x == y
      end
    end
  end

  fn need(p : {P | _ == P(1, 2)}) : Int do 0 end

  fn main() : Unit do
    let _ = need(P(1, 3))
    println(if P(1, 3) == P(1, 2) do "eq" else "ne" end)
  end
end
