mod A2 do
  fn cat(xs : List(Int), ys : List(Int)) : List(Int) do
    match xs do
      Nil -> ys
      Cons(h, t) -> Cons(h, cat(t, ys))
    end
  end

  fn law(xs : List(Int), ys : List(Int)) : {Int | _ == len(xs) + len(ys)} do
    List.length(cat(xs, ys))
  end

  fn main() : Unit do
    let _ = law(Cons(1, Nil), Nil)
    ()
  end
end
