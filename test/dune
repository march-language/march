; Task 3: SIMD register-residency / escape fixture. `kernel` is a
; straight-line load/mul/add/sum function -- its compiled body must stay
; entirely in registers, contributing ZERO march_simd_alloc calls. `escape`
; stores the loaded vector into a List cell, forcing exactly ONE heap box.
; Asserted via -emit-llvm, not output diff -- IR shape is the point.
;
; `kernel`/`escape` are pure and small, so the default optimizer (Inline,
; lib/tir/inline.ml) always inlines them into march_main regardless of call
; count -- there is no separate `define ... @kernel`/`@escape` symbol to
; scope a grep against post-opt (and building with --no-opt to keep them as
; symbols would defeat the point: the Simd.* wrapper calls would stay as
; boxed-ptr calls instead of being inlined down to raw <4 x float> register
; ops, making a "kernel makes 0 allocs" check vacuous for the wrong reason).
;
; A source-order split at the first march_simd_alloc call (an earlier
; version of this rule) is UNSOUND: the "before the split" half is built by
; construction from lines that stop at the first march_simd_alloc match, so
; a "0 allocs in that half" assertion can never fail -- it doesn't test
; kernel-vs-escape attribution at all, and its sabotage check only ever
; flipped the always-true threshold, which is guaranteed to fail regardless
; of whether the split logic means anything (caught in review). The
; falsifiable version asserts the fixture's only real invariant: march_main
; contains EXACTLY ONE march_simd_alloc call in total (this fixture has one
; escape call site; a kernel-side regression that boxes would push the
; total to 2, an escape-side regression that stops boxing would drop it to
; 0 -- both directions are caught by a single equality check on the total),
; strengthened with a presence check for the vector arithmetic itself
; (`fmul <4 x float>` and `fadd <4 x float>`/`reduce.fadd` both >= 1) so an
; optimizer that deleted the kernel's body entirely (e.g. DCE'd its unused
; result) couldn't fake a pass by vacuously satisfying an allocation count
; with no vector ops behind it.
(rule
 (targets simd_residency_llvm_check.out)
 (deps (file %{exe:../bin/main.exe})
       (glob_files ../runtime/*.c) (glob_files ../runtime/*.h)
       (file native/simd_residency.march)
       (source_tree ../stdlib))
 (action
  (progn
   (run %{exe:../bin/main.exe} --emit-llvm native/simd_residency.march)
   (with-stdout-to simd_residency_llvm_check.out
    (run bash -c
     "mbody=$(awk '/^define ptr @march_main/{f=1} f{print} f && /^}/{exit}' native/simd_residency.ll); \
      alloc=$(printf '%s\\n' \"$mbody\" | grep -c march_simd_alloc); \
      fmul=$(printf '%s\\n' \"$mbody\" | grep -c 'fmul <4 x float>'); \
      fadd=$(printf '%s\\n' \"$mbody\" | grep -c -E 'fadd <4 x float>|reduce\\.fadd'); \
      echo \"$alloc $fmul $fadd\"")))))

(rule
 (alias runtest)
 (deps simd_residency_llvm_check.out)
 (action
  (run bash -c
   "read -r alloc fmul fadd < simd_residency_llvm_check.out; \
    test \"$alloc\" -eq 1 -a \"$fmul\" -ge 1 -a \"$fadd\" -ge 1 || { echo \"expected exactly 1 march_simd_alloc total in march_main (this fixture's single escape call site -- a kernel-side box regression pushes this to 2, an escape-side regression that stops boxing drops it to 0), with >=1 fmul <4 x float> and >=1 fadd/reduce.fadd present (found alloc=$alloc fmul=$fmul fadd=$fadd)\" >&2; exit 1; }")))

