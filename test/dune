       (source_tree ../stdlib))
 (action
  (progn
   (run %{exe:../bin/main.exe} --compile -o simd_nested_closure_acc
        native/simd_nested_closure_acc.march)
   (with-stdout-to simd_nested_closure_acc.out
        (system "./simd_nested_closure_acc")))))

(rule
 (alias runtest)
 (action
  (diff native/simd_nested_closure_acc.expected simd_nested_closure_acc.out)))

; Residency half (defect B): `simd_acc_go` is the SAME loop as a top-level
; self-TAIL-recursive helper, so llvm_tco turns its self-call into a
; back-edge and the accumulator never crosses a real call. Its parameter
; slot must therefore be a NATIVE `<4 x float>` alloca, not the default
; "boxed at rest" ptr slot -- with a ptr slot the back-edge's coerce boxed
; through march_simd_alloc on EVERY iteration (and leaked the previous box,
; since nothing dec_rc's the slot), which is what made a Simd dot product
; lose to the scalar composition it was meant to beat.
;
; `simd_acc_go` is recursive, so the inliner leaves it as its own `define`
; symbol and the grep can be scoped to it (unlike simd_residency's kernel,
; which is inlined into march_main and has to be checked there).
;
; The contract is a CONJUNCTION, because neither half is falsifiable alone:
;   vstore >= 2 -- native `store <4 x float> ... %acc.addr`, one for the
;     entry unbox and one for the back-edge. This is the load-bearing
;     assertion: pre-fix the slot was `alloca ptr` so this count was 0.
;   alloc == 1 -- exactly one march_simd_alloc in the whole function, the
;     coercion that boxes the accumulator on the RETURN path (the one place
;     it genuinely does cross a call boundary). Pre-fix this was also 1 (the
;     per-iteration back-edge box), which is precisely why the alloc count
;     alone cannot detect the regression and vstore must carry it; alloc==1
;     is what stops a future change from ADDING boxes back on top.
;   fma >= 1 -- the vector arithmetic is still there, so an optimizer that
;     DCE'd the loop body could not vacuously satisfy the counts above.
(rule
 (targets simd_nested_closure_acc_llvm_check.out)
 (deps (file %{exe:../bin/main.exe})
       (glob_files ../runtime/*.c) (glob_files ../runtime/*.h)
       (file native/simd_nested_closure_acc.march)
       (source_tree ../stdlib))
 (action
  (progn
   (run %{exe:../bin/main.exe} --emit-llvm native/simd_nested_closure_acc.march)
   (with-stdout-to simd_nested_closure_acc_llvm_check.out
    (run bash -c
     "body=$(awk '/^define .*@simd_acc_go\\(/{f=1} f{print} f && /^}/{exit}' native/simd_nested_closure_acc.ll); \
      alloc=$(printf '%s\\n' \"$body\" | grep -c march_simd_alloc); \
      vstore=$(printf '%s\\n' \"$body\" | grep -c 'store <4 x float>.*%acc.addr'); \
      fma=$(printf '%s\\n' \"$body\" | grep -c 'fma\\.v4f32'); \
      echo \"$alloc $vstore $fma\"")))))

(rule
 (alias runtest)
 (deps simd_nested_closure_acc_llvm_check.out)
 (action
  (run bash -c
   "read -r alloc vstore fma < simd_nested_closure_acc_llvm_check.out; \
    test \"$vstore\" -ge 2 -a \"$alloc\" -eq 1 -a \"$fma\" -ge 1 || { echo \"expected the self-TCO'd simd_acc_go to keep its vector accumulator in a NATIVE slot: >=2 'store <4 x float> ... %acc.addr' (entry unbox + back-edge; 0 means the slot regressed to 'alloca ptr' and the back-edge boxes every iteration), exactly 1 march_simd_alloc (the return-path coercion only), and >=1 fma.v4f32 (body not DCE'd) -- found alloc=$alloc vstore=$vstore fma=$fma\" >&2; exit 1; }")))

; ── Call-scoped SIMD vector temp boxes: the two halves of the contract ──
;
; llvm_emit's EApp arm releases a vector argument box the CALL SITE created,
; but ONLY for callees whose parameter got a native vector TCO slot
; (ctx.native_vec_params, filled by a pre-pass in emit_module). These two
; fixtures pin the two directions; neither is meaningful without the other.
;
; (1) simd_leak_probe -- the release must HAPPEN. `go` is self-tail-recursive
; with a vector param, so its entry prologue unboxes one caller-made box per
; INVOCATION and (pre-fix) never released it: 2,000,000 calls leaked one
; march_simd_alloc cell each. An output check cannot see a leak, hence the
; unusual assertion.
;
; SIGNAL: live_allocs(), NOT RSS. The original version of this rule asserted
; an absolute max-RSS threshold (< 32 MB), calibrated on Darwin (healthy
; ~2.7 MB, leaked ~67 MB). It went RED the first time CI's ubuntu leg ran it
; (PR #269 removed this probe's prior Darwin-only gate), at max RSS
; 128,761,856 B -- not a leak, just Linux's ~122 MB process baseline that the
; macOS-derived band never accounted for. live_allocs() reads the runtime's
; always-on march_live_alloc_count -- incremented in march_alloc, decremented
; on every free-on-rc-zero path -- so it counts the defect directly: no
; allocator free-list behaviour, no page-granularity rounding, no OS/platform
; baseline. Same conversion, same rationale, as
; native_arr_fold_leak_probe.march.
;
; THREE checks, and all three are load-bearing (unchanged from the RSS-era
; rule's reasoning). A single check that reads a captured number without
; independently verifying the run went well can be fooled by a probe that
; crashes early or corrupts its output -- e.g. macOS /usr/bin/time -l still
; printing a max RSS for a child that died on SIGSEGV (measured: RSS
; 1425408, pipeline rc 0), which is why this was never collapsed into one
; piped command. Hence:
;   (a) the run's EXIT STATUS is dune's (a `system`/`run` action fails on
;       nonzero),
;   (b) stdout is diffed against .expected, so a crash-after-partial-output
;       or a wrong result cannot pass, and
;   (c) only then is the live_allocs delta read, from the captured stderr
;       FILE rather than a pipeline whose status belongs to the last stage.
;
; .expected's stdout is NOT interpreter-produced (2,000,000 iterations do not
; finish under the tree-walker in any reasonable time; same posture as
; simd_bounds_panic, which is compiled-only by design). The stdout value is
; arithmetic: 2,000,000 calls x sum of splat(1.0) over 4 lanes = 8000000.
; live_allocs() itself returns a constant 0 in the INTERPRETER (see
; eval.ml), which is why the delta goes to stderr rather than stdout: it
; never has to agree between backends.
;
; Numbers, measured on this fixture (Darwin arm64, --opt 2, 2,000,000
; calls), both sabotage directions actually run:
;   caller-side release present   live_allocs delta =         1
;   release deleted (sabotage)    live_allocs delta = 2,000,001
; The one leftover object is incidental runtime/stdlib state, not a per-call
; leak; deleting the release adds exactly 2,000,000 -- one leaked
; march_simd_alloc cell per invocation of `go`, the defect stated exactly
; rather than estimated. The dune rule asserts < 1000: ~1000x above the
; healthy figure (ample room for incidental runtime objects) and ~2000x
; below the leaked figure, so it is falsifiable in both directions with an
; enormous margin.
(rule
 (targets simd_leak_probe)
 (deps (file %{exe:../bin/main.exe})
       (glob_files ../runtime/*.c) (glob_files ../runtime/*.h)
       (file native/simd_leak_probe.march)
       (source_tree ../stdlib))
 (action
  (run %{exe:../bin/main.exe} --compile --opt 2 -o simd_leak_probe
       native/simd_leak_probe.march)))

; Check (a): nonzero exit fails this rule (dune's own `system` semantics -- cf.
; simd_bounds_panic, which needs an explicit with-accepted-exit-codes to allow
; its nonzero exit). Stdout (the diffable answer) and stderr (the
; live_allocs delta the probe prints about itself) land in separate files.
(rule
 (targets simd_leak_probe.out simd_leak_probe.live)
 (deps simd_leak_probe)
 (action
  (with-stdout-to simd_leak_probe.out
   (with-stderr-to simd_leak_probe.live
    (run ./simd_leak_probe)))))

; Check (b): the probe must actually finish and print the right answer.
(rule
 (alias runtest)
 (action (diff native/simd_leak_probe.expected simd_leak_probe.out)))

; Check (c): the leak assertion proper, read from the probe's own stderr line.
(rule
 (alias runtest)
 (deps simd_leak_probe.live)
 (action
  (run bash -c
   "live=$(cat simd_leak_probe.live); \
    test -n \"$live\" || { echo 'could not read live_allocs delta from simd_leak_probe.live' >&2; exit 1; }; \
    test \"$live\" -lt 1000 || { echo \"simd_leak_probe leaked: live_allocs delta ${live} >= 1000 objects. 2,000,000 calls to a self-TCO'd fn with a vector param must not accumulate march_simd_alloc cells -- healthy is a small constant (~1 object, independent of call count), the missing release adds exactly 2,000,000. Check that llvm_emit's EApp arm still releases call-scoped vector temp boxes for callees in ctx.native_vec_params, and that Llvm_toplevel.native_vec_param_idxs is still the single source of truth for that decision.\" >&2; exit 1; }; \
    echo \"simd_leak_probe live_allocs delta = ${live} objects\"")))

; ── peak_rss_bytes builtin: unit test ──────────────────────────────────
; Bytes-on-both-platforms sanity check for the builtin the leak guard above
; relies on. Compile and diff against the interpreter's own output: only
; ORDER-STABLE facts and a coarse magnitude band are asserted (never raw byte
; counts, which vary per run/platform), so interpreter/compiled parity holds
; even though the interpreter's figure (Gc.quick_stat-derived, see eval.ml)
