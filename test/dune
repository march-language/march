; ── FFI Gap 1: user shim .so loaded by the interpreter.
; Step 1: compile the shim C file to a shared library.
(rule
 (targets native_ffi_shim.so)
 (deps (file native/ffi_shim.c)
       (file ../runtime/march_ffi.h))
 (action
  ; -undefined dynamic_lookup is Apple ld only; Linux allows undef symbols in .so by default
  (system "case $(uname) in Darwin) F='-undefined dynamic_lookup' ;; *) F= ;; esac; cc -shared -O2 -fPIC $F -I../runtime native/ffi_shim.c -o native_ffi_shim.so")))

; Step 2: run the interpreter with --ffi-so pointing at the compiled shim.
(rule
 (targets native_ffi_interp_shim.out)
