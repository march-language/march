; ── SIMD HTTP parser tests ───────────────────────────────────────────────
; -msse4.2 is only passed on x86-64; the source guards SSE4.2 paths with
; #if defined(__SSE4_2__) so the scalar fallback is used elsewhere.
(rule
 (targets test_http_simd_runner)
 (deps    test_http_simd.c
          ../runtime/march_http_parse_simd.c
          ../runtime/march_http_parse_simd.h)
 (action  (system "case $(uname -m) in x86_64) F=-msse4.2 ;; *) F= ;; esac; %{cc} -std=gnu11 -Wall -Wextra -I../runtime $F -O2 -o %{targets} test_http_simd.c ../runtime/march_http_parse_simd.c")))

(rule
 (alias   runtest)
 (deps    (file test_http_simd_runner))
 (action  (run ./test_http_simd_runner)))

; ── Zero-copy response builder tests ────────────────────────────────────
(rule
