 (action (diff native/ffi_result.expected native_ffi_result.out)))

; ── FFI Phase 4: a primitive extern is callable from the INTERPRETER (no
; ── --compile) via dlopen + trampoline.  main.exe builds/dlopens the runtime .so.
(rule
 (targets native_ffi_interp.out)
 (deps (file %{exe:../bin/main.exe})
       (file ../runtime/march_runtime.c) (file ../runtime/march_runtime.h)
       (file ../runtime/march_ffi.c) (file ../runtime/march_ffi.h)
       (file ../runtime/march_scheduler.c) (file ../runtime/march_scheduler.h)
       (file ../runtime/march_heap.c) (file ../runtime/march_heap.h)
       (file ../runtime/march_gc.c) (file ../runtime/march_gc.h)
       (file ../runtime/march_message.c) (file ../runtime/march_message.h)
       (file ../runtime/march_deque.h)
       (file ../runtime/march_extras.c) (file ../runtime/march_compress.c)
       (file ../runtime/base64.c) (file ../runtime/sha1.c)
       (file native/ffi_interp.march))
 (action
  (with-stdout-to native_ffi_interp.out
    (run %{exe:../bin/main.exe} native/ffi_interp.march))))

(rule
 (alias runtest)
 (action (diff native/ffi_interp.expected native_ffi_interp.out)))

