; ── JS backend end-to-end tests ──────────────────────────────────────────────
; Copy march_runtime.mjs once; each JS test compiles with --no-copy-runtime
; so dune owns the runtime target and the compiler doesn't shadow it.
(rule
 (targets march_runtime.mjs)
 (deps (file ../runtime/march_runtime.mjs))
 (action (copy ../runtime/march_runtime.mjs march_runtime.mjs)))

(rule
 (targets js_atom_ctor_field.mjs)
 (deps (file %{exe:../bin/main.exe}) (glob_files ../stdlib/*.march)
       (file native/atom_ctor_field.march) march_runtime.mjs)
 (action (run %{exe:../bin/main.exe} --target js --no-copy-runtime
              -o js_atom_ctor_field.mjs native/atom_ctor_field.march)))

(rule
 (targets js_atom_ctor_field.out)
 (deps js_atom_ctor_field.mjs march_runtime.mjs)
 (action (with-stdout-to js_atom_ctor_field.out (run node js_atom_ctor_field.mjs))))

(rule (alias runtest) (action (diff native/atom_ctor_field.expected js_atom_ctor_field.out)))

