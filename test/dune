; ── Regression: cross-module ctor pattern whose name collides with a stdlib ──
; ── constructor, on the FIRST variant. ──
; A user type's first ctor `Text` collides with stdlib Xml.XmlNode.Text (tag 1).
; Stripping the qualified pattern `Inline.Text` to bare "Text" (b3e8721) left
; codegen's ctor_entry to resolve it by an ambiguous ".Text" suffix match when
; the value's element type was not propagated across the module boundary — it
; picked the stdlib ctor's tag (1) instead of Inline.Text (0), so the
; first-variant match silently missed.  The fix keeps the pattern's qualifier
; and resolves it to the ctor_info key whose type segment matches.  Build the
; value in a MARCH_LIB_PATH lib module, match it cross-module, run, diff stdout.
(rule
 (targets native_xmod_ctor_collision native_xmod_ctor_collision.out)
 (deps (file %{exe:../bin/main.exe})
       (file ../runtime/march_runtime.c) (file ../runtime/march_runtime.h)
       (file ../runtime/march_scheduler.c) (file ../runtime/march_scheduler.h)
       (file ../runtime/march_heap.c) (file ../runtime/march_heap.h)
       (file ../runtime/march_gc.c) (file ../runtime/march_gc.h)
       (file ../runtime/march_message.c) (file ../runtime/march_message.h)
       (file ../runtime/march_deque.h)
       (file ../runtime/march_extras.c) (file ../runtime/march_ctx_escape.c) (file ../runtime/march_compress.c)
       (file ../runtime/base64.c) (file ../runtime/sha1.c)
       (glob_files_rec native/xmod_ctor_collision/*.march))
 (action
  (setenv MARCH_LIB_PATH native/xmod_ctor_collision/lib
   (progn
    (run %{exe:../bin/main.exe} --compile -o native_xmod_ctor_collision
         native/xmod_ctor_collision/entry.march)
    (with-stdout-to native_xmod_ctor_collision.out
         (system "./native_xmod_ctor_collision"))))))

