; ── Parallel test runners (dune executes these concurrently) ─────────────
; -e: show test-case error details inline (no digging through log files).
; Run binaries directly for agent-safe, RPC-free execution: see scripts/run-tests.sh.
; cap_strip / cap_markers shell out to the real compiler and inspect the
; linked binary, so main.exe AND the staged runtime tree must exist before
; this runner starts.  Without these deps the tests resolved nothing and
; returned 127 in CI while passing locally (where the repo root happened to
; be the CWD).
(test
 (name run_compiler)
 (modules run_compiler)
 (libraries march_test_compiler alcotest)
 (deps %{exe:../bin/main.exe} (source_tree ../runtime) (source_tree ../stdlib))
 (action (run %{test} -e)))

(test
 (name run_eval)
 (modules run_eval)
 (libraries march_test_eval alcotest)
 (action (run %{test} -e)))

(test
 (name run_codegen)
 (modules run_codegen)
 (libraries march_test_codegen alcotest)
 (action (run %{test} -e)))

(test
 (name run_stdlib)
 (modules run_stdlib)
 (libraries march_test_stdlib_suite alcotest)
 ; test_http_native and test_socket_timeout shell out to the real compiler,
 ; which compiles the STAGED runtime/ and stdlib/ trees.  Without these deps
 ; those trees can be stale relative to the working copy, so an edit to
 ; runtime/*.c or stdlib/*.march is simply absent from what the test exercises
 ; — which shows up as a fake failure, or worse, a vacuous pass.
 (deps %{exe:../bin/main.exe} (source_tree ../runtime) (source_tree ../stdlib))
 (action (run %{test} -e)))

; ── TIR golden-snapshot tests (Wave 2 Task 4 / W2.2) ──────────────────────
; A separate runner (not folded into run_compiler/run_codegen): snapshot
; tests have distinct semantics from ordinary alcotest assertions — an
; UPDATE_SNAPSHOTS=1 regeneration run is expected to WRITE files and still
; exit 0, which would be a confusing mode to enable ambient inside one of
; the five existing suites (accidentally regenerating unrelated compiler or
; codegen `.expected` fixtures was never a risk anyone had to consider
; before). Keeping `-e` semantics clean per-runner (per the task brief) and
; giving this corpus its own `test/snapshots/{src,lower,perceus}/` tree a
; single obvious home. See test/test_snapshots.ml's top-of-file comment for
; the regen workflow.
(test
 (name run_snapshots)
 (modules run_snapshots)
 (libraries march_test_snapshots alcotest)
 (action (run %{test} -e)))

; ── C scheduler tests ────────────────────────────────────────────────────
; Compile test_scheduler.c together with the C runtime scheduler and run it
; as part of `dune runtest`.  Uses %{cc} (the OCaml-configured C compiler).
(rule
 (targets test_scheduler_runner)
 (deps    test_scheduler.c
          ../runtime/march_scheduler.c
          ../runtime/march_scheduler.h
          ../runtime/march_deque.h)
 (action  (run %{cc}
               -std=gnu11 -Wall -Wextra -I../runtime
               -DMARCH_NUM_SCHEDULERS=1
               -o %{targets}
               test_scheduler.c ../runtime/march_scheduler.c
               -lpthread)))

; REVIVED 2026-08-08: the harness now requests shutdown before march_sched_run()
; (via run_to_quiescence), matching the current "run until shutdown requested AND
; no live procs remain" termination contract — compiled `main` normally supplies
; that request when its green thread returns; a plain C harness must do it
; explicitly. Previously the RUN was disabled because it idle-nanosleeped forever
; (g_all_done never set), which had itself been masked for weeks by a LINK failure
; the Signal.watch commit (9c97391a) introduced (fixed by the weak no-op
; march_signal_drain in march_scheduler.c).
(rule
 (alias   runtest)
 (deps    (file test_scheduler_runner))
 (action  (run ./test_scheduler_runner)))

