; ── Regression: type errors in imported user modules must fail the build ──
; The diagnostic filter only matched the entry filename, so errors in
; modules resolved from the source dir / MARCH_LIB_PATH were tolerated as
; "stdlib-internal" — ill-typed programs compiled into corrupt binaries
; (null fn-ptr calls, RC corruption).  Both the interpreter path
; (march test) and the typecheck/compile path (--check) must exit 1.
(rule
 (alias runtest)
 (deps (file %{exe:../bin/main.exe})
       (file imports/entry_imports_ill_typed.march)
       (file imports/ill_typed_user_mod.march))
 (action (with-accepted-exit-codes 1
          (run %{exe:../bin/main.exe} test
               imports/entry_imports_ill_typed.march))))

(rule
 (alias runtest)
 (deps (file %{exe:../bin/main.exe})
       (file imports/entry_imports_ill_typed.march)
       (file imports/ill_typed_user_mod.march))
 (action (with-accepted-exit-codes 1
          (run %{exe:../bin/main.exe} --check
               imports/entry_imports_ill_typed.march))))

; The `check` SUBCOMMAND (run_check_cmd, what `forge` invokes) is a THIRD code
; path distinct from `--check` above: it filtered diagnostics against the
; command-line file list only, so errors in auto-discovered imported modules
; were dropped as stdlib-internal (fixed by merging each entry's user_files
; into the membership filter).  Must exit 1 like the other two paths.
(rule
 (alias runtest)
 (deps (file %{exe:../bin/main.exe})
       (file imports/entry_imports_ill_typed.march)
       (file imports/ill_typed_user_mod.march))
 (action (with-accepted-exit-codes 1
          (run %{exe:../bin/main.exe} check
               imports/entry_imports_ill_typed.march))))

; ── Regression: ill-typed modules from a RELATIVE MARCH_LIB_PATH ──
; user_files held only realpath-canonicalised paths while diagnostic spans
; carry the as-given (relative) path the file was parsed under, so the
; is_user_file filter misclassified lib-module errors as stdlib-internal
; and silently tolerated them — ill-typed TIR reached codegen (the depot
; repro: 70 swallowed type errors, undefined pattern-binder symbols at
; link time).  user_files now records BOTH spellings; --check and the
; interpreter path must exit 1.
(rule
 (alias runtest)
 (deps (file %{exe:../bin/main.exe})
       (glob_files_rec imports/lib_path_ill_typed/*.march))
 (action (setenv MARCH_LIB_PATH imports/lib_path_ill_typed/lp_lib
          (with-accepted-exit-codes 1
           (run %{exe:../bin/main.exe} --check
                imports/lib_path_ill_typed/lp_entry.march)))))

(rule
 (alias runtest)
 (deps (file %{exe:../bin/main.exe})
       (glob_files_rec imports/lib_path_ill_typed/*.march))
 (action (setenv MARCH_LIB_PATH imports/lib_path_ill_typed/lp_lib
          (with-accepted-exit-codes 1
           (run %{exe:../bin/main.exe} test
                imports/lib_path_ill_typed/lp_entry.march)))))

; ── Regression: an UNREFERENCED ill-typed lib module must NOT fail the build ──
; MARCH_LIB_PATH auto-discovery used to parse+typecheck EVERY .march file on
; the path regardless of reachability, so a single broken UNRELATED module
; failed an entry that never references it.  The resolver now prunes any
; auto-discovered module the entry cannot reach (transitively, by name) unless
; it carries a global-effect decl (impl/interface/protocol/extern/...).  The
; pruned module is dropped from the program entirely — so its ill-typed TIR
; never reaches codegen (the original harm) — and the entry builds clean.
; [libpath_entry.march] deliberately does not reference LibpathIllTyped, so
; --check must now exit 0.  (The referenced-module control lives in the
; imports/lib_path_ill_typed rule above, which still exits 1.)
(rule
 (alias runtest)
 (deps (file %{exe:../bin/main.exe})
       (file libpath_entry.march)
       (glob_files libpath_ill_typed/*.march))
 (action (setenv MARCH_LIB_PATH libpath_ill_typed
          (with-accepted-exit-codes 0
           (run %{exe:../bin/main.exe} --check libpath_entry.march)))))

; ── Control: an entry that DOES reference the ill-typed lib module still errors ──
; Same broken lib dir as above, but this entry references LibpathIllTyped by
; name, so reachability keeps it in the build and its type error must surface
; (exit 1).  Guards against the pruning fix over-reaching and swallowing a
; genuinely-reachable module's diagnostics.
(rule
 (alias runtest)
 (deps (file %{exe:../bin/main.exe})
       (file libpath_entry_ref.march)
       (glob_files libpath_ill_typed/*.march))
 (action (setenv MARCH_LIB_PATH libpath_ill_typed
          (with-accepted-exit-codes 1
           (run %{exe:../bin/main.exe} --check libpath_entry_ref.march)))))

; ── Regression: early-CAS hash must cover source-dir sibling modules ──
; The --check/--compile early-exit cache hashed the entry source, the stdlib
; hash, and MARCH_LIB_PATH files — but NOT the entry's own source-dir
; siblings, which resolve_imports auto-discovers as user code.  Editing an
; imported sibling to introduce a type error therefore hit the stale OK
; artifact and exited 0 without typechecking.  This rule checks a two-file
; sandbox (caching an OK result), injects an arity error into the sibling,
; and requires the SECOND --check to exit 1 (a warm-cache exit 0 fails it).
; Files are generated inline so the duplicate `mod CsHelper` bodies never
; pollute imports/ auto-discovery for other rules.
(rule
 (alias runtest)
 (deps (file %{exe:../bin/main.exe}))
 (action (system "\
rm -rf cas_stale_dir && mkdir cas_stale_dir && \
printf 'mod CsEntry do\\n\\n  use CsHelper\\n\\n  fn main() : Int do\\n    CsHelper.double(21)\\n  end\\n\\nend\\n' > cas_stale_dir/cs_entry.march && \
printf 'mod CsHelper do\\n\\n  fn double(x : Int) : Int do\\n    x * 2\\n  end\\n\\nend\\n' > cas_stale_dir/cs_helper.march && \
%{exe:../bin/main.exe} --check cas_stale_dir/cs_entry.march && \
printf 'mod CsHelper do\\n\\n  fn double(x : Int) : Int do\\n    x * 2\\n  end\\n\\n  fn broken() : Int do\\n    double(1, 2, 3)\\n  end\\n\\nend\\n' > cas_stale_dir/cs_helper.march && \
! %{exe:../bin/main.exe} --check cas_stale_dir/cs_entry.march 2>/dev/null")))

; ── Regression: CAS key must digest the runtime dir that is actually compiled ──
; cas.ml resolved its own runtime-directory candidates cwd-FIRST while
; bin/main.ml resolves the sources it compiles exe-relative-FIRST, so with cwd
; at the repo root the key digested ./runtime/*.c and clang compiled
; _build/default/runtime/*.c.  A targeted `dune build bin/main.exe` does not
; refresh _build/default/runtime, so the two diverge and editing a runtime
; source printed `compiled <out> (cached)` for a binary with none of the new
; code (compiler_identity does not cover it — the exe's bytes are unchanged).
; The script compiles one March program against two divergent runtime trees
; through the same warm CAS store and requires each binary to come from the
; runtime it was compiled against.  Native compiles, hence `Slow`-equivalent:
; own alias, run with `dune build @test/cas-runtime-dir`.
(rule
 (alias cas-runtime-dir)
 (deps (file %{exe:../bin/main.exe})
       (file cas_runtime_dir_check.sh)
       (source_tree ../runtime)
       (source_tree ../stdlib))
 (action (setenv MARCH_BIN %{exe:../bin/main.exe}
          (run bash %{dep:cas_runtime_dir_check.sh}))))

; ── Staging-only alias: refresh _build/default/{runtime,stdlib} ───────────
; Every test that shells out to the built compiler for a NATIVE compile links
; _build/default/runtime/*.c and reads _build/default/stdlib — those are dune
; COPIES of the source trees, and a targeted `dune build test/run_x.exe` does
; not refresh them, so a runtime or stdlib edit is simply absent from what the
; test compiles.  Measured, that produced two failures that look like real
; March bugs and are not: an undefined-symbol link error for a test helper
; added to runtime/march_ffi.c, and a --cap-sandbox binary with no embedded
; SBPL profile (the -D define is only referenced by march_runtime.c, so a
; stale copy without that block silently drops the string).  This rule has no
; action; its only purpose is to make dune stage the trees, so it costs a
; directory copy and nothing else.  scripts/run-tests.sh builds it before
; running any suite.
(rule
 (alias stage-source-trees)
 (deps (source_tree ../runtime) (source_tree ../stdlib))
 (action (progn)))

; ── Regression: whole-program assembly must not leak named-type placeholders ──
; `forge build` typechecks each lib file individually (`march --check <file>`)
; with the sibling modules discovered via MARCH_LIB_PATH, so any lib file can be
; the compile *entry* (its declarations live at the top level; the siblings are
; wrapped modules).  Two whole-program leaks made well-typed projects fail to
; build while `forge test` (one combined entry) passed:
;   * a record type owned by the entry module and referenced by a sibling under
;     its qualified name (`Cfg.Site`) resolved to a nominal TCon that would not
;     unify with the entry's own structural use of it; and
;   * a variant type referenced UNQUALIFIED across modules (`Node`) leaked an
;     unresolved placeholder when the using module happened to be checked before
;     the defining one ("I cannot find `Node`").
; Checking either entry pulls in every sibling, so both invocations must now
; typecheck cleanly (exit 0) regardless of which file is the entry.
(rule
 (alias runtest)
 (deps (file %{exe:../bin/main.exe})
       (glob_files whole_program/*.march))
 (action (setenv MARCH_LIB_PATH whole_program
          (run %{exe:../bin/main.exe} --check whole_program/cfg.march))))

(rule
 (alias runtest)
 (deps (file %{exe:../bin/main.exe})
       (glob_files whole_program/*.march))
 (action (setenv MARCH_LIB_PATH whole_program
          (run %{exe:../bin/main.exe} --check whole_program/prog.march))))

; ── Regression: TYPE-qualified ctors of the ENTRY module used by siblings ──
; Pass 1 of check_module registered the entry module's variant constructors
; under their BARE names only; the "TypeName.CtorName" key was added in
; check_decl (pass 2).  A sibling loaded via the transitive-import path
; (dotted module name → loads first → imports a plain sibling) is checked
; before the entry's own DType decl is reached, so its `TqShape.TqDot`
; reference failed with "I don't know a constructor called `TqShape.TqDot`".
(rule
 (alias runtest)
 (deps (file %{exe:../bin/main.exe})
       (glob_files imports/tq_ctor/*.march))
 (action (setenv MARCH_LIB_PATH imports/tq_ctor
          (run %{exe:../bin/main.exe} --check imports/tq_ctor/tq_ctor_entry.march))))

; ── Regression: TYPE-qualified reference to a sibling's OPAQUE VARIANT type ──
; A sibling module (`OqToken`) auto-discovered via MARCH_LIB_PATH declares an
; `opaque type Token = Token(String)`.  The entry references it under its
; qualified name (`OqToken.Token`) in a parameter annotation.  surface_ty
; resolved the qualified path to a distinct nominal `TCon("OqToken.Token")`
; that would not unify with the BARE `TCon("Token")` produced by OqToken's own
; `make`/`value`, so values crossing the boundary failed with
; "expected `OqToken.Token` but got `Token`" (and the reverse).  The bare name
; is the canonical global identity (constructor `ci_type` is bare), so the
; qualified reference must canonicalize to it.  `--check` must exit 0.
(rule
 (alias runtest)
 (deps (file %{exe:../bin/main.exe})
       (glob_files imports/opaque_qual/*.march))
 (action (setenv MARCH_LIB_PATH imports/opaque_qual
          (run %{exe:../bin/main.exe} --check imports/opaque_qual/oq_entry.march))))

; ── Regression: local fn definitions must shadow bulk imports ──
; `import X` (UseAll) rebound every public `X.name` as bare `name`,
; clobbering the importing module's OWN pass-1 placeholder when it defines a
; function of the same name.  check_fn then unified the local definition
; against the imported fn's type (nonsense arity errors on the local fn's
; header, e.g. a 3-arg `render` "expected" to be the entry's 2-arg one).
; The entry must be passed as an ABSOLUTE path: that makes the sibling's
; `import IsEntry` resolve to the entry's pass-1b placeholder bindings (the
; failing configuration) instead of double-loading the entry as a DMod copy.
; forge always invokes `march --check` with absolute paths, so this mirrors
; real `forge check` behavior.
(rule
 (alias runtest)
 (deps (file %{exe:../bin/main.exe})
       (glob_files imports/import_shadow/*.march))
 (action (system
   "MARCH_LIB_PATH=\"$PWD/imports/import_shadow\" %{exe:../bin/main.exe} --check \"$PWD/imports/import_shadow/is_entry.march\"")))

; ── Regression: tail-call enforcement must respect local scoping ──
; The call-graph builder matched bare call names against the set of TOP-LEVEL
; function names with no regard for scope, so a call to a LOCAL helper whose
; name collided with a top-level function forged a call-graph edge and invented
; an SCC.  Prelude's `length`/`reverse`/`map`/... are all written with a local
; `fn go` helper and the entry module's decls have the prelude spliced in, so
; any program with its own top-level `go` calling one of them was rejected with
; "recursive call to `length` is not in tail position" — for a `go` that is not
; recursive, against a `length` that may not even have a body (extern case).
; Both fixtures must `--check` clean.  These need the real stdlib (the bug only
; appears once the prelude is injected), hence (source_tree ../stdlib).
(rule
 (alias runtest)
 (deps (file %{exe:../bin/main.exe})
       (file imports/extern_shadow/es_extern_length.march)
       (source_tree ../stdlib))
 (action (run %{exe:../bin/main.exe} --check
              imports/extern_shadow/es_extern_length.march)))

(rule
 (alias runtest)
 (deps (file %{exe:../bin/main.exe})
       (file imports/extern_shadow/es_prelude_helper.march)
       (source_tree ../stdlib))
 (action (run %{exe:../bin/main.exe} --check
              imports/extern_shadow/es_prelude_helper.march)))

; ── Regression: native codegen must not drop non-pointer tuple fields ──
; A module-nested fn with default-arg params desugars to a body that builds a
; tuple of its args and immediately destructures it.  The native tuple
; destructure typed every field as a tagged pointer ($TupleN → TVar "_" → ptr)
; and untagged on load (ashr 1), but the tuple was BUILT storing Bool/Int
; fields RAW (i64).  The mismatch corrupted non-pointer fields — an explicitly
; passed `loud : Bool \\ false = true` arrived as false, so the native binary
; printed "Def!" instead of "Def *!".  Compile the repro natively, run it, and
; diff stdout against the expected output (which equals the interpreter's).
(rule
 (targets native_default_args_nested native_default_args_nested.out)
 (deps (file %{exe:../bin/main.exe})
       (file ../runtime/march_runtime.c) (file ../runtime/march_runtime.h)
       (file ../runtime/march_scheduler.c) (file ../runtime/march_scheduler.h)
       (file ../runtime/march_heap.c) (file ../runtime/march_heap.h)
       (file ../runtime/march_gc.c) (file ../runtime/march_gc.h)
       (file ../runtime/march_message.c) (file ../runtime/march_message.h)
       (file ../runtime/march_deque.h)
       (file ../runtime/march_extras.c) (file ../runtime/march_ctx_escape.c) (file ../runtime/march_compress.c)
       (file ../runtime/base64.c) (file ../runtime/sha1.c)
       (file native/default_args_nested.march))
 (action
  (progn
   (run %{exe:../bin/main.exe} --compile -o native_default_args_nested
        native/default_args_nested.march)
   (with-stdout-to native_default_args_nested.out
        (system "./native_default_args_nested")))))

(rule
 (alias runtest)
 (action (diff native/default_args_nested.expected native_default_args_nested.out)))

; ── Capability mocking, end to end, compiled ──────────────────────────────
; The one test that exercises what compiler-inserted capability passing exists
; for: an operation performed by code that names no capability is intercepted
; by a dictionary installed for a lexical region, and only there.
;
; Compiled with --test, which is what enables the elaboration. The fixture
; deliberately does NOT live in test/native/: that directory is swept by the
; LLVM IR validity gate (test_ir_verify.ml), which compiles every .march in it
; WITHOUT --test -- and without --test `cap_ops_empty` has no implementation to
; link against, so the sweep would fail on it.
;
; Three calls to the same function, the middle one inside `with_cap`. One
; dictionary alone would not distinguish interception from a hard-coded
; implementation; the calls either side pin that the swap is lexically scoped
; rather than global.
(rule
 (targets cap_mock_io_bin cap_mock_io.out)
 (deps (file %{exe:../bin/main.exe})
       (file ../runtime/march_runtime.c) (file ../runtime/march_runtime.h)
       (file ../runtime/march_scheduler.c) (file ../runtime/march_scheduler.h)
       (file ../runtime/march_heap.c) (file ../runtime/march_heap.h)
       (file ../runtime/march_gc.c) (file ../runtime/march_gc.h)
       (file ../runtime/march_message.c) (file ../runtime/march_message.h)
       (file ../runtime/march_deque.h)
       (file ../runtime/march_extras.c) (file ../runtime/march_ctx_escape.c) (file ../runtime/march_compress.c)
       (file ../runtime/base64.c) (file ../runtime/sha1.c)
       (source_tree ../stdlib)
       (file cap_mock/cap_mock_io.march))
 (action
  (progn
   (run %{exe:../bin/main.exe} --compile --test -o cap_mock_io_bin
        cap_mock/cap_mock_io.march)
   (with-stdout-to cap_mock_io.out (system "./cap_mock_io_bin")))))

(rule
 (alias runtest)
 (action (diff cap_mock/cap_mock_io.expected cap_mock_io.out)))

; ── Session transport swapped for deterministic in-process replay ─────────
; The payoff case of the capability-dictionary design: the `Stream` protocol's
; two endpoints (send by role, suspend with a handler, close -- what a
; projector would emit) run against an in-process transport attached to
; `Cap(Session.Live)`, and the interleaving is fixed by a FIFO run queue, so
; the trace is reproducible run to run. Compiled WITHOUT --test: this is a
; dictionary on a declared capability, gated by the declaring module, not IO
; mocking. Diffed against .expected on the compiled path; the interpreted
; trace is identical (checked by hand when the fixture was written, and the
; two disagreed once -- see the Vault note in the fixture).
(rule
 (targets stream_replay_bin stream_replay.out)
 (deps (file %{exe:../bin/main.exe})
       (file ../runtime/march_runtime.c) (file ../runtime/march_runtime.h)
       (file ../runtime/march_scheduler.c) (file ../runtime/march_scheduler.h)
       (file ../runtime/march_heap.c) (file ../runtime/march_heap.h)
       (file ../runtime/march_gc.c) (file ../runtime/march_gc.h)
       (file ../runtime/march_message.c) (file ../runtime/march_message.h)
       (file ../runtime/march_deque.h)
       (file ../runtime/march_extras.c) (file ../runtime/march_ctx_escape.c) (file ../runtime/march_compress.c)
       (file ../runtime/base64.c) (file ../runtime/sha1.c)
       (source_tree ../stdlib)
       (file session/stream_replay.march))
 (action
  (progn
   (run %{exe:../bin/main.exe} --compile -o stream_replay_bin
        session/stream_replay.march)
   (with-stdout-to stream_replay.out (system "./stream_replay_bin")))))

(rule
 (alias runtest)
 (action (diff session/stream_replay.expected stream_replay.out)))

; ── Capability mocking reaching an actor handler ──────────────────────────
; The handler is entered from the scheduler, so the capability cannot be
; threaded in as a parameter -- the dispatch function's arity is frozen because
; the actor record holds it as $d_dispatch. It is captured at the SPAWN site
; onto the actor's runtime metadata (march_actor_meta) and read back by the
; dispatch.
;
; Two actors, and which one is mocked is the point: `outside` is spawned before
; the mock exists but SENT TO after the with_cap block closes, so a global or
; dynamically-scoped slot would give the wrong answer for the wrong reason.
; Capturing per-actor at spawn makes it depend on where each actor was created,
; not on when it runs.
(rule
 (targets cap_mock_actor_bin cap_mock_actor.out)
 (deps (file %{exe:../bin/main.exe})
       (file ../runtime/march_runtime.c) (file ../runtime/march_runtime.h)
       (file ../runtime/march_scheduler.c) (file ../runtime/march_scheduler.h)
       (file ../runtime/march_heap.c) (file ../runtime/march_heap.h)
       (file ../runtime/march_gc.c) (file ../runtime/march_gc.h)
       (file ../runtime/march_message.c) (file ../runtime/march_message.h)
       (file ../runtime/march_deque.h)
       (file ../runtime/march_extras.c) (file ../runtime/march_ctx_escape.c) (file ../runtime/march_compress.c)
       (file ../runtime/base64.c) (file ../runtime/sha1.c)
       (source_tree ../stdlib)
       (file cap_mock/cap_mock_actor.march))
 (action
  (progn
   (run %{exe:../bin/main.exe} --compile --test -o cap_mock_actor_bin
        cap_mock/cap_mock_actor.march)
   (with-stdout-to cap_mock_actor.out (system "./cap_mock_actor_bin")))))

(rule
 (alias runtest)
 (action (diff cap_mock/cap_mock_actor.expected cap_mock_actor.out)))

