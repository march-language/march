; ── Regression: a module's own top-level fn shadows another module's import ──
; _use_aliases is program-global; one module's `import X` registers X's public
; names as bare aliases, which leaked into OTHER modules during lowering.
; resolve_use_alias only guarded against locals (params/lets), not same-module
; top-level fns, so e.g. Widget.use_it's bare `render(x)` was rewritten to
; Other.render (registered by the entry's `import Other`) — wrong arity, called
; with one arg, silently miscompiled. resolve_use_alias now also skips names in
; _current_module_fns (the fns the module being lowered defines).  Compile +
; run; the binary panics (exit 1) if the bare call resolved to the wrong fn.
(rule
 (alias runtest)
 (deps (file %{exe:../bin/main.exe})
       (file ../runtime/march_runtime.c) (file ../runtime/march_runtime.h)
       (file ../runtime/march_scheduler.c) (file ../runtime/march_scheduler.h)
       (file ../runtime/march_heap.c) (file ../runtime/march_heap.h)
       (file ../runtime/march_gc.c) (file ../runtime/march_gc.h)
       (file ../runtime/march_message.c) (file ../runtime/march_message.h)
       (file ../runtime/march_deque.h)
       (file ../runtime/march_extras.c) (file ../runtime/march_compress.c)
       (file ../runtime/base64.c) (file ../runtime/sha1.c)
       (glob_files imports/same_mod_shadow_native/*.march))
 (action (system
   "MARCH_LIB_PATH=\"$PWD/imports/same_mod_shadow_native\" %{exe:../bin/main.exe} --compile -o same_mod_shadow_native_bin \"$PWD/imports/same_mod_shadow_native/sms_entry.march\" && ./same_mod_shadow_native_bin")))

