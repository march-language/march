; ── Regression: self-referencing block-let shadowing (`let x = x + 5`).
; Lowering emitted both bindings under the source name `x`, so name-based TIR
; passes (copy-prop/fold) captured across the shadow and folded the inner
; USE site to the OUTER value (e.g. single(10) -> 10 instead of 15), silently
; miscompiling on native (and JS) while the interpreter stayed correct. Fixed
; by Lower_decls.uniquify_fn (alpha-rename shadowed local binders). Covers
; single, chained, and match-arm-body shadows; compiled stdout must equal the
; interpreter's (native/shadow_selfref_let.expected).
(rule
 (targets native_shadow_selfref_let native_shadow_selfref_let.out)
 (deps (file %{exe:../bin/main.exe})
       (file ../runtime/march_runtime.c) (file ../runtime/march_runtime.h)
       (file ../runtime/march_scheduler.c) (file ../runtime/march_scheduler.h)
       (file ../runtime/march_heap.c) (file ../runtime/march_heap.h)
       (file ../runtime/march_gc.c) (file ../runtime/march_gc.h)
