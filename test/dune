 (deps (file %{exe:../bin/main.exe})
       (glob_files ../runtime/*.c) (glob_files ../runtime/*.h)
       (file native/native_arr_fold.march)
       (source_tree ../stdlib))
 (action
  (progn
   (run %{exe:../bin/main.exe} --compile -o native_arr_fold
        native/native_arr_fold.march)
   (with-stdout-to native_arr_fold.out
        (system "./native_arr_fold")))))

(rule
 (alias runtest)
 (action (diff native/native_arr_fold.expected native_arr_fold.out)))

; ── fold per-element float box: live-object guard ──────────────────────
; The rule above diffs OUTPUT ONLY, and a leak is invisible to an output
; diff: native_float_arr_fold / native_f32_arr_fold return the right number
; whether or not they release the per-element march_alloc_float box they
; make for each closure call. So the two `march_decrc(elem)` lines in
; runtime/march_runtime.c were unpinned -- deleting either left every gate
; green. This is the guard.
;
; The signal is live_allocs() -- the runtime's always-on net count of live
; march objects -- NOT peak RSS. This rule originally asserted an absolute
; RSS band calibrated on Darwin (healthy 48 MB / leaked 170 MB / threshold
; 96 MB); the first ubuntu CI run reported 128,143,360 B and went RED on a
; healthy tree, because Linux's process baseline is ~122 MB on its own. An
; absolute-RSS threshold is not portable across platforms. A live-object
; count is: a leak IS "allocated and never freed", so the counter measures
; the defect exactly, with no allocator, page-rounding, or OS baseline in
; the path, and the threshold becomes a small exact number.
;
; Falsifiability was ESTABLISHED BY SABOTAGE, both directions, both lines
; (Darwin arm64, --opt 2, 4,000,000 elements per leg):
;   both decrc present        live_allocs delta         3   -> GREEN
;   f64 decrc(elem) deleted   live_allocs delta 4,000,003   -> RED
;   f32 decrc(elem) deleted   live_allocs delta 4,000,003   -> RED
; Each sabotage adds exactly one leaked object per element. Threshold 1000
; sits ~333x above the healthy figure and 4000x below either leaked one.
; The healthy delta is a constant, not a per-element quantity: if it starts
; tracking the element count, that is a new leak, not drift in this bound.
;
; The probe's accumulator is an INT, deliberately, so this rule measures the
; per-ELEMENT box in isolation. The accumulator-chain leak is a DIFFERENT
; defect in the same helpers -- fixed 2026-08-20 and guarded separately by
; native_arr_fold_acc_leak_probe below
; (specs/progress/2026-08-20-fold-accumulator-chain-leak-fix.md). Keeping the
; accumulator Int here keeps the two signals separable: a regression in either
; one must name the right defect. See the header comment in the fixture.
;
; Three rules, all load-bearing, for the reasons spelled out at length on
; simd_leak_probe below: (a) the run's exit status is dune's, (b) stdout is
; diffed so a crash-after-partial-output cannot pass, (c) only then is the
; delta read from a captured FILE rather than from a pipeline whose status
; belongs to its last stage.
(rule
 (targets native_arr_fold_leak_probe)
 (deps (file %{exe:../bin/main.exe})
       (glob_files ../runtime/*.c) (glob_files ../runtime/*.h)
       (file native/native_arr_fold_leak_probe.march)
       (source_tree ../stdlib))
 (action
  (run %{exe:../bin/main.exe} --compile --opt 2 -o native_arr_fold_leak_probe
       native/native_arr_fold_leak_probe.march)))

(rule
 (targets native_arr_fold_leak_probe.out native_arr_fold_leak_probe.live)
 (deps native_arr_fold_leak_probe)
 (action
  (with-stdout-to native_arr_fold_leak_probe.out
   (with-stderr-to native_arr_fold_leak_probe.live
    (run ./native_arr_fold_leak_probe)))))

(rule
 (alias runtest)
 (action
  (diff native/native_arr_fold_leak_probe.expected
        native_arr_fold_leak_probe.out)))

(rule
 (alias runtest)
 (deps native_arr_fold_leak_probe.live)
 (action
  (run bash -c
   "live=$(cat native_arr_fold_leak_probe.live); \
    test -n \"$live\" || { echo 'could not read live_allocs delta from native_arr_fold_leak_probe.live' >&2; exit 1; }; \
    test \"$live\" -lt 1000 || { echo \"native_arr_fold_leak_probe leaked: live_allocs delta ${live} >= 1000 objects. Folding 4,000,000 elements must not accumulate per-element march_alloc_float boxes -- healthy is a small constant (~3 objects, independent of element count), each missing march_decrc(elem) adds exactly 4,000,000. Check that native_float_arr_fold and native_f32_arr_fold in runtime/march_runtime.c still call march_decrc(elem) after call_closure_2.\" >&2; exit 1; }; \
    echo \"native_arr_fold_leak_probe live_allocs delta = ${live} objects\"")))

; Sibling of native_arr_fold_leak_probe above: that one guards the per-ELEMENT
; box (and deliberately uses an INT accumulator so it measures the element box
; in isolation); this one guards the per-ACCUMULATOR box and deliberately uses
; a FLOAT accumulator, which is the shape that leaks. Both are needed and
; neither subsumes the other -- see the fixture header for the full rationale,
; including why the release in runtime/march_runtime.c is MARCH_FLOAT_TAG-
; guarded rather than unconditional (an apply fn returns a BORROWED alias for
; a ptr param returned unchanged, so an unconditional release is a UAF).
;
; SIGNAL: live_allocs(), NOT RSS -- same reasoning as the sibling rule and
; simd_leak_probe: an absolute RSS threshold is not portable (Linux's ~122 MB
; process baseline sent the RSS-era rules RED on CI), a live-object count
; needs no calibration.
;
; Same three load-bearing rules as the sibling: (a) the run's exit status is
; dune's, (b) stdout is diffed so a crash-after-partial-output cannot pass --
; which matters especially here, because the fixture's identity leg exists to
; CRASH if the release is over-eager, (c) only then is the delta read from a
; captured FILE rather than from a pipeline whose status belongs to its last
; stage.
(rule
 (targets native_arr_fold_acc_leak_probe)
 (deps (file %{exe:../bin/main.exe})
       (glob_files ../runtime/*.c) (glob_files ../runtime/*.h)
       (file native/native_arr_fold_acc_leak_probe.march)
       (source_tree ../stdlib))
 (action
  (run %{exe:../bin/main.exe} --compile --opt 2 -o native_arr_fold_acc_leak_probe
       native/native_arr_fold_acc_leak_probe.march)))

(rule
 (targets native_arr_fold_acc_leak_probe.out native_arr_fold_acc_leak_probe.live)
 (deps native_arr_fold_acc_leak_probe)
 (action
  (with-stdout-to native_arr_fold_acc_leak_probe.out
   (with-stderr-to native_arr_fold_acc_leak_probe.live
    (run ./native_arr_fold_acc_leak_probe)))))

(rule
 (alias runtest)
 (action
  (diff native/native_arr_fold_acc_leak_probe.expected
        native_arr_fold_acc_leak_probe.out)))

(rule
 (alias runtest)
 (deps native_arr_fold_acc_leak_probe.live)
 (action
  (run bash -c
   "live=$(cat native_arr_fold_acc_leak_probe.live); \
    test -n \"$live\" || { echo 'could not read live_allocs delta from native_arr_fold_acc_leak_probe.live' >&2; exit 1; }; \
    test \"$live\" -lt 1000 || { echo \"native_arr_fold_acc_leak_probe leaked: live_allocs delta ${live} >= 1000 objects. Folding with a HEAP accumulator must not accumulate one dropped object per element -- healthy is a small constant (20 objects, and the Float half of it is identical at 500k/2M/8M elements). Two independent witnesses are being asserted here and the delta says which one broke: ~4,000,000 is the FLOAT half (native_float_arr_fold / native_f32_arr_fold no longer call fold_release_prev_acc after call_closure_2), ~1,000,000 is the STRING half (the MARCH_CLO_ARG0_BORROWED bit is no longer reaching the closure header -- check Perceus still populates Clo_flags and that llvm_emit still stamps the pad word at every closure-alloc site). Note stdout is identical either way, so the .expected diff will NOT have failed.\" >&2; exit 1; }; \
    echo \"native_arr_fold_acc_leak_probe live_allocs delta = ${live} objects\"")))

