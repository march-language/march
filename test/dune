       (file ../runtime/march_scheduler.c) (file ../runtime/march_scheduler.h)
       (file ../runtime/march_heap.c) (file ../runtime/march_heap.h)
       (file ../runtime/march_gc.c) (file ../runtime/march_gc.h)
       (file ../runtime/march_message.c) (file ../runtime/march_message.h)
       (file ../runtime/march_deque.h)
       (file ../runtime/march_extras.c) (file ../runtime/march_compress.c)
       (file ../runtime/base64.c) (file ../runtime/sha1.c)
       (file native/closure_bool_field.march))
 (action
  (progn
   (run %{exe:../bin/main.exe} --compile -o native_closure_bool_field
        native/closure_bool_field.march)
   (with-stdout-to native_closure_bool_field.out
        (system "./native_closure_bool_field")))))

(rule
 (alias runtest)
 (action (diff native/closure_bool_field.expected native_closure_bool_field.out)))

; ── Regression: `let (a, b) = rhs` must untag scalar tuple fields ───────────
; The match-pattern path bound fields at their concrete element type and untagged
; them; the let-destructure path bound them at TVar, so a tagged scalar field was
; carried verbatim (Int 5 -> 11) and never untagged.  Broke Random.range/Gen.element.
(rule
 (targets native_let_tuple_destructure native_let_tuple_destructure.out)
 (deps (file %{exe:../bin/main.exe})
       (file ../runtime/march_runtime.c) (file ../runtime/march_runtime.h)
       (file ../runtime/march_scheduler.c) (file ../runtime/march_scheduler.h)
       (file ../runtime/march_heap.c) (file ../runtime/march_heap.h)
       (file ../runtime/march_gc.c) (file ../runtime/march_gc.h)
       (file ../runtime/march_message.c) (file ../runtime/march_message.h)
       (file ../runtime/march_deque.h)
       (file ../runtime/march_extras.c) (file ../runtime/march_compress.c)
       (file ../runtime/base64.c) (file ../runtime/sha1.c)
       (file native/let_tuple_destructure.march))
 (action
  (progn
   (run %{exe:../bin/main.exe} --compile -o native_let_tuple_destructure
        native/let_tuple_destructure.march)
   (with-stdout-to native_let_tuple_destructure.out
        (system "./native_let_tuple_destructure")))))

(rule
