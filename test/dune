; (2) simd_vector_escape_arg -- the release must NOT happen. `wrap` is
; structurally (not tail) recursive, so it gets NO native slot, its `v`
; parameter stays `ptr`, and its body stores that incoming pointer straight
; into the cons cell it returns: the caller's box escapes into a list that
; then owns it. Releasing it after the call frees a live list element.
; Verified non-vacuous: with the index guard removed (release every box the
; call site created -- the design this replaced) this fixture exits 139/133 on
; every run, while simd_vector_core, simd_nested_closure_acc AND simd_poly_eq
; all still passed, which is exactly why it had to be added. k = 0 is
; deliberate: the base-case branch stores the box with no incrc, so the list
; holds its ONLY reference and the bad dec frees it outright (a k = 3 version
; leaves rc > 0 after the bad dec and silently passes).
; .expected is interpreter-produced; compiled must match byte-for-byte.
(rule
 (targets simd_vector_escape_arg simd_vector_escape_arg.out)
 (deps (file %{exe:../bin/main.exe})
       (glob_files ../runtime/*.c) (glob_files ../runtime/*.h)
       (file native/simd_vector_escape_arg.march)
       (source_tree ../stdlib))
 (action
  (progn
   (run %{exe:../bin/main.exe} --compile -o simd_vector_escape_arg
        native/simd_vector_escape_arg.march)
   (with-stdout-to simd_vector_escape_arg.out
        (system "./simd_vector_escape_arg")))))

(rule
 (alias runtest)
 (action
  (diff native/simd_vector_escape_arg.expected simd_vector_escape_arg.out)))

; ...and again at --opt 2, which is where the double-free was originally
; measured. Not redundant with the default-opt run above: at --opt 2 LLVM may
