(test
 (name test_refinecheck)
 (modules test_refinecheck)
 ; march_typecheck: the `no-panic-by-proof` group runs the REAL pipeline
 ; (typecheck -> refine_check -> division_safety -> panic_surface_by_proof),
 ; because the question it asks — "does a guarded call still error?" — spans
