-- A task runs under the authority in force where it is spawned (design §7):
-- spawned inside a framed fn, its body is refused what the frame refuses,
-- even when that body is a module-level function value, which captures
-- nothing and so runs under whatever authority its task has.  A task
-- spawned by a function value runs under the value's captured authority,
-- not its caller's; main's own tasks keep the launch authority.
mod TaskInheritsCapture do
  needs IO.Console
  needs IO.FileRead
  needs IO.Spawn

  fn verdict(r : Result(a, CapError)) : String do
    match r do
    Ok(_) -> "allowed"
    Err(e) -> Authority.describe(e)
    end
  end

  let probe_l = fn () -> verdict(File.exists("/etc/hosts"))

  fn run(f : () -> String) : String do
    match Task.async(f) do
    Err(e) -> "spawn: " ++ Authority.describe(e)
    Ok(t) ->
      match Task.await(t) do
      Ok(s) -> s
      Err(e) -> "await failed: " ++ e
      end
    end
  end

  fn in_frame() : String needs IO.FileRead("/srv/"), IO.Spawn do
    run(fn () -> verdict(File.exists("/etc/hosts"))) ++ " / " ++ run(probe_l)
  end

  fn mk() : String -> String needs IO.FileRead("/srv/"), IO.Spawn do
    fn p -> run(probe_l) ++ " / " ++ run(fn () -> verdict(File.exists(p)))
  end

  fn main() do
    println("in frame: " ++ in_frame())
    let made = mk()
    println("made in frame: " ++ made("/srv/x"))
    println("made in frame: " ++ made("/etc/hosts"))
    println("main: " ++ run(probe_l))
  end
end
