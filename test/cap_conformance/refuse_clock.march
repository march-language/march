-- REFUSE: IO.Clock
-- One refused kind: a clock check is refused by the launch, with the hook's
-- text as the limit's scope; a console check still passes.
mod RefuseClock do
  needs IO.Console

  fn show_check(kind : String, target : String) : String do
    match Authority.check(kind, target) do
    Ok(_) -> kind ++ " allowed"
    Err(e) -> Authority.describe(e)
    end
  end

  fn main(_c : Cap(IO.Console)) do
    println(show_check("IO.Clock", ""))
    println(show_check("IO.Console", "stdout"))
  end
end
