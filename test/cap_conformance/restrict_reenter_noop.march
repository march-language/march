-- Re-entering a restrict whose layer is already on top pushes nothing (ocap
-- p5 decision 8): a 1,000-deep recursion through the same scoped restrict
-- completes in every runtime, its innermost check is still refused outside
-- the scope by that one restrict, and main's authority is unchanged after
-- it returns. A framed restrict body is not a tail position (a deferred
-- todo), so the stack grows one frame per call, though the layer list does
-- not: 10,000 deep overflows the stack compiled (--opt 0) and under node,
-- as a plain 10,000-deep non-tail recursion with no restrict also does.
mod RestrictReenterNoop do
  needs IO.Console
  needs IO.FileRead

  fn probe(target : String) : String do
    match Authority.check("IO.FileRead", target) do
    Ok(_) -> "allowed " ++ target
    Err(e) -> Authority.describe(e)
    end
  end

  fn countdown(n : Int, p : String) : String do
    restrict IO.FileRead("/srv/") do
      if n == 0 do probe(p)
      else countdown(n - 1, p) end
    end
  end

  fn main() do
    println(countdown(1000, "/srv/x"))
    println(countdown(1000, "/etc/hosts"))
    println(probe("/etc/hosts"))
  end
end
