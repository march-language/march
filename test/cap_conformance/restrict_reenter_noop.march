-- Re-entering a restrict whose layer is already on top pushes nothing (ocap
-- p5 decision 8): a 100,000-deep recursion through the same scoped restrict
-- completes in every runtime, its innermost check is still refused outside
-- the scope by that one restrict, and main's authority is unchanged after
-- it returns. The restrict is countdown's whole body, so the body is
-- outlined and the self call loops instead of re-entering the frame
-- (Auth_rt.outline_restrict_body); before that the frame's restore made it
-- a non-tail call, and 30,000 deep died with SIGBUS compiled.
mod RestrictReenterNoop do
  needs IO.Console
  needs IO.FileRead

  fn probe(target : String) : String do
    match Authority.check("IO.FileRead", target) do
    Ok(_) -> "allowed " ++ target
    Err(e) -> Authority.describe(e)
    end
  end

  fn countdown(n : Int, p : String) : String do
    restrict IO.FileRead("/srv/") do
      if n == 0 do probe(p)
      else countdown(n - 1, p) end
    end
  end

  fn main() do
    println(countdown(100000, "/srv/x"))
    println(countdown(100000, "/etc/hosts"))
    println(probe("/etc/hosts"))
  end
end
