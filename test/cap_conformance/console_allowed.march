-- GRANT: IO.Console
-- With the console granted, every console operation prints and returns
-- Ok(()).
mod ConsoleAllowed do
  needs IO.Console

  fn main() needs IO.Console do
    let a = println("println")
    let b = IO.puts("IO.puts")
    let c = IO.write("IO.write\n")
    println(a == Ok(()) && b == Ok(()) && c == Ok(()))
    println(IO.inspect(5))
    debug("debug")
  end
end
