-- GRANT: IO.Console
-- The network opens outside the launch grant are refused before anything is
-- bound or looked up (ocap phase 4, Task 9): `HttpServer.listen` and
-- `spawn_n` on their port, `bind_host` on its address, and `Udp.resolve` on
-- its `host:port`. Each refusal is the outer Err; nothing listens, so
-- `listen` returns instead of serving forever. A server with a
-- `plain_listener` is refused on its main port, checked first: IO.NetListen
-- takes no scope, so the plain port's check cannot refuse on its own.
mod ListenRefused do
  needs IO.Console
  needs IO.NetListen
  needs IO.NetConnect

  fn verdict(r : Result(a, CapError)) : String do
    match r do
    Ok(_) -> "allowed"
    Err(e) -> Authority.describe(e)
    end
  end

  fn server() do
    HttpServer.new(18097)
    |> HttpServer.plug(fn conn -> HttpServer.text(conn, 200, "ok"))
  end

  fn main(_c : Cap(IO.Console), _l : Cap(IO.NetListen), _n : Cap(IO.NetConnect)) do
    println(verdict(HttpServer.listen(server())))
    println(verdict(HttpServer.spawn_n(server(), 1)))
    println(verdict(HttpServer.bind_host("127.0.0.1")))
    println(verdict(HttpServer.listen(HttpServer.plain_listener(server(), 18098, Nil))))
    println(verdict(Udp.resolve("localhost", 9000)))
  end
end
