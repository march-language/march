-- An actor spawned inside a restrict block runs under the block's narrowed
-- authority for life (design §7, §9): asked after the block has ended, it
-- is still refused outside the scope, naming the restrict. The child of a
-- supervisor spawned inside the block is restricted the same way, and a
-- supervisor restart restores that authority, the child's first spawn's,
-- after it crashes and after main, which holds the launch authority, kills
-- it.
mod RestrictActorRestrictedForLife do
  needs IO
  needs IO.Console
  needs IO.FileRead
  needs IO.Spawn
  needs Actor.Introspect

  type ProbeReq = ProbeReq

  fn verdict(r : Result(a, CapError)) : String do
    match r do
    Ok(_) -> "allowed"
    Err(e) -> Authority.describe(e)
    end
  end

  actor Fragile do
    state { n : Int }
    init  { n: 0 }
    on Probe(reply_to) do
      Actor.reply(reply_to,
        verdict(File.exists("/etc/hosts")) ++ " / " ++ verdict(File.exists("/srv/x")))
      state
    end
    on Poison() do
      panic("poisoned")
      state
    end
  end

  actor Boss do
    state { child : Int }
    init  { child: 0 }
    supervise do
      strategy one_for_one
      max_restarts 10 within 60
      Fragile child
    end
  end

  fn start_worker() do
    restrict IO.FileRead("/srv/"), IO.Spawn do
      spawn(Fragile)
    end
  end

  fn start_boss() do
    restrict IO.FileRead("/srv/"), IO.Spawn do
      spawn(Boss)
    end
  end

  fn child_of(boss) : Int do
    match get_actor_field(boss, "child") do
    None -> -1
    Some(n) -> n
    end
  end

  fn ask(p) : String do
    match Actor.call(p, ProbeReq, 5000) do
    Ok(s) -> s
    Err(e) -> "call failed: " ++ e
    end
  end

  fn main(io : Cap(IO)) do
    let intro = Actor.introspect(io)
    let w = start_worker()
    println("worker: " ++ ask(w))
    let boss = start_boss()
    let c1 = child_of(boss)
    println("child: " ++ ask(Actor.pid_from_int(intro, c1)))
    send(Actor.pid_from_int(intro, c1), Poison())
    run_until_idle()
    let c2 = child_of(boss)
    println("restarted: " ++ bool_to_string(c2 != c1))
    println("after crash: " ++ ask(Actor.pid_from_int(intro, c2)))
    kill(Actor.pid_from_int(intro, c2))
    run_until_idle()
    let c3 = child_of(boss)
    println("restarted again: " ++ bool_to_string(c3 != c2))
    println("after kill: " ++ ask(Actor.pid_from_int(intro, c3)))
    println("main: " ++ verdict(File.exists("/etc/hosts")))
  end
end
