-- A task runs under the authority in force where it is spawned (design §7,
-- §9): spawned inside a restrict block, its body is refused what the block
-- refuses, even when that body is a module-level function value, which
-- captures nothing and so runs under whatever authority its task has. A
-- function value made inside the block spawns its tasks under the block's
-- authority after the block has ended; main's own tasks keep the launch
-- authority.
mod RestrictTaskInherits do
  needs IO.Console
  needs IO.FileRead
  needs IO.Spawn

  fn verdict(r : Result(a, CapError)) : String do
    match r do
    Ok(_) -> "allowed"
    Err(e) -> Authority.describe(e)
    end
  end

  let probe_l = fn () -> verdict(File.exists("/etc/hosts"))

  fn run(f : () -> String) : String do
    match Task.async(f) do
    Err(e) -> "spawn: " ++ Authority.describe(e)
    Ok(t) ->
      match Task.await(t) do
      Ok(s) -> s
      Err(e) -> "await failed: " ++ e
      end
    end
  end

  fn in_block() : String do
    restrict IO.FileRead("/srv/"), IO.Spawn do
      run(fn () -> verdict(File.exists("/etc/hosts"))) ++ " / " ++ run(probe_l)
    end
  end

  fn mk() : String -> String do
    restrict IO.FileRead("/srv/"), IO.Spawn do
      fn p -> run(probe_l) ++ " / " ++ run(fn () -> verdict(File.exists(p)))
    end
  end

  fn main() do
    println("in block: " ++ in_block())
    let made = mk()
    println("made in block: " ++ made("/srv/x"))
    println("made in block: " ++ made("/etc/hosts"))
    println("main: " ++ run(probe_l))
  end
end
