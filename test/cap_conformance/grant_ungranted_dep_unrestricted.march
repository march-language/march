-- DEP: gate deps/gate none
-- A dependency with no grant keeps today's behaviour (design §10, the
-- `legacy` line): it gets no frame and is limited only by its own `needs`
-- and its caller's authority. Here the app runs with no launch grant and an
-- unscoped request, which installs no launch layer, so the app's authority
-- is unrestricted and so is the ungranted `gate`'s: even IO.Process, which
-- the app never declares, is allowed (`gate`'s `needs` line does not widen
-- the launch request). `grant_ungranted_dep_caller_limits` shows the caller's
-- authority refusing; `grant_refuses_scoped` is the same calls with a grant.
mod GrantUngrantedDepUnrestricted do
  needs IO.Console
  needs IO.FileRead

  fn reads() : String do
    Gate.read_at("/etc", "hosts") ++ " | " ++ Gate.check_path("/srv/x")
  end

  fn env() : String do
    Gate.probe("IO.Process", "HOME")
  end

  fn mine(p : String) : String do
    match Authority.check("IO.FileRead", p) do
    Ok(_) -> "allowed " ++ p
    Err(e) -> Authority.describe(e)
    end
  end

  fn main() do
    println(reads())
    println(env())
    println("app: " ++ mine("/etc/hosts"))
  end
end
