-- TEST
-- A scoped mock covers only the targets its scope admits (ocap phase 7):
-- `mock IO.FileRead("/fixtures/")` takes reads under /fixtures/, and a read
-- elsewhere runs for real (here: a path that does not exist).
mod MockScoped do
  needs IO.Console
  needs IO.FileRead

  fn read(p : String) : String do
    match File.read(p) do
    Ok(Ok(s)) -> "read " ++ s
    Ok(Err(_)) -> "real read failed"
    Err(e) -> Authority.describe(e)
    end
  end

  fn main() do
    mock IO.FileRead("/fixtures/") with { file_read: Some(fn p -> Ok("<" ++ p ++ ">")) } do
      println(read("/fixtures/a.txt"))
      println(read("/nonexistent-march-mock/a.txt"))
    end
  end
end
