-- GRANT: IO.Console, IO.FileRead
-- EXIT-ONLY
-- A launch grant wider than main's request is an error at launch, not a
-- widening (design §3, §11): one line on stderr and exit status 2, before
-- any of the program runs.
mod GrantWiderLaunchError do
  needs IO.Console

  fn main() needs IO.Console do
    println("main ran")
  end
end
