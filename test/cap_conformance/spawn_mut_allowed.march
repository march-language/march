-- GRANT: IO.Console, IO.Spawn, IO.Mut
-- Spawning and opening tables allowed: the results are Ok and usable, and a
-- table handle's uses need nothing further.
mod SpawnMutAllowed do
  needs IO.Console
  needs IO.Spawn
  needs IO.Mut

  -- The steps live in a function, not in main's body, and the last one
  -- matches instead of comparing with `==`: the REPL mode types main's body
  -- one prompt line at a time, which does not fix a table's element type
  -- from a later line, and types each preloaded declaration alone, which
  -- finds no `Eq` for `Result(Option(Int), CapError)`.
  fn exercise() do
    let t = Authority.must(Task.async(fn () -> 21 * 2))
    println(Task.await(t))
    let v = Authority.must(Vault.new("conformance_allowed"))
    Vault.set(v, "k", 7)
    println(Vault.get_or(v, "k", 0))
    println(match Vault.ns_get("conformance_allowed", "k") do
      Ok(Some(7)) -> true
      _ -> false
      end)
  end

  fn main(_c : Cap(IO.Console), _s : Cap(IO.Spawn), _m : Cap(IO.Mut)) do
    exercise()
  end
end
