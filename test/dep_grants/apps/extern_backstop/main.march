mod Main do
  needs IO.Console, IO.Foreign

  fn caught(r : Result(String, String)) : String do
    match r do
    Ok(s) -> s
    Err(_) -> "refused"
    end
  end

  fn main() do
    println("direct: " ++ peek(Pidlib.tok()))
    println("callback: " ++ Pidshow.call(fn _ -> if Pidlib.positive() do "ran getpid" else "ran getpid" end))
    println("through pidshow: " ++ caught(__try_call_val(fn _ -> Pidshow.run())))
  end
end
