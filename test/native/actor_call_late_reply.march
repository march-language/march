-- Correlation-checked Actor.call replies, and Actor.call's timeout as a real
-- wall-clock deadline on BOTH backends (the interpreter ignored timeout_ms
-- entirely until 2026-09-08, which is why this fixture used to run compiled
-- only -- interpreted it reported `first: unexpected ok`):
-- a first call times out (the handler replies late); the caller then issues
-- a second call. Without correlation checking, the stale first reply is
-- returned as the second call's answer. With it, the second call gets the
-- second reply.
mod Main do
  needs IO.Console
  needs IO.Clock

  type GetReq = GetReq

  -- Make the handler late by the CLOCK, not by a fixed amount of work.
  --
  -- This fixture used to burn a fixed 20,000,000-element fold, which is only
  -- ever "slow" relative to whatever machine runs it: the interpreter needed
  -- that cut to something affordable (~300x slower per element than compiled),
  -- and at 50,000 the compiled handler finished INSIDE the 1ms deadline on the
  -- macos-15 CI runner while taking 4ms locally, so the golden said
  -- `first: unexpected ok` in CI and `first: timeout` here. Raw speed is not
  -- even the whole story -- on a many-core runner the handler's green thread
  -- gets a head start on the caller.
  --
  -- Spinning until a wall-clock deadline costs the same 50ms on both backends
  -- and on any machine, which is a 50x margin over the 1ms deadline below
  -- instead of a 4x one. Both backends tail-call-optimize this, so it does not
  -- grow the stack.
  fn spin_until(deadline_ms) do
    if unix_time_ms() >= deadline_ms do
      0
    else
      spin_until(deadline_ms)
    end
  end

  actor Echo do
    state { n : Int }
    init  { n: 0 }

    on Get(reply_to) do
      let _ = spin_until(unix_time_ms() + 50)
      Actor.reply(reply_to, state.n)
      { n: state.n + 1 }
    end
  end

  fn main(_cap_console : Cap(IO.Console), _cap_clock : Cap(IO.Clock)) do
    let pid = spawn(Echo)
    let first = Actor.call(pid, GetReq, 1)      -- times out; reply n=0 arrives late
    match first do
      Ok(_)  -> println("first: unexpected ok")
      Err(_) -> println("first: timeout")
    end
    match Actor.call(pid, GetReq, 10000) do      -- must get n=1, not stale n=0
      Ok(n)  -> println("second: " ++ int_to_string(n))
      Err(e) -> println("second err: " ++ e)
    end
  end
end
