-- RSS guard for the per-call SIMD vector temp-box leak.
--
-- `go` is self-tail-recursive with a vector parameter, so llvm_toplevel gives
-- that parameter a NATIVE <4 x float> TCO slot and the entry prologue unboxes
-- the incoming argument once per call. Nothing released that box: one
-- 32-byte march_simd_alloc cell leaked per INVOCATION (not per iteration),
-- unbounded over a long-lived process. `drive` calls `go` 2,000,000 times, so
-- pre-fix max RSS was ~64 MB against ~2.7 MB post-fix; the dune rule asserts
-- max RSS < 32 MB (headroom for allocator noise).
--
-- The fix is caller-side: the call site releases the box IT created, but only
-- for callees listed in ctx.native_vec_params -- callees whose entry prologue
-- provably does one GEP+load and never retains the pointer. The complementary
-- canary for the shapes that must NOT be released is
-- test/native/simd_vector_escape_arg.march.
--
-- The probe measures its OWN peak RSS via the `peak_rss_bytes` builtin
-- (portable: bytes on both macOS and Linux -- see runtime/march_runtime.c)
-- and prints it to STDERR (via IO.warn) as the final line, so stdout stays
-- diffable against .expected while the dune rule parses the RSS figure
-- straight out of the probe's own output -- no `/usr/bin/time`, no Darwin
-- gate.
--
-- specs/progress/2026-08-11-simd-tco-entry-box-leak.md
mod SimdLeakProbe do
  needs IO.Console

  pfn go(v, i : Int) : Float do
    if i <= 0 do Simd.sum_f32x4(v)
    else go(Simd.add_f32x4(v, Simd.splat_f32x4(0.0)), i - 1) end
  end

  pfn drive(n : Int, acc : Float) : Float do
    if n <= 0 do acc
    else drive(n - 1, acc +. go(Simd.splat_f32x4(1.0), 1)) end
  end

  fn main(_cap_console : Cap(IO.Console)) do
    println(drive(2000000, 0.0))
    IO.warn(int_to_string(peak_rss_bytes()))
  end
end
