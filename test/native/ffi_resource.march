-- Regression: FFI resources (opaque native handles, destructor on Perceus drop)
-- and the `consume` param mode (ownership transferred to the binding).
-- `finish(consume a)` reads the total and drops the resource itself; March must
-- NOT also drop it (that was a double-free / RC underflow before `consume`).
mod Test do
  needs Ffi
  resource Acc
  extern "rt" : Cap(Ffi) do
    fn live_allocs(): Int = "march_live_allocs"
    fn acc_new(): Acc = "ffi_acc_new"
    fn acc_push(a: Acc, n: Int): Int = "ffi_acc_push"
    fn finish(consume a: Acc): Int = "ffi_acc_finish"
  end
  fn one() : Int do
    let a = acc_new()
    acc_push(a, 10)
    acc_push(a, 32)
    finish(a)                              -- consume: binding drops a
  end
  fn churn(n: Int) : Unit do
    if n == 0 do () else
      let a = acc_new()
      acc_push(a, 1)
      finish(a)
      churn(n - 1)
    end
  end
  fn main() : Unit do
    println(int_to_string(one()))          -- correctness: 42
    churn(50)
    let base = live_allocs()
    churn(2000)
    println(int_to_string(live_allocs() - base))  -- leak/double-free check: 0
  end
end
