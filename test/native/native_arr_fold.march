-- Compiled/interpreted parity witness for NativeArray.fold_int/fold_float/
-- fold_f32/fold_i32/fold_u8. Task 2 of the SIMD follow-ups plan: fold_int and
-- fold_float previously had no compiled implementation (link error), and
-- fold_f32/fold_i32/fold_u8 didn't exist at all.
--
-- Argument-order landmine: the March builtin is (init, arr, f), while the
-- reference RC pattern (march_typed_array_fold) is (arr, acc, f), and the
-- stdlib wrapper flips again to collection-first (arr, acc, f). A commutative
-- fold (+) would pass even with the order silently wrong, so every case here
-- uses a NON-COMMUTATIVE fold `fn (acc, x) -> acc * 2 + x`:
--   0*2+1=1, 1*2+2=4, 4*2+3=11
mod NativeArrFold do
  needs IO.Console
  fn main(_cap : Cap(IO.Console)) do
    let i = NativeArray.from_list_int([1, 2, 3])
    println(NativeArray.fold_int(i, 0, fn (acc, x) -> acc * 2 + x))       -- 11
    let f = NativeArray.from_list_float([1.0, 2.0, 3.0])
    println(NativeArray.fold_float(f, 0.0, fn (acc, x) -> acc *. 2.0 +. x)) -- 11.0
    let g = NativeArray.from_list_f32([1.0, 2.0, 3.0])
    println(NativeArray.fold_f32(g, 0.0, fn (acc, x) -> acc *. 2.0 +. x))   -- 11.0
    let j = NativeArray.from_list_i32([1, 2, 3])
    println(NativeArray.fold_i32(j, 0, fn (acc, x) -> acc * 2 + x))         -- 11
    let u = NativeArray.from_list_u8([1, 2, 255])
    println(NativeArray.fold_u8(u, 0, fn (acc, x) -> acc * 2 + x))          -- 263 (255 zero-extends)
    -- accumulator is generic: fold into a List to prove the erased path
    println(List.length(NativeArray.fold_int(i, [], fn (acc, x) -> List.append([x], acc))))  -- 3
  end
end
