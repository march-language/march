-- Tuples are Ord when every component is: lexicographic, the first pair of
-- components that differs decides, each by its own Ord impl. `<`, `<=`, `>`,
-- `>=` on a tuple mean `compare(a, b) <op> 0`. Before: rejected by the
-- typechecker; interpreted `<` panicked and `compare` ordered an ADT component
-- by constructor NAME; compiled `compare` was an ambiguous interface call.
mod Main do
  needs IO.Console
  type Color = Zed | Amber | Blue
  derive Ord for Color

  fn sign(n : Int) : Int do if n < 0 do -1 else if n > 0 do 1 else 0 end end end

  fn lt(a : (Int, String), b : (Int, String)) : Bool do a < b end

  -- Generic: only Mono learns that `a` is a tuple here.
  fn gt(a, b) do a > b end

  fn main(_c : Cap(IO.Console)) do
    println(int_to_string(sign(compare((1, 2), (1, 3)))))
    println(int_to_string(sign(compare((2, 0), (1, 9)))))
    println(int_to_string(sign(compare((1, 2), (1, 2)))))
    println(bool_to_string((1, 2) < (1, 3)))
    println(bool_to_string((1, 3) <= (1, 3)))
    println(bool_to_string((2, 0) > (1, 9)))
    println(bool_to_string((1, 2) >= (1, 3)))
    println(bool_to_string((1, "b") < (1, "ab")))
    println(bool_to_string((1.5, 2) < (1.5, 3)))
    println(bool_to_string((2.5, 0) > (1.0 +. 0.5, 9)))
    println(bool_to_string(((1, 2), "z") < ((1, 3), "a")))
    println(bool_to_string((1, 2, 3) < (1, 2, 4)))
    println(bool_to_string((1, 2, 3, 4, 5) > (1, 2, 3, 4, 4)))
    -- Zed is declared first, so it is the least Color although its name sorts last.
    println(bool_to_string((Zed, 1) < (Amber, 0)))
    println(int_to_string(sign(compare((Blue, 1), (Amber, 2)))))
    println(bool_to_string(lt((7, "s"), (7, "t"))))
    println(bool_to_string(gt((1, 3), (1, 2))))
    println(bool_to_string(gt(2, 3)))
    let sorted = List.sort_by([(2, "b"), (1, "z"), (2, "a")], fn (p, q) -> p < q)
    println(List.fold_left(sorted, "", fn (acc, p) -> match p do (n, s) -> acc ++ int_to_string(n) ++ s end))
  end
end
