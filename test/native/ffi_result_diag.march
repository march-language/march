-- Self-diagnosing variant of ffi_result.march for the intermittent GH-Actions
-- flake (parse("zz") prints "bad int" instead of "nan").  Same canonical prints
-- as the pristine reproducer, plus a diagnostic line: `err_len` decodes the
-- Result cell and dumps its tag + Err-payload ptr/len/bytes to STDERR, and
-- returns the payload length, which we print to stdout so the call survives DCE.
-- On a CI failure the stderr line and the trailing length reveal whether the
-- cell itself already carries a len-7 "bad int" (=> ffi_test_parse returned the
-- wrong string — the shim miscompiled) or a correct len-3 "nan" (=> the
-- divergence is downstream of the shim).  Expected stdout: 7 / nan / 3.
mod Test do
  needs Ffi
  needs IO.Foreign
  extern "rt" : Cap(Ffi) do
    fn parse(s: String): Result(Int, String) = "ffi_test_parse"
    fn err_len(r: Result(Int, String)): Int = "ffi_result_err_len"
  end
  fn shown(r: Result(Int, String)) : String do
    match r do
      Ok(n) -> int_to_string(n)
      Err(e) -> e
    end
  end
  fn main() : Unit do
    println(shown(parse("7")))                    -- Ok(7)   -> 7
    println(shown(parse("zz")))                   -- Err     -> nan
    println(int_to_string(err_len(parse("zz"))))  -- Err payload length -> 3
  end
end
