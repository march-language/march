mod Main do
  needs IO.Console
  fn double(x : Int) : Int do x * 2 end

  fn apply_it(f : Int -> Int, n : Int) : Int do f(n) end

  fn go(i : Int, acc : Int) : Int do
    if i <= 0 do
      acc
    else
      go(i - 1, acc + apply_it(double, i))
    end
  end

  fn main() : () do
    println(go(1000, 0))
    println(go(2000, 0))
  end
end
