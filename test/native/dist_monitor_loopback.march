-- A cross-node monitor, end to end (monitor-fire step 0):
-- specs/todos/2026-09-14-monitor-fire-at-least-once.md.
--
-- node-b hosts an actor and announces its GlobalPid; node-a's Watcher
-- monitors it by sending MONITOR_REQ (tag 7), which node-b's reader hands to
-- `dist_monitor_register` -- the March surface of the C runtime's registry,
-- which until now nothing exposed. node-a then asks node-b to kill the
-- target; the runtime's actor-death path writes MONITOR_FIRE (tag 8) on the
-- registered fd, node-a's reader decodes it and delivers a RemoteDown to the
-- Watcher's mailbox. Exactly one Down, with the real reason.
-- Prints from node-a's main thread only (node-b's would race them).
mod DistMonitorLoopback do
  needs IO.Console
  needs IO.NetListen
  needs IO.Spawn
  needs IO.NetConnect

  -- ── node-b ───────────────────────────────────────────────────────────
  actor Target do
    state { n : Int }
    init  { n: 0 }
    on Tick() do { n: state.n + 1 } end
  end

  pfn on_frame_b(fd : Int, target, tag : Int, frame : List(Int)) : Result(Bool, String) do
    if tag == 7 do
      match DistLink.decode_req(frame) do
        Ok((watcher_node, watcher_pid, target_pid)) ->
          dist_monitor_register(target_pid, watcher_node, watcher_pid, fd)
          Ok(true)
        Err(e) -> Err(e)
      end
    else
      if tag == NodeSend.tag_actor_msg() do
        match NodeSend.decode_msg(frame) do
          Ok(d) ->
            if d.type_tag == "DistMonitorLoopback.Kill" do
              kill(target)          -- the death path fires MONITOR_FIRE
              Ok(true)
            else
              Err("unexpected type " ++ d.type_tag)
            end
          Err(e) -> Err(e)
        end
      else
        Err("unexpected tag " ++ int_to_string(tag))
      end
    end
  end

  pfn run_node_b(listen_fd : Int) do
    match tcp_accept(listen_fd) do
      Ok(fd) ->
        let target = spawn(Target)
        let _ = NodeSend.cast(fd, 0, GlobalPid.make("node-a", 0, 0), "DistMonitorLoopback.Hello",
                              GlobalPid.encode(GlobalPid.make("node-b", pid_to_int(target), 1)))
        let _ = PeerReader.serve(fd, Nil, fn (tag, frame) -> on_frame_b(fd, target, tag, frame))
        tcp_close(fd)
        tcp_close(listen_fd)
      Err(e) ->
        tcp_close(listen_fd)
        panic("accept: " ++ e)
    end
  end

  -- ── node-a ───────────────────────────────────────────────────────────
  actor Watcher do
    state { downs : Int, last : String }
    init  { downs: 0, last: "" }
    on RemoteDown(_target : Int, reason : String) do
      { downs: state.downs + 1, last: reason }
    end
  end

  pfn reason_text(r : DistLink.DownReason) : String do
    match r do
      DistLink.Normal -> "Normal"
      DistLink.Killed -> "Killed"
      DistLink.Crash(m) -> "Crash(" ++ m ++ ")"
      DistLink.NodeDown -> "NodeDown"
    end
  end

  pfn on_frame_a(watcher, tag : Int, frame : List(Int)) : Result(Bool, String) do
    if tag == 8 do
      match DistLink.decode_fire(frame) do
        Ok((target_pid, reason)) ->
          println("node-a: MONITOR_FIRE for target " ++ int_to_string(target_pid) ++ " reason=" ++ reason_text(reason))
          let _ = send(watcher, RemoteDown(target_pid, reason_text(reason)))
          Ok(false)
        Err(e) -> Err(e)
      end
    else
      Err("unexpected tag " ++ int_to_string(tag))
    end
  end

  pfn read_hello(fd : Int) : Pid do
    match NetKernel.recv_frame(fd, Nil) do
      Err(e) -> panic("hello: " ++ e)
      Ok((frame, _)) ->
        match NodeSend.decode_msg(frame) do
          Ok(d) ->
            match GlobalPid.decode(d.payload) do
              Ok(p) -> p
              Err(e) -> panic("hello pid: " ++ e)
            end
          Err(e) -> panic("hello frame: " ++ e)
        end
    end
  end

  pfn connect_with_retry(host : String, port : Int, attempts_left : Int) : Result(Int, Socket.SocketError) do
    match Socket.connect(host, port) do
      Ok(fd) -> Ok(fd)
      Err(e) -> if attempts_left <= 1 do Err(e) else connect_with_retry(host, port, attempts_left - 1) end
    end
  end

  fn main(_cap_console : Cap(IO.Console), _cap_netconnect : Cap(IO.NetConnect), _cap_netlisten : Cap(IO.NetListen), _cap_spawn : Cap(IO.Spawn)) do
    let listen_fd = match tcp_listen(0) do
      Ok(fd) -> fd
      Err(e) -> panic("listen: " ++ e)
    end
    let port = match tcp_local_port(listen_fd) do
      Ok(p) -> p
      Err(e) -> panic("local_port: " ++ e)
    end
    let srv = task_spawn(fn _ -> run_node_b(listen_fd))
    let fd = match connect_with_retry("127.0.0.1", port, 5) do
      Ok(fd) -> fd
      Err(e) -> panic("connect: " ++ Socket.error_message(e))
    end
    let watcher = spawn(Watcher)
    let target = read_hello(fd)
    println("node-a: monitoring " ++ target.node_id ++ "'s actor " ++ int_to_string(target.local_pid))
    let _ = NetKernel.send_frame(fd, DistLink.encode_req("node-a", pid_to_int(watcher), target.local_pid))
    let _ = NodeSend.cast(fd, 1, target, "DistMonitorLoopback.Kill", Nil)
    match PeerReader.serve(fd, Nil, fn (tag, frame) -> on_frame_a(watcher, tag, frame)) do
      Ok(_) -> ()
      Err(e) -> println("node-a: reader error: " ++ e)
    end
    tcp_close(fd)
    let _ = task_await(srv)
    run_until_idle()
    match get_actor_field(watcher, "downs") do
      Some(n) -> println("node-a: watcher saw " ++ int_to_string(n) ++ " Down(s)")
      None -> println("node-a: watcher gone")
    end
  end
end
