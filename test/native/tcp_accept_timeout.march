-- `Socket.accept_timeout` (over the raw `tcp_accept_timeout`): a listener
-- that nobody dials gives up with Err(RecvTimeout(ms)) once the timeout passes, instead of waiting
-- for ever as `tcp_accept` does; one that is dialed accepts as usual. The
-- session role runner's accept deadline stands on it
-- (specs/progress/2026-09-18-session-accept-deadline.md).
mod TcpAcceptTimeout do
  needs IO
  needs IO.Console
  needs IO.NetConnect
  needs IO.NetListen
  needs IO.Spawn

  fn main(c : Cap(IO)) do
    let l = match Authority.must(Socket.listen(0)) do
      Ok(l) -> l
      Err(e) -> panic("listen: " ++ Socket.error_message(e))
    end
    let port = match Socket.local_port(l) do
      Ok(p) -> p
      Err(e) -> panic("port: " ++ Socket.error_message(e))
    end
    match Socket.accept_timeout(l, 300) do
      Ok(_) -> println("nobody dialed, yet accepted")
      Err(e) -> println("no client: " ++ Socket.error_message(e))
    end
    let dialer = task_spawn(fn _ -> do
      sleep_ms(100)
      match Authority.must(Socket.connect("127.0.0.1", port)) do
        Ok(s) ->
          let _ = Socket.close(s)
          1
        Err(_) -> 0
      end
    end)
    match Socket.accept_timeout(l, 5000) do
      Ok(s) ->
        println("client accepted")
        let _ = Socket.close(s)
        ()
      Err(e) -> Authority.ignore(println("dialed, yet: " ++ Socket.error_message(e)))
    end
    println("dialer connected: " ++ int_to_string(task_await_unwrap(dialer)))
    let _ = Socket.close_listener(l)
    ()
  end
end
