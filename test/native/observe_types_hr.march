-- Actor type names in the observe socket's ACTORS rows come from the
-- hot-reload dispatch table, so this leg is built with --hot-reload Main
-- (R1 of specs/plans/2026-09-28-observe-recon-shell-plan.md).
--
-- The same build checks TOP's supervision columns (the supervisor's type name
-- `parent_type`, which needs the dispatch table too) and its `stack` ranking:
-- "deep" recursed once and its stack stays grown.
mod Main do
  needs IO.Console
  needs IO.Clock

  actor Counter do
    state { n : Int }
    init  { n: 0 }
    on Bump(k : Int) do
      { n: state.n + k }
    end
  end

  actor Sup do
    state { c : Int }
    init  { c: 0 }
    supervise do
      strategy rest_for_one
      max_restarts 3 within 30
      Counter c
    end
  end

  -- Non-tail recursion over a list: one stack frame per element (a subtraction,
  -- because LLVM turns a recursive addition into a loop).
  fn total(xs : List(Int)) : Int do
    match xs do
      Nil -> 0
      Cons(h, t) -> h - total(t)
    end
  end

  actor Deep do
    state { n : Int }
    init  { n: 0 }
    on Grow(k : Int) do
      { n: total(List.range(0, k)) }
    end
  end

  fn main(_c : Cap(IO.Console), _k : Cap(IO.Clock)) do
    let _a = spawn(Counter)
    let _b = spawn(Counter)
    let sup = spawn(Sup)
    let deep = spawn(Deep)
    let _r1 = Actor.register(sup, "sup")
    let _r2 = Actor.register(deep, "deep")
    send(deep, Grow(8000))
    sleep_ms(500)
    println("ready")
    sleep_ms(120000)
  end
end
