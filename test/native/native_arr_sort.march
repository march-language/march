-- Compiled witness for NativeArray.sort_int (ipnsort-style, implemented in the
-- C runtime; see specs/todos/2026-09-16-native-array-sort-ipnsort.md).
--
-- Every case cross-checks the C sort against List.sort_by, an INDEPENDENT
-- implementation (stdlib/list.march's mergesort over cons cells). Asserting
-- only "the output is sorted" would pass a sort that dropped or duplicated
-- elements, which is exactly how a mis-indexed partition fails.
--
-- The input patterns are the ones in bench/c/native_sort_bench.c, each aimed
-- at a specific branch of the algorithm:
--   sorted / reversed  — the top-level full-run scan (and its reverse-in-place)
--   equal / dist10     — the equal-partition path for a repeated pivot
--   sawtooth           — periodic input, which defeats fixed-stride pivot
--                        sampling unless the pattern-breaking step runs
--   organ              — a classic median-of-3 killer shape
--   random             — the ordinary branchless-Lomuto path
--
-- Each pattern runs at 13 sizes straddling the n <= 32 small-sort cutoff and
-- the 8-element network blocks (0, 1, 2, 7, 8, 9, 31, 32, 33, 64, 65, 200,
-- 1000): an off-by-one in either boundary is invisible at a single size. Each
-- line prints how many of the 13 agreed, so a regression names its pattern
-- instead of just failing.
--
-- The aliasing case is the one that catches an FBIP mistake: sorting a SHARED
-- array must copy rather than mutate, or the original binding silently changes
-- under its owner. A sort that ignores the rc > 1 branch passes every other
-- case here and only fails that one.
--
-- NativeArray.sort_float (f64) runs the same patterns on signed, fractional
-- doubles, and then the part only floats have: IEEE 754 totalOrder placement
-- of -NaN, -Inf, -0.0, +0.0, +Inf, +NaN. Floats are compared through
-- float_to_string renderings, because NaN != NaN under `==` and -0.0 == 0.0.
-- NaN renders as "nan" whatever its sign, so a NaN's sign shows up only as
-- its POSITION, which is exactly what is being tested. The interpreter must
-- print the same lines: OCaml's `compare` puts every NaN first and treats
-- -0.0 as equal to 0.0, so an interpreter arm built on it fails `specials`
-- and `nan last` here.
--
-- test/dune runs the compiled binary a second time with
-- MARCH_TEST_NSORT_DEPTH_LIMIT=0 against the same golden: that forces every
-- segment above the small-sort cutoff into the heapsort fallback, which the
-- pattern-breaking step otherwise makes unreachable from any input.
mod NativeArrSort do
  needs IO.Console

  -- Build [f(0), f(1), ..., f(n-1)]. Tail-recursive with an accumulator.
  pfn build(n : Int, f : Int -> a) : List(a) do
    fn go(i : Int, acc : List(a)) : List(a) do
      if i < 0 do acc else go(i - 1, Cons(f(i), acc)) end
    end
    go(n - 1, Nil)
  end

  -- Deterministic scramble: a fixed sequence keeps a failure reproducible.
  pfn scramble(i : Int) : Int do
    let x = (i * 2654435761) % 1000003
    if x < 0 do 0 - x else x end
  end

  pfn sorted_l(n : Int) : List(Int) do build(n, fn i -> i) end
  pfn reversed_l(n : Int) : List(Int) do build(n, fn i -> n - i) end
  pfn equal_l(n : Int) : List(Int) do build(n, fn _ -> 42) end
  pfn dist10_l(n : Int) : List(Int) do build(n, fn i -> scramble(i) % 10) end
  pfn sawtooth_l(n : Int) : List(Int) do build(n, fn i -> i % 17) end
  pfn organ_l(n : Int) : List(Int) do
    build(n, fn i -> if i < n / 2 do i else n - i end)
  end
  pfn random_l(n : Int) : List(Int) do build(n, fn i -> scramble(i)) end
  pfn nearly_l(n : Int) : List(Int) do
    build(n, fn i -> if i % 50 == 0 do scramble(i) % 100 else i end)
  end

  pfn expected(xs : List(Int)) : List(Int) do
    List.sort_by(xs, fn (a, b) -> a <= b)
  end

  pfn agrees(xs : List(Int)) : Bool do
    let got = NativeArray.to_list_int(
      NativeArray.sort_int(NativeArray.from_list_int(xs)))
    got == expected(xs)
  end

  -- How many of the 13 sizes the C sort got right for this pattern.
  pfn score(gen : Int -> List(Int)) : Int do
    let sizes = [0, 1, 2, 7, 8, 9, 31, 32, 33, 64, 65, 200, 1000]
    List.fold_left(sizes, 0, fn (acc, n) ->
      if agrees(gen(n)) do acc + 1 else acc end)
  end

  -- ── f64 ────────────────────────────────────────────────────────────────

  -- Signed, fractional doubles from an int pattern, so the totalOrder key's
  -- negative branch runs on every case, not only on the specials.
  pfn to_f(xs : List(Int)) : List(Float) do
    List.map(xs, fn x -> int_to_float(x - 500) *. 0.25)
  end

  pfn render(xs : List(Float)) : List(String) do
    List.map(xs, fn x -> float_to_string(x))
  end

  pfn agrees_f(xs : List(Float)) : Bool do
    let got = NativeArray.to_list_float(
      NativeArray.sort_float(NativeArray.from_list_float(xs)))
    render(got) == render(List.sort_by(xs, fn (a, b) -> a <= b))
  end

  pfn score_f(gen : Int -> List(Int)) : Int do
    let sizes = [0, 1, 2, 7, 8, 9, 31, 32, 33, 64, 65, 200, 1000]
    List.fold_left(sizes, 0, fn (acc, n) ->
      if agrees_f(to_f(gen(n))) do acc + 1 else acc end)
  end

  -- Element i of the mixed-specials array: every 13th slot is one of six
  -- special values, cycling in the order below; the rest are nonzero finite
  -- values of both signs. Kind 0..5 = -NaN, -Inf, -0.0, +0.0, +Inf, +NaN,
  -- which is also their totalOrder rank; 6 = finite negative, 7 = finite
  -- positive.
  pfn kind(i : Int) : Int do
    if i % 13 == 0 do (i / 13) % 6
    else if finite(i) < 0.0 do 6 else 7 end end
  end

  pfn finite(i : Int) : Float do
    int_to_float(scramble(i) % 2000 - 1000) +. 0.5
  end

  pfn special(k : Int) : Float do
    match k do
      0 -> -float_nan()
      1 -> float_neg_infinity()
      2 -> 0.0 *. -1.0
      3 -> 0.0
      4 -> float_infinity()
      _ -> float_nan()
    end
  end

  pfn mixed_at(i : Int) : Float do
    let k = kind(i)
    if k < 6 do special(k) else finite(i) end
  end

  -- The expected order, built from KINDS rather than by comparing values:
  -- specials of each rank in rank order, with the finite negatives between
  -- -Inf and -0.0 and the finite positives between +0.0 and +Inf.
  pfn mixed_expected(n : Int) : List(Float) do
    let idx = build(n, fn i -> i)
    let of_kind = fn k -> List.map(List.filter(idx, fn i -> kind(i) == k), fn i -> mixed_at(i))
    let asc = fn xs -> List.sort_by(xs, fn (a, b) -> a <= b)
    List.concat([of_kind(0), of_kind(1), asc(of_kind(6)), of_kind(2),
                 of_kind(3), asc(of_kind(7)), of_kind(4), of_kind(5)])
  end

  pfn mixed_agrees(n : Int) : Bool do
    let got = NativeArray.to_list_float(
      NativeArray.sort_float(NativeArray.from_list_float(build(n, mixed_at))))
    render(got) == render(mixed_expected(n))
  end

  pfn show_sorted_f(xs : List(Float)) : String do
    let got = NativeArray.to_list_float(
      NativeArray.sort_float(NativeArray.from_list_float(xs)))
    List.fold_left(render(got), "", fn (acc, s) ->
      if acc == "" do s else acc ++ " " ++ s end)
  end

  fn main(_cap : Cap(IO.Console)) : () do
    println("sorted: " ++ int_to_string(score(sorted_l)))
    println("reversed: " ++ int_to_string(score(reversed_l)))
    println("equal: " ++ int_to_string(score(equal_l)))
    println("dist10: " ++ int_to_string(score(dist10_l)))
    println("sawtooth: " ++ int_to_string(score(sawtooth_l)))
    println("organ: " ++ int_to_string(score(organ_l)))
    println("random: " ++ int_to_string(score(random_l)))
    println("nearly: " ++ int_to_string(score(nearly_l)))

    -- rc > 1: `shared` is still live after the sort, so sort_int must copy.
    -- An unconditional in-place sort leaves `shared` sorted and fails here.
    let shared = NativeArray.from_list_int([5, 3, 1, 4, 2])
    let sorted = NativeArray.sort_int(shared)
    println("alias original intact: "
            ++ bool_to_string(NativeArray.to_list_int(shared) == [5, 3, 1, 4, 2]))
    println("alias result sorted: "
            ++ bool_to_string(NativeArray.to_list_int(sorted) == [1, 2, 3, 4, 5]))

    -- Sorting an already-sorted array must not corrupt it (full-run fast path).
    let once = NativeArray.sort_int(NativeArray.from_list_int(random_l(100)))
    let twice = NativeArray.sort_int(once)
    println("idempotent: "
            ++ bool_to_string(NativeArray.to_list_int(twice) == expected(random_l(100))))

    println("f64 sorted: " ++ int_to_string(score_f(sorted_l)))
    println("f64 reversed: " ++ int_to_string(score_f(reversed_l)))
    println("f64 equal: " ++ int_to_string(score_f(equal_l)))
    println("f64 dist10: " ++ int_to_string(score_f(dist10_l)))
    println("f64 sawtooth: " ++ int_to_string(score_f(sawtooth_l)))
    println("f64 organ: " ++ int_to_string(score_f(organ_l)))
    println("f64 random: " ++ int_to_string(score_f(random_l)))
    println("f64 nearly: " ++ int_to_string(score_f(nearly_l)))

    -- totalOrder, spelled out on one small array (small-sort path) ...
    let nz = 0.0 *. -1.0
    println("f64 specials: " ++ show_sorted_f(
      [1.0, float_nan(), nz, float_neg_infinity(), 0.0, -float_nan(),
       float_infinity(), -1.0]))
    -- ... and the parity trap on its own: a +NaN sorts LAST.
    println("f64 nan last: " ++ show_sorted_f([float_nan(), 1.0, -1.0]))
    -- ... and mixed into large arrays (quicksort + equal-partition paths).
    let msizes = [9, 33, 200, 1000, 5000]
    println("f64 mixed specials: " ++ int_to_string(
      List.fold_left(msizes, 0, fn (acc, n) ->
        if mixed_agrees(n) do acc + 1 else acc end)))

    let fshared = NativeArray.from_list_float([0.5, -2.0, 1.5])
    let fsorted = NativeArray.sort_float(fshared)
    println("f64 alias original intact: "
            ++ bool_to_string(NativeArray.to_list_float(fshared) == [0.5, -2.0, 1.5]))
    println("f64 alias result sorted: "
            ++ bool_to_string(NativeArray.to_list_float(fsorted) == [-2.0, 0.5, 1.5]))
  end
end
