-- SIMD load bounds-panic fixture (Task 3). i=2, lanes=4, length=5 ->
-- i+lanes=6 > 5, one past the last legal index (i=1). Asserted against
-- the COMPILED binary's stderr; the interpreter's message has a slightly
-- different prefix (see march_simd_bounds_panic in runtime/march_runtime.c
-- vs. eval.ml's simd_bounds_check).
mod Main do
  needs IO.Console

  fn main() : () do
    let arr = NativeArray.make_f32(5, 0.0)
    let v = Simd.load_f32x4(arr, 2)
    println(Simd.extract_f32x4(v, 0))
  end
end
