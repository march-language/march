mod RecordPattern do
  needs IO.Console
fn area({ w: w, h: h }) : Int do w * h end

fn classify(r : { code : Int, msg : String }) : String do
  match r do
    { code: 404, msg: m } -> m
    { code: c, msg: _ }   -> "other " ++ int_to_string(c)
  end
end

-- A record pattern NESTED inside a constructor payload.  The column's
-- scrutinee here is a synthetic sub-var that compile_matrix_impl leaves at
-- the lowering placeholder type, so EField had no record type to GEP
-- through: llvm_emit fell back to march_record_field_dyn and then decoded
-- the returned word with the FIELD's type.  A statically-laid-out record
-- stores `rate` as a raw inline double, so march_unbox_float dereferenced a
-- double's bit pattern as a pointer — SIGSEGV, compiled only.  Int/String
-- fields happened to survive it, which is why only Float pins the bug.
type Box  = Box({ rate : Float, code : Int })
type Wrap = W({ rate : Float, code : Int }) | Z

fn boxed(b : Box) : String do
  match b do
    Box({ rate: r }) -> float_to_string(r)
  end
end

fn wrapped(w : Wrap) : String do
  match w do
    W({ rate: 1.5, code: c }) -> "exact " ++ int_to_string(c)
    W({ rate: r, code: _ })   -> float_to_string(r)
    Z                         -> "z"
  end
end

fn main(_cap_console : Cap(IO.Console)) : Unit do
  let r = { x: 3, y: 4 }
  match r do
    { x: a, y: b } -> println(int_to_string(a * b))
  end

  let { x: p, y: q } = r
  println(int_to_string(p + q))

  println(int_to_string(area({ w: 6, h: 7 })))
  println(classify({ code: 404, msg: "gone" }))
  println(classify({ code: 200, msg: "ok" }))

  println(boxed(Box({ rate: 1.5, code: 3 })))
  println(wrapped(W({ rate: 1.5, code: 9 })))
  println(wrapped(W({ rate: 2.5, code: 9 })))
  println(wrapped(Z))
end
end
