-- FFI codec completeness: Option(Float) (fully boxed), Option(Unit) (mixed niche),
-- and List(Int) (C-array codec via gen-c). The C binding builds and decodes all
-- values; March passes them through without inspecting internal structure, so no
-- assumption about how March stores List(Int) element slots is needed.
mod Test do
  needs Ffi
  needs IO.Foreign
  type Sample = { avg : Option(Float), flag : Option(Unit), data : List(Int) }
  extern "c" : Cap(Ffi) do
    fn make_sample(n: Int): Sample = "ffi_codec2_make"
    fn describe_sample(s: Sample): String = "ffi_codec2_describe"
  end
  fn main() : Unit do
    println(describe_sample(make_sample(3)))   -- avg=1.5/flag=yes/data=10,20,30
    println(describe_sample(make_sample(0)))   -- avg=none/flag=no/data=
  end
end
