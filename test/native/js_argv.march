-- process_argv on the JS target: Node's arguments after the script (the dune
-- rule runs `node js_argv.mjs one two`); [] in a browser.
mod JsArgv do
  needs IO.Console
  needs IO.Process

  fn main() : Unit needs IO.Console, IO.Process do
    println(String.join(Authority.must(Process.argv()), ","))
    ()
  end
end
