-- Credit-based flow control over loopback (distributed actors 2/4, step 3):
-- a sender whose receiver has not yet consumed anything fills its budget,
-- gets Backpressure under drop_new, and is admitted again once CREDIT
-- arrives on the control connection. Two connections per peer (the split);
-- the receiver reads the data connection only after a "go" on control, so
-- the budget is really what refuses the third frame.
-- Design: specs/todos/2026-09-14-credit-based-flow-control.md.
mod CreditBackpressureLoopback do
  needs IO.Console
  needs IO.Mut
  needs IO.NetListen
  needs IO.NetConnect
  needs IO.Random
  needs IO.Spawn
  needs IO.Process

  pfn secret() do "test-cluster-secret" end
  pfn node_a_id() do NodeIdentity.make("node-a", "pk-a", 1) end
  pfn node_b_id() do NodeIdentity.make("node-b", "pk-b", 1) end
  pfn budget() : Int do 100 end

  -- A 44-byte frame (4-byte prefix + 40 bytes of payload).
  pfn frame() : Bytes do
    Bytes.from_list(NetFrame.encode(List.map(Range.to_list(Range.new(0, 40)), fn _ -> 120)))
  end

  -- node-b: takes the peer's two connections, waits for a "go" ping on
  -- control, then consumes three data frames, announcing credit as it goes.
  pfn read_n(data_fd : Int, control_fd : Int, buf : List(Int), n : Int, got : Int) : Int do
    if n <= 0 do got
    else
      match NetKernel.recv_frame(data_fd, buf) do
        Err(_) -> got
        Ok((fr, rest)) ->
          let _ = NodeQueue.consumed(control_fd, budget(), List.length(fr) + 4)
          read_n(data_fd, control_fd, rest, n - 1, got + 1)
      end
    end
  end

  pfn run_node_b(listen_fd : Int) : Int do
    match ClusterConn.accept_split(PeerRegistry.empty(), listen_fd, node_b_id(), secret()) do
      Err(e) -> panic("node-b accept: " ++ e)
      Ok((_reg, peer)) ->
        let _ = NetKernel.recv_frame(peer.fd, Nil)   -- the "go"
        let got = read_n(peer.data_fd, peer.fd, Nil, 3, 0)
        tcp_close(peer.data_fd)
        tcp_close(peer.fd)
        tcp_close(listen_fd)
        got
    end
  end

  -- node-a's control reader: CREDIT frames feed the queue; stop once the
  -- receiver has consumed all three frames.
  pfn on_control(q, tag : Int, fr : List(Int)) : Result(Bool, String) do
    if tag == NodeQueue.tag_credit() do
      match NodeQueue.decode_credit(fr) do
        Ok(total) ->
          NodeQueue.credit(q, total)
          Ok(total < 132)
        Err(e) -> Err(e)
      end
    else
      Err("unexpected tag " ++ int_to_string(tag))
    end
  end

  fn main(_cap_console : Cap(IO.Console), _cap_netconnect : Cap(IO.NetConnect), _cap_netlisten : Cap(IO.NetListen), _cap_random : Cap(IO.Random), _cap_spawn : Cap(IO.Spawn), _cap_mut : Cap(IO.Mut), _cap_process : Cap(IO.Process)) do
    let listen_fd = match tcp_listen(0) do
      Ok(fd) -> fd
      Err(e) -> panic("listen: " ++ e)
    end
    let port = match tcp_local_port(listen_fd) do
      Ok(p) -> p
      Err(e) -> panic("local_port: " ++ e)
    end
    let srv = task_spawn(fn _ -> run_node_b(listen_fd))
    let peer = match ClusterConn.connect_split(PeerRegistry.empty(), "127.0.0.1", port, node_a_id(), secret()) do
      Err(e) -> panic("node-a connect: " ++ e)
      Ok((_reg, p)) -> p
    end
    let q = NodeQueue.start(peer.data_fd, budget())
    -- Budget 100: two 44-byte frames fit, the third does not.
    let r1 = NodeQueue.enqueue(q, 1, frame(), NodeQueue.DropNew)
    let r2 = NodeQueue.enqueue(q, 2, frame(), NodeQueue.DropNew)
    let r3 = NodeQueue.enqueue(q, 3, frame(), NodeQueue.DropNew)
    println("node-a: two frames admitted: " ++ bool_to_string(r1 == Ok(()) && r2 == Ok(())))
    println("node-a: third refused with Backpressure: " ++ bool_to_string(r3 == Err(NodeQueue.Backpressure)))
    -- Let the receiver consume; its CREDIT frames arrive on control.
    let ctl = task_spawn(fn _ -> match PeerReader.serve(peer.fd, Nil, fn (tag, fr) -> on_control(q, tag, fr)) do
      Ok(_) -> 0
      Err(e) -> panic("control reader: " ++ e)
    end)
    let _ = NetKernel.send_frame(peer.fd, SwimDriver.encode_msg(SwimDriver.SwimPing("node-a")))
    -- The receiver consumes the two frames it was sent (88 >= budget/4, so a
    -- CREDIT comes back); retry the third until credit lets it in.
    let r3b = retry_enqueue(q, 3, 200)
    println("node-a: third admitted after credit: " ++ bool_to_string(r3b))
    let _ = task_await(ctl)
    let got = match task_await(srv) do
      Ok(n) -> n
      Err(e) -> panic("node-b: " ++ e)
    end
    println("node-b: consumed " ++ int_to_string(got) ++ " frames")
    tcp_close(peer.fd)
    tcp_close(peer.data_fd)
  end

  pfn retry_enqueue(q, seq : Int, attempts : Int) : Bool do
    if attempts <= 0 do false
    else
      match NodeQueue.enqueue(q, seq, frame(), NodeQueue.DropNew) do
        Ok(_) -> true
        Err(_) ->
          let _ = Process.run("sleep", Cons("0.01", Nil))
          retry_enqueue(q, seq, attempts - 1)
      end
    end
  end
end
