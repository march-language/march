-- `Node.send(peer, to, msg)` (and `Node.enqueue` through a NodeQueue): the
-- typed remote send, end to end, both
-- backends (specs/progress/2026-09-15-remote-actor-dispatch.md).
--
-- The message types live in a NESTED module and derive Json. The sender
-- writes ONE line per message with no type tag and no codec in sight; the
-- compiler mints the wire tag from the declaration's qualified name and
-- picks the derived encoder. The receiver prints the tag it got (that is
-- the "minted tag equals the derive's registered name" check, on a nested-
-- module type: `Msgs.Ping`, the path from the entry module, whose own name
-- is unwrapped) and decodes with a `from_json` pinned by its result type.
-- Compiled only: the interpreter parks on the loopback accept (as every
-- socket fixture here does); its half of the rewrite is unit-tested in
-- test/stdlib/test_node.march.
-- Prints from node-b (the receiver) ride node-a's console only after the
-- reader returns, so the trace order is deterministic.
mod TypedSendLoopback do
  needs IO.Console
  needs IO.NetListen
  needs IO.NetConnect
  needs IO.Spawn
  needs IO.Mut

  mod Msgs do
    type Ping = { n : Int, who : String }
    derive Json for Ping
    type Report = Hot(Int) | Cold
    derive Json for Report
  end

  -- ── node-b: an @[remote] actor, fed by the generated dispatch ─────────
  -- Each delivery is ALSO routed through `Inbox_Remote.dispatch`: the tag
  -- node-a's compiler minted must equal the one the generated `Node.accepts`
  -- test resolves for the handler's type. The actor records what it got; the
  -- lines print after the reader ends (mailbox order is the delivery order).
  @[remote]
  actor Inbox do
    state { n : Int }
    init  { n: 0 }
    on GotPing(p : Ping) do
      remember("inbox: GotPing n=" ++ int_to_string(p.n))
      { n: state.n + 1 }
    end
    on GotReport(r : Report) do
      remember("inbox: GotReport " ++ (match r do
        Msgs.Hot(t) -> "Hot(" ++ int_to_string(t) ++ ")"
        Msgs.Cold -> "Cold"
      end))
      { n: state.n + 1 }
    end
  end

  pfn remember(line : String) : () do
    match Vault.whereis("typed_send_inbox") do
      Some(t) ->
        let prior = match Vault.get(t, "lines") do
          Some(ls) -> ls
          None -> Nil
        end
        Vault.set(t, "lines", Cons(line, prior))
      None -> ()
    end
  end

  -- ── node-b: receive ─────────────────────────────────────────────────
  pfn describe(d : Delivery) : String do
    match Node.payload(d) do
      Err(e) -> "bad json: " ++ e
      Ok(v) ->
        if d.type_tag == "Msgs.Ping" do
          let r : Result(Ping, Json.DecodeError) = from_json(v)
          match r do
            Ok(p) -> "Ping n=" ++ int_to_string(p.n) ++ " who=" ++ p.who
            Err(_) -> "ping-decode-failed"
          end
        else
          if d.type_tag == "Msgs.Report" do
            let r : Result(Report, Json.DecodeError) = from_json(v)
            match r do
              Ok(Msgs.Hot(t)) -> "Report Hot(" ++ int_to_string(t) ++ ")"
              Ok(Msgs.Cold) -> "Report Cold"
              Err(_) -> "report-decode-failed"
            end
          else
            "unknown tag"
          end
        end
    end
  end

  pfn on_frame_b(seen, inbox, tag : Int, frame : List(Int)) : Result(Bool, String) do
    if tag == NodeSend.tag_actor_msg() do
      match NodeSend.decode_msg(frame) do
        Ok(d) ->
          let line = "node-b: seq=" ++ int_to_string(d.seq) ++ " to=" ++ int_to_string(d.to_local_pid)
                  ++ " tag=" ++ d.type_tag ++ " -> " ++ describe(d)
          let prior = match Vault.get(seen, "lines") do
            Some(ls) -> ls
            None -> Nil
          end
          Vault.set(seen, "lines", Cons(line, prior))
          match Inbox_Remote.dispatch(inbox, d) do
            Ok(true) -> ()
            Ok(false) -> remember("inbox: not routed seq=" ++ int_to_string(d.seq))
            Err(e) -> remember("inbox: error " ++ e)
          end
          Ok(d.seq < 4)
        Err(e) -> Err(e)
      end
    else
      Err("unexpected tag " ++ int_to_string(tag))
    end
  end

  pfn run_node_b(listen_fd : Int, seen, inbox) do
    match tcp_accept(listen_fd) do
      Ok(fd) ->
        let _ = PeerReader.serve(fd, Nil, fn (tag, frame) -> on_frame_b(seen, inbox, tag, frame))
        tcp_close(fd)
        tcp_close(listen_fd)
      Err(e) ->
        tcp_close(listen_fd)
        panic("accept: " ++ e)
    end
  end

  -- ── node-a: send ────────────────────────────────────────────────────
  pfn connect_with_retry(host : String, port : Int, attempts_left : Int) : Result(Int, Socket.SocketError) do
    match Socket.connect(host, port) do
      Ok(fd) -> Ok(fd)
      Err(e) -> if attempts_left <= 1 do Err(e) else connect_with_retry(host, port, attempts_left - 1) end
    end
  end

  pfn show_sent(r : Result(Int, NodeSend.SendError)) : String do
    match r do
      Ok(seq) -> "sent seq=" ++ int_to_string(seq)
      Err(NodeSend.NoConnection) -> "no connection"
      Err(NodeSend.Refused(_, why)) -> "refused: " ++ why
    end
  end

  pfn show_queued(r : Result(Int, NodeQueue.EnqueueError)) : String do
    match r do
      Ok(seq) -> "queued seq=" ++ int_to_string(seq)
      Err(NodeQueue.Backpressure) -> "backpressure"
      Err(NodeQueue.NoConnection) -> "no connection"
    end
  end

  pfn print_all(ls : List(String)) : () do
    match ls do
      Nil -> ()
      Cons(l, rest) ->
        println(l)
        print_all(rest)
    end
  end

  fn main(_cap_console : Cap(IO.Console), _cap_netconnect : Cap(IO.NetConnect), _cap_netlisten : Cap(IO.NetListen), _cap_spawn : Cap(IO.Spawn), _cap_mut : Cap(IO.Mut)) do
    let listen_fd = match tcp_listen(0) do
      Ok(fd) -> fd
      Err(e) -> panic("listen: " ++ e)
    end
    let port = match tcp_local_port(listen_fd) do
      Ok(p) -> p
      Err(e) -> panic("local_port: " ++ e)
    end
    let seen = Vault.new("typed_send_seen")
    let inbox_log = Vault.new("typed_send_inbox")
    let inbox = spawn(Inbox)
    let srv = task_spawn(fn _ -> run_node_b(listen_fd, seen, inbox))
    let fd = match connect_with_retry("127.0.0.1", port, 5) do
      Ok(fd) -> fd
      Err(e) -> panic("connect: " ++ Socket.error_message(e))
    end
    let peer : Peer = {
      node_id: "node-b", identity: NodeIdentity.make("node-b", "pk", 1), fd: fd, data_fd: PeerRegistry.no_fd()
    }
    let target = GlobalPid.make("node-b", 42, 1)
    let ping : Ping = { n: 7, who: "node-a" }
    -- Three typed sends. No tag, no codec: the compiler supplies both.
    println("node-a: " ++ show_sent(Node.send(peer, target, ping)))
    println("node-a: " ++ show_sent(Node.send(peer, target, Msgs.Hot(99))))
    println("node-a: " ++ show_sent(Node.send(peer, target, Msgs.Cold)))
    -- The fourth through a NodeQueue on the same connection: the same
    -- rewrite (`Node.enqueue` -> `enqueue_tagged`), admitted under DropNew and
    -- written by the queue's writer within the initial credit.
    let q = NodeQueue.start(fd, 4096)
    println("node-a: " ++ show_queued(Node.enqueue(q, target, Msgs.Hot(7), NodeQueue.DropNew)))
    let _ = task_await(srv)
    tcp_close(fd)
    match Vault.get(seen, "lines") do
      Some(ls) -> print_all(List.reverse(ls))
      None -> println("node-b saw nothing")
    end
    run_until_idle()
    match Vault.get(inbox_log, "lines") do
      Some(ls) -> print_all(List.reverse(ls))
      None -> println("inbox got nothing")
    end
  end
end
