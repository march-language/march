-- FFI Gap 1: user shim .so loaded by the interpreter.
-- The C functions live in test/native/ffi_shim.c (not in the runtime).
-- The dune rule compiles ffi_shim.c to a .so and passes it via --ffi-so.
mod Test do
  needs IO.Console
  needs Ffi
  needs IO.Foreign

  extern "shim" : Cap(Ffi) do
    fn shim_add(a: Int, b: Int): Int = "shim_add"
    fn shim_mul(a: Int, b: Int): Int = "shim_mul"
    fn shim_strlen(s: String): Int = "shim_strlen"
  end

  fn main() : Unit do
    println(int_to_string(shim_add(3, 4)))
    println(int_to_string(shim_mul(6, 7)))
    println(int_to_string(shim_strlen("hello")))
    -- Regression: an Int argument is marshaled untagged, so a large even
    -- value is bit-identical to a heap pointer.  The post-call cleanup used
    -- to decide what to drop from the bit pattern alone and decremented the
    -- integer as if it were a refcounted object, crashing on anything even
    -- and >= 4096 (the runtime's IS_HEAP_PTR floor) — which is every file
    -- chunk size and every FILE* handle.  Only ownership tracking fixes it.
    println(int_to_string(shim_add(65536, 1)))
    println(int_to_string(shim_mul(4096, 2)))
    println(int_to_string(shim_add(65536, 65536)))
  end
end
