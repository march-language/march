-- Regression: inline refcount fast path (lib/tir/llvm_rc_inline.ml,
-- specs/plans/2026-09-30-inline-rc-fast-path.md).
--
-- Compiled code calls internal inline twins of the six runtime refcount entry
-- points instead of the runtime functions. This program drives every shape the
-- twins distinguish: plain heap objects that are shared and then freed (the
-- last-reference path), string literals (immortal objects, whose decrement must
-- be skipped), capturing closures, Float boxes inside a generic container, and
-- pattern matches that destructure (the _freed forms). Every line must print the
-- same value compiled and interpreted, and the loop must not leak: the dune
-- rule's IR check pins that the twins are used and nothing calls around them.
mod Main do
  needs IO.Console

  type Pair = Pair(List(Int), String)

  pfn build(n : Int, acc : List(Int)) : List(Int) do
    if n <= 0 do acc else build(n - 1, Cons(n, acc)) end
  end

  pfn total_acc(xs : List(Int), acc : Int) : Int do
    match xs do
    Nil -> acc
    Cons(h, t) -> total_acc(t, acc + h)
    end
  end

  pfn total(xs : List(Int)) : Int do total_acc(xs, 0) end

  -- Shares a list between two owners, drops one, keeps using the other.
  pfn share(k : Int, acc : Int) : Int do
    if k <= 0 do acc
    else
      let xs = build(50, Nil)
      let p = Pair(xs, "label")
      let s = match p do
        Pair(ys, l) -> total(ys) + string_length(l)
      end
      share(k - 1, acc + s + total(xs))
    end
  end

  -- Closures capturing heap values, called and dropped every iteration.
  pfn closures(k : Int, acc : Int) : Int do
    if k <= 0 do acc
    else
      let base = build(10, Nil)
      let tag = int_to_string(k)
      let f = fn x -> x + total(base) + string_length(tag)
      closures(k - 1, acc + f(k))
    end
  end

  -- Float boxes in a generic container.
  pfn floats(k : Int, acc : Float) : Float do
    if k <= 0 do acc
    else
      let xs = Cons(int_to_float(k), Cons(0.5, Nil))
      let s = List.fold_left(xs, 0.0, fn (a, x) -> a +. x)
      floats(k - 1, acc +. s)
    end
  end

  -- Immortal string literals passed around and dropped.
  pfn literals(k : Int, acc : Int) : Int do
    if k <= 0 do acc
    else
      let a = "immortal"
      let b = if k % 2 == 0 do a else "other" end
      literals(k - 1, acc + string_length(b) + string_length(a ++ b))
    end
  end

  fn main(_c : Cap(IO.Console)) : () do
    -- The leak check covers every leg except `floats`: a List(Float) cons cell
    -- leaks its boxed Float when dropped, compiled, with or without this fast
    -- path (specs/todos/2026-10-01-aggregate-drop-skips-boxed-float-field.md).
    let a = live_allocs()
    println(int_to_string(share(2000, 0)))
    println(int_to_string(closures(2000, 0)))
    let b = live_allocs()
    println(float_to_string(floats(2000, 0.0)))
    let c = live_allocs()
    println(int_to_string(literals(2000, 0)))
    let grew = (b - a) + (live_allocs() - c)
    println("flat: " ++ bool_to_string(grew < 100))
  end
end
