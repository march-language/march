-- File.close reports a write that only fails when the buffer is flushed.
--
-- File.open_write streams are buffered, so File.write_to of a short string
-- only fills the buffer and answers Ok. The bytes reach the file when the
-- handle is closed, and File.close used to discard that write's result: it
-- answered Ok(()) after losing the data. test/dune runs this with a
-- one-block file size limit (512 or 1024 bytes) and SIGXFSZ ignored, so
-- writing the 3000 buffered bytes out fails with EFBIG at the close.
-- File.with_open_write reports the same failure. Compiled and interpreted.
mod FileCloseFlushError do
  needs IO
  needs IO.Console
  needs IO.FileWrite

  pfn xs(n : Int, acc : String) : String do
    if n <= 0 do acc else xs(n - 1, acc ++ "x") end
  end

  fn main() needs IO do
    let h = match Authority.must(File.open_write("file_close_flush_error.tmp", File.Truncate)) do
      Ok(h) -> h
      Err(_) -> panic("open_write failed")
    end
    match File.write_to(h, xs(3000, "")) do
      Ok(_) -> println("write_to: ok (buffered)")
      Err(_) -> println("write_to: error")
    end
    match File.close(h) do
      Ok(_) -> println("close: ok")
      Err(File.IoError(_)) -> println("close: io error")
      Err(File.Closed) -> println("close: closed")
      Err(_) -> println("close: another error")
    end
    match File.close(h) do
      Err(File.Closed) -> println("second close: closed")
      _ -> println("second close: not closed")
    end
    let data = xs(3000, "")
    match Authority.must(File.with_open_write("file_close_flush_error.tmp", File.Truncate, fn w -> File.write_to(w, data))) do
      Ok(_) -> println("with_open_write: ok")
      Err(File.IoError(_)) -> println("with_open_write: io error")
      Err(_) -> println("with_open_write: another error")
    end
  end
end
