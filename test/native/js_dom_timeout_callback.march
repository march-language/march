-- Regression: Js.Dom.set_timeout's callback is declared `Int -> Unit` (a dummy,
-- ignored Int arg), not `Unit -> Unit`. A true zero-arg lambda (`fn -> body`)
-- types to its body's result directly (no arrow wrapper), so it can never
-- unify with a declared `Unit -> Unit` extern parameter — see the module doc
-- in stdlib/dom.march. This exercises the fix end-to-end under Node: the
-- callback must both typecheck (`fn _ -> ...`) and actually run via the
-- `cb._0(cb, 0)` JS closure-call ABI in runtime/march_dom.mjs.
mod JsDomTimeoutCallback do
  needs IO.Console
  fn main() : Unit do
    Js.Dom.set_timeout(0, fn _ -> println("fired"))
  end
end
