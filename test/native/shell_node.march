-- The node for test/shell_check.ml: a --hot-reload --signing-pubkey build
-- whose shell listener (runtime/march_shell.c) runs signed fragments.
-- Prints "ready" and sleeps; the checker kills it.
mod Main do
  needs IO.Console
  needs IO.Clock
  import List

  -- Reached from the shell as `Main.evens(..)` and `evens(..)`: a
  -- self-qualified name, and a body whose bare `filter` is an import.
  fn evens(n : Int) : List(Int) do
    filter(range(0, n), fn x -> x % 2 == 0)
  end

  -- Uses IO.Clock, which the session's shell policy does not list: an input
  -- calling it is refused, though the input names no capability itself.
  fn nap() : Int do
    if unix_time_ms() > 0 do 7 else 0 end
  end

  -- test/native/shell_node_skew.march declares these constructors in the
  -- other order: the shell must refuse an input that builds one.
  type Shade = Light | Dark

  -- For the shell's result rendering (test/shell/session.txt): a record
  -- holding a list, a recursive ADT that derives Show (rendered
  -- structurally, as its derived impl would), and a type whose HAND-WRITTEN
  -- Show is called and cut at 16 KiB.
  type Item = { name : String, tags : List(String) }
  type Twig = Bud | Fork(Twig, Int, Twig)
  derive Show for Twig
  type Blob = Blob(Int)
  impl Show(Blob) do
    fn show(b) do
      match b do
        Blob(n) -> "Blob:" ++ string_repeat("x", n)
      end
    end
  end

  fn items(n : Int) : List(Item) do
    List.map(range(0, n), fn i -> { name: "item" ++ int_to_string(i), tags: List.map(range(0, i), fn j -> "t" ++ int_to_string(j)) })
  end

  actor Counter do
    state { n : Int }
    init  { n: 0 }
    on Bump(k : Int) do
      { n: state.n + k }
    end
  end

  fn main(_c : Cap(IO.Console), _k : Cap(IO.Clock)) do
    let c = spawn(Counter)
    send(c, Bump(1))
    -- Stdlib code the node's own build carries (Json's parser and printer
    -- survive its optimiser; List.range and friends are inlined away): a
    -- shell input reaching it calls these instead of compiling a copy
    -- (test/shell/link.txt).
    match Json.parse("[1, {\"ok\": true}]") do
      Ok(j) -> println(Json.to_string(j))
      Err(e) -> println(e)
    end
    println("ready")
    sleep_ms(120000)
  end
end
