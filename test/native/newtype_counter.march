-- Regression: unboxed newtype (single-field single-variant type).
-- Counter(Int) must be stored as the tagged scalar, not heap-allocated.
-- bump: Counter -> Counter (construct + match across function boundary)
-- unwrap_counter: Counter -> Int   (extract the Int payload; named to avoid
-- colliding with Prelude's own unwrap — see
-- specs/plans/2026-08-13-prelude-entry-fn-name-collision.md)
-- Expected output: 42

mod NewtypeCounter do
  needs IO.Console
  type Counter = Counter(Int)

  fn bump(c) do
    match c do
    Counter(n) -> Counter(n + 1)
    end
  end

  fn unwrap_counter(c) do
    match c do
    Counter(n) -> n
    end
  end

  fn main(_cap_console : Cap(IO.Console)) do
    let c = Counter(41)
    println(int_to_string(unwrap_counter(bump(c))))
  end
end
