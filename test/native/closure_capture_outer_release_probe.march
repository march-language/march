-- Leak guard: a capturing lambda handed to a higher-order function is
-- released with everything it captured, whichever side does the releasing.
--
-- Two halves landed together
-- (specs/progress/2026-09-15-closure-captures-released-at-every-site.md):
--
--   1. The HOF's own loop. `List.map`/`List.filter` build an internal `go`
--      closure over the callback, and `go$apply` binds `$clo` to a local alias
--      it hands down the recursion. The release Perceus splices in
--      (`dec_rc $clo`) is therefore never the one that reaches zero -- the last
--      iteration's `dec_rc go` is -- so the deep drop keyed on the spliced
--      release never fired and the callback leaked once per `map` call.
--   2. The OUTER release. A HOF that drops its callback (`List.fold_left` ends
--      with `dec_rc f`) releases a closure VALUE, whose type names no layout.
--      That free was shallow, so a lambda's captures leaked once per call --
--      3 objects per iteration for `fn (a, b) -> a + b + List.length(ys)`.
--      The layout now comes from the apply-fn pointer the cell carries, via a
--      table the module registers at startup (lib/tir/clo_drops.ml).
--
-- Every leg prints the value it computed: a release that is too eager frees a
-- capture the closure still reads, which shows up as a wrong number (or a
-- crash) rather than as a leak. The golden must match the interpreter.
mod Main do
  needs IO.Console

  type Holder = Holder((Int) -> Int)

  pfn leg_map_capture(n : Int, k : Int, acc : Int) : Int do
    if n <= 0 do acc else
      let xs = List.map([int_to_string(n), "ab"], fn s -> string_length(s) + k)
      leg_map_capture(n - 1, k, acc + List.fold_left(xs, 0, fn (a, b) -> a + b))
    end
  end
  pfn leg_filter_capture(n : Int, k : Int, acc : Int) : Int do
    if n <= 0 do acc else
      let xs = List.filter([int_to_string(n), "ab"], fn s -> string_length(s) > k)
      leg_filter_capture(n - 1, k, acc + List.length(xs))
    end
  end
  -- The outer release: `step` is a closure VALUE the fold releases.
  pfn leg_local_closure(n : Int, acc : Int) : Int do
    if n <= 0 do acc else
      let ys = [n, n + 1]
      let step = fn (a, b) -> a + b + List.length(ys)
      leg_local_closure(n - 1, acc + List.fold_left(ys, 0, step))
    end
  end
  -- A closure that is never applied at all, just dropped.
  pfn leg_never_applied(n : Int, acc : Int) : Int do
    if n <= 0 do acc else
      let ys = [int_to_string(n), "z"]
      let f = fn (x : Int) -> x + List.length(ys)
      let v = if n % 2 == 0 do f(1) else 0 end
      leg_never_applied(n - 1, acc + v)
    end
  end
  -- A closure inside a constructor, released with the cell around it.
  pfn leg_in_ctor(n : Int, acc : Int) : Int do
    if n <= 0 do acc else
      let ys = [n, n, n]
      let h = Holder(fn x -> x + List.length(ys))
      let v = match h do Holder(g) -> g(n) end
      leg_in_ctor(n - 1, acc + v)
    end
  end
  -- A capture the closure reads on EVERY call: an over-eager release shows up
  -- as a wrong value on the second call, not as a leak.
  pfn leg_reused_capture(n : Int, acc : Int) : Int do
    if n <= 0 do acc else
      let ys = [int_to_string(n), "pq"]
      let f = fn (x : Int) -> x + string_length(List.fold_left(ys, "", fn (a, b) -> a ++ b))
      leg_reused_capture(n - 1, acc + f(1) + f(2))
    end
  end

  pfn flat(label : String, before : Int, r : Int) : () do
    let grew = live_allocs() - before
    println(label ++ " = " ++ int_to_string(r) ++ ", flat: " ++ bool_to_string(grew < 200))
  end

  fn main(_c : Cap(IO.Console)) do
    let n = 5000
    let a = live_allocs()
    flat("map over a capturing lambda", a, leg_map_capture(n, 3, 0))
    let b = live_allocs()
    flat("filter over a capturing lambda", b, leg_filter_capture(n, 1, 0))
    let c = live_allocs()
    flat("closure value released by the fold", c, leg_local_closure(n, 0))
    let d = live_allocs()
    flat("closure dropped unapplied", d, leg_never_applied(n, 0))
    let e = live_allocs()
    flat("closure inside a constructor", e, leg_in_ctor(n, 0))
    let f = live_allocs()
    flat("capture read on every call", f, leg_reused_capture(n, 0))
  end
end
