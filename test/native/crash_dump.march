-- MARCH_CRASH_DUMP (R7.4 of specs/plans/2026-09-28-observe-recon-shell-plan.md):
-- a supervised child panics three times (the crash ring now holds a
-- crash.loop), then main panics with nothing to catch it.  The unsupervised
-- panic path writes the dump to $MARCH_CRASH_DUMP before the process exits 1;
-- test/dune reads it back with `forge diagnose --from-dump` and
-- `forge observe --dump`.
mod Main do
  needs IO
  needs IO.Console
  needs IO.Clock

  actor Fragile do
    state { n : Int }
    init  { n: 0 }
    on Boom() do
      panic("dump-child-crash-xyzzy")
    end
  end

  actor Boss do
    state { c : Int }
    init  { c: 0 }
    supervise do
      strategy one_for_one
      max_restarts 10 within 60
      Fragile c
    end
  end

  fn current_child(intro, boss) do
    let pids = Actor.list(intro)
    match List.reverse(pids) do
      Cons(p, _) ->
        if to_string(p) == to_string(boss) do
          match pids do
            Cons(first, _) -> Some(first)
            Nil -> None
          end
        else
          Some(p)
        end
      Nil -> None
    end
  end

  fn crash_child(intro, boss, k : Int) do
    if k > 0 do
      match current_child(intro, boss) do
        Some(p) ->
          let _ = send(p, Boom())
          sleep_ms(300)
          crash_child(intro, boss, k - 1)
        None -> ()
      end
    else
      ()
    end
  end

  fn main(io : Cap(IO)) do
    let intro = Actor.introspect(io)
    let boss = spawn(Boss)
    let _r = Actor.register(boss, "boss")
    crash_child(intro, boss, 3)
    println("about to panic")
    panic("dump-main-panic-xyzzy")
  end
end
