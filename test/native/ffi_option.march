-- Regression: an FFI binding returning Option(Int) must produce the compiler's
-- niche representation (None=0, Some(x)=x), not a tagged heap cell.
mod Test do
  needs Ffi
  needs IO.Foreign
  extern "rt" : Cap(Ffi) do
    fn maybe(n: Int): Option(Int) = "ffi_test_maybe"
  end
  fn shown(o: Option(Int)) : String do
    match o do
      Some(v) -> int_to_string(v)
      None -> "none"
    end
  end
  fn main() : Unit do
    println(shown(maybe(7)))     -- Some(7) -> 7
    println(shown(maybe(0 - 1))) -- None    -> none
  end
end
