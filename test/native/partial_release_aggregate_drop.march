-- Leak guard: an owned record that one path of a branching expression
-- releases and another only reads must still be released on the reading
-- path.  Found by the TIR verifier's leak sweep (2026-10-12,
-- specs/progress/2026-10-12-verifier-leak-sweep.md); each leg leaked one
-- record per call, compiled only.
--
--   - a parameter read in a `let`'s if-value, released by the other arm,
--     while the rest of the body reads ANOTHER parameter
--     (ClusterNode.keeps_new);
--   - a record destructured in a TRMC'd map, whose panic default made the
--     drop give up on every path (Plot's render_legend).
-- Each leg prints the value it computed, so a use-after-free that changes a
-- result fails the golden, not just the flat check.
mod Main do
  needs IO.Console

  type St = { me : String, tag : String }
  type Ln = { node_id : String, dialer : String }
  type S = { label : Option(String), style : String }

  pfn keeps_new(st : St, l : Ln) : Bool do
    let lower = if st.me < l.node_id do st.me else l.node_id end
    l.dialer == lower
  end

  pfn mk_st(n : Int) : St do { me: int_to_string(n), tag: int_to_string(n * 3) } end
  pfn mk_ln(n : Int) : Ln do { node_id: int_to_string(n + 1), dialer: int_to_string(n) } end

  pfn param_leg(n : Int, acc : Int) : Int do
    if n <= 0 do acc else
      let k = if keeps_new(mk_st(n), mk_ln(n)) do 1 else 0 end
      param_leg(n - 1, acc + k)
    end
  end

  pfn labels(lst : List(S)) : List(String) do
    match lst do
      Nil -> Nil
      Cons(s, rest) ->
        match s.label do
          None -> labels(rest)
          Some(lbl) -> Cons(lbl ++ s.style, labels(rest))
        end
    end
  end

  pfn mk_list(n : Int, acc : List(S)) : List(S) do
    if n <= 0 do acc else
      let lab = if n % 2 == 0 do Some(int_to_string(n)) else None end
      mk_list(n - 1, Cons({ label: lab, style: int_to_string(n * 3) }, acc))
    end
  end

  pfn first_len(ls : List(String)) : Int do
    match ls do
      Nil -> 0
      Cons(h, _) -> string_length(h)
    end
  end

  pfn trmc_leg(n : Int, acc : Int) : Int do
    if n <= 0 do acc else
      let ls = labels(mk_list(20, Nil))
      trmc_leg(n - 1, acc + List.length(ls) + first_len(ls))
    end
  end

  pfn flat(label : String, before : Int, r : String) : () do
    let grew = live_allocs() - before
    println(label ++ " = " ++ r ++ ", flat: " ++ bool_to_string(grew < 200))
  end

  fn main(_c : Cap(IO.Console)) do
    let a = live_allocs()
    flat("parameter read in a let's if-value", a, int_to_string(param_leg(3000, 0)))
    let c = live_allocs()
    flat("record destructured in a TRMC map", c, int_to_string(trmc_leg(300, 0)))
  end
end
