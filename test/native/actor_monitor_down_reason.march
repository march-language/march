-- Failing witness for local monitor Down payloads.
-- The watcher consumes the monitor notification with receive() and requires
-- the three-field Down(ref, target, reason) shape for both exit paths.
mod ActorMonitorDownReason do
  needs IO.Console

  type DownReason = Normal | Killed | Crash(String)
  type Down(a) = Down(Int, a, DownReason)

  type Poison = Poison
  type ReadDown(a) = ReadDown(a, String)

  actor Worker do
    state { alive : Bool }
    init { alive: true }
    on Poison() do
      panic("bang")
    end
  end

  actor Watcher do
    state { seen : Int }
    init { seen: 0 }
    on ReadDown(expected, label) do
      match receive() do
        Down(ref, target, Crash(msg)) ->
          if target == expected do
            println("down ref=" ++ to_string(ref) ++ " target=" ++ label ++
                    " reason=Crash(" ++ msg ++ ")")
          else
            panic("crash Down target mismatch")
          end
        Down(ref, target, Killed) ->
          if target == expected do
            println("down ref=" ++ to_string(ref) ++ " target=" ++ label ++
                    " reason=Killed")
          else
            panic("kill Down target mismatch")
          end
        _ -> panic("Down wrong shape")
      end
      { seen: state.seen + 1 }
    end
  end

  fn main(_console : Cap(IO.Console)) do
    let watcher = spawn(Watcher)
    let crashed = spawn(Worker)
    monitor(watcher, crashed)
    send(crashed, Poison())
    send(watcher, ReadDown(crashed, "crashed"))

    let killed = spawn(Worker)
    monitor(watcher, killed)
    kill(killed)
    send(watcher, ReadDown(killed, "killed"))
    run_until_idle()
  end
end
