-- Regression: a primitive extern (Int args/return) is callable from the
-- tree-walking interpreter (no --compile) via dlopen + a fixed-arity
-- trampoline. ffi_test_dbl lives in runtime/march_ffi.c.
mod Test do
  needs IO.Console
  needs Ffi
  needs IO.Foreign
  extern "m" : Cap(Ffi) do
    fn dbl(n: Int): Int = "ffi_test_dbl"
  end
  fn main(_cap_console : Cap(IO.Console), _cap_foreign : Cap(IO.Foreign)) : Unit do
    println(int_to_string(dbl(21)))
    println(int_to_string(dbl(100)))
  end
end
