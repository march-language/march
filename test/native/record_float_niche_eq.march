-- Regression: record_get of a Float field must compare equal to a
-- constructed Some(Float) through native structural equality
-- (__march_eq_Option_Float). Before the fix, record_get's boxed Some(Float)
-- cell held raw bits instead of a march_alloc_float box, so
-- march_unbox_float on the record-read side read garbage and the equality
-- came back wrong (or crashed) even though both sides "are" 0.0.
mod Main do
  needs IO.Console
  fn main(_cap_console : Cap(IO.Console)) : Unit do
    let r = record_put(record_from_list([]), "ratio", 0.0)
    let v : Option(Float) = record_get(r, "ratio")
    println(bool_to_string(v == Some(0.0)))
  end
end
