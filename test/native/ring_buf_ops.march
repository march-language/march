-- Compiled RingBuf backend regression (runtime/march_runtime.c ring_buf_*),
-- threaded through the always_linear API (Part C, Phase C2): every operation
-- consumes the buffer and hands it back, readers return pairs, and each
-- buffer ends in to_list or drop. Exercises make -> push past capacity
-- (wraparound) -> pop -> get -> peek -> size -> cap -> snapshot -> clear ->
-- to_list, with both Int (immediate) and String (heap, RC-managed) elements.
-- Expected output equals the interpreter's (test/stdlib/test_ring_buf.march
-- asserts the same facts).
mod Main do
  needs IO.Console
  fn show_opt_int(o : Option(Int)) : String do
    match o do
      Some(v) -> "Some(" ++ int_to_string(v) ++ ")"
      None -> "None"
    end
  end

  fn show_opt_str(o : Option(String)) : String do
    match o do
      Some(v) -> "Some(" ++ v ++ ")"
      None -> "None"
    end
  end

  fn ints() : Unit do
    let rb = RingBuf.make(3)
    let (c, rb) = RingBuf.cap(rb)
    println("cap=" ++ int_to_string(c))
    let (e, rb) = RingBuf.is_empty(rb)
    println("empty=" ++ show(e))
    let rb = RingBuf.push(rb, 10)
    let rb = RingBuf.push(rb, 20)
    let rb = RingBuf.push(rb, 30)
    let (f, rb) = RingBuf.is_full(rb)
    println("full=" ++ show(f))
    -- odd value 7 exercises the erased-i64 tag round-trip
    let rb = RingBuf.push(rb, 7)
    let (xs, rb) = RingBuf.snapshot(rb)
    println("snapshot=[" ++ String.join(List.map(xs, fn x -> int_to_string(x)), ",") ++ "]")
    let (o, rb) = RingBuf.peek_oldest(rb)
    println("oldest=" ++ show_opt_int(o))
    let (n, rb) = RingBuf.peek_newest(rb)
    println("newest=" ++ show_opt_int(n))
    let (g0, rb) = RingBuf.get(rb, 0)
    println("get0=" ++ show_opt_int(g0))
    let (g2, rb) = RingBuf.get(rb, 2)
    println("get2=" ++ show_opt_int(g2))
    let (g9, rb) = RingBuf.get(rb, 9)
    println("get9=" ++ show_opt_int(g9))
    let (p, rb) = RingBuf.pop(rb)
    println("pop=" ++ show_opt_int(p))
    let (sz, rb) = RingBuf.size(rb)
    println("size=" ++ int_to_string(sz))
    let rb = RingBuf.clear(rb)
    let (sz2, rb) = RingBuf.size(rb)
    println("cleared=" ++ int_to_string(sz2))
    let rb = RingBuf.push(rb, 99)
    println("to_list=[" ++ String.join(List.map(RingBuf.to_list(rb), fn x -> int_to_string(x)), ",") ++ "]")
  end

  fn strs() : Unit do
    let rb = RingBuf.make(2)
    let rb = RingBuf.push(rb, "a")
    let rb = RingBuf.push(rb, "b")
    let rb = RingBuf.push(rb, "c" ++ "!")
    let (xs, rb) = RingBuf.snapshot(rb)
    println("str snapshot=" ++ String.join(xs, ","))
    let (p, rb) = RingBuf.pop(rb)
    println("str pop=" ++ show_opt_str(p))
    let (n, rb) = RingBuf.peek_newest(rb)
    println("str newest=" ++ show_opt_str(n))
    println("str to_list=" ++ String.join(RingBuf.to_list(rb), ","))
    -- a buffer whose contents are not needed ends in drop; its elements
    -- are released by the destructor
    let rb2 = RingBuf.push(RingBuf.make(1), "dropped" ++ "!")
    RingBuf.drop(rb2)
    println("dropped")
  end

  fn main(_cap_console : Cap(IO.Console)) : Unit do
    ints()
    strs()
  end
end
