-- stdlib Udp over loopback, compiled and interpreted against one golden:
-- a round trip and its source address, a 500-datagram batch arriving whole
-- and in order, mixed sizes in one batch (empty, 1 byte, 65000 bytes, and a
-- short tail inside an equal-sized run, which is what a GSO run splits on),
-- an oversize datagram refused, truncation to max_size, send_many to two
-- receivers, a connected socket, an ICMP port-unreachable surfacing as a
-- receive error, timeouts, IPv6, and SO_REUSEPORT shards.
mod UdpLoopback do
  needs IO
  needs IO.Console
  needs IO.NetConnect

  pfn sock(host : String) : UdpSocket do
    match Udp.open(host, 0) do
      Ok(s) -> s
      Err(e) -> panic(Udp.error_message(e))
    end
  end

  pfn addr_of(s : UdpSocket) : UdpAddr do
    match Udp.local_addr(s) do
      Ok(a) -> a
      Err(e) -> panic(Udp.error_message(e))
    end
  end

  pfn send_ok(r : Result(Int, UdpError)) : Int do
    match r do
      Ok(n) -> n
      Err(e) -> panic(Udp.error_message(e))
    end
  end

  pfn rev_onto(xs : List((UdpAddr, String)), acc : List((UdpAddr, String))) : List((UdpAddr, String)) do
    match xs do
      Nil -> acc
      Cons(x, rest) -> rev_onto(rest, Cons(x, acc))
    end
  end

  -- Receive until `want` datagrams or a quiet half second.
  pfn take(s : UdpSocket, want : Int, max_size : {Int | _ > 0 && _ <= 65535}, acc : List((UdpAddr, String))) : List((UdpAddr, String)) do
    if List.length(acc) >= want do List.reverse(acc)
    else
      match Udp.recv_batch(s, 64, max_size, 500) do
        Ok(Nil) -> List.reverse(acc)
        Ok(ds) -> take(s, want, max_size, rev_onto(ds, acc))
        Err(e) -> panic(Udp.error_message(e))
      end
    end
  end

  pfn payloads(ds : List((UdpAddr, String))) : List(String) do
    List.map(ds, fn d -> match d do (_, p) -> p end)
  end

  pfn in_order(ps : List(String), i : Int) : Bool do
    match ps do
      Nil -> true
      Cons(p, rest) -> if p == "seq-" ++ int_to_string(i) do in_order(rest, i + 1) else false end
    end
  end

  pfn sizes(ps : List(String)) : String do
    string_join(List.map(ps, fn p -> int_to_string(string_byte_length(p))), ",")
  end

  fn main(_cap : Cap(IO)) : () do
    let rx = sock("127.0.0.1")
    let tx = sock("127.0.0.1")
    let dst = addr_of(rx)
    Authority.ignore(println("bound port > 0: " ++ bool_to_string(Udp.addr_port(dst) > 0)))
    Authority.ignore(println("addr renders: " ++ bool_to_string(string_starts_with(Udp.addr_to_string(dst), "127.0.0.1:"))))

    -- round trip, and the source is tx's address
    let _ = send_ok(Udp.send_batch(tx, dst, ["hello"]))
    match Udp.recv(rx, 2048, 1000) do
      Ok(Some((from, data))) ->
        Authority.ignore(println("recv: " ++ data))
        Authority.ignore(println("from == tx: " ++ bool_to_string(from == addr_of(tx))))
      Ok(None) -> Authority.ignore(println("recv: timed out"))
      Err(e) -> Authority.ignore(println(Udp.error_message(e)))
    end

    -- a batch arrives whole and in order
    let batch = List.map(List.range(0, 500), fn i -> "seq-" ++ int_to_string(i))
    Authority.ignore(println("batch sent: " ++ int_to_string(send_ok(Udp.send_batch(tx, dst, batch)))))
    let got = payloads(take(rx, 500, 2048, []))
    Authority.ignore(println("batch received: " ++ int_to_string(List.length(got)) ++ ", in order: " ++ bool_to_string(in_order(got, 0))))

    -- mixed sizes, including empty and near the 64 KiB limit
    let mixed = [string_repeat("a", 700), string_repeat("b", 700), string_repeat("c", 300),
                 string_repeat("d", 700), "", "e", string_repeat("f", 65000), string_repeat("g", 5)]
    Authority.ignore(println("mixed sent: " ++ int_to_string(send_ok(Udp.send_batch(tx, dst, mixed)))))
    let back = payloads(take(rx, 8, 65535, []))
    Authority.ignore(println("mixed sizes: " ++ sizes(back)))
    Authority.ignore(println("mixed intact: " ++ bool_to_string(back == mixed)))

    -- oversize is refused, not truncated
    match Udp.send_to(tx, dst, string_repeat("z", 70000)) do
      Ok(_) -> Authority.ignore(println("oversize: sent?!"))
      Err(SendFailed(_)) -> Authority.ignore(println("oversize: SendFailed"))
      Err(e) -> Authority.ignore(println("oversize: " ++ Udp.error_message(e)))
    end

    -- truncation to max_size
    let _ = send_ok(Udp.send_batch(tx, dst, [string_repeat("t", 100)]))
    Authority.ignore(println("truncated to: " ++ sizes(payloads(take(rx, 1, 10, [])))))

    -- send_many: two destinations in one call
    let rx2 = sock("127.0.0.1")
    let dst2 = addr_of(rx2)
    let n = send_ok(Udp.send_many(tx, [(dst, "one"), (dst2, "two"), (dst2, "three"), (dst, "four")]))
    Authority.ignore(println("send_many sent: " ++ int_to_string(n)))
    Authority.ignore(println("rx got: " ++ string_join(payloads(take(rx, 2, 2048, [])), " ")))
    Authority.ignore(println("rx2 got: " ++ string_join(payloads(take(rx2, 2, 2048, [])), " ")))

    -- connected socket
    let c = sock("127.0.0.1")
    match Udp.connect(c, dst2) do
      Ok(_) -> ()
      Err(e) -> Authority.ignore(println(Udp.error_message(e)))
    end
    match Udp.send(c, "via connect") do
      Ok(_) -> ()
      Err(e) -> Authority.ignore(println(Udp.error_message(e)))
    end
    Authority.ignore(println("connected: " ++ string_join(payloads(take(rx2, 1, 2048, [])), " ")))

    -- a connected socket hears ICMP port-unreachable as an error
    let gone = sock("127.0.0.1")
    let gone_addr = addr_of(gone)
    Udp.close(gone)
    let lonely = sock("127.0.0.1")
    let _ = Udp.connect(lonely, gone_addr)
    let _ = Udp.send(lonely, "anyone?")
    match Udp.recv(lonely, 2048, 1000) do
      Err(RecvFailed(_)) -> Authority.ignore(println("unreachable peer: RecvFailed"))
      Ok(None) -> Authority.ignore(println("unreachable peer: silent"))
      Ok(Some(_)) -> Authority.ignore(println("unreachable peer: got data?!"))
      Err(e) -> Authority.ignore(println("unreachable peer: " ++ Udp.error_message(e)))
    end

    -- timeouts: 0 never waits, a quiet socket gives Ok([])
    match Udp.recv_batch(rx, 64, 2048, 0) do
      Ok(ds) -> Authority.ignore(println("poll empty: " ++ int_to_string(List.length(ds))))
      Err(e) -> Authority.ignore(println(Udp.error_message(e)))
    end
    match Udp.recv(rx, 2048, 50) do
      Ok(None) -> Authority.ignore(println("quiet recv: None"))
      _ -> Authority.ignore(println("quiet recv: unexpected"))
    end

    -- IPv6
    match Udp.open("::1", 0) do
      Err(e) -> Authority.ignore(println("ipv6: " ++ Udp.error_message(e)))
      Ok(r6) ->
        let t6 = sock("::1")
        let d6 = addr_of(r6)
        Authority.ignore(println("ipv6 addr renders: " ++ bool_to_string(string_starts_with(Udp.addr_to_string(d6), "[::1]:"))))
        let _ = send_ok(Udp.send_batch(t6, d6, ["six", "six again"]))
        Authority.ignore(println("ipv6 got: " ++ string_join(payloads(take(r6, 2, 2048, [])), " | ")))
        Udp.close(t6)
        Udp.close(r6)
    end

    -- shards share one port
    match Udp.open_sharded("127.0.0.1", 0, 3, Udp.defaults()) do
      Err(e) -> Authority.ignore(println("sharded: " ++ Udp.error_message(e)))
      Ok(shards) ->
        let ports = List.map(shards, fn s -> Udp.addr_port(addr_of(s)))
        let p0 = match ports do
          Cons(p, _) -> p
          Nil -> -1
        end
        Authority.ignore(println("shards: " ++ int_to_string(List.length(shards)) ++ ", one port: "
          ++ bool_to_string(List.all(ports, fn p -> p == p0))))
        List.map(shards, fn s -> Udp.close(s))
        ()
    end

    let st = Udp.stats(tx)
    Authority.ignore(println("send stalls counted: " ++ bool_to_string(st.tx_stalls >= 0)))
    Authority.ignore(println(Udp.error_message(ResolveFailed("nope"))))
    match Udp.resolve("", 9) do
      Err(ResolveFailed(_)) -> Authority.ignore(println("empty host: ResolveFailed"))
      _ -> Authority.ignore(println("empty host: unexpected"))
    end
    Udp.close(c)
    Udp.close(lonely)
    Udp.close(rx2)
    Udp.close(tx)
    Udp.close(rx)
  end
end
