-- FFI Float in generic slots: a `raises` Result(Float, String) (Ok payload
-- boxed via march_make_float), and Option(Float)/Option(Unit) returns built
-- with march_some_boxed (the niche form can't represent a 0-bit payload).
-- Uses exact-representable float equality to avoid float formatting.
mod Test do
  needs IO.Console
  needs Ffi
  needs IO.Foreign
  extern "rt" : Cap(Ffi) do
    raises fn fdiv(a: Float, b: Float): Result(Float, String) = "ffi_raise_fdiv"
    fn maybe_half(x: Float): Option(Float) = "ffi_maybe_half"
    fn maybe_unit(flag: Int): Option(Unit) = "ffi_maybe_unit"
  end
  fn shown(r: Result(Float, String)) : String do
    match r do
      Ok(f)  -> if f == 3.5 do "ok 3.5" else "ok ?" end
      Err(e) -> e
    end
  end
  fn show_half(o: Option(Float)) : String do
    match o do
      Some(f) -> if f == 4.5 do "some 4.5" else "some ?" end
      None    -> "none"
    end
  end
  fn show_unit(o: Option(Unit)) : String do
    match o do
      Some(_) -> "some"
      None    -> "none"
    end
  end
  fn main(_cap_console : Cap(IO.Console), _cap_foreign : Cap(IO.Foreign)) : Unit do
    println(shown(fdiv(7.0, 2.0)))         -- Ok(3.5)        -> ok 3.5
    println(shown(fdiv(1.0, 0.0)))         -- raised          -> div by zero
    println(show_half(maybe_half(9.0)))    -- Some(4.5)       -> some 4.5
    println(show_half(maybe_half(0.0 - 1.0)))  -- None        -> none
    println(show_unit(maybe_unit(1)))      -- Some(())        -> some
    println(show_unit(maybe_unit(0)))      -- None            -> none
  end
end
