-- Regression: Lower_state.resolve_iface_method must not silently pick a
-- first-registered impl when the callee's bare type name is ambiguous
-- (declared by >=2 modules). Companion to test/imports/speak_collision_native,
-- which structurally dodges this exact shape (each `speak` call there is
-- issued from INSIDE the impl's own declaring module). Here BOTH ambiguous
-- calls are visible together in a single function, on values built by a
-- same-shaped `mk()` helper in each module — the shape that exposed the bug:
-- pre-fix, lower.ml baked BOTH calls onto whichever impl was registered
-- first in the interface-method table, so both lines printed the same
-- string instead of dispatching each value to its own module's impl.
mod Top do
  needs IO.Console
  interface Speak(a) do
    fn speak : a -> String
  end
  mod NA do
    type Thing = TA
    impl Speak(Thing) do
      fn speak(_self) do "from-A" end
    end
    fn mk() do TA end
  end
  mod NB do
    type Thing = TB
    impl Speak(Thing) do
      fn speak(_self) do "from-B" end
    end
    fn mk() do TB end
  end
  fn main() do
    println(speak(NA.mk()))
    println(speak(NB.mk()))
  end
end
