-- Regression: record_put/record_get of a Float field, read back through a
-- STATICALLY TYPED annotation (Option(Float)), must round-trip natively.
--
-- runtime/march_extras.c's rec_box_some_float stored record_get's boxed
-- Some(Float) cell as raw IEEE-754 bits at offset 16 instead of a
-- march_alloc_float box behind a ptr slot (the convention every other Float
-- box, e.g. march_string_to_float, already follows). march_unbox_float then
-- dereferenced the raw bit pattern (0x3FE0000000000000 for 0.5) as a heap
-- pointer — SIGSEGV (depot's "Float type default in blank",
-- specs/progress/2026-08-20-record-put-get-float-niche-segfault.md). Fixed
-- alongside the ctor-field boxing sites in llvm_eq.ml/llvm_emit.ml.
mod Main do
  needs IO.Console
  fn main(_cap_console : Cap(IO.Console)) : Unit do
    let r = record_put(record_from_list([]), "y", 0.5)
    let v : Option(Float) = record_get(r, "y")
    match v do
    Some(f) -> println(to_string(f))
    None    -> println("MISS")
    end
  end
end
