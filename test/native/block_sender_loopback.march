-- `NodeQueue.BlockSender`: the caller blocks until credit admits the frame
-- (credit-based flow control, the last policy). Same topology as
-- credit_backpressure_loopback, budget 100 and 44-byte frames. The queue
-- holds ADMITTED-BUT-UNWRITTEN bytes and the initial credit lets the writer
-- put 100 on the wire at once, so frames 1-2 are written and 3-4 sit in the
-- queue (88 of 100); the fifth cannot be admitted until credit lets the
-- writer drain one. The receiver only starts consuming after a "go" that a
-- task sends 200 ms later; the fifth enqueue, under BlockSender(5000), must
-- therefore return Ok AFTER that, not at once -- witnessed by the wall clock.
-- Design: specs/progress/2026-09-15-credit-based-flow-control.md.
mod BlockSenderLoopback do
  needs IO.Console
  needs IO.Mut
  needs IO.NetListen
  needs IO.NetConnect
  needs IO.Random
  needs IO.Spawn
  needs IO.Process
  needs IO.Clock

  pfn secret() do "test-cluster-secret" end
  pfn node_a_id() do NodeIdentity.make("node-a", "pk-a", 1) end
  pfn node_b_id() do NodeIdentity.make("node-b", "pk-b", 1) end
  pfn budget() : Int do 100 end

  pfn frame() : Bytes do
    Bytes.from_list(NetFrame.encode(List.map(Range.to_list(Range.new(0, 40)), fn _ -> 120)))
  end

  pfn read_n(data_fd : Int, control_fd : Int, buf : List(Int), n : Int, got : Int) : Int do
    if n <= 0 do got
    else
      match NetKernel.recv_frame(data_fd, buf) do
        Err(_) -> got
        Ok((fr, rest)) ->
          let _ = NodeQueue.consumed(control_fd, budget(), List.length(fr) + 4)
          read_n(data_fd, control_fd, rest, n - 1, got + 1)
      end
    end
  end

  pfn run_node_b(listen_fd : Int) : Int do
    match ClusterConn.accept_split(PeerRegistry.empty(), listen_fd, node_b_id(), secret()) do
      Err(e) -> panic("node-b accept: " ++ e)
      Ok((_reg, peer)) ->
        let _ = NetKernel.recv_frame(peer.fd, Nil)   -- the "go"
        let got = read_n(peer.data_fd, peer.fd, Nil, 5, 0)
        tcp_close(peer.data_fd)
        tcp_close(peer.fd)
        tcp_close(listen_fd)
        got
    end
  end

  pfn on_control(q, tag : Int, fr : List(Int)) : Result(Bool, String) do
    if tag == NodeQueue.tag_credit() do
      match NodeQueue.decode_credit(fr) do
        Ok(total) ->
          NodeQueue.credit(q, total)
          Ok(total < 220)
        Err(e) -> Err(e)
      end
    else
      Err("unexpected tag " ++ int_to_string(tag))
    end
  end

  -- Poll (10 ms steps, [attempts] tries) until the queue's admitted-but-
  -- unwritten depth reads [want]; same helper as credit_backpressure_loopback.
  pfn wait_depth(q, want : Int, attempts : Int) : Bool do
    if NodeQueue.depth(q) == want do true
    else if attempts <= 0 do false
    else
      let _ = Process.run("sleep", Cons("0.01", Nil))
      wait_depth(q, want, attempts - 1)
    end end
  end

  fn main(_cap_console : Cap(IO.Console), _cap_netconnect : Cap(IO.NetConnect), _cap_netlisten : Cap(IO.NetListen), _cap_random : Cap(IO.Random), _cap_spawn : Cap(IO.Spawn), _cap_mut : Cap(IO.Mut), _cap_process : Cap(IO.Process), _cap_clock : Cap(IO.Clock)) do
    let listen_fd = match tcp_listen(0) do
      Ok(fd) -> fd
      Err(e) -> panic("listen: " ++ e)
    end
    let port = match tcp_local_port(listen_fd) do
      Ok(p) -> p
      Err(e) -> panic("local_port: " ++ e)
    end
    let srv = task_spawn(fn _ -> run_node_b(listen_fd))
    let peer = match ClusterConn.connect_split(PeerRegistry.empty(), "127.0.0.1", port, node_a_id(), secret()) do
      Err(e) -> panic("node-a connect: " ++ e)
      Ok((_reg, p)) -> p
    end
    let q = NodeQueue.start(peer.data_fd, budget())
    let r1 = NodeQueue.enqueue(q, 1, frame(), NodeQueue.DropNew)
    let r2 = NodeQueue.enqueue(q, 2, frame(), NodeQueue.DropNew)
    println("node-a: two frames admitted: " ++ bool_to_string(r1 == Ok(()) && r2 == Ok(())))
    -- Wait for the writer to put those two on the wire (initial credit
    -- covers 100), so depth is 0 and frames 3-4 both fit the budget. Poll the
    -- observable state rather than sleeping a fixed time: under load the
    -- writer can take longer than any fixed pause. Not run_until_idle: the
    -- receiver task is parked in accept, and that call never returns while
    -- any task is parked in a socket read.
    if wait_depth(q, 0, 500) do ()
    else panic("node-a: writer never wrote frames 1-2 under the initial credit (depth " ++ int_to_string(NodeQueue.depth(q)) ++ " after 5 s)")
    end
    let r3 = NodeQueue.enqueue(q, 3, frame(), NodeQueue.DropNew)
    let r4 = NodeQueue.enqueue(q, 4, frame(), NodeQueue.DropNew)
    println("node-a: two more queued behind the credit line: " ++ bool_to_string(r3 == Ok(()) && r4 == Ok(())))
    let ctl = task_spawn(fn _ -> match PeerReader.serve(peer.fd, Nil, fn (tag, fr) -> on_control(q, tag, fr)) do
      Ok(_) -> 0
      Err(e) -> panic("control reader: " ++ e)
    end)
    -- The receiver gets its "go" only after 200 ms.
    let go = task_spawn(fn _ -> do
      let _ = Process.run("sleep", Cons("0.2", Nil))
      let _ = NetKernel.send_frame(peer.fd, SwimDriver.encode_msg(SwimDriver.SwimPing("node-a")))
      0
    end)
    let t0 = unix_time_ms()
    let r5 = NodeQueue.enqueue(q, 5, frame(), NodeQueue.BlockSender(5000))
    let waited = unix_time_ms() - t0
    println("node-a: fifth admitted by blocking: " ++ bool_to_string(r5 == Ok(())))
    println("node-a: blocked until credit (>= 150 ms): " ++ bool_to_string(waited >= 150))
    let _ = task_await(go)
    let _ = task_await(ctl)
    let got = match task_await(srv) do
      Ok(n) -> n
      Err(e) -> panic("node-b: " ++ e)
    end
    println("node-b: consumed " ++ int_to_string(got) ++ " frames")
    tcp_close(peer.fd)
    tcp_close(peer.data_fd)
  end
end
