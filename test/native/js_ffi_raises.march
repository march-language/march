-- Regression: a `raises` extern wraps JS throw into Err, normal return into Ok.
-- Helper: test/native/js_ffi_raises_helper.mjs exports parseNum (throws on NaN).
mod JsFfiRaises do
  needs IO.Console
  needs IO.Foreign

  extern "./js_ffi_raises_helper.mjs" : Cap(IO.Foreign) do
    raises fn parseNum(s: String) : Result(Int, String)
  end

  fn shown(r: Result(Int, String)) : String do
    match r do
      Ok(n)  -> int_to_string(n)
      Err(e) -> "error: " ++ e
    end
  end

  fn main() : Unit do
    println(shown(parseNum("42")))
    println(shown(parseNum("bad")))
  end
end
