-- Uses LazyNicheProbe (a stdlib module NOT in stdlib_file_list), forcing the
-- lazy-load path.  Before the emit_case niche-recovery fix this segfaulted.
mod LazyNiche do
  needs IO.Console
  fn main() do
    println(String.from_int(LazyNicheProbe.first_or(Cons(42, Cons(7, Nil)), 0)))
    println(String.from_int(LazyNicheProbe.first_or(Nil, 99)))
  end
end
