mod InProcess do
  -- `Session.in_process()`, the stdlib's network-free transport: a whole
  -- session, a role leaving (its peer's cancel handler runs), a message the
  -- receiver cannot decode (`Session.fail` cancels it), a delivery parked
  -- until the continuation that wants it is installed, and a role that
  -- crashes (the waiting peer takes its `or crash` branch).
  --
  -- TWO `@[endpoints]` protocols in ONE module, each running its own
  -- sessions: that is the regression this fixture pins.  Until
  -- 2026-09-22 both generated message types were called `Msg`, whose SHORT
  -- name is what impl dispatch for the derived `Json` codec keys on, so
  -- `Stream`'s first send encoded through `Logging`'s `to_json` -- a match
  -- failure interpreted, and a hard "ambiguous interface-method call to
  -- `JsonFrom$Msg.from_json`" compiled.  The generated type is now
  -- `<P>_Message`.  This file was split in two for exactly that reason;
  -- see the record dated 2026-09-22 under specs/progress/.
  --
  -- Run on BOTH backends against this one golden, because the bug's
  -- signature was the two backends DISAGREEING.
  -- One transport per session; the indented `transport:` lines come from
  -- `in_process_with`.
  needs IO
  needs IO.Console
  needs IO.Mut
  needs Session.Live

  @[endpoints]
  protocol Stream do
    loop do
      Prod -> Cons : Int
      choose by Cons:
        more -> Cons -> Prod : Bool
        done -> Cons -> Prod : Bool
                stop
      end
    end
  end

  @[endpoints]
  protocol Logging do
    may crash C
    L -> I : Int
    C -> I : String
      or crash do
        I -> L : String
      end
    I -> L : String
    L -> I : Bool
    I -> C : Bool
  end

  pfn traced() : Session.InProcess do
    Session.in_process_with(fn line -> print_line("  transport: " ++ line))
  end

  -- ── Stream roles ────────────────────────────────────────────────────────
  pfn prod(s : Cap(Session.Live), st : Stream_Prod.S_send_Msg_Prod_Cons_1, next : Int) : Stream_Prod.Yield do
    print_line("Prod sends Item(" ++ int_to_string(next) ++ ")")
    let st1 = Stream_Prod.send_Msg_Prod_Cons_1(s, st, next)
    Stream_Prod.offer_more_done(s, st1,
      fn (_b, st2) ->
        print_line("Prod got More")
        prod(s, st2, next + 1),
      fn (_b, st2) ->
        print_line("Prod got Done")
        Stream_Prod.close(s, st2))
  end

  -- Cons with a cancel handler on every receive.
  pfn cons(s : Cap(Session.Live), st : Stream_Cons.S_recv_Msg_Prod_Cons_1, budget : Int) : Stream_Cons.Yield do
    Stream_Cons.recv_Msg_Prod_Cons_1_or(s, st,
      fn (n, st1) ->
        print_line("Cons got Item(" ++ int_to_string(n) ++ ")")
        if budget > 1 do
          cons(s, Stream_Cons.choose_more(s, st1, true), budget - 1)
        else
          Stream_Cons.close(s, Stream_Cons.choose_done(s, st1, true))
        end,
      fn (role, cause, c) ->
        print_line("Cons cancelled by role " ++ int_to_string(role) ++ ": " ++ cause)
        Stream_Cons.cancelled(s, c))
  end

  -- ── Logging roles (as test/session/logging_crash.march) ────────────────
  pfn role_l(s : Cap(Session.Live), st : Logging_L.S_send_Msg_L_I_1) : Logging_L.Yield do
    print_line("L sends Trigger")
    let st1 = Logging_L.send_Msg_L_I_1(s, st, 1)
    Logging_L.offer_Msg_I_L_2_Msg_I_L_1(s, st1,
      fn (read, st2) ->
        print_line("L got Read(" ++ read ++ ")")
        Logging_L.close(s, Logging_L.send_Msg_L_I_2(s, st2, true)),
      fn (fatal, st2) ->
        print_line("L got Fatal(" ++ fatal ++ ")")
        Logging_L.close(s, st2))
  end

  pfn role_i(s : Cap(Session.Live), st : Logging_I.S_recv_Msg_L_I_1) : Logging_I.Yield do
    Logging_I.recv_Msg_L_I_1(s, st, fn (_trigger, st1) ->
      print_line("I got Trigger")
      Logging_I.recv_Msg_C_I_1(s, st1,
        fn (read, st2) ->
          print_line("I got Read(" ++ read ++ ")")
          let st3 = Logging_I.send_Msg_I_L_2(s, st2, read)
          Logging_I.recv_Msg_L_I_2(s, st3, fn (report, st4) ->
            print_line("I got Report(" ++ bool_to_string(report) ++ ")")
            Logging_I.close(s, Logging_I.send_Msg_I_C_1(s, st4, report))),
        fn (crashed, st2) ->
          print_line("I: role " ++ int_to_string(crashed.role) ++ " crashed: " ++ crashed.cause)
          Logging_I.close(s, Logging_I.send_Msg_I_L_1(s, st2, "C is gone"))))
  end

  pfn role_c(s : Cap(Session.Live), st : Logging_C.S_send_Msg_C_I_1) : Logging_C.Yield do
    print_line("C sends Read")
    let st1 = Logging_C.send_Msg_C_I_1(s, st, "disk 42%")
    Logging_C.recv_Msg_I_C_1(s, st1, fn (report, st2) ->
      print_line("C got Report(" ++ bool_to_string(report) ++ ")")
      Logging_C.close(s, st2))
  end

  fn main(c : Cap(IO)) do
    print_line("-- a whole session")
    let t1 = traced()
    let s1 = Session.attach(c, t1.ops)
    let _ = cons(s1, Stream_Cons.register(s1, 0), 2)
    let _ = prod(s1, Stream_Prod.register(s1, 0), 1)
    t1.drain(())
    print_line("queued after: " ++ int_to_string(t1.queued(())))

    print_line("-- Prod leaves")
    let t2 = traced()
    let s2 = Session.attach(c, t2.ops)
    let _ = cons(s2, Stream_Cons.register(s2, 0), 2)
    let _ = Stream_Prod.leave_send_Msg_Prod_Cons_1(s2, Stream_Prod.register(s2, 0), "nothing to send")
    t2.drain(())

    print_line("-- Prod sends bytes that do not decode")
    let t3 = traced()
    let s3 = Session.attach(c, t3.ops)
    let _ = cons(s3, Stream_Cons.register(s3, 0), 2)
    let raw = Session.register(s3, 0, Stream_Msg.role_Prod())
    let _ = Session.emit(s3, raw, Stream_Msg.role_Cons(), Bytes.from_string("not a message"))
    t3.drain(())

    print_line("-- C's Read is queued before L's Trigger")
    let t5 = traced()
    let s5 = Session.attach(c, t5.ops)
    let i5 = Logging_I.register(s5, 0)
    let c5 = Logging_C.register(s5, 0)
    let l5 = Logging_L.register(s5, 0)
    -- I waits on L first: C's Read is parked until I's next receive wants it.
    let _ = role_c(s5, c5)
    let _ = role_l(s5, l5)
    let _ = role_i(s5, i5)
    t5.drain(())

    print_line("-- C crashes before sending")
    let t4 = traced()
    let s4 = Session.attach(c, t4.ops)
    -- The order the roles start in does not matter: I waits on L first, and
    -- a delivery from anyone else is parked until it does.
    let _ = role_i(s4, Logging_I.register(s4, 0))
    let _ = role_l(s4, Logging_L.register(s4, 0))
    t4.crash(Logging_Msg.role_C(), "node down")
    t4.drain(())
  end
end
