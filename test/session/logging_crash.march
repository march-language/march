mod LoggingCrash do
  -- Crash branches, in one process (design Part B, 2026-09-20): the ECOOP
  -- logging protocol with C declared `may crash`.  The transport is the
  -- stdlib's `Session.in_process`: `on_crash` records the crash continuation
  -- a receive installs, and `drain`, once nothing queued can be delivered,
  -- runs it for an endpoint waiting on a role that is gone -- what
  -- `SessionNode.check_waiting` does on a real network when the connection
  -- to that role has closed with nothing queued from it.
  --
  -- The program runs the round twice.  First C is alive: L triggers, C
  -- sends Read, I forwards it to L, L reports, I answers C, everyone closes.
  -- Then C "crashes": its body never runs and `crash` marks role 3
  -- gone, so I's `recv_Msg_C_I_1` takes its crash callback with a LIVE
  -- state, sends L the Fatal, and both close normally.  Messages to a gone
  -- role are dropped by `emit`, as `SessionNode` drops them.
  needs IO
  needs IO.Console
  needs IO.Mut
  needs Session.Live

  @[endpoints]
  protocol Logging do
    may crash C
    L -> I : Int
    C -> I : String
      or crash do
        I -> L : String
      end
    I -> L : String
    L -> I : Bool
    I -> C : Bool
  end

  -- ── the roles ───────────────────────────────────────────────────────────
  pfn role_l(s : Cap(Session.Live), st : Logging_L.S_send_Msg_L_I_1) : Logging_L.Yield do
    print_line("L sends Trigger")
    let st1 = Logging_L.send_Msg_L_I_1(s, st, 1)
    Logging_L.offer_Msg_I_L_2_Msg_I_L_1(s, st1,
      fn (read, st2) ->
        print_line("L got Read(" ++ read ++ ")")
        Logging_L.close(s, Logging_L.send_Msg_L_I_2(s, st2, true)),
      fn (fatal, st2) ->
        print_line("L got Fatal(" ++ fatal ++ ")")
        Logging_L.close(s, st2))
  end

  pfn role_i(s : Cap(Session.Live), st : Logging_I.S_recv_Msg_L_I_1) : Logging_I.Yield do
    Logging_I.recv_Msg_L_I_1(s, st, fn (_trigger, st1) ->
      print_line("I got Trigger")
      Logging_I.recv_Msg_C_I_1(s, st1,
        fn (read, st2) ->
          print_line("I got Read(" ++ read ++ ")")
          let st3 = Logging_I.send_Msg_I_L_2(s, st2, read)
          Logging_I.recv_Msg_L_I_2(s, st3, fn (report, st4) ->
            print_line("I got Report(" ++ bool_to_string(report) ++ ")")
            Logging_I.close(s, Logging_I.send_Msg_I_C_1(s, st4, report))),
        fn (crashed, st2) ->
          print_line("I: role " ++ int_to_string(crashed.role) ++ " crashed: " ++ crashed.cause)
          Logging_I.close(s, Logging_I.send_Msg_I_L_1(s, st2, "C is gone"))))
  end

  pfn role_c(s : Cap(Session.Live), st : Logging_C.S_send_Msg_C_I_1) : Logging_C.Yield do
    print_line("C sends Read")
    let st1 = Logging_C.send_Msg_C_I_1(s, st, "disk 42%")
    Logging_C.recv_Msg_I_C_1(s, st1, fn (report, st2) ->
      print_line("C got Report(" ++ bool_to_string(report) ++ ")")
      Logging_C.close(s, st2))
  end

  fn main(c : Cap(IO)) do
    print_line("-- round 1: C is alive")
    let t1 = Session.in_process_with(fn line -> print_line("transport: " ++ line))
    let s1 = Session.attach(c, t1.ops)
    let i1 = Logging_I.register(s1, 0)
    let c1 = Logging_C.register(s1, 0)
    let l1 = Logging_L.register(s1, 0)
    let _ = role_l(s1, l1)
    let _ = role_i(s1, i1)
    let _ = role_c(s1, c1)
    t1.drain(())
    print_line("-- round 2: C has crashed")
    let t2 = Session.in_process_with(fn line -> print_line("transport: " ++ line))
    let s2 = Session.attach(c, t2.ops)
    let i2 = Logging_I.register(s2, 0)
    let l2 = Logging_L.register(s2, 0)
    t2.crash(Logging_Msg.role_C(), "connection lost")
    let _ = role_l(s2, l2)
    let _ = role_i(s2, i2)
    t2.drain(())
  end
end
