-- Golden failure report for a plain (non-derived-Show) record
-- (test/run_test_reports.ml).  Its own file so it can sit in [js_unsupported]
-- (`to_string` on a record without Show has no JS mapping) without taking
-- assert_values' JS coverage with it.  The #1171 helper collision is fixed.
mod AssertRecords do
  type Point = { x : Int, y : Int }
  derive Eq for Point

  test "plain record field" do
    let p : Point = { x: 1, y: 2 }
    assert (p == { x: 1, y: 3 })
  end
end
