## describe
fn describe(pair : (Int, Int)) : String =
  case pair of
  $Tuple2($f1, $f2) -> case $f1 of
  0() -> case $f2 of
  0() -> "origin"
  _ -> let y : Int = $f2 in
let x : Int = $f1 in
"point"
  _ -> let y : Int = $f2 in
let x : Int = $f1 in
"point"
  _ -> panic("non-exhaustive pattern match")

## main
fn main() : () =
  let $t2 : String = let $t1 : (Int, Int) = (0, 0) in
describe($t1) in
println($t2);
let $t4 : String = let $t3 : Atom = :ok in
tag_name($t3) in
println($t4);
let $t5 : Int = word("yes") in
println($t5)

## tag_name
fn tag_name(t : Atom) : String =
  case t of
  :ok() -> "okay"
  :err() -> "error"
  _ -> "unknown"

## word
fn word(s : String) : Int =
  case s of
  "yes"() -> 1
  "no"() -> 0
  _ -> negate(1)

