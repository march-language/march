## tag_name
fn tag_name(t : Atom) : String =
  case t of
  :ok() -> "okay"
  :err() -> "error"
  _ -> "unknown"

## word
fn word(s : String) : Int =
  case s of
  "yes"() -> 1
  "no"() -> 0
  _ -> negate(1)

