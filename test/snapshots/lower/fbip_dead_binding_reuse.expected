## bump_head
fn bump_head(xs : List(Int)) : List(Int) =
  case xs of
  Cons($f2, $f3) -> let t : List(Int) = $f3 in
let h : Int = $f2 in
let $t1 : Int = +(h, 1) in
alloc List.Cons($t1, t)
  Nil() -> alloc List.Nil(Int)()
  _ -> panic("non-exhaustive pattern match")

## main
fn main(_cap_console : Cap(IO.Console)) : () =
  let $t3 : List(Int) = let $t2 : List(Int) = let $t1 : List(Int) = alloc List.Nil(Int)() in
alloc List.Cons(1, $t1) in
bump_head($t2) in
case $t3 of
  Cons($f4, $f5) -> let h : Int = $f4 in
println(h)
  Nil() -> println(0)
  _ -> panic("non-exhaustive pattern match")

