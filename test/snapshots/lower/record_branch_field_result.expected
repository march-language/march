-- types (1) --
record Rel { seq : Int, signature : String }
-- fns (3) --
## main
fn main() : () =
  let $t4 : String = let $t3 : { seq : Int, signature : String } = let $t2 : String = let $t1 : String = int_to_string(1) in
++("s", $t1) in
{ seq = 1, signature = $t2 } in
ser($t3) in
println($t4);
let $t6 : String = let $t5 : { seq : Int, signature : String } = { seq = 2, signature = "" } in
sig_of($t5) in
println($t6)

## ser
fn ser(r : { seq : Int, signature : String }) : String =
  let $t3 : String = let $t2 : Bool = let $t1 : String = r.signature in
==($t1, "") in
case $t2 of
  True() -> "-"
  _ -> r.signature in
++("sig ", $t3)

## sig_of
fn sig_of(r : { seq : Int, signature : String }) : String =
  let $t2 : Bool = let $t1 : String = r.signature in
==($t1, "") in
case $t2 of
  True() -> "-"
  _ -> r.signature

