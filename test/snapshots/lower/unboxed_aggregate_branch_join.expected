-- types (1) --
type P2 = P2(Float, Float)
-- fns (3) --
## main
fn main() : () =
  let $t2 : String = let $t1 : Float = spin(10, 0.) in
float_to_string($t1) in
println($t2)

## psum
fn psum(p : P2) : Float =
  case p of
  P2($f1, $f2) -> let b : Float = $f2 in
let a : Float = $f1 in
+.(a, b)
  _ -> panic("non-exhaustive pattern match")

## spin
fn spin(i : Int, acc : Float) : Float =
  let $t1 : Bool = ==(i, 0) in
case $t1 of
  True() -> acc
  _ -> let p : P2 = let $t3 : Bool = let $t2 : Int = %(i, 2) in
==($t2, 0) in
case $t3 of
  True() -> alloc P2.P2(1., 2.)
  _ -> alloc P2.P2(3., 4.) in
let $t4 : Int = -(i, 1) in
let $t6 : Float = let $t5 : Float = psum(p) in
+.(acc, $t5) in
spin($t4, $t6)

