## both
fn both(owned : String, borrowed : String, n : Int) : String =
  let $t1 : Bool = >(n, 0) in
case $t1 of
  True() -> owned
  _ -> borrowed

## main
fn main(_cap_console : Cap(IO.Console)) : () =
  let s : String = "shared" in
let $t2 : String = both(s, s, 1) in
println($t2)

