## main
fn main() : () =
  let $t2 : Int = let $t1 : Option(Int) = alloc Option.Some(7) in
unwrap_or_die($t1) in
println($t2)

## unwrap_or_die
fn unwrap_or_die(o : Option(Int)) : Int =
  case o of
  Some($f1) -> let x : Int = $f1 in
x
  None() -> 0
  _ -> panic("non-exhaustive pattern match")

