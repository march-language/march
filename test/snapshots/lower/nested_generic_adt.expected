## head_opt
fn head_opt(xs : List(Int)) : Option(Int) =
  case xs of
  Cons($f1, $f2) -> let h : Int = $f1 in
alloc Option.Some(h)
  Nil() -> alloc Option.None(Int)()
  _ -> panic("non-exhaustive pattern match")

## main
fn main(_cap_console : Cap(IO.Console)) : () =
  let $t3 : Option(Int) = let $t2 : List(Int) = let $t1 : List(Int) = alloc List.Nil(Int)() in
alloc List.Cons(3, $t1) in
head_opt($t2) in
case $t3 of
  Some($f4) -> let v : Int = $f4 in
println(v)
  None() -> println(0)
