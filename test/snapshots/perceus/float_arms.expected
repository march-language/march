-- fns (2) --
## describe
fn describe(x : Float) : String =
  case x of
  #0x0p+0() -> "zero"
  #0x1.8p+0() -> "one-half-more"
  _ -> "other"

## main
fn main(_cap_console : Cap(IO.Console)) : () =
  let $t1 : String = describe(1.5) in
let $rc_1 : () = println($t1) in
dec_rc $t1;
$rc_1

