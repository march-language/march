## describe
fn describe(pair : (Int, Int)) : String =
  case pair of
  $Tuple2($f1, $f2) -> dec_rc pair;
case $f1 of
  0() -> case $f2 of
  0() -> dec_rc $f2;
dec_rc $f1;
"origin"
  _ -> let y : Int = $f2 in
let x : Int = $f1 in
"point"
  _ -> let y : Int = $f2 in
let x : Int = $f1 in
"point"
  _ -> dec_rc pair;
panic("non-exhaustive pattern match")

## main
fn main() : () =
  let $t2 : String = let $t1 : (Int, Int) = (0, 0) in
describe($t1) in
let $rc_3 : () = println($t2) in
dec_rc $t2;
$rc_3;
let $t4 : String = let $t3 : Atom = :ok in
let $rc_2 : String = tag_name($t3) in
dec_rc $t3;
$rc_2 in
let $rc_1 : () = println($t4) in
dec_rc $t4;
$rc_1;
let $t5 : Int = word("yes") in
println($t5)

## tag_name
fn tag_name(t : Atom) : String =
  case t of
  :ok() -> "okay"
  :err() -> "error"
  _ -> "unknown"

## word
fn word(s : String) : Int =
  case s of
  "yes"() -> 1
  "no"() -> 0
  _ -> negate(1)

