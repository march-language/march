-- types (2) --
type Box = Box(String, String)
type Raw = Raw(String, Int, String)
-- fns (4) --
## from_ctor
fn from_ctor(r : Raw) : Box =
  case r of
  Raw($f2, $f3, $f4) -> dec_rc r;
let c : String = $f4 in
let n : Int = $f3 in
let a : String = $f2 in
let $t1 : Box = alloc Box.Box(a, c) in
keep($t1)
  _ -> dec_rc r;
panic("non-exhaustive pattern match")

## from_tuple
fn from_tuple(t : (String, Int, String)) : Box =
  case t of
  $Tuple3($f2, $f3, $f4) -> dec_rc t;
let c : String = $f4 in
let n : Int = $f3 in
let a : String = $f2 in
let $t1 : Box = alloc Box.Box(a, c) in
keep($t1)
  _ -> dec_rc t;
panic("non-exhaustive pattern match")

## keep
fn keep(b : Box) : Box =
  b

## main
fn main(_c : Cap(IO.Console)) : () =
  let $p4 : Box = let $t1 : (String, Int, String) = ("a", 1, "b") in
from_tuple($t1) in
dec_rc $p4;
let $p3 : Box = let $t2 : Raw = alloc Raw.Raw("a", 1, "b") in
from_ctor($t2) in
dec_rc $p3;
println("done")

