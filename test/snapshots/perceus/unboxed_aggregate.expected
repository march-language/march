-- types (1) --
type Vec3 = Vec3(Float, Float, Float)
-- fns (3) --
## dot
fn dot(a : Vec3, b : Vec3) : Float =
  case a of
  Vec3($f12, $f13, $f14) -> let az : Float = $f14 in
let ay : Float = $f13 in
let ax : Float = $f12 in
case b of
  Vec3($f5, $f6, $f7) -> let bz : Float = $f7 in
let b2 : Float = $f6 in
let bx : Float = $f5 in
let $t3 : Float = let $t1 : Float = *.(ax, bx) in
let $t2 : Float = *.(ay, b2) in
+.($t1, $t2) in
let $t4 : Float = *.(az, bz) in
+.($t3, $t4)
  _ -> panic("non-exhaustive pattern match")
  _ -> panic("non-exhaustive pattern match")

## forward
fn forward(yaw : Float, pitch : Float) : Vec3 =
  let cp : Float = *.(pitch, 2.) in
let $t2 : Float = let $t1 : Float = *.(yaw, cp) in
-.(0., $t1) in
let $t3 : Float = -.(0., cp) in
alloc Vec3.Vec3($t2, pitch, $t3)

## main
fn main() : () =
  let v : Vec3 = forward(0.5, 0.25) in
let $t2 : String = let $t1 : Float = dot(v, v) in
float_to_string($t1) in
let $rc_1 : () = println($t2) in
dec_rc $t2;
$rc_1

