## both
fn both(owned : String, borrowed : String, n : Int) : String =
  let $t1 : Bool = >(n, 0) in
case $t1 of
  True() -> dec_rc borrowed;
owned
  _ -> dec_rc owned;
borrowed

## main
fn main(_cap_console : Cap(IO.Console)) : () =
  let s : String = "shared" in
let $t1 : String = inc_rc s;
both(s, s, 1) in
let $rc_1 : () = println($t1) in
dec_rc $t1;
$rc_1

