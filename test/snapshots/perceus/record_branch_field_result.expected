## main
fn main() : () =
  let $t4 : String = let $t3 : { seq : Int, signature : String } = let $t2 : String = let $t1 : String = int_to_string(1) in
let $rc_8 : '_ = ++("s", $t1) in
dec_rc $t1;
$rc_8 in
{ seq = 1, signature = $t2 } in
