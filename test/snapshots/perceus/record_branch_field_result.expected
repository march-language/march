## ser
fn ser(r : { seq : Int, signature : String }) : String =
  let $t3 : String = let $t2 : Bool = let $t1 : String = r.signature in
==($t1, "") in
case $t2 of
  True() -> "-"
  _ -> let $rc_1 : String = r.signature in
inc_rc $rc_1;
$rc_1 in
let $rc_2 : '_ = ++("sig ", $t3) in
dec_rc $t3;
$rc_2

## sig_of
fn sig_of(r : { seq : Int, signature : String }) : String =
  let $t2 : Bool = let $t1 : String = r.signature in
==($t1, "") in
case $t2 of
  True() -> "-"
  _ -> let $rc_3 : String = r.signature in
inc_rc $rc_3;
$rc_3

