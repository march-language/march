-- types (1) --
record Point { x : Int, y : Int }
-- fns (2) --
## main
fn main() : () =
  let p : { x : Int, y : Int } = { x = 1, y = 2 } in
let moved : { x : Int, y : Int } = move_right(p) in
let $t3 : Int = moved.x in
println($t3)

## move_right
fn move_right(p : { x : Int, y : Int }) : { x : Int, y : Int } =
  let $t2 : Int = let $t1 : Int = p.x in
+($t1, 1) in
{ p with x = $t2 }

