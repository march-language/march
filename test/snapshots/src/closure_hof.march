-- Closure capture + higher-order function: pins defunctionalization output
-- ($Clo_ / $apply$ naming) for a captured free variable passed through a
-- generic HOF parameter.
mod ClosureHof do
  needs IO.Console
  fn apply_twice(f : (Int) -> Int, x : Int) : Int do
    f(f(x))
  end

  fn make_adder(n : Int) : (Int) -> Int do
    fn x -> x + n
  end

  fn main() do
    let add5 = make_adder(5)
    println(apply_twice(add5, 10))
  end
end
