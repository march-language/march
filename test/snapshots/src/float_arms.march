-- Float-literal match arms: pins how ALit(LitFloat _) branches lower
-- (equality-compiled float literals, not a range/guard rewrite).
mod FloatArms do
  needs IO.Console
  fn describe(x : Float) : String do
    match x do
      0.0 -> "zero"
      1.5 -> "one-half-more"
      _ -> "other"
    end
  end

  fn main(_cap_console : Cap(IO.Console)) do
    println(describe(1.5))
  end
end
