-- Three-node harness scenario "fan": node-a hosts role A of the Fan protocol
-- as its own OS process; node-c hosts C and node-b hosts B (see their files).
-- The same protocol and the same race as test/native/session_node_fan_loopback
-- -- A sleeps before its send so B's message reaches C first and must be
-- parked -- but across three processes, each with its own scheduler.
-- scenario.sh pins every node to ONE scheduler thread: socket waits park the
-- green thread, so node-c's four readers cost no thread each (they used to,
-- and this scenario stalled at fewer than 4 threads).
-- Roles number A = 1, C = 2, B = 3 (first appearance), so under "i < j: i
-- listens, j connects" A listens (FAN_A_ADDR) for C.
--
-- Every node is the generated role runner: `Fan_Run.run_<Role>` does the
-- listen/connect/accept wiring from the address table, in the order that
-- cannot deadlock, and hands the body its entry state. What a node writes
-- is its role's line and the four-line match on the result.
-- Design: specs/progress/2026-09-16-session-node-multiparty-routing.md and
-- specs/progress/2026-09-16-role-runner.md.
mod FanNodeA do
  needs IO
  needs IO.Console
  needs IO.Mut
  needs IO.NetConnect
  needs IO.NetListen
  needs IO.Spawn
  needs Session.Live

  @[endpoints]
  protocol Fan do
    A -> C : Int
    B -> C : Int
    C -> A : Bool
  end

  pfn role_a(s : Cap(Session.Live), st : Fan_A.S_send_Msg_A_C_1) : Fan_A.Yield do
    -- The delay that makes the race deterministic: B's message reaches C
    -- while C is still waiting for this one.
    sleep_ms(300)
    println("A: sends 7")
    let st1 = Fan_A.send_Msg_A_C_1(s, st, 7)
    Fan_A.recv_Msg_C_A_1(s, st1, fn (ok, st2) ->
      println("A: got " ++ bool_to_string(ok))
      Fan_A.close(s, st2))
  end

  fn main(c : Cap(IO)) do
    println("node-a: up")
    match Fan_Run.run_A(c, "node-a", "fan-secret", Fan_Run.addrs_from_env(), fn (s, st) -> role_a(s, st)) do
      Ok(_) -> println("A: closed")
      Err(e) -> panic(SessionNode.run_error_message(e))
    end
  end
end
