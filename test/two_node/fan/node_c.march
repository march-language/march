-- Three-node harness scenario "fan": node-c hosts role C, which receives
-- from A and then B and answers A (see node_a.march for the scenario). C = 2
-- dials A = 1 (FAN_A_ADDR) and listens (FAN_C_ADDR) for B = 3; the runner
-- dials first and accepts second, which is what keeps three roles from
-- waiting on each other.
mod FanNodeC do
  needs IO
  needs IO.Console
  needs IO.Mut
  needs IO.NetConnect
  needs IO.NetListen
  needs IO.Spawn
  needs Session.Live

  @[endpoints]
  protocol Fan do
    A -> C : Int
    B -> C : Int
    C -> A : Bool
  end

  pfn role_c(s : Cap(Session.Live), st : Fan_C.S_recv_Msg_A_C_1) : Fan_C.Yield do
    Fan_C.recv_Msg_A_C_1(s, st, fn (a, st1) ->
      println("C: got " ++ int_to_string(a) ++ " from A")
      Fan_C.recv_Msg_B_C_1(s, st1, fn (b, st2) ->
        println("C: got " ++ int_to_string(b) ++ " from B")
        Fan_C.close(s, Fan_C.send_Msg_C_A_1(s, st2, a + b == 16))))
  end

  fn main(c : Cap(IO)) do
    println("node-c: up")
    match Fan_Run.run_C(c, "node-c", "fan-secret", Fan_Run.addrs_from_env(), fn (s, st) -> role_c(s, st)) do
      Ok(_) -> println("C: closed")
      Err(e) -> panic(SessionNode.run_error_message(e))
    end
  end
end
