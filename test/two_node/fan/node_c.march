-- Three-node harness scenario "fan": node-c hosts role C, which receives
-- from A and then B and answers A (see node_a.march for the scenario). C = 2
-- connects to A = 1 on MARCH_PORT_A and listens on MARCH_PORT_C for B = 3.
mod FanNodeC do
  needs IO
  needs IO.Console
  needs IO.Mut
  needs IO.NetConnect
  needs IO.NetListen
  needs IO.Process
  needs IO.Random
  needs IO.Spawn
  needs Session.Live

  @[endpoints]
  protocol Fan do
    A -> C : Int
    B -> C : Int
    C -> A : Bool
  end

  pfn secret() do "fan-secret" end
  pfn identity(name : String) do NodeIdentity.make(name, "pk-" ++ name, 1) end

  pfn connect_retry(port : Int, name : String, attempts : Int) : Peer do
    match ClusterConn.connect_split(PeerRegistry.empty(), "127.0.0.1", port, identity(name), secret()) do
      Ok((_reg, p)) -> p
      Err(e) ->
        if attempts <= 1 do
          panic(name ++ " connect: " ++ e)
        else
          let _ = Process.run("sleep", Cons("0.1", Nil))
          connect_retry(port, name, attempts - 1)
        end
    end
  end

  pfn accept_on(listen_fd : Int, name : String) : Peer do
    match ClusterConn.accept_split(PeerRegistry.empty(), listen_fd, identity(name), secret()) do
      Ok((_reg, p)) -> p
      Err(e) -> panic(name ++ " accept: " ++ e)
    end
  end

  pfn listen_on(port : Int) : Int do
    match tcp_listen(port) do
      Ok(fd) -> fd
      Err(e) -> panic("listen: " ++ e)
    end
  end

  fn main(c : Cap(IO)) do
    let listen_fd = listen_on(Env.require_int("MARCH_PORT_C"))
    println("node-c: up")
    let conn_a = connect_retry(Env.require_int("MARCH_PORT_A"), "node-c", 100)
    let p0 = SessionNode.party(Fan_Msg.role_C(), "node-c", fn _ep -> println("C: closed"))
    let p1 = SessionNode.connect_to(p0, Fan_Msg.role_A(), conn_a)
    let p = SessionNode.require(SessionNode.accept_from(p1, accept_on(listen_fd, "node-c")), Fan_Msg.peers_C())
    let s = Session.attach(c, SessionNode.ops(p))
    let _ = Fan_C.recv_Msg_A_C_1(s, Fan_C.register(s, 0), fn (a, st1) ->
      println("C: got " ++ int_to_string(a) ++ " from A")
      Fan_C.recv_Msg_B_C_1(s, st1, fn (b, st2) ->
        println("C: got " ++ int_to_string(b) ++ " from B")
        Fan_C.close(s, Fan_C.send_Msg_C_A_1(s, st2, a + b == 16))))
    SessionNode.serve(p)
    SessionNode.finish(p)
    tcp_close(listen_fd)
  end
end
