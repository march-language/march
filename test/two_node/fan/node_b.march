-- Three-node harness scenario "fan": node-b hosts role B, which sends to C
-- at once (see node_a.march for the scenario). B = 3 is the highest role, so
-- it listens for nobody and dials C (FAN_C_ADDR); the runner works that out
-- from the generated peer set.
mod FanNodeB do
  needs IO
  needs IO.Console
  needs IO.Mut
  needs IO.NetConnect
  needs IO.NetListen
  needs IO.Spawn
  needs Session.Live

  @[endpoints]
  protocol Fan do
    A -> C : Int
    B -> C : Int
    C -> A : Bool
  end

  pfn role_b(s : Cap(Session.Live), st : Fan_B.S_send_Msg_B_C_1) : Fan_B.Yield do
    println("B: sends 9")
    Fan_B.close(s, Fan_B.send_Msg_B_C_1(s, st, 9))
  end

  fn main(c : Cap(IO)) do
    match Fan_Run.run_B(c, "node-b", "fan-secret", Fan_Run.addrs_from_env(), fn (s, st) -> role_b(s, st)) do
      Ok(_) -> println("B: closed")
      Err(e) -> panic(SessionNode.run_error_message(e))
    end
  end
end
