-- Three-node scenario "cluster_ap_hosted_cancel": node-a offers role Server
-- of Echo HOSTED IN ONE ACTOR (`offer_hosted_Server`, capacity 4), as in
-- cluster_ap_hosted. Three sessions are parked in its LinearMap at once:
-- node-c's, stalled half way, and node-b's two. node-c is killed: its
-- session alone is cancelled (the actor's Cancel handler runs for that sid
-- and drops its parked value), the two from node-b finish, and node-a
-- stops once it has seen two done and one cancelled. See scenario.sh.
mod ClusterApHostedCancelA do
  needs IO
  needs IO.Console
  needs IO.Mut
  needs IO.NetConnect
  needs IO.NetListen
  needs IO.Spawn
  needs IO.Clock
  needs Session.Live

  @[endpoints]
  protocol Echo do
    Client -> Server : Int
    Server -> Client : Int
    Client -> Server : Int
    Server -> Client : Int
  end

  actor ServerActor do
    state { done : Int, cancelled : Int, counts : Map(String, Int),
            sessions : LinearMap(String, Echo_Server.Parked_Server) }
    init  { done: 0, cancelled: 0, counts: Map.empty(), sessions: LinearMap.empty_string() }
    on Start(sid : String, s : Cap(Session.Live)) do
      let parked = Echo_Server.await_Msg_Client_Server_1(s, Echo_Server.register(s, 0))
      match LinearMap.put(state.sessions, sid, parked) do
        (None, m) -> { state with sessions: m }
        (Some(old), m) ->
          Echo_Server.take_closed(Echo_Server.cancel(s, old))
          panic("Start: session " ++ sid ++ " is already hosted")
      end
    end
    on Deliver(sid : String, s : Cap(Session.Live), from : Int, msg : Bytes, ep : Int) do
      match LinearMap.take_slot(state.sessions, sid) do
        -- A delivery for a session that already ended or was cancelled.
        (None, slot) -> { state with sessions: LinearMap.vacate(slot) }
        (Some(parked), slot) ->
          let k = Map.get_or(state.counts, sid, 0, Map.str_cmp) + 1
          match Echo_Server.resume(parked, from, msg, ep) do
            Got_Msg_Client_Server_1(n, st) ->
              println("Server: got " ++ int_to_string(n) ++ " (message " ++ int_to_string(k) ++ " of its session)")
              let st2 = Echo_Server.send_Msg_Server_Client_1(s, st, n * 10)
              { state with counts: Map.insert(state.counts, sid, k, Map.str_cmp),
                           sessions: LinearMap.fill(slot, Echo_Server.await_Msg_Client_Server_2(s, st2)) }
            Got_Msg_Client_Server_2(n, st) ->
              println("Server: got " ++ int_to_string(n) ++ " (message " ++ int_to_string(k) ++ " of its session)")
              let st2 = Echo_Server.send_Msg_Server_Client_2(s, st, n * 10)
              Echo_Server.take_closed(Echo_Server.finish(s, st2))
              { state with done: state.done + 1, counts: Map.remove(state.counts, sid, Map.str_cmp),
                           sessions: LinearMap.vacate(slot) }
          end
      end
    end
    on Cancel(sid : String, s : Cap(Session.Live), role : Int, _cause : String, _ep : Int) do
      match LinearMap.take(state.sessions, sid) do
        (None, m) -> { state with sessions: m }
        (Some(parked), m) ->
          println("Server: session cancelled, " ++ Echo_Msg.role_name(role) ++ " gone")
          Echo_Server.take_closed(Echo_Server.cancel(s, parked))
          { state with cancelled: state.cancelled + 1,
                       counts: Map.remove(state.counts, sid, Map.str_cmp), sessions: m }
      end
    end
  end

  pfn field(a, name : String) : Int do
    match get_actor_field(a, name) do
      Some(n) -> n
      None -> panic("node-a: no actor field " ++ name)
    end
  end

  pfn wait_done(a, want : Int, left : Int) : Bool do
    if field(a, "done") >= want && field(a, "cancelled") >= 1 do true
    else if left <= 0 do false else
      sleep_ms(50)
      wait_done(a, want, left - 50)
    end end
  end

  fn main(c : Cap(IO)) do
    let cfg = ClusterNode.config("node-a", Env.require_int("MARCH_PORT_A"), "", Nil, "aphc-secret", 1)
    match ClusterNode.start(c, cfg) do
      Err(e) -> panic(e)
      Ok(h) ->
        let srv = spawn(ServerActor)
        let start = fn (sid, s) ->
          let _ = send(srv, Start(sid, s))
          ()
        let deliver = fn (sid, s, from, msg, ep) ->
          let _ = send(srv, Deliver(sid, s, from, msg, ep))
          ()
        let cancel = fn (sid, s, role, cause, ep) ->
          let _ = send(srv, Cancel(sid, s, role, cause, ep))
          ()
        -- Printed BEFORE the offer: it is live as soon as it registers.
        println("node-a: offering")
        match Echo_Run.offer_hosted_Server(c, h, 4, srv, start, deliver, cancel) do
          Err(e) -> panic(Echo_Run.error_message(e))
          Ok(o) ->
            if wait_done(srv, 2, 120000) do () else panic("node-a: never saw two done and one cancelled") end
            -- Let the last session's close reach node-b before stopping.
            sleep_ms(500)
            println("Server: " ++ int_to_string(field(srv, "done")) ++ " sessions done, "
                    ++ int_to_string(field(srv, "cancelled")) ++ " cancelled")
            SessionNode.close_offer(o)
            ClusterNode.stop(h)
        end
    end
  end
end
