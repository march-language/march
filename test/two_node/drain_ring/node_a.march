-- Three-node scenario "drain_ring": node-a runs A (see scenario.sh).
mod DrainRingA do
  needs IO
  needs IO.Console
  needs IO.Mut
  needs IO.NetConnect
  needs IO.NetListen
  needs IO.Spawn
  needs Session.Live

  @[endpoints]
  protocol Ring do
    loop do
      a: A -> B : Int
      b: B -> C : Int
      choose by C:
        more -> C -> A : Bool
                more_b: C -> B : Bool
        done -> C -> A : Bool
                done_b: C -> B : Bool
                stop
      end
    end
  end

  pfn role_a(s : Cap(Session.Live), st : Ring_A.Entry, n : Int) : Ring_A.Yield do
    println("A sends " ++ int_to_string(n))
    let st1 = Ring_A.send_A(s, st, n)
    Ring_A.offer_more_done_or_drain(s, st1,
      fn (_m, st2) -> role_a(s, st2, n + 1),
      fn (_d, st2) -> Ring_A.close(s, st2),
      fn (role, back, d) ->
        println("A drained, waiting on role " ++ int_to_string(role) ++ ", " ++ int_to_string(List.length(back)) ++ " came back")
        Ring_A.drained(s, d))
  end

  fn main(c : Cap(IO)) do
    println("node-a: up")
    match Ring_Run.run_A(c, "node-a", "ring-secret", Ring_Run.addrs_from_env(), fn (s, st) -> role_a(s, st, 1)) do
      Ok(Session.Drained(n)) -> println("A: Ok(Drained(" ++ int_to_string(n) ++ "))")
      Ok(Session.Finished) -> println("A: Ok(Finished)")
      Err(e) -> panic(Ring_Run.error_message(e))
    end
  end
end
