-- Scenario "fingerprint_skew": node-a's `Thing` is `{ x : Int }`; node-b's
-- is `{ x : String }`. Same protocol name, same roles, same steps, same
-- payload type NAME -- the two modules differ only below that name. See
-- scenario.sh.
mod FingerprintSkewA do
  needs IO
  needs IO.Console
  needs IO.Mut
  needs IO.NetConnect
  needs IO.NetListen
  needs IO.Spawn
  needs Session.Live

  type Thing = { x : Int }
  derive Json for Thing

  @[endpoints]
  protocol Q do
    A -> B : Thing
    B -> A : Int
  end

  fn main(c : Cap(IO)) do
    println("node-a: up")
    match Q_Run.run_A(c, "node-a", "skew-secret", Q_Run.addrs_from_env(), fn (s, st) ->
      println("A: RAN THE BODY")
      Q_A.recv_Msg_B_A_1(s, Q_A.send_Msg_A_B_1(s, st, { x: 1 }), fn (_n, st2) -> Q_A.close(s, st2))) do
      Ok(_) -> println("A: ok")
      Err(e) ->
        let m = Q_Run.error_message(e)
        -- The message carries both fingerprints, which are digests and move
        -- whenever the digest's input widens: assert on the sentence, not on
        -- the hex.
        if String.contains(m, "built from DIFFERENT versions of the protocol") do
          println("A: refused at setup: the protocol versions differ")
        else println("A: " ++ m) end
    end
  end
end
