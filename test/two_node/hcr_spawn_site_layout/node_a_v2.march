-- Scenario "hcr_spawn_site_layout", version 2. See scenario.sh.
mod SpawnSite do
  needs IO.Console
  needs IO.Spawn
  needs IO.Clock
  needs IO.Mut

  pfn tally() : Vault(Int) do Authority.must(Vault.open("spawn_site_tally")) end

  actor C do
    state { count : Int, label : String, extra : Int }
    init { count: 7, label: "fresh", extra: 42 }
    on Show(path : String) do
      -- A state the v2 code built has "fresh"/42; a v1 state migrated has
      -- "migrated"/1. Anything else is a v1 layout read as v2.
      let k = if state.count == 7 && state.label == "fresh" && state.extra == 42 do "fresh"
              else if state.count == 7 && state.label == "migrated" && state.extra == 1 do "migrated"
              else "BAD" end end
      let _ = Vault.incr(tally(), path ++ " v2 " ++ k, 1)
      state
    end
  end

  -- The migration a live C runs at its marker.
  fn c_migrate_state(old : { count : Int }) : { count : Int, label : String, extra : Int } do
    { count: old.count, label: "migrated", extra: 1 }
  end

  -- A mailbox boundary can advance to new code while main keeps its old frame.
  actor Driver do
    state { ticks : Int }
    init { ticks: 0 }
    on Tick() do
      let c = spawn(C)
      send(c, Show("driver"))
      { ticks: state.ticks + 1 }
    end
  end

  -- Spawn site 1: a function reached through its dispatch slot, which the
  -- patch replaces (its impl hash moves with C's init, which is inlined).
  pfn spawn_by_slot() : Unit do
    let c = spawn(C)
    send(c, Show("slot"))
    ()
  end

  -- Spawn site 2: a task started before the deploy, looping in its own
  -- function: it runs at the epoch it was spawned at.
  pfn old_task_loop(i : Int, n : Int) : Int do
    if i >= n do 0
    else
      let c = spawn(C)
      send(c, Show("task"))
      sleep_ms(150)
      old_task_loop(i + 1, n)
    end
  end

  pfn report(t : Vault(Int), path : String) : Unit do
    let seen = fn k -> if Vault.get_or(t, path ++ k, 0) > 0 do "true" else "false" end
    println(path ++ ": v1 " ++ seen(" v1") ++ ", v2 fresh " ++ seen(" v2 fresh")
            ++ ", v2 migrated " ++ seen(" v2 migrated")
            ++ ", v2 bad " ++ int_to_string(Vault.get_or(t, path ++ " v2 BAD", 0)))
    ()
  end

  fn main(_c : Cap(IO.Console), _s : Cap(IO.Spawn), _k : Cap(IO.Clock), _m : Cap(IO.Mut)) : Unit do
    println("node-a: version 2 up")
    let driver = spawn(Driver)
    let n = 50
    let t = task_spawn(fn _ -> old_task_loop(0, n))
    -- Spawn site 3: main and its closure keep their original routing epoch.
    List.each(List.range(0, n), fn _ ->
      let c = spawn(C)
      send(c, Show("main"))
      spawn_by_slot()
      send(driver, Tick)
      sleep_ms(150))
    let _ = task_await_unwrap(t)
    sleep_ms(500)
    let tl = tally()
    report(tl, "slot")
    report(tl, "task")
    report(tl, "main")
    println("driver: v2 fresh " ++ bool_to_string(Vault.get_or(tl, "driver v2 fresh", 0) > 0)
            ++ ", v2 bad " ++ int_to_string(Vault.get_or(tl, "driver v2 BAD", 0)))
    ()
  end
end
