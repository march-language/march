-- Two-node scenario "cluster_ap": node-a offers role Server of Echo (up to 4
-- sessions at once) and answers each session with the number times 10. It
-- stops once it has served two sessions. See scenario.sh.
mod ClusterApA do
  needs IO
  needs IO.Console
  needs IO.Mut
  needs IO.NetConnect
  needs IO.NetListen
  needs IO.Spawn
  needs IO.Clock
  needs Session.Live

  @[endpoints]
  protocol Echo do
    Client -> Server : Int
    Server -> Client : Int
  end

  pfn serve_one(s : Cap(Session.Live), st : Echo_Server.S_recv_Msg_Client_Server_1, served : Vault(Int)) : Echo_Server.Yield do
    Echo_Server.recv_Msg_Client_Server_1(s, st, fn (n, st1) ->
      println("Server: got " ++ int_to_string(n))
      let _ = Vault.incr(served, "n", 1)
      Echo_Server.close(s, Echo_Server.send_Msg_Server_Client_1(s, st1, n * 10)))
  end

  pfn wait_served(served : Vault(Int), want : Int, left : Int) : Bool do
    if Vault.get_or(served, "n", 0) >= want do true
    else if left <= 0 do false else
      sleep_ms(50)
      wait_served(served, want, left - 50)
    end end
  end

  fn main(c : Cap(IO)) do
    let cfg = ClusterNode.config("node-a", Env.require_int("MARCH_PORT_A"), "", Nil, "ap-secret", 1)
    match ClusterNode.start(cfg) do
      Err(e) -> panic(e)
      Ok(h) ->
        let served = Vault.new("served")
        -- Printed BEFORE the offer: it is live as soon as `offer_Server`
        -- registers it, and a session can be served before a line printed
        -- after the call would run.
        println("node-a: offering")
        match Echo_Run.offer_Server(c, h, 4, fn (s, st) -> serve_one(s, st, served)) do
          Err(e) -> panic(e)
          Ok(o) ->
            if wait_served(served, 2, 120000) do () else panic("node-a: never served two sessions") end
            -- Let the second session's close reach node-b before stopping.
            sleep_ms(500)
            SessionNode.close_offer(o)
            ClusterNode.stop(h)
        end
    end
  end
end
