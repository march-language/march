-- Two-node harness scenario "crash_before_send": node-b hosts role I, the DETECTOR:
-- its `recv_Msg_C_I_1` takes a crash callback. C is killed before it sends,
-- so I takes the crash branch with a LIVE state, tells L, and closes: Ok, not
-- Cancelled.
mod CrashBeforeSendNodeB do
  needs IO
  needs IO.Console
  needs IO.Mut
  needs IO.NetConnect
  needs IO.NetListen
  needs IO.Spawn
  needs Session.Live

  @[endpoints]
  protocol Logging do
    may crash C
    L -> I : Int
    C -> I : String
      or crash do
        I -> L : String
      end
    I -> L : String
    L -> I : Bool
    I -> C : Bool
  end

  pfn role_i(s : Cap(Session.Live), st : Logging_I.S_recv_Msg_L_I_1) : Logging_I.Yield do
    Logging_I.recv_Msg_L_I_1(s, st, fn (_trigger, st1) ->
      println("I: got Trigger")
      Logging_I.recv_Msg_C_I_1(s, st1,
        fn (read, st2) ->
          println("I: got Read(" ++ read ++ ")")
          let st3 = Logging_I.send_Msg_I_L_2(s, st2, read)
          Logging_I.recv_Msg_L_I_2(s, st3, fn (report, st4) ->
            println("I: got Report(" ++ bool_to_string(report) ++ ")")
            Logging_I.close(s, Logging_I.send_Msg_I_C_1(s, st4, report))),
        fn (crashed, st2) ->
          println("I: role " ++ int_to_string(crashed.role) ++ " crashed: " ++ crashed.cause)
          Logging_I.close(s, Logging_I.send_Msg_I_L_1(s, st2, "C crashed: " ++ crashed.cause))))
  end

  fn main(c : Cap(IO)) do
    println("node-b: up")
    match Logging_Run.run_I(c, "node-b", "logging-secret", Logging_Run.addrs_from_env(), fn (s, st) -> role_i(s, st)) do
      Ok(_) -> println("I: closed")
      Err(SessionNode.Cancelled(role, cause)) ->
        println("I: cancelled waiting on role " ++ int_to_string(role) ++ ": " ++ cause)
      Err(e) -> panic(SessionNode.run_error_message(e))
    end
  end
end
