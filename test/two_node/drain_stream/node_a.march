-- Two-node scenario "drain_stream": node-a runs Prod (role 1, listens).
mod DrainStreamA do
  needs IO
  needs IO.Console
  needs IO.Mut
  needs IO.NetConnect
  needs IO.NetListen
  needs IO.Spawn
  needs Session.Live

  @[endpoints]
  protocol Stream do
    loop do
      Prod -> Cons : Int
      choose by Cons:
        more -> Cons -> Prod : Bool
        done -> Cons -> Prod : Bool
                stop
      end
    end
  end

  pfn prod(s : Cap(Session.Live), st : Stream_Prod.Entry, next : Int) : Stream_Prod.Yield do
    println("Prod sends " ++ int_to_string(next))
    let st1 = Stream_Prod.send_Msg_Prod_Cons_1(s, st, next)
    Stream_Prod.offer_more_done_or_drain(s, st1,
      fn (_b, st2) -> prod(s, st2, next + 1),
      fn (_b, st2) -> Stream_Prod.close(s, st2),
      fn (role, undelivered, d) ->
        println("Prod drained, waiting on role " ++ int_to_string(role) ++ "; came back: "
          ++ String.join(List.map(undelivered, fn m -> match m do
               Stream_Msg.Msg_Prod_Cons_1(v) -> int_to_string(v)
               _ -> "?"
             end), ", "))
        Stream_Prod.drained(s, d))
  end

  fn main(c : Cap(IO)) do
    println("node-a: up")
    match Stream_Run.run_Prod(c, "node-a", "drain-secret", Stream_Run.addrs_from_env(), fn (s, st) -> prod(s, st, 1)) do
      Ok(Session.Drained(n)) -> println("Prod: Ok(Drained(" ++ int_to_string(n) ++ "))")
      Ok(Session.Finished) -> println("Prod: Ok(Finished)")
      Err(e) -> panic(Stream_Run.error_message(e))
    end
  end
end
