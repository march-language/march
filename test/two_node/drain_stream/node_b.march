-- Two-node scenario "drain_stream": node-b runs Cons (role 2, dials Prod)
-- and drains its epochs after its third item.
mod DrainStreamB do
  needs IO
  needs IO.Console
  needs IO.Mut
  needs IO.NetConnect
  needs IO.NetListen
  needs IO.Spawn
  needs Session.Live

  @[endpoints]
  protocol Stream do
    loop do
      Prod -> Cons : Int
      choose by Cons:
        more -> Cons -> Prod : Bool
        done -> Cons -> Prod : Bool
                stop
      end
    end
  end

  pfn cons(c : Cap(IO), s : Cap(Session.Live), st : Stream_Cons.Entry, got : Int) : Stream_Cons.Yield do
    Stream_Cons.recv_Msg_Prod_Cons_1(s, st, fn (n, st1) ->
      println("Cons got " ++ int_to_string(n))
      if got + 1 == 3 do
        println("node-b: draining")
        SessionNode.drain_epochs(c, 600000, 0)
      else () end
      if got + 1 >= 10 do Stream_Cons.close(s, Stream_Cons.choose_done(s, st1, true))
      else cons(c, s, Stream_Cons.choose_more(s, st1, true), got + 1) end)
  end

  fn main(c : Cap(IO)) do
    match Stream_Run.run_Cons(c, "node-b", "drain-secret", Stream_Run.addrs_from_env(), fn (s, st) -> cons(c, s, st, 0)) do
      Ok(Session.Drained(n)) -> println("Cons: Ok(Drained(" ++ int_to_string(n) ++ "))")
      Ok(Session.Finished) -> println("Cons: Ok(Finished)")
      Err(e) -> panic(Stream_Run.error_message(e))
    end
  end
end
