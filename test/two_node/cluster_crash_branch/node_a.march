-- Two-node harness, scenario "cluster_crash_branch" (three nodes): the crash
-- branch of test/two_node/crash_before_send, with the session run over the
-- cluster node service (Logging_Run.cluster_L: peers found by name under the
-- session id, frames over the node's shared connections, SWIM and refused
-- redials as the failure detector). node-c, which hosts the role declared
-- `may crash`, is SIGKILLed before it sends; the detector learns it is gone
-- from its node rather than from a dropped session connection, and the same
-- `check_waiting` takes the crash branch. Until this scenario the cluster
-- path was believed to do that and nothing pinned it.
-- node-a is the seed and hosts role L, which offers over the two messages I
-- can send it: Read (the normal path) or Fatal (the crash branch).
mod ClusterCrashBranchA do
  needs IO
  needs IO.Console
  needs IO.Mut
  needs IO.NetConnect
  needs IO.NetListen
  needs IO.Spawn
  needs IO.Clock
  needs Session.Live

  @[endpoints]
  protocol Logging do
    may crash C
    L -> I : Int
    C -> I : String
      or crash do
        I -> L : String
      end
    I -> L : String
    L -> I : Bool
    I -> C : Bool
  end

  pfn join() : ClusterNode.ClusterHandle do
    let cfg = ClusterNode.config("node-a", Env.require_int("MARCH_PORT_A"), "", Nil, "logging-secret", 1)
    match ClusterNode.start(cfg) do
      Err(e) -> panic(e)
      Ok(h) ->
        if ClusterNode.await_members(h, 2, 120000) do h else panic("node-a: never joined") end
    end
  end

  pfn role_l(s : Cap(Session.Live), st : Logging_L.S_send_Msg_L_I_1) : Logging_L.Yield do
    println("L: sends Trigger")
    let st1 = Logging_L.send_Msg_L_I_1(s, st, 1)
    Logging_L.offer_Msg_I_L_2_Msg_I_L_1(s, st1,
      fn (read, st2) ->
        println("L: got Read(" ++ read ++ ")")
        Logging_L.close(s, Logging_L.send_Msg_L_I_2(s, st2, true)),
      fn (fatal, st2) ->
        println("L: got Fatal(" ++ fatal ++ ")")
        Logging_L.close(s, st2))
  end

  fn main(c : Cap(IO)) do
    let h = join()
    println("node-a: up")
    match Logging_Run.cluster_L(c, h, "logging-1", fn (s, st) -> role_l(s, st)) do
      Ok(_) -> println("L: closed")
      Err(SessionNode.Cancelled(role, cause)) ->
        println("L: cancelled waiting on role " ++ int_to_string(role) ++ ": " ++ cause)
      Err(e) -> println("L: " ++ SessionNode.run_error_message(e))
    end
    ClusterNode.stop(h)
  end
end
