-- Two-node scenario "slow_start": node-b runs role B, which waits for A's
-- late first message; see scenario.sh.
mod SlowStartB do
  needs IO
  needs IO.Console
  needs IO.Mut
  needs IO.NetConnect
  needs IO.NetListen
  needs IO.Spawn
  needs Session.Live

  @[endpoints]
  protocol Slow do
    A -> B : Int
    B -> A : Int
  end

  pfn role_b(s : Cap(Session.Live), st : Slow_B.S_recv_Msg_A_B_1) : Slow_B.Yield do
    Slow_B.recv_Msg_A_B_1(s, st, fn (n, st1) ->
      println("B: got " ++ int_to_string(n))
      Slow_B.close(s, Slow_B.send_Msg_B_A_1(s, st1, n * 2)))
  end

  fn main(c : Cap(IO)) do
    match Slow_Run.run_B(c, "node-b", "slow-secret", Slow_Run.addrs_from_env(), fn (s, st) -> role_b(s, st)) do
      Ok(_) -> println("B: closed")
      Err(e) -> println("B: " ++ SessionNode.run_error_message(e))
    end
  end
end
