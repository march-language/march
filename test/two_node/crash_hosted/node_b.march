-- Two-node harness scenario "crash_hosted": node-b hosts role I, the
-- DETECTOR, IN AN ACTOR (`Logging_Run.host_I`, the event API). C is killed
-- before it sends, so I is waiting on a role that is gone: the crash reaches
-- the actor the way a delivery does, `resume` hands it back as
-- `Crashed_Msg_C_I_1` with the crash branch's first state, and the actor
-- sends L the Fatal and finishes. Ok, not Cancelled -- which is what a role
-- run from callbacks already did (crash_before_send), and what a hosted one
-- could not do before.
mod CrashHostedNodeB do
  needs IO
  needs IO.Console
  needs IO.Mut
  needs IO.NetConnect
  needs IO.NetListen
  needs IO.Spawn
  needs Session.Live

  @[endpoints]
  protocol Logging do
    may crash C
    L -> I : Int
    C -> I : String
      or crash do
        I -> L : String
      end
    I -> L : String
    L -> I : Bool
    I -> C : Bool
  end

  actor IActor do
    state { parked : Logging_I.Parked_I }
    init  { parked: Logging_I.idle() }
    on StartI(s : Cap(Session.Live)) do
      Logging_I.take_idle(state.parked)
      { state with parked: Logging_I.await_Msg_L_I_1(s, Logging_I.register(s, 0)) }
    end
    on DeliverI(s : Cap(Session.Live), from : Int, msg : Bytes, ep : Int) do
      match Logging_I.resume(state.parked, from, msg, ep) do
        Got_Msg_L_I_1(_trigger, st) ->
          println("I: got Trigger")
          { state with parked: Logging_I.await_Msg_C_I_1(s, st) }
        Got_Msg_C_I_1(read, st) ->
          println("I: got Read(" ++ read ++ ")")
          { state with parked: Logging_I.await_Msg_L_I_2(s, Logging_I.send_Msg_I_L_2(s, st, read)) }
        Got_Msg_L_I_2(report, st) ->
          println("I: got Report(" ++ bool_to_string(report) ++ ")")
          { state with parked: Logging_I.finish(s, Logging_I.send_Msg_I_C_1(s, st, report)) }
        Crashed_Msg_C_I_1(crashed, st) ->
          println("I: role " ++ int_to_string(crashed.role) ++ " crashed: " ++ crashed.cause)
          { state with parked: Logging_I.finish(s, Logging_I.send_Msg_I_L_1(s, st, "C crashed: " ++ crashed.cause)) }
      end
    end
  end

  fn main(c : Cap(IO)) do
    println("node-b: up")
    let pi = spawn(IActor)
    let start = fn s ->
      let _ = send(pi, StartI(s))
      ()
    let deliver = fn (s, from, msg, ep) ->
      let _ = send(pi, DeliverI(s, from, msg, ep))
      ()
    match Logging_Run.host_I(c, "node-b", "logging-secret", Logging_Run.addrs_from_env(), pi, start, deliver) do
      Ok(_) -> println("I: closed")
      Err(SessionNode.Cancelled(role, cause)) ->
        println("I: cancelled waiting on role " ++ int_to_string(role) ++ ": " ++ cause)
      Err(e) -> panic(SessionNode.run_error_message(e))
    end
  end
end
