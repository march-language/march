-- Two-node scenario "drain_second_signal": node-a offers role Server of Echo and
-- answers the number times 10 only after 30 s, so the session is still running
-- when node-b is sent SIGTERM twice. The scenario SIGKILLs it at the end. See
-- scenario.sh.
mod DrainSecondSignalA do
  needs IO
  needs IO.Console
  needs IO.Mut
  needs IO.NetConnect
  needs IO.NetListen
  needs IO.Spawn
  needs IO.Clock
  needs Session.Live

  @[endpoints]
  protocol Echo do
    Client -> Server : Int
    Server -> Client : Int
  end

  pfn serve_one(s : Cap(Session.Live), st : Echo_Server.S_recv_Msg_Client_Server_1, served : Vault(Int)) : Echo_Server.Yield do
    Echo_Server.recv_Msg_Client_Server_1(s, st, fn (n, st1) ->
      println("Server: got " ++ int_to_string(n))
      sleep_ms(30000)
      let st2 = Echo_Server.send_Msg_Server_Client_1(s, st1, n * 10)
      let _ = Vault.incr(served, "n", 1)
      Echo_Server.close(s, st2))
  end

  pfn idle() : () do
    sleep_ms(250)
    idle()
  end

  fn main(c : Cap(IO)) do
    let cfg = ClusterNode.config("node-a", Env.require_int("MARCH_PORT_A"), "", Nil, "drain-second-secret", 1)
    match ClusterNode.start(c, cfg) do
      Err(e) -> panic(e)
      Ok(h) ->
        let served = Vault.new("served")
        println("node-a: offering")
        match Echo_Run.offer_Server(c, h, 4, fn (s, st) -> serve_one(s, st, served)) do
          Err(e) -> panic(Echo_Run.error_message(e))
          Ok(_) -> idle()
        end
    end
  end
end
