-- Two-node harness, scenario "cluster_fingerprint_skew": node-b's `Thing` is
-- `{ x : String }` where node-a's is `{ x : Int }` (session s1), and in s2 it
-- plays a peer built before the check. See node_a.march.
mod ClusterFpSkewB do
  needs IO
  needs IO.Console
  needs IO.Mut
  needs IO.NetConnect
  needs IO.NetListen
  needs IO.Spawn
  needs IO.Clock
  needs Session.Live
  needs ClusterNode.Live

  type Thing = { x : String }
  derive Json for Thing

  @[endpoints]
  protocol Q do
    A -> B : Thing
    B -> A : Int
  end

  @[endpoints]
  protocol R do
    A -> B : Int
    B -> A : Int
  end

  pfn verdict(who : String, m : String) : String do
    if String.contains(m, "built from a DIFFERENT version of the protocol") do
      who ++ ": refused at setup: the protocol versions differ"
    else if String.contains(m, "registered no protocol fingerprint") do
      -- node-a's refusal, carried by its cancel of this role.
      who ++ ": refused by its peer: this node registered no fingerprint"
    else who ++ ": " ++ m end end
  end

  fn main(c : Cap(IO)) do
    let seed = "127.0.0.1:" ++ int_to_string(Env.require_int("MARCH_PORT_A"))
    let cfg = ClusterNode.config("node-b", Env.require_int("MARCH_PORT_B"), "", Cons(seed, Nil), "fp-secret", 1)
    match ClusterNode.start(c, cfg) do
      Err(e) -> panic(e)
      Ok(h) ->
        println("node-b: up")
        if ClusterNode.await_members(h, 1, 120000) do () else panic("node-b: never joined") end
        let q = Q_Run.cluster_B(c, h, "s1", fn (s, st) ->
          println("B s1: RAN THE BODY")
          Q_B.recv_Msg_A_B_1(s, st, fn (_t, st1) -> Q_B.close(s, Q_B.send_Msg_B_A_1(s, st1, 1))))
        match q do
          Ok(_) -> println("B s1: ok")
          Err(e) -> println(verdict("B s1", Q_Run.error_message(e)))
        end
        -- The old peer: what `R_Run.cluster_B` did before the check, with no
        -- fingerprint registered and none checked.
        let r = SessionNode.run_cluster(c, h, R_Msg.role_B(), R_Msg.peers_B(), "s2", "", fn _ -> (), fn s ->
          let _ = R_B.recv_Msg_A_B_1(s, R_B.register(s, 0), fn (_n, st1) ->
            println("B s2: RAN THE BODY")
            R_B.close(s, R_B.send_Msg_B_A_1(s, st1, 1)))
          ())
        match r do
          Ok(_) -> println("B s2: ok")
          Err(e) -> println(verdict("B s2", SessionNode.run_error_message(e)))
        end
        ClusterNode.stop(h)
    end
  end
end
