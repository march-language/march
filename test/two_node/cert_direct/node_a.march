-- Two-node harness, scenario "cert_direct": node-a, role A of Pair, Audit
-- and Ledger through the generated run_A, in certificate mode. See
-- scenario.sh.
mod CertDirectA do
  needs IO
  needs IO.Console
  needs IO.Mut
  needs IO.NetConnect
  needs IO.NetListen
  needs IO.Process
  needs IO.Spawn
  needs IO.Clock
  needs Session.Live

  @[endpoints]
  protocol Pair do
    A -> B : Int
    B -> A : Int
  end

  @[endpoints]
  protocol Audit do
    A -> B : Int
    B -> A : Int
  end

  @[endpoints]
  protocol Ledger do
    A -> B : Int
    B -> A : Int
  end

  pfn me() : String do "node-a" end

  pfn pair(s : Cap(Session.Live), st : Pair_A.S_send_Msg_A_B_1) : Pair_A.Yield do
    Pair_A.recv_Msg_B_A_1(s, Pair_A.send_Msg_A_B_1(s, st, 20), fn (n, st1) ->
      println("node-a: Pair got " ++ int_to_string(n))
      Pair_A.close(s, st1))
  end

  pfn audit(s : Cap(Session.Live), st : Audit_A.S_send_Msg_A_B_1) : Audit_A.Yield do
    Audit_A.recv_Msg_B_A_1(s, Audit_A.send_Msg_A_B_1(s, st, 1), fn (_n, st1) -> Audit_A.close(s, st1))
  end

  pfn ledger(s : Cap(Session.Live), st : Ledger_A.S_send_Msg_A_B_1) : Ledger_A.Yield do
    Ledger_A.recv_Msg_B_A_1(s, Ledger_A.send_Msg_A_B_1(s, st, 1), fn (_n, st1) -> Ledger_A.close(s, st1))
  end

  fn main(c : Cap(IO)) do
    let pki = Env.require("PKI")
    Process.set_env("MARCH_NODE_CERT", pki ++ "/" ++ me() ++ ".cert")
    Process.set_env("MARCH_NODE_KEY", pki ++ "/" ++ me() ++ ".key")
    Process.set_env("MARCH_CLUSTER_OPERATOR_PUBKEY", pki ++ "/operator.pub")
    println(me() ++ ": up")
    match Pair_Run.run_A(c, me(), "unused-secret", Pair_Run.addrs_from_env(), fn (s, st) -> pair(s, st)) do
      Ok(_) -> println(me() ++ ": Pair closed")
      Err(e) -> println(me() ++ ": Pair: " ++ Pair_Run.error_message(e))
    end
    match Audit_Run.run_A(c, me(), "unused-secret", Audit_Run.addrs_from_env(), fn (s, st) -> audit(s, st)) do
      Ok(_) -> println(me() ++ ": Audit formed (wrong)")
      Err(_) -> println(me() ++ ": Audit did not form")
    end
    match Ledger_Run.run_A(c, me(), "unused-secret", Ledger_Run.addrs_from_env(), fn (s, st) -> ledger(s, st)) do
      Ok(_) -> println(me() ++ ": Ledger formed (wrong)")
      Err(e) -> println(me() ++ ": Ledger: " ++ Ledger_Run.error_message(e))
    end
  end
end
