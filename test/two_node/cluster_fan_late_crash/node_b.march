-- Two-node harness, scenario "cluster_fan_late_crash": node-b hosts role B.
-- It sends its 9 and is killed before closing. See node_a.march.
mod ClusterFanLateCrashB do
  needs IO
  needs IO.Console
  needs IO.FileRead
  needs IO.Mut
  needs IO.NetConnect
  needs IO.NetListen
  needs IO.Spawn
  needs IO.Clock
  needs Session.Live
  needs ClusterNode.Live

  @[endpoints]
  protocol Fan do
    A -> C : Int
    B -> C : Int
    C -> A : Bool
  end


  pfn joined(h : Cap(ClusterNode.Live)) : () do
    if ClusterNode.await_members(h, 2, 120000) do () else panic("node-b: never joined") end
  end

  pfn role_b(s : Cap(Session.Live), st : Fan_B.S_send_Msg_B_C_1) : Fan_B.Yield do
    let st1 = Fan_B.send_Msg_B_C_1(s, st, 9)
    println("B: sent 9")
    sleep_ms(600000)           -- the scenario kills us here, before the close
    Fan_B.close(s, st1)
  end

  fn main(c : Cap(IO)) do
    let cfg = ClusterNode.config("node-b", Env.require_int("MARCH_PORT_B"), "", Cons("127.0.0.1:" ++ int_to_string(Env.require_int("MARCH_PORT_A")), Nil), "fan-secret", 1)
    let h = match ClusterNode.start(c, cfg) do
      Ok(h0) -> h0
      Err(e) -> panic(e)
    end
    joined(h)
    println("node-b: up")
    match Fan_Run.cluster_B(c, h, "fan-1", fn (s, st) -> role_b(s, st)) do
      Ok(_) -> println("B: closed")
      Err(e) -> println("B: " ++ SessionNode.run_error_message(e))
    end
  end
end
