-- Scenario "protocol_expand_contract", version 2: the next version of
-- node_a.march, where `choose by Shop` gains `later`. The scenario builds it
-- twice: the EXPAND (--protocol-expand Order:later: Shop stays on version
-- 1's fingerprint and its `choose_later` refuses to run) and the CONTRACT
-- (the plain build). The Shop asks which it is (`may_choose_later`), so the
-- same source is right in both. See scenario.sh.
mod ProtocolSplit do
  needs IO
  needs IO.Console
  needs IO.Mut
  needs IO.NetConnect
  needs IO.NetListen
  needs IO.Spawn
  needs IO.Clock
  needs Session.Live
  needs ClusterNode.Live

  @[endpoints]
  protocol Order do
    loop do
      item: Buyer -> Shop : Int
      choose by Shop:
        more -> Shop -> Buyer : Int
        later -> Shop -> Buyer : Int
        done -> Shop -> Buyer : Int
                stop
      end
    end
  end

  fn version() : Int do 2 end

  -- The Shop may choose `later` once it offers under this version's own
  -- fingerprint: never in the expand build, which pins it to version 1's.
  fn may_choose_later() : Bool do
    Order_Msg.role_fingerprint(Order_Msg.role_Shop()) == Order_Msg.fingerprint()
  end

  -- What the Shop tells its Buyer it is: 2 in the expand, 3 in the contract.
  fn shop_phase() : Int do if may_choose_later() do 3 else 2 end end

  -- ── the Shop (node-a): the chooser ────────────────────────────────────

  fn shop(s : Cap(Session.Live), st : Order_Shop.Entry) : Order_Shop.Yield do
    Order_Shop.recv_Item(s, st, fn (n, st1) ->
      sleep_ms(100)
      if n >= 4 do Order_Shop.close(s, Order_Shop.choose_done(s, st1, shop_phase()))
      else if n == 2 && may_choose_later() do shop(s, Order_Shop.choose_later(s, st1, shop_phase()))
      else shop(s, Order_Shop.choose_more(s, st1, shop_phase())) end end)
  end

  pfn offers() : Vault(SessionNode.Offer) do
    match Vault.whereis("split_offers") do
      Some(v) -> v
      None -> Vault.new("split_offers")
    end
  end

  -- The Shop's access point, kept on the fingerprint the running code offers
  -- Shop under: `role_fingerprint`, which an expand build pins to the
  -- previous version for the chooser, so the expand re-offers nothing and the
  -- contract re-offers under the new fingerprint.
  fn host_tick(c : Cap(IO), h : Cap(ClusterNode.Live)) : () do
    let v = offers()
    let fp = Order_Msg.role_fingerprint(Order_Msg.role_Shop())
    match Vault.get(v, "cur") do
      Some(o) ->
        if o.fingerprint == fp do ()
        else
          match Order_Run.offer_Shop(c, h, 64, fn (s, st) -> shop(s, st)) do
            Ok(o2) ->
              Vault.set(v, "cur", o2)
              SessionNode.close_offer(o)
              println("node-a: Shop re-offered in phase " ++ int_to_string(shop_phase()) ++ "; the old offer drains")
            Err(e) -> println("node-a: could not re-offer: " ++ SessionNode.run_error_message(e))
          end
        end
      None ->
        match Order_Run.offer_Shop(c, h, 64, fn (s, st) -> shop(s, st)) do
          Ok(o) -> Vault.set(v, "cur", o)
          Err(e) -> panic(SessionNode.run_error_message(e))
        end
    end
  end

  fn note(_v : Int) : () do () end

  type ShopHostState = { ticks : Int }

  actor ShopHost do
    state { ticks : Int }
    init  { ticks: 0 }
    on Tick(c : Cap(IO), h : Cap(ClusterNode.Live)) do
      -- The version literal makes this handler differ between the versions.
      note(2)
      host_tick(c, h)
      { ticks: state.ticks + 1 }
    end
  end

  fn start_host() : Pid(ShopHostState) do spawn(ShopHost) end
  fn tick(a : Pid(ShopHostState), c : Cap(IO), h : Cap(ClusterNode.Live)) : () do
    let _ = send(a, Tick(c, h))
    ()
  end

  -- ── the Buyer (node-b): a receiver ────────────────────────────────────

  pfn tally() : Vault(Int) do
    match Vault.whereis("split_tally") do
      Some(t) -> t
      None -> Vault.new("split_tally")
    end
  end

  fn count(key : String, k : Int) : () do
    let _ = Vault.incr(tally(), key, k)
    ()
  end

  fn buyer(s : Cap(Session.Live), st : Order_Buyer.Entry, n : Int) : Order_Buyer.Yield do
    let st1 = Order_Buyer.send_Item(s, st, n)
    Order_Buyer.offer_more_later_done(s, st1,
      fn (_v, st2) -> buyer(s, st2, n + 1),
      fn (v, st2) ->
        count("later:" ++ int_to_string(v), 1)
        buyer(s, st2, n + 1),
      fn (v, st2) ->
        count("pair:" ++ int_to_string(version()) ++ "/" ++ int_to_string(v), 1)
        Order_Buyer.close(s, st2))
  end

  -- One session, its outcome counted: Finished, Drained (D27), refused at
  -- formation, or failed -- the last is a LOST session.
  fn session(c : Cap(IO), h : Cap(ClusterNode.Live)) : () do
    count("started", 1)
    match Order_Run.initiate_Buyer(c, h, fn (s, st) -> buyer(s, st, 1)) do
      Ok(Session.Finished) -> count("finished", 1)
      Ok(Session.Drained(k)) ->
        count("drained", 1)
        count("returned", k)
      Err(SessionNode.NoOffer(_, why)) ->
        count("refused", 1)
        println("node-b: refused at formation: " ++ why)
      Err(e) ->
        count("failed", 1)
        println("node-b: session failed: " ++ Order_Run.error_message(e))
    end
    count("ended", 1)
  end

  type DriverState = { started : Int }

  actor Driver do
    state { started : Int }
    init  { started: 0 }
    on Go(c : Cap(IO), h : Cap(ClusterNode.Live)) do
      note(2)
      let _ = task_spawn(fn _ -> do
        session(c, h)
        0
      end)
      { started: state.started + 1 }
    end
  end

  fn start_driver() : Pid(DriverState) do spawn(Driver) end
  fn go(d : Pid(DriverState), c : Cap(IO), h : Cap(ClusterNode.Live)) : () do
    let _ = send(d, Go(c, h))
    ()
  end

  fn settled() : Bool do
    let t = tally()
    Vault.get_or(t, "ended", 0) >= Vault.get_or(t, "started", 0)
  end

  pfn seen(key : String) : String do
    if Vault.get_or(tally(), key, 0) > 0 do "seen" else "NOT seen" end
  end

  fn summary() : () do
    let t = tally()
    println("node-b: sessions lost: " ++ int_to_string(Vault.get_or(t, "failed", 0)))
    println("node-b: sessions refused at formation: " ++ int_to_string(Vault.get_or(t, "refused", 0)))
    println("node-b: every session Finished or Drained: "
      ++ bool_to_string(Vault.get_or(t, "finished", 0) + Vault.get_or(t, "drained", 0) == Vault.get_or(t, "started", 0)))
    println("node-b: v1 Buyer with a v1 Shop: " ++ seen("pair:1/1"))
    println("node-b: v2 Buyer with a v1 Shop: " ++ seen("pair:2/1"))
    println("node-b: v2 Buyer with a contract Shop: " ++ seen("pair:2/3"))
    println("node-b: v1 Buyer with a contract Shop: " ++ seen("pair:1/3"))
    println("node-b: later from a contract Shop: " ++ seen("later:3"))
    println("node-b: later from an expand Shop: " ++ seen("later:2"))
  end

  -- ── the two nodes ─────────────────────────────────────────────────────

  pfn run(host : Pid(ShopHostState), c : Cap(IO), h : Cap(ClusterNode.Live)) : () do
    tick(host, c, h)
    sleep_ms(200)
    run(host, c, h)
  end

  pfn drive(d : Pid(DriverState), c : Cap(IO), h : Cap(ClusterNode.Live), until : Int) : () do
    if unix_time_ms() >= until do ()
    else
      go(d, c, h)
      sleep_ms(150)
      drive(d, c, h, until)
    end
  end

  pfn settle(left : Int) : () do
    if settled() do ()
    else if left <= 0 do println("node-b: sessions still running at the end") else
      sleep_ms(50)
      settle(left - 50)
    end end
  end

  pfn offered(h : Cap(ClusterNode.Live), left : Int) : Bool do
    if List.any(ClusterNode.names(h), fn nm -> String.starts_with(nm, "ap:Order/2/")) && ClusterNode.link_count(h) >= 1 do true
    else if left <= 0 do false else
      sleep_ms(50)
      offered(h, left - 50)
    end end
  end

  -- A 15 s suspect timeout, not the default 3 s: a node stalls while its
  -- deploy is verified and activated (protocol_evolve's reason).
  pfn node_a(c : Cap(IO)) : () do
    let cfg = { ClusterNode.config("node-a", Env.require_int("MARCH_PORT_A"), "", Nil, "split-secret", 1) with swim: Swim.config(500, 15000, 2) }
    match ClusterNode.start(c, cfg) do
      Err(e) -> panic(e)
      Ok(h) ->
        let host = start_host()
        tick(host, c, h)
        sleep_ms(300)
        println("node-a: offering")
        run(host, c, h)
    end
  end

  pfn node_b(c : Cap(IO)) : () do
    let seed = "127.0.0.1:" ++ int_to_string(Env.require_int("MARCH_PORT_A"))
    let cfg = { ClusterNode.config("node-b", Env.require_int("MARCH_PORT_B"), "", Cons(seed, Nil), "split-secret", 1) with swim: Swim.config(500, 15000, 2) }
    match ClusterNode.start(c, cfg) do
      Err(e) -> panic(e)
      Ok(h) ->
        if ClusterNode.await_members(h, 1, 60000) do () else panic("node-b: never joined") end
        if offered(h, 60000) do () else panic("node-b: never saw the Shop offer") end
        let d = start_driver()
        println("node-b: driving")
        drive(d, c, h, unix_time_ms() + Env.get_int("SPLIT_DRIVE_MS", 22000))
        settle(30000)
        summary()
        -- Linger so the scenario can read this node's reload counters.
        sleep_ms(5000)
        ClusterNode.stop(h)
    end
  end

  fn main(c : Cap(IO)) do
    if Env.get("SPLIT_NODE", "a") == "b" do node_b(c) else node_a(c) end
  end
end
