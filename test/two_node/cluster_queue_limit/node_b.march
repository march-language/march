-- Scenario "cluster_queue_limit": node-b plays Server, sends the go-ahead,
-- and is then frozen by the scenario; see scenario.sh.
mod ClusterQueueLimitB do
  needs IO
  needs IO.Console
  needs IO.Mut
  needs IO.NetConnect
  needs IO.NetListen
  needs IO.Spawn
  needs IO.Clock
  needs Session.Live

  @[endpoints]
  protocol Bulk do
    Server -> Client : Int
    Client -> Server : String
    Client -> Server : String
    Client -> Server : String
    Server -> Client : Int
  end

  pfn pad(n : Int, acc : String) : String do
    if n <= 0 do acc else pad(n - 1, acc ++ "x") end
  end

  pfn role_server(s : Cap(Session.Live), st : Bulk_Server.S_send_Msg_Server_Client_1) : Bulk_Server.Yield do
    let st1 = Bulk_Server.send_Msg_Server_Client_1(s, st, 1)
    println("Server: sent go")
    Bulk_Server.recv_Msg_Client_Server_1(s, st1, fn (_m1, st2) ->
      Bulk_Server.recv_Msg_Client_Server_2(s, st2, fn (_m2, st3) ->
        Bulk_Server.recv_Msg_Client_Server_3(s, st3, fn (_m3, st4) ->
          Bulk_Server.close(s, Bulk_Server.send_Msg_Server_Client_2(s, st4, 2)))))
  end

  fn main(c : Cap(IO)) do
    let seed = "127.0.0.1:" ++ int_to_string(Env.require_int("MARCH_PORT_A"))
    let cfg = ClusterNode.config("node-b", Env.require_int("MARCH_PORT_B"), "", Cons(seed, Nil), "ql-secret", 1)
    match ClusterNode.start(cfg) do
      Err(e) -> panic(e)
      Ok(h) ->
        if ClusterNode.await_members(h, 1, 120000) do () else panic("node-b: never joined") end
        let _ = Bulk_Run.cluster_Server(c, h, "q1", fn (s, st) -> role_server(s, st))
        ClusterNode.stop(h)
    end
  end
end
