-- Two-node harness scenario "gone": a peer dies mid-session and the survivor's
-- `run` RETURNS `Err(PeerGone(role, _))` instead of hanging on it. A sends B
-- one message and waits for the reply; B is SIGKILLed before it answers.
-- A = 1 listens (GONE_A_ADDR); B = 2 dials.
-- Design: specs/progress/2026-09-16-role-runner.md, decision 2.
mod GoneNodeA do
  needs IO
  needs IO.Console
  needs IO.Mut
  needs IO.NetConnect
  needs IO.NetListen
  needs IO.Spawn
  needs Session.Live

  @[endpoints]
  protocol Gone do
    A -> B : Int
    B -> A : Int
  end

  pfn role_a(s : Cap(Session.Live), st : Gone_A.S_send_Msg_A_B_1) : Gone_A.Yield do
    println("A: sends 1")
    Gone_A.recv_Msg_B_A_1(s, Gone_A.send_Msg_A_B_1(s, st, 1), fn (n, st1) ->
      println("A: got " ++ int_to_string(n))
      Gone_A.close(s, st1))
  end

  fn main(c : Cap(IO)) do
    println("node-a: up")
    match Gone_Run.run_A(c, "node-a", "gone-secret", Gone_Run.addrs_from_env(), fn (s, st) -> role_a(s, st)) do
      Ok(_) -> println("A: clean end")
      Err(SessionNode.PeerGone(role, _)) -> println("A: role " ++ int_to_string(role) ++ " gone")
      Err(e) -> panic(SessionNode.run_error_message(e))
    end
  end
end
