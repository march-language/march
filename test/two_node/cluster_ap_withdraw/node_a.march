-- Scenario "cluster_ap_withdraw": node-a initiates the Ring session; see
-- scenario.sh.
mod ClusterApWithdrawA do
  needs IO
  needs IO.Console
  needs IO.Mut
  needs IO.NetConnect
  needs IO.NetListen
  needs IO.Spawn
  needs IO.Clock
  needs Session.Live

  @[endpoints]
  protocol Ring do
    A -> B : Int
    B -> C : Int
    C -> A : Int
  end

  pfn role_a(s : Cap(Session.Live), st : Ring_A.S_send_Msg_A_B_1) : Ring_A.Yield do
    let st1 = Ring_A.send_Msg_A_B_1(s, st, 7)
    Ring_A.recv_Msg_C_A_1(s, st1, fn (n, st2) ->
      println("A: round trip " ++ int_to_string(n))
      Ring_A.close(s, st2))
  end

  pfn attempt(c : Cap(IO), h : ClusterNode.ClusterHandle) : Bool do
    match Ring_Run.initiate_A(c, h, fn (s, st) -> role_a(s, st)) do
      Ok(_) -> true
      Err(_) -> false
    end
  end

  pfn attempt_retry(c : Cap(IO), h : ClusterNode.ClusterHandle, left : Int) : Bool do
    if attempt(c, h) do true
    else if left <= 0 do false else
      sleep_ms(500)
      attempt_retry(c, h, left - 500)
    end end
  end

  fn main(c : Cap(IO)) do
    let cfg = ClusterNode.config("node-a", Env.require_int("MARCH_PORT_A"), "", Nil, "apw-secret", 1)
    match ClusterNode.start(cfg) do
      Err(e) -> panic(e)
      Ok(h) ->
        println("node-a: up")
        if ClusterNode.await_members(h, 1, 120000) do () else panic("node-a: nobody joined") end
        -- Only B is offered: this attempt fills B, finds no C, and withdraws.
        if attempt(c, h) do panic("node-a: a session formed with no C") else () end
        println("Client: no session yet")
        -- node-c starts now; B's slot must be free again.
        if attempt_retry(c, h, 20000) do println("Client: session done") else panic("node-a: no session after node-c joined") end
        ClusterNode.stop(h)
    end
  end
end
