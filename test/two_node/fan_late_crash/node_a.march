-- Two-node harness scenario "fan_late_crash": node-a hosts role A of Fan (see
-- scenario.sh). A sends only once the scenario creates FAN_GO_FILE, which it
-- does after B is dead and C has seen its connection drop -- so C is still
-- waiting on A, with B's 9 parked, when B goes. A fixed delay does not do
-- this: the harness compiles each node as it starts it, so a delay measured
-- from A's start can expire before B even exists, and the protocol then
-- finishes before B is killed (that is how the first version of this
-- scenario passed on the runner it was meant to fail on).
mod FanLateCrashNodeA do
  needs IO
  needs IO.Console
  needs IO.FileRead
  needs IO.Mut
  needs IO.NetConnect
  needs IO.NetListen
  needs IO.Spawn
  needs Session.Live

  @[endpoints]
  protocol Fan do
    A -> C : Int
    B -> C : Int
    C -> A : Bool
  end

  pfn wait_for(path : String) : () do
    if File.exists(path) do ()
    else
      sleep_ms(50)
      wait_for(path)
    end
  end

  pfn role_a(s : Cap(Session.Live), st : Fan_A.S_send_Msg_A_C_1) : Fan_A.Yield do
    wait_for(Env.require("FAN_GO_FILE"))
    println("A: sends 7")
    let st1 = Fan_A.send_Msg_A_C_1(s, st, 7)
    Fan_A.recv_Msg_C_A_1(s, st1, fn (ok, st2) ->
      println("A: got " ++ bool_to_string(ok))
      Fan_A.close(s, st2))
  end

  fn main(c : Cap(IO)) do
    println("node-a: up")
    match Fan_Run.run_A(c, "node-a", "fan-secret", Fan_Run.addrs_from_env(), fn (s, st) -> role_a(s, st)) do
      Ok(_) -> println("A: closed")
      Err(SessionNode.Cancelled(role, cause)) ->
        println("A: cancelled waiting on role " ++ int_to_string(role) ++ ": " ++ cause)
      Err(e) -> panic(SessionNode.run_error_message(e))
    end
  end
end
