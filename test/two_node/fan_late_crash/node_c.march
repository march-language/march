-- Two-node harness scenario "fan_late_crash": node-c hosts role C. B's 9
-- arrives first and is parked; B's connection then drops. C is waiting on
-- A at that point, so nothing fails. When C reaches its receive from B, the
-- 9 is still queued, so it is delivered: the protocol completes.
mod FanLateCrashNodeC do
  needs IO
  needs IO.Console
  needs IO.Mut
  needs IO.NetConnect
  needs IO.NetListen
  needs IO.Spawn
  needs Session.Live

  @[endpoints]
  protocol Fan do
    A -> C : Int
    B -> C : Int
    C -> A : Bool
  end

  pfn role_c(s : Cap(Session.Live), st : Fan_C.S_recv_Msg_A_C_1) : Fan_C.Yield do
    Fan_C.recv_Msg_A_C_1(s, st, fn (a, st1) ->
      println("C: got " ++ int_to_string(a) ++ " from A")
      Fan_C.recv_Msg_B_C_1(s, st1, fn (b, st2) ->
        println("C: got " ++ int_to_string(b) ++ " from B")
        Fan_C.close(s, Fan_C.send_Msg_C_A_1(s, st2, a + b == 16))))
  end

  fn main(c : Cap(IO)) do
    println("node-c: up")
    match Fan_Run.run_C(c, "node-c", "fan-secret", Fan_Run.addrs_from_env(), fn (s, st) -> role_c(s, st)) do
      Ok(_) -> println("C: closed")
      Err(SessionNode.Cancelled(role, cause)) ->
        println("C: cancelled waiting on role " ++ int_to_string(role) ++ ": " ++ cause)
      Err(e) -> panic(SessionNode.run_error_message(e))
    end
  end
end
