-- Two-node scenario "drain_initiated": node-b serves no role. It installs
-- the SIGTERM drain, then initiates one Echo session as Client from a task
-- (as a pool hook's task would) and waits; the scenario sends SIGTERM while
-- the session waits for its answer. The drain must count that session:
-- "Client: got 70" is printed before node-b exits. See scenario.sh.
mod DrainInitiatedB do
  needs IO
  needs IO.Console
  needs IO.Mut
  needs IO.NetConnect
  needs IO.NetListen
  needs IO.Spawn
  needs IO.Clock
  needs IO.Signal
  needs Session.Live
  needs ClusterNode.Live

  @[endpoints]
  protocol Echo do
    Client -> Server : Int
    Server -> Client : Int
  end

  pfn ask(s : Cap(Session.Live), st : Echo_Client.S_send_Msg_Client_Server_1, n : Int) : Echo_Client.Yield do
    let st1 = Echo_Client.send_Msg_Client_Server_1(s, st, n)
    Echo_Client.recv_Msg_Server_Client_1(s, st1, fn (m, st2) ->
      println("Client: got " ++ int_to_string(m))
      Echo_Client.close(s, st2))
  end

  pfn session(c : Cap(IO), h : Cap(ClusterNode.Live)) : () do
    match Echo_Run.initiate_Client(c, h, fn (s, st) -> ask(s, st, 7)) do
      Ok(_) -> ()
      Err(e) -> println("Client: " ++ SessionNode.run_error_message(e))
    end
  end

  pfn idle() : () do
    sleep_ms(250)
    idle()
  end

  fn main(c : Cap(IO)) do
    let seed = "127.0.0.1:" ++ int_to_string(Env.require_int("MARCH_PORT_A"))
    let cfg = ClusterNode.config("node-b", Env.require_int("MARCH_PORT_B"), "", Cons(seed, Nil), "drain-init-secret", 1)
    match ClusterNode.start(c, cfg) do
      Err(e) -> panic(e)
      Ok(h) ->
        if ClusterNode.await_members(h, 1, 120000) do () else panic("node-b: never joined") end
        Topology.drain_on_signal(h, 10000, 30000)
        let _ = task_spawn(fn _ -> session(c, h))
        -- The drain exits the process.
        idle()
    end
  end
end
