-- Two-node scenario "drain_initiated": node-a offers role Server of Echo and
-- answers the number times 10, after 2 s, so the session is still running
-- when node-b is sent SIGTERM. It stops once it has served one session. See
-- scenario.sh.
mod DrainInitiatedA do
  needs IO
  needs IO.Console
  needs IO.Mut
  needs IO.NetConnect
  needs IO.NetListen
  needs IO.Spawn
  needs IO.Clock
  needs Session.Live

  @[endpoints]
  protocol Echo do
    Client -> Server : Int
    Server -> Client : Int
  end

  pfn serve_one(s : Cap(Session.Live), st : Echo_Server.S_recv_Msg_Client_Server_1, served : Vault(Int)) : Echo_Server.Yield do
    Echo_Server.recv_Msg_Client_Server_1(s, st, fn (n, st1) ->
      println("Server: got " ++ int_to_string(n))
      sleep_ms(2000)
      let st2 = Echo_Server.send_Msg_Server_Client_1(s, st1, n * 10)
      let _ = Vault.incr(served, "n", 1)
      Echo_Server.close(s, st2))
  end

  pfn wait_served(served : Vault(Int), left : Int) : Bool do
    if Vault.get_or(served, "n", 0) >= 1 do true
    else if left <= 0 do false else
      sleep_ms(50)
      wait_served(served, left - 50)
    end end
  end

  fn main(c : Cap(IO)) do
    let cfg = ClusterNode.config("node-a", Env.require_int("MARCH_PORT_A"), "", Nil, "drain-init-secret", 1)
    match ClusterNode.start(c, cfg) do
      Err(e) -> panic(e)
      Ok(h) ->
        let served = Vault.new("served")
        println("node-a: offering")
        match Echo_Run.offer_Server(c, h, 4, fn (s, st) -> serve_one(s, st, served)) do
          Err(e) -> panic(Echo_Run.error_message(e))
          Ok(o) ->
            if wait_served(served, 120000) do () else panic("node-a: never served a session") end
            -- Let the answer reach node-b before stopping.
            sleep_ms(500)
            SessionNode.close_offer(o)
            ClusterNode.stop(h)
        end
    end
  end
end
