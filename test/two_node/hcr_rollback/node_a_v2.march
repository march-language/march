mod Rollback do
  needs IO.Console
  needs IO.Spawn
  needs IO.Clock

  actor Counter do
    state { count : Int, announced : Bool, label : String }
    init { count: 0, announced: false, label: "v2" }
    on Tick() do
      let _ = if state.announced do () else Authority.ignore(println("behavior: bad")) end
      { count: state.count + 1, announced: true, label: state.label }
    end
    on Finish() do
      println("all work preserved: " ++ bool_to_string(state.count == 150))
      state
    end
  end

  fn counter_migrate_state(old : { count : Int, announced : Bool }) : { count : Int, announced : Bool, label : String } do
    { count: old.count, announced: false, label: "v2" }
  end

  fn main(_c : Cap(IO.Console), _s : Cap(IO.Spawn), _k : Cap(IO.Clock)) : Unit do
    let counter = spawn(Counter)
    println("ready")
    List.each(List.range(0, 150), fn _ ->
      send(counter, Tick)
      sleep_ms(100))
    send(counter, Finish)
    sleep_ms(500)
  end
end
