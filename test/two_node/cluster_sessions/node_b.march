-- Two-node harness, scenario "cluster_sessions": node-b hosts role B of both
-- sessions, concurrently, and answers each with its number times 3. See
-- node_a.march.
mod ClusterSessionsB do
  needs IO
  needs IO.Console
  needs IO.Mut
  needs IO.NetConnect
  needs IO.NetListen
  needs IO.Spawn
  needs IO.Clock
  needs Session.Live
  needs ClusterNode.Live

  @[endpoints]
  protocol Echo do
    A -> B : Int
    B -> A : Int
  end

  pfn role_b(s : Cap(Session.Live), st : Echo_B.S_recv_Msg_A_B_1) : Echo_B.Yield do
    Echo_B.recv_Msg_A_B_1(s, st, fn (n, st1) ->
      Echo_B.close(s, Echo_B.send_Msg_B_A_1(s, st1, n * 3)))
  end

  pfn session(c : Cap(IO), h : Cap(ClusterNode.Live), sid : String) : Int do
    match Echo_Run.cluster_B(c, h, sid, fn (s, st) -> role_b(s, st)) do
      Ok(_) -> 1
      Err(_) -> 0
    end
  end

  fn main(c : Cap(IO)) do
    let seed = "127.0.0.1:" ++ int_to_string(Env.require_int("MARCH_PORT_A"))
    let cfg = ClusterNode.config("node-b", Env.require_int("MARCH_PORT_B"), "", Cons(seed, Nil), "echo-secret", 1)
    match ClusterNode.start(c, cfg) do
      Err(e) -> panic(e)
      Ok(h) ->
        println("node-b: up")
        if ClusterNode.await_members(h, 1, 120000) do () else panic("node-b: never joined") end
        let t1 = task_spawn(fn _ -> session(c, h, "s1"))
        let t2 = task_spawn(fn _ -> session(c, h, "s2"))
        let ok = task_await_unwrap(t1) + task_await_unwrap(t2)
        println("B: sessions completed " ++ int_to_string(ok))
        ClusterNode.stop(h)
    end
  end
end
