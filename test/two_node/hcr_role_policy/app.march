-- The app of scenario "hcr_role_policy": a topology app (no `main`; it is
-- generated from the topology the scenario writes) with two pools. `back`
-- serves Echo.Server, bound to the function Back.serve_one, whose own caps
-- hold the session it is handed (caps=...,Session.Live in the manifest);
-- `front` asks it for 4 every 150 ms and prints each new answer, until the
-- stop file exists.
--
-- The scenario makes each version by rewriting the lines marked `-- ANSWER`
-- and `-- AUDIT` (scenario.sh). Version 1 answers n * 10. Every version
-- reads the mark a Vault holds, which version 1's code set in the base
-- build, and the patched versions add it to their answer, so a patch whose
-- code ran against a vault registry of its own would answer without it.
mod RoleApp do
  needs IO
  needs IO.Console
  needs IO.Mut
  needs IO.NetConnect
  needs IO.NetListen
  needs IO.Spawn
  needs IO.Clock
  needs Session.Live
  needs ClusterNode.Live

  @[endpoints]
  protocol Echo do
    role Server needs IO.Console, IO.Mut
    ask: Client -> Server : Int
    answer: Server -> Client : Int
  end

  -- Loop boundaries expose stale endpoint epochs: a freshly accepted
  -- hosted session must not drain merely because its saved offer is old.
  @[endpoints]
  protocol HostedEcho do
    loop do
      ask: Client -> Server : Int
      choose by Server:
        more -> Server -> Client : Int
        done -> Server -> Client : Int
                stop
      end
    end
  end

  -- ── the back pool ────────────────────────────────────────────────────

  mod Back do
    needs IO.Console
    needs IO.Mut
    needs Session.Live
    needs ClusterNode.Live
    needs IO.FileWrite

    -- Reached by no role (only by front's exit path, which never runs on a
    -- back node): a function a patch can widen (version 4 makes it write a
    -- file) without the compiler's role grant check seeing it, so only the
    -- node's policy stands in the way. Reached at all, so the base build
    -- has a dispatch slot for it.
    fn audit(_path : String) : Int do 0 end -- AUDIT

    type Env = { factor : Int }

    fn start(_con : Cap(IO.Console), _node : Cap(ClusterNode.Live)) : Env do
      Authority.ignore(println("back: hook ran"))
      { factor: 10 }
    end

    -- The table version 1 writes the mark into (in the base build).
    fn marks() : Vault(Int) do
      match Authority.must(Vault.whereis("role_app_marks")) do
        Some(t) -> t
        None -> Authority.must(Vault.new("role_app_marks"))
      end
    end

    fn mark() : Int do
      let t = marks()
      match Vault.get(t, "mark") do
        Some(m) -> m
        None ->
          Vault.set(t, "mark", 7)
          0
      end
    end

    fn serve_one(env : Env, s : Cap(Session.Live), _con : Cap(IO.Console), _mut : Cap(IO.Mut), st : Echo_Server.Entry) : Echo_Server.Yield do
      Echo_Server.recv_Ask(s, st, fn (n, st1) ->
        let m = mark()
        let a = n * env.factor + m * 0 -- ANSWER
        Echo_Server.close(s, Echo_Server.send_Answer(s, st1, a)))
    end
    actor HostedServer do
      state { factor : Int, sessions : LinearMap(String, HostedEcho_Server.Parked_Server) }
      init(env : Env) { factor: env.factor, sessions: LinearMap.empty_string() }
      on Start(sid : String, s : Cap(Session.Live)) do
        let parked = HostedEcho_Server.await_Ask(s, HostedEcho_Server.register(s, 0))
        match LinearMap.put(state.sessions, sid, parked) do
          (None, m) -> { state with sessions: m }
          (Some(old), m) ->
            HostedEcho_Server.take_closed(HostedEcho_Server.cancel(s, old))
            { state with sessions: m }
        end
      end
      on Deliver(sid : String, s : Cap(Session.Live), from : Int, msg : Bytes, ep : Int) do
        match LinearMap.take_slot(state.sessions, sid) do
          (None, slot) -> { state with sessions: LinearMap.vacate(slot) }
          (Some(parked), slot) ->
            match HostedEcho_Server.resume(parked, from, msg, ep) do
              HostedEcho_Server.Got_Ask(n, st) ->
                let env = { factor: state.factor }
                let m = mark()
                let a = n * env.factor + m * 0 -- ANSWER
                if n >= 4 do
                  HostedEcho_Server.take_closed(HostedEcho_Server.finish(s, HostedEcho_Server.choose_done(s, st, a)))
                  { state with sessions: LinearMap.vacate(slot) }
                else
                  let st2 = HostedEcho_Server.choose_more(s, st, a)
                  { state with sessions: LinearMap.fill(slot, HostedEcho_Server.await_Ask(s, st2)) }
                end
            end
        end
      end
      on Cancel(sid : String, s : Cap(Session.Live), _role : Int, _cause : String, _ep : Int) do
        match LinearMap.take(state.sessions, sid) do
          (None, m) -> { state with sessions: m }
          (Some(parked), m) ->
            HostedEcho_Server.take_closed(HostedEcho_Server.cancel(s, parked))
            { state with sessions: m }
        end
      end
    end

  end

  -- ── the front pool ───────────────────────────────────────────────────

  mod Front do
    needs IO
    needs IO.Console
    needs IO.Clock
    needs IO.Spawn
    needs Session.Live
    needs ClusterNode.Live

    type Env = { started : Bool }

    fn start(io : Cap(IO), node : Cap(ClusterNode.Live)) : Env do
      let _ = task_spawn(fn _ -> run(io, node, 0, 0))
      { started: true }
    end

    -- Ask, print an answer that differs from the last one printed, and go
    -- again, until $ROLE_APP_STOP exists.
    fn run(io : Cap(IO), node : Cap(ClusterNode.Live), last : Int, hosted_last : Int) : Int do
      let stop = Authority.must(Env.get("ROLE_APP_STOP", ""))
      if stop != "" && Authority.must(File.exists(stop)) do
        Authority.ignore(println("front: done"))
        Back.audit(stop) * 0
      else
        let next = match echo(io, node, 4) do
          Some(v) ->
            if v != last do
              Authority.ignore(println("front: answer " ++ int_to_string(v)))
              v
            else last end
          None -> last
        end
        let hosted_next = match hosted_echo(io, node) do
          Some(v) ->
            if v != hosted_last do Authority.ignore(println("front: hosted answer " ++ int_to_string(v))) else () end
            v
          None -> hosted_last
        end
        sleep_ms(150)
        run(io, node, next, hosted_next)
      end
    end

    fn hosted_client(s : Cap(Session.Live), st : HostedEcho_Client.Entry, got : Vault(Int), n : Int)
        : HostedEcho_Client.Yield do
      HostedEcho_Client.offer_more_done(s, HostedEcho_Client.send_Ask(s, st, n),
        fn (_v, st2) -> hosted_client(s, st2, got, n + 1),
        fn (v, st2) ->
          Vault.set(got, "v", v)
          HostedEcho_Client.close(s, st2))
    end

    fn hosted_echo(io : Cap(IO), node : Cap(ClusterNode.Live)) : Option(Int) do
      let got = Authority.must(Vault.new("front_hosted_echo"))
      match HostedEcho_Run.initiate_Client(node, fn (s, st) -> hosted_client(s, st, got, 3)) do
        Ok(_) -> Vault.get(got, "v")
        Err(_) -> None
      end
    end

    fn echo(io : Cap(IO), node : Cap(ClusterNode.Live), n : Int) : Option(Int) do
      let got = Authority.must(Vault.new("front_echo"))
      match Echo_Run.initiate_Client(node, fn (s, st) ->
          Echo_Client.recv_Answer(s, Echo_Client.send_Ask(s, st, n), fn (m, st2) ->
            Vault.set(got, "v", m)
            Echo_Client.close(s, st2))) do
        Ok(_) -> Vault.get(got, "v")
        Err(_) -> None
      end
    end
  end
end
