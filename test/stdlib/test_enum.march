-- Tests for the Enum stdlib module (higher-order list operations)
-- Run with: dune exec march -- test test/stdlib/test_enum.march

mod TestEnum do

describe "Enum" do

  describe "map" do

    test "map double" do
      let xs = Cons(1, Cons(2, Cons(3, Nil)))
      let doubled = Enum.map(xs, fn x -> x * 2)
      assert (head(doubled) == 2)
      assert (head(tail(doubled)) == 4)
      assert (head(tail(tail(doubled))) == 6)
    end

    test "map empty" do
      let result = Enum.map(Nil, fn (x : Int) -> x * 2)
      assert (length(result) == 0)
    end

    test "map to string" do
      let xs = Cons(1, Cons(2, Nil))
      let strs = Enum.map(xs, fn x -> int_to_string(x))
      assert (head(strs) == "1")
    end

  end

  describe "flat_map" do

    test "flat_map basic" do
      let xs = Cons(1, Cons(2, Cons(3, Nil)))
      let result = Enum.flat_map(xs, fn x -> Cons(x, Cons(x * 10, Nil)))
      assert (length(result) == 6)
      assert (head(result) == 1)
    end

    test "flat_map empty" do
      let result = Enum.flat_map(Nil, fn (x : Int) -> Cons(x, Nil))
      assert (length(result) == 0)
    end

  end

  describe "filter" do

    test "filter even" do
      let xs = Cons(1, Cons(2, Cons(3, Cons(4, Nil))))
      let evens = Enum.filter(xs, fn x -> int_mod(x, 2) == 0)
      assert (length(evens) == 2)
      assert (head(evens) == 2)
    end

    test "filter all pass" do
      let xs = Cons(1, Cons(2, Nil))
      let result = Enum.filter(xs, fn _ -> true)
      assert (length(result) == 2)
    end

    test "filter none pass" do
      let xs = Cons(1, Cons(2, Nil))
      let result = Enum.filter(xs, fn _ -> false)
      assert (length(result) == 0)
    end

    test "filter preserves order" do
      assert (Enum.filter([5, 1, 4, 2, 3, 6], fn x -> x > 2) == [5, 4, 3, 6])
    end

    test "filter keeps duplicates in place" do
      assert (Enum.filter([3, 1, 3, 2, 3], fn x -> x == 3) == [3, 3, 3])
    end

    test "filter empty" do
      let empty : List(Int) = Nil
      assert (Enum.filter(empty, fn x -> x > 0) == Nil)
    end

    test "filter all pass is the input" do
      assert (Enum.filter([4, 2, 9], fn x -> x > 0) == [4, 2, 9])
    end

    test "filter all fail is empty" do
      assert (Enum.filter([4, 2, 9], fn x -> x < 0) == Nil)
    end

    test "filter a long list" do
      let xs = List.range(0, 100000)
      let ys = Enum.filter(xs, fn x -> x % 2 == 0)
      assert (length(ys) == 50000)
      assert (head(ys) == 0)
      assert (List.last(ys) == 99998)
    end

  end

  describe "fold" do

    test "fold sum" do
      let xs = Cons(1, Cons(2, Cons(3, Cons(4, Nil))))
      let sum = Enum.fold(xs, 0, fn acc -> fn x -> acc + x)
      assert (sum == 10)
    end

    test "fold product" do
      let xs = Cons(1, Cons(2, Cons(3, Cons(4, Nil))))
      let prod = Enum.fold(xs, 1, fn acc -> fn x -> acc * x)
      assert (prod == 24)
    end

    test "fold empty" do
      let result = Enum.fold(Nil, 0, fn acc -> fn (x : Int) -> acc + x)
      assert (result == 0)
    end

  end

  describe "reduce" do

    test "reduce sum" do
      let xs = Cons(1, Cons(2, Cons(3, Nil)))
      match Enum.reduce(xs, fn a -> fn b -> a + b) do
      None -> panic("FAIL: reduce sum returned None")
      Some(v) -> assert (v == 6)
      end
    end

    test "reduce single" do
      match Enum.reduce(Cons(42, Nil), fn a -> fn b -> a + b) do
      None -> panic("FAIL: reduce single returned None")
      Some(v) -> assert (v == 42)
      end
    end

    test "reduce empty returns None" do
      match Enum.reduce(Nil, fn (a : Int) -> fn b -> a + b) do
      None -> ()
      Some(_) -> panic("FAIL: reduce empty should return None")
      end
    end

  end

  describe "count" do

    test "count" do
      let xs = Cons(1, Cons(2, Cons(3, Nil)))
      assert (Enum.count(xs) == 3)
    end

    test "count empty" do
      assert (Enum.count(Nil) == 0)
    end

  end

  describe "any and all" do

    test "any true" do
      let xs = Cons(1, Cons(2, Cons(3, Nil)))
      assert Enum.any(xs, fn x -> x > 2)
    end

    test "any false" do
      let xs = Cons(1, Cons(2, Cons(3, Nil)))
      assert not(Enum.any(xs, fn x -> x > 10))
    end

    test "all true" do
      let xs = Cons(1, Cons(2, Cons(3, Nil)))
      assert Enum.all(xs, fn x -> x > 0)
    end

    test "all false" do
      let xs = Cons(1, Cons(2, Cons(3, Nil)))
      assert not(Enum.all(xs, fn x -> x > 1))
    end

  end

  describe "find" do

    test "find existing" do
      let xs = Cons(1, Cons(2, Cons(3, Nil)))
      match Enum.find(xs, fn x -> x > 1) do
      None -> panic("FAIL: find existing returned None")
      Some(v) -> assert (v == 2)
      end
    end

    test "find not found" do
      let xs = Cons(1, Cons(2, Nil))
      match Enum.find(xs, fn x -> x > 10) do
      None -> ()
      Some(_) -> panic("FAIL: find not found returned Some")
      end
    end

    test "find returns the FIRST match" do
      assert (Enum.find([1, 7, 3, 9], fn x -> x > 2) == Some(7))
    end

    test "find on empty" do
      let empty : List(Int) = Nil
      assert (Enum.find(empty, fn x -> x > 0) == None)
    end

  end

  describe "take_while" do

    test "take_while stops at the first failure" do
      assert (Enum.take_while([1, 2, 3, 4, 1], fn x -> x < 3) == [1, 2])
    end

    test "take_while empty" do
      let empty : List(Int) = Nil
      assert (Enum.take_while(empty, fn x -> x > 0) == Nil)
    end

    test "take_while all pass is the input" do
      assert (Enum.take_while([3, 1, 2], fn x -> x > 0) == [3, 1, 2])
    end

    test "take_while first fails is empty" do
      assert (Enum.take_while([0, 1, 2], fn x -> x > 0) == Nil)
    end

    test "take_while a long prefix" do
      let xs = List.range(0, 100000)
      let ys = Enum.take_while(xs, fn x -> x < 60000)
      assert (length(ys) == 60000)
      assert (List.last(ys) == 59999)
    end

  end

  describe "Range.filter" do

    test "Range.filter preserves order" do
      assert (Range.filter(Range.new(0, 10), fn x -> x % 3 == 0) == [0, 3, 6, 9])
    end

    test "Range.filter empty range" do
      assert (Range.filter(Range.new(5, 5), fn x -> x > 0) == Nil)
    end

    test "Range.filter all pass" do
      assert (Range.filter(Range.new(1, 4), fn x -> x > 0) == [1, 2, 3])
    end

    test "Range.filter all fail" do
      assert (Range.filter(Range.new(1, 4), fn x -> x > 10) == Nil)
    end

  end

  describe "zip_with" do

    test "zip_with basic" do
      let xs = Cons(1, Cons(2, Cons(3, Nil)))
      let ys = Cons(10, Cons(20, Cons(30, Nil)))
      let result = Enum.zip_with(xs, ys, fn x -> fn y -> x + y)
      assert (head(result) == 11)
      assert (length(result) == 3)
    end

  end

  describe "sort_by" do

    test "sort_by ascending" do
      let xs = Cons(3, Cons(1, Cons(2, Nil)))
      let sorted = Enum.sort_by(xs, fn a -> fn b -> a < b)
      assert (head(sorted) == 1)
      assert (head(tail(sorted)) == 2)
      assert (head(tail(tail(sorted))) == 3)
    end

    test "sort_by descending" do
      let xs = Cons(1, Cons(3, Cons(2, Nil)))
      let sorted = Enum.sort_by(xs, fn a -> fn b -> a > b)
      assert (head(sorted) == 3)
    end

  end

end

end
