-- test/stdlib/test_http_transport.march
-- Tests for the HttpTransport stdlib module.
-- Only tests the pure/structural parts (error type constructors, etc.).
-- Network I/O functions are not exercised here.
-- Run with: dune exec march -- test test/stdlib/test_http_transport.march

mod TestHttpTransport do

  needs IO.NetConnect
  needs IO.NetConnect.TLS
  needs IO.NetListen

-- A closed Socket: request_on / stream_request_on must refuse https before
-- they touch the socket, so any Socket will do; a closed one proves it.
pfn closed_socket() do
  match Socket.listen(0) do
  Err(e) -> panic("listen: " ++ Socket.error_message(e))
  Ok(l) ->
    let port = match Socket.local_port(l) do
      Ok(p) -> p
      Err(e) -> panic("local_port: " ++ Socket.error_message(e))
    end
    match Socket.connect("127.0.0.1", port) do
    Err(e) -> panic("connect: " ++ Socket.error_message(e))
    Ok(s) ->
      let _ = Socket.close(s)
      let _ = Socket.close_listener(l)
      s
    end
  end
end

-- Local error values exercise the constructor shape independently of the
-- transport. Tests of HttpTransport itself use its qualified constructors.
ptype TransportError =
  ConnectionRefused(String)
  | ConnTimeout(String)
  | SendError(String)
  | RecvError(String)
  | ConnParseError(String)
  | Closed
  | SchemeNotSupported(String)

pfn show_error(e) do
  match e do
  ConnectionRefused(s) -> "refused:" ++ s
  ConnTimeout(s)       -> "timeout:" ++ s
  SendError(s)         -> "send:" ++ s
  RecvError(s)         -> "recv:" ++ s
  ConnParseError(s)    -> "parse:" ++ s
  Closed               -> "closed"
  SchemeNotSupported(s) -> "scheme:" ++ s
  end
end

describe "TransportError constructors" do
  test "ConnectionRefused stores message" do
    let e = ConnectionRefused("localhost:8080")
    match e do
    ConnectionRefused(msg) -> assert (msg == "localhost:8080")
    _ -> assert false
    end
  end

  test "ConnTimeout stores message" do
    let e = ConnTimeout("timed out after 30s")
    match e do
    ConnTimeout(msg) -> assert (msg == "timed out after 30s")
    _ -> assert false
    end
  end

  test "SendError stores message" do
    let e = SendError("broken pipe")
    match e do
    SendError(msg) -> assert (msg == "broken pipe")
    _ -> assert false
    end
  end

  test "RecvError stores message" do
    let e = RecvError("connection reset")
    match e do
    RecvError(msg) -> assert (msg == "connection reset")
    _ -> assert false
    end
  end

  test "ConnParseError stores message" do
    let e = ConnParseError("unexpected EOF")
    match e do
    ConnParseError(msg) -> assert (msg == "unexpected EOF")
    _ -> assert false
    end
  end

  test "Closed constructor" do
    let e = Closed
    match e do
    Closed -> ()
    _ -> assert false
    end
  end
end

describe "TransportError pattern matching" do
  test "match ConnectionRefused" do
    assert (show_error(ConnectionRefused("h")) == "refused:h")
  end

  test "match ConnTimeout" do
    assert (show_error(ConnTimeout("t")) == "timeout:t")
  end

  test "match SendError" do
    assert (show_error(SendError("s")) == "send:s")
  end

  test "match RecvError" do
    assert (show_error(RecvError("r")) == "recv:r")
  end

  test "match ConnParseError" do
    assert (show_error(ConnParseError("p")) == "parse:p")
  end

  test "match Closed" do
    assert (show_error(Closed) == "closed")
  end
end

describe "https transport dispatch" do
  test "request sends https through TLS instead of rejecting its scheme" do
    let req = Request(Get, SchemeHttps, "127.0.0.1", Some(1), "/", None, Nil, "")
    match HttpTransport.request(req) do
    Err(HttpTransport.SchemeNotSupported(_)) -> assert false
    Err(_) -> assert true
    Ok(_) -> assert true
    end
  end

  test "simple_get sends https through TLS instead of rejecting its scheme" do
    match HttpTransport.simple_get("https://127.0.0.1:1/") do
    Err(HttpTransport.SchemeNotSupported(_)) -> assert false
    Err(_) -> assert true
    Ok(_) -> assert true
    end
  end

  test "request_on rejects https request with SchemeNotSupported" do
    -- The socket is closed, but the scheme check comes first.
    let req = Request(Get, SchemeHttps, "example.com", None, "/", None, Nil, "")
    match HttpTransport.request_on(closed_socket(), req) do
    Err(HttpTransport.SchemeNotSupported(_)) -> ()
    Err(_) -> assert false
    Ok(_)  -> assert false
    end
  end

  test "stream_request_on rejects https request with SchemeNotSupported" do
    let req = Request(Get, SchemeHttps, "example.com", None, "/", None, Nil, "")
    match HttpTransport.stream_request_on(closed_socket(), req, fn _ -> ()) do
    Err(HttpTransport.SchemeNotSupported(_)) -> ()
    Err(_) -> assert false
    Ok(_)  -> assert false
    end
  end

  test "connect rejects https request with SchemeNotSupported" do
    let req = Request(Get, SchemeHttps, "example.com", None, "/", None, Nil, "")
    match HttpTransport.connect(req) do
    Err(HttpTransport.SchemeNotSupported(_)) -> ()
    Err(_) -> assert false
    Ok(_)  -> assert false
    end
  end

end


describe "HttpTransport scope guard" do
  test "simple_get_scoped refuses an out-of-scope URL before connecting" do
    -- `.invalid` never resolves, so a wrongful connect would show up as a
    -- connection error, not as Refused.
    match HttpTransport.simple_get_scoped("https://other.invalid/x", "a.invalid/v1/") do
    Err(HttpTransport.Refused(_)) -> ()
    _ -> assert false
    end
  end

  test "simple_get_scoped refuses a path outside the prefix" do
    match HttpTransport.simple_get_scoped("https://a.invalid/v2/x", "a.invalid/v1/") do
    Err(HttpTransport.Refused(m)) -> assert (string_contains(m, "/v2/x"))
    _ -> assert false
    end
  end
end

describe "request smuggling is refused before connecting" do
  -- Port 1 on loopback refuses connections, so a wrongful connect would show
  -- up as a connection/handshake error rather than the serializer's refusal.
  test "HttpTransport.request refuses a CRLF in the path" do
    let req = Request(Get, SchemeHttp, "127.0.0.1", Some(1),
                      "/x HTTP/1.1\r\nHost: h\r\n\r\nDELETE /admin", None, Nil, "")
    match HttpTransport.request(req) do
    Err(HttpTransport.Refused(m)) -> assert (string_contains(m, "http request rejected: path"))
    _ -> assert false
    end
  end

  test "HttpTransport.request refuses a CRLF in a header value" do
    let req = Request(Get, SchemeHttp, "127.0.0.1", Some(1), "/",
                      None, Cons(Header("X-A", "v\r\nX-Injected: 1"), Nil), "")
    match HttpTransport.request(req) do
    Err(HttpTransport.Refused(m)) -> assert (string_contains(m, "header value"))
    _ -> assert false
    end
  end

  test "Tls.https_get refuses a CRLF in the path" do
    match Tls.https_get("127.0.0.1", 1, "/x HTTP/1.1\r\nHost: h\r\n\r\nDELETE /admin") do
    Err(Tls.TlsWriteError(m)) -> assert (string_contains(m, "http request rejected: path"))
    _ -> assert false
    end
  end
end

end
