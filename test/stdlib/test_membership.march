mod TestMembership do

  pfn status_of(ms : Membership.Members, id : String) : Membership.MemberStatus do
    match Membership.get(ms, id) do
      Some(m) -> m.status
      None -> Membership.Dead   -- unreachable in these tests
    end
  end

  pfn inc_of(ms : Membership.Members, id : String) : Int do
    match Membership.get(ms, id) do
      Some(m) -> m.incarnation
      None -> -1
    end
  end

  describe "Membership.observe" do

    test "records a new member" do
      let ms = Membership.observe(Membership.empty(), Membership.alive("a", 1))
      assert (Membership.size(ms) == 1)
      assert (Membership.get(ms, "a") == Some(Membership.alive("a", 1)))
    end

    test "higher incarnation wins (refutation)" do
      -- a is suspected at inc 1, then refutes with alive at inc 2
      let ms = Membership.observe(
                 Membership.observe(Membership.empty(), Membership.suspect("a", 1)),
                 Membership.alive("a", 2))
      assert (status_of(ms, "a") == Alive)
      assert (inc_of(ms, "a") == 2)
    end

    test "stale lower-incarnation observation is ignored" do
      let ms = Membership.observe(
                 Membership.observe(Membership.empty(), Membership.alive("a", 5)),
                 Membership.suspect("a", 3))
      assert (status_of(ms, "a") == Alive)
      assert (inc_of(ms, "a") == 5)
    end

    test "same incarnation: Suspect beats Alive" do
      let ms = Membership.observe(
                 Membership.observe(Membership.empty(), Membership.alive("a", 4)),
                 Membership.suspect("a", 4))
      assert (status_of(ms, "a") == Suspect)
    end

    test "same incarnation: Dead beats Suspect" do
      let ms = Membership.observe(
                 Membership.observe(Membership.empty(), Membership.suspect("a", 4)),
                 Membership.dead("a", 4))
      assert (status_of(ms, "a") == Dead)
    end

    test "restarted node (higher incarnation) overrides Dead" do
      let ms = Membership.observe(
                 Membership.observe(Membership.empty(), Membership.dead("a", 2)),
                 Membership.alive("a", 3))
      assert (status_of(ms, "a") == Alive)
      assert (inc_of(ms, "a") == 3)
    end

  end

  describe "Membership.merge (CRDT join)" do

    test "is commutative on conflicting views" do
      let a = Membership.observe(Membership.empty(), Membership.alive("x", 2))
      let b = Membership.observe(Membership.empty(), Membership.suspect("x", 1))
      -- both orders converge to the higher-incarnation winner
      assert (status_of(Membership.merge(a, b), "x") == Alive)
      assert (status_of(Membership.merge(b, a), "x") == Alive)
    end

    test "is idempotent" do
      let a = Membership.observe(
                Membership.observe(Membership.empty(), Membership.alive("x", 1)),
                Membership.suspect("y", 2))
      assert (Membership.size(Membership.merge(a, a)) == 2)
      assert (status_of(Membership.merge(a, a), "y") == Suspect)
    end

    test "unions distinct members" do
      let a = Membership.observe(Membership.empty(), Membership.alive("x", 1))
      let b = Membership.observe(Membership.empty(), Membership.alive("y", 1))
      assert (Membership.size(Membership.merge(a, b)) == 2)
    end

  end

  describe "Membership.alive_members" do

    test "returns only Alive members" do
      let ms = Membership.observe(
                 Membership.observe(Membership.empty(), Membership.alive("x", 1)),
                 Membership.dead("y", 1))
      assert (List.length(Membership.alive_members(ms)) == 1)
    end

  end


  describe "Membership origin fields (the node service)" do

    test "a later creation outranks any verdict about the previous life" do
      let dead_old = Membership.member("a", "node-a", "h:1", 1, Membership.Dead, 9)
      let alive_new = Membership.member("a", "node-a", "h:2", 2, Membership.Alive, 1)
      let ms1 = Membership.observe(Membership.observe(Membership.empty(), dead_old), alive_new)
      let ms2 = Membership.observe(Membership.observe(Membership.empty(), alive_new), dead_old)
      assert (status_of(ms1, "a") == Alive)
      assert (status_of(ms2, "a") == Alive)
      match Membership.get(ms2, "a") do
        Some(m) -> assert (m.addr == "h:2" && m.creation == 2)
        None -> assert false
      end
    end

    test "a verdict carries the origin the view holds" do
      let ms = Membership.observe(Membership.empty(), Membership.member("a", "node-a", "h:1", 3, Membership.Alive, 4))
      let v = Membership.verdict(ms, "a", Membership.Suspect, 4)
      assert (v.creation == 3 && v.addr == "h:1" && v.name == "node-a")
      assert (status_of(Membership.observe(ms, v), "a") == Suspect)
    end

    test "an origin-less verdict does not outrank a known later creation" do
      let ms = Membership.observe(Membership.empty(), Membership.member("a", "node-a", "h:1", 3, Membership.Alive, 1))
      assert (status_of(Membership.observe(ms, Membership.dead("a", 50)), "a") == Alive)
    end

  end

end
