mod TestRingBuf do

  -- RingBuf is always_linear: every operation consumes the buffer and hands
  -- it back (mutators return it, readers return it beside their answer), and
  -- every test ends its buffer with to_list or drop. Part C, Phase C2 of
  -- specs/plans/2026-09-25-send-data-race-freedom-plan.md. The compiled twin
  -- is test/native/ring_buf_ops.march; the two backends must agree.

  pfn push_all(rb : RingBuf(Int), xs : List(Int)) : RingBuf(Int) do
    List.fold_left(xs, rb, fn (acc, x) -> RingBuf.push(acc, x))
  end

  describe "make / cap / is_empty" do

    test "cap is preserved" do
      let (c, rb) = RingBuf.cap(RingBuf.make(8))
      RingBuf.drop(rb)
      assert (c == 8)
    end

    test "starts empty" do
      let (e, rb) = RingBuf.is_empty(RingBuf.make(4))
      RingBuf.drop(rb)
      assert e
    end

    test "size starts at zero" do
      let (n, rb) = RingBuf.size(RingBuf.make(4))
      RingBuf.drop(rb)
      assert (n == 0)
    end

    test "peek_oldest on empty is None" do
      let (x, rb) = RingBuf.peek_oldest(RingBuf.make(4))
      RingBuf.drop(rb)
      assert (x == None)
    end

    test "peek_newest on empty is None" do
      let (x, rb) = RingBuf.peek_newest(RingBuf.make(4))
      RingBuf.drop(rb)
      assert (x == None)
    end

    test "pop on empty is None" do
      let (x, rb) = RingBuf.pop(RingBuf.make(4))
      RingBuf.drop(rb)
      assert (x == None)
    end

    test "to_list on empty is Nil" do
      assert (RingBuf.to_list(RingBuf.make(4)) == Nil)
    end

  end

  describe "push / size / is_full" do

    test "push increments size" do
      let rb = RingBuf.push(RingBuf.make(4), 1)
      let (n, rb) = RingBuf.size(rb)
      RingBuf.drop(rb)
      assert (n == 1)
    end

    test "size stops at cap when full" do
      let rb = push_all(RingBuf.make(3), [1, 2, 3, 4])
      let (n, rb) = RingBuf.size(rb)
      RingBuf.drop(rb)
      assert (n == 3)
    end

    test "is_full after cap pushes" do
      let rb = push_all(RingBuf.make(2), [10, 20])
      let (f, rb) = RingBuf.is_full(rb)
      RingBuf.drop(rb)
      assert f
    end

    test "not full before cap" do
      let rb = RingBuf.push(RingBuf.make(4), 1)
      let (f, rb) = RingBuf.is_full(rb)
      RingBuf.drop(rb)
      assert (not(f))
    end

  end

  describe "peek_oldest / peek_newest" do

    test "peek_oldest returns first pushed" do
      let rb = push_all(RingBuf.make(4), [10, 20])
      let (x, rb) = RingBuf.peek_oldest(rb)
      RingBuf.drop(rb)
      assert (x == Some(10))
    end

    test "peek_newest returns last pushed" do
      let rb = push_all(RingBuf.make(4), [10, 20])
      let (x, rb) = RingBuf.peek_newest(rb)
      RingBuf.drop(rb)
      assert (x == Some(20))
    end

    test "single element: oldest == newest, and peeking keeps it" do
      let rb = RingBuf.push(RingBuf.make(4), 42)
      let (o, rb) = RingBuf.peek_oldest(rb)
      let (n, rb) = RingBuf.peek_newest(rb)
      let (sz, rb) = RingBuf.size(rb)
      RingBuf.drop(rb)
      assert (o == Some(42))
      assert (n == Some(42))
      assert (sz == 1)
    end

  end

  describe "get — indexed access (0 = oldest)" do

    test "get(0) returns oldest" do
      let rb = push_all(RingBuf.make(4), [1, 2, 3])
      let (x, rb) = RingBuf.get(rb, 0)
      RingBuf.drop(rb)
      assert (x == Some(1))
    end

    test "get(size-1) returns newest" do
      let rb = push_all(RingBuf.make(4), [1, 2, 3])
      let (x, rb) = RingBuf.get(rb, 2)
      RingBuf.drop(rb)
      assert (x == Some(3))
    end

    test "get out of range returns None" do
      let rb = RingBuf.push(RingBuf.make(4), 1)
      let (a, rb) = RingBuf.get(rb, 1)
      let (b, rb) = RingBuf.get(rb, -1)
      RingBuf.drop(rb)
      assert (a == None)
      assert (b == None)
    end

  end

  describe "pop — FIFO drain" do

    test "pop returns oldest first" do
      let rb = push_all(RingBuf.make(4), [10, 20, 30])
      let (a, rb) = RingBuf.pop(rb)
      let (b, rb) = RingBuf.pop(rb)
      let (c, rb) = RingBuf.pop(rb)
      let (d, rb) = RingBuf.pop(rb)
      RingBuf.drop(rb)
      assert (a == Some(10))
      assert (b == Some(20))
      assert (c == Some(30))
      assert (d == None)
    end

    test "pop decrements size" do
      let rb = push_all(RingBuf.make(4), [1, 2])
      let (_, rb) = RingBuf.pop(rb)
      let (n, rb) = RingBuf.size(rb)
      RingBuf.drop(rb)
      assert (n == 1)
    end

  end

  describe "overwrite — wrap-around behavior" do

    test "oldest is overwritten when full" do
      let rb = push_all(RingBuf.make(3), [1, 2, 3, 4])
      let (o, rb) = RingBuf.peek_oldest(rb)
      let (n, rb) = RingBuf.peek_newest(rb)
      RingBuf.drop(rb)
      assert (o == Some(2))
      assert (n == Some(4))
    end

    test "to_list after wrap has correct order" do
      let rb = push_all(RingBuf.make(3), [1, 2, 3, 4])
      assert (RingBuf.to_list(rb) == Cons(2, Cons(3, Cons(4, Nil))))
    end

    test "multiple overwrites" do
      let rb = push_all(RingBuf.make(2), [1, 2, 3, 4])
      assert (RingBuf.to_list(rb) == Cons(3, Cons(4, Nil)))
    end

  end

  describe "snapshot / to_list — oldest-to-newest" do

    test "to_list of three pushes" do
      let rb = push_all(RingBuf.make(4), [1, 2, 3])
      assert (RingBuf.to_list(rb) == Cons(1, Cons(2, Cons(3, Nil))))
    end

    test "to_list after pop" do
      let rb = push_all(RingBuf.make(4), [10, 20, 30])
      let (_, rb) = RingBuf.pop(rb)
      assert (RingBuf.to_list(rb) == Cons(20, Cons(30, Nil)))
    end

    test "snapshot reads out and keeps the buffer" do
      let rb = push_all(RingBuf.make(4), [1, 2])
      let (xs, rb) = RingBuf.snapshot(rb)
      let rb = RingBuf.push(rb, 3)
      let ys = RingBuf.to_list(rb)
      assert (xs == Cons(1, Cons(2, Nil)))
      assert (ys == Cons(1, Cons(2, Cons(3, Nil))))
    end

  end

  describe "clear" do

    test "clear resets size to 0" do
      let rb = RingBuf.clear(push_all(RingBuf.make(4), [1, 2]))
      let (n, rb) = RingBuf.size(rb)
      RingBuf.drop(rb)
      assert (n == 0)
    end

    test "cap unchanged after clear" do
      let rb = RingBuf.clear(RingBuf.push(RingBuf.make(8), 1))
      let (c, rb) = RingBuf.cap(rb)
      RingBuf.drop(rb)
      assert (c == 8)
    end

    test "can push after clear" do
      let rb = RingBuf.clear(push_all(RingBuf.make(2), [1, 2]))
      let rb = RingBuf.push(rb, 99)
      assert (RingBuf.to_list(rb) == Cons(99, Nil))
    end

  end

  describe "ownership" do

    test "a buffer threaded through a fold never shares" do
      let rb = List.fold_left([1, 2, 3, 4, 5], RingBuf.make(3), fn (acc, x) -> RingBuf.push(acc, x))
      assert (RingBuf.to_list(rb) == Cons(3, Cons(4, Cons(5, Nil))))
    end

    test "heap elements survive the pair round trips" do
      let rb = RingBuf.push(RingBuf.push(RingBuf.make(2), "a"), "b" ++ "!")
      let (x, rb) = RingBuf.peek_newest(rb)
      let (y, rb) = RingBuf.pop(rb)
      let zs = RingBuf.to_list(rb)
      assert (x == Some("b!"))
      assert (y == Some("a"))
      assert (zs == Cons("b!", Nil))
    end

  end

end
