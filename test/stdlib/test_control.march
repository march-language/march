mod TestControl do
  needs IO.Mut

  -- Distributed-deploys step 12a, the pure core of the control plane
  -- (stdlib/control.march): the release document, the executor's pass, the
  -- leader's memory and the Agent's apply, driven here against a simulated
  -- cluster. The protocol side (Ctl, CtlFetch, scripted and chaos peers) is
  -- test/session/control_peers.march, which needs sessions.

  -- ── fixtures ─────────────────────────────────────────────────────────────

  fn release_text() do
    "release v1\n"
    ++ "seq      42\n"
    ++ "parent   none\n"
    ++ "env      prod\n"
    ++ "topology t42\n"
    ++ "build    web     base:bw manifest:mw2\n"
    ++ "build    render  base:br manifest:mr2\n"
    ++ "step 1   pools:render  hosts:canary(1)  do:activate(render)  gate:healthy(60s)\n"
    ++ "step 2   pools:render  hosts:rest       do:activate(render)  gate:healthy(30s)  batch:1\n"
    ++ "step 3   pools:*       hosts:all        do:topology\n"
    ++ "line 1   SEQ 42 id1 s1 ACTIVATE render mr2\n"
    ++ "line 2   SEQ 42 id1 s1 ACTIVATE render mr2\n"
    ++ "line 3   SEQ 42 id1 s2 TOPOLOGY t42\n"
    ++ "drain    epoch<=41  soft:30000 hard:120000\n"
    ++ "sig      -\n"
  end

  fn rel() do
    match Control.parse(release_text()) do
      Ok(r) -> r
      Err(e) -> panic("fixture does not parse: " ++ e)
    end
  end

  fn step_n(k : Int) : Control.CtlStep do
    let r = rel()
    match List.drop(r.steps, k - 1) do
      Cons(s, _) -> s
      Nil -> panic("no step " ++ int_to_string(k))
    end
  end

  fn seed(b) do Bytes.from_list(List.map(List.range(0, 32), fn _ -> b)) end
  fn op_sk() do NodeCert.keypair_from_seed(seed(7)) end

  -- A simulated node: what it runs, whether it is healthy, whether its reload
  -- server refuses what it is sent, and every step it applied (to catch a
  -- step applied twice).
  type SimNode = {
    name : String, pools : List(String), versions : List(Control.CtlVersion), topology : String,
    drained : Int, healthy : Bool, seq : Int, refuse : Bool, applied : List(Int), certs : String
  }

  fn node(name, pools, versions) : SimNode do
    { name: name, pools: pools, versions: versions, topology: "t41", drained: 0, healthy: true,
      seq: 41, refuse: false, applied: Nil, certs: "" }
  end

  fn old_versions(pools) do
    List.map(pools, fn p -> { build: p, manifest: if p == "web" do "mw1" else "mr1" end })
  end

  fn cluster() : List(SimNode) do
    [ node("r3", ["render"], old_versions(["render"])),
      node("r1", ["render"], old_versions(["render"])),
      node("r2", ["render"], old_versions(["render"])),
      node("w1", ["web"], old_versions(["web"])) ]
  end

  fn members(ns : List(SimNode)) : List(Control.CtlMember) do
    List.map(ns, fn n -> { node: n.name, pools: n.pools })
  end

  fn report(n : SimNode) : Control.AgentReport do
    { node: n.name, seq: n.seq, versions: Control.versions_text(n.versions), topology: n.topology, drained: n.drained,
      healthy: n.healthy, failed_seq: 0, failed_step: 0, failed_why: "", detail: "", pools: "", certs: n.certs }
  end

  -- The node side of an order: what the reload server would do with the
  -- order's signed lines.
  fn apply_on(n : SimNode, o : Control.StepOrder) : SimNode do
    let n2 = { n with applied: List.append(n.applied, [o.step]), seq: o.seq }
    if o.action == "topology" do { n2 with topology: o.want }
    else if o.action == "drain" do { n2 with drained: 41 }
    else if o.action == "certs" do { n with applied: List.append(n.applied, [o.step]), certs: o.want }
    else
      let b = String.slice(o.action, 9, String.byte_size(o.action) - 10)
      { n2 with versions: Cons({ build: b, manifest: o.want }, List.filter(n.versions, fn v -> v.build != b)) }
    end end end
  end

  fn find_node(ns : List(SimNode), name : String) : SimNode do
    match List.find(ns, fn n -> n.name == name) do
      Some(n) -> n
      None -> panic("no node " ++ name)
    end
  end

  fn update(ns : List(SimNode), n : SimNode) : List(SimNode) do
    List.map(ns, fn m -> if m.name == n.name do n else m end)
  end

  fn report_all(l : Control.CtlLeader, ns : List(SimNode), now : Int) : Control.CtlLeader do
    List.fold_left(ns, l, fn (acc, n) -> Control.leader_report(acc, report(n), now))
  end

  -- Carry out [os]: each node applies its order (or refuses it) and the
  -- leader hears the result.
  fn carry_out(l : Control.CtlLeader, ns : List(SimNode), os : List(Control.StepOrder), now : Int) : (Control.CtlLeader, List(SimNode)) do
    List.fold_left(os, (l, ns), fn (acc, o) ->
      let (l1, ns1) = acc
      let n = find_node(ns1, o.node)
      if n.refuse do
        (Control.leader_result(l1, { seq: o.seq, step: o.step, node: o.node, ok: false, detail: "ERR bad_signature" }, now), ns1)
      else
        (Control.leader_result(l1, { seq: o.seq, step: o.step, node: o.node, ok: true, detail: "applied" }, now), update(ns1, apply_on(n, o)))
      end)
  end

  -- One leader round at [now]: every node reports, the leader passes, and the
  -- orders are carried out.
  fn round(l : Control.CtlLeader, ns : List(SimNode), now : Int) : (Control.CtlLeader, List(SimNode), Option(Control.CtlDecision)) do
    let l1 = report_all(l, ns, now)
    let (l2, d) = Control.leader_pass(l1, members(ns), now)
    match d do
      Some(Control.RolloutApply(_, os)) ->
        let (l3, ns2) = carry_out(l2, ns, os, now)
        (l3, ns2, d)
      _ -> (l2, ns, d)
    end
  end

  -- Rounds 10 s apart until the release completes or halts, or [n] rounds.
  fn drive(l : Control.CtlLeader, ns : List(SimNode), now : Int, n : Int) : (Control.CtlLeader, List(SimNode), Int, Option(Control.CtlDecision)) do
    let (l2, ns2, d) = round(l, ns, now)
    match d do
      Some(Control.RolloutComplete) -> (l2, ns2, now, d)
      Some(Control.RolloutHalted(_, _, _)) -> (l2, ns2, now, d)
      _ -> if n <= 1 do (l2, ns2, now, d) else drive(l2, ns2, now + 10000, n - 1) end
    end
  end

  fn fresh_leader() : Control.CtlLeader do
    match Control.leader_release(Control.leader_new(), rel()) do
      Ok(l) -> l
      Err(e) -> panic(e)
    end
  end

  fn applied(ns : List(SimNode), name : String) : List(Int) do
    let n = find_node(ns, name)
    n.applied
  end

  fn is_complete(d : Option(Control.CtlDecision)) : Bool do d == Some(Control.RolloutComplete) end

  -- "step:why" of a Wait, else "".
  fn wait_of(d : Option(Control.CtlDecision)) : String do
    match d do
      Some(Control.RolloutWait(s, why)) -> int_to_string(s) ++ ":" ++ why
      _ -> ""
    end
  end

  -- The step and nodes of an Apply, else (0, []).
  fn apply_of(d : Option(Control.CtlDecision)) : (Int, List(String)) do
    match d do
      Some(Control.RolloutApply(s, os)) -> (s, List.map(os, fn o -> o.node))
      _ -> (0, Nil)
    end
  end

  -- Drive leader A until step 2 has taken r2 and has an order out to r3.
  -- A is lost there; B starts from the release and the agents' reports.
  fn until_step2(l : Control.CtlLeader, ns : List(SimNode), now : Int, n : Int) : (Control.CtlLeader, List(SimNode), Int) do
    if n == 0 do panic("step 2 never started")
    else
      let (l2, ns2, d) = round(l, ns, now)
      match d do
        Some(Control.RolloutApply(2, _)) -> (l2, ns2, now)
        _ -> until_step2(l2, ns2, now + 10000, n - 1)
      end
    end
  end

  fn ops_for(rep : Control.AgentReport, answer : String) : Control.AgentOps do
    { report: fn -> rep, has: fn h -> h != "missing", request: fn _ -> answer }
  end

  -- ── certificate and revocation items (step 12b) ──────────────────────────

  fn deploy_sk() do NodeCert.keypair_from_seed(seed(3)) end
  fn rogue_sk() do NodeCert.keypair_from_seed(seed(9)) end
  fn r1_key() do NodeCert.keypair_from_seed(seed(11)) end

  fn uri(name : String) : String do NodeCert.node_uri("test.local", "render", name) end

  -- A certificate for [name] under [key], signed by [op], as its text form.
  fn cert_for(name : String, serial : String, op : Bytes) : String do
    NodeCert.to_text(NodeCert.sign({ node: uri(name), roles: ["Ctl.Agent:initiate"], flags: Nil,
      not_after: 4102444800, issuer: "spiffe://test.local/operator/x", pubkey: Bytes.to_hex(NodeCert.public_key(r1_key())),
      serial: serial }, op))
  end

  fn revocation_of(name : String) : String do
    NodeCert.revocation_to_text(NodeCert.sign_revocation({ node: uri(name), serial: "", issued_at: 1700000000 }, op_sk()))
  end

  fn rev_id(name : String) : String do
    NodeCert.revocation_id({ node: uri(name), serial: "", issued_at: 1700000000 })
  end

  fn certs_step() : Control.CtlStep do
    { id: 1, pools: ["*"], hosts: Control.HostsAll, action: Control.DoCerts, gate: Control.GateNone, batch: 0 }
  end

  -- A signed release carrying [certs] and [revokes], one `do:certs` step.
  fn cert_release(seq : Int, certs : List(Control.CtlCert), revokes : List(String)) : Control.CtlRelease do
    Control.sign({ seq: seq, parent: "none", env: "prod", topology: "-", builds: Nil, steps: [certs_step()], lines: Nil,
      certs: certs, revokes: revokes, drain: None, signature: "" }, deploy_sk())
  end

  fn rotation() : Control.CtlRelease do
    cert_release(43, [{ node: "r1", cert: cert_for("r1", "r1-new", op_sk()) }], [revocation_of("w1")])
  end

  -- A node's certificate state for `agent_apply_certs`: the serial it
  -- presents and the revocations it knows, in [v]. `replace` checks the
  -- operator's signature and the name, as `ClusterNode.replace_cert` does.
  fn sim_cert_ops(v : Vault(String), name : String) : Control.CertOps do
    { name: name, deploy_key: NodeCert.public_key(deploy_sk()),
      serial: fn -> Vault.get_or(v, "serial", "r1-old"),
      replace: fn text ->
        match NodeCert.from_text(text) do
          Err(e) -> Err(e)
          Ok(sc) -> match NodeCert.verify(sc, NodeCert.public_key(op_sk()), 1700000000) do
            Err(e) -> Err("cluster_node: the new certificate: " ++ e)
            Ok(c) ->
              Vault.set(v, "replaced", Vault.get_or(v, "replaced", "") ++ "1")
              Vault.set(v, "serial", c.serial)
              Ok(c.serial)
          end
        end,
      revoke: fn t ->
        match NodeCert.revocation_from_text(t) do
          Err(e) -> Err(e)
          Ok(sr) ->
            Vault.set(v, "rev:" ++ NodeCert.revocation_id(sr.rev), "1")
            Ok(())
        end,
      floor: fn -> Control.cert_floor(v) }
  end

  -- [n] reporting [r]'s `do:certs` step done.
  fn certs_done(r : Control.CtlRelease, n : SimNode) : SimNode do
    { n with certs: Control.want_for(r, certs_step(), n.name) }
  end

  fn certs_order(r : Control.CtlRelease, node : String) : Control.StepOrder do
    Control.order(r, certs_step(), node)
  end

  -- ── the release document ─────────────────────────────────────────────────

  describe "release parse and serialise" do
    test "the design's example parses, whatever the spacing" do
      let r = rel()
      assert (r.seq == 42)
      assert (r.parent == "none")
      assert (r.env == "prod")
      assert (r.topology == "t42")
      assert (List.length(r.builds) == 2)
      assert (List.length(r.steps) == 3)
      assert (List.length(r.lines) == 3)
      assert (r.signature == "")
      match r.drain do
        Some(d) -> assert (d.epoch == 41 && d.soft_ms == 30000 && d.hard_ms == 120000)
        None -> assert false
      end
    end

    test "steps: hosts, action, gate and batch" do
      let r = rel()
      match r.steps do
        Cons(s1, Cons(s2, Cons(s3, Nil))) ->
          assert (s1.hosts == Control.HostsCanary(1))
          assert (s1.action == Control.DoActivate("render"))
          assert (s1.gate == Control.GateHealthy(60000))
          assert (s1.batch == 0)
          assert (s2.hosts == Control.HostsRest)
          assert (s2.gate == Control.GateHealthy(30000))
          assert (s2.batch == 1)
          assert (s3.pools == ["*"])
          assert (s3.hosts == Control.HostsAll)
          assert (s3.action == Control.DoTopology)
          assert (s3.gate == Control.GateNone)
        _ -> assert false
      end
    end

    test "serialize is canonical and parses back to the same release" do
      let r = rel()
      let txt = Control.serialize(r)
      assert (String.starts_with(txt, "release v1\nseq 42\nparent none\n"))
      assert (String.contains(txt, "step 2 pools:render hosts:rest do:activate(render) gate:healthy(30s) batch:1\n"))
      assert (String.ends_with(txt, "sig -\n"))
      assert (Control.parse(txt) == Ok(r))
      assert (Control.serialize(unwrap(Result.to_option(Control.parse(txt)))) == txt)
    end

    test "durations" do
      assert (Control.parse_duration("250ms") == Ok(250))
      assert (Control.parse_duration("60s") == Ok(60000))
      assert (Control.parse_duration("2m") == Ok(120000))
      assert (Control.parse_duration("1500") == Ok(1500))
      assert (Result.is_err(Control.parse_duration("soon")))
      assert (Control.show_duration(60000) == "60s")
      assert (Control.show_duration(1500) == "1500ms")
    end

    test "malformed documents are refused with the line" do
      assert (Control.parse("") == Err("empty release"))
      assert (Control.parse("release v2\n") == Err("expected `release v1` first, got `release v2`"))
      let bad_key = String.replace(release_text(), "env      prod", "envy prod")
      assert (Control.parse(bad_key) == Err("line 4: unknown entry `envy`"))
      let bad_hosts = String.replace(release_text(), "hosts:rest", "hosts:most")
      assert (Control.parse(bad_hosts) == Err("line 9: hosts: expected canary(n), rest or all, got most"))
      let after_sig = release_text() ++ "seq 43\n"
      assert (Control.parse(after_sig) == Err("line 16: nothing may follow `sig`"))
      let no_do = String.replace(release_text(), "do:topology", "")
      assert (Control.parse(no_do) == Err("line 10: step 3: missing do:"))
    end

    test "check: numbering, builds, drain, lines, canary, gate" do
      let r = rel()
      let bump = fn (s : Control.CtlStep) -> { s with id: s.id + 1 }
      assert (Control.check({ r with steps: List.map(r.steps, bump) }) == Err("step 2: steps must be numbered 1, 2, ... in order (expected 1)"))
      assert (Control.check({ r with builds: Nil }) == Err("step 1: activates build `render`, which the release does not ship"))
      assert (Control.check({ r with builds: List.append(r.builds, r.builds) }) == Err("build `web` is given twice"))
      assert (Control.check({ r with lines: [{ step: 9, text: "X" }] }) == Err("line for step 9, which does not exist"))
      assert (Control.check({ r with seq: 0 }) == Err("seq must be positive"))
      let drains = String.replace(release_text(), "do:topology", "do:drain")
      assert (Result.is_ok(Control.parse(drains)))
      let no_drain = String.replace(drains, "drain    epoch<=41  soft:30000 hard:120000\n", "")
      assert (Control.parse(no_drain) == Err("step 3: drains, but the release has no `drain` line"))
      let canary0 = String.replace(release_text(), "canary(1)", "canary(0)")
      assert (Control.parse(canary0) == Err("step 1: canary(n) needs n >= 1"))
      let gate0 = String.replace(release_text(), "healthy(60s)", "healthy(0s)")
      assert (Control.parse(gate0) == Err("step 1: healthy(window) needs a positive window"))
    end
  end

  describe "release identity, signature, compare-and-set" do
    test "sign and verify over the canonical text" do
      let sk = op_sk()
      let r = Control.sign(rel(), sk)
      assert (Control.verify(r, NodeCert.public_key(sk)))
      assert (not(Control.verify(rel(), NodeCert.public_key(sk))))
      assert (not(Control.verify({ r with seq: 43 }, NodeCert.public_key(sk))))
      assert (not(Control.verify(r, NodeCert.public_key(NodeCert.keypair_from_seed(seed(8))))))
      -- a signed document re-laid-out still verifies: the signature is over the canonical form
      let spaced = String.replace_all(Control.serialize(r), " ", "   ")
      match Control.parse(spaced) do
        Ok(r2) -> assert (Control.verify(r2, NodeCert.public_key(sk)))
        Err(e) -> panic(e)
      end
    end

    test "the digest is the sha256 of the signed text, and ignores the signature" do
      let r = rel()
      assert (String.byte_size(Control.digest(r)) == 64)
      assert (Control.digest(r) == Control.digest(Control.sign(r, op_sk())))
      assert (Control.digest(r) != Control.digest({ r with env: "staging" }))
    end

    test "accept: first, retry, next, stale, fork, parent mismatch" do
      let r = rel()
      let next = { r with seq: 43, parent: Control.digest(r) }
      assert (Control.accept(None, r) == Ok(()))
      assert (Control.accept(Some(r), r) == Ok(()))
      assert (Control.accept(Some(r), next) == Ok(()))
      assert (Control.accept(Some(next), r) == Err("stale: release 42 is older than the head 43"))
      assert (Control.accept(Some(r), { r with env: "staging" }) == Err("fork: release 42 is already held with other content"))
      assert (Control.accept(Some(r), { next with parent: "abc" }) == Err("parent mismatch: release 43 does not follow the head 42"))
    end

    test "a leader refuses an unordered release and clears a halt on a new one" do
      let l = fresh_leader()
      let r = rel()
      assert (Result.is_err(Control.leader_release(l, { r with seq: 44, parent: "x" })))
      let halted = { l with halted: Some(Control.RolloutHalted(1, "r1", "x")) }
      match Control.leader_release(halted, { r with seq: 43, parent: Control.digest(r) }) do
        Ok(l2) -> assert (l2.halted == None)
        Err(e) -> panic(e)
      end
    end
  end

  -- ── host selection and gates ─────────────────────────────────────────────

  describe "host selection" do
    test "targets are the pool's members in node order; * is every member" do
      let r = rel()
      let ms = members(cluster())
      match r.steps do
        Cons(s1, Cons(_, Cons(s3, Nil))) ->
          assert (Control.targets(s1, ms) == ["r1", "r2", "r3"])
          assert (Control.targets(s3, ms) == ["r1", "r2", "r3", "w1"])
        _ -> assert false
      end
    end

    test "canary(n) takes the first n, rest the others, all everyone" do
      let r = rel()
      let ms = members(cluster())
      match r.steps do
        Cons(s1, Cons(s2, Cons(s3, Nil))) ->
          let c = Control.select(s1, ms, Nil)
          assert (c == ["r1"])
          assert (Control.select(s2, ms, [(s1, c)]) == ["r2", "r3"])
          assert (Control.select(s3, ms, [(s1, c), (s2, ["r2", "r3"])]) == ["r1", "r2", "r3", "w1"])
          assert (Control.select({ s1 with hosts: Control.HostsCanary(9) }, ms, Nil) == ["r1", "r2", "r3"])
          -- `rest` after a step with a different action takes every target
          assert (Control.select({ s2 with action: Control.DoTopology }, ms, [(s1, c)]) == ["r1", "r2", "r3"])
        _ -> assert false
      end
    end

    test "a canary that left the membership is replaced by the next node" do
      let r = rel()
      let ms = List.filter(members(cluster()), fn m -> m.node != "r1")
      assert (Control.select(head(r.steps), ms, Nil) == ["r2"])
    end
  end

  describe "gates" do
    test "healthy(60s) waits for 60s of the leader's clock, then the next step starts" do
      let l = fresh_leader()
      let (l1, ns1, d1) = round(l, cluster(), 0)
      assert (d1 == Some(Control.RolloutApply(1, [Control.order(rel(), step_n(1), "r1")])))
      let (l2, _, d2) = round(l1, ns1, 1000)
      match d2 do
        Some(Control.RolloutWait(1, why)) -> assert (why == "gate healthy(60s): r1 healthy for 0ms of 60000ms")
        _ -> panic("expected a wait, got " ++ Control.show_decision(unwrap_or(d2, Control.RolloutComplete)))
      end
      let (_, _, d3) = round(l2, ns1, 1000 + 59999)
      assert (String.starts_with(wait_of(d3), "1:"))
      let (_, _, d4) = round(l2, ns1, 1000 + 60000)
      let (s4, n4) = apply_of(d4)
      assert (s4 == 2 && n4 == ["r2"])
    end

    test "a state change restarts a node's window; unhealthy clears it" do
      let rep = report(find_node(cluster(), "r1"))
      let o1 = Control.observe(Nil, rep, 100)
      let o2 = Control.observe(o1, rep, 900)
      let h2 = head(o2)
      assert (h2.healthy_since == Some(100))
      let o3 = Control.observe(o2, { rep with topology: "t42" }, 1000)
      let h3 = head(o3)
      assert (h3.healthy_since == Some(1000))
      let o4 = Control.observe(o3, { rep with healthy: false }, 1100)
      let h4 = head(o4)
      assert (h4.healthy_since == None)
      assert (List.length(o4) == 1)
    end
  end

  -- ── the executor over a simulated cluster ────────────────────────────────

  describe "rollout" do
    test "a full rollout: canary, rest one at a time, then topology everywhere" do
      let (_, ns, _, d) = drive(fresh_leader(), cluster(), 0, 50)
      assert (is_complete(d))
      assert (applied(ns, "r1") == [1, 3])
      assert (applied(ns, "r2") == [2, 3])
      assert (applied(ns, "r3") == [2, 3])
      assert (applied(ns, "w1") == [3])
      assert (List.all(ns, fn n -> n.topology == "t42"))
      assert (List.all(List.filter(ns, fn n -> n.name != "w1"), fn n -> List.member(n.versions, { build: "render", manifest: "mr2" })))
    end

    test "batch:1 keeps one order in flight; an order is not re-sent while in flight" do
      let r = rel()
      let s2 = head(tail(r.steps))
      let obs = List.fold_left(cluster(), Nil, fn (acc, n) -> Control.observe(acc, report(n), 0))
      let prior = [(head(r.steps), ["r1"])]
      let _ = prior
      -- r1 done, gate passed: step 2 orders r2 only, and nothing while r2 is in flight
      let done_r1 = Control.observe(obs, report(apply_on(find_node(cluster(), "r1"), Control.order(r, head(r.steps), "r1"))), 0)
      match Control.pass(r, members(cluster()), done_r1, Nil, 60000) do
        Control.RolloutApply(2, os) -> assert (List.map(os, fn o -> o.node) == ["r2"])
        d -> panic("expected step 2, got " ++ Control.show_decision(d))
      end
      assert (Control.pass(r, members(cluster()), done_r1, ["r2"], 60000) == Control.RolloutApply(2, Nil))
      assert (s2.batch == 1)
    end

    test "a node that already reports a step's end state is never ordered" do
      let r = rel()
      let ns = List.map(cluster(), fn n -> if n.name == "r1" do apply_on(n, Control.order(r, head(r.steps), "r1")) else n end)
      let (_, ns2, _, d) = drive(fresh_leader(), List.map(ns, fn n -> { n with applied: Nil }), 0, 50)
      assert (is_complete(d))
      assert (applied(ns2, "r1") == [3])
    end

    test "a node holding a newer release puts the leader behind" do
      let r = rel()
      let ns = List.map(cluster(), fn n -> if n.name == "w1" do { n with seq: 50 } else n end)
      let obs = List.fold_left(ns, Nil, fn (acc, n) -> Control.observe(acc, report(n), 0))
      assert (Control.pass(r, members(ns), obs, Nil, 0) == Control.RolloutBehind(50))
    end
  end

  describe "leader change" do
    test "a report without detail keeps the detail last reported (a poll after the hello)" do
      let n = head(cluster())
      let hello = { report(n) with detail: "pins\nstatus" }
      let l1 = Control.leader_report(fresh_leader(), hello, 0)
      let l2 = Control.leader_report(l1, report(n), 1000)
      assert (List.length(l2.obs) == 1)
      assert (List.all(l2.obs, fn o -> o.report.detail == "pins\nstatus"))
      let l3 = Control.leader_report(l2, { report(n) with detail: "newer" }, 2000)
      assert (List.all(l3.obs, fn o -> o.report.detail == "newer"))
    end

    test "a new leader resumes mid-rollout from observation alone; no step twice, none skipped" do
      let (_, ns, now) = until_step2(fresh_leader(), cluster(), 0, 50)
      assert (applied(ns, "r2") == [2])
      assert (applied(ns, "r3") == Nil)
      let (_, ns2, _, d) = drive(fresh_leader(), ns, now + 5000, 50)
      assert (is_complete(d))
      assert (applied(ns2, "r1") == [1, 3])
      assert (applied(ns2, "r2") == [2, 3])
      assert (applied(ns2, "r3") == [2, 3])
      assert (applied(ns2, "w1") == [3])
    end

    test "an order the old leader sent and the node applied is not sent again" do
      -- A orders r1 (step 1); r1 applies it; A dies before hearing the result.
      let r = rel()
      let l = report_all(fresh_leader(), cluster(), 0)
      let (_, d) = Control.leader_pass(l, members(cluster()), 0)
      let ns = match d do
        Some(Control.RolloutApply(1, Cons(o, Nil))) -> update(cluster(), apply_on(find_node(cluster(), "r1"), o))
        _ -> panic("expected the canary order")
      end
      -- B: r1 is at the end state, so B waits on the gate, it does not re-order
      let (_, _, d2) = round(fresh_leader(), ns, 1000)
      assert (String.starts_with(wait_of(d2), "1:"))
      let (_, ns3, _, d3) = drive(fresh_leader(), ns, 1000, 50)
      assert (is_complete(d3))
      assert (applied(ns3, "r1") == [1, 3])
      assert (List.length(r.steps) == 3)
    end

    test "an order lost with the old leader is sent once by the new one" do
      let l = report_all(fresh_leader(), cluster(), 0)
      let (_, _) = Control.leader_pass(l, members(cluster()), 0)
      -- A died with its order undelivered: nothing changed on r1
      let (_, ns, _, d) = drive(fresh_leader(), cluster(), 1000, 50)
      assert (is_complete(d))
      assert (applied(ns, "r1") == [1, 3])
    end

    test "a new leader restarts a gate window that was in progress" do
      let (l1, ns1, _) = round(fresh_leader(), cluster(), 0)
      -- A first sees r1 in its new state at 1000, and at 51000 is 50 s in
      let (l2, _, _) = round(l1, ns1, 1000)
      let (_, _, d_old) = round(l2, ns1, 51000)
      assert (wait_of(d_old) == "1:gate healthy(60s): r1 healthy for 50000ms of 60000ms")
      let (_, _, d_new) = round(fresh_leader(), ns1, 51000)
      assert (wait_of(d_new) == "1:gate healthy(60s): r1 healthy for 0ms of 60000ms")
    end
  end

  describe "halting" do
    test "a canary that turns unhealthy halts the release at its gate; nothing else is touched" do
      let (l1, ns1, _) = round(fresh_leader(), cluster(), 0)
      let sick = update(ns1, { find_node(ns1, "r1") with healthy: false })
      let (l2, ns2, d) = round(l1, sick, 10000)
      assert (d == Some(Control.RolloutHalted(1, "r1", "gate healthy(60s) failed: r1 reports unhealthy")))
      -- the halt sticks even once r1 recovers, and the executor never rolls back
      let well = update(ns2, { find_node(ns2, "r1") with healthy: true })
      let (_, ns3, _, d2) = drive(l2, well, 200000, 20)
      assert (d2 == d)
      assert (applied(ns3, "r1") == [1])
      assert (applied(ns3, "r2") == Nil)
      let r1 = find_node(ns3, "r1")
      assert (List.member(r1.versions, { build: "render", manifest: "mr2" }))
    end

    test "a refused order halts the release" do
      let ns = List.map(cluster(), fn n -> if n.name == "r1" do { n with refuse: true } else n end)
      let (_, ns2, _, d) = drive(fresh_leader(), ns, 0, 20)
      assert (d == Some(Control.RolloutHalted(1, "r1", "ERR bad_signature")))
      assert (List.all(ns2, fn n -> n.applied == Nil))
    end

    test "a new leader re-derives an apply failure from the agent's own report" do
      let r = rel()
      let failed = Control.with_failure(report(find_node(cluster(), "r1")), { seq: 42, step: 1, why: "ERR bad_signature" })
      let obs = Control.observe(Nil, failed, 0)
      assert (Control.pass(r, members(cluster()), obs, Nil, 0) == Control.RolloutHalted(1, "r1", "ERR bad_signature"))
      -- a failure from an older release does not count
      let old = Control.observe(Nil, Control.with_failure(failed, { seq: 41, step: 1, why: "old" }), 0)
      let (s1, n1) = apply_of(Some(Control.pass(r, members(cluster()), old, Nil, 0)))
      assert (s1 == 1 && n1 == ["r1"])
    end
  end

  -- ── the Agent's apply ────────────────────────────────────────────────────

  describe "agent_apply" do
    test "an order the node already reports is answered without a request" do
      let r = rel()
      let o = Control.order(r, head(r.steps), "r1")
      let rep = report(apply_on(find_node(cluster(), "r1"), o))
      let ops = { report: fn -> rep, has: fn _ -> true, request: fn _ -> panic("no request expected") }
      let res = Control.agent_apply(ops, o)
      assert (res.ok && res.detail == "already applied")
    end

    test "missing artifacts, a refused line, and a line that changed nothing all fail" do
      let r = rel()
      let o = Control.order(r, head(r.steps), "r1")
      assert (Control.order_artifacts(o) == ["mr2"])
      assert (Control.order_lines(o) == ["SEQ 42 id1 s1 ACTIVATE render mr2"])
      let rep = report(find_node(cluster(), "r1"))
      let m = Control.agent_apply(ops_for(rep, "OK"), { o with artifacts: "br missing" })
      assert (not(m.ok) && m.detail == "missing artifacts: missing")
      let refused = Control.agent_apply(ops_for(rep, "ERR stale_release"), o)
      assert (not(refused.ok) && refused.detail == "ERR stale_release")
      let noop = Control.agent_apply(ops_for(rep, "OK"), o)
      assert (not(noop.ok) && String.starts_with(noop.detail, "the node accepted every line"))
    end

    test "a line that takes effect answers ok" do
      let r = rel()
      let o = Control.order(r, head(r.steps), "r1")
      let v = Vault.new("test_control_agent_state")
      Vault.set(v, "state", report(find_node(cluster(), "r1")))
      let req = fn _ ->
        let _ = Vault.set(v, "state", report(apply_on(find_node(cluster(), "r1"), o)))
        "OK activated"
      let ops = { report: fn -> unwrap(Vault.get(v, "state")), has: fn _ -> true, request: req }
      let res = Control.agent_apply(ops, o)
      assert (res.ok && res.detail == "applied")
    end

    test "orders carry hashes and the step's signed lines, not bytes" do
      let r = rel()
      let o = Control.order(r, head(tail(tail(r.steps))), "w1")
      assert (o.action == "topology" && o.want == "t42" && Control.order_artifacts(o) == ["t42"])
      assert (Control.order_lines(o) == ["SEQ 42 id1 s2 TOPOLOGY t42"])
      assert (o.release == Control.digest(r))
    end
  end

  describe "certificate items: the release" do
    test "cert and revoke items parse, serialise canonically, and are covered by the signature" do
      let r = rotation()
      let txt = Control.serialize(r)
      assert (String.contains(txt, "step 1 pools:* hosts:all do:certs gate:none\n"))
      assert (String.contains(txt, "\ncert r1 " ++ cert_for("r1", "r1-new", op_sk()) ++ "\nrevoke " ++ revocation_of("w1") ++ "\nsig "))
      assert (Control.parse(txt) == Ok(r))
      assert (Control.verify(r, NodeCert.public_key(deploy_sk())))
      -- an item swapped after signing breaks the release's signature
      let swapped = { r with certs: [{ node: "r1", cert: cert_for("r1", "r1-other", op_sk()) }] }
      assert (not(Control.verify(swapped, NodeCert.public_key(deploy_sk()))))
    end

    test "the item lines are forge's, byte for byte" do
      -- pinned in forge/test/test_cluster.ml too (`pinned_items_text`)
      let r = { seq: 7, parent: "none", env: "prod", topology: "-", builds: Nil, steps: [certs_step()], lines: Nil,
                certs: [{ node: "node-a", cert: "Q0VSVA==" }], revokes: ["UkVWMQ==", "UkVWMg=="], drain: None, signature: "" }
      assert (Control.signed_text(r) == "release v1\nseq 7\nparent none\nenv prod\ntopology -\nstep 1 pools:* hosts:all do:certs gate:none\ncert node-a Q0VSVA==\nrevoke UkVWMQ==\nrevoke UkVWMg==\n")
    end

    test "items are checked for shape only" do
      let base = { rotation() with signature: "" }
      let no_step = { base with steps: [{ certs_step() with action: Control.DoTopology }] }
      assert (Control.check(no_step) == Err("the release carries certificate items but no `do:certs` step"))
      let empty = { base with certs: Nil, revokes: Nil }
      assert (Control.check(empty) == Err("step 1: delivers certificates, but the release carries no `cert` or `revoke` item"))
      let junk = { base with certs: [{ node: "r1", cert: "bm90IGEgY2VydA==" }] }
      assert (Control.check(junk) == Err("cert for r1: not a certificate"))
      let bad_rev = { base with revokes: ["bm90IGEgY2VydA=="] }
      assert (Control.check(bad_rev) == Err("revoke: not a revocation token"))
      let twice = { base with certs: [{ node: "r1", cert: cert_for("r1", "a", op_sk()) }, { node: "r1", cert: cert_for("r1", "b", op_sk()) }] }
      assert (Control.check(twice) == Err("cert: node r1 is given two certificates"))
      -- whether a certificate is the operator's, or names the node it is for, is the node's check
      let mismatched = { base with certs: [{ node: "r1", cert: cert_for("r2", "x", rogue_sk()) }] }
      assert (Control.check(mismatched) == Ok(()))
      assert (Result.is_err(Control.parse("release v1\nseq 1\nparent none\nenv e\ntopology t\nstep 1 pools:* hosts:all do:certs\ncert r1\nsig -\n")))
    end
  end

  describe "certificate items: the executor" do
    test "a do:certs step is done on a node once it reports its certificate and every revocation" do
      let r = rotation()
      assert (Control.want_for(r, certs_step(), "r1") == "cert:r1-new rev:" ++ rev_id("w1"))
      assert (Control.want_for(r, certs_step(), "r2") == "rev:" ++ rev_id("w1"))
      let o = certs_order(r, "r1")
      assert (o.action == "certs" && o.lines == Control.serialize(r) && Control.order_artifacts(o) == Nil)
      let l = match Control.leader_release(Control.leader_new(), r) do
        Ok(x) -> x
        Err(e) -> panic(e)
      end
      let (_, ns, _, d) = drive(l, cluster(), 0, 10)
      assert (is_complete(d))
      assert (applied(ns, "r1") == [1])
      assert (Control.reports_state(report(find_node(ns, "r1")), "certs", "cert:r1-new"))
      assert (not(Control.reports_state(report(find_node(cluster(), "r1")), "certs", "cert:r1-new")))
    end

    test "a node a certificate item names is waited for, member or not" do
      let r = cert_release(47, [{ node: "r9", cert: cert_for("r9", "r9-new", op_sk()) }], Nil)
      let ns = List.map(cluster(), fn n -> certs_done(r, n))
      let obs = List.fold_left(ns, Nil, fn (acc, n) -> Control.observe(acc, report(n), 0))
      -- r9 is in no pool the leader knows of: it is still ordered, and the step waits for it
      let (s1, n1) = apply_of(Some(Control.pass(r, members(ns), obs, Nil, 0)))
      assert (s1 == 1 && n1 == ["r9"])
      let (s2, n2) = apply_of(Some(Control.pass(r, members(ns), obs, ["r9"], 0)))
      assert (s2 == 1 && n2 == Nil)
      let r9 = { node("r9", ["edge"], Nil) with certs: "cert:r9-new" }
      let obs2 = Control.observe(obs, report(r9), 0)
      assert (Control.pass(r, members(ns), obs2, Nil, 0) == Control.RolloutComplete)
    end

    test "the revoked node itself is not waited for" do
      let r = rotation()
      -- every node but w1 (the one the release revokes) reports the step done
      let ns = List.map(cluster(), fn n -> if n.name == "w1" do n else certs_done(r, n) end)
      let obs = List.fold_left(ns, Nil, fn (acc, n) -> Control.observe(acc, report(n), 0))
      assert (Control.pass(r, members(ns), obs, Nil, 0) == Control.RolloutComplete)
      -- a revocation by serial exempts the node that reports presenting it
      let by_serial = NodeCert.revocation_to_text(NodeCert.sign_revocation({ node: "", serial: "r2-cur", issued_at: 1 }, op_sk()))
      let r2 = cert_release(44, Nil, [by_serial])
      let ns2 = List.map(cluster(), fn n -> if n.name == "r2" do { n with certs: "cert:r2-cur" } else certs_done(r2, n) end)
      let obs2 = List.fold_left(ns2, Nil, fn (acc, n) -> Control.observe(acc, report(n), 0))
      assert (Control.pass(r2, members(ns2), obs2, Nil, 0) == Control.RolloutComplete)
      -- without the exemption r1, which reports nothing, holds the step
      let ns3 = List.map(ns2, fn n -> if n.name == "r1" do { n with certs: "cert:r1-old" } else n end)
      let obs3 = List.fold_left(ns3, Nil, fn (acc, n) -> Control.observe(acc, report(n), 0))
      let (s3, n3) = apply_of(Some(Control.pass(r2, members(ns3), obs3, Nil, 0)))
      assert (s3 == 1 && n3 == ["r1"])
    end

    test "certs_text is what a node reports" do
      let c = { node: uri("r1"), roles: Nil, flags: Nil, not_after: 1, issuer: "", pubkey: "", serial: "abc" }
      let rv = { node: uri("w1"), serial: "", issued_at: 1700000000 }
      assert (Control.certs_text(Some(c), [rv]) == "cert:abc rev:" ++ rev_id("w1"))
      assert (Control.certs_text(None, Nil) == "")
      assert (String.byte_size(rev_id("w1")) == 16)
    end
  end

  describe "certificate items: the Agent" do
    test "a node takes its own certificate and every revocation, once" do
      let v = Vault.new("test_control_certs_take")
      let res = Control.agent_apply_certs_recording(sim_cert_ops(v, "r1"), v, certs_order(rotation(), "r1"))
      assert (res.ok && res.detail == "certificate r1-new in use; 1 revocation(s) known")
      assert (Vault.get(v, "serial") == Some("r1-new"))
      assert (Vault.get(v, "rev:" ++ rev_id("w1")) == Some("1"))
      assert (Control.cert_floor(v) == 43)
      let again = Control.agent_apply_certs_recording(sim_cert_ops(v, "r1"), v, certs_order(rotation(), "r1"))
      assert (again.ok && again.detail == "certificate r1-new already in use; 1 revocation(s) known")
      assert (Vault.get(v, "replaced") == Some("1"))
    end

    test "another node's certificate item is not applied" do
      let v = Vault.new("test_control_certs_other")
      let res = Control.agent_apply_certs(sim_cert_ops(v, "r2"), certs_order(rotation(), "r2"))
      assert (res.ok && res.detail == "1 revocation(s) known")
      assert (Vault.get(v, "replaced") == None)
    end

    test "a certificate naming another node, or signed by another operator, is refused" do
      let v = Vault.new("test_control_certs_refuse")
      let named = cert_release(45, [{ node: "r1", cert: cert_for("r2", "r2-new", op_sk()) }], Nil)
      let res = Control.agent_apply_certs_recording(sim_cert_ops(v, "r1"), v, certs_order(named, "r1"))
      assert (not(res.ok) && res.detail == "the certificate for r1 names " ++ uri("r2") ++ ", not this node")
      assert (Vault.get(v, "failure") == Some("45 1 " ++ res.detail))
      let rogue = cert_release(46, [{ node: "r1", cert: cert_for("r1", "r1-rogue", rogue_sk()) }], Nil)
      let res2 = Control.agent_apply_certs(sim_cert_ops(v, "r1"), certs_order(rogue, "r1"))
      assert (not(res2.ok) && res2.detail == "cluster_node: the new certificate: certificate not signed by the cluster operator")
      assert (Vault.get(v, "replaced") == None)
      assert (Control.cert_floor(v) == 0)
    end

    test "the release must be the deploy key's, the one the order names, and not older than one taken" do
      let v = Vault.new("test_control_certs_release")
      let o = certs_order(rotation(), "r1")
      let unsigned = { o with lines: Control.serialize({ rotation() with signature: "" }) }
      let a = Control.agent_apply_certs(sim_cert_ops(v, "r1"), unsigned)
      assert (a.detail == "the order's release is not signed by the deploy key")
      let by_rogue = { o with lines: Control.serialize(Control.sign(rotation(), rogue_sk())) }
      let b = Control.agent_apply_certs(sim_cert_ops(v, "r1"), by_rogue)
      assert (b.detail == "the order's release is not signed by the deploy key")
      let renamed = { o with release: "0000" }
      let c = Control.agent_apply_certs(sim_cert_ops(v, "r1"), renamed)
      assert (c.detail == "the order's release is not the release it names")
      Vault.set(v, "cert_floor", "50")
      let d = Control.agent_apply_certs(sim_cert_ops(v, "r1"), o)
      assert (d.detail == "stale: release 43 is older than release 50, which this node has taken")
      assert (Vault.get(v, "replaced") == None)
    end
  end

  describe "chunks" do
    test "an artifact splits into fixed-size chunks and reassembles" do
      let cs = Control.chunks("0123456789", 4)
      assert (List.map(cs, fn c -> c.data) == ["0123", "4567", "89"])
      assert (List.map(cs, fn c -> c.offset) == [0, 4, 8])
      assert (List.map(cs, fn c -> c.last) == [false, false, true])
      assert (Control.chunks("", 4) == [{ offset: 0, data: "", last: true }])
      assert (Control.chunks("0123", 4) == [{ offset: 0, data: "0123", last: true }])
    end
  end

  describe "audit" do
    test "a release line is one JSON object with the node log's ts/type and the leader" do
      let l = Control.audit_release(1700000000123, "a", 42, "d42", "ok", "")
      assert (String.ends_with(l, "\n"))
      match Json.parse(String.trim(l)) do
        Ok(jv) ->
          assert (Json.get(jv, "ts") == Some(Json.Number(1700000000123.0)))
          assert (Json.get(jv, "type") == Some(Json.Str("release")))
          assert (Json.get(jv, "leader") == Some(Json.Str("a")))
          assert (Json.get(jv, "seq") == Some(Json.Number(42.0)))
          assert (Json.get(jv, "result") == Some(Json.Str("ok")))
        Err(e) -> panic("not JSON: " ++ e)
      end
    end

    test "a refusal at compare-and-set is named by its kind" do
      let r = rel()
      let l1 = match Control.leader_release(Control.leader_new(), r) do
        Ok(l) -> l
        Err(e) -> panic(e)
      end
      let stale = { r with seq: 41 }
      let other = { r with seq: 43, parent: "not-the-head" }
      let fork = { r with env: "other" }
      let why = fn x -> match Control.leader_release(l1, x) do
        Ok(_) -> "accepted"
        Err(e) -> Control.audit_refusal(e)
      end
      assert (why(stale) == "err_stale")
      assert (why(other) == "err_parent")
      assert (why(fork) == "err_fork")
      assert (Control.audit_refusal("no steps") == "err_invalid")
    end

    test "orders, answers and the release's end each have a line; a reason with quotes stays JSON" do
      let r = rel()
      let o = Control.order(r, head(r.steps), "w1")
      assert (String.contains(Control.audit_order(5, "a", o), "\"type\":\"order\""))
      assert (String.contains(Control.audit_order(5, "a", o), "\"node\":\"w1\""))
      let res = { seq: 42, step: 1, node: "w1", ok: false, detail: "ERR \"bad\" sig" }
      match Json.parse(String.trim(Control.audit_step(6, "a", res))) do
        Ok(jv) -> assert (Json.get(jv, "why") == Some(Json.Str("ERR \"bad\" sig")))
        Err(e) -> panic("not JSON: " ++ e)
      end
      assert (Option.is_some(Control.audit_decision(7, "a", 42, Control.RolloutHalted(1, "w1", "gate"))))
      assert (Option.is_some(Control.audit_decision(7, "a", 42, Control.RolloutComplete)))
      assert (Control.audit_decision(7, "a", 42, Control.RolloutWait(1, "x")) == None)
    end
  end
end
