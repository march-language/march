mod TestNetKernel do

  describe "NetKernel byte bridge" do

    test "str_to_bytes / bytes_to_str round-trip" do
      let s = "hello, net-kernel"
      assert (NetKernel.bytes_to_str(NetKernel.str_to_bytes(s)) == s)
    end

    test "str_to_bytes yields byte values 0..255" do
      -- "AB" -> [65, 66]
      assert (NetKernel.str_to_bytes("AB") == Cons(65, Cons(66, Nil)))
    end

  end

  describe "NetKernel.to_wire (frame + render for the socket)" do

    test "wire bytes decode back to the original payload via NetFrame" do
      let payload = Cons(7, Cons(8, Cons(9, Nil)))
      let wire = NetKernel.to_wire(payload)
      -- the receiver turns the socket string back into bytes and de-frames it
      assert (NetFrame.decode(NetKernel.str_to_bytes(wire)) == Some((payload, Nil)))
    end

  end

  describe "NetKernel full handshake-message round-trip (pure path)" do

    test "a framed Hello survives wire encode + decode" do
      let id = NodeIdentity.make("alice@host", "alice-pubkey", 1)
      let h = Handshake.make_hello(id, "nonce-xyz")
      -- sender: encode_hello -> to_wire (frame+string)
      let wire = NetKernel.to_wire(Handshake.encode_hello(h))
      -- receiver: string -> bytes -> de-frame -> decode_hello
      match NetFrame.decode(NetKernel.str_to_bytes(wire)) do
        Some((hbytes, _rest)) ->
          assert (Handshake.decode_hello(hbytes) == Ok(h))
        None -> assert false
      end
    end

  end


  describe "NetKernel REGISTRY_SYNC_RESP carries each entry's VectorClock" do

    test "a leaf's clock survives encode + decode" do
      let clock = VectorClock.increment(VectorClock.increment(VectorClock.new(), "node-a"), "node-a")
      let reg = GlobalRegistry.register(GlobalRegistry.empty(), "leader", "node-a", 100, clock)
      match NetKernel.decode_registry_sync_resp(NetKernel.encode_registry_sync_resp("h", GlobalRegistry.all_entries(reg))) do
        Ok((rh, Cons((name, e), Nil))) ->
          assert (rh == "h")
          assert (name == "leader")
          assert (e.node_id == "node-a")
          assert (VectorClock.get(e.clock, "node-a") == 2)
        _ -> assert false
      end
    end

    test "a four-element leaf (the original encoding, no clock) still decodes" do
      let leaf = Msgpack.array(Cons(Msgpack.str("svc"), Cons(Msgpack.str("n1"), Cons(Msgpack.int(7), Cons(Msgpack.int(1), Nil)))))
      let bytes = Msgpack.encode(Msgpack.array(Cons(Msgpack.int(6), Cons(Msgpack.str("r"), Cons(Msgpack.array(Cons(leaf, Nil)), Nil)))))
      match NetKernel.decode_registry_sync_resp(bytes) do
        Ok((_, Cons((name, e), Nil))) ->
          assert (name == "svc")
          assert (e.pid == 7)
          assert (VectorClock.sum(e.clock) == 0)
        _ -> assert false
      end
    end

    -- The partition shape: each side claimed "leader" concurrently; each
    -- merges the OTHER's registry as it arrives over the wire. Both must pick
    -- the same winner (tiebreak: the higher node_id).
    test "concurrent claims merged through the wire converge on both sides" do
      let a = GlobalRegistry.register(GlobalRegistry.empty(), "leader", "node-a", 100, VectorClock.increment(VectorClock.new(), "node-a"))
      let b = GlobalRegistry.register(GlobalRegistry.empty(), "leader", "node-b", 200, VectorClock.increment(VectorClock.new(), "node-b"))
      let over = fn reg -> NetKernel.decode_registry_sync_resp(NetKernel.encode_registry_sync_resp(GlobalRegistry.root_hash(reg), GlobalRegistry.all_entries(reg)))
      match (over(b), over(a)) do
        (Ok((rb, lb)), Ok((ra, la))) ->
          let a2 = GlobalRegistry.diff_entries(a, rb, lb)
          let b2 = GlobalRegistry.diff_entries(b, ra, la)
          assert (GlobalRegistry.lookup(a2, "leader") == Some(("node-b", 200)))
          assert (GlobalRegistry.lookup(b2, "leader") == Some(("node-b", 200)))
        _ -> assert false
      end
    end

  end


  describe "NetKernel REGISTRY_SYNC_RESP carries each entry's creation" do

    test "creation round-trips" do
      let r = GlobalRegistry.register_at(GlobalRegistry.empty(), "ap", "n1", 42, 7, VectorClock.increment(VectorClock.new(), "n1"))
      let bytes = NetKernel.encode_registry_sync_resp("h", GlobalRegistry.all_entries(r))
      match NetKernel.decode_registry_sync_resp(bytes) do
        Ok((_, Cons((_, e), Nil))) -> assert (e.creation == 42)
        _ -> assert false
      end
    end

    test "a 5-element leaf (no creation) decodes with creation 0" do
      let leaf = Msgpack.array(Cons(Msgpack.str("ap"), Cons(Msgpack.str("n1"), Cons(Msgpack.int(7),
                   Cons(Msgpack.int(1), Cons(Msgpack.array(Nil), Nil))))))
      let bytes = Msgpack.encode(Msgpack.array(Cons(Msgpack.int(6), Cons(Msgpack.str("h"), Cons(Msgpack.array(Cons(leaf, Nil)), Nil)))))
      match NetKernel.decode_registry_sync_resp(bytes) do
        Ok((_, Cons((_, e), Nil))) -> assert (e.creation == 0 && e.pid == 7)
        _ -> assert false
      end
    end

  end

  pfn stamped() : GlobalRegistry.Names do
    let r1 = GlobalRegistry.register_at(GlobalRegistry.empty(), "gone", "n1", 3, 7, VectorClock.increment(VectorClock.new(), "n1"))
    let r2 = GlobalRegistry.unregister(r1, "gone", VectorClock.increment(VectorClock.increment(VectorClock.new(), "n1"), "n1"))
    GlobalRegistry.collect_tombstones(r2, 123456, 1000)
  end

  describe "NetKernel REGISTRY_SYNC_RESP carries a tombstone's expiry stamp" do

    test "the stamp round-trips, and the clock and creation are untouched by it" do
      match NetKernel.decode_registry_sync_resp(NetKernel.encode_registry_sync_resp("h", GlobalRegistry.all_entries(stamped()))) do
        Ok((_, Cons((name, e), Nil))) ->
          assert (name == "gone")
          assert (e.retired_at == 123456)
          assert (!e.present)
          assert (e.creation == 3)
          -- an older node's decoder skips the [0, ms] pair the same way:
          -- the clock holds only the real actor entry
          assert (List.length(VectorClock.entries(e.clock)) == 1)
          assert (VectorClock.get(e.clock, "n1") == 2)
        _ -> assert false
      end
    end

    -- The reason the stamp travels: replicas that stamp at different times
    -- would otherwise hand a purged tombstone back to each other with a fresh
    -- countdown forever. With it, a copy re-sent after one side purged
    -- carries its old stamp and is dropped at the next pass.
    test "two replicas that stamped at different times both converge to empty" do
      let over = fn reg -> NetKernel.decode_registry_sync_resp(NetKernel.encode_registry_sync_resp(GlobalRegistry.root_hash(reg), GlobalRegistry.all_entries(reg)))
      let r1 = GlobalRegistry.register(GlobalRegistry.empty(), "gone", "n1", 7, VectorClock.increment(VectorClock.new(), "n1"))
      let t = GlobalRegistry.unregister(r1, "gone", VectorClock.increment(VectorClock.increment(VectorClock.new(), "n1"), "n1"))
      let a = GlobalRegistry.collect_tombstones(t, 1000, 500)
      let b = GlobalRegistry.collect_tombstones(t, 1300, 500)
      -- a purges first; b, not yet, re-sends its copy
      let a2 = GlobalRegistry.collect_tombstones(a, 1500, 500)
      assert (GlobalRegistry.tombstone_count(a2) == 0)
      match over(b) do
        Ok((rb, lb)) ->
          let a3 = GlobalRegistry.diff_entries(a2, rb, lb)
          assert (GlobalRegistry.tombstone_count(a3) == 1)
          -- a's next pass drops it on b's stamp; b's own pass drops its copy
          assert (GlobalRegistry.tombstone_count(GlobalRegistry.collect_tombstones(a3, 1800, 500)) == 0)
          assert (GlobalRegistry.tombstone_count(GlobalRegistry.collect_tombstones(b, 1800, 500)) == 0)
        _ -> assert false
      end
    end

    test "a present binding carries no stamp" do
      let r = GlobalRegistry.register(GlobalRegistry.empty(), "live", "n1", 7, VectorClock.increment(VectorClock.new(), "n1"))
      match NetKernel.decode_registry_sync_resp(NetKernel.encode_registry_sync_resp("h", GlobalRegistry.all_entries(r))) do
        Ok((_, Cons((_, e), Nil))) -> assert (e.retired_at == 0)
        _ -> assert false
      end
    end

  end

end
