mod TestTopology do

  -- Topology's pure half (stdlib/topology.march): the placement decision
  -- every node makes for itself, fed fake membership. The effectful half
  -- (offers opened, moved, drained over a real ClusterNode; the hook
  -- watchdog) runs compiled in test/native/topology_place and
  -- test/native/topology_hook_timeout.

  pfn nodes(n : Int) : List(String) do
    List.map(List.range(0, n), fn i -> "node-" ++ int_to_string(i))
  end

  pfn nth(xs : List(String), i : Int) : String do
    match List.drop(xs, i) do
      Cons(h, _) -> h
      Nil -> ""
    end
  end

  -- How many of [ids] offer [role] under [p], each deciding with the others
  -- as its eligible set.
  pfn offering(p : Topology.TopoPlacement, role : String, ids : List(String), labels : List(String)) : List(String) do
    List.filter(ids, fn me -> Topology.wants(p, role, me, labels, List.filter(ids, fn o -> o != me)))
  end

  pfn digest() : String do
    "{\"version\":1,\"roles\":[" ++
    "{\"name\":\"A.Srv\",\"place\":{\"on\":\"db\",\"count\":2},\"capacity\":3}," ++
    "{\"name\":\"B.Srv\",\"place\":null,\"capacity\":null}," ++
    "{\"name\":\"C.Srv\",\"place\":{\"on\":null,\"count\":1}}]," ++
    "\"pools\":[{\"name\":\"p\",\"serves\":[\"A.Srv\",\"B.Srv\"]},{\"name\":\"q\",\"serves\":[\"C.Srv\"]}]," ++
    "\"drain\":{\"soft_ms\":5,\"hard_ms\":null}}"
  end

  pfn names(ds : List(Topology.TopoDesired)) : List(String) do List.map(ds, fn d -> d.d_name) end

  describe "Topology placement: labels" do

    test "MARCH_NODE_LABELS-style lists parse, blanks dropped" do
      assert (Topology.labels_of("db, public") == ["db", "public"])
      assert (Topology.labels_of("") == Nil)
      assert (Topology.labels_of(" , gpu,") == ["gpu"])
    end

    test "Everywhere is offered by every node; On only where the label is" do
      assert (Topology.wants(Topology.everywhere(), "P.R", "a", Nil, Nil))
      assert (Topology.wants(Topology.on_label("db"), "P.R", "a", ["db"], Nil))
      assert (Topology.wants(Topology.on_label("db"), "P.R", "a", ["public"], Nil) == false)
      assert (Topology.ranked(Topology.everywhere()) == false)
      assert (Topology.ranked(Topology.count(1)))
    end

  end

  describe "Topology placement: rendezvous counts" do

    test "every node computes the same ranking, whatever order it saw members in" do
      let ids = nodes(6)
      let r1 = Topology.rank("Checkout.Ledger", ids)
      let r2 = Topology.rank("Checkout.Ledger", List.reverse(ids))
      assert (r1 == r2)
      assert (List.length(r1) == 6)
    end

    test "Count(n) is offered by exactly n nodes when all agree on membership" do
      let ids = nodes(5)
      assert (List.length(offering(Topology.count(1), "A.X", ids, Nil)) == 1)
      assert (List.length(offering(Topology.count(2), "A.X", ids, Nil)) == 2)
      assert (List.length(offering(Topology.count(9), "A.X", ids, Nil)) == 5)
    end

    test "different roles spread over different nodes" do
      let ids = nodes(8)
      let owners = List.map(["A.X", "A.Y", "B.X", "B.Y", "C.X", "C.Y"], fn r -> offering(Topology.count(1), r, ids, Nil))
      let distinct = List.dedup(List.concat(owners))
      assert (List.length(distinct) > 1)
    end

    test "a dead node's role moves to the next node in the ranking, and only it" do
      let ids = nodes(4)
      let before = offering(Topology.count(1), "Checkout.Ledger", ids, Nil)
      let ranked = Topology.rank("Checkout.Ledger", ids)
      let first = nth(ranked, 0)
      let second = nth(ranked, 1)
      assert (before == [first])
      let survivors = List.filter(ids, fn i -> i != first)
      assert (offering(Topology.count(1), "Checkout.Ledger", survivors, Nil) == [second])
    end

    test "CountOn needs the label as well as the rank" do
      assert (Topology.wants(Topology.count_on("db", 1), "P.R", "a", Nil, Nil) == false)
      assert (Topology.wants(Topology.count_on("db", 1), "P.R", "a", ["db"], Nil))
    end

  end

  describe "Topology placement: markers and settling" do

    test "marker names round-trip to node ids" do
      let names = [Topology.marker("P.R", "n1"), Topology.marker("P.R", "n2"),
                   Topology.marker("P.S", "n3"), "ap:P/1/n1"]
      assert (Topology.marked("P.R", names) == ["n1", "n2"])
      assert (Topology.marked("P.S", names) == ["n3"])
    end

    test "a rejoined node counts only after the settling period" do
      assert (Topology.settled(1000, None, 15000))
      assert (Topology.settled(10000, Some(0), 15000) == false)
      assert (Topology.settled(15000, Some(0), 15000))
    end

    -- A count = 1 role over two nodes: B took it over while A was down; A
    -- restarts, ranks first, and a peer showed it as rejoining at t = 1000.
    -- B does not count A for the settle period; A must not open the role
    -- for that long either, or two nodes offer it with no partition.
    test "a rejoining node that ranks first does not open a count role inside the settle period" do
      let ids = ["node-a", "node-b"]
      let ranked = Topology.rank("Order.Ledger", ids)
      let a = nth(ranked, 0)
      let b = nth(ranked, 1)
      let p = Topology.count(1)
      -- A wants it (it ranks first among both markers)...
      assert (Topology.wants(p, "Order.Ledger", a, Nil, [b]))
      -- ...B, which excludes the settling A, still wants it too...
      assert (Topology.wants(p, "Order.Ledger", b, Nil, Nil))
      -- ...so A may not open it until 15 s after it rejoined.
      assert (Topology.may_open(p, 1, 1500, 0, true, Some(1000), 15000) == false)
      assert (Topology.may_open(p, 1, 15999, 0, true, Some(1000), 15000) == false)
      assert (Topology.may_open(p, 1, 16000, 0, true, Some(1000), 15000))
    end

    test "a just-started node opens no ranked role before its first registry sync, for at most the settle period" do
      let p = Topology.count(1)
      -- Not synced: it sees no other marker yet, so wanting proves nothing.
      assert (Topology.may_open(p, 0, 500, 0, false, None, 15000) == false)
      -- Bounded: seeds unreachable for the whole period, it takes the role.
      assert (Topology.may_open(p, 0, 15000, 0, false, None, 15000))
      -- Synced, no peer remembers it (a fresh cluster): at once.
      assert (Topology.may_open(p, 1, 500, 0, true, None, 15000))
      -- Unranked roles are never held back.
      assert (Topology.may_open(Topology.everywhere(), 0, 0, 0, false, Some(0), 15000))
    end

    test "a rejoining node still fills a count its peers cannot" do
      -- Alone (the holder died while it was down), or fewer others than the count.
      assert (Topology.may_open(Topology.count(1), 0, 1500, 0, true, Some(1000), 15000))
      assert (Topology.may_open(Topology.count(3), 2, 1500, 0, true, Some(1000), 15000))
      assert (Topology.may_open(Topology.count(2), 2, 1500, 0, true, Some(1000), 15000) == false)
      assert (Topology.count_of(Topology.count_on("db", 2)) == 2)
      assert (Topology.count_of(Topology.everywhere()) == 0)
    end

  end

  describe "Topology reload: the digest a SIGHUP re-reads" do

    test "only the roles this process's pools serve, with placement, capacity and drain" do
      match Topology.desired_of(digest(), fn p -> p == "p") do
        Ok((ds, soft, hard)) ->
          assert (names(ds) == ["A.Srv", "B.Srv"])
          assert (List.map(ds, fn d -> Topology.placement_text(d.d_place)) == ["count 2 on db", "everywhere"])
          assert (List.map(ds, fn d -> d.d_capacity) == [3, 64])
          assert (soft == 5)
          assert (hard == 120000)
        Err(e) -> assert (e == "a digest")
      end
      match Topology.desired_of(digest(), fn p -> p == "q") do
        Ok((ds, _, _)) -> assert (List.map(ds, fn d -> Topology.placement_text(d.d_place)) == ["count 1"])
        Err(e) -> assert (e == "a digest")
      end
    end

    test "text that is not a version-1 digest is refused" do
      assert (Result.is_err(Topology.desired_of("{\"version\":2}", fn _ -> true)))
      assert (Result.is_err(Topology.desired_of("not json", fn _ -> true)))
    end

    test "the build's roles take the digest's placement; unserved ones are placed nowhere" do
      let none = fn _ -> Err(SessionNode.AlreadyOffered(0))
      let base = [Topology.offer_role("A.Srv", Topology.count(1), 4, none),
                  Topology.role("B.Srv", Topology.everywhere(), fn () -> Err(SessionNode.AlreadyOffered(0))),
                  Topology.offer_role("D.Srv", Topology.everywhere(), 4, none)]
      match Topology.desired_of(digest(), fn p -> p == "p") do
        Ok((ds, _, _)) ->
          let after = Topology.apply_desired(base, ds)
          assert (List.map(after, fn r -> Topology.placement_text(r.place)) == ["count 2 on db", "everywhere", "not served here"])
          -- A capacity from the digest, except where the build fixed it (0).
          assert (List.map(after, fn r -> r.capacity) == [3, 0, 4])
          assert (Topology.wants(Topology.PlaceNowhere, "D.Srv", "a", ["db"], Nil) == false)
        Err(e) -> assert (e == "a digest")
      end
    end

  end

end
