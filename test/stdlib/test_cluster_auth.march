mod TestClusterAuth do

  describe "ClusterAuth.prove" do

    test "is deterministic for the same secret and nonce" do
      assert (ClusterAuth.prove("s3cret", "nonce-1") == ClusterAuth.prove("s3cret", "nonce-1"))
    end

    test "depends on the secret" do
      assert (ClusterAuth.prove("s3cret", "nonce-1") != ClusterAuth.prove("other", "nonce-1"))
    end

    test "depends on the nonce" do
      assert (ClusterAuth.prove("s3cret", "nonce-1") != ClusterAuth.prove("s3cret", "nonce-2"))
    end

    test "does not leak the secret" do
      assert (ClusterAuth.prove("s3cret", "nonce-1") != "s3cret")
    end

  end

  describe "ClusterAuth.verify" do

    test "accepts a correct proof" do
      let nonce = "nonce-1"
      assert (ClusterAuth.verify("s3cret", nonce, ClusterAuth.prove("s3cret", nonce)))
    end

    test "rejects a wrong secret" do
      let nonce = "nonce-1"
      assert (not(ClusterAuth.verify("s3cret", nonce, ClusterAuth.prove("imposter", nonce))))
    end

    test "rejects a replayed proof for a different nonce" do
      assert (not(ClusterAuth.verify("s3cret", "nonce-2", ClusterAuth.prove("s3cret", "nonce-1"))))
    end

    test "rejects a tampered proof" do
      assert (not(ClusterAuth.verify("s3cret", "nonce-1", "deadbeef")))
    end

    -- verify compares with Crypto.secure_compare (constant-time in shape: no
    -- early exit on the first differing byte or on a length mismatch). Timing
    -- cannot be unit-tested; these pin that the comparison still answers right.
    test "rejects an equal-length proof differing only in the last byte" do
      let good = ClusterAuth.prove("s3cret", "nonce-1")
      let n = string_byte_length(good)
      let last = string_slice(good, n - 1, 1)
      let flipped = if last == "0" do "1" else "0" end
      let bad = string_slice(good, 0, n - 1) ++ flipped
      assert (string_byte_length(bad) == n)
      assert (not(ClusterAuth.verify("s3cret", "nonce-1", bad)))
    end

    test "rejects an equal-length proof differing only in the first byte" do
      let good = ClusterAuth.prove("s3cret", "nonce-1")
      let n = string_byte_length(good)
      let first = string_slice(good, 0, 1)
      let flipped = if first == "0" do "1" else "0" end
      let bad = flipped ++ string_slice(good, 1, n - 1)
      assert (not(ClusterAuth.verify("s3cret", "nonce-1", bad)))
    end

    test "rejects a correct proof with extra bytes appended" do
      let good = ClusterAuth.prove("s3cret", "nonce-1")
      assert (not(ClusterAuth.verify("s3cret", "nonce-1", good ++ "00")))
    end

    test "rejects a truncated proof and an empty proof" do
      let good = ClusterAuth.prove("s3cret", "nonce-1")
      let n = string_byte_length(good)
      assert (not(ClusterAuth.verify("s3cret", "nonce-1", string_slice(good, 0, n - 1))))
      assert (not(ClusterAuth.verify("s3cret", "nonce-1", "")))
    end

  end

  describe "ClusterAuth frame keys (step 11a)" do

    test "each side's send key is the other's receive key, and the directions differ" do
      let ikm = Bytes.from_string("shared")
      let th = ClusterAuth.transcript([1], "na", [2], "nb")
      let a = ClusterAuth.frame_keys(ikm, th, "na", "nb")
      let b = ClusterAuth.frame_keys(ikm, ClusterAuth.transcript([2], "nb", [1], "na"), "nb", "na")
      assert (a.tx_key == b.rx_key)
      assert (a.rx_key == b.tx_key)
      assert (a.tx_key != a.rx_key)
      assert (Bytes.length(a.tx_key) == 32)
    end

    test "the keys depend on the key material and on the transcript" do
      let th = ClusterAuth.transcript([1], "na", [2], "nb")
      let a = ClusterAuth.frame_keys(Bytes.from_string("s1"), th, "na", "nb")
      let other_ikm = ClusterAuth.frame_keys(Bytes.from_string("s2"), th, "na", "nb")
      let other_th = ClusterAuth.frame_keys(Bytes.from_string("s1"), ClusterAuth.transcript([1], "na", [3], "nb"), "na", "nb")
      assert (a.tx_key != other_ikm.tx_key)
      assert (a.tx_key != other_th.tx_key)
    end

    test "the MAC offer rides on the nonce" do
      assert (ClusterAuth.offers_mac("abc" ++ ClusterAuth.mac_suffix()))
      assert (not(ClusterAuth.offers_mac("abc")))
    end

    test "HKDF-SHA256 matches RFC 5869 test case 1 (first block)" do
      let ikm = Bytes.from_list(List.map(List.range(0, 22), fn _ -> 11))
      let salt = Result.unwrap_or(Bytes.from_hex("000102030405060708090a0b0c"), Bytes.empty())
      let prk = ClusterAuth.hkdf_extract(salt, ikm)
      assert (Bytes.to_hex(prk) == "077709362c2e32df0ddc3f0dc47bba6390b6c73bb50f9c3122ec844ad7c2b3e5")
    end

  end

end
