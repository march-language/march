mod TestPeerRegistry do

  pfn mk_peer(name : String, n : Int) : PeerRegistry.Peer do
    let id = NodeIdentity.make(name, name ++ "-key", n)
    { node_id: id.node_id, identity: id, fd: n, data_fd: PeerRegistry.no_fd() }
  end

  describe "PeerRegistry" do

    test "empty registry has no peers" do
      let r = PeerRegistry.empty()
      assert (PeerRegistry.size(r) == 0)
      assert (PeerRegistry.lookup(r, "nobody") == None)
    end

    test "add then lookup returns the peer" do
      let p = mk_peer("alice@host", 1)
      let r = PeerRegistry.add(PeerRegistry.empty(), p)
      assert (PeerRegistry.size(r) == 1)
      assert (PeerRegistry.lookup(r, p.node_id) == Some(p))
      assert (PeerRegistry.contains(r, p.node_id))
    end

    test "one connection per peer — re-add same NodeId replaces" do
      let p1 = mk_peer("alice@host", 1)
      let p2 = { node_id: p1.node_id, identity: p1.identity, fd: 99, data_fd: PeerRegistry.no_fd() }
      let r = PeerRegistry.add(PeerRegistry.add(PeerRegistry.empty(), p1), p2)
      assert (PeerRegistry.size(r) == 1)
      assert (PeerRegistry.lookup(r, p1.node_id) == Some(p2))
    end

    test "remove drops the peer" do
      let p = mk_peer("alice@host", 1)
      let r = PeerRegistry.remove(PeerRegistry.add(PeerRegistry.empty(), p), p.node_id)
      assert (PeerRegistry.size(r) == 0)
      assert (not(PeerRegistry.contains(r, p.node_id)))
    end

    test "distinct peers coexist" do
      let r = PeerRegistry.add(
                PeerRegistry.add(PeerRegistry.empty(), mk_peer("a@host", 1)),
                mk_peer("b@host", 2))
      assert (PeerRegistry.size(r) == 2)
    end

  end

  describe "PeerRegistry data connection" do

    test "a fresh peer has no data connection; add_data attaches one" do
      let r = PeerRegistry.add(PeerRegistry.empty(), mk_peer("a", 3))
      let id = NodeIdentity.make("a", "a-key", 3)
      match PeerRegistry.lookup(r, id.node_id) do
        Some(p) -> assert (PeerRegistry.has_data(p) == false)
        None -> assert false
      end
      match PeerRegistry.add_data(r, id.node_id, 44) do
        Err(_) -> assert false
        Ok(r2) ->
          match PeerRegistry.lookup(r2, id.node_id) do
            Some(p) ->
              assert (p.data_fd == 44)
              assert (p.fd == 3)
              assert (PeerRegistry.has_data(p))
            None -> assert false
          end
      end
    end

    test "add_data for an unknown peer is an Err" do
      match PeerRegistry.add_data(PeerRegistry.empty(), "nobody", 5) do
        Err(_) -> assert true
        Ok(_) -> assert false
      end
    end

  end

end
