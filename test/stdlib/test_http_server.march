-- test/stdlib/test_http_server.march
-- Tests for the HttpServer stdlib module.
-- Covers Conn construction, accessors, transforms, pipeline execution,
-- and server config. No actual TCP binding.
-- Run with: dune exec march -- test test/stdlib/test_http_server.march

mod TestHttpServer do

  needs IO.FileRead
  needs IO.FileWrite

-- Local mirrors of HttpServer private types (matched structurally at runtime).
-- Method field is now Atom (:get, :post, etc.) matching HttpServer.Conn.
ptype Upgrade = NoUpgrade | WebSocketUpgrade(a)
ptype Conn = Conn(
  Int, Atom, String, List(String), String,
  List(Header), String, Int, List(Header), String,
  Bool, List((String, String)), Upgrade
)

pfn make_conn(meth, path_, qs, req_hdrs, req_body) do
  let path_parts = List.filter(string_split(path_, "/"), fn s -> not(string_is_empty(s)))
  Conn(0, meth, path_, path_parts, qs, req_hdrs, req_body, 0, Nil, "", false, Nil, NoUpgrade)
end

pfn make_get(path_) do
  make_conn(:get, path_, "", Cons(Header("host", "localhost"), Nil), "")
end

pfn make_post(path_, body) do
  make_conn(:post, path_, "", Cons(Header("content-type", "text/plain"), Nil), body)
end

describe "HttpServer Conn accessors" do
  test "method accessor Get" do
    let conn = make_get("/users")
    assert (HttpServer.method(conn) == :get)
  end

  test "method accessor Post" do
    let conn = make_post("/submit", "data")
    assert (HttpServer.method(conn) == :post)
  end

  test "path accessor" do
    let conn = make_get("/api/v1/users")
    assert (HttpServer.path(conn) == "/api/v1/users")
  end

  test "path_info splits path segments" do
    let conn = make_get("/api/v1/users")
    let info = HttpServer.path_info(conn)
    assert (not (is_nil(info)))
    assert (head(info) == "api")
  end

  test "query_string accessor" do
    let conn = make_conn(:get, "/search", "q=hello&limit=5", Nil, "")
    assert (HttpServer.query_string(conn) == "q=hello&limit=5")
  end

  test "req_body accessor" do
    let conn = make_post("/submit", "my payload")
    assert (HttpServer.req_body(conn) == "my payload")
  end

  test "status is 0 by default" do
    let conn = make_get("/")
    assert (HttpServer.status(conn) == 0)
  end

  test "halted is false by default" do
    let conn = make_get("/")
    assert (not (HttpServer.halted(conn)))
  end
end

describe "HttpServer request header lookup" do
  test "get_req_header finds host" do
    let conn = make_get("/")
    assert (HttpServer.get_req_header(conn, "host") == Some("localhost"))
  end

  test "get_req_header is case insensitive" do
    let conn = make_get("/")
    assert (HttpServer.get_req_header(conn, "HOST") == Some("localhost"))
  end

  test "get_req_header returns None for missing header" do
    let conn = make_get("/")
    assert (HttpServer.get_req_header(conn, "x-missing") == None)
  end
end

describe "HttpServer Conn transforms" do
  test "put_resp_header adds header to resp_headers" do
    let conn = make_get("/")
    let conn2 = HttpServer.put_resp_header(conn, "X-Custom", "hello")
    let hdrs = HttpServer.resp_headers(conn2)
    assert (not (is_nil(hdrs)))
    match head(hdrs) do
    Header(n, v) -> do
      assert (string_to_lowercase(n) == "x-custom")
      assert (v == "hello")
    end
    end
  end

  test "assign stores and retrieves value" do
    let conn = make_get("/")
    let conn2 = HttpServer.assign(conn, "user_id", "42")
    assert (HttpServer.get_assign(conn2, "user_id") == Some("42"))
    assert (HttpServer.get_assign(conn2, "missing") == None)
  end

  test "send_resp sets status body and halts" do
    let conn = make_get("/")
    let conn2 = HttpServer.send_resp(conn, 200, "hello world")
    assert (HttpServer.status(conn2) == 200)
    assert (HttpServer.resp_body(conn2) == "hello world")
    assert (HttpServer.halted(conn2))
  end

  test "halt marks conn as halted" do
    let conn = make_get("/")
    let conn2 = HttpServer.halt(conn)
    assert (HttpServer.halted(conn2))
  end
end

describe "HttpServer convenience response builders" do
  test "text sets status body and halts" do
    let conn = make_get("/")
    let conn2 = HttpServer.text(conn, 200, "plain text")
    assert (HttpServer.status(conn2) == 200)
    assert (HttpServer.resp_body(conn2) == "plain text")
    assert (HttpServer.halted(conn2))
  end

  test "text sets content-type header" do
    let conn = make_get("/")
    let conn2 = HttpServer.text(conn, 200, "plain text")
    let hdrs = HttpServer.resp_headers(conn2)
    assert (not (is_nil(hdrs)))
    match head(hdrs) do
    Header(n, _) -> assert (string_to_lowercase(n) == "content-type")
    end
  end

  test "json sets status and body" do
    let conn = make_get("/")
    let conn2 = HttpServer.json(conn, 201, "{\"ok\":true}")
    assert (HttpServer.status(conn2) == 201)
    assert (HttpServer.resp_body(conn2) == "{\"ok\":true}")
  end

  test "redirect sets status 302 and halts" do
    let conn = make_get("/old")
    let conn2 = HttpServer.redirect(conn, "/new")
    assert (HttpServer.status(conn2) == 302)
    assert (HttpServer.halted(conn2))
  end
end

describe "HttpServer pipeline execution" do
  test "empty pipeline leaves conn unchanged" do
    let conn = make_get("/")
    let conn2 = HttpServer.run_pipeline(conn, Nil)
    assert (HttpServer.path(conn2) == "/")
    assert (not (HttpServer.halted(conn2)))
  end

  test "single plug is applied" do
    let conn = make_get("/")
    let add_header = fn c -> HttpServer.put_resp_header(c, "X-Plug", "ran")
    let conn2 = HttpServer.run_pipeline(conn, Cons(add_header, Nil))
    assert (not (is_nil(HttpServer.resp_headers(conn2))))
  end

  test "pipeline stops when halted" do
    let conn = make_get("/")
    let halt_plug       = fn c -> HttpServer.halt(c)
    let add_after_halt  = fn c -> HttpServer.put_resp_header(c, "X-After-Halt", "bad")
    let conn2 = HttpServer.run_pipeline(conn, Cons(halt_plug, Cons(add_after_halt, Nil)))
    assert (HttpServer.halted(conn2))
    let hdrs = HttpServer.resp_headers(conn2)
    let has_bad = List.any(hdrs, fn h ->
      match h do Header(n, _) -> string_to_lowercase(n) == "x-after-halt" end)
    assert (not(has_bad))
  end

  test "multiple plugs all run when not halted" do
    let conn = make_get("/")
    let plug1 = fn c -> HttpServer.assign(c, "step", "1")
    let plug2 = fn c -> HttpServer.assign(c, "done", "yes")
    let conn2 = HttpServer.run_pipeline(conn, Cons(plug1, Cons(plug2, Nil)))
    assert (HttpServer.get_assign(conn2, "step") == Some("1"))
    assert (HttpServer.get_assign(conn2, "done") == Some("yes"))
  end
end

describe "HttpServer server config" do
  test "new creates a server without panicking" do
    let _srv = HttpServer.new(4000)
    ()
  end

  test "https builders return a Server" do
    let _srv = HttpServer.new(4443)
      |> HttpServer.tls(HttpServer.TlsFiles("/etc/cert.pem", "/etc/key.pem"))
      |> HttpServer.tls_handshake_timeout(5)
      |> HttpServer.tls_poll_interval(0)
      |> HttpServer.tls_wait_for_cert()
      |> HttpServer.header_timeout(10)
      |> HttpServer.progress_timeout(10)
      |> HttpServer.plain_listener(8080, [fn c -> HttpServer.text(c, 200, "plain")])
    ()
  end
end

pfn req(meth, path_, qs, hdrs) do
  make_conn(meth, path_, qs, hdrs, "")
end

pfn run(plug, conn) do
  plug(conn)
end

pfn host(h) do
  Cons(Header("host", h), Nil)
end

pfn acme_path(token) do
  "/.well-known/acme-challenge/" ++ token
end

pfn refused_token(t) do
  let c = run(HttpServer.acme_responder(fn _ -> Some("leak")), req(:get, acme_path(t), "", host("e.com")))
  HttpServer.status(c) == 404 && HttpServer.resp_body(c) != "leak"
end

pfn lookup_tok(t) do
  if t == "tok" do Some("tok.key") else None end
end

describe "HttpServer.redirect_to_https" do
  test "GET redirects 301 to https on the default port, query kept" do
    let c = run(HttpServer.redirect_to_https(443), req(:get, "/a", "b=1", host("example.com:8080")))
    assert (HttpServer.status(c) == 301)
    assert (HttpServer.get_resp_header(c, "location") == Some("https://example.com/a?b=1"))
    assert (HttpServer.halted(c))
  end

  test "a non-default port is kept in the location" do
    let c = run(HttpServer.redirect_to_https(8443), req(:get, "/a", "", host("example.com")))
    assert (HttpServer.get_resp_header(c, "location") == Some("https://example.com:8443/a"))
  end

  test "HEAD is 301 too" do
    let c = run(HttpServer.redirect_to_https(443), req(:head, "/", "", host("example.com")))
    assert (HttpServer.status(c) == 301)
  end

  test "POST is 308" do
    let c = run(HttpServer.redirect_to_https(443), req(:post, "/form", "", host("example.com")))
    assert (HttpServer.status(c) == 308)
    assert (HttpServer.get_resp_header(c, "location") == Some("https://example.com/form"))
  end

  test "no Host header is 400" do
    let c = run(HttpServer.redirect_to_https(443), req(:get, "/", "", Nil))
    assert (HttpServer.status(c) == 400)
    assert (HttpServer.halted(c))
  end

  test "ACME challenge paths pass through" do
    let c = run(HttpServer.redirect_to_https(443), req(:get, acme_path("x"), "", host("example.com")))
    assert (not(HttpServer.halted(c)))
    assert (HttpServer.status(c) == 0)
  end
end

describe "HttpServer.acme_responder" do
  test "a known token is answered 200 with its key authorization" do
    let c = run(HttpServer.acme_responder(lookup_tok), req(:get, acme_path("tok"), "", host("e.com")))
    assert (HttpServer.status(c) == 200)
    assert (HttpServer.resp_body(c) == "tok.key")
    assert (HttpServer.get_resp_header(c, "content-type") == Some("text/plain"))
  end

  test "an unknown token is 404" do
    let c = run(HttpServer.acme_responder(lookup_tok), req(:get, acme_path("nope"), "", host("e.com")))
    assert (HttpServer.status(c) == 404)
  end

  test "tokens outside the base64url alphabet are 404, never looked up" do
    assert (refused_token("..%2f"))
    assert (refused_token("a.b"))
    assert (refused_token("a/b"))
    assert (refused_token(".."))
    assert (refused_token(""))
  end

  test "other paths pass through" do
    let c = run(HttpServer.acme_responder(lookup_tok), req(:get, "/other", "", host("e.com")))
    assert (not(HttpServer.halted(c)))
  end
end

describe "HttpServer.acme_webroot" do
  test "serves the challenge file certbot wrote" do
    let dir = "/tmp/march_acme_webroot_test"
    let _ = Dir.mkdir_p(dir ++ "/.well-known/acme-challenge")
    let _ = File.write(dir ++ "/.well-known/acme-challenge/abc_-9", "abc_-9.thumbprint")
    let c = run(HttpServer.acme_webroot(dir), req(:get, acme_path("abc_-9"), "", host("e.com")))
    assert (HttpServer.status(c) == 200)
    assert (HttpServer.resp_body(c) == "abc_-9.thumbprint")
  end

  test "a missing file is 404" do
    let c = run(HttpServer.acme_webroot("/tmp/march_acme_webroot_test"), req(:get, acme_path("missing"), "", host("e.com")))
    assert (HttpServer.status(c) == 404)
  end

  test "a traversal token is 404" do
    let c = run(HttpServer.acme_webroot("/tmp/march_acme_webroot_test"), req(:get, acme_path(".."), "", host("e.com")))
    assert (HttpServer.status(c) == 404)
  end

  test "other paths pass through" do
    let c = run(HttpServer.acme_webroot("/tmp"), req(:get, "/other", "", host("e.com")))
    assert (not(HttpServer.halted(c)))
  end
end

describe "HttpServer scheme" do
  test "a conn with no TLS session is http" do
    assert (HttpServer.scheme(make_get("/")) == "http")
  end
end

end
