mod TestNodeQueue do

  pfn xs(n : Int, acc : List(Int)) : List(Int) do
    if n <= 0 do acc else xs(n - 1, Cons(120, acc)) end
  end

  pfn frame40() : Bytes do Bytes.from_list(xs(40, Nil)) end

  describe "NodeQueue CREDIT frames" do

    test "round-trips the consumed total" do
      assert (NodeQueue.decode_credit(NodeQueue.encode_credit(4096)) == Ok(4096))
      assert (NodeQueue.decode_credit(NodeQueue.encode_credit(0)) == Ok(0))
    end

    test "another tag is not a CREDIT" do
      match NodeQueue.decode_credit(NodeSend.encode_failed(1, "x")) do
        Err(_) -> assert true
        Ok(_) -> assert false
      end
    end

  end

  describe "NodeQueue budget" do

    test "drop_new refuses the frame that would exceed the budget, synchronously" do
      let q = NodeQueue.start(-1, 100)
      assert (NodeQueue.enqueue(q, 1, frame40(), NodeQueue.DropNew) == Ok(()))
      assert (NodeQueue.enqueue(q, 2, frame40(), NodeQueue.DropNew) == Ok(()))
      assert (NodeQueue.enqueue(q, 3, frame40(), NodeQueue.DropNew) == Err(NodeQueue.Backpressure))
    end

    test "a refused frame is not charged to the budget" do
      let q = NodeQueue.start(-2, 50)
      assert (NodeQueue.enqueue(q, 1, frame40(), NodeQueue.DropNew) == Ok(()))
      assert (NodeQueue.enqueue(q, 2, frame40(), NodeQueue.DropNew) == Err(NodeQueue.Backpressure))
      assert (NodeQueue.depth(q) == 40)
    end

    -- It could never fit, so refusing it would refuse it forever.
    test "a frame larger than the whole budget is admitted into an empty queue, alone" do
      let q = NodeQueue.start(-4, 30)
      assert (NodeQueue.enqueue(q, 1, frame40(), NodeQueue.DropNew) == Ok(()))
      assert (NodeQueue.enqueue(q, 2, frame40(), NodeQueue.DropNew) == Err(NodeQueue.Backpressure))
    end

    test "unbounded admits past the budget and charges every frame" do
      let q = NodeQueue.start(-5, 50)
      assert (NodeQueue.enqueue(q, 1, frame40(), NodeQueue.Unbounded) == Ok(()))
      assert (NodeQueue.enqueue(q, 2, frame40(), NodeQueue.Unbounded) == Ok(()))
      assert (NodeQueue.enqueue(q, 3, frame40(), NodeQueue.Unbounded) == Ok(()))
      assert (NodeQueue.depth(q) == 120)
    end

    test "drop_old admits the frame" do
      let q = NodeQueue.start(-3, 50)
      assert (NodeQueue.enqueue(q, 1, frame40(), NodeQueue.DropOld) == Ok(()))
      assert (NodeQueue.enqueue(q, 2, frame40(), NodeQueue.DropOld) == Ok(()))
    end

  end

  describe "NodeQueue.cast" do

    test "take_evicted reports what drop_old evicted (call routing to handler 0)" do
      let q = NodeQueue.start(-1, 10)
      let _ = NodeQueue.enqueue(q, 1, Bytes.from_string("aaaaaaaa"), NodeQueue.DropNew)
      let _ = NodeQueue.enqueue(q, 2, Bytes.from_string("bbbbbbbb"), NodeQueue.DropOld)
      assert (NodeQueue.take_evicted(q) == Cons(1, Nil))
      assert (NodeQueue.take_evicted(q) == Nil)
    end

    test "block_sender admits at once when the frame fits" do
      let q = NodeQueue.start(-1, 10)
      match NodeQueue.enqueue(q, 1, Bytes.from_string("aaaa"), NodeQueue.BlockSender(100)) do
        Ok(_) -> assert (true)
        Err(_) -> assert (false)
      end
      assert (NodeQueue.depth(q) == 4)
    end

    -- fd -1: the writer's first write fails and marks the connection dead.
    -- A blocking send then must not wait for credit that can never come.
    test "block_sender on a dead connection is NoConnection at once, nothing queued" do
      let q = NodeQueue.start(-1, 10)
      let _ = NodeQueue.enqueue(q, 1, Bytes.from_string("aaaaaaaa"), NodeQueue.DropNew)
      match NodeQueue.enqueue(q, 2, Bytes.from_string("bbbbbbbb"), NodeQueue.BlockSender(50)) do
        Err(NodeQueue.NoConnection) -> assert (true)
        _ -> assert (false)
      end
      assert (NodeQueue.depth(q) == 8)
    end

    test "an ACTOR_MSG is charged by its framed size" do
      let q = NodeQueue.start(-4, 60)
      let to = GlobalPid.make("n", 1, 1)
      assert (NodeQueue.cast(q, 1, to, "T.M", Nil, NodeQueue.DropNew) == Ok(()))
      let framed = 4 + List.length(NodeSend.encode_msg(1, to, "T.M", Nil))
      assert (NodeQueue.depth(q) == framed)
    end

  end

end
