mod TestSessionNode do

  -- The role runner's pure half (specs/progress/2026-09-16-role-runner.md):
  -- who dials whom, which addresses a role needs, how an address parses.
  -- The socket half runs in test/two_node/fan and test/two_node/gone.

  pfn addr(role : Int, s : String) do
    match SessionNode.parse_addr(role, s) do
      Ok(a) -> a
      Err(e) -> panic(e)
    end
  end

  describe "SessionNode role runner: topology" do

    test "a role dials the peers below it, ascending, and accepts those above" do
      assert (SessionNode.dials(3, [1, 4, 2]) == [1, 2])
      assert (SessionNode.accepts(3, [1, 4, 2]) == [4])
      assert (SessionNode.dials(1, [2, 3]) == Nil)
      assert (SessionNode.accepts(3, [1, 2]) == Nil)
    end

    test "the missing addresses are named: every dialled peer, and itself iff it accepts" do
      let a1 = addr(1, "127.0.0.1:20001")
      assert (SessionNode.missing_addrs(3, [1, 2, 4], [a1]) == [3, 2])
      assert (SessionNode.missing_addrs(4, [1, 2, 3], [a1]) == [2, 3])
      assert (SessionNode.missing_addrs(1, [2, 3], Nil) == [1])
      assert (SessionNode.missing_addrs(1, [2, 3], [a1]) == Nil)
      assert (SessionNode.missing_addrs(2, [1], [a1]) == Nil)
    end

  end

  describe "SessionNode role runner: addresses" do

    test "host:port parses into the role's entry" do
      let a = addr(2, "10.0.0.5:8080")
      assert (a.role == 2)
      assert (a.host == "10.0.0.5")
      assert (a.port == 8080)
    end

    test "anything else is an error, not an entry" do
      match SessionNode.parse_addr(2, "nope") do
        Err(_) -> assert true
        Ok(_) -> assert false
      end
      match SessionNode.parse_addr(2, "host:x") do
        Err(_) -> assert true
        Ok(_) -> assert false
      end
    end

    test "addrs_from_env yields no entry for an unset role" do
      assert (List.length(SessionNode.addrs_from_env("MARCH_TEST_NEVER_SET", [("A", 1), ("B", 2)])) == 0)
    end

    test "a run error names its role" do
      assert (SessionNode.run_error_message(SessionNode.Cancelled(2, "role 3: connection lost")) == "session_node: cancelled while waiting on role 2: role 3: connection lost")
      assert (SessionNode.run_error_message(SessionNode.Connect(3, "refused")) == "session_node: connect to role 3: refused")
    end

  end

  -- A HOSTED endpoint's `suspend` runs in the host actor's turn: it installs
  -- the continuation and only SENDS the endpoint actor a `Drain` for what
  -- was parked meanwhile. A delivery that the endpoint actor handles between
  -- the two (a peer that sent two messages back to back) found the
  -- continuation installed and was forwarded at once, AHEAD of the older
  -- parked message: the host, awaiting the first, was resumed with the
  -- second, and the generated `resume` panicked "unexpected message in state
  -- S_recv_Hello" (hosted_protocol_change under ASan,
  -- specs/progress/2026-10-05-hosted-protocol-change-unexpected-hello-under-asan.md).
  -- This forces that interleaving: park one, install the continuation as
  -- the host's suspend does with its Drain not yet run, deliver the second.
  describe "SessionNode delivery: per-sender FIFO" do

    test "a delivery behind a parked one from the same sender waits its turn" do
      let p = SessionNode.party(2, "fifo-test", fn _ -> ())
      let got : Vault(String) = Vault.new("test_session_node_fifo_got")
      Vault.set(p.forward, "f", fn (_from, msg, _ep) ->
        Vault.set(got, "seen", Vault.get_or(got, "seen", "") ++ Bytes.to_string(msg) ++ ";"))
      -- No continuation yet (the host has not parked): the first is parked.
      let _ = SessionNode.deliver(p, 2, 1, Bytes.from_string("hello"))
      assert (Vault.get_or(got, "seen", "") == "")
      -- The host parks: its continuation is installed, its Drain still queued.
      Vault.set(p.waiting, "e2", 1)
      Vault.set(p.handlers, "e2", fn (_f, _m, ep) -> ep)
      -- The sender's second message arrives before that Drain runs.
      let _ = SessionNode.deliver(p, 2, 1, Bytes.from_string("go"))
      assert (Vault.get_or(got, "seen", "") == "hello;")
      -- "go" is parked for the host's next suspension.
      match Vault.get_or(p.pending, "e2", Nil) do
        Cons((1, m), Nil) -> assert (Bytes.to_string(m) == "go")
        _ -> assert false
      end
      kill(p.ep)
    end

  end
end
