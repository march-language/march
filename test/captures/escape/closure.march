-- A function that captured a scoped handle, returned from the callback.
mod EscapeClosure do
  needs IO.FileRead, IO.Console

  fn main() do
    match File.with_open("data.txt", fn h -> fn () -> File.read_line(h)) do
      Ok(Ok(next)) ->
        match next() do
          Err(File.Closed) -> println("used after close: Err(Closed)")
          _ -> println("the handle still worked")
        end
      _ -> println("open failed")
    end
  end
end
