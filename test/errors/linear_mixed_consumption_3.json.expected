{"severity":"error","file":"errors/linear_mixed_consumption_3.march","start_line":9,"start_col":18,"end_line":13,"end_col":7,"message":"The linear value `s` is consumed on some branches but not others.\nOn a branch that doesn't consume it, the value is dropped. Consume it on every branch, or end that branch with `panic(…)` if it never returns.","code":"linear_mixed_consumption","fix":null,"labels":[{"file":"errors/linear_mixed_consumption_3.march","start_line":10,"start_col":16,"end_line":10,"end_col":17,"message":"`s` is consumed on this branch"},{"file":"errors/linear_mixed_consumption_3.march","start_line":12,"start_col":11,"end_line":12,"end_col":12,"message":"but not on this one, where it is dropped"}],"notes":[]}
