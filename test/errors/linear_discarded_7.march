-- EXPECT-ERROR: The linear value `state.parked` is used more than once here
mod Main do
  needs IO
  needs IO.Console
  needs IO.Mut
  needs Session.Live
  @[endpoints]
  protocol Stream do
    loop do
      Prod -> Cons : Int
      choose by Cons:
        more -> Cons -> Prod : Bool
        done -> Cons -> Prod : Bool
                stop
      end
    end
  end
  -- A handler that resumes and never parks again: returning `state`
  -- unchanged keeps the resumed value (R2: using the record whole moves every
  -- field it holds, and `parked` was already moved out by `resume`).
  actor ConsActor do
    state { budget : Int, parked : Stream_Cons.Parked_Cons }
    init  { budget: 2, parked: Stream_Cons.idle() }
    on DeliverC(s : Cap(Session.Live), from : Int, msg : Bytes, ep : Int) do
      match Stream_Cons.resume(state.parked, from, msg, ep) do
        Got_Msg_Prod_Cons_1(_n, st) ->
          let _ = Stream_Cons.finish(s, Stream_Cons.choose_done(s, st, true))
          state
      end
    end
  end
  fn main(c : Cap(IO)) do
    let _ = spawn(ConsActor)
    ()
  end
end
