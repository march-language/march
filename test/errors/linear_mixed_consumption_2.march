-- EXPECT-ERROR: The linear value `st` is consumed on some branches but not others
mod Main do
  needs IO.Console
  -- A linear value consumed in one branch and not the other leaks on the other.
  -- Branch joins used to UNION the paths (consumed on some path = consumed),
  -- so linear values behaved affinely across branches. Accepted before
  -- 2026-09-13.
  always_linear type S1 = S1(Int)
  fn sink(s : S1) : Int do match s do S1(e) -> e end end
  fn g(b : Bool, st : S1) : Int do
    if b do sink(st) else 0 end
  end
  fn main(c : Cap(IO.Console)) do
    println(int_to_string(g(false, S1(1))))
  end
end
