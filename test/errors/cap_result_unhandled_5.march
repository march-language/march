-- EXPECT-ERROR: This capability operation returns
mod Main do
  needs IO.Console
  needs IO.FileRead

  -- A match written for File.read's own Result, now nested inside the
  -- capability one: an `Err(NotFound(_))` arm says so. The fix wraps the
  -- scrutinee in `Authority.must(...)`; the arms stay as they are.
  fn motd() : String do
    match File.read("/etc/motd") do
    Ok(s) -> s
    Err(NotFound(_)) -> ""
    Err(_) -> "?"
    end
  end

  fn main(_c : Cap(IO.Console), _r : Cap(IO.FileRead)) do
    println(motd())
  end
end
