mod Main do
  needs IO.Console
  needs IO.FileRead
  mod Config do
    needs IO.Console
    fn motd() : String do
      match Authority.must(File.read("/etc/motd")) do
        Ok(s) -> s
        Err(_) -> ""
      end
    end
  end

  fn main() needs IO.Console, IO.FileRead do
    println(Config.motd())
  end
end
