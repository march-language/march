-- EXPECT-ERROR: The linear value `st` is used more than once here
mod Main do
  needs IO.Console
  -- A parameter's linearity was decided when it was bound, from its type at
  -- that moment. Unannotated, that type is a fresh variable, so `st` was never
  -- tracked, even though `sink(st)` fixes it to an always_linear type a token
  -- later. Accepted before 2026-09-13; annotated, it was always rejected.
  always_linear type S1 = S1(Int)
  fn sink(s : S1) : Int do match s do S1(e) -> e end end
  fn g(st) : Int do sink(st) + sink(st) end
  fn main(c : Cap(IO.Console)) do
    println(int_to_string(g(S1(1))))
  end
end
