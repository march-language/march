mod Main do
  needs IO.Console
  needs IO.Mut
  needs IO.Spawn

  fn main() needs IO.Console, IO.Mut, IO.Spawn do
    let best = Authority.must(Vault.new("best"))
    let _ = List.pmap([3, 9, 4], fn x -> Vault.set(best, "max", x * x))
    println(int_to_string(Vault.get_or(best, "max", 0)))
  end
end
