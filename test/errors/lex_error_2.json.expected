{"severity":"error","file":"errors/lex_error_2.march","start_line":4,"start_col":12,"end_line":4,"end_col":13,"message":"This string is never closed: I reached the end of the file inside it.","code":"lex_error","fix":{"kind":"replace","start_line":4,"start_col":16,"end_line":4,"end_col":16,"text":"\"","applicability":"maybe-incorrect"},"labels":[],"notes":["A string can span lines, so a missing `\"` makes the strings after it swap inside and out. This is the first one that runs past its line; close it where it should end."],"category":"SYNTAX"}
