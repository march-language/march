mod Main do
  needs IO.Console

  actor Worker do
    state { n : Int }
    init { n: 0 }
    on Tick() do { state with n: state.n + 1 } end
  end

  actor Pool do
    state { worker : Int }
    init { worker: 0 }
    supervise do
      strategy one_for_one
      max_restarts 5 within 30
      Worker wroker
    end
  end

  fn main(_c : Cap(IO.Console)) do
    let _ = spawn(Pool)
  end
end
