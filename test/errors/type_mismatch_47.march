-- EXPECT-ERROR: expected `Int` but got `String`
-- REJECT (§X1 slice 3): with no known type, a `match do` arm is checked against the first arm, at the arm, the right way round.
mod Grade do
  fn grade(n : Int) : Int do
    let g = match do
      n > 90 -> 4
      n > 80 -> "B"
      true -> 0
    end
    g
  end
  fn main() : Int do grade(85) end
end
