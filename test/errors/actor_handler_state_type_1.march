-- EXPECT-ERROR: The handler for `Poke` in actor `A` must return the actor's new state
-- A handler returns the actor's new state; this one returns the field.
mod Main do
  actor A do
    state { n : Int }
    init { n: 0 }
    on Poke(k : Int) do state.n + k end
  end

  fn main() : Int do 0 end
end
