{"severity":"error","file":"errors/spawn_not_actor_1.march","start_line":16,"start_col":18,"end_line":16,"end_col":24,"message":"`helper` is a function, not an actor, so `spawn` cannot start it.\n`spawn` takes the name of an `actor` declaration, like `spawn(Counter)`.","code":"spawn_not_actor","fix":null,"labels":[],"notes":[],"category":"ACTOR"}
