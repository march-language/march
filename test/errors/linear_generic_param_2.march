-- EXPECT-ERROR: `S1` is linear, but `dup` is generic in a parameter of that type
mod Main do
  needs IO.Console
  -- A type variable was never restricted, so a generic function could
  -- duplicate a value of its type parameter, and nothing stopped that
  -- parameter being instantiated with a linear type: one S1 became two.
  -- Accepted before 2026-09-13. Type variables are now unrestricted, and a
  -- generic function must opt in (`linear x : a`) to receive a linear value.
  always_linear type S1 = S1(Int)
  fn sink(s : S1) : Int do match s do S1(e) -> e end end
  fn dup(x) do (x, x) end
  fn main(c : Cap(IO.Console)) do
    let (a, b) = dup(S1(1))
    println(int_to_string(sink(a) + sink(b)))
  end
end
