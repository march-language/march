{"severity":"error","file":"errors/linear_discarded_6.march","start_line":29,"start_col":14,"end_line":29,"end_col":15,"message":"This `_` discards a linear value of type `Parked_Cons`.\nLinear values must be consumed exactly once. Bind it to a name and pass it to something that consumes it.","code":"linear_discarded","fix":null,"labels":[],"notes":[]}
{"severity":"error","file":"errors/linear_discarded_6.march","start_line":30,"start_col":10,"end_line":30,"end_col":49,"message":"The linear value `state.parked` is used more than once here.\nLinear values must be consumed exactly once — they cannot be copied or ignored.","code":"linear_used_twice","fix":null,"labels":[{"file":"errors/linear_discarded_6.march","start_line":27,"start_col":31,"end_line":27,"end_col":43,"message":"`state.parked` was already consumed here"}],"notes":["`{ state with … }` keeps every field it doesn't replace, so the old `state.parked` would survive into the new record. Replace it too: `{ state with parked: … }`."]}
