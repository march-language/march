{"severity":"error","file":"errors/linear_mixed_consumption_5.march","start_line":13,"start_col":12,"end_line":16,"end_col":9,"message":"The linear value `m` is consumed on some branches but not others.\nOn a branch that doesn't consume it, the value is dropped. Consume it on every branch, or end that branch with `panic(…)` if it never returns.","code":"linear_mixed_consumption","fix":null,"labels":[{"file":"errors/linear_mixed_consumption_5.march","start_line":14,"start_col":39,"end_line":14,"end_col":40,"message":"`m` is consumed on this branch"},{"file":"errors/linear_mixed_consumption_5.march","start_line":15,"start_col":19,"end_line":15,"end_col":60,"message":"but not on this one, where it is dropped"}],"notes":[]}
{"severity":"error","file":"errors/linear_mixed_consumption_5.march","start_line":15,"start_col":19,"end_line":15,"end_col":60,"message":"The linear value `state.sessions` is used more than once here.\nLinear values must be consumed exactly once — they cannot be copied or ignored.","code":"linear_used_twice","fix":null,"labels":[{"file":"errors/linear_mixed_consumption_5.march","start_line":12,"start_col":36,"end_line":12,"end_col":50,"message":"`state.sessions` was already consumed here"}],"notes":["`{ state with … }` keeps every field it doesn't replace, so the old `state.sessions` would survive into the new record. Replace it too: `{ state with sessions: … }`."]}
{"severity":"hint","file":"errors/linear_mixed_consumption_5.march","start_line":21,"start_col":12,"end_line":21,"end_col":20,"message":"Constructor `Close` is defined by multiple types (Host_Msg, WsFrame). Use a qualified form to disambiguate, e.g. `Host_Msg.Close`.","code":"ambiguous_constructor","fix":null,"labels":[],"notes":[]}
