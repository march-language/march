{"severity":"error","file":"errors/cap_needs_10.march","start_line":14,"start_col":12,"end_line":14,"end_col":22,"message":"`file_write` is internal to the standard library; use `File.write`.","code":"stdlib_internal","fix":{"kind":"replace","start_line":14,"start_col":12,"end_line":14,"end_col":50,"text":"Authority.must(File.write(\"/tmp/n\", int_to_string(n)))","applicability":"machine-applicable"},"labels":[],"notes":[],"category":"PROGRAM"}
{"severity":"error","file":"errors/cap_needs_10.march","start_line":14,"start_col":12,"end_line":14,"end_col":22,"message":"`save` writes a file, but module `Main` declares no `needs IO.FileWrite`, and `main` is granted only `needs IO.Console`.\nhint: add this to the module body —\n        needs IO.FileWrite\nand add `IO.FileWrite` to `main`'s request.","code":"cap_needs:IO.FileWrite","fix":{"kind":"multi","edits":[{"kind":"insert","after_line":10,"text":"  needs IO.FileWrite"},{"kind":"replace","start_line":18,"start_col":28,"end_line":18,"end_col":28,"text":", IO.FileWrite"}],"applicability":"machine-applicable"},"labels":[{"file":"errors/cap_needs_10.march","start_line":19,"start_col":4,"end_line":19,"end_col":8,"message":"`main` calls `save` here"},{"file":"errors/cap_needs_10.march","start_line":18,"start_col":9,"end_line":18,"end_col":11,"message":"`main` is granted only `needs IO.Console` here"}],"notes":[],"category":"CAPABILITY"}
{"severity":"error","file":"errors/cap_needs_10.march","start_line":18,"start_col":12,"end_line":18,"end_col":28,"message":"`main` is bounded by `needs IO.Console`, but reaches `IO.FileWrite` (via save).\nhelp: add `IO.FileWrite` to the bound, or remove the use.","code":"cap_bound","fix":null,"labels":[],"notes":[],"category":"CAPABILITY"}
