-- EXPECT-ERROR: came from `Chan.offer`
mod Main do
  -- Session-types final review, Finding 1 (2026-07-27) -- the `t95`
  -- unrefined-`Chan.offer` guard was LAUNDERABLE BY UNIFICATION.
  --
  -- `env.offer_unrefined` marks the exact session ref `Chan.offer` minted and
  -- the `Chan.*` operation arms test it by PHYSICAL identity. But `unify`'s
  -- `TChan` arm never aliased refs -- it only compared states -- so a type
  -- ANNOTATION whose session state happens to equal the guessed first branch
  -- minted a DIFFERENT, unmarked ref carrying that same state, and the guard
  -- could never fire again.
  --
  -- Here `D2`'s branches continue differently (`Int` vs `String`) so `cc2` is
  -- marked; `Chan(C, E)` is exactly `S -> C : Int`, the FIRST branch, so it
  -- unifies cleanly. Pre-fix: `--check` exit 0, and compiled this read the
  -- String payload's heap pointer as an Int (observed: `40852523489`). The
  -- fix rejects the unification itself: an unrefined offer continuation may
  -- not be unified with any other channel type, only refined by a `match` on
  -- its paired label. Sibling witness for the `if`-join shape: `t99`.
  -- Base witness (no laundering at all): `t95`. Accept twin: `t43`.
  needs IO.Console
  type C = C
  type S = S

  protocol D2 do
    choose by S:
      ok  -> S -> C : Int
      err -> S -> C : String
    end
  end

  protocol E do
    S -> C : Int
  end

  fn main() do
    let (cc, sc) = Chan.new(D2)
    let sc2 = Chan.choose(sc, :err)
    let sc3 = Chan.send(sc2, "boom")
    Chan.close(sc3)
    let (lbl, cc2) = Chan.offer(cc)
    -- The laundering: a fresh, unmarked ref at the same state.
    let ch : Chan(C, E) = cc2
    let (v, ch2) = Chan.recv(ch)
    Chan.close(ch2)
    println(int_to_string(v + 1))
  end
end
