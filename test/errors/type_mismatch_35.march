-- EXPECT-ERROR: this function's result is its `b`
-- REJECT (§X1 slice 2): `List.map`'s result element is decided by the lambda alone, so its body is blamed, not the whole call.
mod Names do
  fn names(xs : List(Int)) : List(String) do
    List.map(xs, fn x -> x + 1)
  end
  fn main() : Int do 0 end
end
