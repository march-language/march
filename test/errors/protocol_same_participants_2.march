-- EXPECT-ERROR: came from `Chan.offer`
mod Main do
  -- Session-types final review, Finding 1 RESIDUAL (2026-07-27) -- the LAMBDA
  -- shape of the annotated-parameter laundering.
  --
  -- `t100` closes the TOP-LEVEL `fn` parameter shape: `check_fn`'s `FPNamed`
  -- loop binds the parameter at its annotation AND builds the declared arrow
  -- from the same type, so a call site unifying an unrefined `Chan.offer`
  -- continuation against it reaches `unify`'s `TChan` laundering guard.
  --
  -- A LAMBDA parameter did not. `bind_lam_params` minted a fresh type variable
  -- per parameter, built the lambda's arrow type out of those variables, and
  -- then let `bind_lam_param` bind an ANNOTATED parameter at `surface_ty ann`
  -- WITHOUT ever unifying the two. So the body was checked against the
  -- annotation's own fresh `TChan` ref while the call site unified the marked
  -- argument against a bare, unconstrained type variable -- reaching neither
  -- the `Chan.*` operation arms (physical identity) nor the `unify` guard.
  -- Pre-fix: `--check` exit 0, and the compiled binary printed `4326055105`,
  -- the `String` payload's heap pointer read as an `Int`.
  --
  -- The gap was general, not session-specific: EVERY lambda parameter
  -- annotation was unenforced (a wrong-DIRECTION `Chan` annotation typed clean
  -- too). Fixed at the source in `bind_lam_param`: when a parameter carries an
  -- annotation AND an expected type is supplied, the two are unified, so a
  -- lambda parameter annotation is now checked like every other annotation.
  -- Sibling shape (named `fn` nested in a function body, which routes through
  -- the same `bind_lam_params`): `t103`. Top-level twin: `t100`. Base
  -- witness: `t95`. Accept twin (refined first): `t43`.
  needs IO.Console
  type C = C
  type S = S

  protocol D2 do
    choose by S:
      ok  -> S -> C : Int
      err -> S -> C : String
    end
  end

  protocol E do
    S -> C : Int
  end

  fn main() do
    let (cc, sc) = Chan.new(D2)
    let sc2 = Chan.choose(sc, :err)
    let sc3 = Chan.send(sc2, "boom")
    Chan.close(sc3)
    let (lbl, cc2) = Chan.offer(cc)
    -- The laundering: an ANNOTATED LAMBDA parameter at the same state.
    let f = fn (c : Chan(C, E)) -> Chan.recv(c)
    let (v, cx) = f(cc2)
    Chan.close(cx)
    println(int_to_string(v + 1))
  end
end
