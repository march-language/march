-- EXPECT-ERROR: it reaches `sys_uptime_ms`
-- Issue #1180: `cap pure` must reject a monotonic clock read, both the
-- builtin `sys_uptime_ms` and the stdlib wrapper `System.monotonic_time`
-- over it. `sys_uptime_ms` stays AMBIENT for `needs` (no `IO.Clock` row in
-- `builtin_cap_table`), so the ban cannot come from the capability table or
-- the ceiling: the builtin is banned by name, and the wrapper is found by
-- following the stdlib's own reference edges to the builtin it reaches.
mod Main do
  needs IO.Console

  mod Pure do
    cap pure
    fn direct() : Int do
      sys_uptime_ms()
    end
    fn wrapped() : Int do
      System.monotonic_time()
    end
  end

  fn main(_c : Cap(IO.Console)) : () do
    println(int_to_string(Pure.direct() + Pure.wrapped()))
  end
end
