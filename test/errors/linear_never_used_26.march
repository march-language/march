-- EXPECT-ERROR: The `Ok(v)` arm returns without consuming `c`
mod Main do
  -- F5: `c` is consumed only on the `Err` arm, which ends in `panic` and so
  -- never returns. The error names the arm that does return without
  -- consuming it, instead of pointing only at the binding.
  always_linear type Conn = Conn(Int)
  fn close(c : Conn) : Int do match c do Conn(n) -> n end end
  fn read(c : Conn, r : Result(Int, String)) : Int do
    match r do
      Err(e) ->
        let _ = close(c)
        panic(e)
      Ok(v) -> v
    end
  end
  fn main() : Int do 0 end
end
