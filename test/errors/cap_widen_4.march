-- EXPECT-FIX-PARTIAL: the grant fix is right; `as_writer` also widens `Cap(IO.Console)` to `Cap(IO.FileWrite)` (cap_widen), which needs a code change
mod Main do
  needs IO.Console
  needs IO.FileWrite

  pfn as_writer(c : Cap(IO.Console)) : Cap(IO.FileWrite) do
    cap_narrow(c)
  end

  fn main(c : Cap(IO.Console)) do
    let _w = as_writer(c)
    println("done")
  end
end
