-- EXPECT-ERROR: expected `Int` but got `String`
-- REJECT (§X1 slice 3): one `match do` arm disagrees with the declared return type.
mod Compare do
  fn compare(a : Int, b : Int) : Int do
    match do
      a < b -> -1
      a > b -> "greater"
      true -> 0
    end
  end
  fn main() : Int do compare(1, 2) end
end
