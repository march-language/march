-- EXPECT-ERROR: The linear value `s` cannot be captured by a closure
mod Main do
  needs IO.Console
  -- t208 with a parameter: binding the lambda's own parameter on the way down
  -- must not hide the capture of an outer value.
  always_linear type S1 = S1(Int)
  fn sink(s : S1) : Int do match s do S1(e) -> e end end
  fn run2(k : Int -> Int) : Int do k(1) + k(2) end
  fn main(c : Cap(IO.Console)) do
    let s = S1(1)
    println(int_to_string(run2(fn x -> x + sink(s))))
  end
end
