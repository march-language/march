{"severity":"error","file":"errors/handle_not_sendable_1.march","start_line":14,"start_col":9,"end_line":14,"end_col":13,"message":"`Socket` cannot be sent to another node: a handle names a resource on this node.\n`Relay` cannot derive Json, because its field `sock` holds a `Socket`.","code":"handle_not_sendable","fix":null,"labels":[{"file":"errors/handle_not_sendable_1.march","start_line":13,"start_col":24,"end_line":13,"end_col":30,"message":"`Socket` is a handle"}],"notes":["Keep the `Socket` on this node and send what the other node needs to know instead: a path, an address, or a `GlobalPid.Pid` of an actor here that owns the resource."],"category":"ACTOR"}
{"severity":"error","file":"errors/handle_not_sendable_1.march","start_line":18,"start_col":4,"end_line":18,"end_col":49,"message":"`Socket` cannot be sent to another node: a handle names a resource on this node.\n`Node.send` sends a value of type `Relay`, which holds a `Socket`.","code":"handle_not_sendable","fix":null,"labels":[],"notes":["Keep the `Socket` on this node and send what the other node needs to know instead: a path, an address, or a `GlobalPid.Pid` of an actor here that owns the resource."],"category":"ACTOR"}
