-- MARCH-MODE: run-compiled
-- EXPECT-ERROR: The program panicked: unknown product code: zz
-- The same panic compiled: the report quotes the panic call, then the first
-- line of each function it was reached through.
mod Main do
  needs IO.Console

  fn price(code : String) : Int do
    match code do
    "a" -> 1
    _ -> panic("unknown product code: " ++ code)
    end
  end

  fn total(codes : List(String)) : Int do
    List.fold_left(codes, 0, fn (acc, c) -> acc + price(c))
  end

  fn main(c : Cap(IO.Console)) do
    println(int_to_string(total(["a", "zz"])))
  end
end
