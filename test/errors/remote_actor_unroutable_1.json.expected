{"severity":"error","file":"errors/remote_actor_unroutable_1.march","start_line":9,"start_col":8,"end_line":9,"end_col":15,"message":"The `@[remote]` actor `Counter` has no handler a remote message can reach.\nA routable handler takes one parameter annotated with a declared type that derives Json, like `on Bump(h : Hit)`.","code":"remote_actor_unroutable","fix":null,"labels":[{"file":"errors/remote_actor_unroutable_1.march","start_line":12,"start_col":7,"end_line":12,"end_col":10,"message":"`Set` takes a builtin `Int`, which has no wire tag"},{"file":"errors/remote_actor_unroutable_1.march","start_line":15,"start_col":7,"end_line":15,"end_col":10,"message":"`Add` takes 2 parameters"},{"file":"errors/remote_actor_unroutable_1.march","start_line":18,"start_col":7,"end_line":18,"end_col":12,"message":"`Reset` takes no parameter"}],"notes":[],"category":"ACTOR"}
