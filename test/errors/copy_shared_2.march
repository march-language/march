-- MARCH-MODE: why-copies
-- EXPECT-ERROR: builds a new copy instead of reusing `xs` in place
-- The later use prints, so moving it above the map would reorder output:
-- no fix is offered, only the reason.
mod Main do
  needs IO.Console

  fn doubled(c : Cap(IO.Console), xs : List(Int)) : List(Int) do
    let ys = List.map(xs, fn x -> x * 2)
    let _ = println(int_to_string(List.length(xs)))
    ys
  end

  fn main(c : Cap(IO.Console)) do
    println(int_to_string(List.length(doubled(c, [1, 2, 3]))))
  end
end
