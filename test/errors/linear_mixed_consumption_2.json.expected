{"severity":"error","file":"errors/linear_mixed_consumption_2.march","start_line":11,"start_col":4,"end_line":11,"end_col":31,"message":"The linear value `st` is consumed on some branches but not others.\nOn a branch that doesn't consume it, the value is dropped. Consume it on every branch, or end that branch with `panic(…)` if it never returns.","code":"linear_mixed_consumption","fix":null,"labels":[{"file":"errors/linear_mixed_consumption_2.march","start_line":11,"start_col":17,"end_line":11,"end_col":19,"message":"`st` is consumed on this branch"},{"file":"errors/linear_mixed_consumption_2.march","start_line":11,"start_col":26,"end_line":11,"end_col":27,"message":"but not on this one, where it is dropped"}],"notes":[]}
