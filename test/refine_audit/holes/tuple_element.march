-- Fixture for the audit's non-vacuity guard: a refinement on a TUPLE element.
-- Every registered container (List / Option / Result / a user variant, and
-- any stdlib type defined as one, such as Map) carries element contracts
-- since container subtyping landed (2026-09-13); a tuple is not a registered
-- ADT and has no constructor to hang a contract on, so this site is
-- genuinely Unenforced and keeps the holes baseline non-empty.
mod HolesTupleElement do
  fn f(p : ({Int | _ > 0}, Int)) : Int do
    match p do
      (a, _) -> a
    end
  end

  fn main() : Int do
    f((0, 1))
  end
end
