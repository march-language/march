-- Control fixture: an entry that DOES reference the ill-typed lib module.
-- Reachability keeps LibpathIllTyped in the build (it is named here), so its
-- type error must still surface and --check must exit 1.  Guards the pruning
-- fix against over-reaching and swallowing a reachable module's diagnostics.
mod LibpathEntryRef do
  needs IO.Console

  fn main(_cap_console : Cap(IO.Console)) do
    println(int_to_string(LibpathIllTyped.broken()))
  end

end
