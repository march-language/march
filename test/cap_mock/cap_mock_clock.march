mod CapMockClock do
  -- A clock mock inside a `test` block (ocap phase 7): the same helper is
  -- called before, inside, and after a `mock IO.Clock` block. The outer two
  -- must return a real timestamp and the middle one the mocked 1234, so the
  -- mock is scoped to the block and not global.
  needs IO.Console
  needs IO.Clock

  -- code under test: takes no capability and names none
  pfn stamp() : Int do
    Authority.must(System.now_ms())
  end

  test "a clock mock is scoped to its block" do
    let before = stamp()
    let mocked = mock IO.Clock with { unix_time_ms: Some(fn _ -> 1234) } do
      stamp()
    end
    let after = stamp()
    -- Test.assert_eq is (expected, actual) -- note this is the OPPOSITE order
    -- from Test.assert_eq_int(got, expected) in the same module, so getting it
    -- backwards prints a failure that reads inside out.
    Test.assert_eq(1234, mocked, "inside the mock block the mock is in force")
    Test.assert_true(before > 1700000000000, "before the mock: the real clock")
    Test.assert_true(after > 1700000000000, "after the mock: the real clock again")
  end
end
