mod CapMockActorMany do
  -- An actor spawned inside a `mock`, sent MANY messages, from a test-only
  -- build (no `main`) (ocap phase 7).
  --
  -- The actor keeps the authority of its spawn, mock layer included, and
  -- enters it for every message. Each message must leave the layer list's
  -- reference counts as it found them: a handler that dropped one reference
  -- too many would free the list on the second message and a later one would
  -- die with "RC underflow". `Log` is never sent; its `println` is what makes
  -- the actor reach an interceptable operation at all.
  needs IO.Console
  needs IO.Spawn
  use Test

  actor Logger do
    state { n : Int }
    init  { n: 0 }
    on Bump() do
      { state with n: state.n + 1 }
    end
    on Log() do
      println("count " ++ int_to_string(state.n))
      state
    end
    on Count(reply_to) do
      let _ = actor_reply(reply_to, state.n)
      state
    end
  end

  pfn bump_n(p, n : Int) : Unit do
    if n == 0 do () else
      let _ = send(p, Bump())
      bump_n(p, n - 1)
    end
  end

  test "a capturing actor survives many messages to its cap-free handlers" do
    let p = mock IO.Console with { print_line: Some(fn _ -> ()) } do
      spawn(Logger)
    end
    bump_n(p, 50)
    let t = Authority.must(Task.async(fn () -> actor_call(p, Count(0), 5000)))
    match task_await_unwrap(t) do
      Ok(n)  -> Test.assert_true(n == 50, "all 50 bumps handled")
      Err(e) -> Test.assert_true(false, e)
    end
  end
end
