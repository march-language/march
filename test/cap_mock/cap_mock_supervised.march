mod CapMockSupervised do
  -- A mock reaching a SUPERVISED child (ocap phase 7).
  --
  -- A `supervise` block's children are not spawned by user code: the
  -- supervisor's own spawn glue spawns them. Each child still runs under the
  -- authority current where its supervisor was spawned, and a restart
  -- restores the authority of the slot's first spawn, so the mock layer
  -- reaches both.
  --
  -- Three lines, and which are mocked is the whole test:
  --   in    : the child of a supervisor spawned inside the mock -> mocked
  --   again : the SAME child slot after `kill` forced a restart -> still
  --           mocked (the restart keeps the first spawn's authority)
  --   out   : the child of a supervisor spawned outside, sent to AFTER the
  --           block closes -> real
  needs Actor.Introspect
  needs IO
  needs IO.Console

  actor Logger do
    state { n : Int }
    init  { n: 0 }
    on Say(s : String) do
      IO.puts("L:" ++ s)
      { state with n: state.n + 1 }
    end
  end

  actor Sup do
    state { w : Int }
    init  { w: 0 }
    supervise do
      strategy one_for_one
      max_restarts 5 within 60
      Logger w
    end
  end

  fn child_of(intro : Cap(Actor.Introspect), sup) do
    match get_actor_field(sup, "w") do
      None    -> Authority.must(Actor.pid_from_int(-1))
      Some(n) -> Authority.must(Actor.pid_from_int(n))
    end
  end

  fn main(io : Cap(IO), _cap_introspect : Cap(Actor.Introspect)) do
    let intro = Authority.must(Actor.introspect())
    let outside = spawn(Sup)
    mock IO.Console with { print_line: Some(fn s -> Authority.ignore(IO.write("MOCK[" ++ s ++ "]\n"))) } do
      let inside = spawn(Sup)
      send(child_of(intro, inside), Say("in"))
      run_until_idle()
      kill(child_of(intro, inside))
      run_until_idle()
      send(child_of(intro, inside), Say("again"))
      run_until_idle()
    end
    send(child_of(intro, outside), Say("out"))
    run_until_idle()
  end
end
