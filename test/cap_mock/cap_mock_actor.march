mod CapMockActor do
  -- A mock reaching an ACTOR handler (ocap phase 7).
  --
  -- The handler is entered from the scheduler, not from a call inside the
  -- block. An actor runs under the authority current at its spawn, and the
  -- mock is a layer of that authority, so an actor spawned inside a `mock`
  -- keeps the mock for life.
  --
  -- Two actors, and which one is mocked is the whole test. `outside` is
  -- spawned before the mock exists; `inside` is spawned within the `mock`.
  -- `outside` is then sent its message AFTER the `mock` block has closed,
  -- so a global or dynamically-scoped capability slot would leave it unmocked
  -- for the wrong reason. Capturing per-actor at spawn is what makes the
  -- answer depend on where each actor was created rather than on when it runs.
  needs IO.Console

  actor Logger do
    state { n : Int }
    init  { n: 0 }
    on Say(s : String) do
      IO.puts("A:" ++ s)
      { state with n: state.n + 1 }
    end
  end

  fn main() do
    let outside = spawn(Logger)
    mock IO.Console with { print_line: Some(fn s -> Authority.ignore(IO.write("MOCK[" ++ s ++ "]\n"))) } do
      let inside = spawn(Logger)
      send(inside, Say("in"))
      run_until_idle()
    end
    send(outside, Say("out"))
    run_until_idle()
  end
end
