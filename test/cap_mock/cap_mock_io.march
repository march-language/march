mod CapMockIO do
  -- End-to-end IO mocking with a `mock` block (ocap phase 7).
  --
  -- `work` and `shout` take no capability and name none. `shout` calls
  -- `print_line`, an interceptable operation: inside the `mock`, the test
  -- build routes it to the handler, because the mock is a layer of the
  -- current authority that `work` runs under.
  --
  -- Three calls to the SAME function, with the middle one inside the `mock`:
  -- one handler alone would not distinguish interception from a hard-coded
  -- implementation, and the calls either side pin that the swap is scoped to
  -- the block rather than global.
  needs IO.Console

  pfn shout(s : String) : () do
    IO.puts("REAL:" ++ s)
    ()
  end

  pfn work() : () do
    shout("x")
  end

  fn main() do
    work()
    mock IO.Console with { print_line: Some(fn s -> Authority.ignore(IO.write("MOCK[" ++ s ++ "]\n"))) } do
      work()
    end
    work()
  end
end
