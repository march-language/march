mod CapMockSupervisedNested do
  -- A mock reaching the child of a NESTED supervisor (ocap phase 7).
  --
  -- Top supervises Mid supervises Leaf. Every incarnation of each runs under
  -- the authority of its slot's first spawn, which for a Top spawned inside
  -- the mock includes the mock layer, so Leaf is mocked through any number of
  -- Mid restarts.
  --
  -- Four lines, and which are mocked is the whole test:
  --   in    : the grandchild of a Top spawned inside the mock -> mocked
  --   again : after `kill`ing Mid, the NEW Leaf its respawn created -> still
  --           mocked
  --   third : after killing Mid a SECOND time -> still mocked
  --   out   : the grandchild of a Top spawned outside, sent to AFTER the
  --           block closes -> real
  needs Actor.Introspect
  needs IO
  needs IO.Console

  actor Leaf do
    state { n : Int }
    init  { n: 0 }
    on Say(s : String) do
      IO.puts("leaf:" ++ s)
      { state with n: state.n + 1 }
    end
  end

  actor Mid do
    state { l : Int }
    init  { l: 0 }
    supervise do
      strategy one_for_one
      max_restarts 5 within 60
      Leaf l
    end
  end

  actor Top do
    state { m : Int }
    init  { m: 0 }
    supervise do
      strategy one_for_one
      max_restarts 5 within 60
      Mid m
    end
  end

  fn field_pid(intro : Cap(Actor.Introspect), p, name) do
    match get_actor_field(p, name) do
      None    -> Authority.must(Actor.pid_from_int(-1))
      Some(n) -> Authority.must(Actor.pid_from_int(n))
    end
  end

  fn mid_of(intro : Cap(Actor.Introspect), top) do field_pid(intro, top, "m") end
  fn leaf_of(intro : Cap(Actor.Introspect), top) do field_pid(intro, mid_of(intro, top), "l") end

  fn main(io : Cap(IO), _cap_introspect : Cap(Actor.Introspect)) do
    let intro = Authority.must(Actor.introspect())
    let outside = spawn(Top)
    mock IO.Console with { print_line: Some(fn s -> Authority.ignore(IO.write("MOCK[" ++ s ++ "]\n"))) } do
      let inside = spawn(Top)
      send(leaf_of(intro, inside), Say("in"))
      run_until_idle()
      kill(mid_of(intro, inside))
      run_until_idle()
      send(leaf_of(intro, inside), Say("again"))
      run_until_idle()
      kill(mid_of(intro, inside))
      run_until_idle()
      send(leaf_of(intro, inside), Say("third"))
      run_until_idle()
    end
    send(leaf_of(intro, outside), Say("out"))
    run_until_idle()
  end
end
