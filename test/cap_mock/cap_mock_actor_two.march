mod CapMockActorTwo do
  -- Mocks reaching an actor whose handler performs TWO capabilities'
  -- operations: it logs (IO.Console) and reads the clock (IO.Clock)
  -- (ocap phase 7). Each kind is its own `mock` block, nested.
  --
  -- Four spawns, and which operations are mocked in each is the whole test:
  --   both     : inside the clock mock inside the console mock -> both mocked
  --   clock    : inside the clock mock only   -> Clock mocked, real Console
  --   console  : inside the console mock only -> Console mocked, real Clock
  --   out      : outside every mock, and sent to AFTER every block has
  --              closed -> neither mocked
  -- The two partial rows pin that each mock covers its own kind only.
  -- `out` pins, as cap_mock_actor does, that an actor keeps the authority of
  -- its spawn and not a global or dynamically-scoped slot.
  --
  -- The clock is mocked to a fixed value; the real clock's reading varies, so
  -- the handler prints it by SHAPE only ("real" for anything but the mock's
  -- value) and the trace stays byte-comparable.
  needs IO
  needs IO.Console
  needs IO.Clock

  actor Stamper do
    state { n : Int }
    init  { n: 0 }
    on Say(s : String) do
      let t = Authority.must(System.now_ms())
      let shown = if t == 1234 do "1234" else "real" end
      IO.puts(s ++ "@" ++ shown)
      { state with n: state.n + 1 }
    end
  end

  fn main() do
    let outside = spawn(Stamper)
    mock IO.Clock with { unix_time_ms: Some(fn _ -> 1234) } do
      mock IO.Console with { print_line: Some(fn s -> Authority.ignore(IO.write("MOCK[" ++ s ++ "]\n"))) } do
        let both = spawn(Stamper)
        send(both, Say("both"))
        run_until_idle()
        send(both, Say("both2"))
        run_until_idle()
      end
      let clock_only = spawn(Stamper)
      send(clock_only, Say("clock"))
      run_until_idle()
    end
    mock IO.Console with { print_line: Some(fn s -> Authority.ignore(IO.write("MOCK[" ++ s ++ "]\n"))) } do
      let console_only = spawn(Stamper)
      send(console_only, Say("console"))
      run_until_idle()
    end
    send(outside, Say("out"))
    run_until_idle()
    send(outside, Say("out2"))
    run_until_idle()
  end
end
