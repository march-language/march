-- HCR Phase 5 live test server.
--
-- Spawns a Counter actor, increments it 3 times, then blocks on a TCP port
-- waiting for the test script to signal (by connecting) that the hot deploy
-- is done.  After the signal it prints the post-migration state so the test
-- can verify both the count AND the history field were correctly migrated.
--
-- Pre-migration (v1):
--   pre_migrate count=3
--   pre_migrate history=(none)      -- v1 has no history field
--
-- Post-migration (v2 via __migrate_Counter):
--   post_migrate count=3            -- count must survive unchanged
--   post_migrate history=[]         -- history initialized to [] by migrate_state
--
-- After one more Inc in v2:
--   post_inc count=4
--   post_inc history=[3]            -- v2 Inc prepends old count to history
--
-- Build for linux/amd64:
--   march --compile --hot-reload MyApp --signing-pubkey $KEY \
--     -o /out/counter_server demo/hcr_actor_demo/counter_server.march
--
-- Run on droplet:
--   MARCH_HOT_RELOAD_SOCKET=/tmp/march_hcr_counter.sock ./counter_server

mod MyApp do
  needs IO.Console
  needs IO.NetListen

  actor Counter do
    state { count: Int }
    init { count: 0 }

    on Inc() do
      { count: state.count + 1 }
    end

    on PrintCount(label) do
      println(label ++ int_to_string(state.count))
      state
    end

    on PrintHistory(label) do
      println(label ++ "(none)")
      state
    end
  end

  fn main() do
    let pid = spawn(Counter)
    let _ = send(pid, Inc())
    let _ = send(pid, Inc())
    let _ = send(pid, Inc())
    let _ = send(pid, PrintCount("pre_migrate count="))
    let _ = send(pid, PrintHistory("pre_migrate history="))
    -- Block on TCP port 8765.  The test script connects here after hot-deploy,
    -- which unblocks tcp_accept so we can print post-migration state.
    match tcp_listen(8765) do
      Err(e) ->
        println("ERROR tcp_listen: " ++ e)
      Ok(listen_fd) ->
        let _ = tcp_accept(listen_fd)
        let _ = send(pid, PrintCount("post_migrate count="))
        let _ = send(pid, PrintHistory("post_migrate history="))
        let _ = send(pid, Inc())
        let _ = send(pid, PrintCount("post_inc count="))
        send(pid, PrintHistory("post_inc history="))
    end
  end

end
