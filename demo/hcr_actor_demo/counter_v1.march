-- HCR Phase 5 Demo: Actor state migration — Counter v1
--
-- This actor tracks a simple integer count.
-- Deploy v2 (counter_v2.march) while this is running to trigger
-- live state migration: the count field is preserved and a new
-- history list is added.
--
-- Build and run:
--   march demo/hcr_actor_demo/counter_v1.march \
--     --hot-reload MyApp --compile-so -o /tmp/counter_v1.so
--   march demo/hcr_actor_demo/server.march --hot-reload MyApp \
--     --compile -o /tmp/counter_server
--   /tmp/counter_server

mod MyApp do

  actor Counter do
    state = { count: Int = 0 }

    on Inc() ->
      { count = state.count + 1 }

    on Dec() ->
      { count = state.count - 1 }

    on Reset() ->
      { count = 0 }

    on GetCount() ->
      state.count
  end

  fn main() do
    let pid = spawn(Counter)
    send(pid, Inc())
    send(pid, Inc())
    send(pid, Inc())
    let n = actor_call(pid, GetCount(), 1000)
    println("Count after 3 increments: " ++ int_to_string(n))
    ()
  end

end
