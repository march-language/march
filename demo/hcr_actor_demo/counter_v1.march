-- HCR Phase 5 Demo: Counter v1 (baseline patch)
--
-- Message type MUST match counter_server.march so the server's encoded messages
-- are understood by this dispatch function after hot-swap.
-- State: { count: Int }

mod MyApp do
  needs IO.Console

  actor Counter do
    state { count: Int }
    init { count: 0 }

    on Inc() do
      { count: state.count + 1 }
    end

    on PrintCount(label) do
      println(label ++ int_to_string(state.count))
      state
    end

    on PrintHistory(label) do
      println(label ++ "(none)")
      state
    end
  end

  fn main() do
    let pid = spawn(Counter)
    let _ = send(pid, Inc())
    let _ = send(pid, Inc())
    let _ = send(pid, Inc())
    send(pid, PrintCount("v1 count="))
  end

end
