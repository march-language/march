-- HCR Phase 5 Demo: Counter v2 (migration patch)
--
-- Message type matches counter_server.march and counter_v1.march exactly
-- so dispatch remains compatible after hot-swap.
-- State adds: history: List(Int)
--
-- When forge deploy hot activates this version:
--   1. Schema diff detects history field added
--   2. __migrate_Counter is found (from counter_migrate_state below)
--   3. MARCH_MIGRATE_TAG broadcast to all Counter actors
--   4. Each Counter calls counter_migrate_state({count}) → {count, history=[]}

mod MyApp do
  needs IO.Console

  actor Counter do
    state { count: Int, history: List(Int) }
    init { count: 0, history: [] }

    on Inc() do
      let new_count = state.count + 1
      { count: new_count, history: List.append([state.count], state.history) }
    end

    on PrintCount(label) do
      println(label ++ int_to_string(state.count))
      state
    end

    on PrintHistory(label) do
      let strs = List.map(state.history, fn n -> String.from_int(n))
      println(label ++ "[" ++ String.join(strs, ",") ++ "]")
      state
    end
  end

  -- Magic name: <actor_lowercase>_migrate_state
  -- Exported as @__migrate_Counter by the compiler.
  -- Receives old state (v1: {count: Int}) and returns new state (v2: {count, history}).
  fn counter_migrate_state(old : { count: Int }) : { count: Int, history: List(Int) } do
    { count: old.count, history: [] }
  end

  fn main() do
    let pid = spawn(Counter)
    let _ = send(pid, Inc())
    let _ = send(pid, Inc())
    let _ = send(pid, Inc())
    let _ = send(pid, PrintCount("v2 count="))
    send(pid, PrintCount("(history tracking active)"))
  end

end
