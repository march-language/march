  (run %{exe:../bin/main.exe} --compile -o %{targets} hcr_client.march)))

; Capacity-aware routing demo — server reports CPU/memory headroom, client routes.
; (Works cross-binary thanks to the stable RPC CAS impl_hash fix.)
;
; Build:  dune build demo/load_server.exe demo/load_client.exe
; Server: ./_build/default/demo/load_server.exe [port]
; Client: ./_build/default/demo/load_client.exe <hostA> <portA> <hostB> <portB>
(rule
 (targets load_server.exe)
 (deps (file %{exe:../bin/main.exe})
       (file ../runtime/march_runtime.c) (file ../runtime/march_runtime.h)
       (file ../runtime/march_scheduler.c) (file ../runtime/march_scheduler.h)
       (file ../runtime/march_heap.c) (file ../runtime/march_heap.h)
       (file ../runtime/march_gc.c) (file ../runtime/march_gc.h)
       (file ../runtime/march_message.c) (file ../runtime/march_message.h)
       (file ../runtime/march_deque.h)
       (file ../runtime/march_extras.c) (file ../runtime/march_ctx_escape.c) (file ../runtime/march_compress.c)
       (file ../runtime/base64.c) (file ../runtime/sha1.c)
       (file ../runtime/march_remote_registry.c) (file ../runtime/march_remote_registry.h)
       (file ../runtime/march_monitor_registry.c) (file ../runtime/march_monitor_registry.h)
       (file load_server.march)
       (file ../stdlib/cluster_load.march)
       (file ../stdlib/system.march)
       (file ../stdlib/node_call.march)
       (file ../stdlib/node_rpc.march)
       (file ../stdlib/remote_call.march)
       (file ../stdlib/global_pid.march)
       (file ../stdlib/net_kernel.march)
       (file ../stdlib/net_frame.march))
 (action
  (run %{exe:../bin/main.exe} --compile -o %{targets} load_server.march)))

(rule
 (targets load_client.exe)
 (deps (file %{exe:../bin/main.exe})
       (file ../runtime/march_runtime.c) (file ../runtime/march_runtime.h)
       (file ../runtime/march_scheduler.c) (file ../runtime/march_scheduler.h)
