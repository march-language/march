; Every demo below compiles a demo/*.march program to a native binary.
; CI builds them all through the `demo` alias (the `conformance` job), so a
; stdlib or capability change that breaks a demo goes red on the PR that
; causes it; before that, nothing built demo/ except the release script's
; targetless `dune build --root .`, and seven demos broke unnoticed until
; the 0.5.0 cut. A new demo rule must be added to this alias.
;
; Each rule depends on the whole stdlib and runtime trees, not a hand-picked
; list of the stdlib modules it imports: the 0.5.0 breakage came from the
; cluster transport's capability requirements, which a per-file list can
; miss when the change lands in a module the list does not name.
;
; Build all:  dune build --root . @demo/demo
(alias
 (name demo)
 (deps two_node_rpc.exe two_node_server.exe two_node_client.exe
       resource_report.exe hcr_server.exe hcr_client.exe
       load_server.exe load_client.exe))

; Two-node RPC demo: compiles two_node_rpc.march to a native binary.
;
; Build:   dune build demo/two_node_rpc.exe
; Run:     ./_build/default/demo/two_node_rpc.exe
(rule
 (targets two_node_rpc.exe)
 (deps (file %{exe:../bin/main.exe})
       (source_tree ../runtime) (source_tree ../stdlib)
       (file two_node_rpc.march))
 (action
  (run %{exe:../bin/main.exe} --compile -o %{targets} two_node_rpc.march)))

; Two-node RPC over TCP — separate server and client binaries for cross-host demo.
;
; Build:   dune build demo/two_node_server.exe demo/two_node_client.exe
; Server:  ./_build/default/demo/two_node_server.exe
; Client:  ./_build/default/demo/two_node_client.exe [host] [port]
(rule
 (targets two_node_server.exe)
 (deps (file %{exe:../bin/main.exe})
       (source_tree ../runtime) (source_tree ../stdlib)
       (file two_node_server.march))
 (action
  (run %{exe:../bin/main.exe} --compile -o %{targets} two_node_server.march)))

(rule
 (targets two_node_client.exe)
 (deps (file %{exe:../bin/main.exe})
       (source_tree ../runtime) (source_tree ../stdlib)
       (file two_node_client.march))
 (action
  (run %{exe:../bin/main.exe} --compile -o %{targets} two_node_client.march)))

; Resource introspection demo — prints this node's live CPU/memory headroom.
; Cross-compile for linux/amd64 and run on a remote host to confirm the
; resource builtins read real values on that platform.
;
; Build: dune build demo/resource_report.exe
; Run:   ./_build/default/demo/resource_report.exe
(rule
 (targets resource_report.exe)
 (deps (file %{exe:../bin/main.exe})
       (source_tree ../runtime) (source_tree ../stdlib)
       (file resource_report.march))
 (action
  (run %{exe:../bin/main.exe} --compile -o %{targets} resource_report.march)))

; HCR Phase 3 demo — server compiled with --hot-reload Server, client calls square(7).
;
; Build:   dune build demo/hcr_server.exe demo/hcr_client.exe
; Server:  MARCH_HOT_RELOAD_SOCKET=/tmp/hcr.sock ./_build/default/demo/hcr_server.exe
; Client:  ./_build/default/demo/hcr_client.exe 127.0.0.1 29852 7
; Reload:  scripts/march-reload --socket /tmp/hcr.sock --name Server.square --src hcr_server_patch.march
(rule
 (targets hcr_server.exe)
 (deps (file %{exe:../bin/main.exe})
       (source_tree ../runtime) (source_tree ../stdlib)
       (file hcr_server.march))
 (action
  (run %{exe:../bin/main.exe} --compile --hot-reload Server -o %{targets} hcr_server.march)))

(rule
 (targets hcr_client.exe)
 (deps (file %{exe:../bin/main.exe})
       (source_tree ../runtime) (source_tree ../stdlib)
       (file hcr_client.march))
 (action
  (run %{exe:../bin/main.exe} --compile -o %{targets} hcr_client.march)))

; Capacity-aware routing demo — server reports CPU/memory headroom, client routes.
; (Works cross-binary thanks to the stable RPC CAS impl_hash fix.)
;
; Build:  dune build demo/load_server.exe demo/load_client.exe
; Server: ./_build/default/demo/load_server.exe [port]
; Client: ./_build/default/demo/load_client.exe <hostA> <portA> <hostB> <portB>
(rule
 (targets load_server.exe)
 (deps (file %{exe:../bin/main.exe})
       (source_tree ../runtime) (source_tree ../stdlib)
       (file load_server.march))
 (action
  (run %{exe:../bin/main.exe} --compile -o %{targets} load_server.march)))

(rule
 (targets load_client.exe)
 (deps (file %{exe:../bin/main.exe})
       (source_tree ../runtime) (source_tree ../stdlib)
       (file load_client.march))
 (action
  (run %{exe:../bin/main.exe} --compile -o %{targets} load_client.march)))
