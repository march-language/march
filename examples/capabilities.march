-- Capability security showcase.
-- Demonstrates how March enforces that modules declare the IO capabilities
-- they use, how `main` asks for the program's authority, and how `restrict`
-- runs part of a program under less of it.
--
-- Run: march examples/capabilities.march
--
-- The capability system works as follows:
--   - `needs X` declares which capabilities a module's code may use
--   - `main`'s `needs` clause is what the whole program asks for at launch
--   - each operation checks the current authority at run time
--   - `restrict X do ... end` narrows that authority for a block
--   - `IO` covers all sub-capabilities (IO.Console, IO.Network, etc.)

mod CapDemo do

needs IO

-- ─── Pure functions ────────────────────────────────────────────────────────
-- These do no IO and need no capability. Calling them is always safe.

fn add(x : Int, y : Int) : Int do x + y end

fn format_greeting(name : String) : String do
  "Hello, " ++ name ++ "!"
end

fn square(n : Int) : Int do n * n end

-- ─── Console IO ───────────────────────────────────────────────────────────
-- Functions that perform console IO need `IO.Console`: the module declares
-- it, and the program's request must cover it.

fn greet(name : String) : Unit do
  println(format_greeting(name))
  ()
end

fn print_result(label : String, value : Int) : Unit do
  println(label ++ ": " ++ String.from_int(value))
  ()
end

-- ─── Network IO ───────────────────────────────────────────────────────────
-- A separate sub-capability governs network access.
-- `IO.Console` does NOT cover `IO.Network`.

fn simulate_fetch(url : String) : String do
  -- In a real implementation this would make an HTTP call.
  "[simulated response from " ++ url ++ "]"
end

-- ─── Narrowing: restrict ──────────────────────────────────────────────────
-- `restrict IO.Console do ... end` runs its block under the console alone:
-- inside it, a file read is refused at run time (and a direct one is a
-- compile error, `cap_restrict`).

fn demo_narrowing() : Unit do
  restrict IO.Console do
    greet("restricted user")
    let resp = simulate_fetch("https://example.com/api")
    println("fetch result: " ++ resp)
  end
  ()
end

-- ─── Higher-order capability passing ──────────────────────────────────────
-- A closure runs under the authority where it was made, so a callback
-- built here keeps this module's console wherever it is called.

fn run_with_logging(items : List(Int), label : String) : Unit do
  if is_nil(items) do Authority.ignore(println(label ++ ": empty"))
  else print_result(label ++ " first", head(items)) end
  ()
end

-- ─── Main — asks for the program's authority ──────────────────────────────

fn main() : Unit needs IO.Console, IO.Network do
  println("=== Capability Security Demo ===")
  println("")

  -- Pure functions need no capability
  println("--- Pure functions (no capability needed) ---")
  let sum = add(3, 4)
  println("add(3, 4) = " ++ String.from_int(sum))
  let msg = format_greeting("March")
  println("greeting  = " ++ msg)
  let sq  = square(7)
  println("square(7) = " ++ String.from_int(sq))
  println("")

  -- Console IO
  println("--- Console capability ---")
  greet("Alice")
  greet("Bob")
  print_result("square(12)", square(12))
  println("")

  -- Network IO
  println("--- Network capability ---")
  let resp1 = simulate_fetch("https://api.example.com/users")
  println("response: " ++ resp1)
  let resp2 = simulate_fetch("https://api.example.com/posts")
  println("response: " ++ resp2)
  println("")

  -- Narrowing demo
  println("--- Capability narrowing ---")
  demo_narrowing()
  println("")

  -- HOF with capability
  println("--- Higher-order capability passing ---")
  let nums = Cons(10, Cons(20, Cons(30, Nil)))
  run_with_logging(nums, "nums")
  println("")

  println("=== Done ===")
  ()
end

end
