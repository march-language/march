-- Example: reading a text file with the File module.
--
-- Run: dune exec march -- examples/read_file.march

mod ReadFile do
  needs IO.Console
  needs IO.FileRead

  fn main(_cap_console : Cap(IO.Console), _cap_fileread : Cap(IO.FileRead)) do
    let path = "examples/read_file.march"

    -- Read the whole file at once
    match Authority.must(File.read(path)) do
    Err(e) ->
      Authority.ignore(println("Error reading file: " ++ to_string(e)))
    Ok(contents) -> do
      Authority.ignore(println("=== Full file contents ==="))
      println(contents)
      ()
    end
    end

    -- Read as a list of lines
    match Authority.must(File.read_lines(path)) do
    Err(e) ->
      Authority.ignore(println("Error: " ++ to_string(e)))
    Ok(lines) -> do
      Authority.ignore(println("=== Line count ==="))
      println(String.from_int(List.length(lines)) ++ " lines")
      ()
    end
    end
    -- dbg()
    -- Stream lines with with_lines, collect first 3
    println("=== First 3 lines (streaming) ===")
    match Authority.must(File.with_lines(path, fn(lines) -> Seq.to_list(Seq.take(lines, 3)))) do
    Err(e) ->
      Authority.ignore(println("Error: " ++ to_string(e)))
    Ok(first3) -> do
      let joined = List.fold_left(first3, "", fn(acc, line) -> acc ++ line ++ "\n")
      println(joined)
      ()
    end
    end
  end

end
