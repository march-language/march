-- Example: streaming HTTP responses in March.
--
-- Shows three streaming patterns:
--   1. Print chunks as they arrive
--   2. Count bytes without buffering
--   3. Stream a larger chunked response
--
-- Run: dune exec march -- examples/http_streaming.march

mod HttpStreaming do
  needs IO.Console
  needs IO.NetConnect

fn main() needs IO.Console, IO.NetConnect do
  let client = HttpClient.new_client()
  let client = HttpClient.add_request_step(client, "defaults",
    HttpClient.step_default_headers)

  -- Pattern 1: Print chunks as they arrive
  IO.write("=== Pattern 1: Print chunks ===")
  IO.write("Streaming 5 JSON objects from httpbin.org/stream/5...")
  IO.write("")

  fn print_chunk(chunk) do
    IO.write("[chunk " ++ String.from_int(String.byte_size(chunk)) ++ " bytes]")
    IO.write(chunk)
  end

  match HttpClient.stream_get(client, "http://httpbin.org/stream/5", print_chunk) do
  Ok((status, _, _)) ->
    IO.write("Status: " ++ String.from_int(status))
  Err(_) ->
    IO.write("Error!")
  end

  -- Pattern 2: Count bytes without keeping body in memory
  IO.write("")
  IO.write("=== Pattern 2: Byte counting ===")
  IO.write("Counting bytes from httpbin.org/bytes/8192...")

  fn count_bytes(chunk) do
    IO.write("  received " ++ String.from_int(String.byte_size(chunk)) ++ " bytes")
  end

  match HttpClient.stream_get(client, "http://httpbin.org/bytes/8192", count_bytes) do
  Ok((status, _, _)) ->
    IO.write("Status: " ++ String.from_int(status))
  Err(_) ->
    IO.write("Error!")
  end

  -- Pattern 3: Stream larger chunked response
  IO.write("")
  IO.write("=== Pattern 3: Chunked transfer (20 objects) ===")

  fn show_chunk(chunk) do
    IO.write("  chunk: " ++ String.from_int(String.byte_size(chunk)) ++ " bytes")
  end

  match HttpClient.stream_get(client, "http://httpbin.org/stream/20", show_chunk) do
  Ok((status, _, _)) ->
    IO.write("Status: " ++ String.from_int(status))
    IO.write("Done!")
  Err(_) ->
    IO.write("Error!")
  end
end

end
