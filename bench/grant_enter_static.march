-- Grant boundary cost, frame dropped: the loop of bench/grant_enter.march under
-- an unscoped grant (`IO.FileRead`). The package's functions are pure, so the
-- type checker proves their rows within the grant, they reach no actor spawn
-- and no call of a function value, and no grant frame is emitted (ocap p6
-- decision 7): each boundary call is a plain call. Should match the same
-- build with no grants file within noise (see specs/benchmarks.md and
-- scripts/bench-grants.sh).
--
-- Usage (by hand). Build from a copy outside bench/: a granted library root
-- inside the entry's own directory is a dep_module_conflict. The root in the
-- grants file must be absolute.
--   d=$(mktemp -d); cp -R bench/grant_enter_static.march bench/grant_enter_dep "$d"/
--   mkdir "$d/app"; mv "$d/grant_enter_static.march" "$d/app/"
--   printf 'grant_dep\t%s\tforge.toml:1\tIO.FileRead\n' "$d/grant_enter_dep" > "$d/grants"
--   MARCH_LIB_PATH="$d/grant_enter_dep" march --compile --opt 2 \
--     --dep-grants "$d/grants" "$d/app/grant_enter_static.march" -o /tmp/grant_enter_static
--   /tmp/grant_enter_static

mod GrantEnterStatic do
  needs IO.Console

pfn go(i : Int, n : Int, acc : Int) : Int do
  if i >= n do acc
  else go(i + 1, n, acc + GrantDep.work(i))
  end
end

fn main() do
  println(int_to_string(go(0, 1000000, 0)))
end

end
