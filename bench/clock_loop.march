-- Clock-read throughput: 10_000_000 `System.now_ms()` reads.
-- Measures the per-call cost of a clock read through the checked entry point,
-- including its capability check (ocap phase 1 added it; phase 4 made the raw
-- `unix_time_ms` builtin stdlib-only, so this reads the clock as a program
-- must: specs/plans/2026-11-15-ocap-p4-runtime-plan.md, Task 8).
-- Prints the read count, not a time, so the output is deterministic.
--
-- Usage: march --compile --opt 2 bench/clock_loop.march -o /tmp/clock_loop

mod ClockLoop do
  needs IO.Console
  needs IO.Clock

pfn go(i : Int, n : Int, acc : Int) : Int do
  if i >= n do (if acc > 0 do i else 0 end)
  else go(i + 1, n, acc + Authority.must(System.now_ms()) % 2 + 1) end
end

pfn main(_cap_console : Cap(IO.Console), _cap_clock : Cap(IO.Clock)) : Unit do
  println(int_to_string(go(0, 10000000, 0)))
  ()
end

end
