-- SIMD cross-language benchmark: sum a Float array.
-- Matches bench/ocaml/simd_sum.ml, bench/rust/simd_sum.rs,
-- bench/elixir/simd_sum.exs, bench/python/simd_sum.py (+ _numpy.py).
--
-- native_float_arr_sum auto-vectorizes under --compile --opt 2 (see
-- docs/simd-vectorization.md / specs/optimizations.md P10).
--
-- Data generation (building the source List, converting to NativeArray) is
-- NOT part of the timed region -- only the operation itself is. Building a
-- 5M-element List of boxed Cons cells is ~200ms on its own, which would
-- swamp a <2ms vectorized sum and measure "how fast can March allocate a
-- linked list" instead of "how fast is the vectorized loop". Every other
-- language's benchmark in this set self-times the same way, for the same
-- reason (a flat array fill isn't equivalent cost to a boxed-list build).
mod SimdSum do
  needs IO.Console

needs IO.Clock

pfn elapsed_ms(t0 : Float, t1 : Float) : Float do
  (t1 -. t0) *. 1000.0
end

pfn make_float_list(n : Int) : List(Float) do
  fn go(i : Int, acc : List(Float)) : List(Float) do
    if i < 0 do acc
    else go(i - 1, Cons(int_to_float(i % 100) /. 100.0, acc)) end
  end
  go(n - 1, Nil)
end

fn main() : Unit do
  let n = 5000000
  let arr = NativeArray.from_list_float(make_float_list(n))
  let t0 = unix_time(())
  let s = NativeArray.sum_float(arr)
  let t1 = unix_time(())
  println("RESULT " ++ float_to_string(s))
  println("TIME_MS " ++ float_to_string(elapsed_ms(t0, t1)))
end

end
