-- SIMD cross-language benchmark: elementwise (a[i] + b[i]) over two Float arrays.
-- Matches bench/ocaml/simd_map2.ml, bench/rust/simd_map2.rs,
-- bench/elixir/simd_map2.exs, bench/python/simd_map2.py (+ _numpy.py).
--
-- native_float_arr_map2 is the two-array zip-with primitive added to unblock
-- DataFrame.col_add_col (see docs/simd-vectorization.md "Known limitations").
-- Unlike map_float, it does NOT (yet) get the inlining/vectorization
-- treatment -- included here deliberately, to keep the numbers honest.
--
-- Data generation is NOT part of the timed region -- see bench/simd_sum.march
-- for why (building the source Lists dominates otherwise-small ops).
mod SimdMap2 do
  needs IO.Console

needs IO.Clock

pfn elapsed_ms(t0 : Float, t1 : Float) : Float do
  (t1 -. t0) *. 1000.0
end

pfn make_float_list(n : Int, offset : Float) : List(Float) do
  fn go(i : Int, acc : List(Float)) : List(Float) do
    if i < 0 do acc
    else go(i - 1, Cons(int_to_float(i % 100) /. 100.0 +. offset, acc)) end
  end
  go(n - 1, Nil)
end

fn main() : Unit do
  let n = 5000000
  let a = NativeArray.from_list_float(make_float_list(n, 0.0))
  let b = NativeArray.from_list_float(make_float_list(n, 1.0))
  let t0 = unix_time(())
  let combined = NativeArray.map2_float(a, b, fn (x, y) -> x +. y)
  let t1 = unix_time(())
  let s = NativeArray.sum_float(combined)
  println("RESULT " ++ float_to_string(s))
  println("TIME_MS " ++ float_to_string(elapsed_ms(t0, t1)))
end

end
