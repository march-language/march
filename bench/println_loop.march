-- Console throughput: 1_000_000 println calls.
-- Measures the per-call cost of the console path, including the capability
-- check that ocap phase 1 adds (specs/plans/2026-11-10-ocap-p1-result-plan.md).
--
-- Usage: march --compile --opt 2 bench/println_loop.march -o /tmp/println_loop
--        /tmp/println_loop > /dev/null

mod PrintlnLoop do
  needs IO.Console

pfn go(i : Int, n : Int) : Int do
  if i >= n do i
  else do
    println("x")
    go(i + 1, n)
  end end
end

pfn main(_cap_console : Cap(IO.Console)) : Unit do
  let n = go(0, 1000000)
  println(int_to_string(n))
end

end
