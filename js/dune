; March browser REPL — compiled to JavaScript via js_of_ocaml.
;
; To build the JS bundle:
;   dune build --root=<worktree-root> js/march_browser.bc.js
;
; After building, copy the bundle to docs/assets/:
;   cp _build/default/js/march_browser.bc.js docs/assets/march.js
;
; Or use the playground alias which does both:
;   dune build --root=<worktree-root> @js/playground

(executable
 (name march_browser)
 (libraries
  digestif.ocaml
  march_ast
  march_errors
  march_lexer
  march_parser
  march_desugar
  march_typecheck
  march_eval
  js_of_ocaml)
 (js_of_ocaml (flags (:standard)))
 (modes js))

; March browser live-compile entry point — runs the real --target js compile
; pipeline (lib/driver/js_pipeline.ml) against user-edited source, in the
; browser. Build/copy the same way as march_browser above, with
; march_browser_compile.bc.js -> docs/assets/march_compile.js.
(executable
 (name march_browser_compile)
 (libraries
  march_ast
  march_errors
  march_lexer
  march_parser
  march_desugar
  march_typecheck
  march_tir
  march_driver
  js_of_ocaml)
 (js_of_ocaml (flags (:standard)))
 (modes js))
