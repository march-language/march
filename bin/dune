(rule
 (target version.ml)
 (action (with-stdout-to version.ml (echo "let version = \"%{version:march}\"\n"))))

(executable
 (name main)
 (public_name march)
 (package march)
 (libraries march_lexer march_parser march_ast march_desugar march_typecheck march_codegen march_effects march_errors march_eval march_coverage march_tir march_repl march_debug march_jit march_cas march_caps march_format march_resolver march_dump march_dap march_refine march_refinecheck march_modules march_forge threads.posix unix))

(rule
 (alias warm-cache)
 (deps main.exe (source_tree ../stdlib) (source_tree ../runtime))
 (action (no-infer (system "./main.exe warm-cache"))))

