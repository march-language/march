(library
 (name march_forge)
 (libraries unix march_ast march_lexer march_parser march_desugar march_search march_format march_lint march_refactor yojson digestif march_ed25519 march_caps march_cas))

(rule
 (target notebook_march_src.ml)
 (deps ../tasks/notebook.march)
 (action
  (with-stdout-to %{target}
   (progn
    (echo "let content = {forge_notebook_march|\n")
    (cat %{dep:../tasks/notebook.march})
    (echo "\n|forge_notebook_march}\n")))))


