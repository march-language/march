; `forge topology gen` built-in generators: the templates under
; forge/templates/topology/ embedded as OCaml strings ({{key}} placeholders,
; substituted by Topology.Gen.render).
(rule
 (target topology_tmpl_systemd.ml)
 (deps ../templates/topology/systemd.service.tmpl)
 (action
  (with-stdout-to %{target}
   (progn
    (echo "let content = {tmpl|\n")
    (cat %{dep:../templates/topology/systemd.service.tmpl})
    (echo "\n|tmpl}\n")))))

