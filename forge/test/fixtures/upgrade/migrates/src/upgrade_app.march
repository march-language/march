-- The NEW version of the upgrade fixture that REMOVES a handler and converts
-- what old code still sends: Tally loses Legacy, and tally_migrate_msg turns
-- each old-format Legacy(n) the old feeder keeps sending into Add(n).
-- forge/test/test_upgrade_from.ml copies this over v1 and expects
-- `forge test --upgrade-from HEAD` to pass with converted > 0 and nothing
-- dropped (specs/progress/2026-09-25-migrate-msg-actor-message-tags.md: the
-- old message carries the OLD build's actor-message tag, and TallyMsgV1.Msg
-- is compiled with Tally's tags by constructor name so the match sees it).
--
-- Echo.Server answers twice; a session can span a hot deploy. The hook
-- spawns Tally, whose message type has two handlers, Add and Legacy, and
-- a feeder task that sends Legacy(1) every 20 ms for about six seconds.
-- The feeder is a task: it stays on the code (epoch) it started on, so
-- after a deploy it keeps sending the OLD message format to a Tally that
-- has moved to the new code.
mod UpgradeApp do
  needs IO
  needs IO.Clock
  needs IO.Spawn
  needs Session.Live
  needs ClusterNode.Live

  @[endpoints]
  protocol Echo do
    ask: Client -> Server : Int
    answer: Server -> Client : Int
    ask2: Client -> Server : Int
    answer2: Server -> Client : Int
  end

  type Env = { started : Bool }

  actor Tally do
    state { total : Int }
    init  { total: 0 }
    on Add(n : Int) do { total: state.total + n } end
  end

  fn start(_io : Cap(IO), _node : Cap(ClusterNode.Live)) : Env do
    let t = spawn(Tally)
    let _ = task_spawn(fn _ -> feed(t, 0))
    { started: true }
  end

  fn feed(t : Pid(TallyState), i : Int) : Int do
    if i >= 300 do i else
      let _ = send(t, Add(1))
      sleep_ms(20)
      feed(t, i + 1)
    end
  end

  type TallyState = { total : Int }

  -- The message type Tally had in v1 (what `forge hot-reload
  -- migrate-msg-stub Tally` writes).
  mod TallyMsgV1 do
    type Msg = Add(Int) | Legacy(Int)
  end

  fn tally_migrate_msg(m : TallyMsgV1.Msg) : Option(Tally.Msg) do
    match m do
      TallyMsgV1.Add(n) -> Some(Add(n))
      TallyMsgV1.Legacy(n) -> Some(Add(n))
    end
  end

  fn serve_one(_env : Env, s : Cap(Session.Live), st : Echo_Server.Entry) : Echo_Server.Yield do
    Echo_Server.recv_Ask(s, st, fn (n, st1) ->
      Echo_Server.recv_Ask2(s, Echo_Server.send_Answer(s, st1, n + 1), fn (k, st2) ->
        Echo_Server.close(s, Echo_Server.send_Answer2(s, st2, k + 1))))
  end
end
