-- The OLD version of the ENTRY-MODULE upgrade fixture
-- (forge/test/test_upgrade_from.ml copies this and entry_v1/topology.toml
-- over v1): v1 with the role body and its task function written at the TOP
-- of the entry module instead of in a nested `mod Serve`.
--
-- Lowering strips the entry module's name, so these are the bare TIR fns
-- `serve_one` and `nested`; until 2026-10-01 a bare name was never on the
-- hot-reload boundary and a change to them could not be hot deployed
-- (specs/progress/2026-10-01-hcr-entry-module-top-level-fns-outside-boundary.md).
--
-- Echo.Server answers twice; a session can span a hot deploy. The hook
-- spawns Tally and a feeder task like v1's.
mod UpgradeApp do
  needs IO
  needs IO.Console
  needs IO.Clock
  needs IO.Spawn
  needs IO.Mut
  needs Session.Live
  needs ClusterNode.Live

  @[endpoints]
  protocol Echo do
    ask: Client -> Server : Int
    answer: Server -> Client : Int
    ask2: Client -> Server : Int
    answer2: Server -> Client : Int
  end

  -- The hook keeps its capabilities so a later version's role body can
  -- start sessions of its own (fixtures/upgrade/live).
  type Env = { io : Cap(IO), node : Cap(ClusterNode.Live) }

  actor Tally do
    state { total : Int }
    init  { total: 0 }
    on Add(n : Int) do { total: state.total + n } end
    on Legacy(n : Int) do { total: state.total + n } end
  end

  fn serve_one(env : Env, s : Cap(Session.Live), st : Echo_Server.Entry) : Echo_Server.Yield do
    Echo_Server.recv_Ask(s, st, fn (n, st1) ->
      -- Version 1 runs the task (so it holds the same authority as later
      -- versions: a hot deploy may not add any) but answers without it;
      -- only a NEW body can produce 1111 for an Ask of 1000.
      let extra = if n >= 1000 do task_await_unwrap(task_spawn(fn _ -> nested(env, n))) else 0 end
      let _ = extra
      Echo_Server.recv_Ask2(s, Echo_Server.send_Answer(s, st1, n + 1), fn (k, st2) ->
        Echo_Server.close(s, Echo_Server.send_Answer2(s, st2, k + 1))))
  end

  -- A task: reads the Vault the hook created, then starts an Echo session
  -- of its own (Ask 7: answered 8, then 9).
  pfn nested(env : Env, n : Int) : Int do
    let base = match Vault.whereis("upgrade_state") do
      Some(v) -> Vault.get_or(v, "base", -1)
      None -> -1000
    end
    let got = Vault.new("upgrade_nested_" ++ int_to_string(n))
    let own = match Echo_Run.initiate_Client(env.io, env.node, fn (s, st) ->
        Echo_Client.recv_Answer(s, Echo_Client.send_Ask(s, st, 7), fn (a, st2) ->
          Echo_Client.recv_Answer2(s, Echo_Client.send_Ask2(s, st2, a), fn (b, st3) ->
            Vault.set(got, "v", b)
            Echo_Client.close(s, st3)))) do
      Ok(_) -> Vault.get_or(got, "v", -10000)
      Err(_) -> -100000
    end
    println("upgrade v1: a nested session answered " ++ int_to_string(own))
    base + own
  end

  -- The hook and the feeder come AFTER the role body on purpose: the hook's
  -- lambda is numbered after serve_one's, so an edit to serve_one
  -- renumbers it, and a slot hash that saw the counter names flagged
  -- `start` as changed although its code is not.
  fn start(io : Cap(IO), node : Cap(ClusterNode.Live)) : Env do
    let t = spawn(Tally)
    let _ = task_spawn(fn _ -> feed(t, 0))
    -- Named state the OLD version creates: a later version's code must find
    -- it (a hot patch used to carry its own vault registry and could not).
    let st = Vault.new("upgrade_state")
    Vault.set(st, "base", 100)
    { io: io, node: node }
  end

  fn feed(t : Pid(TallyState), i : Int) : Int do
    if i >= 300 do i else
      let _ = send(t, Legacy(1))
      sleep_ms(20)
      feed(t, i + 1)
    end
  end

  type TallyState = { total : Int }
end
