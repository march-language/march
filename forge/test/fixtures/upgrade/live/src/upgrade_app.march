-- The NEW version of the upgrade fixture whose patch does what real
-- patches do (forge/test/test_upgrade_from.ml copies this over v1 and
-- expects `forge test --upgrade-from HEAD` to pass): the role body changes,
-- and for an Ask of 1000 or more the new body spawns a task, which reads the
-- Vault the OLD version's hook created and starts an Echo session of its
-- own against this pool before answering.
--
-- Three things this proves that the arithmetic-only `good` version cannot
-- (specs/progress/2026-09-25-hcr-patch-so-private-runtime-copy.md):
--   - the role body is called by the generated topology entry, which is not
--     reloadable, so the call reaches the patch only because a call
--     dispatches whenever its CALLEE is reloadable (lib/tir/hot_reload.ml);
--   - new code runs green threads and sessions: a patch that carried its
--     own copy of the C runtime crashed on the first task it spawned;
--   - new code sees the old version's named state (one vault registry).
--
mod UpgradeApp do
  needs IO
  needs IO.Clock
  needs IO.Spawn
  needs IO.Mut
  needs Session.Live
  needs ClusterNode.Live

  @[endpoints]
  protocol Echo do
    ask: Client -> Server : Int
    answer: Server -> Client : Int
    ask2: Client -> Server : Int
    answer2: Server -> Client : Int
  end

  -- The hook keeps its capabilities so a later version's role body can
  -- start sessions of its own (fixtures/upgrade/live).
  type Env = { io : Cap(IO), node : Cap(ClusterNode.Live) }

  actor Tally do
    state { total : Int }
    init  { total: 0 }
    on Add(n : Int) do { total: state.total + n } end
    on Legacy(n : Int) do { total: state.total + n } end
  end

  fn start(io : Cap(IO), node : Cap(ClusterNode.Live)) : Env do
    let t = spawn(Tally)
    let _ = task_spawn(fn _ -> feed(t, 0))
    -- Named state the OLD version creates: a later version's code must find
    -- it (a hot patch used to carry its own vault registry and could not).
    let st = Vault.new("upgrade_state")
    Vault.set(st, "base", 100)
    { io: io, node: node }
  end

  fn feed(t : Pid(TallyState), i : Int) : Int do
    if i >= 300 do i else
      let _ = send(t, Legacy(1))
      sleep_ms(20)
      feed(t, i + 1)
    end
  end

  type TallyState = { total : Int }

  -- The role body lives in a nested module: a nested module's functions
  -- keep their qualified name (`Serve.serve_one`) and are on the hot-reload
  -- boundary; the entry module's own top-level functions get bare names and
  -- are not, so a body there could never be hot-deployed.
  mod Serve do
    needs IO
    needs IO.Console
    needs IO.Clock
    needs IO.Spawn
    needs IO.Mut
    needs Session.Live
    needs ClusterNode.Live

    fn serve_one(env : Env, s : Cap(Session.Live), st : Echo_Server.Entry) : Echo_Server.Yield do
      Echo_Server.recv_Ask(s, st, fn (n, st1) ->
        let extra = if n >= 1000 do task_await_unwrap(task_spawn(fn _ -> nested(env, n))) else 0 end
        Echo_Server.recv_Ask2(s, Echo_Server.send_Answer(s, st1, n + 1 + extra), fn (k, st2) ->
          Echo_Server.close(s, Echo_Server.send_Answer2(s, st2, k + 1))))
    end

    -- New code in a task the new code spawned: reads the Vault the OLD
    -- version's hook created, then starts an Echo session of its own (Ask 7:
    -- answered 8, then 9). Returns base + that answer: 109.
    pfn nested(env : Env, n : Int) : Int do
      let base = match Vault.whereis("upgrade_state") do
        Some(v) -> Vault.get_or(v, "base", -1)
        None -> -1000
      end
      let got = Vault.new("upgrade_nested_" ++ int_to_string(n))
      let own = match Echo_Run.initiate_Client(env.io, env.node, fn (s, st) ->
          Echo_Client.recv_Answer(s, Echo_Client.send_Ask(s, st, 7), fn (a, st2) ->
            Echo_Client.recv_Answer2(s, Echo_Client.send_Ask2(s, st2, a), fn (b, st3) ->
              Vault.set(got, "v", b)
              Echo_Client.close(s, st3)))) do
        Ok(_) -> Vault.get_or(got, "v", -10000)
        Err(_) -> -100000
      end
      println("upgrade live: new code sees base=" ++ int_to_string(base) ++ ", its own session answered " ++ int_to_string(own))
      base + own
    end
  end
end
