# ==> march-edge.service <==
# march-edge.service: pool "edge" of shop (generated by `forge topology gen systemd`)
# Serves: (no roles; hook only)
[Unit]
Description=March pool edge (shop)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/opt/march/shop/shop
Environment=MARCH_POOL=edge
Environment=MARCH_TOPOLOGY=/etc/march/shop/topology.json
# Per-host settings (MARCH_NODE_LABELS, ports, secrets) live in the env file the launcher writes.
EnvironmentFile=-/etc/march/shop/edge.env
Restart=on-failure
RestartSec=2
# SIGTERM starts the drain; the hard deadline from [drain] hard_ms is the stop timeout.
KillSignal=SIGTERM
TimeoutStopSec=120

[Install]
WantedBy=multi-user.target

