# ==> march-edge.service <==
# march-edge.service: pool "edge" of shop (generated by `forge topology gen systemd`)
# Serves: (no roles; hook only)
[Unit]
Description=March pool edge (shop)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=march
Group=march
ExecStart=/opt/march/shop/shop
Environment=MARCH_POOLS=edge
Environment=MARCH_TOPOLOGY_FILE=/etc/march/shop/topology.json
Environment=MARCH_TOPOLOGY_STATUS=/var/lib/march/shop/run/edge.status
Environment=MARCH_HOT_RELOAD_SOCKET=/var/lib/march/shop/run/edge.sock
Environment=HOME=/var/lib/march/shop
# Secrets (the cluster secret) live in the env file `forge host init` writes (mode 0640).
EnvironmentFile=-/etc/march/shop/edge.env
Restart=on-failure
RestartSec=2
# SIGTERM starts the drain; the hard deadline from [drain] hard_ms is the stop timeout.
KillSignal=SIGTERM
TimeoutStopSec=120

[Install]
WantedBy=multi-user.target

