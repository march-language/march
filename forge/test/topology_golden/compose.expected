# ==> docker-compose.yml <==
# docker-compose for shop, generated by `forge topology gen compose`: one service per pool.
services:
  edge:
    image: shop:latest
    environment:
      MARCH_POOL: edge
      MARCH_TOPOLOGY: /etc/march/topology.json
    volumes:
      - ./.forge/topology.json:/etc/march/topology.json:ro
    deploy:
      replicas: 1
    ports:
      - "443:443"

  ledger:
    image: shop:latest
    environment:
      MARCH_POOL: ledger
      MARCH_TOPOLOGY: /etc/march/topology.json
    volumes:
      - ./.forge/topology.json:/etc/march/topology.json:ro
    deploy:
      replicas: 1

  imaging:
    image: shop:imaging
    environment:
      MARCH_POOL: imaging
      MARCH_TOPOLOGY: /etc/march/topology.json
    volumes:
      - ./.forge/topology.json:/etc/march/topology.json:ro
    deploy:
      replicas: 2


