# ==> ufw-web-1.sh <==
#!/bin/sh
# ufw rules for host web-1 (pool "edge"), generated by `forge topology gen ufw`.
# Public ports open to anyone; the cluster port to every other cluster member (SWIM
# probes every member; pools are kept apart by certificate, not by firewall).
set -e
# ssh stays open: enabling ufw without it would cut off every later deploy.
ufw allow 22/tcp comment 'ssh (march deploys)'
ufw allow 443/tcp comment 'march edge public'
ufw allow from db-1 to any port 7946 proto tcp comment 'march cluster from ledger'
ufw allow from render-1 to any port 7946 proto tcp comment 'march cluster from imaging'
ufw allow from render-2 to any port 7946 proto tcp comment 'march cluster from imaging'
ufw --force enable

