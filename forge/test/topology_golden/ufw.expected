# ==> ufw-web-1.sh <==
#!/bin/sh
# ufw rules for host web-1 (pool "edge"), generated by `forge topology gen ufw`.
# Public ports open to anyone; the cluster port only to the hosts of the pools this one talks to.
set -e
# ssh stays open: enabling ufw without it would cut off every later deploy.
ufw allow 22/tcp comment 'ssh (march deploys)'
ufw allow 443/tcp comment 'march edge public'
ufw allow from db-1 to any port 7946 proto tcp comment 'march cluster from ledger'
ufw --force enable

# ==> ufw-db-1.sh <==
#!/bin/sh
# ufw rules for host db-1 (pool "ledger"), generated by `forge topology gen ufw`.
# Public ports open to anyone; the cluster port only to the hosts of the pools this one talks to.
set -e
# ssh stays open: enabling ufw without it would cut off every later deploy.
ufw allow 22/tcp comment 'ssh (march deploys)'
ufw allow from web-1 to any port 7946 proto tcp comment 'march cluster from edge'
ufw --force enable

# ==> ufw-render-1.sh <==
#!/bin/sh
# ufw rules for host render-1 (pool "imaging"), generated by `forge topology gen ufw`.
# Public ports open to anyone; the cluster port only to the hosts of the pools this one talks to.
set -e
# ssh stays open: enabling ufw without it would cut off every later deploy.
ufw allow 22/tcp comment 'ssh (march deploys)'
# no inbound rules
ufw --force enable

