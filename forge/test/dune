; test_forge.ml's test_compiled_run_end_to_end shells out to a real, just-built
; `march --compile` (exe-relative from test_forge.exe to ../../bin/main.exe,
; the same convention as test/test_cap_markers.ml's compiler_exe). The `deps`
; below makes `dune runtest`/CI build bin/main.exe before running this suite,
; so the test's own "compiler not found" guard never fires just because
; nothing else happened to build it first.
(tests
 (names test_forge test_resolver test_solver test_cas_package test_patch
        test_api_surface test_properties test_regression test_cap_binary test_cap_inspect
        test_audit test_audit_inferred test_cap_package test_dep_dir test_dep_cache_versions)
 (modules test_forge test_resolver test_solver test_cas_package test_patch
          test_api_surface test_properties test_regression test_cap_binary test_cap_inspect
          test_audit test_audit_inferred test_cap_package test_dep_dir test_dep_cache_versions)
 (deps ../../bin/main.exe)
 (libraries march_forge march_search march_caps str alcotest unix qcheck-core qcheck-alcotest march_cas))

; test_cap_sandbox.ml's test_scaffolded_app_builds_clean and
; test_forge_fix_applies_capability_errors cases shell out to real bare
; `march`/`forge` subprocesses. Pulled out of the generic (tests) stanza
; above and given the same hermetic treatment as test_build_check.ml below:
; the rule passes the just-built march AND forge (%{bin:march}, %{bin:forge})
; as MARCH_TEST_BIN / FORGE_TEST_BIN, and setup_hermetic_toolchain (in
; test_cap_sandbox.ml) symlinks both onto a private PATH with an empty
; MARCH_HOME, so the bare `march`/`forge` these tests invoke always resolve
; to the build under test, never an ambient/installed release.
;
; Also passes the staged runtime/ and stdlib/ trees (MARCH_TEST_RUNTIME_DIR /
; MARCH_TEST_STDLIB_DIR, via the `(source_tree ...)` deps below) so
; setup_hermetic_toolchain can export MARCH_RUNTIME_DIR / MARCH_STDLIB --
; unlike test_build_check.ml, this suite exercises a REAL native compile
; (`forge build`/`forge test` on a scaffolded app), and march invoked as a
; bare name through a PATH symlink cannot find runtime/stdlib via its normal
; exe-relative resolution (see the doc comment on setup_hermetic_toolchain).
(executable
 (name test_cap_sandbox)
 (modules test_cap_sandbox)
 (libraries march_forge march_caps str alcotest unix qcheck-core qcheck-alcotest march_cas))

(rule
 (alias runtest)
 (deps (source_tree %{workspace_root}/runtime) (source_tree %{workspace_root}/stdlib))
 (action
  (setenv MARCH_TEST_BIN %{bin:march}
   (setenv FORGE_TEST_BIN %{bin:forge}
    (setenv MARCH_TEST_RUNTIME_DIR %{workspace_root}/runtime
     (setenv MARCH_TEST_STDLIB_DIR %{workspace_root}/stdlib
      (run %{exe:test_cap_sandbox.exe})))))))

