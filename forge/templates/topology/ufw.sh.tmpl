#!/bin/sh
# ufw rules for host {{host}} (pool "{{pool}}"), generated by `forge topology gen ufw`.
# Public ports open to anyone; the cluster port to every other cluster member (SWIM
# probes every member; pools are kept apart by certificate, not by firewall).
set -e
# ssh stays open: enabling ufw without it would cut off every later deploy.
ufw allow 22/tcp comment 'ssh (march deploys)'
{{rules}}
ufw --force enable
