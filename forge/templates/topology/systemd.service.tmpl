# march-{{pool}}.service: pool "{{pool}}" of {{project}} (generated by `forge topology gen systemd`)
# Serves: {{roles}}
[Unit]
Description=March pool {{pool}} ({{project}})
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart={{exec}}
Environment=MARCH_POOL={{pool}}
Environment=MARCH_TOPOLOGY=/etc/march/{{project}}/topology.json
# Per-host settings (MARCH_NODE_LABELS, ports, secrets) live in the env file the launcher writes.
EnvironmentFile=-/etc/march/{{project}}/{{pool}}.env
Restart=on-failure
RestartSec=2
# SIGTERM starts the drain; the hard deadline from [drain] hard_ms is the stop timeout.
KillSignal=SIGTERM
TimeoutStopSec={{stop_sec}}

[Install]
WantedBy=multi-user.target
