# march-{{pool}}.service: pool "{{pool}}" of {{project}} (generated by `{{generator}}`)
# Serves: {{roles}}
[Unit]
Description=March pool {{pool}} ({{project}})
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User={{user}}
Group={{user}}
ExecStart={{exec}}
{{environment}}
# Secrets (the cluster secret) live in the env file `forge host init` writes (mode 0640).
EnvironmentFile=-/etc/march/{{project}}/{{pool}}.env
Restart=on-failure
RestartSec=2
# SIGTERM starts the drain; the hard deadline from [drain] hard_ms is the stop timeout.
KillSignal=SIGTERM
TimeoutStopSec={{stop_sec}}

[Install]
WantedBy=multi-user.target
