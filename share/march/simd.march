-- Simd -- explicit 128-bit SIMD vector values (F32x4, F64x2, I32x4, I64x2, U8x16).
-- Fixed width: identical semantics on every target, interpreted or compiled.
-- See docs/simd-vectorization.md.
--
-- Boundary rule: lane get/set traffic in widened Int/Float; integer narrowing
-- wraps mod 2^w two's-complement; f32 narrowing rounds to nearest-even; u8 loads
-- zero-extend (0..255), i32 sign-extends. Integer lane arithmetic wraps. Float
-- lanes are true single/double precision. min/max/hmin/hmax on floats use
-- minNum/maxNum semantics (a NaN operand loses to the other; both NaN is NaN).
-- sum accumulates sequentially (f32x4/f64x2 in double, i32x4/i64x2 in i64).
--
-- Lane order: lane 0 is the first make_* argument / lowest-addressed on load.
mod Simd do

  -- ── F32x4 ──────────────────────────────────────────────
  doc "All lanes set to [v] (rounded to binary32)."
  fn splat_f32x4(v : Float) do simd_f32x4_splat(v) end
  doc "Vector with lane 0 = the first argument, ..., lane 3 = the last."
  fn make_f32x4(v0 : Float, v1 : Float, v2 : Float, v3 : Float) do simd_f32x4_make(v0, v1, v2, v3) end
  doc "Lane [i] (0-3), widened to Float exactly."
  fn extract_f32x4(v, i : {Int | 0 <= _ && _ < 4}) do simd_f32x4_extract(v, i) end
  doc "[v] with lane [i] set to [x] (rounded to binary32)."
  fn replace_f32x4(v, i : {Int | 0 <= _ && _ < 4}, x : Float) do simd_f32x4_replace(v, i, x) end
  doc "Load 4 lanes from [arr] starting at index [i] (dynamic bounds check; panics out of range)."
  fn load_f32x4(arr, i : Int) do simd_f32x4_load(arr, i) end
  doc "Store [v]'s 4 lanes into [arr] starting at index [i], returning the updated array (dynamic bounds check; panics out of range)."
  fn store_f32x4(arr, i : Int, v) do simd_f32x4_store(arr, i, v) end
  doc "Per-lane equality mask (all-ones lane where equal, zero otherwise)."
  fn eq_f32x4(a, b) do simd_f32x4_eq(a, b) end
  doc "Per-lane less-than mask (all-ones lane where [a] < [b], zero otherwise)."
  fn lt_f32x4(a, b) do simd_f32x4_lt(a, b) end
  doc "Per-lane greater-than mask (all-ones lane where [a] > [b], zero otherwise)."
  fn gt_f32x4(a, b) do simd_f32x4_gt(a, b) end
  doc "Per-lane bitwise AND."
  fn and_f32x4(a, b) do simd_f32x4_and(a, b) end
  doc "Per-lane bitwise OR."
  fn or_f32x4(a, b) do simd_f32x4_or(a, b) end
  doc "Per-lane bitwise XOR."
  fn xor_f32x4(a, b) do simd_f32x4_xor(a, b) end
  doc "Per-lane bitwise complement."
  fn not_f32x4(v) do simd_f32x4_not(v) end
  doc "Per-lane: [mask]'s lane all-ones selects [a]'s lane, else [b]'s lane."
  fn select_f32x4(mask, a, b) do simd_f32x4_select(mask, a, b) end
  doc "True if any lane's high bit is set (interprets [v] as a mask)."
  fn any_f32x4(v) do simd_f32x4_any(v) end
  doc "True if every lane's high bit is set (interprets [v] as a mask)."
  fn all_f32x4(v) do simd_f32x4_all(v) end
  doc "Index of the first lane whose high bit is set (interprets [v] as a mask), or -1 if none."
  fn first_set_f32x4(v) do simd_f32x4_first_set(v) end
  doc "Per-lane addition, rounded to binary32."
  fn add_f32x4(a, b) do simd_f32x4_add(a, b) end
  doc "Per-lane subtraction, rounded to binary32."
  fn sub_f32x4(a, b) do simd_f32x4_sub(a, b) end
  doc "Per-lane multiplication, rounded to binary32."
  fn mul_f32x4(a, b) do simd_f32x4_mul(a, b) end
  doc "Per-lane division."
  fn div_f32x4(a, b) do simd_f32x4_div(a, b) end
  doc "Per-lane minimum (minNum/maxNum: a NaN lane yields the other operand; both NaN yields NaN)."
  fn min_f32x4(a, b) do simd_f32x4_min(a, b) end
  doc "Per-lane maximum (minNum/maxNum: a NaN lane yields the other operand; both NaN yields NaN)."
  fn max_f32x4(a, b) do simd_f32x4_max(a, b) end
  doc "Per-lane fused multiply-add: [a] * [b] + [c], one rounding."
  fn fma_f32x4(a, b, c) do simd_f32x4_fma(a, b, c) end
  doc "Per-lane square root."
  fn sqrt_f32x4(v) do simd_f32x4_sqrt(v) end
  doc "Horizontal sum of all lanes, accumulated sequentially in double."
  fn sum_f32x4(v) do simd_f32x4_sum(v) end
  doc "Horizontal minimum of all lanes (minNum/maxNum: a NaN lane yields the other operand; both NaN yields NaN)."
  fn hmin_f32x4(v) do simd_f32x4_hmin(v) end
  doc "Horizontal maximum of all lanes (minNum/maxNum: a NaN lane yields the other operand; both NaN yields NaN)."
  fn hmax_f32x4(v) do simd_f32x4_hmax(v) end

