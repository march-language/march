  -- ── Show / Eq / Hash impls — pure March, shared by both execution paths ──

  impl Show(F32x4) do
    fn show(v) do
      "F32x4[" ++ to_string(simd_f32x4_extract(v, 0)) ++ ", " ++ to_string(simd_f32x4_extract(v, 1)) ++ ", " ++ to_string(simd_f32x4_extract(v, 2)) ++ ", " ++ to_string(simd_f32x4_extract(v, 3)) ++ "]"
    end
  end

  impl Eq(F32x4) do
    fn eq(a, b) do
      simd_f32x4_extract(a, 0) == simd_f32x4_extract(b, 0)
        && simd_f32x4_extract(a, 1) == simd_f32x4_extract(b, 1)
        && simd_f32x4_extract(a, 2) == simd_f32x4_extract(b, 2)
        && simd_f32x4_extract(a, 3) == simd_f32x4_extract(b, 3)
    end
  end

  impl Hash(F32x4) do
    fn hash(v) do
      hash(simd_f32x4_extract(v, 0)) * 31
        + hash(simd_f32x4_extract(v, 1)) * 17
        + hash(simd_f32x4_extract(v, 2)) * 7
        + hash(simd_f32x4_extract(v, 3))
    end
  end

  impl Show(F64x2) do
    fn show(v) do
      "F64x2[" ++ to_string(simd_f64x2_extract(v, 0)) ++ ", " ++ to_string(simd_f64x2_extract(v, 1)) ++ "]"
    end
  end

  impl Eq(F64x2) do
    fn eq(a, b) do
      simd_f64x2_extract(a, 0) == simd_f64x2_extract(b, 0)
        && simd_f64x2_extract(a, 1) == simd_f64x2_extract(b, 1)
    end
  end

  impl Hash(F64x2) do
    fn hash(v) do
      hash(simd_f64x2_extract(v, 0)) * 31
        + hash(simd_f64x2_extract(v, 1))
    end
  end

  impl Show(I32x4) do
    fn show(v) do
      "I32x4[" ++ to_string(simd_i32x4_extract(v, 0)) ++ ", " ++ to_string(simd_i32x4_extract(v, 1)) ++ ", " ++ to_string(simd_i32x4_extract(v, 2)) ++ ", " ++ to_string(simd_i32x4_extract(v, 3)) ++ "]"
    end
  end

  impl Eq(I32x4) do
    fn eq(a, b) do
      simd_i32x4_extract(a, 0) == simd_i32x4_extract(b, 0)
        && simd_i32x4_extract(a, 1) == simd_i32x4_extract(b, 1)
        && simd_i32x4_extract(a, 2) == simd_i32x4_extract(b, 2)
        && simd_i32x4_extract(a, 3) == simd_i32x4_extract(b, 3)
    end
  end

  impl Hash(I32x4) do
    fn hash(v) do
      hash(simd_i32x4_extract(v, 0)) * 31
        + hash(simd_i32x4_extract(v, 1)) * 17
        + hash(simd_i32x4_extract(v, 2)) * 7
        + hash(simd_i32x4_extract(v, 3))
    end
  end

  impl Show(I64x2) do
    fn show(v) do
      "I64x2[" ++ to_string(simd_i64x2_extract(v, 0)) ++ ", " ++ to_string(simd_i64x2_extract(v, 1)) ++ "]"
    end
  end

  impl Eq(I64x2) do
    fn eq(a, b) do
      simd_i64x2_extract(a, 0) == simd_i64x2_extract(b, 0)
        && simd_i64x2_extract(a, 1) == simd_i64x2_extract(b, 1)
    end
  end

  impl Hash(I64x2) do
    fn hash(v) do
      hash(simd_i64x2_extract(v, 0)) * 31
        + hash(simd_i64x2_extract(v, 1))
    end
  end

  impl Show(U8x16) do
    fn show(v) do
      "U8x16[" ++ to_string(simd_u8x16_extract(v, 0)) ++ ", " ++ to_string(simd_u8x16_extract(v, 1)) ++ ", " ++ to_string(simd_u8x16_extract(v, 2)) ++ ", " ++ to_string(simd_u8x16_extract(v, 3)) ++ ", " ++ to_string(simd_u8x16_extract(v, 4)) ++ ", " ++ to_string(simd_u8x16_extract(v, 5)) ++ ", " ++ to_string(simd_u8x16_extract(v, 6)) ++ ", " ++ to_string(simd_u8x16_extract(v, 7)) ++ ", " ++ to_string(simd_u8x16_extract(v, 8)) ++ ", " ++ to_string(simd_u8x16_extract(v, 9)) ++ ", " ++ to_string(simd_u8x16_extract(v, 10)) ++ ", " ++ to_string(simd_u8x16_extract(v, 11)) ++ ", " ++ to_string(simd_u8x16_extract(v, 12)) ++ ", " ++ to_string(simd_u8x16_extract(v, 13)) ++ ", " ++ to_string(simd_u8x16_extract(v, 14)) ++ ", " ++ to_string(simd_u8x16_extract(v, 15)) ++ "]"
    end
  end

  impl Eq(U8x16) do
    fn eq(a, b) do
      simd_u8x16_extract(a, 0) == simd_u8x16_extract(b, 0)
        && simd_u8x16_extract(a, 1) == simd_u8x16_extract(b, 1)
        && simd_u8x16_extract(a, 2) == simd_u8x16_extract(b, 2)
        && simd_u8x16_extract(a, 3) == simd_u8x16_extract(b, 3)
        && simd_u8x16_extract(a, 4) == simd_u8x16_extract(b, 4)
        && simd_u8x16_extract(a, 5) == simd_u8x16_extract(b, 5)
        && simd_u8x16_extract(a, 6) == simd_u8x16_extract(b, 6)
        && simd_u8x16_extract(a, 7) == simd_u8x16_extract(b, 7)
        && simd_u8x16_extract(a, 8) == simd_u8x16_extract(b, 8)
        && simd_u8x16_extract(a, 9) == simd_u8x16_extract(b, 9)
        && simd_u8x16_extract(a, 10) == simd_u8x16_extract(b, 10)
        && simd_u8x16_extract(a, 11) == simd_u8x16_extract(b, 11)
        && simd_u8x16_extract(a, 12) == simd_u8x16_extract(b, 12)
        && simd_u8x16_extract(a, 13) == simd_u8x16_extract(b, 13)
        && simd_u8x16_extract(a, 14) == simd_u8x16_extract(b, 14)
        && simd_u8x16_extract(a, 15) == simd_u8x16_extract(b, 15)
    end
  end

  impl Hash(U8x16) do
    fn hash(v) do
      hash(simd_u8x16_extract(v, 0)) * 31
        + hash(simd_u8x16_extract(v, 1)) * 17
        + hash(simd_u8x16_extract(v, 2)) * 7
        + hash(simd_u8x16_extract(v, 3)) * 3
        + hash(simd_u8x16_extract(v, 4)) * 13
        + hash(simd_u8x16_extract(v, 5)) * 11
        + hash(simd_u8x16_extract(v, 6)) * 5
        + hash(simd_u8x16_extract(v, 7)) * 19
        + hash(simd_u8x16_extract(v, 8)) * 23
        + hash(simd_u8x16_extract(v, 9)) * 29
        + hash(simd_u8x16_extract(v, 10)) * 37
        + hash(simd_u8x16_extract(v, 11)) * 41
        + hash(simd_u8x16_extract(v, 12)) * 43
        + hash(simd_u8x16_extract(v, 13)) * 47
        + hash(simd_u8x16_extract(v, 14)) * 53
        + hash(simd_u8x16_extract(v, 15))
    end
  end

end
